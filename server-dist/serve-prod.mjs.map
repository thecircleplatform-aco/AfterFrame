    "label": "Body Font"
   }
  ],
  "thumb": "/thumbnails/207da43b-d3e8-4f05-81b9-25fbe97c50f4.jpg",
  "code": "const WatercolorAnchor = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n\n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const textColor = props.textColor;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n  const washColor1 = props.washColor1;\n  const washColor2 = props.washColor2;\n  const washColor3 = props.washColor3;\n\n  const parseHex = (hex) => {\n    if (!hex) return [0,0,0];\n    const h = hex.replace('#','');\n    return [parseInt(h.substring(0,2),16)||0, parseInt(h.substring(2,4),16)||0, parseInt(h.substring(4,6),16)||0];\n  };\n  const rgba = (hex, a) => { const [r,g,b] = parseHex(hex); return `rgba(${r},${g},${b},${a})`; };\n\n  const smoothSettle = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,3.5);\n  const bellCurveLate = (t) => t<=0?0:t>=1?1:t<0.4?0.15*Math.pow(t/0.4,2.5):0.15+0.85*(1-Math.pow(1-(t-0.4)/0.6,2.8));\n  const lineDraw = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,2.8);\n\n  const total = durationInFrames || 150;\n  const exitRaw = Math.max(0, Math.min(1, (frame-(total-25))/25));\n  const ex = 1 - exitRaw*exitRaw;\n\n  const anim = (delay, dur) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/dur)));\n  const fadeIn = (delay) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/15)));\n\n  // Wash background\n  const washA = anim(0, 50) * ex;\n  const washScale = 1.04 - 0.04*anim(0,45);\n\n  // Title (delay 5)\n  const ttA = fadeIn(5)*ex;\n  const ttY = (1-anim(5,48))*45;\n\n  // Subtitle (delay 20)\n  const stA = fadeIn(20)*ex;\n  const stY = (1-anim(20,35))*30;\n\n  // Body (delay 30)\n  const bdA = fadeIn(30)*ex;\n  const bdY = (1-anim(30,35))*25;\n\n  // Timeline vertical line (delay 10)\n  const tlH = lineDraw(Math.min(1, Math.max(0,(frame-10)/55)))*500;\n  const tlA = fadeIn(10)*ex;\n\n  // Timeline nodes (stagger from 25)\n  const nd = [0,1,2,3].map(i => {\n    const d = 25+i*6;\n    return { a: fadeIn(d)*ex, y: (1-anim(d,30))*15 };\n  });\n\n  // Pie chart (delay 15, 60f)\n  const chRaw = Math.min(1, Math.max(0,(frame-15)/60));\n  const chP = bellCurveLate(chRaw);\n  const chLblA = anim(15+60*0.55, 18)*ex;\n\n  // Name tag (delay 35)\n  const nmA = fadeIn(35)*ex;\n\n  // Footer line (delay 25)\n  const lineW = anim(25, 40);\n  const lineA = fadeIn(25)*ex;\n\n  // Donut arc helper\n  const arcPath = (cx, cy, r, startDeg, endDeg) => {\n    if (endDeg - startDeg < 0.5) return '';\n    const s = { x: cx+Math.cos(startDeg*Math.PI/180)*r, y: cy+Math.sin(startDeg*Math.PI/180)*r };\n    const e = { x: cx+Math.cos(endDeg*Math.PI/180)*r, y: cy+Math.sin(endDeg*Math.PI/180)*r };\n    return `M ${s.x} ${s.y} A ${r} ${r} 0 ${endDeg-startDeg>180?1:0} 1 ${e.x} ${e.y}`;\n  };\n\n  const segs = [{p:0.35,c:washColor1},{p:0.30,c:washColor2},{p:0.20,c:washColor3},{p:0.15,c:washColor1}];\n  let ang = -90;\n\n  return (\n    <div style={{position:'absolute',inset:0,backgroundColor:bgColor,overflow:'hidden',fontFamily:bodyFont}}>\n      {/* Watercolor washes */}\n      <div style={{position:'absolute',top:'-10%',left:'-5%',width:900,height:900,\n        background:`radial-gradient(circle,${rgba(washColor1,washA*0.4)} 0%,transparent 65%)`,\n        transform:`scale(${washScale})`,transformOrigin:'center'}}/>\n      <div style={{position:'absolute',bottom:'-15%',right:'-10%',width:1100,height:1100,\n        background:`radial-gradient(circle,${rgba(washColor2,washA*0.35)} 0%,transparent 60%)`,\n        transform:`scale(${washScale})`,transformOrigin:'center'}}/>\n\n      {/* Title area (left) */}\n      <div style={{position:'absolute',left:120,top:120,transform:`translateY(${ttY}px)`}}>\n        <div style={{fontFamily:titleFont,fontSize:90,fontWeight:300,color:rgba(textColor,ttA),lineHeight:1.1,letterSpacing:'0.02em',whiteSpace:'pre-wrap'}}>\n          CREATIVE{'\\n'}WATERCOLOR\n        </div>\n      </div>\n\n      {/* Subtitle */}\n      <div style={{position:'absolute',left:120,top:360,transform:`translateY(${stY}px)`}}>\n        <div style={{fontSize:28,color:rgba(textColor,stA*0.7),lineHeight:1.4,whiteSpace:'pre-wrap'}}>\n          Here is where your{'\\n'}presentation begins\n        </div>\n      </div>\n\n      {/* Body text */}\n      <div style={{position:'absolute',left:120,top:500,width:550,transform:`translateY(${bdY}px)`}}>\n        <div style={{fontSize:26,lineHeight:1.5,color:rgba(textColor,bdA*0.8)}}>\n          Our studio brings artistic vision to every project through color, texture, and organic form.\n        </div>\n      </div>\n\n      {/* Name tag (lower-left) */}\n      <div style={{position:'absolute',left:120,bottom:100}}>\n        <div style={{fontSize:32,fontFamily:titleFont,color:rgba(textColor,nmA)}}>Elena Marchetti</div>\n        <div style={{fontSize:16,letterSpacing:'0.12em',textTransform:'uppercase',color:rgba(textColor,nmA*0.6),marginTop:8}}>LEAD ARTIST</div>\n      </div>\n\n      {/* Footer separator line */}\n      <div style={{position:'absolute',bottom:80,left:120,right:120,height:1,backgroundColor:rgba(textColor,lineA*0.3),transform:`scaleX(${lineW})`,transformOrigin:'left'}}/>\n\n      {/* Vertical timeline (center) */}\n      <div style={{position:'absolute',left:780,top:200,width:2,height:500}}>\n        <div style={{position:'absolute',top:0,width:2,height:tlH,backgroundColor:rgba(textColor,tlA*0.2)}}/>\n        {['2018','2020','2022','2024'].map((yr,i) => {\n          const ny = i*130;\n          return (\n            <div key={i} style={{position:'absolute',top:ny,left:0,transform:`translateY(${nd[i].y}px)`}}>\n              <div style={{position:'absolute',left:-12,top:-4,width:8,height:8,borderRadius:'50%',backgroundColor:rgba(washColor1,nd[i].a*0.7)}}/>\n              <div style={{position:'absolute',left:20,top:-8,fontFamily:titleFont,fontSize:24,fontWeight:'bold',color:rgba(textColor,nd[i].a)}}>{yr}</div>\n              <div style={{position:'absolute',left:20,top:18,fontSize:15,color:rgba(textColor,nd[i].a*0.6)}}>Waypoint</div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Pie/donut chart (right) */}\n      <div style={{position:'absolute',right:150,top:180,width:380,height:380}}>\n        <svg width={380} height={380}>\n          {segs.map((s,i) => {\n            const segAngle = s.p*360*chP;\n            const path = arcPath(190, 190, 130, ang, ang+segAngle);\n            ang += s.p*360;\n            return path ? <path key={i} d={path} fill=\"none\" stroke={rgba(s.c,ex)} strokeWidth={50} strokeLinecap=\"butt\"/> : null;\n          })}\n        </svg>\n        {[{pct:'35%',a:-30},{pct:'30%',a:80},{pct:'20%',a:170},{pct:'15%',a:250}].map((l,i) => {\n          const lx = 190+Math.cos(l.a*Math.PI/180)*170;\n          const ly = 190+Math.sin(l.a*Math.PI/180)*170;\n          return <div key={`l${i}`} style={{position:'absolute',left:lx-20,top:ly-10,width:40,textAlign:'center',fontSize:16,fontWeight:600,color:rgba(textColor,chLblA)}}>{l.pct}</div>;\n        })}\n      </div>\n\n      {/* Team member circles (right bottom) */}\n      <div style={{position:'absolute',right:150,bottom:140,display:'flex',gap:40}}>\n        {[washColor1,washColor2,washColor3].map((c,i) => {\n          const cA = fadeIn(30+i*8)*ex;\n          return <div key={i} style={{width:80,height:80,borderRadius:'50%',backgroundColor:rgba(c,cA*0.15),border:`2px solid ${rgba(c,cA*0.5)}`}}/>;\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "a73aa354-9e8c-459a-a94a-78b0547d9a67",
  "name": "Dark cinematic chapter title card — \"Number 3 / TONE\"",
