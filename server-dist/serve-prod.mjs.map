  "thumb": "/thumbnails/77c25412-0768-4c6f-a56d-3d78b5481ff0.jpg",
  "code": "const LiquidMetalText = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const bodyText = props.bodyText;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const blobColor3 = props.blobColor3;\n\n  const backgroundFill = transparentBackground ? 'transparent' : bgColor;\n\n  const safeFps = fps || 30;\n  \n  const titleOpacity = interpolate(frame, [10, 30], [0, 1], { extrapolateRight: 'clamp' });\n  const titleSpring = spring({ frame: Math.max(0, frame - 10), fps: safeFps, config: { damping: 16 } });\n  const titleY = interpolate(titleSpring, [0, 1], [40, 0]);\n\n  const bodyOpacity = interpolate(frame, [25, 45], [0, 1], { extrapolateRight: 'clamp' });\n  const bodySpring = spring({ frame: Math.max(0, frame - 25), fps: safeFps, config: { damping: 16 } });\n  const bodyY = interpolate(bodySpring, [0, 1], [40, 0]);\n\n  const t = frame / (durationInFrames || 150);\n\n  const cx1 = 1920 * (0.4 + 0.15 * Math.sin(t * Math.PI * 2));\n  const cy1 = 1080 * (0.3 + 0.15 * Math.cos(t * Math.PI * 2));\n  \n  const cx2 = 1920 * (0.7 + 0.1 * Math.cos(t * Math.PI * 2));\n  const cy2 = 1080 * (0.6 + 0.1 * Math.sin(t * Math.PI * 2));\n\n  const cx3 = 1920 * (0.3 + 0.2 * Math.sin(t * Math.PI * 4));\n  const cy3 = 1080 * (0.8 + 0.1 * Math.cos(t * Math.PI * 2));\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: backgroundFill,\n    overflow: 'hidden'\n  };\n\n  const svgStyle = {\n    position: 'absolute',\n    inset: 0,\n    width: '100%',\n    height: '100%'\n  };\n\n  const titleStyle = {\n    position: 'absolute',\n    top: '20%',\n    left: '8%',\n    width: '75%',\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n    fontFamily: titleFont,\n    fontSize: '96px',\n    fontWeight: 700,\n    fontStyle: 'italic',\n    color: '#FFFFFF',\n    lineHeight: 1.15,\n    letterSpacing: '-0.02em',\n    textShadow: '0 4px 16px rgba(0,0,0,0.25)'\n  };\n\n  const bodyStyle = {\n    position: 'absolute',\n    top: '55%',\n    left: '45%',\n    width: '45%',\n    opacity: bodyOpacity,\n    transform: `translateY(${bodyY}px)`,\n    fontFamily: bodyFont,\n    fontSize: '30px',\n    fontWeight: 400,\n    color: 'rgba(255, 255, 255, 0.9)',\n    lineHeight: 1.6,\n    textShadow: '0 2px 8px rgba(0,0,0,0.2)'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {!transparentBackground && (\n        <svg style={svgStyle}>\n          <defs>\n            <filter id=\"liquidBlur\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"180\" />\n            </filter>\n          </defs>\n          <g filter=\"url(#liquidBlur)\">\n            <circle cx={cx1} cy={cy1} r=\"900\" fill={blobColor1} />\n            <circle cx={cx2} cy={cy2} r=\"1000\" fill={blobColor2} />\n            <circle cx={cx3} cy={cy3} r=\"800\" fill={blobColor3} />\n          </g>\n        </svg>\n      )}\n\n      <div style={titleStyle}>\n        {titleText}\n      </div>\n\n      <div style={bodyStyle}>\n        {bodyText}\n      </div>\n    </div>\n  );\n};"
 },
