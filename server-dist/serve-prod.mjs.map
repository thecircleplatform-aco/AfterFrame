   }
  ],
  "thumb": "/thumbnails/dfda4ffe-ab11-4da3-94e7-963a41d79fb4.jpg",
  "code": "const MinimalTitleCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleLine1 = props.titleLine1;\n  const titleLine2 = props.titleLine2;\n  const subtitle = props.subtitle;\n  const backgroundColor = props.backgroundColor;\n  const textColor = props.textColor;\n  const subtitleColor = props.subtitleColor;\n  const transparentBackground = props.transparentBackground;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n\n  // Gradient edge width (%) — black→transparent transition zone\n  const EDGE = 8;\n  // The gradient goes 135deg. For the mask to be fully hidden at start,\n  // the transparent edge must be at or below 0%. So start offset = -(EDGE).\n  // For fully revealed, the black trailing edge must be at or above 100%.\n  // So end offset = 100 + EDGE. Range = 100 + 2*EDGE.\n  const RANGE = 100 + 2 * EDGE;\n\n  // easeOut cubic\n  const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);\n  // easeIn cubic\n  const easeInCubic = (t) => Math.pow(t, 3);\n\n  // --- Wipe IN: frames 0 → WIPE_IN_DURATION ---\n  const WIPE_IN_DURATION = 60;\n  const tIn = Math.min(1, Math.max(0, frame / WIPE_IN_DURATION));\n  // offset goes from -EDGE (fully hidden) to 100+EDGE (fully revealed)\n  const inOffset = easeOutCubic(tIn) * RANGE - EDGE;\n\n  // --- Wipe OUT: same direction (left-top → right-bottom), continues past screen ---\n  // At wipeOutProgress=0: offset at 100+EDGE (fully revealed, nothing masked)\n  // At wipeOutProgress=1: offset at 100+EDGE + RANGE (trailing black edge past 100%, all hidden)\n  const WIPE_OUT_DURATION = 45;\n  const WIPE_OUT_START = durationInFrames - WIPE_OUT_DURATION;\n  const tOut = Math.min(1, Math.max(0, (frame - WIPE_OUT_START) / WIPE_OUT_DURATION));\n  // Wipe OUT mask: transparent sweeps left-top → right-bottom (same direction as in)\n  // outOffset goes from -EDGE (fully visible) to 100+EDGE (fully hidden)\n  const outMaskOffset = easeInCubic(tOut) * RANGE - EDGE;\n\n  // Build combined mask:\n  // During in-phase: black region sweeps in from left-top → right-bottom\n  // During out-phase: transparent region sweeps out from left-top → right-bottom\n  // We pick the appropriate gradient based on which phase is active\n  let maskImage;\n  if (tOut > 0) {\n    // Out phase: transparent sweeps over, erasing content left-top → right-bottom\n    maskImage = `linear-gradient(135deg, transparent ${outMaskOffset - EDGE}%, transparent ${outMaskOffset}%, black ${outMaskOffset + EDGE}%)`;\n  } else {\n    // In phase: black region reveals content left-top → right-bottom\n    maskImage = `linear-gradient(135deg, black ${inOffset - EDGE}%, black ${inOffset}%, transparent ${inOffset + EDGE}%)`;\n  }\n\n  // --- Text animations ---\n  // Start text after wipe is ~halfway through\n  const TEXT_START = 30;\n  const delay1 = TEXT_START;\n  const delay2 = TEXT_START + 15;\n  const delay3 = TEXT_START + 35;\n\n  const spring1 = spring({\n    frame: Math.max(0, frame - delay1),\n    fps: safeFps,\n    config: { damping: 14, mass: 0.8 }\n  });\n\n  const spring2 = spring({\n    frame: Math.max(0, frame - delay2),\n    fps: safeFps,\n    config: { damping: 14, mass: 0.8 }\n  });\n\n  const fade3 = interpolate(frame - delay3, [0, 15], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  const opacity1 = interpolate(spring1, [0, 1], [0, 1], { extrapolateRight: 'clamp' });\n  const translateY1 = interpolate(spring1, [0, 1], [40, 0]);\n\n  const opacity2 = interpolate(spring2, [0, 1], [0, 1], { extrapolateRight: 'clamp' });\n  const translateY2 = interpolate(spring2, [0, 1], [40, 0]);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: transparentBackground ? 'transparent' : backgroundColor,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    fontFamily: fontFamily,\n    overflow: 'hidden',\n    WebkitMaskImage: maskImage,\n    maskImage: maskImage,\n  };\n\n  const line1Style = {\n    fontSize: '72px',\n    fontWeight: 700,\n    color: textColor,\n    letterSpacing: '-0.02em',\n    opacity: opacity1,\n    transform: `translateY(${translateY1}px)`,\n    margin: 0,\n    lineHeight: 1.1\n  };\n\n  const line2Style = {\n    fontSize: '140px',\n    fontWeight: 800,\n    color: textColor,\n    letterSpacing: '-0.04em',\n    opacity: opacity2,\n    transform: `translateY(${translateY2}px)`,\n    margin: '10px 0 0 0',\n    lineHeight: 1.1\n  };\n\n  const subtitleStyle = {\n    fontSize: '42px',\n    fontWeight: 400,\n    fontStyle: 'italic',\n    color: subtitleColor,\n    opacity: fade3,\n    margin: '35px 0 0 0',\n    letterSpacing: '-0.01em'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={line1Style}>{titleLine1}</div>\n      <div style={line2Style}>{titleLine2}</div>\n      <div style={subtitleStyle}>{subtitle}</div>\n    </div>\n  );\n};\n"
 },
 {
