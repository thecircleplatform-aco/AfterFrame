  "propSchema": [],
  "thumb": "/thumbnails/435ca688-a7aa-4b5a-ac7b-d6994b2cbe36.jpg",
  "code": "const ScrollVelocityMarquee = ({item}) => {\n  const frame = useCurrentFrame();\n  const { durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const row1Text = props.row1Text || 'IT DOES NOT MATTER ✦ HOW SMALL THE STUDIO ✦ SO LONG';\n  const row1Joiner = props.row1Joiner || '✦';\n  const row2Text = props.row2Text || 'DO NOT • BLINK • AS YOU • KEEP SHOOTING';\n  const row2Joiner = props.row2Joiner || '•';\n  const fontFamily = props.fontFamily || 'Montserrat, sans-serif';\n  const textColor = props.textColor || '#f3f2ff';\n  const lineColor = props.lineColor || '#f3f2ff';\n  const cruiseSpeed = props.cruiseSpeed !== undefined ? props.cruiseSpeed : 18;\n  const easeFrames = props.easeFrames !== undefined ? props.easeFrames : 60;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Safe velocity integration to calculate position with ease-in and ease-out\n  const getScrollPosition = (f, speed, ease, total) => {\n    const E = Math.max(0, Math.min(ease, total / 2));\n    const V = speed;\n    const T = total;\n\n    if (E === 0) return V * f;\n\n    if (f <= E) {\n      // Acceleration phase\n      return 0.5 * V * (f * f) / E;\n    } else if (f <= T - E) {\n      // Cruise phase\n      return 0.5 * V * E + V * (f - E);\n    } else {\n      // Deceleration phase\n      const fp = f - (T - E);\n      const posAtCruiseEnd = 0.5 * V * E + V * (T - 2 * E);\n      return posAtCruiseEnd + (V * fp) - (0.5 * V * (fp * fp) / E);\n    }\n  };\n\n  const pos = getScrollPosition(frame, cruiseSpeed, easeFrames, durationInFrames);\n\n  // Generate long repeating text to ensure seamless looping without DOM measurements\n  const getRepeatedText = (text, joiner) => {\n    const separator = `\\u00A0\\u00A0\\u00A0\\u00A0${joiner}\\u00A0\\u00A0\\u00A0\\u00A0`;\n    return Array(40).fill(text).join(separator);\n  };\n\n  const fullText1 = getRepeatedText(row1Text, row1Joiner);\n  const fullText2 = getRepeatedText(row2Text, row2Joiner);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center'\n  };\n\n  const marqueeContainerStyle = {\n    width: '100%',\n    borderTop: `2px solid ${lineColor}`,\n    borderBottom: `2px solid ${lineColor}`,\n    padding: '30px 0',\n    display: 'flex',\n    flexDirection: 'column',\n    gap: '20px',\n    overflow: 'hidden',\n    position: 'relative',\n    backgroundColor: 'transparent'\n  };\n\n  const rowStyle = {\n    position: 'relative',\n    height: '110px',\n    width: '100%',\n    overflow: 'visible'\n  };\n\n  const textStyle = {\n    position: 'absolute',\n    top: 0,\n    left: '50%',\n    whiteSpace: 'nowrap',\n    fontFamily: fontFamily,\n    fontSize: '100px',\n    fontWeight: 700,\n    lineHeight: '110px',\n    color: textColor,\n    textTransform: 'uppercase'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={marqueeContainerStyle}>\n        <div style={rowStyle}>\n          <div style={{\n            ...textStyle,\n            transform: `translateX(calc(-50% + ${pos}px))`\n          }}>\n            {fullText1}\n          </div>\n        </div>\n        <div style={rowStyle}>\n          <div style={{\n            ...textStyle,\n            transform: `translateX(calc(-50% - ${pos}px))`\n          }}>\n            {fullText2}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "30ff329c-f4cc-49cf-afae-8c98299039f5",
  "name": "Takeaway lower-third overlay (baked)",
  "category": "text-effects",
  "description": "Animated lower-third overlay with glow text reveal, per-letter stagger entrance, and a sweeping accent slash — all fading out smoothly at the end.",
  "tags": [
   "long-form",
   "short-form",
   "talking-head"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/30ff329c-f4cc-49cf-afae-8c98299039f5.jpg",
  "code": "const TakeawayOverlayBaked = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const titleText = \"Takeaway\";\n  const bodyText = \"Grow your listener base — don't rely on playlists alone\";\n  const accentColor = \"#ffffff\";\n  const textColor = \"#ffffff\";\n  const titleFontFamily = \"Inter\";\n  const bodyFontFamily = \"Inter\";\n  const transparentBackground = true;\n\n  const DESIGN_WIDTH = 1200;\n  const DESIGN_HEIGHT = 300;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const TITLE_IN_START = 0;\n  const TITLE_IN_END   = 20;\n  const LINE_START     = 18;\n  const LINE_END       = 58;\n  const LINE_MAX_W     = 270;  // 与标题文字等宽\n  const BODY_START     = 34;\n  const LETTER_STAGGER = 0.9;\n  const LETTER_DUR     = 7;\n  const FADE_OUT_START = durationInFrames - 18;\n  const FADE_OUT_END   = durationInFrames - 2;\n\n  const globalOpacity = interpolate(\n    frame,\n    [Math.max(0, FADE_OUT_START), Math.max(1, FADE_OUT_END)],\n    [1, 0],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  const titleProgress = interpolate(frame, [TITLE_IN_START, TITLE_IN_END], [0, 1], {\n    easing: Easing.bezier(0.25, 1, 0.5, 1),\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n  const titleOpacity = titleProgress;\n  const titleBlur    = interpolate(titleProgress, [0, 1], [14, 0]);\n  const tg = titleProgress;\n  const titleShadow = [\n    `0 0 4px rgba(255,255,255,${0.95*tg})`,\n    `0 0 12px rgba(255,255,255,${0.8*tg})`,\n    `0 0 28px rgba(255,255,255,${0.55*tg})`,\n    `0 0 56px rgba(255,255,255,${0.3*tg})`,\n  ].join(',');\n\n  const lineProgress = interpolate(frame, [LINE_START, LINE_END], [0, 1], {\n    easing: Easing.bezier(0.16, 1, 0.3, 1),\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n  const lineW = lineProgress * LINE_MAX_W;\n  const lineGlowPeak = interpolate(frame, [LINE_START, LINE_END, LINE_END + 15], [0, 1, 0.65], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n  const lineVisible = frame >= LINE_START;\n\n  const svgH = 44;\n  const cy = svgH / 2;\n\n  // 左端宽（两点），右端尖（一点）\n  const triPoints = (w, hL) => {\n    if (w <= 0) return `0,${cy} 0,${cy} 0,${cy}`;\n    return `0,${cy - hL} ${w},${cy} 0,${cy + hL}`;\n  };\n\n  const hexToRgb = (hex) => {\n    const h = (hex || '#874cff').replace('#', '');\n    return {\n      r: parseInt(h.slice(0,2),16),\n      g: parseInt(h.slice(2,4),16),\n      b: parseInt(h.slice(4,6),16)\n    };\n  };\n  const {r, g: gc, b} = hexToRgb(accentColor);\n  const ac = `${r},${gc},${b}`;\n\n  const rawWords = (bodyText || '').split(' ');\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: transparentBackground ? 'transparent' : 'rgba(10,10,18,0.82)',\n    padding: '36px 48px',\n    boxSizing: 'border-box',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'flex-start',\n    alignItems: 'flex-start',\n    opacity: globalOpacity,\n  };\n\n  const titleStyle = {\n    fontFamily: titleFontFamily, fontSize: 52, fontWeight: 700,\n    color: textColor, margin: 0, letterSpacing: '0.01em',\n    lineHeight: 1.15, whiteSpace: 'nowrap',\n    opacity: titleOpacity,\n    filter: `blur(${titleBlur}px)`,\n    textShadow: titleShadow,\n  };\n\n  const lineSvgWrap = {\n    marginTop: 4,\n    marginBottom: 8,\n    flexShrink: 0,\n    opacity: lineVisible ? 1 : 0,\n    display: 'block',\n    overflow: 'visible',\n  };\n\n  const bodyContainerStyle = { position: 'relative', width: '100%', lineHeight: 1.55 };\n\n  let letterIdx = 0;\n  const wordNodes = rawWords.map((word, wi) => {\n    const wordLetters = word.split('').map(ch => {\n      const gi = letterIdx++;\n      const start = BODY_START + gi * LETTER_STAGGER;\n      const end   = start + LETTER_DUR;\n      const lp = interpolate(frame, [start, end], [0, 1], {\n        easing: Easing.bezier(0.22, 1, 0.36, 1),\n        extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n      });\n      const lY    = interpolate(lp, [0, 1], [-9, 0]);\n      const lBlur = interpolate(lp, [0, 1], [3, 0]);\n      const g = lp;\n      const ls = [\n        `0 0 3px rgba(255,255,255,${0.98*g})`,\n        `0 0 9px rgba(255,255,255,${0.85*g})`,\n        `0 0 20px rgba(255,255,255,${0.65*g})`,\n        `0 0 40px rgba(255,255,255,${0.38*g})`,\n        `0 0 72px rgba(255,255,255,${0.18*g})`,\n      ].join(',');\n      return (\n        <span key={gi} style={{\n          display: 'inline-block', opacity: lp,\n          transform: `translateY(${lY}px)`, verticalAlign: 'baseline',\n          fontFamily: bodyFontFamily, fontSize: 34, fontWeight: 300,\n          color: textColor, filter: `blur(${lBlur}px)`,\n          textShadow: ls, whiteSpace: 'pre',\n        }}>{ch}</span>\n      );\n    });\n    let spaceNode = null;\n    if (wi < rawWords.length - 1) {\n      const si = letterIdx++;\n      const sp = interpolate(frame,\n        [BODY_START+si*LETTER_STAGGER, BODY_START+si*LETTER_STAGGER+LETTER_DUR],\n        [0,1], {extrapolateLeft:'clamp',extrapolateRight:'clamp'});\n      spaceNode = <span key={'sp-'+wi} style={{display:'inline-block',width:'0.28em',opacity:sp}} />;\n    }\n    return (\n      <span key={'w-'+wi} style={{display:'inline-block',whiteSpace:'nowrap'}}>\n        {wordLetters}{spaceNode}\n      </span>\n    );\n  });\n\n  return (\n    <div style={rootStyle}>\n      <div style={titleStyle}>{titleText}</div>\n\n      <svg\n        width={LINE_MAX_W}\n        height={svgH}\n        viewBox={`0 0 ${LINE_MAX_W} ${svgH}`}\n        style={lineSvgWrap}\n        overflow=\"visible\"\n      >\n        <polygon\n          points={triPoints(lineW, 18)}\n          fill={`rgba(${ac},${0.45 * lineGlowPeak})`}\n          style={{filter: 'blur(8px)'}}\n        />\n        <polygon\n          points={triPoints(lineW, 10)}\n          fill={`rgba(${ac},${0.7 * lineGlowPeak})`}\n          style={{filter: 'blur(3px)'}}\n        />\n        <polygon\n          points={triPoints(lineW, 2.5)}\n          fill={`rgba(${ac},0.95)`}\n        />\n        <polygon\n          points={triPoints(lineW, 0.8)}\n          fill={`rgba(255,255,255,${0.85 * lineProgress})`}\n        />\n      </svg>\n\n      <div style={bodyContainerStyle}>\n        <div style={{position:'relative',width:'100%',lineHeight:1.55,color:textColor}}>\n          {wordNodes}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "f11ec59a-6c28-4b03-8dae-e9e98516547d",
  "name": "Vibe Effects Title Card",
  "category": "text-effects",
  "description": "A bold full-screen title opener with a staggered column wipe-in, italic layered text, and a fast split-exit animation — perfect for high-energy intros and channel branding.",
  "tags": [
   "long-form",
   "short-form",
   "intro"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "URBAN\nRIDERS",
   "repeatText": "Urban Riders",
   "mainFont": "Oswald, Impact, sans-serif",
   "backgroundColor": "#534d71",
   "accentColor": "#00b0b1",
   "transparentBackground": false
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "URBAN\nRIDERS",
    "label": "titleText"
   },
   {
    "key": "repeatText",
    "type": "text",
    "defaultValue": "Urban Riders",
    "label": "repeatText"
   },
   {
    "key": "mainFont",
    "type": "font",
    "defaultValue": "Oswald, Impact, sans-serif",
    "label": "mainFont"
   },
   {
    "key": "backgroundColor",
    "type": "color",
    "defaultValue": "#534d71",
    "label": "backgroundColor"
   },
   {
    "key": "accentColor",
    "type": "color",
    "defaultValue": "#00b0b1",
    "label": "accentColor"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
