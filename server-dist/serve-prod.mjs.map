  "thumb": "/thumbnails/452d340f-f4f4-4747-bec6-018cf639d10e.jpg",
  "code": "const CategoryBarChart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'Membership Signups';\n  const bgColor = props.bgColor || '#212038';\n  const unit = props.unit || 'K';\n\n  const barColor1 = props.barColor1 || '#ce63ba';\n  const barColor2 = props.barColor2 || '#a594eb';\n  const barColor3 = props.barColor3 || '#0093cc';\n  const barColor4 = props.barColor4 || '#efa200';\n  const barColor5 = props.barColor5 || '#00b6a0';\n\n  const cat1 = props.cat1 || 'Yoga'; const val1 = Number(props.val1 ?? 890);\n  const cat2 = props.cat2 || 'Cycling';     const val2 = Number(props.val2 ?? 560);\n  const cat3 = props.cat3 || 'Nutrition';     const val3 = Number(props.val3 ?? 430);\n  const cat4 = props.cat4 || 'Recovery';     const val4 = Number(props.val4 ?? 320);\n  const cat5 = props.cat5 || 'Strength';     const val5 = Number(props.val5 ?? 250);\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return Math.min(1, spring({ frame: Math.max(0, frame - delay), fps: safeFps, config }));\n  };\n\n  const titleSpring = safeSpring(0, { damping: 14 });\n  const gridSpring = safeSpring(10, { damping: 20 });\n\n  const chartTop = 320;\n  const chartHeight = 580;\n  const chartLeft = 200;\n  const chartWidth = 1520;\n\n  const actualMax = Math.max(val1, val2, val3, val4, val5, 10);\n  const computedMax = Math.ceil(actualMax / 200) * 200;\n\n  const gridSteps = 5;\n  const gridItems = [];\n  for (let i = 0; i <= gridSteps; i++) {\n    const val = (computedMax / gridSteps) * i;\n    const yPos = chartTop + chartHeight - (val / computedMax) * chartHeight;\n    gridItems.push({ val, yPos });\n  }\n\n  const data = [\n    { label: cat1, value: val1, color: barColor1 },\n    { label: cat2, value: val2, color: barColor2 },\n    { label: cat3, value: val3, color: barColor3 },\n    { label: cat4, value: val4, color: barColor4 },\n    { label: cat5, value: val5, color: barColor5 },\n  ];\n\n  const barWidth = 130;\n  const barSpacing = chartWidth / data.length;\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    overflow: 'hidden',\n    fontFamily: '\"Noto Sans SC\", sans-serif',\n    color: 'white'\n  };\n\n  const gridLines = gridItems.map((item, i) => {\n    const lineOpacity = gridSpring * 0.15;\n    const lineStyle = {\n      position: 'absolute',\n      left: chartLeft,\n      top: item.yPos,\n      width: chartWidth,\n      height: 2,\n      backgroundColor: `rgba(255,255,255,${lineOpacity})`,\n      transform: `scaleX(${gridSpring})`,\n      transformOrigin: 'left center'\n    };\n\n    const labelStyle = {\n      position: 'absolute',\n      left: chartLeft - 30,\n      top: item.yPos - 14,\n      width: 100,\n      textAlign: 'right',\n      transform: 'translateX(-100%)',\n      fontSize: 22,\n      color: `rgba(255,255,255,${gridSpring * 0.6})`,\n      fontFamily: '\"IBM Plex Mono\", monospace'\n    };\n\n    return (\n      <div key={`grid-${i}`}>\n        <div style={lineStyle} />\n        <div style={labelStyle}>{item.val}</div>\n      </div>\n    );\n  });\n\n  const bars = data.map((d, i) => {\n    const barSpring = safeSpring(20 + i * 5, { damping: 14, mass: 0.8 });\n    const targetHeight = (d.value / computedMax) * chartHeight;\n    const currentHeight = targetHeight * barSpring;\n    const currentY = chartTop + chartHeight - currentHeight;\n    const currentVal = Math.round(d.value * barSpring);\n\n    const barCenterX = chartLeft + (barSpacing * i) + (barSpacing / 2);\n\n    const barContainerStyle = {\n      position: 'absolute',\n      left: barCenterX - (barWidth / 2),\n      top: currentY,\n      width: barWidth,\n      height: Math.max(0, currentHeight),\n      borderRadius: '16px 16px 0 0',\n      background: `linear-gradient(180deg, ${d.color} 0%, rgba(0,0,0,0.3) 100%)`,\n      backgroundColor: d.color,\n      boxShadow: '0 8px 24px rgba(0,0,0,0.4)',\n      opacity: barSpring\n    };\n\n    const innerHighlightStyle = {\n      position: 'absolute', top: 0, left: 0, right: 0, bottom: 0,\n      borderRadius: '16px 16px 0 0',\n      background: 'linear-gradient(180deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 25%)',\n    };\n\n    const labelStyle = {\n      position: 'absolute',\n      left: barCenterX - 150,\n      top: currentY - 56 - (barSpring * 10),\n      width: 300,\n      textAlign: 'center',\n      fontSize: 36,\n      fontWeight: 700,\n      color: 'white',\n      opacity: barSpring,\n      fontFamily: '\"IBM Plex Mono\", monospace',\n      textShadow: '0px 4px 12px rgba(0,0,0,0.4)'\n    };\n\n    const unitStyle = {\n      fontSize: 22,\n      fontFamily: '\"Noto Sans SC\", sans-serif',\n      marginLeft: 6,\n      fontWeight: 400,\n      opacity: 0.8\n    };\n\n    const categoryStyle = {\n      position: 'absolute',\n      left: barCenterX - 150,\n      top: chartTop + chartHeight + 24,\n      width: 300,\n      textAlign: 'center',\n      fontSize: 28,\n      fontWeight: 500,\n      color: `rgba(255,255,255,${barSpring * 0.95})`,\n      transform: `translateY(${interpolate(barSpring, [0, 1], [20, 0])}px)`\n    };\n\n    return (\n      <div key={`bar-${i}`}>\n        <div style={barContainerStyle}>\n            <div style={innerHighlightStyle} />\n        </div>\n        <div style={labelStyle}>\n          {currentVal}\n          <span style={unitStyle}>{unit}</span>\n        </div>\n        <div style={categoryStyle}>{d.label}</div>\n      </div>\n    );\n  });\n\n  const xAxisStyle = {\n    position: 'absolute',\n    left: chartLeft,\n    top: chartTop + chartHeight,\n    width: chartWidth,\n    height: 3,\n    backgroundColor: `rgba(255,255,255,${gridSpring * 0.4})`,\n    transform: `scaleX(${gridSpring})`,\n    transformOrigin: 'left center'\n  };\n\n  return (\n    <div style={rootStyle}>\n       {gridLines}\n       <div style={xAxisStyle} />\n       {bars}\n       <div style={{\n         position: 'absolute',\n         left: chartLeft,\n         top: 100,\n         opacity: titleSpring,\n         transform: `translateX(${interpolate(titleSpring, [0, 1], [-40, 0])}px)`\n       }}>\n         <h1 style={{\n             margin: 0,\n             fontSize: 64,\n             fontWeight: 700,\n             letterSpacing: 2,\n             color: 'white',\n             textShadow: '0 4px 16px rgba(0,0,0,0.3)'\n         }}>{titleText}</h1>\n         <div style={{\n             marginTop: 16,\n             width: 120,\n             height: 8,\n             backgroundColor: barColor1,\n             borderRadius: 4,\n             transform: `scaleX(${titleSpring})`,\n             transformOrigin: 'left center'\n         }} />\n       </div>\n    </div>\n  );\n};\n"
 },
 {
