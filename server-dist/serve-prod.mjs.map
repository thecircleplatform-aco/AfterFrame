    "defaultValue": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-1.2.1&auto=format&fit=crop&w=1200&q=80",
    "label": "Portrait photo"
   },
   {
    "key": "backgroundColor",
    "type": "color",
    "defaultValue": "#daeff2",
    "label": "Background color"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#1F1F1F",
    "label": "Text color"
   },
   {
    "key": "imageOpacity",
    "type": "number",
    "defaultValue": 0.4,
    "label": "Portrait opacity"
   }
  ],
  "thumb": "/thumbnails/a2abdfc4-c794-4224-b89a-07c0f4009129.jpg",
  "code": "const EditorialIntro = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  // Editable Properties\n  const props = item.props || {};\n  const firstName = props.firstName || 'Marcus';\n  const lastName = props.lastName || 'Alvarado';\n  const roleText = props.role || 'Indie Studio Founder';\n  const backgroundColor = props.backgroundColor || '#daeff2';\n  const textColor = props.textColor || '#1F1F1F';\n  const photoUrl = props.photoUrl || 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-1.2.1&auto=format&fit=crop&w=1200&q=80';\n  const imageOpacity = props.imageOpacity !== undefined ? props.imageOpacity : 0.4;\n\n  // Responsive Scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Timing\n  const durationFrames = Math.round((item?.durationInSeconds || 12) * fps);\n  const outStart = durationFrames - 45; // 45 frames = 1.5s exit window — enough to complete\n\n  // Overdamped spring — smooth ease-in, zero bounce\n  const springCfg = { damping: 30, stiffness: 85 };\n\n  // ── ENTRANCE SEQUENCE (left→right visual flow) ──\n  // Step 1: First name slides in from left (frame 0)\n  const fn = spring({ frame, fps, config: springCfg });\n  const firstNameX  = interpolate(fn, [0, 1], [-180, 0], { extrapolateRight: 'clamp' });\n  const firstNameOp = interpolate(fn, [0, 1], [0, 1],    { extrapolateRight: 'clamp' });\n\n  // Step 2: Last name follows slightly after (frame 8)\n  const ln = spring({ frame: Math.max(0, frame - 8), fps, config: springCfg });\n  const lastNameX  = interpolate(ln, [0, 1], [-180, 0], { extrapolateRight: 'clamp' });\n  const lastNameOp = interpolate(ln, [0, 1], [0, 1],    { extrapolateRight: 'clamp' });\n\n  // Step 3: Role line after last name (frame 18)\n  const rl = spring({ frame: Math.max(0, frame - 18), fps, config: springCfg });\n  const roleOp = interpolate(rl, [0, 1], [0, 1], { extrapolateRight: 'clamp' });\n  const roleX  = interpolate(rl, [0, 1], [-20, 0], { extrapolateRight: 'clamp' });\n\n  // Step 4: Portrait enters from right AFTER text is settled (frame 30–70, linear fade)\n  // Viewer's eye has been anchored left by text; portrait slides in from right side\n  const imgFadeIn = interpolate(frame, [30, 70], [0, imageOpacity], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n    easing: Easing.bezier(0.25, 0, 0.5, 1),\n  });\n  const imgSlideIn = interpolate(frame, [30, 70], [80, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n    easing: Easing.bezier(0.25, 0, 0.5, 1),\n  });\n\n  // ── EXIT SEQUENCE — all elements slide RIGHT and fade out together ──\n  const exitP = interpolate(frame, [outStart, durationFrames], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n    easing: Easing.bezier(0.4, 0, 0.8, 1),\n  });\n  const exitOp = interpolate(exitP, [0, 1], [1, 0]);\n  const exitX  = interpolate(exitP, [0, 1], [0, 120]);   // slide right on exit\n\n  // Styles\n  const rootStyle = {\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor,\n    position: 'relative',\n    overflow: 'hidden',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    fontFamily: '\"Cormorant Garamond\", \"Times New Roman\", serif',\n  };\n\n  // Portrait — right side, slides in from right after text\n  const imageContainerStyle = {\n    position: 'absolute',\n    top: 0,\n    right: 0,\n    bottom: 0,\n    width: '55%',\n    opacity: imgFadeIn * exitOp,\n    transform: `translateX(${imgSlideIn + exitX}px)`,\n    mixBlendMode: 'multiply',\n    filter: 'grayscale(100%) contrast(108%)',\n  };\n\n  const imgStyle = {\n    width: '100%',\n    height: '100%',\n    objectFit: 'cover',\n    objectPosition: 'center 15%',\n    maskImage: 'linear-gradient(to right, transparent 0%, black 55%)',\n    WebkitMaskImage: 'linear-gradient(to right, transparent 0%, black 55%)',\n  };\n\n  // Text block — left side, exits right\n  const contentStyle = {\n    position: 'absolute',\n    top: '50%',\n    left: 180,\n    transform: `translateY(-50%) translateX(${exitX}px)`,\n    opacity: exitOp,\n    zIndex: 10,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n  };\n\n  const lineBase = {\n    color: textColor,\n    fontSize: 250,\n    lineHeight: 0.88,\n    fontWeight: 400,\n    letterSpacing: '-0.05em',\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n  };\n\n  const detailRowStyle = {\n    display: 'flex',\n    alignItems: 'center',\n    marginTop: 48,\n    marginLeft: 8,\n    opacity: roleOp,\n    transform: `translateX(${roleX}px)`,\n  };\n\n  const dashStyle = {\n    width: 72,\n    height: 2,\n    backgroundColor: textColor,\n    marginRight: 24,\n    opacity: 0.6,\n  };\n\n  const roleTextStyle = {\n    color: textColor,\n    fontSize: 34,\n    fontWeight: 400,\n    fontStyle: 'italic',\n    letterSpacing: '0.03em',\n    fontFamily: '\"Cormorant Garamond\", \"Georgia\", serif',\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Portrait — enters after text, from right */}\n      <div style={imageContainerStyle}>\n        <Img src={photoUrl} style={imgStyle} />\n      </div>\n\n      {/* Typography — enters first, from left */}\n      <div style={contentStyle}>\n        {/* First name */}\n        <div style={{ overflow: 'hidden', paddingBottom: 12 }}>\n          <div style={{ ...lineBase, transform: `translateX(${firstNameX}px)`, opacity: firstNameOp }}>\n            {firstName}\n          </div>\n        </div>\n        {/* Last name — offset right for staggered indent */}\n        <div style={{ overflow: 'hidden', paddingBottom: 12 }}>\n          <div style={{ ...lineBase, transform: `translateX(${lastNameX}px)`, opacity: lastNameOp, marginLeft: 56 }}>\n            {lastName}\n          </div>\n        </div>\n        {/* Role line */}\n        <div style={detailRowStyle}>\n          <div style={dashStyle} />\n          <span style={roleTextStyle}>{roleText}</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "8833541d-1d2a-4281-bec2-9139e3d9c6aa",
  "name": "Celebrity Quote Flashcards",
  "category": "quote-cards",
  "description": "A verified social media card overlay with staggered word animations and glowing shadow, perfect for highlighting quotes.",
  "tags": [
   "Mockups & UI、Social Media、Tweet Quotes"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "authorName": "Elena Rossi",
   "authorRole": "Founder, Cielo Coffee",
   "avatarUrl": "",
   "quoteText": "The only way to roast great coffee is to taste every batch yourself.",
   "wordSpeed": 1,
   "cardBackgroundColor": "#ffffff",
   "textColor": "#231411",
   "glowColor": "#a35836",
   "accentColor": "#cf777d"
  },
  "propSchema": [
   {
    "key": "authorName",
    "type": "text",
    "defaultValue": "Elena Rossi",
    "label": "Author Name"
   },
   {
    "key": "authorRole",
    "type": "text",
    "defaultValue": "Founder, Cielo Coffee",
    "label": "Title / Role"
   },
   {
    "key": "avatarUrl",
    "type": "text",
    "defaultValue": "",
    "label": "Avatar Image URL"
   },
   {
    "key": "quoteText",
    "type": "text",
    "defaultValue": "The only way to roast great coffee is to taste every batch yourself.",
    "label": "Quote Text"
   },
   {
    "key": "wordSpeed",
    "type": "number",
    "defaultValue": 1,
    "label": "Word Speed (0.5=Fast / 1=Normal / 2=Slow)",
    "min": 0.2,
    "max": 3,
    "step": 0.1
   },
   {
    "key": "cardBackgroundColor",
    "type": "color",
    "defaultValue": "#ffffff",
    "label": "Card Background Color"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#231411",
    "label": "Quote Text Color"
   },
   {
    "key": "glowColor",
    "type": "color",
    "defaultValue": "#a35836",
    "label": "Glow Color"
   },
   {
    "key": "accentColor",
    "type": "color",
    "defaultValue": "#cf777d",
    "label": "Badge Color"
   }
  ],
  "thumb": "/thumbnails/8833541d-1d2a-4281-bec2-9139e3d9c6aa.jpg",
  "code": "const TweetQuoteCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  // Editable props\n  const props = item.props || {};\n  const authorName = props.authorName || 'Elena Rossi';\n  const authorRole = props.authorRole || 'Founder, Cielo Coffee';\n  const avatarUrl = props.avatarUrl || '';\n  const quoteText = props.quoteText || 'The only way to roast great coffee is to taste every batch yourself.';\n  const cardBg = props.cardBackgroundColor || '#ffffff';\n  const textColor = props.textColor || '#231411';\n  const glowColor = props.glowColor || '#a35836';\n  const accentColor = props.accentColor || '#cf777d';\n  // 1 = normal, 0.5 = faster, 2 = slower\n  const wordSpeed = Math.max(0.2, props.wordSpeed != null ? Number(props.wordSpeed) : 1);\n\n  // Canvas scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const getInitials = (name) =>\n    name.trim().split(' ').map((n) => n[0]).slice(0, 2).join('').toUpperCase();\n\n  // --- Easing: fast-in slow-out (ease-out cubic) ---\n  const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);\n\n  // Card entrance: slide in from right, fast-in slow-out, 18 frames\n  const CARD_DURATION = 18;\n  const cardRawT = Math.min(frame / CARD_DURATION, 1);\n  const cardT = easeOutCubic(cardRawT);\n  const cardTranslateX = interpolate(cardT, [0, 1], [80, 0]);\n  const cardOpacity = interpolate(cardRawT, [0, 0.3], [0, 1], {\n    extrapolateRight: 'clamp',\n  });\n\n  // Card exit fade\n  const fadeOutStart = durationInFrames - 15;\n  const globalOpacity = interpolate(frame, [fadeOutStart, durationInFrames], [1, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  // Author info fade-in after card arrives\n  const AUTHOR_START = 12;\n  const authorRawT = Math.min(Math.max((frame - AUTHOR_START) / 14, 0), 1);\n  const authorT = easeOutCubic(authorRawT);\n  const authorY = interpolate(authorT, [0, 1], [18, 0]);\n  const authorOpacity = authorRawT;\n\n  // Words: slide up (no scale change), short distance, motion blur via CSS filter\n  const words = quoteText.split(' ');\n  const WORD_START = 22;\n  const STAGGER = 3.6 * wordSpeed; // frames between words, scaled by speed\n  const WORD_ANIM_DUR = 14 * wordSpeed; // frames per word animation, scaled by speed\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: 'transparent',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    justifyContent: 'flex-end',\n    alignItems: 'center',\n    paddingRight: '100px',\n    fontFamily: 'Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif',\n    opacity: globalOpacity,\n  };\n\n  const cardStyle = {\n    width: '700px',\n    backgroundColor: cardBg,\n    borderRadius: '22px',\n    padding: '44px 48px',\n    boxShadow: `0 8px 32px -8px rgba(0,0,0,0.12), 0 0 0 1.5px rgba(163,88,54,0.15), 0 0 60px -10px ${glowColor}`,\n    display: 'flex',\n    flexDirection: 'column',\n    gap: '28px',\n    transform: `translateX(${cardTranslateX}px)`,\n    opacity: cardOpacity,\n  };\n\n  const headerStyle = {\n    display: 'flex',\n    alignItems: 'center',\n    gap: '16px',\n    transform: `translateY(${authorY}px)`,\n    opacity: authorOpacity,\n  };\n\n  const avatarStyle = {\n    width: '68px',\n    height: '68px',\n    borderRadius: '50%',\n    backgroundColor: '#332423',\n    color: '#ffffff',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    fontSize: '26px',\n    fontWeight: '700',\n    flexShrink: 0,\n    overflow: 'hidden',\n  };\n\n  const nameStyle = {\n    fontSize: '24px',\n    fontWeight: '700',\n    color: '#000000',\n    lineHeight: '1.2',\n  };\n\n  const roleStyle = {\n    fontSize: '18px',\n    color: '#7c6e6b',\n    marginTop: '3px',\n  };\n\n  const quoteContainerStyle = {\n    fontSize: '40px',\n    fontWeight: '600',\n    color: textColor,\n    lineHeight: '1.4',\n    display: 'flex',\n    flexWrap: 'wrap',\n    columnGap: '0.22em',\n    rowGap: '0.05em',\n  };\n\n  const VerifiedBadge = () => (\n    <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill={accentColor} style={{ flexShrink: 0 }}>\n      <path d=\"M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .495.083.965.238 1.4-1.272.65-2.147 2.02-2.147 3.6 0 1.457.748 2.795 1.843 3.475-.062.46-.104.927-.104 1.402 0 2.486 2.013 4.5 4.5 4.5.475 0 .942-.042 1.402-.104.68 1.094 2.018 1.843 3.475 1.843s2.795-.748 3.475-1.843c.46.062.927.104 1.402.104 2.486 0 4.5-2.013 4.5-4.5 0-.475-.042-.94-.104-1.402 1.094-.68 1.843-2.018 1.843-3.475zm-9.933 6.93l-4-4 1.414-1.414 2.586 2.586 5.586-5.586 1.414 1.414-7 7z\" />\n    </svg>\n  );\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        {/* Author header */}\n        <div style={headerStyle}>\n          <div style={avatarStyle}>\n            {avatarUrl\n              ? <Img src={avatarUrl} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />\n              : <span>{getInitials(authorName)}</span>\n            }\n          </div>\n          <div style={{ display: 'flex', flexDirection: 'column' }}>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '7px' }}>\n              <span style={nameStyle}>{authorName}</span>\n              <VerifiedBadge />\n            </div>\n            <span style={roleStyle}>{authorRole}</span>\n          </div>\n        </div>\n\n        {/* Quote with word-by-word slide-up */}\n        <div style={quoteContainerStyle}>\n          {words.map((word, i) => {\n            const wordDelay = WORD_START + i * STAGGER;\n            const rawT = Math.min(Math.max((frame - wordDelay) / WORD_ANIM_DUR, 0), 1);\n            const t = easeOutCubic(rawT);\n\n            // Short travel distance only, no scale\n            const wordY = interpolate(t, [0, 1], [20, 0]);\n            const wordOpacity = interpolate(rawT, [0, 0.4], [0, 1], {\n              extrapolateRight: 'clamp',\n            });\n\n            // Motion blur: decays quickly, fully gone by rawT=0.6 to avoid late-frame flicker\n            const blurRaw = interpolate(rawT, [0, 0.6], [1, 0], {\n              extrapolateLeft: 'clamp',\n              extrapolateRight: 'clamp',\n            });\n            const blurAmount = easeOutCubic(blurRaw) * 3;\n\n            return (\n              <span\n                key={i}\n                style={{\n                  display: 'inline-block',\n                  overflow: 'hidden',\n                  verticalAlign: 'bottom',\n                  lineHeight: '1.5em',\n                  height: '1.5em',\n                }}\n              >\n                <span\n                  style={{\n                    display: 'inline-block',\n                    transform: `translateY(${wordY}px)`,\n                    opacity: wordOpacity,\n                    filter: `blur(${blurAmount}px)`,\n                  }}\n                >\n                  {word}\n                </span>\n              </span>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "ef4231df-8e0a-43b8-9dfc-76bac9c1eeb9",
  "name": "Quote Card",
  "category": "quote-cards",
  "description": "A classic 8-bit style stacked paper card that slides in from the right, featuring a staggered multi-line text reveal.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "quoteText": "THE BEST TRIP TO\nPLAN WAS LAST SPRING.\nTHE SECOND BEST\nTIME IS NOW.",
   "fontSize": 20,
   "textColor": "#030100",
   "bgColor": "#faf3e5",
   "borderColor": "#030100"
  },
  "propSchema": [
   {
    "key": "quoteText",
    "type": "text",
    "defaultValue": "THE BEST TRIP TO\nPLAN WAS LAST SPRING.\nTHE SECOND BEST\nTIME IS NOW.",
    "label": "Quote Text"
   },
   {
    "key": "fontSize",
    "type": "number",
    "defaultValue": 20,
    "label": "Font Size",
    "min": 10,
    "step": 1
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#030100",
    "label": "Text Color"
   },
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#faf3e5",
    "label": "Background Color"
   },
   {
    "key": "borderColor",
    "type": "color",
    "defaultValue": "#030100",
    "label": "Border Color"
   }
  ],
  "thumb": "/thumbnails/ef4231df-8e0a-43b8-9dfc-76bac9c1eeb9.jpg",
  "code": "const SmartTitleCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const props = item.props || {};\n  const quoteText = props.quoteText || 'THE BEST TRIP TO\\nPLAN WAS LAST SPRING.\\nTHE SECOND BEST\\nTIME IS NOW.';\n  const fontFamily = props.fontFamily || '\"Press Start 2P\", monospace';\n  const fontSize = props.fontSize || 20;\n  const textColor = props.textColor || '#030100';\n  const bgColor = props.bgColor || '#faf3e5';\n  const borderColor = props.borderColor || '#030100';\n\n  const DESIGN_WIDTH = 780;\n  const DESIGN_HEIGHT = 280;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    overflow: 'hidden',\n  };\n\n  // Snappy retro spring entrance\n  const slideIn = spring({\n    frame,\n    fps,\n    config: { damping: 15, stiffness: 120 },\n  });\n  \n  // Slide from right side of the screen\n  const xOffset = interpolate(slideIn, [0, 1], [800, 0]);\n\n  const cardStyle = {\n    position: 'absolute',\n    left: 60,\n    top: 24,\n    width: 660,\n    height: 220,\n    backgroundColor: bgColor,\n    border: `2px solid ${borderColor}`,\n    boxSizing: 'border-box',\n    boxShadow: `6px 6px 0px 0px ${bgColor}, 6px 6px 0px 2px ${borderColor}, 12px 12px 0px 0px ${bgColor}, 12px 12px 0px 2px ${borderColor}`,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    transform: `translateX(${xOffset}px)`,\n  };\n\n  const lines = quoteText.split('\\n');\n  const textStartFrame = 15;\n  const staggerFrames = 5; // ~0.15s at 30fps\n  const fadeDuration = 10;\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        {lines.map((line, i) => {\n          const lineOpacity = interpolate(\n            frame,\n            [textStartFrame + i * staggerFrames, textStartFrame + i * staggerFrames + fadeDuration],\n            [0, 1],\n            { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n          );\n\n          return (\n            <div\n              key={i}\n              style={{\n                fontFamily,\n                fontSize: `${fontSize}px`,\n                color: textColor,\n                lineHeight: 1.8,\n                textAlign: 'center',\n                textTransform: 'uppercase',\n                opacity: lineOpacity,\n                whiteSpace: 'pre',\n              }}\n            >\n              {line}\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
