  "thumb": "/thumbnails/a7b5e885-25ae-4970-9d5e-d451e9d8da7a.jpg",
  "code": "const MonthlySalesInfographic = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  // --- Props & Configuration ---\n  const props = item.props || {};\n  const titleText = props.titleText || 'Trip Bookings';\n  const kpiValue = props.kpiValue || '68%';\n  const kpiLabel = props.kpiLabel || 'more bookings';\n  const backgroundColor = props.backgroundColor || '#E8E6F0';\n  const cardColor = props.cardColor || '#FFFFFF';\n  const accentColor1 = props.accentColor1 || '#ffaced'; // Cyan\n  const accentColor2 = props.accentColor2 || '#6d72e5'; // Blue\n  const titleColor = props.titleColor || '#333333';\n  const kpiColor = props.kpiColor || '#ffaced';\n  const watermarkSymbol = props.watermarkSymbol || '$';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n\n  // Bar Data (Editable via individual props for simplicity in this schema)\n  const dataPoints = [\n    { label: 'Jan', value: props.val1 ?? 42 },\n    { label: 'Feb', value: props.val2 ?? 58 },\n    { label: 'Mar', value: props.val3 ?? 35 },\n    { label: 'Apr', value: props.val4 ?? 71 },\n    { label: 'May', value: props.val5 ?? 89 },\n    { label: 'Jun', value: props.val6 ?? 63 },\n  ];\n\n  const yAxisLabels = ['100%', '75%', '50%', '25%', '0%'];\n  const maxVal = 100;\n\n  // --- Responsive Scaling ---\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // --- Helpers ---\n  // Slow, smooth spring for the 2s growth feel\n  const growthSpring = (delay) =>\n    spring({\n      frame: Math.max(0, frame - delay),\n      fps,\n      config: { mass: 2.5, damping: 25, stiffness: 120 },\n    });\n\n  // --- Styles ---\n  const rootStyle = {\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor,\n    fontFamily,\n    position: 'relative',\n    overflow: 'hidden',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n  };\n\n  const cardStyle = {\n    width: 1400,\n    height: 800,\n    backgroundColor: cardColor,\n    borderRadius: 40,\n    boxShadow: '0 20px 60px rgba(0,0,0,0.08)',\n    position: 'relative',\n    padding: '60px 80px',\n    display: 'flex',\n    flexDirection: 'column',\n    overflow: 'hidden', // clips the watermark\n  };\n\n  // Watermark\n  const watermarkStyle = {\n    position: 'absolute',\n    right: -50,\n    bottom: -80,\n    fontSize: 600,\n    fontWeight: 900,\n    color: '#000000',\n    opacity: 0.03,\n    lineHeight: 1,\n    pointerEvents: 'none',\n    zIndex: 0,\n  };\n\n  // Header Area\n  const headerStyle = {\n    display: 'flex',\n    justifyContent: 'space-between',\n    alignItems: 'flex-start',\n    marginBottom: 40,\n    zIndex: 2,\n    position: 'relative',\n  };\n\n  const titleStyle = {\n    fontSize: 56,\n    fontWeight: 700,\n    color: titleColor,\n    letterSpacing: '-0.02em',\n  };\n\n  const kpiContainerStyle = {\n    textAlign: 'right',\n  };\n\n  const kpiValueStyle = {\n    fontSize: 80,\n    fontWeight: 800,\n    color: kpiColor,\n    lineHeight: 1,\n  };\n\n  const kpiLabelStyle = {\n    fontSize: 24,\n    fontWeight: 500,\n    color: '#8b8798',\n    marginTop: 8,\n  };\n\n  // Chart Area\n  const chartContainerStyle = {\n    flex: 1,\n    position: 'relative',\n    display: 'flex',\n    zIndex: 2,\n  };\n\n  const yAxisStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'space-between',\n    height: '100%',\n    paddingRight: 20,\n    paddingBottom: 40, // Space for x-axis labels\n  };\n\n  const gridLineLabelStyle = {\n    fontSize: 20,\n    color: '#ada9ba',\n    fontWeight: 500,\n    textAlign: 'right',\n    transform: 'translateY(50%)', // Center label vertically on line\n  };\n\n  const gridLinesContainerStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 60,\n    right: 0,\n    bottom: 40,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'space-between',\n    zIndex: 1,\n  };\n\n  const gridLineStyle = {\n    width: '100%',\n    height: 1,\n    backgroundColor: '#f1edfe',\n  };\n\n  const barsAreaStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 80,\n    right: 0,\n    bottom: 0,\n    display: 'flex',\n    alignItems: 'flex-end',\n    justifyContent: 'space-around',\n    zIndex: 3,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        {/* Watermark */}\n        <div style={watermarkStyle}>{watermarkSymbol}</div>\n\n        {/* Header */}\n        <div style={headerStyle}>\n          <div style={titleStyle}>{titleText}</div>\n          <div style={kpiContainerStyle}>\n            <div style={kpiValueStyle}>{kpiValue}</div>\n            <div style={kpiLabelStyle}>{kpiLabel}</div>\n          </div>\n        </div>\n\n        {/* Chart */}\n        <div style={chartContainerStyle}>\n          {/* Y Axis Labels */}\n          <div style={yAxisStyle}>\n            {yAxisLabels.map((label, i) => (\n              <div key={i} style={gridLineLabelStyle}>\n                {label}\n              </div>\n            ))}\n          </div>\n\n          {/* Grid Lines */}\n          <div style={gridLinesContainerStyle}>\n            {yAxisLabels.map((_, i) => (\n              <div key={i} style={gridLineStyle} />\n            ))}\n          </div>\n\n          {/* Bars */}\n          <div style={barsAreaStyle}>\n            {dataPoints.map((dp, i) => {\n              // Stagger delay: 5 frames per bar\n              const progress = growthSpring(i * 5);\n              // Current display value\n              const currentVal = Math.round(progress * dp.value);\n              // Bar height calculation\n              const barHeightPercent = (dp.value / maxVal) * 100 * progress;\n              const color = i % 2 === 0 ? accentColor1 : accentColor2;\n\n              return (\n                <div\n                  key={i}\n                  style={{\n                    display: 'flex',\n                    flexDirection: 'column',\n                    alignItems: 'center',\n                    justifyContent: 'flex-end',\n                    height: '100%',\n                    width: '10%',\n                  }}\n                >\n                  {/* Number Label above bar */}\n                  <div\n                    style={{\n                      marginBottom: 12,\n                      fontSize: 24,\n                      fontWeight: 700,\n                      color: '#585465',\n                      opacity: progress, // Fade in label\n                      transform: `translateY(${10 - progress * 10}px)`,\n                    }}\n                  >\n                    {currentVal}\n                  </div>\n\n                  {/* The Bar */}\n                  <div\n                    style={{\n                      width: '60%',\n                      height: `${barHeightPercent}%`,\n                      backgroundColor: color,\n                      borderRadius: '8px 8px 0 0',\n                      boxShadow: '0 4px 12px rgba(0,0,0,0.1)',\n                    }}\n                  />\n\n                  {/* X Axis Label */}\n                  <div\n                    style={{\n                      marginTop: 16,\n                      height: 40,\n                      fontSize: 20,\n                      fontWeight: 600,\n                      color: '#9c98a9',\n                    }}\n                  >\n                    {dp.label}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "1c49b2f1-3dce-4953-afd1-674ae0a285e8",
  "name": "Bar Chart - Monthly Targets",
  "category": "data-visualization",
  "description": "A minimal grouped bar chart comparing actual vs target performance with smooth staggered entry animations and a warm gradient background.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "GROOMING BOOKINGS",
   "subtitleText": "Booked vs Goal Volume (sessions)",
   "bgGradientStart": "#f0fbf7",
   "bgGradientEnd": "#e2f5ee",
   "actualColor": "#0ea67c",
   "targetColor": "rgba(14,166,124,0.20)",
   "textColor": "#123a2e",
   "gridColor": "rgba(16,58,45,0.10)"
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "GROOMING BOOKINGS",
    "label": "Chart Title"
   },
   {
    "key": "subtitleText",
