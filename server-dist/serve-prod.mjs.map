   {
    "key": "g2Single",
    "type": "number",
    "defaultValue": 3920,
    "label": "Dripline Price Score",
    "min": 100,
    "max": 20000
   },
   {
    "key": "g2Multi",
    "type": "number",
    "defaultValue": 7640,
    "label": "Dripline Ambiance Score",
    "min": 100,
    "max": 20000
   },
   {
    "key": "g3Phone",
    "type": "text",
    "defaultValue": "GreenCell Power",
    "label": "Group 3 Name"
   },
   {
    "key": "g3Chip",
    "type": "text",
    "defaultValue": "Legacy inverter, local trust",
    "label": "Group 3 Subtitle"
   },
   {
    "key": "g3Single",
    "type": "number",
    "defaultValue": 2780,
    "label": "Daily Grind Price Score",
    "min": 100,
    "max": 20000
   },
   {
    "key": "g3Multi",
    "type": "number",
    "defaultValue": 5995,
    "label": "Daily Grind Ambiance Score",
    "min": 100,
    "max": 20000
   },
   {
    "key": "singleColorStart",
    "type": "color",
    "defaultValue": "#00a490",
    "label": "Price Bar Gradient Start"
   },
   {
    "key": "singleColorEnd",
    "type": "color",
    "defaultValue": "#85e09a",
    "label": "Price Bar Gradient End"
   },
   {
    "key": "multiColorStart",
    "type": "color",
    "defaultValue": "#a28000",
    "label": "Ambiance Bar Gradient Start"
