  "thumb": "/thumbnails/893c85e4-940f-4cbc-b0fc-2db3a2f48392.jpg",
  "code": "const QuoteCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const line3Text = props.line3Text;\n  const line4Text = props.line4Text;\n  const fontFamily = props.fontFamily;\n  const bgColor = props.bgColor;\n  const primaryColor = props.primaryColor;\n  const accentColor = props.accentColor;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const staggerDelay = safeFps * 0.5;\n\n  const anim1 = spring({ frame, fps: safeFps, config: { damping: 15, mass: 1, stiffness: 80 }});\n  const anim2 = spring({ frame: Math.max(0, frame - staggerDelay), fps: safeFps, config: { damping: 15, mass: 1, stiffness: 80 }});\n  const anim3 = spring({ frame: Math.max(0, frame - staggerDelay * 2), fps: safeFps, config: { damping: 15, mass: 1, stiffness: 80 }});\n  const anim4 = spring({ frame: Math.max(0, frame - staggerDelay * 3), fps: safeFps, config: { damping: 15, mass: 1, stiffness: 80 }});\n\n  const yDist = 80;\n  const y1 = interpolate(anim1, [0, 1], [yDist, 0]);\n  const y2 = interpolate(anim2, [0, 1], [yDist, 0]);\n  const y3 = interpolate(anim3, [0, 1], [yDist, 0]);\n  const y4 = interpolate(anim4, [0, 1], [yDist, 0]);\n\n  const op1 = Math.min(1, Math.max(0, anim1));\n  const op2 = Math.min(1, Math.max(0, anim2));\n  const op3 = Math.min(1, Math.max(0, anim3));\n  const op4 = Math.min(1, Math.max(0, anim4));\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    fontFamily: fontFamily,\n    fontWeight: 'bold',\n    fontSize: '110px',\n    lineHeight: 1.2,\n    textAlign: 'center'\n  };\n\n  const line1Style = {\n    opacity: op1,\n    transform: `translateY(${y1}px)`,\n    color: primaryColor\n  };\n  const line2Style = {\n    opacity: op2,\n    transform: `translateY(${y2}px)`,\n    color: primaryColor\n  };\n  const line3Style = {\n    opacity: op3,\n    transform: `translateY(${y3}px)`,\n    color: primaryColor\n  };\n  const line4Style = {\n    opacity: op4,\n    transform: `translateY(${y4}px)`,\n    color: accentColor\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={line1Style}>{line1Text}</div>\n      <div style={line2Style}>{line2Text}</div>\n      <div style={line3Style}>{line3Text}</div>\n      <div style={line4Style}>{line4Text}</div>\n    </div>\n  );\n};"
 },
