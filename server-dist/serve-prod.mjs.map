    "label": "字体"
   }
  ],
  "thumb": "/thumbnails/4dfa6822-7089-4908-a4e5-3e4d5720f2df.jpg",
  "code": "const FloatingQuestions = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const markText = props.markText;\n  const fillColor = props.fillColor;\n  const strokeColor = props.strokeColor;\n  const fontFamily = props.fontFamily;\n  const strokeWidth = props.strokeWidth;\n  const bobAmplitude = props.bobAmplitude;\n  const introAnimation = props.introAnimation;\n  const arcRadius = props.arcRadius !== undefined ? props.arcRadius : 120;\n  const spread = props.spread !== undefined ? props.spread : 90;\n\n  const safeFps = fps || 30;\n  const totalFrames = durationInFrames || 90;\n\n  // Outro: fade + scale out over last 12 frames\n  const outroStart = totalFrames - 12;\n  const outroProgress = frame >= outroStart\n    ? Math.min(1, (frame - outroStart) / 12)\n    : 0;\n  const globalOpacity = 1 - outroProgress;\n  const globalOutroScale = 1 - outroProgress * 0.15;\n\n  // Arc layout: 5 marks spread along a circular arc (top half)\n  const count = 5;\n  const marks = Array.from({length: count}, (_, i) => {\n    // angle from -spread/2 to +spread/2 in degrees, centered at top (270deg)\n    const t = count > 1 ? i / (count - 1) : 0.5;\n    const angleDeg = -spread / 2 + t * spread;\n    const angleRad = (angleDeg - 90) * (Math.PI / 180); // offset so 0deg = top\n    const x = Math.cos(angleRad) * arcRadius;\n    const y = Math.sin(angleRad) * arcRadius;\n    const sizeFactor = 1 - Math.abs(t - 0.5) * 0.3; // center slightly bigger\n    const baseSize = 85 * sizeFactor;\n    const rotation = angleDeg * 0.4; // slight tilt following arc\n    const phase = i * 1.2;\n    return { id: i + 1, x, y, size: baseSize, r: rotation, phase };\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: 'transparent',\n    opacity: globalOpacity,\n    transform: `scale(${globalOutroScale})`,\n    overflow: 'visible',\n  };\n\n  const containerStyle = {\n    position: 'absolute',\n    left: '50%',\n    top: '75%',\n    width: 0,\n    height: 0,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={containerStyle}>\n        {marks.map((m, i) => {\n          const delay = i * 2;\n          const springFrame = Math.max(0, frame - delay);\n\n          let scale = 1;\n          if (introAnimation) {\n            scale = spring({\n              frame: springFrame,\n              fps: safeFps,\n              config: { damping: 14, stiffness: 200 }\n            });\n          }\n\n          const floatY = Math.sin((frame / 90) * Math.PI * 4 + m.phase) * bobAmplitude;\n          const markTransform = `translate(-50%, -50%) scale(${scale}) translateY(${floatY}px) rotate(${m.r}deg)`;\n\n          const markStyle = {\n            position: 'absolute',\n            left: m.x,\n            top: m.y,\n            transform: markTransform,\n            display: 'flex',\n            justifyContent: 'center',\n            alignItems: 'center',\n            width: m.size * 1.5,\n            height: m.size * 1.5,\n          };\n\n          const strokeLayerStyle = {\n            position: 'absolute',\n            fontSize: m.size,\n            fontFamily: fontFamily,\n            fontWeight: 900,\n            color: fillColor,\n            WebkitTextStroke: `${strokeWidth}px ${strokeColor}`,\n            textShadow: `0px 6px 12px rgba(0,3,1,0.15)`,\n            zIndex: 1,\n            lineHeight: 1,\n          };\n\n          const fillLayerStyle = {\n            position: 'absolute',\n            fontSize: m.size,\n            fontFamily: fontFamily,\n            fontWeight: 900,\n            color: fillColor,\n            zIndex: 2,\n            lineHeight: 1,\n          };\n\n          return (\n            <div key={m.id} style={markStyle}>\n              <div style={strokeLayerStyle}>{markText}</div>\n              <div style={fillLayerStyle}>{markText}</div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "d466a3cb-a87f-4bf1-9da2-a074d9c4ef6f",
  "name": "Red Passion Chapter Card",
  "category": "title-cards",
  "description": "High-contrast chapter card with bold headline typography and dramatic red-accented presentation.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "mainText": "Fresh Start Now",
   "subText": "Member Rewards",
   "sphereNumber": "",
   "animSpeed": 1
  },
  "propSchema": [
   {
    "key": "mainText",
    "type": "text",
    "defaultValue": "Fresh Start Now",
    "label": "Main title"
   },
   {
    "key": "subText",
    "type": "text",
    "defaultValue": "Member Rewards",
    "label": "Subtitle"
   },
   {
    "key": "sphereNumber",
    "type": "text",
    "defaultValue": "",
    "label": "Badge number"
   },
   {
    "key": "animSpeed",
    "type": "number",
    "defaultValue": 1,
    "label": "Animation speed"
   }
  ],
  "thumb": "/thumbnails/d466a3cb-a87f-4bf1-9da2-a074d9c4ef6f.jpg",
  "code": "const RedPassionChapterCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  // Editable properties\n  const mainText = item?.propertyOverrides?.mainText ?? 'Fresh Start Now';\n  const subText = item?.propertyOverrides?.subText ?? 'Member Rewards';\n  const sphereNumber = item?.propertyOverrides?.sphereNumber ?? '';\n  const sphereXProp = item?.propertyOverrides?.sphereX ?? 300;\n  const sphereYProp = item?.propertyOverrides?.sphereY ?? 120;\n  const bannerMaxWidth = item?.propertyOverrides?.bannerMaxWidth ?? 620;\n  const bannerPaddingRight = item?.propertyOverrides?.bannerPaddingRight ?? 30;\n  const animSpeed = item?.propertyOverrides?.animSpeed ?? 1;\n  const exitDuration = item?.propertyOverrides?.exitDuration ?? 30;\n\n  // Design Dimensions\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Animation logic\n  const isExiting = frame > durationInFrames - exitDuration;\n  const animFrame = isExiting\n    ? Math.max(0, durationInFrames - frame)\n    : frame;\n  const scaledFrame = animFrame / Math.max(0.1, animSpeed);\n\n  // Spring Configurations\n  const sphereSpring = spring({\n    frame: scaledFrame,\n    fps,\n    config: { damping: 14, stiffness: 100 },\n  });\n\n  const bannerSpring = spring({\n    frame: Math.max(0, scaledFrame - 10),\n    fps,\n    config: { damping: 16, stiffness: 90 },\n  });\n\n  const textSpring = spring({\n    frame: Math.max(0, scaledFrame - 20),\n    fps,\n    config: { damping: 20 },\n  });\n\n  // Interpolations\n  const sphereScale = interpolate(sphereSpring, [0, 1], [0, 1]);\n  const sphereRotate = interpolate(sphereSpring, [0, 1], [-180, 0]);\n\n  const bannerWidth = interpolate(bannerSpring, [0, 1], [0, bannerMaxWidth]);\n  const textOpacity = interpolate(textSpring, [0, 1], [0, 1]);\n  const textTranslate = interpolate(textSpring, [0, 1], [-40, 0]);\n\n  // Colors\n  const colors = {\n    sphereGradient: 'radial-gradient(circle at 35% 35%, #fe2134 0%, #e4001a 50%, #a00011 100%)',\n    bannerBg: '#ffffff',\n    bannerBorder: '#a00011',\n    subStripBg: '#870513',\n    subText: '#ff6c18',\n    mainText: '#352416',\n    number: '#ffffff',\n  };\n\n  // Layout positions\n  const sphereX = sphereXProp;\n  const sphereY = sphereYProp;\n  const sphereRadius = 55;\n  const bannerHeight = 100;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: 'transparent',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    fontFamily: '\"Montserrat\", \"Inter\", sans-serif',\n  };\n\n  const sphereContainerStyle = {\n    position: 'absolute',\n    left: sphereX - sphereRadius,\n    top: sphereY - sphereRadius,\n    width: sphereRadius * 2,\n    height: sphereRadius * 2,\n    borderRadius: '50%',\n    background: colors.sphereGradient,\n    boxShadow: '0 12px 35px rgba(160,0,17, 0.6)',\n    zIndex: 20,\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    transform: `scale(${sphereScale}) rotate(${sphereRotate}deg)`,\n  };\n\n  const numberStyle = {\n    color: colors.number,\n    fontSize: 56,\n    fontWeight: 900,\n    fontFamily: 'sans-serif',\n  };\n\n  const bannerMaskStyle = {\n    position: 'absolute',\n    left: sphereX,\n    top: sphereY - bannerHeight / 2,\n    height: bannerHeight,\n    width: bannerWidth,\n    overflow: 'hidden',\n    zIndex: 10,\n    filter: 'drop-shadow(0 6px 16px rgba(0,0,0,0.2))',\n    transformOrigin: 'left center',\n  };\n\n  const bannerContentStyle = {\n    width: bannerMaxWidth,\n    height: '100%',\n    background: colors.bannerBg,\n    border: `3px solid ${colors.bannerBorder}`,\n    borderLeft: 'none',\n    borderTopRightRadius: 16,\n    borderBottomRightRadius: 16,\n    display: 'flex',\n    flexDirection: 'column',\n    position: 'relative',\n  };\n\n  const mainTitleSectionStyle = {\n    flex: 1,\n    display: 'flex',\n    alignItems: 'center',\n    paddingLeft: sphereRadius + 30,\n    paddingRight: bannerPaddingRight,\n  };\n\n  const mainTextStyle = {\n    fontSize: 34,\n    fontWeight: 800,\n    color: colors.mainText,\n    textTransform: 'uppercase',\n    letterSpacing: '-0.03em',\n    lineHeight: 1,\n    opacity: textOpacity,\n    transform: `translateX(${textTranslate}px)`,\n    whiteSpace: 'nowrap',\n  };\n\n  const subStripSectionStyle = {\n    height: 38,\n    backgroundColor: colors.subStripBg,\n    display: 'flex',\n    alignItems: 'center',\n    paddingLeft: sphereRadius + 30,\n    paddingRight: bannerPaddingRight,\n    borderBottomRightRadius: 12,\n  };\n\n  const subTextStyle = {\n    fontSize: 16,\n    fontWeight: 700,\n    color: colors.subText,\n    textTransform: 'uppercase',\n    letterSpacing: '0.2em',\n    opacity: textOpacity,\n    transform: `translateX(${textTranslate}px)`,\n    whiteSpace: 'nowrap',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={bannerMaskStyle}>\n        <div style={bannerContentStyle}>\n          <div style={mainTitleSectionStyle}>\n            <div style={mainTextStyle}>{mainText}</div>\n          </div>\n          <div style={subStripSectionStyle}>\n            <div style={subTextStyle}>{subText}</div>\n          </div>\n        </div>\n      </div>\n\n      <div style={sphereContainerStyle}>\n        {sphereNumber ? <span style={numberStyle}>{sphereNumber}</span> : null}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "0280ff3f-b1af-498b-9069-b849929f8df9",
