  "thumb": "/thumbnails/c1d4287a-a6b4-4710-a1dd-bc6420554923.jpg",
  "code": "const TechTrends = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const label1 = props.label1;\n  const val1 = props.val1;\n  const label2 = props.label2;\n  const val2 = props.val2;\n  const label3 = props.label3;\n  const val3 = props.val3;\n  const label4 = props.label4;\n  const val4 = props.val4;\n  \n  const titleFontFamily = props.titleFontFamily;\n  const labelFontFamily = props.labelFontFamily;\n  const gradientStart = props.gradientStart;\n  const gradientEnd = props.gradientEnd;\n  const textColor = props.textColor;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  const globalOpacity = interpolate(frame, [durationInFrames - 20, durationInFrames - 5], [1, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  const titleOpacity = interpolate(frame, [0, 15], [0, 1], { extrapolateRight: 'clamp' });\n  const titleSpring = spring({ frame, fps, config: { damping: 15 } });\n  const titleY = interpolate(titleSpring, [0, 1], [40, 0]);\n\n  const bars = [\n    { label: label1, val: val1, delay: 24 },\n    { label: label2, val: val2, delay: 48 },\n    { label: label3, val: val3, delay: 72 },\n    { label: label4, val: val4, delay: 96 }\n  ];\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    padding: '0 160px',\n    opacity: globalOpacity\n  };\n\n  const blobStyle = {\n    position: 'absolute',\n    top: -300,\n    right: -200,\n    width: 1200,\n    height: 1200,\n    background: `radial-gradient(circle, ${gradientStart} 0%, ${gradientEnd} 40%, transparent 70%)`,\n    opacity: 0.35,\n    borderRadius: '50%',\n    zIndex: 0\n  };\n\n  const blob2Style = {\n    position: 'absolute',\n    bottom: -200,\n    left: -200,\n    width: 800,\n    height: 800,\n    background: `radial-gradient(circle, ${gradientEnd} 0%, transparent 60%)`,\n    opacity: 0.15,\n    borderRadius: '50%',\n    zIndex: 0\n  };\n\n  const contentStyle = {\n    position: 'relative',\n    zIndex: 1,\n    display: 'flex',\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    gap: 80\n  };\n\n  const titleStyle = {\n    fontFamily: titleFontFamily,\n    fontSize: 56,\n    fontWeight: 300,\n    letterSpacing: '0.15em',\n    lineHeight: 1.15,\n    color: textColor,\n    margin: 0,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n    flex: 1\n  };\n\n  const barsContainerStyle = {\n    flex: 1,\n    display: 'flex',\n    flexDirection: 'column',\n    gap: 48,\n    position: 'relative',\n    padding: 40\n  };\n\n  const gridStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundImage: `radial-gradient(circle, ${textColor} 1.5px, transparent 1.5px)`,\n    backgroundSize: '24px 24px',\n    opacity: 0.08,\n    zIndex: -1,\n    borderRadius: 24\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={blobStyle} />\n      <div style={blob2Style} />\n      \n      <div style={contentStyle}>\n        <h1 style={titleStyle}>\n          {titleText.split('\\n').map((line, i) => (\n            <div key={i}>{line}</div>\n          ))}\n        </h1>\n\n        <div style={barsContainerStyle}>\n          <div style={gridStyle} />\n          \n          {bars.map((bar, i) => {\n            const barAnim = spring({ \n              frame: Math.max(0, frame - bar.delay), \n              fps, \n              config: { damping: 15, mass: 0.8 } \n            });\n            \n            const barOpacity = interpolate(barAnim, [0, 1], [0, 1]);\n            const barWidth = interpolate(barAnim, [0, 1], [0, bar.val]);\n            const displayVal = Math.round(bar.val * barAnim);\n\n            return (\n              <div \n                key={i} \n                style={{ \n                  display: 'flex', \n                  flexDirection: 'column', \n                  gap: 16,\n                  opacity: barOpacity,\n                  transform: `translateY(${interpolate(barAnim, [0, 1], [20, 0])}px)`\n                }}\n              >\n                <div style={{ \n                  display: 'flex', \n                  justifyContent: 'space-between', \n                  alignItems: 'baseline',\n                  fontFamily: labelFontFamily,\n                  color: textColor\n                }}>\n                  <span style={{ fontSize: 20, fontWeight: 500 }}>{bar.label}</span>\n                  <span style={{ fontSize: 20, fontWeight: 700, opacity: 0.8 }}>{displayVal}%</span>\n                </div>\n                \n                <div style={{ \n                  width: '100%', \n                  height: 32, \n                  backgroundColor: 'rgba(0,0,0,0.05)', \n                  borderRadius: 4, \n                  overflow: 'hidden'\n                }}>\n                  <div style={{ \n                    width: `${barWidth}%`, \n                    height: '100%', \n                    background: `linear-gradient(90deg, ${gradientStart}, ${gradientEnd})`,\n                    borderRadius: 4\n                  }} />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
