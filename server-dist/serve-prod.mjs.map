    "label": "Font"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#ffffff",
    "label": "Text Color"
   },
   {
    "key": "ribbonColorStart",
    "type": "color",
    "defaultValue": "#b42e45",
    "label": "Ribbon Start"
   },
   {
    "key": "ribbonColorMid",
