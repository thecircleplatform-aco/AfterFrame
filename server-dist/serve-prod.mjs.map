  "thumb": "/thumbnails/b5cb1e75-4e94-4f37-b5c6-4c309320b2bd.jpg",
  "code": "const MinimalTeamPresentation = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const titleFontFamily = props.titleFontFamily;\n  const fontFamily = props.fontFamily;\n  const textColor = props.textColor;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const accentColor1 = props.accentColor1;\n  const accentColor2 = props.accentColor2;\n\n  const members = [\n    { name: props.member1Name, role: props.member1Role, img: props.member1Img, delay: 30 },\n    { name: props.member2Name, role: props.member2Role, img: props.member2Img, delay: 50 },\n    { name: props.member3Name, role: props.member3Role, img: props.member3Img, delay: 70 }\n  ];\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  // --- Easing ---\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n\n  // --- Exit ---\n  const totalFrames = durationInFrames || 150;\n  const exitStart = totalFrames - 25;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / 25));\n  const exitProgress = exitRaw * exitRaw;\n  const exitOpacity = 1 - exitProgress;\n  const exitScale = 1 - exitProgress * 0.02;\n\n  // --- Blobs: scale 1.04 → 1.0, opacity staggered, gentle sin/cos drift ---\n  const blob1FadeRaw = Math.min(1, Math.max(0, frame / 40));\n  const blob1Opacity = smoothSettle(blob1FadeRaw) * 0.7;\n  const blob2FadeRaw = Math.min(1, Math.max(0, (frame - 8) / 40));\n  const blob2Opacity = smoothSettle(blob2FadeRaw) * 0.6;\n\n  const blob1DriftX = Math.sin(frame / 55) * 8;\n  const blob1DriftY = Math.cos(frame / 70) * 6;\n  const blob2DriftX = Math.sin(frame / 65) * 7;\n  const blob2DriftY = Math.cos(frame / 50) * 5;\n\n  // --- Title: starts frame 5, 50 frames ---\n  const titleRaw = Math.min(1, Math.max(0, (frame - 5) / 50));\n  const titleProgress = smoothSettle(titleRaw);\n  const titleOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - 5) / 18)));\n  const titleY = (1 - titleProgress) * 60;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden',\n    fontFamily: fontFamily,\n    opacity: exitOpacity,\n    transform: `scale(${exitScale})`\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Organic Background Blobs — no linear translate, only drift */}\n      <div style={{position: 'absolute', top: -600, right: -800, opacity: blob1Opacity, transform: `translate(${blob1DriftX}px, ${blob1DriftY}px)`}}>\n        <svg width=\"2400\" height=\"2400\">\n          <defs>\n            <radialGradient id=\"gradPeach\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={accentColor2} stopOpacity=\"0.9\" />\n              <stop offset=\"100%\" stopColor={accentColor2} stopOpacity=\"0\" />\n            </radialGradient>\n          </defs>\n          <circle cx=\"1200\" cy=\"1200\" r=\"1200\" fill=\"url(#gradPeach)\" />\n        </svg>\n      </div>\n\n      <div style={{position: 'absolute', bottom: -700, left: -400, opacity: blob2Opacity, transform: `translate(${blob2DriftX}px, ${blob2DriftY}px)`}}>\n        <svg width=\"2000\" height=\"2000\">\n          <defs>\n            <radialGradient id=\"gradSage\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={accentColor1} stopOpacity=\"0.8\" />\n              <stop offset=\"100%\" stopColor={accentColor1} stopOpacity=\"0\" />\n            </radialGradient>\n          </defs>\n          <circle cx=\"1000\" cy=\"1000\" r=\"1000\" fill=\"url(#gradSage)\" />\n        </svg>\n      </div>\n\n      {/* Title */}\n      <div style={{\n        position: 'absolute',\n        top: 180,\n        left: 180,\n        fontSize: 120,\n        fontFamily: titleFontFamily,\n        fontStyle: 'italic',\n        color: textColor,\n        opacity: titleOpacity,\n        transform: `translateY(${titleY}px)`,\n        letterSpacing: '-0.02em'\n      }}>\n        {titleText}\n      </div>\n\n      {/* Team Members */}\n      <div style={{\n        position: 'absolute',\n        top: 480,\n        left: 180,\n        right: 180,\n        display: 'flex',\n        justifyContent: 'space-between',\n        alignItems: 'flex-start'\n      }}>\n        {members.map((member, i) => {\n          const mRaw = Math.min(1, Math.max(0, (frame - member.delay) / 45));\n          const mProgress = smoothSettle(mRaw);\n          const mOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - member.delay) / 15)));\n          return (\n            <div key={i} style={{\n              display: 'flex',\n              flexDirection: 'column',\n              alignItems: 'flex-start',\n              opacity: mOpacity,\n              transform: `translateY(${(1 - mProgress) * 50}px)`,\n              width: 280\n            }}>\n              <div style={{\n                width: 280,\n                height: 280,\n                borderRadius: '50%',\n                border: `2px solid rgba(236,207,229, 0.4)`,\n                backgroundColor: member.img ? 'transparent' : 'rgba(207,203,233, 0.1)',\n                overflow: 'hidden',\n                display: 'flex',\n                alignItems: 'center',\n                justifyContent: 'center',\n                boxShadow: '0px 20px 40px rgba(0,0,0,0.02)'\n              }}>\n                {member.img ? (\n                  <Img src={member.img} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />\n                ) : null}\n              </div>\n              <div style={{\n                marginTop: 45,\n                fontSize: 40,\n                fontFamily: titleFontFamily,\n                color: textColor,\n                lineHeight: 1.1\n              }}>\n                {member.name}\n              </div>\n              <div style={{\n                marginTop: 16,\n                fontSize: 18,\n                fontFamily: fontFamily,\n                color: textColor,\n                textTransform: 'uppercase',\n                letterSpacing: '0.1em',\n                opacity: 0.65\n              }}>\n                {member.role}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "75dae426-6c04-4ffd-9de5-9a4c5959d87c",
  "name": "Minimal Gradient — Timeline",
