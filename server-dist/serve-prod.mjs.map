  "thumb": "/thumbnails/f00fd95b-31ae-4fda-ae41-cb1bbcb4df02.jpg",
  "code": "const HoloBg = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const props = item.props || {};\n\n  const accentColor = props.accentColor || '#9e7fff';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const sparkleProgress = interpolate(frame, [0, durationInFrames], [0, 1], { extrapolateRight: 'clamp' });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: '#F9F9F9',\n    overflow: 'hidden',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    fontFamily\n  };\n\n  const chromeShadow = '4px 4px 0px rgba(0,0,0,0.1)';\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Blobs */}\n      <div style={{ position: 'absolute', top: '-10%', left: '-5%', width: 800, height: 800, borderRadius: '50%', background: '#ff9f90', filter: 'blur(150px)', opacity: 0.5 }} />\n      <div style={{ position: 'absolute', top: '-10%', right: '-5%', width: 900, height: 900, borderRadius: '50%', background: accentColor, filter: 'blur(150px)', opacity: 0.4 }} />\n      <div style={{ position: 'absolute', bottom: '-10%', right: '10%', width: 800, height: 800, borderRadius: '50%', background: '#a68300', filter: 'blur(150px)', opacity: 0.5 }} />\n\n      {/* Top Tabs */}\n      <div style={{ position: 'absolute', top: 60, left: 100, display: 'flex', gap: 15 }}>\n        {[0, 1, 2].map((i) => (\n          <div key={i} style={{ width: 100, height: 36, border: '3px solid black', borderRadius: 18, backgroundColor: i === 0 ? '#fff' : 'transparent', boxShadow: chromeShadow }} />\n        ))}\n      </div>\n      {/* Hamburger */}\n      <div style={{ position: 'absolute', top: 65, right: 100, display: 'flex', flexDirection: 'column', gap: 6 }}>\n        {[0, 1, 2].map(i => <div key={i} style={{ width: 40, height: 4, background: 'black', borderRadius: 2 }} />)}\n      </div>\n\n      {/* Left Triangles */}\n      <div style={{ position: 'absolute', left: 80, top: '42%' }}>\n        <svg width=\"60\" height=\"120\" viewBox=\"0 0 60 120\" fill=\"none\" stroke=\"black\" strokeWidth=\"4\">\n          <path d=\"M 10 10 L 50 35 L 10 60 Z\" stroke=\"#009b9b\" fill=\"rgba(0,155,155, 0.1)\" />\n          <path d=\"M 10 70 L 50 95 L 10 120 Z\" stroke=\"#fc5ed1\" fill=\"rgba(252,94,209, 0.1)\" />\n        </svg>\n      </div>\n\n      {/* Right Dots */}\n      <div style={{ position: 'absolute', right: 80, top: '42%', display: 'flex', flexDirection: 'column', gap: 18 }}>\n        {[0, 1, 2, 3].map(i => (\n          <div key={i} style={{ width: 18, height: 18, border: '3px solid black', borderRadius: '50%', backgroundColor: i === 3 ? '#fc5ed1' : 'transparent' }} />\n        ))}\n      </div>\n\n      {/* Bottom Timeline & Sparkle */}\n      <div style={{ position: 'absolute', bottom: 100, left: 150, right: 150, height: 4, backgroundColor: 'black', borderRadius: 2 }}>\n        <div style={{ position: 'absolute', left: -10, top: -8, width: 20, height: 20, background: 'black', transform: 'rotate(45deg)' }} />\n        <div style={{ position: 'absolute', right: -10, top: -8, width: 20, height: 20, background: 'black', transform: 'rotate(45deg)' }} />\n        <div style={{\n          position: 'absolute',\n          left: 0, top: -28,\n          transform: `translateX(${interpolate(sparkleProgress, [0, 1], [0, 1620])}px) rotate(${frame * 3}deg)`\n        }}>\n          <svg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\">\n            <path d=\"M30 0 C30 0 38 22 60 30 C38 38 30 60 30 60 C30 60 22 38 0 30 C22 22 30 0 30 0 Z\" fill=\"#dad3ff\" stroke=\"black\" strokeWidth=\"2\" />\n          </svg>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
