    "code": "const ShortsStepList = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const title = p.title || '';\n  const steps = [p.step1 || '', p.step2 || '', p.step3 || ''];\n  const accent = p.accentColor || '#2dd4bf';\n  const textColor = p.textColor || '#ecfdf5';\n  const card = p.cardColor || 'rgba(15,23,42,0.82)';\n  const exit = interpolate(frame, [durationInFrames - 10, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const titleEnter = spring({ frame, fps, config: { damping: 16, stiffness: 100 } });\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent', justifyContent: 'center', alignItems: 'center' }}>\n      <div style={{ width: 920, opacity: exit }}>\n        <div style={{\n          fontSize: 44, fontWeight: 900, color: textColor, marginBottom: 36,\n          opacity: titleEnter, transform: `translateY(${(1 - titleEnter) * 20}px)`,\n        }}>{title}</div>\n        {steps.map((s, i) => {\n          const enter = spring({ frame: frame - i * 8, fps, config: { damping: 15, stiffness: 110 } });\n          return (\n            <div key={i} style={{\n              display: 'flex', alignItems: 'center', gap: 24,\n              marginBottom: 22,\n              opacity: enter,\n              transform: `translateX(${(1 - enter) * 40}px)`,\n              background: card,\n              borderRadius: 20,\n              padding: '26px 28px',\n              border: `1px solid ${accent}33`,\n            }}>\n              <div style={{\n                width: 56, height: 56, borderRadius: 999,\n                background: accent, color: '#0f172a',\n                display: 'flex', alignItems: 'center', justifyContent: 'center',\n                fontWeight: 900, fontSize: 28, flexShrink: 0,\n              }}>{i + 1}</div>\n              <div style={{ fontSize: 34, fontWeight: 700, color: textColor, lineHeight: 1.3 }}>{s}</div>\n            </div>\n          );\n        })}\n      </div>\n    </AbsoluteFill>\n  );\n};"
