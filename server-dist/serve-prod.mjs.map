  "thumb": "/thumbnails/5e015143-44fa-4cc4-bb04-f692e011a1ee.jpg",
  "code": "const DonutChartInfographic = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'Booking Mix';\n  const centerMainText = props.centerMainText || '12%';\n  const centerSubText = props.centerSubText || 'YoY Bookings';\n\n  const appBgColor = props.appBgColor || '#E8E6F0';\n  const cardBgColor = props.cardBgColor || '#FFFFFF';\n  const titleColor = props.titleColor || '#2D3436';\n\n  const segments = [\n    { value: props.seg1Value ?? 30, label: props.seg1Label || 'Film Studio',   color: props.seg1Color || '#2eeacf' },\n    { value: props.seg2Value ?? 54, label: props.seg2Label || 'Photo Studio',   color: props.seg2Color || '#348b12' },\n    { value: props.seg3Value ?? 65, label: props.seg3Label || 'Print Studio',    color: props.seg3Color || '#aa8700' },\n    { value: props.seg4Value ?? 40, label: props.seg4Label || 'Event Studio', color: props.seg4Color || '#36beff' },\n  ];\n\n  const totalValue = segments.reduce((acc, s) => acc + s.value, 0);\n  // ViewBox matches container exactly (640×640), no scaling distortion\n  const centerXY = 320;\n  const radius = 200;\n  const strokeWidth = 52;\n  const circumference = 2 * Math.PI * radius;\n  // Gap must be wider than strokeWidth arc-equivalent to prevent round-cap overlap\n  // strokeWidth=52, radius=200 → cap extends 26px → ~7.5° per side → need >15° total\n  const gapDeg = 16;\n  const gapArcLength = (gapDeg / 360) * circumference;\n\n  const entranceSpring = spring({ frame, fps, config: { damping: 20, stiffness: 100 } });\n\n  const chartProgress = spring({\n    frame: Math.max(0, frame - 10),\n    fps,\n    config: { damping: 30, stiffness: 80 },\n  });\n\n  const textReveal = spring({\n    frame: Math.max(0, frame - 20),\n    fps,\n    config: { damping: 20, stiffness: 100 },\n  });\n\n  // DNA Helix watermark — restored as original\n  const helixDots = new Array(20).fill(0).map((_, i) => {\n    const y = i * 40;\n    const norm = i / 20;\n    const xOffset = Math.sin(norm * Math.PI * 4) * 60;\n    return { y, x1: 100 + xOffset, x2: 100 - xOffset, opacity: 0.1 + (1 - norm) * 0.2 };\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: appBgColor,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    fontFamily: 'Inter, sans-serif',\n    overflow: 'hidden',\n  };\n\n  const cardStyle = {\n    width: 1400,\n    height: 800,\n    backgroundColor: cardBgColor,\n    borderRadius: 50,\n    boxShadow: '0 20px 60px rgba(0,0,0,0.05)',\n    position: 'relative',\n    display: 'flex',\n    flexDirection: 'row',\n    padding: '60px 80px',\n    boxSizing: 'border-box',\n    opacity: entranceSpring,\n    transform: `translateY(${(1 - entranceSpring) * 50}px)`,\n    overflow: 'hidden',\n  };\n\n  const leftColStyle = {\n    flex: 1,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    paddingLeft: 150,\n    paddingRight: 20,\n    zIndex: 2,\n  };\n\n  const rightColStyle = {\n    flex: 1,\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    position: 'relative',\n    zIndex: 2,\n  };\n\n  const titleStyle = {\n    fontSize: 56,\n    fontWeight: 800,\n    color: titleColor,\n    marginBottom: 60,\n    letterSpacing: '-0.02em',\n  };\n\n  let accumulatedRotation = -90;\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n\n        {/* DNA Watermark — original style, opacity lowered slightly */}\n        <div style={{ position: 'absolute', right: 50, top: '50%', transform: 'translateY(-50%)', opacity: 0.08, zIndex: 0 }}>\n          <svg width=\"200\" height=\"800\" viewBox=\"0 0 200 800\">\n            {helixDots.map((dot, i) => (\n              <React.Fragment key={i}>\n                <circle cx={dot.x1} cy={dot.y} r={8} fill=\"#a6b6ad\" opacity={dot.opacity} />\n                <circle cx={dot.x2} cy={dot.y} r={8} fill=\"#a6b6ad\" opacity={dot.opacity} />\n                <line x1={dot.x1} y1={dot.y} x2={dot.x2} y2={dot.y} stroke=\"#a6b6ad\" strokeWidth=\"2\" opacity={dot.opacity * 0.5} />\n              </React.Fragment>\n            ))}\n          </svg>\n        </div>\n\n        {/* Left Column: Title & Legend */}\n        <div style={leftColStyle}>\n          <h1 style={titleStyle}>{titleText}</h1>\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 30 }}>\n            {segments.map((seg, i) => {\n              const percentage = Math.round((seg.value / totalValue) * 100);\n              const delay = i * 5 + 10;\n              const itemSpring = spring({ frame: Math.max(0, frame - delay), fps, config: { damping: 15 } });\n              return (\n                <div key={i} style={{\n                  display: 'flex',\n                  alignItems: 'center',\n                  gap: 20,\n                  opacity: itemSpring,\n                  transform: `translateX(${(1 - itemSpring) * -30}px)`,\n                }}>\n                  <div style={{\n                    width: 24, height: 24, borderRadius: '50%',\n                    backgroundColor: seg.color, flexShrink: 0,\n                    boxShadow: `0 4px 10px ${seg.color}66`,\n                  }} />\n                  <span style={{ fontSize: 32, fontWeight: 700, color: titleColor, minWidth: 90 }}>{percentage}%</span>\n                  <span style={{ fontSize: 28, fontWeight: 500, color: '#636e72' }}>{seg.label}</span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right Column: Donut Chart */}\n        <div style={rightColStyle}>\n          <div style={{ position: 'relative', width: 640, height: 640 }}>\n\n            {/* Center Text */}\n            <div style={{\n              position: 'absolute', top: 0, left: 0,\n              width: '100%', height: '100%',\n              display: 'flex', flexDirection: 'column',\n              alignItems: 'center', justifyContent: 'center',\n              textAlign: 'center', zIndex: 10, pointerEvents: 'none',\n            }}>\n              <div style={{\n                fontSize: 80, fontWeight: 800, color: titleColor,\n                lineHeight: 1,\n                opacity: textReveal,\n                transform: `scale(${0.8 + 0.2 * textReveal})`,\n              }}>{centerMainText}</div>\n              <div style={{\n                fontSize: 18, fontWeight: 500, color: '#636e72',\n                marginTop: 8, maxWidth: 140, lineHeight: 1.3,\n                opacity: textReveal,\n                transform: `translateY(${(1 - textReveal) * 20}px)`,\n              }}>{centerSubText}</div>\n            </div>\n\n            {/* SVG Donut\n                Animation: strokeDashoffset goes from segmentLength → 0\n                This draws the arc from its start point forward — no shrink, no disappear.\n                strokeDasharray is fixed at [segmentLength, circumference] so only this\n                segment's arc is ever visible regardless of offset. */}\n            <svg width=\"640\" height=\"640\" viewBox=\"0 0 640 640\">\n              {segments.map((seg, i) => {\n                // Fixed 4° gap — all gaps look the same width regardless of segment size\n                const segmentLength = Math.max(0, (seg.value / totalValue) * circumference - gapArcLength);\n                const rotation = accumulatedRotation;\n                accumulatedRotation += (seg.value / totalValue) * 360;\n\n                const dashOffset = segmentLength * (1 - chartProgress);\n\n                return (\n                  <circle\n                    key={i}\n                    cx={centerXY} cy={centerXY} r={radius}\n                    fill=\"transparent\"\n                    stroke={seg.color}\n                    strokeWidth={strokeWidth}\n                    strokeDasharray={`${segmentLength} ${circumference}`}\n                    strokeDashoffset={dashOffset}\n                    strokeLinecap=\"round\"\n                    transform={`rotate(${rotation} ${centerXY} ${centerXY})`}\n                  />\n                );\n              })}\n            </svg>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n\n"
 },
