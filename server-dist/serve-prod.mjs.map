  "thumb": "/thumbnails/9c9d88f8-9123-4a5a-8236-cbeca6925318.jpg",
  "code": "const VictorianSlide = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const textColor = props.textColor;\n  const bgColor = props.bgColor;\n  const titleFontFamily = props.titleFontFamily;\n  const subtitleFontFamily = props.subtitleFontFamily;\n\n  const safeFps = fps || 30;\n  \n  const borderOpacity = interpolate(frame, [0, 20], [0, 0.8], { extrapolateRight: 'clamp' });\n  const innerBorderOpacity = interpolate(frame, [5, 25], [0, 0.5], { extrapolateRight: 'clamp' });\n  const flourishProgress = spring({ frame: Math.max(0, frame - 10), fps: safeFps, config: { damping: 15, mass: 1.5 } });\n  const circleOpacity = Math.max(0, Math.min(1, flourishProgress));\n\n  const textSpring = spring({ frame: Math.max(0, frame - 20), fps: safeFps, config: { damping: 15 } });\n  const textOpacity = interpolate(textSpring, [0, 1], [0, 1]);\n  const textY = interpolate(textSpring, [0, 1], [40, 0]);\n\n  const ruleSpring = spring({ frame: Math.max(0, frame - 35), fps: safeFps, config: { damping: 15 } });\n  const ruleWidth = interpolate(ruleSpring, [0, 1], [0, 50]);\n  const ruleOpacity = interpolate(ruleSpring, [0, 1], [0, 0.6]);\n\n  const subSpring = spring({ frame: Math.max(0, frame - 45), fps: safeFps, config: { damping: 15 } });\n  const subOpacity = interpolate(subSpring, [0, 1], [0, 0.9]);\n  const subY = interpolate(subSpring, [0, 1], [30, 0]);\n\n  const fadeOutStart = Math.max(0, durationInFrames - 20);\n  const globalOpacity = interpolate(frame, [fadeOutStart, durationInFrames - 1], [1, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const backgroundColor = props.transparentBackground ? 'transparent' : (bgColor || '#F3EBE1');\n  const backgroundImage = props.transparentBackground \n    ? 'none' \n    : `radial-gradient(circle at center, transparent 40%, rgba(16,99,132, 0.08) 100%)`;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    backgroundImage,\n    opacity: globalOpacity,\n    overflow: 'hidden'\n  };\n\n  const quoteAccent = '#5d768e';\n  const quoteBorderScale = 0.95 + Math.min(1, borderOpacity) * 0.05;\n\n  const CornerFlourish = ({ style, item }) => (\n    <div style={{ position: 'absolute', width: 150, height: 150, ...style }}>\n      <svg viewBox=\"0 0 150 150\" width=\"100%\" height=\"100%\">\n        <g stroke={quoteAccent} fill=\"none\" strokeWidth=\"1.5\" strokeLinecap=\"round\">\n          <path d=\"M 0,150 C 0,50 50,0 150,0\" />\n          <path d=\"M 15,150 C 15,70 70,15 150,15\" />\n          <path d=\"M 30,150 C 30,90 70,50 110,40 C 130,35 140,45 130,60 C 115,80 90,60 95,45 C 100,35 110,35 115,45\" />\n          <path d=\"M 150,30 C 90,30 50,70 40,110 C 35,130 45,140 60,130 C 80,115 60,90 45,95 C 35,100 35,110 45,115\" />\n          <circle cx=\"20\" cy=\"20\" r=\"2.5\" fill={quoteAccent} />\n          <path d=\"M 0,0 L 25,0 C 25,25 0,25 0,25 Z\" fill={quoteAccent} stroke=\"none\" />\n        </g>\n      </svg>\n    </div>\n  );\n\n  return (\n    <div style={rootStyle}>\n      {/* Border */}\n      <div style={{ position: 'absolute', top: 50, bottom: 50, left: 60, right: 60, border: `2px solid ${quoteAccent}`, padding: 12, opacity: borderOpacity, transform: `scale(${quoteBorderScale})` }}>\n        <div style={{ width: '100%', height: '100%', border: `1px solid ${quoteAccent}`, position: 'relative', boxSizing: 'border-box' }}>\n          <CornerFlourish style={{ top: 0, left: 0 }} />\n          <CornerFlourish style={{ top: 0, right: 0, transform: 'scaleX(-1)' }} />\n          <CornerFlourish style={{ bottom: 0, left: 0, transform: 'scaleY(-1)' }} />\n          <CornerFlourish style={{ bottom: 0, right: 0, transform: 'scale(-1, -1)' }} />\n        </div>\n      </div>\n\n      {/* Text Content */}\n      <div style={{\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        justifyContent: 'center',\n        position: 'absolute',\n        inset: 100,\n        zIndex: 10\n      }}>\n        <div style={{\n          display: 'flex',\n          alignItems: 'center',\n          gap: 40,\n          opacity: textOpacity,\n          transform: `translateY(${textY}px)`\n        }}>\n          <span style={{ fontSize: 56, fontFamily: titleFontFamily, color: textColor, opacity: 0.8 }}>-</span>\n          <span style={{ fontSize: 72, fontFamily: titleFontFamily, color: textColor, fontWeight: 'bold', letterSpacing: '0.05em' }}>\n            {titleText}\n          </span>\n          <span style={{ fontSize: 56, fontFamily: titleFontFamily, color: textColor, opacity: 0.8 }}>-</span>\n        </div>\n        \n        <div style={{\n          width: `${ruleWidth}%`,\n          height: 2,\n          backgroundColor: textColor,\n          marginTop: 60,\n          marginBottom: 60,\n          opacity: ruleOpacity\n        }} />\n        \n        <div style={{\n          maxWidth: 900,\n          textAlign: 'center',\n          fontSize: 28,\n          fontFamily: subtitleFontFamily,\n          color: textColor,\n          opacity: subOpacity,\n          transform: `translateY(${subY}px)`,\n          lineHeight: 1.6\n        }}>\n          {subtitleText}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
