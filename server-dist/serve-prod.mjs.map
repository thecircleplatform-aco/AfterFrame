  "thumb": "/thumbnails/82876903-b57c-44dd-95cf-e5482749b399.jpg",
  "code": "const AnimatedBarChart = ({item}) => {\n  const frame = useCurrentFrame();\nconst DESIGN_WIDTH = 1920;\nconst DESIGN_HEIGHT = 1080;\nconst scale = Math.min(\n  (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n  (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n);\n\n  const props = item.props;\n  const val1 = props.val1;\n  const val2 = props.val2;\n  const val3 = props.val3;\n  const val4 = props.val4;\n  const yr1 = props.yr1;\n  const yr2 = props.yr2;\n  const yr3 = props.yr3;\n  const yr4 = props.yr4;\n  const color1 = props.color1;\n  const color2 = props.color2;\n  const color3 = props.color3;\n  const color4 = props.color4;\n  const bgColor = props.bgColor;\n  const waveColor = props.waveColor;\n  const axisColor = props.axisColor;\n  const textFont = props.textFont;\n\n  const CHART_LEFT = 380;\n  const CHART_RIGHT = 1600;\n  const CHART_TOP = 150;\n  const CHART_BOTTOM = 900;\n  const CHART_H = CHART_BOTTOM - CHART_TOP;\n\n  // Y-axis: 0 to 10,000 hrs\n  const yMax = 10000;\n  const yTicks = [0, 2500, 5000, 7500, 10000];\n  const yLabel = (v) => v === 0 ? '0' : `${(v/1000).toFixed(v % 1000 === 0 ? 0 : 1)}K hrs`;\n  const yToPixel = (v) => CHART_BOTTOM - (v / yMax) * CHART_H;\n\n  // Actual data values\n  const dataValues = [365, 730, 1460, 10000];\n  const maxH = dataValues.map(v => Math.max((v / yMax) * CHART_H, 6));\n\n  const bellEase = Easing.bezier(0.25, 0, 0.1, 1);\n\n  const p1 = interpolate(frame, [0,   42],  [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: bellEase});\n  const p2 = interpolate(frame, [40,  82],  [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: bellEase});\n  const p3 = interpolate(frame, [80,  122], [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: bellEase});\n  const p4 = interpolate(frame, [120, 162], [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: bellEase});\n\n  const heights = [p1*maxH[0], p2*maxH[1], p3*maxH[2], p4*maxH[3]];\n\n  const lo1 = interpolate(frame, [40,  50],  [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp'});\n  const lo2 = interpolate(frame, [80,  90],  [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp'});\n  const lo3 = interpolate(frame, [120, 130], [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp'});\n  const lo4 = interpolate(frame, [160, 170], [0, 1], {extrapolateLeft:'clamp', extrapolateRight:'clamp'});\n  const labelOps = [lo1, lo2, lo3, lo4];\n\n  const makeFill = (cx, bw, base, h) => {\n    if (h <= 0) return 'M 0 0';\n    const ins = 2;\n    const r = Math.min(6, h / 2);\n    const l = cx - bw/2 + ins, rr = cx + bw/2 - ins;\n    const t = base - h + ins;\n    return `M${l},${base} L${l},${t+r} A${r},${r} 0 0,1 ${l+r},${t} L${rr-r},${t} A${r},${r} 0 0,1 ${rr},${t+r} L${rr},${base} Z`;\n  };\n  const makeStroke = (cx, bw, base, h) => {\n    if (h <= 0) return 'M 0 0';\n    const r = Math.min(6, h / 2);\n    const l = cx - bw/2, rr = cx + bw/2;\n    const t = base - h;\n    return `M${l},${base} L${l},${t+r} A${r},${r} 0 0,1 ${l+r},${t} L${rr-r},${t} A${r},${r} 0 0,1 ${rr},${t+r} L${rr},${base} Z`;\n  };\n\n  const BW = 110;\n  const BASE = CHART_BOTTOM;\n  const centers = [500, 800, 1100, 1400];\n  const values  = [val1, val2, val3, val4];\n  const years   = [yr1,  yr2,  yr3,  yr4];\n  const colors  = [color1, color2, color3, color4];\n  const labelTops = maxH.map(h => BASE - h - 62);\n\n  return (\n    <div style={{position:'absolute',inset:0,backgroundColor:bgColor,overflow:'hidden',userSelect:'none'}}>\n      <svg style={{position:'absolute',inset:0,width:1920,height:1080}} xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M 550,1080 C 800,1080 1000,1000 1200,900 C 1400,800 1600,650 1920,480 L 1920,1080 Z\" fill={waveColor}/>\n        {yTicks.map((val, i) => {\n          const y = yToPixel(val);\n          return (\n            <g key={`ytick-${i}`}>\n              <line\n                x1={CHART_LEFT} y1={y}\n                x2={CHART_RIGHT} y2={y}\n                stroke=\"#B8B2AA\"\n                strokeWidth=\"1\"\n                strokeDasharray={val === 0 ? 'none' : '4 6'}\n                strokeOpacity=\"0.55\"\n              />\n            </g>\n          );\n        })}\n        <polyline\n          points={`${CHART_LEFT},${CHART_TOP} ${CHART_LEFT},${CHART_BOTTOM} ${CHART_RIGHT},${CHART_BOTTOM}`}\n          stroke={axisColor} strokeWidth=\"3\" fill=\"none\" strokeLinecap=\"square\"\n        />\n        {centers.map((cx, i) => (\n          <g key={`bar-${i}`}>\n            <path d={makeFill(cx, BW, BASE, heights[i])}   fill={colors[i]} fillOpacity=\"0.72\" stroke=\"none\"/>\n            <path d={makeStroke(cx, BW, BASE, heights[i])} fill=\"none\" stroke=\"#1C1C1C\" strokeWidth=\"2\" strokeDasharray=\"8 6\" strokeOpacity=\"0.75\"/>\n          </g>\n        ))}\n      </svg>\n\n      {yTicks.map((val, i) => {\n        const y = yToPixel(val);\n        return (\n          <div key={`ylabel-${i}`} style={{\n            position:'absolute',\n            right: 1920 - CHART_LEFT + 12,\n            top: y - 14,\n            width: 140,\n            textAlign:'right',\n            fontFamily: textFont,\n            fontWeight: 400,\n            fontSize: 22,\n            color: '#888078',\n            pointerEvents:'none',\n            letterSpacing: '0px'\n          }}>\n            {yLabel(val)}\n          </div>\n        );\n      })}\n\n      {centers.map((cx, i) => (\n        <React.Fragment key={`lbl-${i}`}>\n          <div style={{\n            position:'absolute', left:cx-150, width:300, top:labelTops[i],\n            textAlign:'center', opacity:labelOps[i],\n            fontFamily:textFont, fontWeight:700, fontSize:46, color:axisColor,\n            letterSpacing:'-1px', pointerEvents:'none'\n          }}>\n            {values[i]}\n          </div>\n          <div style={{\n            position:'absolute', left:cx-100, width:200, top:BASE+24,\n            textAlign:'center',\n            fontFamily: textFont,\n            fontWeight:500, fontSize:28, color:axisColor, pointerEvents:'none'\n          }}>\n            {years[i]}\n          </div>\n        </React.Fragment>\n      ))}\n    </div>\n  );\n}"
 },
