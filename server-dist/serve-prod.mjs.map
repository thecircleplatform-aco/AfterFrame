  "thumb": "/thumbnails/bf565cad-9797-470c-909a-e91e5f5ba0a8.jpg",
  "code": "const TweetScreenshot = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  // Props & Defaults\n  const p = item.props || {};\n  const authorName   = p.authorName   || 'Sam Kessler';\n  const handle       = p.handle       || '@samkessler';\n  const tweetText    = p.tweetText    || 'People giving PulseMetrics write access to their entire warehouse';\n  const dateText     = p.dateText     || '6:15 PM · Mar 11, 2026';\n  const isVerified   = p.isVerified   !== undefined ? p.isVerified : true;\n  const replyCount   = p.replyCount   || '8K';\n  const retweetCount = p.retweetCount || '19K';\n  const likeCount    = p.likeCount    || '287K';\n  const viewCount    = p.viewCount    || '51.2M';\n  const avatarUrl    = p.avatarUrl    || 'data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 96 96%27%3E%3Ccircle cx=%2748%27 cy=%2748%27 r=%2748%27 fill=%27%231d9bf0%27/%3E%3Ccircle cx=%2748%27 cy=%2738%27 r=%2716%27 fill=%27%23e7f5fd%27/%3E%3Cpath d=%27M16 88c4-18 17-26 32-26s28 8 32 26%27 fill=%27%23e7f5fd%27/%3E%3C/svg%3E';\n  // mediaUrl: optional tweet image (leave empty to hide)\n  const mediaUrl     = p.mediaUrl     || '';\n  const theme        = p.theme        || 'light'; // 'light' or 'dark'\n\n  const isLight = theme === 'light';\n\n  // Colors\n  const bgPage    = isLight ? '#F7F9F9' : '#000000';\n  const bgCard    = isLight ? '#FFFFFF' : '#182216';\n  const textMain  = isLight ? '#0F1419' : '#F7F9F9';\n  const textMuted = isLight ? '#5a6559' : '#8e9a90';\n  const borderCol = isLight ? '#CFD9DE' : '#3d453c';\n  const accentBlue = '#64a76b';\n\n  // Responsive\n  const DESIGN_WIDTH  = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width  || DESIGN_WIDTH)  / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const { durationInFrames } = useVideoConfig();\n\n  // 缓入 — 低 stiffness，平滑无抖动\n  const enter = spring({ frame, fps, config: { damping: 22, stiffness: 60, mass: 1 } });\n\n  // 缓出 — 最后 0.6s，用 interpolate + clamp 保证最后一帧严格为 0\n  const exitStartFrame = durationInFrames - Math.round(fps * 0.6);\n  const exitOpacity   = interpolate(frame, [exitStartFrame, durationInFrames - 1], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const exitTranslate = interpolate(frame, [exitStartFrame, durationInFrames - 1], [0, 36], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  const opacity    = interpolate(enter, [0, 1], [0, 1]) * exitOpacity;\n  const translateY = interpolate(enter, [0, 1], [36, 0]) + exitTranslate;\n\n  // ---- SVG Icons (pixel-perfect from X source) ----\n  const XLogo = () => (\n    <svg viewBox=\"0 0 24 24\" width={28} height={28} fill={textMain}>\n      <path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\" />\n    </svg>\n  );\n\n  const VerifiedBadge = () => (\n    <svg viewBox=\"0 0 24 24\" width={20} height={20} fill={accentBlue}>\n      <path d=\"M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .495.083.965.238 1.4-1.272.65-2.147 2.02-2.147 3.6 0 1.457.755 2.739 1.882 3.454-.12.446-.183.916-.183 1.396 0 2.21 1.71 4 3.818 4 .47 0 .92-.086 1.336-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.866.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.48-.063-.95-.183-1.396 1.127-.715 1.882-1.997 1.882-3.454zM10.25 17.25l-3.5-3.5 1.414-1.414 2.086 2.086 5.586-5.586 1.414 1.414-7 7z\" />\n    </svg>\n  );\n\n  const ReplyIcon = () => (\n    <svg viewBox=\"0 0 24 24\" width={19} height={19} fill={textMuted}>\n      <path d=\"M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.245c-4.42 0-8.005-3.58-8.005-8zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.32 2.688 6 6.005 6h2.42v1.91l4.282-2.37c2.148-1.19 3.48-3.45 3.48-5.91 0-3.39-2.738-6.13-6.129-6.13H9.756z\" />\n    </svg>\n  );\n\n  const RetweetIcon = () => (\n    <svg viewBox=\"0 0 24 24\" width={19} height={19} fill={textMuted}>\n      <path d=\"M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z\" />\n    </svg>\n  );\n\n  const LikeIcon = () => (\n    <svg viewBox=\"0 0 24 24\" width={19} height={19} fill={textMuted}>\n      <path d=\"M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91zm4.187 7.69c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.605 3.01.894 1.81.846 4.17-.514 6.67z\" />\n    </svg>\n  );\n\n  const ViewsIcon = () => (\n    <svg viewBox=\"0 0 24 24\" width={19} height={19} fill={textMuted}>\n      <path d=\"M8.75 21V3h2v18h-2zM18 21V8.5h2V21h-2zM4 21l.004-10h2L6 21H4zm9.248 0v-7h2v7h-2z\" />\n    </svg>\n  );\n\n  const BookmarkIcon = () => (\n    <svg viewBox=\"0 0 24 24\" width={19} height={19} fill={textMuted}>\n      <path d=\"M4 4.5C4 3.12 5.119 2 6.5 2h11C18.881 2 20 3.12 20 4.5v18.44l-8-5.71-8 5.71V4.5zM6.5 4c-.276 0-.5.22-.5.5v14.56l6-4.29 6 4.29V4.5c0-.28-.224-.5-.5-.5h-11z\" />\n    </svg>\n  );\n\n  const ShareIcon = () => (\n    <svg viewBox=\"0 0 24 24\" width={19} height={19} fill={textMuted}>\n      <path d=\"M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41l-3.3 3.3-1.41-1.42L12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.12 21 3 19.88 3 18.5V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z\" />\n    </svg>\n  );\n\n  // Card shadow depends on theme\n  const cardShadow = isLight\n    ? '0 2px 12px rgba(0,0,0,0.12), 0 1px 4px rgba(0,0,0,0.08)'\n    : '0 8px 32px rgba(0,0,0,0.6)';\n\n  return (\n    <div style={{\n      position: 'absolute',\n      top: 0, left: 0,\n      width: DESIGN_WIDTH,\n      height: DESIGN_HEIGHT,\n      transformOrigin: 'top left',\n      transform: `scale(${scale})`,\n      fontFamily: '-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif',\n    }}>\n      <div style={{\n        position: 'absolute',\n        top: 0, left: 0,\n        width: DESIGN_WIDTH,\n        height: DESIGN_HEIGHT,\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'center',\n        opacity,\n        transform: `translateY(${translateY}px)`,\n        willChange: 'transform, opacity',\n      }}>\n      <div style={{ width: 560 }}>\n        <div style={{\n          backgroundColor: bgCard,\n          borderRadius: 20,\n          border: `1px solid ${borderCol}`,\n          boxShadow: cardShadow,\n          overflow: 'hidden',\n        }}>\n          <div style={{ padding: '24px 28px 20px 28px' }}>\n            <div style={{ display: 'flex', alignItems: 'center', marginBottom: 20 }}>\n              <div style={{\n                width: 48, height: 48,\n                borderRadius: '50%',\n                overflow: 'hidden',\n                flexShrink: 0,\n                marginRight: 12,\n                backgroundColor: '#ccc',\n              }}>\n                <Img src={avatarUrl} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />\n              </div>\n              <div style={{ flex: 1, minWidth: 0 }}>\n                <div style={{ display: 'flex', alignItems: 'center', gap: 5 }}>\n                  <span style={{ fontSize: 18, fontWeight: 700, color: textMain, letterSpacing: '-0.2px' }}>{authorName}</span>\n                  {isVerified && <VerifiedBadge />}\n                </div>\n                <div style={{ fontSize: 15, color: textMuted, marginTop: 2 }}>{handle}</div>\n              </div>\n              <div style={{ flexShrink: 0, marginLeft: 8 }}><XLogo /></div>\n            </div>\n            <div style={{ fontSize: 22, lineHeight: 1.35, fontWeight: 400, color: textMain, marginBottom: mediaUrl ? 14 : 20, letterSpacing: '-0.2px', wordBreak: 'break-word' }}>\n              {tweetText}\n            </div>\n            {mediaUrl ? (\n              <div style={{ borderRadius: 14, overflow: 'hidden', marginBottom: 16, border: `1px solid ${borderCol}`, lineHeight: 0 }}>\n                <Img src={mediaUrl} style={{ width: '100%', display: 'block', maxHeight: 300, objectFit: 'cover' }} />\n              </div>\n            ) : null}\n            <div style={{ fontSize: 14, color: textMuted, marginBottom: 12 }}>\n              {dateText}\n              <span style={{ margin: '0 5px' }}>·</span>\n              <span style={{ fontWeight: 700, color: textMain }}>{viewCount}</span>\n              <span style={{ marginLeft: 3 }}>Views</span>\n            </div>\n            <div style={{ height: 1, backgroundColor: borderCol, marginBottom: 4 }} />\n            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '8px 4px 4px 4px' }}>\n              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>\n                <ReplyIcon /><span style={{ fontSize: 14, color: textMuted }}>{replyCount}</span>\n              </div>\n              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>\n                <RetweetIcon /><span style={{ fontSize: 14, color: textMuted }}>{retweetCount}</span>\n              </div>\n              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>\n                <LikeIcon /><span style={{ fontSize: 14, color: textMuted }}>{likeCount}</span>\n              </div>\n              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>\n                <BookmarkIcon /><span style={{ fontSize: 14, color: textMuted }}>{p.bookmarkCount || '17K'}</span>\n              </div>\n              <div style={{ display: 'flex', alignItems: 'center' }}><ShareIcon /></div>\n            </div>\n          </div>\n        </div>\n      </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "8aedc1d6-c5c8-44f0-9f3d-9ed78fd55f69",
  "name": "Dark Tech — Feature Showcase",
  "category": "social-media",
  "description": "a 6-second animated slide with a pulsing dot-grid background and a clean white card that fades in to display your product screenshot.\n\n",
  "tags": [
   "long-form",
   "short-form"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgColor": "#426681",
   "dotColor": "#ffffff",
   "screenshotImage": "",
   "cardShadowOpacity": 0.3,
   "transparentBackground": false
  },
  "propSchema": [
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#426681",
    "label": "bgColor"
   },
   {
    "key": "dotColor",
    "type": "color",
    "defaultValue": "#ffffff",
    "label": "dotColor"
   },
   {
    "key": "screenshotImage",
    "type": "image",
    "defaultValue": "",
    "label": "image placeholder"
   },
   {
    "key": "cardShadowOpacity",
    "type": "number",
    "defaultValue": 0.3,
    "label": "cardShadowOpacity"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
    "defaultValue": false,
    "label": "transparentBackground"
   }
  ],
  "thumb": "/thumbnails/8aedc1d6-c5c8-44f0-9f3d-9ed78fd55f69.png",
  "code": "const FlowingDotGridCard = ({item}) => {\n  const frame = useCurrentFrame();\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const dotColor = props.dotColor;\n  const screenshotImage = props.screenshotImage;\n  const cardShadowOpacity = props.cardShadowOpacity;\n  const transparentBackground = props.transparentBackground;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: transparentBackground ? 'transparent' : bgColor,\n    overflow: 'hidden',\n  };\n\n  const cols = 54;\n  const rows = 31;\n  const spacing = 38;\n  const fTime1 = frame * 0.03;\n  const fTime2 = frame * 0.02;\n\n  const dots = [];\n  for (let r = 0; r < rows; r++) {\n    for (let c = 0; c < cols; c++) {\n      const wave1 = Math.sin(c * 0.05 + r * 0.2 + fTime1);\n      const wave2 = Math.sin(c * 0.1 - r * 0.05 + fTime2);\n      const combinedWave = wave1 * 0.7 + wave2 * 0.3;\n      const opacity = 0.215 + combinedWave * 0.135;\n      const radius = 1.5 + combinedWave * 0.5;\n      dots.push(\n        <circle key={`${r}-${c}`} cx={c * spacing} cy={r * spacing} r={radius} fill={dotColor} opacity={opacity} />\n      );\n    }\n  }\n\n  const cardOpacity = interpolate(frame, [5, 25], [0, 1], { extrapolateRight: 'clamp' });\n  const cardScale = interpolate(frame, [5, 25], [0.92, 1], {\n    easing: Easing.out(Easing.cubic), extrapolateRight: 'clamp'\n  });\n\n  return (\n    <div style={rootStyle}>\n      <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%' }}>\n        <g transform={`translate(${(DESIGN_WIDTH - (cols - 1) * spacing) / 2}, ${(DESIGN_HEIGHT - (rows - 1) * spacing) / 2})`}>\n          {dots}\n        </g>\n      </svg>\n\n      {screenshotImage ? (\n        <div style={{\n          position: 'absolute',\n          top: '50%', left: '50%',\n          transform: `translate(-50%, -50%) scale(${cardScale})`,\n          width: 1160, height: 652,\n          backgroundColor: '#ffffff',\n          borderRadius: 16,\n          boxShadow: `0 12px 48px rgba(0,0,0,${cardShadowOpacity})`,\n          opacity: cardOpacity,\n          overflow: 'hidden',\n          display: 'flex',\n          alignItems: 'center',\n          justifyContent: 'center',\n        }}>\n          <Img src={screenshotImage} style={{ width: '100%', height: '100%', objectFit: 'contain' }} />\n        </div>\n      ) : null}\n    </div>\n  );\n};\n"
 },
 {
  "id": "a75ac7ba-db04-4266-93b9-9ebd0614dc06",
  "name": "Finance Explainer — Chapter Marker Notebook",
  "category": "social-media",
  "description": "A notebook-style chapter card that shows three agenda items over a lined paper background photo. Each line gets a yellow highlight that sweeps across the text and then fades out, one after another. The whole card slowly zooms in over time, giving it a subtle Ken Burns feel. Good for introducing the sections of your video at the start, or recapping what's coming next.\n\n",
  "tags": [
   "long-form",
   "short-form"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgImage": "04ff45a7b0",
   "line1Text": "Why most budgets fall apart fast",
   "line2Text": "The envelope method explained",
   "line3Text": "How to start this week",
   "highlightColor": "#ffd8fb",
   "textColor": "#111111",
   "fontFamily": "Roboto, sans-serif",
   "highlightPad": "-20",
   "lineSpacing": "148",
   "ruleWidth": "10",
   "marginWidth": "6",
   "transparentBackground": false
  },
  "propSchema": [
   {
    "key": "bgImage",
    "type": "image",
    "defaultValue": "04ff45a7b0",
    "label": "Background Image"
   },
   {
    "key": "line1Text",
    "type": "text",
    "defaultValue": "Why most budgets fall apart fast",
    "label": "Line 1"
   },
   {
    "key": "line2Text",
    "type": "text",
    "defaultValue": "The envelope method explained",
    "label": "Line 2"
   },
   {
    "key": "line3Text",
    "type": "text",
    "defaultValue": "How to start this week",
    "label": "Line 3"
   },
   {
    "key": "highlightColor",
    "type": "color",
    "defaultValue": "#ffd8fb",
    "label": "Highlight Color"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#111111",
    "label": "Text Color"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Roboto, sans-serif",
    "label": "Font Family"
   },
   {
    "key": "highlightPad",
    "type": "text",
    "defaultValue": "-20",
    "label": "Highlight Pad"
   },
   {
    "key": "lineSpacing",
    "type": "text",
    "defaultValue": "148",
    "label": "Line Spacing"
   },
   {
    "key": "ruleWidth",
    "type": "text",
    "defaultValue": "10",
    "label": "Rule Width"
   },
   {
    "key": "marginWidth",
    "type": "text",
    "defaultValue": "6",
    "label": "Margin Width"
   },
   {
