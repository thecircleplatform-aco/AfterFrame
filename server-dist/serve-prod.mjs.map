  "description": "A clean geometric lower third with a pure white strip and flat cobalt blue diamond accent. Features a smooth linear slide-in, horizontal text wipes, and an extending accent bar.",
  "tags": [
   "Content Cards、Character Intro、Intro Cards"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
