  "thumb": "/thumbnails/b18138db-db81-4e97-8eec-30e69ca071b3.jpg",
  "code": "const Chart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const props = item.props || {};\n  const titleText      = props.titleText;\n  const subtitleText   = props.subtitleText;\n  const seriesALabel   = props.seriesALabel;\n  const seriesBLabel   = props.seriesBLabel;\n  const moreAboveLabel = props.moreAboveLabel;\n  const moreBelowLabel = props.moreBelowLabel;\n  const seriesAPos     = props.seriesAPos;\n  const seriesANeg     = props.seriesANeg;\n  const seriesBPos     = props.seriesBPos;\n  const seriesBNeg     = props.seriesBNeg;\n  const bgColor        = props.bgColor;\n  const textColor      = props.textColor;\n  const gridColor      = props.gridColor;\n  const titleFontFamily  = props.titleFontFamily;\n  const labelFontFamily  = props.labelFontFamily;\n  const transparentBackground = props.transparentBackground;\n\n  const data = [\n    { year: '2000', a: +2.3, b: -2.2 },\n    { year: '2004', a: +3.0, b: -2.8 },\n    { year: '2008', a: +3.2, b: -3.0 },\n    { year: '2012', a: +4.3, b: -4.1 },\n    { year: '2016', a: +2.5, b: -2.4 },\n    { year: '2020', a: +3.6, b: -3.1 },\n  ];\n\n  const SAFE_L = 192; const SAFE_R = 1728; const SAFE_T = 108; const SAFE_B = 972;\n  const TITLE_Y    = SAFE_T + 52;\n  const SUBTITLE_Y = TITLE_Y + 46;\n  const LEGEND_Y   = SUBTITLE_Y + 38;\n  const CHART_TOP  = LEGEND_Y + 28;\n  const CHART_BOT  = SAFE_B - 40;\n  const CHART_H    = CHART_BOT - CHART_TOP;\n\n  const ANNOT_X    = SAFE_L;\n  const ANNOT_MAX  = 310;\n  const TICK_RIGHT = ANNOT_MAX + 78;\n  const CHART_LEFT = TICK_RIGHT + 16;\n  const CHART_RIGHT = SAFE_R;\n  const YEAR_Y     = CHART_BOT + 36;\n\n  const PX_PER_PT = CHART_H / 10;\n  const ZERO_Y    = CHART_TOP + 5 * PX_PER_PT;\n\n  const ticks      = [-4,-2,0,2,4].map(v => ({ v, y: ZERO_Y - v * PX_PER_PT }));\n  const minorTicks = [-5,-3,-1,1,3,5].map(v => ({ v, y: ZERO_Y - v * PX_PER_PT }));\n\n  const aboveMidY = ZERO_Y - 3 * PX_PER_PT;\n  const belowMidY = ZERO_Y + 3 * PX_PER_PT;\n\n  const aboveLine1 = moreAboveLabel + ' ↑';\n  const aboveLine2 = 'than avg';\n  const belowLine1 = moreBelowLabel + ' ↓';\n  const belowLine2 = 'than avg';\n\n  const chartWidth = CHART_RIGHT - CHART_LEFT;\n  const groupWidth = chartWidth / 6;\n  const yearCX = data.map((_, i) => CHART_LEFT + groupWidth * i + groupWidth / 2);\n  const barWidth = groupWidth * 0.20;\n  const barGap   = groupWidth * 0.04;\n\n  const BAR_GROW = 28; const LABEL_FADE = 8; const AB_GAP = 22; const YEAR_GAP = 36; const START = 8;\n  const easeOut = (t) => 1 - Math.pow(1 - Math.min(1, Math.max(0, t)), 3);\n\n  const watermarks = React.useMemo(() => {\n    const symbols = ['∑','∫','π','Δ','α','β','∞','≈','≠','≤','≥','Ω','µ','√'];\n    const out = [];\n    let seed = 12345;\n    const rng = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };\n    for (let i = 0; i < 40; i++) {\n      out.push({ id: i, char: symbols[Math.floor(rng() * symbols.length)],\n        left: `${rng()*110-5}%`, top: `${rng()*110-5}%`,\n        size: 150 + rng()*450, rot: (rng()-0.5)*120, opacity: 0.02+rng()*0.03 });\n    }\n    return out;\n  }, []);\n\n  const rootStyle = { position: 'absolute', inset: 0, backgroundColor: transparentBackground ? 'transparent' : bgColor };\n\n  return (\n    <div style={rootStyle}>\n\n      {/* Grid background — from News Card */}\n      {!transparentBackground && (\n        <div style={{ position: 'absolute', inset: 0, zIndex: 1 }}>\n          <svg width=\"100%\" height=\"100%\">\n            <defs>\n              <pattern id=\"cgrid\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\">\n                <path d=\"M 40 0 L 40 80 M 0 40 L 80 40\" stroke=\"#999\" strokeOpacity=\"0.06\" strokeWidth=\"1.5\"/>\n                <path d=\"M 33 40 L 47 40 M 40 33 L 40 47\" stroke=\"#999\" strokeOpacity=\"0.15\" strokeWidth=\"2\"/>\n              </pattern>\n            </defs>\n            <rect width=\"100%\" height=\"100%\" fill=\"url(#cgrid)\"/>\n          </svg>\n        </div>\n      )}\n\n      {/* Watermark symbols — from News Card */}\n      {!transparentBackground && (\n        <div style={{ position: 'absolute', inset: 0, zIndex: 2 }}>\n          {watermarks.map(wm => (\n            <div key={wm.id} style={{\n              position: 'absolute', left: wm.left, top: wm.top,\n              fontSize: wm.size, color: '#888', opacity: wm.opacity,\n              transform: `rotate(${wm.rot}deg)`, lineHeight: 1, fontFamily: 'serif',\n            }}>{wm.char}</div>\n          ))}\n        </div>\n      )}\n\n      {/* Chart layer */}\n      <div style={{ position: 'absolute', inset: 0, zIndex: 10 }}>\n        <svg width=\"1920\" height=\"1080\" style={{ position: 'absolute', inset: 0 }}>\n          <text x={SAFE_L} y={TITLE_Y} fontFamily={titleFontFamily} fontSize={50} fontWeight=\"800\" fill={textColor}>{titleText}</text>\n          <text x={SAFE_L} y={SUBTITLE_Y} fontFamily={labelFontFamily} fontSize={24} fill={textColor} style={{opacity:0.62}}>{subtitleText}</text>\n\n          <rect x={CHART_LEFT} y={LEGEND_Y-16} width={18} height={18} fill={seriesAPos} />\n          <text x={CHART_LEFT+26} y={LEGEND_Y} fontFamily={labelFontFamily} fontSize={22} fill={textColor}>{seriesALabel}</text>\n          <rect x={CHART_LEFT+260} y={LEGEND_Y-16} width={18} height={18} fill={seriesBNeg} />\n          <text x={CHART_LEFT+286} y={LEGEND_Y} fontFamily={labelFontFamily} fontSize={22} fill={textColor}>{seriesBLabel}</text>\n\n          {minorTicks.map(({v,y}) => (\n            <line key={`m${v}`} x1={CHART_LEFT} y1={y} x2={CHART_RIGHT} y2={y} stroke={gridColor} strokeWidth={0.5} strokeDasharray=\"4 4\" />\n          ))}\n          {ticks.map(({v,y}) => (\n            <g key={`t${v}`}>\n              <line x1={CHART_LEFT} y1={y} x2={CHART_RIGHT} y2={y} stroke={v===0?textColor:gridColor} strokeWidth={v===0?1.5:1} />\n              <text x={TICK_RIGHT} y={y+8} textAnchor=\"end\" fontFamily={labelFontFamily} fontSize={22} fill={textColor}>\n                {v===0?'0':v>0?`+${v}`:`${v}`}\n              </text>\n            </g>\n          ))}\n\n          <text x={ANNOT_X} y={aboveMidY - 12} fill={seriesAPos} fontFamily={labelFontFamily} fontSize={18} fontWeight=\"700\">{aboveLine1}</text>\n          <text x={ANNOT_X} y={aboveMidY + 12} fill={seriesAPos} fontFamily={labelFontFamily} fontSize={15} style={{opacity:0.75}}>{aboveLine2}</text>\n          <text x={ANNOT_X} y={belowMidY - 12} fill={seriesBNeg} fontFamily={labelFontFamily} fontSize={18} fontWeight=\"700\">{belowLine1}</text>\n          <text x={ANNOT_X} y={belowMidY + 12} fill={seriesBNeg} fontFamily={labelFontFamily} fontSize={15} style={{opacity:0.75}}>{belowLine2}</text>\n\n          {data.map((d,i) => (\n            <text key={`yr${d.year}`} x={yearCX[i]} y={YEAR_Y} textAnchor=\"middle\" fontFamily={labelFontFamily} fontSize={26} fill={textColor}>{d.year}</text>\n          ))}\n        </svg>\n\n        <svg width=\"1920\" height=\"1080\" style={{ position: 'absolute', inset: 0 }}>\n          {data.map((d,i) => {\n            const cx = yearCX[i];\n            const ys = START + i*YEAR_GAP;\n            const agS=ys, agE=ys+BAR_GROW, bgS=ys+AB_GAP, bgE=bgS+BAR_GROW;\n            const aP=easeOut((frame-agS)/BAR_GROW), bP=easeOut((frame-bgS)/BAR_GROW);\n            const aLA=Math.min(1,Math.max(0,(frame-agE)/LABEL_FADE));\n            const bLA=Math.min(1,Math.max(0,(frame-bgE)/LABEL_FADE));\n\n            const aC=d.a>=0?seriesAPos:seriesANeg, hA=Math.abs(d.a)*PX_PER_PT*aP;\n            const yA=d.a>=0?ZERO_Y-hA:ZERO_Y, lyA=d.a>=0?yA-13:yA+hA+27;\n            const aX=cx-barWidth-barGap/2;\n\n            const bC=d.b>=0?seriesBPos:seriesBNeg, hB=Math.abs(d.b)*PX_PER_PT*bP;\n            const yB=d.b>=0?ZERO_Y-hB:ZERO_Y, lyB=d.b>=0?yB-13:yB+hB+27;\n            const bX=cx+barGap/2;\n\n            const aRGB=d.a>=0?'253,43,0':'68,180,254';\n            const bRGB=d.b>=0?'210,0,20':'24,130,230';\n\n            return (\n              <g key={`b${d.year}`}>\n                {hA>0&&<rect x={aX} y={yA} width={barWidth} height={Math.max(0.1,hA)} fill={aC}/>}\n                <text x={aX+barWidth/2} y={lyA} fill={`rgba(${aRGB},${aLA})`} fontSize={19} fontWeight=\"700\" fontFamily={labelFontFamily} textAnchor=\"middle\">Retail</text>\n                {hB>0&&<rect x={bX} y={yB} width={barWidth} height={Math.max(0.1,hB)} fill={bC}/>}\n                <text x={bX+barWidth/2} y={lyB} fill={`rgba(${bRGB},${bLA})`} fontSize={19} fontWeight=\"700\" fontFamily={labelFontFamily} textAnchor=\"middle\">Tech</text>\n              </g>\n            );\n          })}\n        </svg>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "82cf935e-d02a-496b-bad3-12a3876328a9",
  "name": "Generation Two — chapter title card",
  "category": "uncategorized",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/82cf935e-d02a-496b-bad3-12a3876328a9.jpg",
  "code": "const TitleReveal = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  // ---- BAKED VALUES (from timeline item overrides + asset defaults) ----\n  const mainText = \"CHAPTER FOUR\";\n  const bgColor = \"#527692\";\n  const textColor = \"#ffffff\";\n  const dotColor = \"#350b21\";\n  const fontFamily = \"'Arial Black', 'Impact', sans-serif\";\n  // -----------------------------------------------------------------------\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const lines = String(mainText)\n    .split(/\\n|<br\\s*\\/?>/ )\n    .map((l) => l.trim())\n    .filter(Boolean);\n\n  const bgMoveX = frame * 0.28;\n  const bgMoveY = Math.sin(frame * 0.025) * 12;\n\n  const titleReveal = interpolate(frame, [0, 45], [0, 1], {\n    easing: Easing.bezier(0.16, 1, 0.3, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const titleX = interpolate(titleReveal, [0, 1], [-DESIGN_WIDTH * 0.7, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const titleBlurRaw = interpolate(frame, [0, 45], [20, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const titleBlur = Math.round(titleBlurRaw * 2) / 2;\n\n  const microX = interpolate(frame, [32, 70], [-60, 0], {\n    easing: Easing.bezier(0.16, 1, 0.3, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const microBlurRaw = interpolate(frame, [32, 55], [8, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const microBlur = Math.round(microBlurRaw * 2) / 2;\n\n  const microAlpha = interpolate(frame, [32, 70], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const hexToRgb = (hex) => {\n    const h = (hex || '#ffffff').replace('#', '');\n    return {\n      r: parseInt(h.substring(0,2), 16),\n      g: parseInt(h.substring(2,4), 16),\n      b: parseInt(h.substring(4,6), 16),\n    };\n  };\n  const tc = hexToRgb(textColor);\n\n  const dots = React.useMemo(() => {\n    const arr = [];\n    let seed = 12;\n    const rand = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };\n    for (let c = -2; c <= 54; c++) {\n      for (let r = -2; r <= 32; r++) {\n        arr.push({\n          x: c * 38 + (rand() - 0.5) * 8,\n          y: r * 38 + (rand() - 0.5) * 8,\n          size: 1.1 + rand() * 1.6,\n          phase: rand() * Math.PI * 2,\n        });\n      }\n    }\n    return arr;\n  }, []);\n\n  const bgTexts = React.useMemo(() => {\n    const arr = [];\n    const rows = [\n      {y: 30, even: true}, {y: 175, even: false}, {y: 320, even: true},\n      {y: 740, even: true}, {y: 885, even: false}, {y: 1030, even: true},\n    ];\n    for (const {y, even} of rows) {\n      for (let c = -1; c <= 8; c++) {\n        arr.push({ x: c * 315 + (even ? 0 : 150), y });\n      }\n    }\n    return arr;\n  }, []);\n\n  const label = String(mainText).replace(/\\n/g, ' ').toUpperCase();\n  const titleTop = lines.length > 1 ? '42%' : '50%';\n  const titleTranslate = lines.length > 1 ? 'translate(-50%, -100%)' : 'translate(-50%, -50%)';\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: scale === 1 ? 'scale(1)' : `scale(${scale})`,\n      transformOrigin: 'top left',\n      backgroundColor: bgColor,\n      overflow: 'hidden',\n    }}>\n      <div style={{\n        position: 'absolute', inset: 0,\n        background: 'radial-gradient(circle at 28% 44%, rgba(255,255,255,0.04), transparent 30%), radial-gradient(circle at 74% 38%, rgba(0,0,0,0.06), transparent 34%)',\n      }} />\n\n      <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT}\n        style={{ position: 'absolute', inset: 0, transform: `translate(${bgMoveX}px,${bgMoveY}px)` }}>\n        {dots.map((d, i) => {\n          const pulse = Math.sin(frame * 0.035 + d.phase);\n          return (\n            <circle key={i} cx={d.x} cy={d.y}\n              r={Math.max(0.4, d.size + pulse * 0.28)}\n              fill={dotColor}\n              opacity={0.34 + pulse * 0.12}\n            />\n          );\n        })}\n      </svg>\n\n      <div style={{\n        position: 'absolute', inset: 0,\n        transform: `translateX(${microX}px)`,\n      }}>\n        {bgTexts.map((t, i) => (\n          <div key={i} style={{\n            position: 'absolute',\n            left: t.x, top: t.y,\n            fontFamily, fontSize: 13, fontWeight: 900,\n            color: `rgba(${tc.r},${tc.g},${tc.b},${microAlpha * 0.58})`,\n            textTransform: 'uppercase',\n            whiteSpace: 'nowrap',\n            filter: microBlur > 0 ? `blur(${microBlur}px)` : 'none',\n          }}>\n            {label}\n          </div>\n        ))}\n      </div>\n\n      <div style={{ position: 'absolute', inset: 0, overflow: 'hidden' }}>\n        <div style={{\n          position: 'absolute', inset: 0,\n          transform: `translateX(${titleX}px)`,\n        }}>\n          {lines.map((line, i) => (\n            <div key={i} style={{\n              position: 'absolute',\n              left: '50%',\n              top: i === 0 ? titleTop : '58%',\n              transform: i === 0 ? titleTranslate : 'translate(-50%, 0%)',\n              fontFamily,\n              fontSize: i === 0 ? 164 : 150,\n              fontWeight: 900,\n              color: textColor,\n              whiteSpace: 'nowrap',\n              letterSpacing: -7,\n              textTransform: 'uppercase',\n              filter: titleBlur > 0 ? `blur(${titleBlur}px)` : 'none',\n            }}>\n              {line.toUpperCase()}\n            </div>\n          ))}\n        </div>\n      </div>\n\n      <div style={{\n        position: 'absolute', inset: 0,\n        pointerEvents: 'none',\n        backgroundImage: 'radial-gradient(rgba(255,255,255,0.1) 0.7px, transparent 0.7px)',\n        backgroundSize: '5px 5px',\n      }} />\n    </div>\n  );\n};\n"
 },
 {
  "id": "a9f9348f-eb15-4064-b5d8-f164dd82cb9b",
  "name": "Glowing Ring MG — bullet list reveal",
  "category": "uncategorized",
  "description": "A cinematic overlay featuring a central expanding glowing ring with sequentially fading text elements and a subtle noise grain background.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "Booking Rate Factors",
   "bullet1": "•Session Length",
   "bullet2": "•Studio Location",
   "bullet3": "•Genre Rate",
   "fontFamily": "Inter, sans-serif",
   "glowIntensity": 5,
   "dotDensity": 6,
   "ringColor": "#f6f0ff",
   "transparentBackground": false
  },
  "propSchema": [
   {
