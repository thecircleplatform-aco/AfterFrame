    "label": "Transparent Background"
   }
  ],
  "thumb": "/thumbnails/61b838f2-a46c-4118-91e4-1c2d61e5b184.jpg",
  "code": "const QuoteCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const { durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const quoteText = props.quoteText;\n  const quoteColor = props.quoteColor;\n  const textColor = props.textColor;\n  const fontFamily = props.fontFamily;\n  const transparentBackground = props.transparentBackground;\n\n  // 扩大内部画布，给光效留出血区\n  const DESIGN_WIDTH = 1060;\n  const DESIGN_HEIGHT = 680;\n\n  const hexToRgb = (hex) => {\n    const h = (hex || '#ffffff').replace('#', '');\n    const r = parseInt(h.substring(0,2), 16);\n    const g = parseInt(h.substring(2,4), 16);\n    const b = parseInt(h.substring(4,6), 16);\n    return {r, g, b};\n  };\n\n  const qc = hexToRgb(quoteColor);\n  const tc = hexToRgb(textColor);\n\n  const masterAlpha = interpolate(frame, [0, 25], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const textAlpha = interpolate(frame, [12, 32], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const cardY = interpolate(frame, [0, 28], [24, 0], {\n    extrapolateRight: 'clamp',\n    easing: Easing.out(Easing.cubic),\n  });\n\n  const fadeOutStart = durationInFrames > 18 ? durationInFrames - 18 : 0;\n  const exitAlpha = interpolate(frame, [fadeOutStart, durationInFrames], [1, 0], {\n    extrapolate: 'clamp',\n  });\n  const exitY = interpolate(frame, [fadeOutStart, durationInFrames], [0, 24], {\n    extrapolate: 'clamp',\n    easing: Easing.in(Easing.cubic),\n  });\n\n  const isExiting = frame >= fadeOutStart;\n  const finalAlpha = masterAlpha * exitAlpha;\n  const finalTextAlpha = textAlpha * exitAlpha;\n  const finalY = isExiting ? exitY : cardY;\n\n  const rootBg = (transparentBackground === 'true' || transparentBackground === true)\n    ? 'transparent'\n    : 'rgba(28,5,3,0.92)';\n\n  const QUOTE_SIZE = 160;\n\n  return (\n    <div\n      style={{\n        position: 'absolute', top: 0, left: 0,\n        width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n        transform: 'scale(1)', transformOrigin: 'top left',\n        display: 'flex', justifyContent: 'center', alignItems: 'center',\n        backgroundColor: rootBg,\n        overflow: 'visible',\n      }}\n    >\n      {/* 开引号 */}\n      <div\n        style={{\n          position: 'absolute',\n          top: 60, left: 60,\n          fontSize: QUOTE_SIZE,\n          fontFamily: 'Georgia, \"Times New Roman\", serif',\n          fontWeight: 'bold',\n          color: `rgba(${qc.r},${qc.g},${qc.b},${finalAlpha * 0.70})`,\n          lineHeight: 1,\n          userSelect: 'none',\n          zIndex: 0,\n          transform: `translateY(${finalY}px)`,\n        }}\n      >\n        {String.fromCharCode(8220)}\n      </div>\n\n      {/* 卡片 */}\n      <div\n        style={{\n          width: 650,\n          height: 340,\n          padding: '0 48px',\n          background: `linear-gradient(135deg, rgba(161,79,82,${finalAlpha}) 0%, rgba(157,74,82,${finalAlpha * 0.85}) 50%, rgba(176,93,82,${finalAlpha * 0.75}) 100%)`,\n          borderRadius: 20,\n          position: 'relative',\n          display: 'flex',\n          justifyContent: 'center',\n          alignItems: 'center',\n          overflow: 'visible',\n          zIndex: 1,\n          transform: `translateY(${finalY}px)`,\n          boxShadow: `0 0 80px rgba(161,79,82,${finalAlpha * 0.55}), 0 0 160px rgba(217,137,102,${finalAlpha * 0.25})`,\n        }}\n      >\n        {/* 右上角粉色光晕 */}\n        <div style={{\n          position: 'absolute',\n          top: -60, right: -60,\n          width: 220, height: 180,\n          borderRadius: '50%',\n          background: `radial-gradient(circle, rgba(217,137,102,${finalAlpha * 0.60}) 0%, rgba(217,137,102,0) 70%)`,\n          filter: 'blur(24px)',\n          pointerEvents: 'none',\n        }} />\n        {/* 左下角蓝紫光晕 */}\n        <div style={{\n          position: 'absolute',\n          bottom: -50, left: -50,\n          width: 200, height: 160,\n          borderRadius: '50%',\n          background: `radial-gradient(circle, rgba(176,93,82,${finalAlpha * 0.50}) 0%, rgba(176,93,82,0) 70%)`,\n          filter: 'blur(20px)',\n          pointerEvents: 'none',\n        }} />\n        <div\n          style={{\n            fontSize: 26,\n            fontFamily: fontFamily,\n            color: `rgba(${tc.r},${tc.g},${tc.b},${finalTextAlpha})`,\n            textAlign: 'center',\n            lineHeight: 1.55,\n            fontWeight: 600,\n            maxWidth: 560,\n            position: 'relative',\n            zIndex: 1,\n          }}\n        >\n          {quoteText}\n        </div>\n      </div>\n\n      {/* 闭引号 */}\n      <div\n        style={{\n          position: 'absolute',\n          bottom: 60, right: 60,\n          fontSize: QUOTE_SIZE,\n          fontFamily: 'Georgia, \"Times New Roman\", serif',\n          fontWeight: 'bold',\n          color: `rgba(${qc.r},${qc.g},${qc.b},${finalAlpha * 0.70})`,\n          lineHeight: 1,\n          userSelect: 'none',\n          zIndex: 2,\n          transform: `translateY(${finalY}px)`,\n        }}\n      >\n        {String.fromCharCode(8221)}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "630caca9-93c5-459c-bae6-6c0bd0338124",
  "name": "MindSpace — Ribbon Statement",
  "category": "uncategorized",
  "description": "A dynamic fluid ribbon draws an S-curve across the screen in 3 phases with a word-by-word staggered text spring reveal.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bodyText": "Explore. Wander. Return.",
   "fontFamily": "DM Sans",
   "textColor": "#ffffff",
   "ribbonColorStart": "#b42e45",
   "ribbonColorMid": "#c94346",
   "ribbonColorEnd": "#f4773b",
   "bgBaseColor": "#000d1f",
   "animationSpeed": 1,
   "transparentBackground": false
  },
  "propSchema": [
   {
    "key": "bodyText",
    "type": "text",
    "defaultValue": "Explore. Wander. Return.",
    "label": "Statement Text"
   },
   {
    "key": "fontFamily",
    "type": "font",
