  "code": "const BulletPointOverlay = ({item}) => { const frame = useCurrentFrame(); const props = item.props || {}; const bgColor = props.bgColor; const transparentBackground = props.transparentBackground; const fontFamily = props.fontFamily; const text1 = props.text1; const text2 = props.text2; const text3 = props.text3; const text4 = props.text4; const DESIGN_WIDTH = 1920; const DESIGN_HEIGHT = 1080; const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT); const rootStyle = { position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: `scale(${scale})`, transformOrigin: 'top left', backgroundColor: 'transparent' }; const IconWrapper = ({ children, item }) => ( <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#18182a\" strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\"> {children} </svg> ); const cardsData = [ { text: text1, y: 179, x: 99, icon: <IconWrapper><path d=\"M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589c-.336-2.002-2.302-3.468-4.593-3.468-2.29 0-4.257 1.466-4.593 3.468a4 4 0 0 0-2.134 7.59c.411.196.727.583.727 1.04V20a1 1 0 0 0 1 1Z\" /><path d=\"M6 17h12\" /></IconWrapper> }, { text: text2, y: 417, x: 402, icon: <IconWrapper><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\" /><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\" /></IconWrapper> }, { text: text3, y: 662, x: 99, icon: <IconWrapper><path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z\" /></IconWrapper> }, { text: text4, y: 907, x: 402, icon: <IconWrapper><path d=\"M8 2h8\" /><path d=\"M9 2v2.789a4 4 0 0 1-.672 2.219l-.656.984A4 4 0 0 0 7 10.212V20a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-9.789a4 4 0 0 0-.672-2.219l-.656-.984A4 4 0 0 1 15 4.788V2\" /></IconWrapper> } ]; return ( <div style={rootStyle}> <svg width=\"1920\" height=\"1080\" style={{ position: 'absolute', top: 0, left: 0 }}> <defs> <mask id=\"video-mask\"> <rect width=\"1920\" height=\"1080\" fill=\"white\" /> <rect x=\"1350\" y=\"172\" width=\"514\" height=\"715\" rx=\"26\" fill=\"black\" /> </mask> <filter id=\"glow\"> <feGaussianBlur stdDeviation=\"4\" result=\"coloredBlur\"/> <feMerge> <feMergeNode in=\"coloredBlur\"/> <feMergeNode in=\"SourceGraphic\"/> </feMerge> </filter> </defs> {!transparentBackground && ( <rect width=\"1920\" height=\"1080\" fill={bgColor} mask=\"url(#video-mask)\" /> )} <rect x=\"1350\" y=\"172\" width=\"514\" height=\"715\" rx=\"26\" fill=\"none\" stroke=\"#a8a8c8\" strokeWidth=\"2\" filter=\"url(#glow)\" opacity={transparentBackground ? 0 : 1} /> </svg> {cardsData.map((card, i) => { const enterStart = 20 + i * 25; const exitStart = 155; const pIn = interpolate(frame, [enterStart, enterStart + 14], [0, 1], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp', easing: Easing.out(Easing.quad) }); const pOut = interpolate(frame, [exitStart, exitStart + 14], [0, 1], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp', easing: Easing.in(Easing.quad) }); const cardX = interpolate(pIn, [0, 1], [-50, 0]) + interpolate(pOut, [0, 1], [0, -50]); const cardOpacity = pIn - pOut; const safeCardOpacity = Math.max(0, cardOpacity); const textEnterStart = enterStart + 6; const tIn = interpolate(frame, [textEnterStart, textEnterStart + 14], [0, 1], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp', easing: Easing.out(Easing.quad) }); const textOpacity = tIn - pOut; const safeTextOpacity = Math.max(0, textOpacity); const textX = interpolate(tIn, [0, 1], [-20, 0]); const cardStyle = { position: 'absolute', left: card.x, top: card.y - 80, width: 735, height: 160, backgroundColor: '#F0EDE6', borderRadius: 18, display: 'flex', alignItems: 'center', padding: '0 40px', boxSizing: 'border-box', transform: `translateX(${cardX}px)`, opacity: safeCardOpacity, fontFamily: fontFamily }; const iconContainerStyle = { width: 80, height: 80, borderRadius: 40, backgroundColor: '#a8a8c8', display: 'flex', justifyContent: 'center', alignItems: 'center', flexShrink: 0 }; const textStyle = { marginLeft: 32, color: '#18182a', fontSize: 42, fontWeight: 600, opacity: safeTextOpacity, transform: `translateX(${textX}px)`, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }; return ( <div key={i} style={cardStyle}> <div style={iconContainerStyle}> {card.icon} </div> <div style={textStyle}> {card.text} </div> </div> ); })} </div> ); };"
 },
 {
  "id": "79b030e8-cd48-4065-8beb-4cd3644ab9fe",
  "name": "Bullet Points Overlay - Soft Coral",
  "category": "talking-head-overlays",
  "description": "A full-screen overlay featuring four animated bullet points that slide in sequentially and exit together. A masked area on the right is reserved for video content.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgColor": "#FAF3E8",
   "transparentBackground": false,
   "text1": "Homes now add solar 3 times faster",
   "text2": "US saves 250 million kWh daily",
   "text3": "Rooftop panels are the top upgrade",
   "text4": "Startups offer free audits & grants",
   "fontFamily": "Inter, sans-serif"
  },
  "propSchema": [
   {
