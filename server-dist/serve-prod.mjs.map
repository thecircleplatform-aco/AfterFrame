    "type": "color",
    "defaultValue": "#000d1f",
    "label": "Background Color"
   },
   {
    "key": "bgAccent1",
    "type": "color",
    "defaultValue": "#32445b",
    "label": "Accent 1"
   },
   {
    "key": "bgAccent2",
    "type": "color",
    "defaultValue": "#1a3043",
    "label": "Accent 2"
   },
   {
    "key": "animationSpeed",
    "type": "number",
    "defaultValue": 1,
    "label": "Animation Speed"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
    "defaultValue": false,
    "label": "Transparent Background"
   }
  ],
  "thumb": "/thumbnails/0d0b9a79-bcc9-4c55-82f3-5a12a2a2a6ce.jpg",
  "code": "const StaggeredQuestions = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n\n  const q1Text = props.q1Text;\n  const q2Text = props.q2Text;\n  const q3Text = props.q3Text;\n  const q4Text = props.q4Text;\n  const fontFamily = props.fontFamily;\n  const textColor = props.textColor;\n  const bgBaseColor = props.bgBaseColor;\n  const bgAccent1 = props.bgAccent1;\n  const bgAccent2 = props.bgAccent2;\n  const animationSpeed = props.animationSpeed;\n  const transparentBackground = props.transparentBackground;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const sprConfig = { damping: 18, stiffness: 120 };\n  const speed = Math.max(0.1, animationSpeed);\n  const numberToFirstWord = Math.max(1, Math.round(6 / speed));\n  const wordDelay = Math.max(1, Math.round(5 / speed));\n  const interRowGap = Math.max(1, Math.round(12 / speed));\n\n  const parseQuestion = (text) => {\n    const match = text.match(/^(\\d+\\.)\\s*([\\s\\S]*)/);\n    if (match) return { number: match[1], words: match[2].replace(/\\n/g, ' ').split(' ').filter(Boolean) };\n    return { number: '', words: text.split(' ').filter(Boolean) };\n  };\n\n  const questions = [q1Text, q2Text, q3Text, q4Text];\n  const parsed = questions.map(parseQuestion);\n\n  const rowStarts = [];\n  let cursor = 15;\n  for (let i = 0; i < parsed.length; i++) {\n    rowStarts.push(cursor);\n    const lastWordOffset = numberToFirstWord + (parsed[i].words.length - 1) * wordDelay;\n    cursor = cursor + lastWordOffset + interRowGap;\n  }\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: transparentBackground ? 'transparent' : bgBaseColor,\n    overflow: 'hidden',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  const textContainerStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    width: '1000px',\n    transform: 'translateX(80px)',\n    zIndex: 10,\n  };\n\n  const sharedTextStyle = {\n    fontFamily,\n    fontSize: '60px',\n    fontWeight: 800,\n    color: textColor,\n    lineHeight: 1.25,\n    letterSpacing: '-0.02em',\n    textShadow: '0px 4px 16px rgba(0,0,0,0.4)',\n  };\n\n  return (\n    <div style={rootStyle}>\n      {!transparentBackground && (\n        <div style={{ position: 'absolute', width: '100%', height: '100%', top: 0, left: 0 }}>\n          <div style={{ position: 'absolute', width: '100%', height: '100%', filter: 'blur(100px)' }}>\n            <div style={{ position: 'absolute', top: '-20%', left: '-10%', width: '80%', height: '80%', backgroundColor: bgAccent1, borderRadius: '50%', opacity: 0.6 }} />\n            <div style={{ position: 'absolute', top: '40%', right: '-20%', width: '70%', height: '90%', backgroundColor: bgAccent2, borderRadius: '50%', opacity: 0.6 }} />\n            <div style={{ position: 'absolute', top: '10%', left: '40%', width: '60%', height: '60%', backgroundColor: bgAccent1, borderRadius: '50%', opacity: 0.4 }} />\n          </div>\n        </div>\n      )}\n\n      <div style={textContainerStyle}>\n        {parsed.map(({ number, words }, qi) => {\n          const rowStart = rowStarts[qi];\n\n          const numSpr = spring({ frame: Math.max(0, frame - rowStart), fps: safeFps, config: sprConfig });\n          const numOpacity = Math.min(1, Math.max(0, numSpr));\n          const numTx = interpolate(numSpr, [0, 1], [-28, 0]);\n\n          return (\n            <div key={qi} style={{\n              ...sharedTextStyle,\n              display: 'flex',\n              flexDirection: 'row',\n              alignItems: 'flex-start',\n              marginBottom: '35px',\n            }}>\n              {/* Number column — fixed width so words always start at same X */}\n              <span style={{\n                display: 'inline-block',\n                flexShrink: 0,\n                width: '90px',\n                opacity: numOpacity,\n                transform: `translateX(${numTx}px)`,\n              }}>\n                {number}\n              </span>\n              {/* Words column — wraps internally, second line aligns with first word */}\n              <div style={{\n                display: 'flex',\n                flexWrap: 'wrap',\n                alignItems: 'baseline',\n                columnGap: '0.3em',\n                rowGap: '0.1em',\n                flex: 1,\n              }}>\n                {words.map((word, wi) => {\n                  const wordStart = rowStart + numberToFirstWord + wi * wordDelay;\n                  const wSpr = spring({ frame: Math.max(0, frame - wordStart), fps: safeFps, config: sprConfig });\n                  const wOpacity = Math.min(1, Math.max(0, wSpr));\n                  const wTx = interpolate(wSpr, [0, 1], [30, 0]);\n                  return (\n                    <span key={wi} style={{\n                      display: 'inline-block',\n                      opacity: wOpacity,\n                      transform: `translateX(${wTx}px)`,\n                    }}>\n                      {word}\n                    </span>\n                  );\n                })}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
