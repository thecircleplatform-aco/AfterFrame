  "thumb": "/thumbnails/b820ad1e-f2e5-4a49-93de-28add26db506.jpg",
  "code": "const MinimalFlatLowerThird = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const nameText = props.nameText || 'Maya Cole';\n  const titleText = props.titleText || 'Title';\n  const introText = props.introText || 'Indie Studio Founder';\n  const accentColor = props.accentColor || '#00873d';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n  const logoUrl = props.logoUrl || '';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const exitStart = durationInFrames - 30;\n  const phase = frame < exitStart\n    ? interpolate(frame, [0, 25], [0, 1], { extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic) })\n    : interpolate(frame, [exitStart, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.in(Easing.cubic) });\n\n  const slideX = interpolate(phase, [0, 1], [-1200, 0], { easing: Easing.out(Easing.cubic) });\n\n  const wipeProgress = frame < exitStart\n    ? interpolate(frame, [20, 38], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' })\n    : phase;\n  const wipeProgress2 = frame < exitStart\n    ? interpolate(frame, [28, 46], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' })\n    : phase;\n  const barProgress = frame < exitStart\n    ? interpolate(frame, [38, 55], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' })\n    : phase;\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      backgroundColor: 'transparent',\n      fontFamily,\n    }}>\n      <div style={{ position: 'absolute', bottom: 120, left: 160 }}>\n        <div style={{\n          position: 'relative',\n          display: 'flex',\n          alignItems: 'center',\n          transform: `translateX(${slideX}px)`,\n        }}>\n\n          {/* Diamond badge */}\n          <div style={{\n            position: 'absolute',\n            left: -90,\n            width: 180,\n            height: 180,\n            backgroundColor: accentColor,\n            clipPath: 'polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%)',\n            zIndex: 2,\n            display: 'flex',\n            justifyContent: 'center',\n            alignItems: 'center',\n            overflow: 'hidden',\n          }}>\n            {logoUrl ? (\n              <Img src={logoUrl} style={{ width: '60%', height: '60%', objectFit: 'contain' }} />\n            ) : (\n              <svg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" fill=\"none\">\n                <rect x=\"12\" y=\"12\" width=\"36\" height=\"36\" rx=\"4\" fill=\"white\" opacity=\"0.9\"/>\n                <rect x=\"20\" y=\"20\" width=\"8\" height=\"8\" fill={accentColor}/>\n                <rect x=\"32\" y=\"20\" width=\"8\" height=\"8\" fill={accentColor}/>\n                <rect x=\"26\" y=\"32\" width=\"8\" height=\"8\" fill={accentColor}/>\n              </svg>\n            )}\n          </div>\n\n          {/* White Strip — tighter padding, no minWidth, shrinks to content */}\n          <div style={{\n            backgroundColor: '#ffffff',\n            padding: '16px 30px 16px 104px',\n            display: 'inline-flex',\n            flexDirection: 'column',\n            position: 'relative',\n            boxShadow: '0 8px 30px rgba(0,0,0,0.10)',\n            overflow: 'visible',\n          }}>\n            {/* Accent bar at bottom */}\n            <div style={{\n              position: 'absolute',\n              bottom: 0, left: 0, right: 0,\n              height: 5,\n              backgroundColor: accentColor,\n              transform: `scaleX(${barProgress})`,\n              transformOrigin: 'left',\n            }} />\n\n            {/* Name */}\n            <div style={{\n              fontSize: 50,\n              fontWeight: 800,\n              color: '#000000',\n              lineHeight: 1.1,\n              whiteSpace: 'nowrap',\n              clipPath: `inset(0 ${(1 - wipeProgress) * 100}% 0 0)`,\n              marginBottom: 3,\n            }}>\n              {nameText}\n            </div>\n\n            {/* Title */}\n            <div style={{\n              fontSize: 24,\n              fontWeight: 600,\n              color: accentColor,\n              lineHeight: 1.2,\n              whiteSpace: 'nowrap',\n              clipPath: `inset(0 ${(1 - wipeProgress2) * 100}% 0 0)`,\n              marginBottom: 1,\n            }}>\n              {titleText}\n            </div>\n\n            {/* Intro */}\n            <div style={{\n              fontSize: 18,\n              fontWeight: 400,\n              color: '#666666',\n              lineHeight: 1.2,\n              whiteSpace: 'nowrap',\n              clipPath: `inset(0 ${(1 - wipeProgress2) * 100}% 0 0)`,\n            }}>\n              {introText}\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
