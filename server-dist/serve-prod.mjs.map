    "code": "const KbLatteLines = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const W = 1920, H = 1080, M = 96;\n  const ink = '#33291f';\n  const red = '#d9553f';\n  const accent = p.accentColor || '#f4b268';\n  const pos = String(p.position || 'bottom-right');\n  const R = Math.min(300, Math.max(110, Number(p.size) || 155));\n  const left = pos.indexOf('left') >= 0;\n  const top = pos.indexOf('top') >= 0;\n  const cx = left ? M + R : W - M - R;\n  const cy = top ? M + R : H - M - R;\n  const title = p.title == null ? '' : String(p.title);\n  const subtitle = p.subtitle == null ? '' : String(p.subtitle);\n  const handle = p.handle == null ? '' : String(p.handle);\n  const enter = spring({ frame, fps, config: { damping: 13, stiffness: 130 } });\n  const popIn = spring({ frame: frame - 5, fps, config: { damping: 11, stiffness: 150 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const sway = Math.sin((frame / 140) * Math.PI * 2);\n  const hole = 'radial-gradient(circle ' + R + 'px at ' + cx + 'px ' + cy + 'px, transparent ' + (R - 1) + 'px, #000 ' + R + 'px)';\n  const titleX = left ? cx + R + 110 : 250;\n  return (\n    <AbsoluteFill style={{ opacity: exit }}>\n      <AbsoluteFill style={{ backgroundColor: '#efe5d3', WebkitMaskImage: hole, maskImage: hole, opacity: enter }}>\n        <div style={{ position: 'absolute', inset: 0, backgroundImage: 'repeating-linear-gradient(180deg, transparent 0 86px, #c9b795b3 86px 88.5px)', backgroundPosition: '0 30px' }} />\n        <div style={{ position: 'absolute', left: 196, top: 0, width: 3, height: H, background: red + '73' }} />\n        <div style={{ position: 'absolute', left: 210, top: 0, width: 1.5, height: H, background: red + '40' }} />\n        <div style={{ position: 'absolute', left: 74, top: 150, width: 20, height: 20, borderRadius: '50%', border: '3px solid #b8a684' }} />\n        <div style={{ position: 'absolute', left: 74, top: 520, width: 20, height: 20, borderRadius: '50%', border: '3px solid #b8a684' }} />\n        <div style={{ position: 'absolute', left: 74, top: 890, width: 20, height: 20, borderRadius: '50%', border: '3px solid #b8a684' }} />\n      </AbsoluteFill>\n      {title ? (\n        <div style={{ position: 'absolute', left: titleX, top: 118 + (1 - enter) * 30, opacity: enter, maxWidth: 1000 }}>\n          <span style={{ display: 'inline-block', fontSize: 88, fontWeight: 800, color: ink, lineHeight: 1.3, letterSpacing: 2, background: 'linear-gradient(0deg, ' + accent + 'b3 0 42%, transparent 42%)', padding: '0 16px 4px', transform: 'rotate(-0.5deg)' }}>{title}</span>\n          {subtitle ? (\n            <div style={{ marginTop: 24, marginLeft: 18, display: 'inline-block', fontSize: 32, fontWeight: 700, color: ink + 'b8', letterSpacing: 3 }}>{subtitle}\n              <svg viewBox=\"0 0 300 16\" style={{ display: 'block', width: 300, height: 16, marginTop: 8 }}>\n                <path d=\"M4 10 Q 30 2, 56 9 T 108 9 T 160 9 T 212 9 T 264 9\" fill=\"none\" stroke={red} strokeWidth=\"4\" strokeLinecap=\"round\" />\n              </svg>\n            </div>\n          ) : null}\n        </div>\n      ) : null}\n      <svg viewBox=\"0 0 60 120\" style={{ position: 'absolute', width: 62, height: 124, left: left ? W - 250 : Math.round(0.60 * W), top: 84 + sway * 4, transform: 'rotate(' + (24 + sway * 3) + 'deg)', opacity: popIn }}>\n        <path d=\"M30 8 C 44 8, 50 18, 50 32 L 50 88 C 50 102, 40 110, 30 110 C 20 110, 12 102, 12 90 L 12 40 C 12 30, 18 24, 26 24 C 34 24, 40 30, 40 40 L 40 84\" fill=\"none\" stroke={ink} strokeWidth=\"5\" strokeLinecap=\"round\" />\n      </svg>\n      <div style={{ position: 'absolute', left: cx - R, top: cy - R, width: R * 2, height: R * 2, transform: 'scale(' + (0.72 + popIn * 0.28) + ')' }}>\n        <div style={{ position: 'absolute', inset: -12, borderRadius: '50%', border: '11px solid #fbf6ec', boxShadow: '0 0 0 3px ' + ink + ', 10px 12px 0 ' + ink + '1f' }} />\n      </div>\n      {handle ? (\n        <div style={{ position: 'absolute', left: cx, top: cy + R - 4, transform: 'translateX(-50%) rotate(-2.5deg)', opacity: popIn, background: '#fbf6ec', border: '2.5px solid ' + ink, borderRadius: 999, padding: '8px 24px', fontSize: 27, fontWeight: 800, color: ink, whiteSpace: 'nowrap', boxShadow: '4px 5px 0 ' + ink + '29' }}>{handle}</div>\n      ) : null}\n    </AbsoluteFill>\n  );\n};"
