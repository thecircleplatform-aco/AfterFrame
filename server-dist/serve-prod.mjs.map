  "thumb": "/thumbnails/19f4b9ff-8768-4c87-8e94-a5e5a9569cd7.jpg",
  "code": "const BlackFridayShowcase = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const safeFps = fps || 30;\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const glowColor = props.glowColor;\n  const accentColor = props.accentColor;\n  const textColor = props.textColor;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n\n  const titleText = props.titleText;\n  const quoteText = props.quoteText;\n  const nameTagBrand = props.nameTagBrand;\n  const nameTagEvent = props.nameTagEvent;\n\n  const bar1Label = props.bar1Label;\n  const bar1Value = props.bar1Value;\n  const bar2Label = props.bar2Label;\n  const bar2Value = props.bar2Value;\n  const bar3Label = props.bar3Label;\n  const bar3Value = props.bar3Value;\n\n  const bullet1 = props.bullet1;\n  const bullet2 = props.bullet2;\n  const bullet3 = props.bullet3;\n\n  const timeline1 = props.timeline1;\n  const timeline2 = props.timeline2;\n  const timeline3 = props.timeline3;\n  const timeline4 = props.timeline4;\n\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({\n      frame: Math.max(0, frame - delay),\n      fps: safeFps,\n      config\n    });\n  };\n\n  // Main Background\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  // Animations\n  const bgFade = interpolate(frame, [0, 15], [0, 1]);\n  const titleSpring = safeSpring(10, { damping: 14 });\n  const titleOpacity = interpolate(frame, [10, 25], [0, 1]);\n\n  const chartPanelSpring = safeSpring(20);\n  const chartOpacity = interpolate(frame, [20, 35], [0, 1]);\n\n  const bulletPanelSpring = safeSpring(25);\n  const bulletOpacity = interpolate(frame, [25, 40], [0, 1]);\n\n  const nameTagSpring = safeSpring(30);\n  const nameTagOpacity = interpolate(frame, [30, 45], [0, 1]);\n\n  const quoteSpring = safeSpring(35);\n  const quoteOpacity = interpolate(frame, [35, 50], [0, 1]);\n\n  const timelineLineSpring = safeSpring(40);\n  const timelineOpacity = interpolate(frame, [40, 55], [0, 1]);\n\n  const chartBars = [\n    { label: bar1Label, val: bar1Value, s: safeSpring(35) },\n    { label: bar2Label, val: bar2Value, s: safeSpring(45) },\n    { label: bar3Label, val: bar3Value, s: safeSpring(55) },\n  ];\n\n  const bullets = [\n    { text: bullet1, s: safeSpring(40) },\n    { text: bullet2, s: safeSpring(50) },\n    { text: bullet3, s: safeSpring(60) },\n  ];\n\n  const timelineNodes = [\n    { text: timeline1, s: safeSpring(50) },\n    { text: timeline2, s: safeSpring(60) },\n    { text: timeline3, s: safeSpring(70) },\n    { text: timeline4, s: safeSpring(80) },\n  ];\n\n  // Shared Glass Style\n  const glassPanel = {\n    backgroundColor: 'rgba(255, 255, 255, 0.03)',\n    borderTop: '1px solid rgba(255, 255, 255, 0.15)',\n    borderLeft: '1px solid rgba(255, 255, 255, 0.08)',\n    borderRight: '1px solid rgba(255, 255, 255, 0.02)',\n    borderBottom: '1px solid rgba(255, 255, 255, 0.02)',\n    borderRadius: 24,\n    boxShadow: `0 20px 50px rgba(0,0,0,0.8), inset 0 0 30px ${accentColor}11`,\n    position: 'absolute',\n  };\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor, overflow: 'hidden' }}>\n      {/* Ambient Red Glows */}\n      <div style={{ position: 'absolute', top: -300, left: '10%', width: 1000, height: 1000, background: `radial-gradient(circle, ${glowColor} 0%, transparent 60%)`, opacity: bgFade * 0.6, borderRadius: '50%' }} />\n      <div style={{ position: 'absolute', bottom: -400, right: '-5%', width: 1200, height: 1200, background: `radial-gradient(circle, ${glowColor} 0%, transparent 60%)`, opacity: bgFade * 0.4, borderRadius: '50%' }} />\n\n      {/* 1. Chapter Title */}\n      <div style={{ \n        ...glassPanel, \n        left: 260, top: 100, width: 1400, height: 260, \n        display: 'flex', alignItems: 'center', justifyContent: 'center',\n        opacity: titleOpacity, \n        transform: `scale(${interpolate(titleSpring, [0, 1], [0.95, 1])}) translateY(${interpolate(titleSpring, [0, 1], [20, 0])}px)`\n      }}>\n        <h1 style={{ \n          fontFamily: titleFont, fontSize: 160, fontWeight: 900, \n          color: textColor, margin: 0, letterSpacing: 8,\n          textShadow: `-2px -2px 0px rgba(255,255,255,0.2), 5px 5px 0px rgba(0,0,0,0.9), 0 0 50px ${accentColor}`\n        }}>\n          {titleText}\n        </h1>\n      </div>\n\n      {/* 3. Name Tag */}\n      <div style={{ \n        ...glassPanel, left: 350, top: 400, padding: '15px 35px', borderRadius: 40,\n        display: 'flex', alignItems: 'center', gap: 18,\n        opacity: nameTagOpacity, \n        transform: `translateX(${interpolate(nameTagSpring, [0, 1], [-40, 0])}px)`\n      }}>\n        <span style={{ fontFamily: titleFont, color: textColor, fontSize: 24, fontWeight: 'bold', letterSpacing: 2 }}>{nameTagBrand}</span>\n        <span style={{ width: 2, height: 24, backgroundColor: accentColor, boxShadow: `0 0 10px ${accentColor}` }} />\n        <span style={{ fontFamily: bodyFont, color: 'rgba(255,255,255,0.8)', fontSize: 22 }}>{nameTagEvent}</span>\n      </div>\n\n      {/* 5. Highlight Quote */}\n      <div style={{ \n        position: 'absolute', right: 350, top: 410, width: 480, textAlign: 'right',\n        opacity: quoteOpacity, \n        transform: `translateX(${interpolate(quoteSpring, [0, 1], [40, 0])}px)`\n      }}>\n        <span style={{ \n          fontFamily: bodyFont, color: textColor, fontSize: 32, fontStyle: 'italic', fontWeight: 600,\n          textShadow: `0 0 20px ${accentColor}`\n        }}>\n          \"{quoteText}\"\n        </span>\n      </div>\n\n      {/* 2. Data Chart Panel */}\n      <div style={{ \n        ...glassPanel, left: 350, top: 490, width: 480, height: 350, padding: '45px 50px', boxSizing: 'border-box',\n        opacity: chartOpacity, \n        transform: `translateY(${interpolate(chartPanelSpring, [0, 1], [40, 0])}px)`\n      }}>\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 35, height: '100%', justifyContent: 'center' }}>\n          {chartBars.map((b, i) => (\n            <div key={i} style={{ width: '100%' }}>\n              <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 10, fontFamily: bodyFont, color: textColor, fontSize: 24, fontWeight: 'bold' }}>\n                <span>{b.label}</span>\n                <span style={{ color: accentColor, textShadow: `0 0 10px ${accentColor}` }}>{Math.round(interpolate(b.s, [0, 1], [0, b.val]))}%</span>\n              </div>\n              <div style={{ width: '100%', height: 14, backgroundColor: 'rgba(255,255,255,0.06)', borderRadius: 7, overflow: 'hidden', boxShadow: 'inset 0 2px 4px rgba(0,0,0,0.5)' }}>\n                <div style={{ \n                  width: `${interpolate(b.s, [0, 1], [0, b.val])}%`, \n                  height: '100%', \n                  backgroundColor: accentColor, \n                  boxShadow: `0 0 15px ${accentColor}`, \n                  borderRadius: 7 \n                }} />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* 4. Bullet Points Panel */}\n      <div style={{ \n        ...glassPanel, right: 350, top: 490, width: 480, height: 350, padding: '45px 50px', boxSizing: 'border-box',\n        opacity: bulletOpacity, \n        transform: `translateY(${interpolate(bulletPanelSpring, [0, 1], [40, 0])}px)`\n      }}>\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 40, height: '100%', justifyContent: 'center' }}>\n          {bullets.map((b, i) => (\n            <div key={i} style={{ \n              display: 'flex', alignItems: 'center', gap: 24, \n              opacity: interpolate(b.s, [0, 1], [0, 1]), \n              transform: `translateX(${interpolate(b.s, [0, 1], [-20, 0])}px)` \n            }}>\n              <div style={{ \n                width: 18, height: 18, borderRadius: '50%', \n                backgroundColor: accentColor, \n                boxShadow: `0 0 16px ${accentColor}, inset 0 0 4px rgba(255,255,255,0.5)`, \n                flexShrink: 0 \n              }} />\n              <span style={{ fontFamily: bodyFont, color: textColor, fontSize: 28, fontWeight: 500, letterSpacing: 0.5 }}>{b.text}</span>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* 6. Timeline Component */}\n      <div style={{ \n        position: 'absolute', top: 920, left: 460, width: 1000, height: 100, \n        opacity: timelineOpacity \n      }}>\n        {/* The glowing line */}\n        <div style={{ \n          position: 'absolute', top: 20, left: 0, \n          width: `${interpolate(timelineLineSpring, [0, 1], [0, 100])}%`, height: 4, \n          background: `linear-gradient(90deg, transparent, ${accentColor} 10%, ${accentColor} 90%, transparent)`,\n          boxShadow: `0 0 10px ${accentColor}`\n        }} />\n        \n        {/* The nodes */}\n        {timelineNodes.map((n, i) => {\n          const nodeCenter = i * (1000 / 3);\n          return (\n            <div key={i} style={{ \n              position: 'absolute', left: nodeCenter - 60, top: 12, width: 120,\n              display: 'flex', flexDirection: 'column', alignItems: 'center', \n              opacity: interpolate(n.s, [0, 1], [0, 1]), \n              transform: `scale(${interpolate(n.s, [0, 1], [0.5, 1])})` \n            }}>\n              <div style={{ \n                width: 22, height: 22, borderRadius: '50%', \n                backgroundColor: bgColor, \n                border: `4px solid ${accentColor}`, \n                boxShadow: `0 0 15px ${accentColor}`, \n                boxSizing: 'border-box' \n              }} />\n              <span style={{ \n                marginTop: 18, fontFamily: titleFont, color: textColor, fontSize: 22, letterSpacing: 1,\n                textShadow: `0 2px 4px rgba(0,0,0,0.8)`\n              }}>\n                {n.text}\n              </span>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
