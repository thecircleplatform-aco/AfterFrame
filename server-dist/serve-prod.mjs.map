  "code": "const ComparisonTable = ({ item }) => {\n  const frame = useCurrentFrame();\n  const props = item.props || {};\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const bgColor = props.bgColor;\n  const dotColor = props.dotColor;\n  const titleColor = props.titleColor;\n  const accentLineColor = props.accentLineColor;\n\n  const wipePct = interpolate(frame, [0, 45], [-30, 150], { extrapolateRight: 'clamp' });\n  const maskStyle = {\n    WebkitMaskImage: `linear-gradient(45deg, rgba(0,1,9,1) ${wipePct}%, rgba(0,1,9,0) ${wipePct + 15}%)`,\n    maskImage: `linear-gradient(45deg, rgba(0,1,9,1) ${wipePct}%, rgba(0,1,9,0) ${wipePct + 15}%)`,\n  };\n\n  const dotRows = 35;\n  const dotCols = 60;\n  const dots = React.useMemo(() => {\n    const arr = [];\n    for (let r = 0; r < dotRows; r++)\n      for (let c = 0; c < dotCols; c++)\n        arr.push({ r, c });\n    return arr;\n  }, []);\n\n  const easeOut = Easing.bezier(0.25, 0.1, 0.25, 1);\n  const DUR = 22;\n\n  const progress = (start) => interpolate(frame, [start, start + DUR], [0, 1], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: easeOut\n  });\n\n  const D = [20, 45, 85, 125, 165];\n  const headerP  = progress(D[0]);\n  const group1P  = progress(D[1]);\n  const group2P  = progress(D[2]);\n  const group3P  = progress(D[3]);\n  const group4P  = progress(D[4]);\n\n  const rowContent = (brand, model, c2, c3, c4, c5, c6, p) => {\n    const slideX = interpolate(p, [0, 1], [-60, 0]);\n    return (\n      <div style={{\n        display: 'grid',\n        gridTemplateColumns: '400px 280px 200px 260px 200px 260px',\n        alignItems: 'center',\n        transform: `translateX(${slideX}px)`,\n        opacity: p,\n        height: 160\n      }}>\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>\n          <span style={{ fontFamily: \"'Barlow Condensed', sans-serif\", fontWeight: 700, fontSize: 24, letterSpacing: 2, color: '#e0e7f5', textTransform: 'uppercase' }}>{brand}</span>\n          <span style={{ fontFamily: \"'Inter', sans-serif\", fontWeight: 400, fontSize: 36, color: '#edf4ff', letterSpacing: 0.5 }}>{model}</span>\n        </div>\n        {[c2, c3, c4, c5, c6].map((text, i) => (\n          <div key={i} style={{ fontFamily: \"'Inter', sans-serif\", fontWeight: 400, fontSize: 32, color: '#edf4ff' }}>{text}</div>\n        ))}\n      </div>\n    );\n  };\n\n  const line = (p) => (\n    <div style={{\n      height: 2,\n      backgroundColor: accentLineColor,\n      width: `${p * 100}%`,\n      transformOrigin: 'left'\n    }} />\n  );\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: props.transparentBackground ? 'transparent' : bgColor,\n    overflow: 'hidden',\n    ...maskStyle\n  };\n\n  return (\n    <div style={rootStyle}>\n      <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%' }}>\n        {dots.map(pt => {\n          const wave = Math.sin(frame / 20 + pt.c * 0.15 + pt.r * 0.15);\n          return (\n            <circle\n              key={`${pt.r}-${pt.c}`}\n              cx={pt.c * 32 + 16}\n              cy={pt.r * 32 + 16}\n              r={interpolate(wave, [-1, 1], [0.5, 1.8])}\n              fill={dotColor}\n              opacity={interpolate(wave, [-1, 1], [0.03, 0.2])}\n            />\n          );\n        })}\n      </svg>\n\n      <div style={{ position: 'absolute', top: 220, left: 160, width: 1600 }}>\n        <div style={{\n          display: 'grid',\n          gridTemplateColumns: '400px 280px 200px 260px 200px 260px',\n          alignItems: 'end',\n          paddingBottom: 24,\n          opacity: headerP\n        }}>\n          {[props.h1, props.h2, props.h3, props.h4, props.h5, props.h6].map((txt, i) => (\n            <span key={i} style={{ fontFamily: \"'Barlow Condensed', sans-serif\", fontSize: 20, fontWeight: 600, color: titleColor, letterSpacing: 2, textTransform: 'uppercase' }}>\n              {txt}\n            </span>\n          ))}\n        </div>\n\n        {line(group1P)}\n        {rowContent(props.r1_b, props.r1_m, props.r1_2, props.r1_3, props.r1_4, props.r1_5, props.r1_6, group1P)}\n        {line(group2P)}\n        {rowContent(props.r2_b, props.r2_m, props.r2_2, props.r2_3, props.r2_4, props.r2_5, props.r2_6, group2P)}\n        {line(group3P)}\n        {rowContent(props.r3_b, props.r3_m, props.r3_2, props.r3_3, props.r3_4, props.r3_5, props.r3_6, group3P)}\n        {line(group4P)}\n        {rowContent(props.r4_b, props.r4_m, props.r4_2, props.r4_3, props.r4_4, props.r4_5, props.r4_6, group4P)}\n      </div>\n    </div>\n  );\n};"
 },
 {
