  "thumb": "/thumbnails/b6ed6fcb-f11c-4209-8f45-9217ccb9d03c.jpg",
  "code": "const LifestyleLowerThird = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  // Editable properties\n  const props = item.props || {};\n  const nameText = props.nameText || 'Marco Ferreira';\n  const roleText = props.roleText || 'Street Food Guide';\n  const cardColor = props.cardColor || '#edf4ff';\n  const textColor = props.textColor || '#1f2633';\n  const lineColor = props.lineColor || '#848d9c';\n  const accentColor = props.accentColor || '#2d3340';\n  const yOffset = props.yOffset !== undefined ? props.yOffset : 120;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // ── ADAPTIVE TIMING ──\n  // Use item.durationInFrames (actual timeline clip length) so exit always plays\n  // regardless of where the user trims the clip. Falls back to asset duration.\n  const totalFrames = item?.durationInFrames || Math.round((item?.durationInSeconds || 12) * fps);\n\n  // Exit window: 40 frames ideal, but never more than 35% of total clip length\n  // This ensures even a very short clip still has a visible exit\n  const EXIT_FRAMES = Math.min(40, Math.floor(totalFrames * 0.35));\n  const exitStart = totalFrames - EXIT_FRAMES;\n\n  // Entrance delays scale with clip length too — cap at what fits before exit begins\n  // For very short clips, compress entrance sequence proportionally\n  const entranceWindow = Math.max(1, exitStart - 5); // leave 5 frames of hold before exit\n  const delayScale = Math.min(1, entranceWindow / 50); // 50 frames = full speed reference\n  const nameDelay  = Math.round(12 * delayScale);\n  const lineDelay  = Math.round(22 * delayScale);\n  const roleDelay  = Math.round(30 * delayScale);\n\n  // Overdamped spring config — smooth ease-in, zero bounce\n  const cfg = { damping: 30, stiffness: 85 };\n\n  // ── ENTRANCE (card slides in from left) ──\n  const entranceSpring = spring({ frame, fps, config: cfg });\n  const cardEnterX = interpolate(entranceSpring, [0, 1], [-1600, 0], { extrapolateRight: 'clamp' });\n\n  const nameSpring = spring({ frame: Math.max(0, frame - nameDelay), fps, config: cfg });\n  const lineSpring = spring({ frame: Math.max(0, frame - lineDelay), fps, config: cfg });\n  const roleSpring = spring({ frame: Math.max(0, frame - roleDelay), fps, config: cfg });\n\n  // ── EXIT (original path: card slides back LEFT — mirror of entrance) ──\n  const exitProgress = interpolate(frame, [exitStart, totalFrames], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n    easing: Easing.bezier(0.4, 0, 0.8, 1), // ease-in: starts slow, accelerates out\n  });\n\n  // Card returns to where it came from (left, off-screen)\n  const cardExitX = interpolate(exitProgress, [0, 1], [0, -1600]);\n\n  // Inner elements fade out slightly ahead of card exit (exit feels layered not flat)\n  const innerExitOp = interpolate(exitProgress, [0, 0.6], [1, 0], { extrapolateRight: 'clamp' });\n\n  // Combined card X: entrance moves it in, exit moves it back out left\n  // During entrance: cardExitX is 0 (exitProgress=0), so only cardEnterX drives position\n  // During exit: cardEnterX is already settled at 0, cardExitX takes over\n  const cardX = cardEnterX + cardExitX;\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'flex-end',\n    paddingLeft: '120px',\n    paddingBottom: `${yOffset}px`,\n  };\n\n  const cardStyle = {\n    backgroundColor: cardColor,\n    padding: '35px 60px',\n    borderRadius: '4px',\n    boxShadow: '0 12px 35px rgba(0,1,9,0.12)',\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    minWidth: '850px',\n    maxWidth: '1400px',\n    width: 'fit-content',\n    transform: `translateX(${cardX}px)`,\n    overflow: 'hidden',\n    position: 'relative',\n  };\n\n  const textGroupStyle = {\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    zIndex: 2,\n    flex: 1,\n    position: 'relative',\n    opacity: innerExitOp,\n  };\n\n  const nameStyle = {\n    fontFamily: 'Georgia, serif',\n    fontWeight: 'bold',\n    fontSize: '52px',\n    color: textColor,\n    opacity: interpolate(nameSpring, [0, 1], [0, 1], { extrapolateRight: 'clamp' }),\n    transform: `translateX(${interpolate(nameSpring, [0, 1], [-20, 0], { extrapolateRight: 'clamp' })}px)`,\n    whiteSpace: 'nowrap',\n    letterSpacing: '-0.5px',\n  };\n\n  const lineStyle = {\n    height: '2px',\n    backgroundColor: lineColor,\n    width: '60px',\n    margin: '0 30px',\n    transform: `scaleX(${interpolate(lineSpring, [0, 1], [0, 1], { extrapolateRight: 'clamp' })})`,\n    transformOrigin: 'left',\n    opacity: interpolate(lineSpring, [0, 1], [0, 1], { extrapolateRight: 'clamp' }),\n  };\n\n  const roleStyle = {\n    fontFamily: '\"Helvetica Neue\", Helvetica, Arial, sans-serif',\n    fontSize: '24px',\n    fontWeight: '600',\n    letterSpacing: '1.5px',\n    textTransform: 'uppercase',\n    color: textColor,\n    opacity: interpolate(roleSpring, [0, 1], [0, 1], { extrapolateRight: 'clamp' }),\n    transform: `translateX(${interpolate(roleSpring, [0, 1], [-10, 0], { extrapolateRight: 'clamp' })}px)`,\n    whiteSpace: 'nowrap',\n  };\n\n  const silhouetteStyle = {\n    position: 'absolute',\n    right: '-50px',\n    top: '50%',\n    transform: `translateY(-45%) scale(${interpolate(entranceSpring, [0, 1], [0.8, 1], { extrapolateRight: 'clamp' })})`,\n    opacity: 0.08 * innerExitOp,\n    color: accentColor,\n    pointerEvents: 'none',\n    zIndex: 1,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <div style={textGroupStyle}>\n          <div style={nameStyle}>{nameText}</div>\n          <div style={lineStyle} />\n          <div style={roleStyle}>{roleText}</div>\n        </div>\n        <div style={silhouetteStyle}>\n          <svg width=\"420\" height=\"420\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n            <path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\" />\n          </svg>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
