  "thumb": "/thumbnails/33e13fa9-76d1-4483-94dc-e3f1217c0f1f.jpg",
  "code": "const Showcase = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const props = item.props || {};\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15, mass: 1, stiffness: 100 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  // Properties\n  const transparentBackground = props.transparentBackground;\n  const bgColor = transparentBackground ? 'transparent' : (props.bgColor);\n  const goldColor = props.goldColor;\n  const creamColor = props.creamColor;\n  const fontFamily = props.fontFamily;\n\n  // Animation Springs\n  const bgSpring = safeSpring(0);\n  const borderSpring = safeSpring(10);\n  const s1 = safeSpring(15); // Title\n  const s2 = safeSpring(30); // Chart\n  const s3 = safeSpring(45); // Name tag\n  const s4 = safeSpring(60); // Bullets\n  const s5 = safeSpring(75); // Quote\n  const s6 = safeSpring(90); // Timeline\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: bgColor,\n    fontFamily: fontFamily,\n    overflow: 'hidden',\n  };\n\n  const LineWithDiamond = ({ progress, color, item }) => (\n    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', width: '100%', opacity: progress }}>\n      <div style={{ height: 2, background: color, flex: 1, transform: `scaleX(${progress})`, transformOrigin: 'right' }} />\n      <div style={{ margin: '0 20px', transform: `scale(${progress})` }}>\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\">\n          <path d=\"M10 0 L20 10 L10 20 L0 10 Z\" fill={color} />\n        </svg>\n      </div>\n      <div style={{ height: 2, background: color, flex: 1, transform: `scaleX(${progress})`, transformOrigin: 'left' }} />\n    </div>\n  );\n\n  const CornerDiamond = ({ top, bottom, left, right, color, item }) => {\n    const style = { position: 'absolute', width: 14, height: 14, backgroundColor: color, transform: 'rotate(45deg)' };\n    if (top !== undefined) style.top = top;\n    if (bottom !== undefined) style.bottom = bottom;\n    if (left !== undefined) style.left = left;\n    if (right !== undefined) style.right = right;\n    return <div style={style} />;\n  };\n\n  const ChartRow = ({ label, percentage, color, textColor, progress, item }) => (\n    <div style={{ marginBottom: 35 }}>\n      <div style={{ color: textColor, fontSize: 28, letterSpacing: 2, marginBottom: 15 }}>{label}</div>\n      <div style={{ width: '100%', height: 18, border: `1px solid ${color}`, padding: 3, boxSizing: 'border-box' }}>\n        <div style={{ width: `${progress * percentage}%`, height: '100%', backgroundColor: color }} />\n      </div>\n    </div>\n  );\n\n  const Bullet = ({ text, color, textColor, delayOffset, item }) => {\n    const bSpring = safeSpring(60 + delayOffset);\n    return (\n      <div style={{ display: 'flex', alignItems: 'center', marginBottom: 30, opacity: bSpring, transform: `translateX(${interpolate(bSpring, [0, 1], [-20, 0])})` }}>\n        <div style={{ marginRight: 25 }}>\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">\n            <path d=\"M12 0 L24 12 L12 24 L0 12 Z\" fill={color} />\n          </svg>\n        </div>\n        <div style={{ color: textColor, fontSize: 34, letterSpacing: 1 }}>{text}</div>\n      </div>\n    );\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Pattern */}\n      <div style={{ position: 'absolute', inset: 0, opacity: interpolate(bgSpring, [0, 1], [0, 0.05]) }}>\n        <svg width=\"100%\" height=\"100%\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <pattern id=\"deco-pattern\" x=\"0\" y=\"0\" width=\"120\" height=\"120\" patternUnits=\"userSpaceOnUse\">\n              <circle cx=\"60\" cy=\"60\" r=\"60\" stroke={goldColor} strokeWidth=\"1\" fill=\"none\" />\n              <circle cx=\"120\" cy=\"120\" r=\"60\" stroke={goldColor} strokeWidth=\"1\" fill=\"none\" />\n              <circle cx=\"0\" cy=\"120\" r=\"60\" stroke={goldColor} strokeWidth=\"1\" fill=\"none\" />\n              <circle cx=\"120\" cy=\"0\" r=\"60\" stroke={goldColor} strokeWidth=\"1\" fill=\"none\" />\n              <circle cx=\"0\" cy=\"0\" r=\"60\" stroke={goldColor} strokeWidth=\"1\" fill=\"none\" />\n            </pattern>\n          </defs>\n          <rect x=\"0\" y=\"0\" width=\"100%\" height=\"100%\" fill=\"url(#deco-pattern)\" />\n        </svg>\n      </div>\n\n      {/* Main Double Border */}\n      <div style={{ position: 'absolute', inset: 30, border: `2px solid ${goldColor}`, opacity: borderSpring, pointerEvents: 'none' }} />\n      <div style={{ position: 'absolute', inset: 42, border: `1px solid ${goldColor}`, opacity: borderSpring, pointerEvents: 'none' }} />\n      {/* Border Corner Accents */}\n      <div style={{ position: 'absolute', top: 30, left: 30, width: 20, height: 20, borderBottom: `2px solid ${goldColor}`, borderRight: `2px solid ${goldColor}`, opacity: borderSpring }} />\n      <div style={{ position: 'absolute', top: 30, right: 30, width: 20, height: 20, borderBottom: `2px solid ${goldColor}`, borderLeft: `2px solid ${goldColor}`, opacity: borderSpring }} />\n      <div style={{ position: 'absolute', bottom: 30, left: 30, width: 20, height: 20, borderTop: `2px solid ${goldColor}`, borderRight: `2px solid ${goldColor}`, opacity: borderSpring }} />\n      <div style={{ position: 'absolute', bottom: 30, right: 30, width: 20, height: 20, borderTop: `2px solid ${goldColor}`, borderLeft: `2px solid ${goldColor}`, opacity: borderSpring }} />\n\n      {/* Section 1: Title */}\n      <div style={{ position: 'absolute', top: 120, left: 120, width: 750, textAlign: 'center' }}>\n        <div style={{ color: creamColor, fontSize: 32, letterSpacing: 8, opacity: s1, transform: `translateY(${interpolate(s1, [0, 1], [20, 0])})` }}>\n          {props.chapterSubtitle}\n        </div>\n        <div style={{ margin: '25px 0' }}>\n          <LineWithDiamond progress={s1} color={goldColor} />\n        </div>\n        <div style={{ color: goldColor, fontSize: 85, fontWeight: 'bold', letterSpacing: 4, transform: `scale(${interpolate(s1, [0, 1], [0.95, 1])})`, opacity: s1, lineHeight: 1.1 }}>\n          {props.chapterTitle}\n        </div>\n        <div style={{ margin: '25px 0' }}>\n          <LineWithDiamond progress={s1} color={goldColor} />\n        </div>\n      </div>\n\n      {/* Section 3: Name Tag */}\n      <div style={{ position: 'absolute', top: 480, left: 145, width: 700, padding: 45, border: `2px solid ${goldColor}`, textAlign: 'center', opacity: s3, transform: `scale(${interpolate(s3, [0, 1], [0.95, 1])})`, boxSizing: 'border-box' }}>\n        <div style={{ position: 'absolute', inset: 8, border: `1px solid ${goldColor}` }} />\n        <CornerDiamond top={-7} left={-7} color={goldColor} />\n        <CornerDiamond top={-7} right={-7} color={goldColor} />\n        <CornerDiamond bottom={-7} left={-7} color={goldColor} />\n        <CornerDiamond bottom={-7} right={-7} color={goldColor} />\n        <div style={{ color: goldColor, fontSize: 50, letterSpacing: 10, fontWeight: 'bold' }}>{props.nameText}</div>\n        <div style={{ color: creamColor, fontSize: 26, letterSpacing: 6, marginTop: 15, fontStyle: 'italic' }}>{props.roleText}</div>\n      </div>\n\n      {/* Section 5: Highlight Quote */}\n      <div style={{ position: 'absolute', top: 780, left: 120, width: 750, textAlign: 'center', opacity: s5, transform: `translateY(${interpolate(s5, [0, 1], [20, 0])})` }}>\n        <div style={{ color: goldColor, fontSize: 100, position: 'absolute', left: 40, top: -50, opacity: 0.2, fontFamily: 'serif' }}>\"</div>\n        <div style={{ color: creamColor, fontSize: 40, fontStyle: 'italic', lineHeight: 1.5, letterSpacing: 1, padding: '0 40px' }}>\n          {props.quoteText}\n        </div>\n        <div style={{ color: goldColor, fontSize: 100, position: 'absolute', right: 40, bottom: -90, opacity: 0.2, fontFamily: 'serif' }}>\"</div>\n      </div>\n\n      {/* Section 2: Chart */}\n      {frame >= 30 && (\n      <div style={{ position: 'absolute', top: 140, left: 1050, width: 700 }}>\n        <ChartRow label={props.chartLabel1} percentage={82} color={goldColor} textColor={creamColor} progress={s2} />\n        <ChartRow label={props.chartLabel2} percentage={90} color={goldColor} textColor={creamColor} progress={s2} />\n        <ChartRow label={props.chartLabel3} percentage={78} color={goldColor} textColor={creamColor} progress={s2} />\n      </div>\n      )}\n\n      {/* Section 4: Bullets */}\n      <div style={{ position: 'absolute', top: 480, left: 1050, width: 700 }}>\n        <Bullet text={props.bullet1} color={goldColor} textColor={creamColor} delayOffset={0} />\n        <Bullet text={props.bullet2} color={goldColor} textColor={creamColor} delayOffset={5} />\n        <Bullet text={props.bullet3} color={goldColor} textColor={creamColor} delayOffset={10} />\n      </div>\n\n      {/* Section 6: Timeline */}\n      <div style={{ position: 'absolute', top: 820, left: 1050, width: 700, opacity: s6 }}>\n        <div style={{ width: '100%', height: 2, background: goldColor, marginTop: 40, transform: `scaleX(${s6})`, transformOrigin: 'left' }} />\n        <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: -11 }}>\n          {[props.time1, props.time2, props.time3, props.time4].map((y, i) => (\n            <div key={i} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', width: 80, transform: `translateY(${interpolate(s6, [0, 1], [15, 0])})`, opacity: s6 }}>\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\">\n                <path d=\"M12 0 L24 12 L12 24 L0 12 Z\" fill={goldColor}/>\n              </svg>\n              <div style={{ color: creamColor, marginTop: 25, fontSize: 28, letterSpacing: 3 }}>{y}</div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n    </div>\n  );\n};"
 },
