  "thumb": "/thumbnails/ca1b1b60-d036-4dfb-a02c-1b511a45a27f.jpg",
  "code": "const TechTrendsAnchor = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n\n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const textColor = props.textColor;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const accentColor = props.accentColor;\n\n  const parseHex = (hex) => {\n    if (!hex) return [0,0,0];\n    const h = hex.replace('#','');\n    return [parseInt(h.substring(0,2),16)||0, parseInt(h.substring(2,4),16)||0, parseInt(h.substring(4,6),16)||0];\n  };\n  const rgba = (hex, a) => { const [r,g,b] = parseHex(hex); return `rgba(${r},${g},${b},${a})`; };\n\n  const smoothSettle = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,3.5);\n  const bellCurveLate = (t) => t<=0?0:t>=1?1:t<0.4?0.15*Math.pow(t/0.4,2.5):0.15+0.85*(1-Math.pow(1-(t-0.4)/0.6,2.8));\n  const lineDraw = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,2.8);\n\n  const total = durationInFrames || 150;\n  const exitRaw = Math.max(0, Math.min(1, (frame-(total-25))/25));\n  const ex = 1 - exitRaw*exitRaw;\n\n  const anim = (delay, dur) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/dur)));\n  const fadeIn = (delay) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/15)));\n\n  // Blobs\n  const blobA = anim(0,40)*ex;\n  const blobScale = 1.05-0.05*anim(0,45);\n  const dX = Math.sin(frame/55)*7;\n  const dY = Math.cos(frame/70)*5;\n\n  // Big number (delay 5)\n  const numA = fadeIn(5)*ex;\n  const numScale = 0.9 + 0.1*anim(5,45);\n\n  // Title (delay 12)\n  const ttA = fadeIn(12)*ex;\n\n  // Subtitle (delay 22)\n  const stA = fadeIn(22)*ex;\n  const stY = (1-anim(22,35))*25;\n\n  // Body (delay 28)\n  const bdA = fadeIn(28)*ex;\n  const bdY = (1-anim(28,35))*25;\n\n  // Bar chart (delay 18)\n  const bars = [{l:'AI/ML',v:38},{l:'Quantum',v:22},{l:'Cloud',v:20},{l:'Biotech',v:20}];\n  const maxV = 38;\n\n  // Timeline (delay 15)\n  const tlW = lineDraw(Math.min(1,Math.max(0,(frame-15)/50)))*600;\n  const tlA = fadeIn(15)*ex;\n  const nd = [0,1,2,3].map(i => ({ a: fadeIn(25+i*5)*ex, y: (1-anim(25+i*5,30))*15 }));\n\n  // Name tag (delay 32)\n  const nmA = fadeIn(32)*ex;\n\n  // Team blobs (delay 35)\n  const tmA = [0,1,2].map(i => fadeIn(35+i*6)*ex);\n\n  return (\n    <div style={{position:'absolute',inset:0,backgroundColor:bgColor,overflow:'hidden',fontFamily:bodyFont}}>\n      {/* Gradient blobs */}\n      <div style={{position:'absolute',top:'-10%',right:'-8%',width:1200,height:1200,\n        background:`radial-gradient(circle,${rgba(blobColor1,blobA*0.45)} 0%,transparent 60%)`,\n        transform:`translate(${dX}px,${dY}px) scale(${blobScale})`,transformOrigin:'center'}}/>\n      <div style={{position:'absolute',bottom:'-15%',left:'-5%',width:1000,height:1000,\n        background:`radial-gradient(circle,${rgba(blobColor2,blobA*0.35)} 0%,transparent 60%)`,\n        transform:`translate(${-dX}px,${-dY}px) scale(${blobScale})`,transformOrigin:'center'}}/>\n\n      {/* Big year number (top left) */}\n      <div style={{position:'absolute',left:140,top:80}}>\n        <div style={{fontFamily:titleFont,fontSize:160,fontWeight:300,color:rgba(textColor,numA*0.15),lineHeight:1,transform:`scale(${numScale})`,transformOrigin:'left top'}}>\n          2026\n        </div>\n      </div>\n\n      {/* Title */}\n      <div style={{position:'absolute',left:140,top:200}}>\n        <div style={{fontFamily:bodyFont,fontSize:48,fontWeight:700,color:rgba(textColor,ttA),letterSpacing:'-0.01em'}}>\n          TECH TRENDS\n        </div>\n      </div>\n\n      {/* Subtitle */}\n      <div style={{position:'absolute',left:140,top:280,transform:`translateY(${stY}px)`}}>\n        <div style={{fontSize:26,color:rgba(textColor,stA*0.6),lineHeight:1.4,whiteSpace:'pre-wrap'}}>\n          Here is where your{'\\n'}presentation begins\n        </div>\n      </div>\n\n      {/* Body */}\n      <div style={{position:'absolute',left:140,top:420,width:550,transform:`translateY(${bdY}px)`}}>\n        <div style={{fontSize:26,color:rgba(textColor,bdA*0.8),lineHeight:1.5}}>\n          Technology is reshaping every industry through AI and quantum computing.\n        </div>\n      </div>\n\n      {/* Horizontal bar chart (right) */}\n      <div style={{position:'absolute',right:120,top:200,width:500}}>\n        {bars.map((b,i) => {\n          const bRaw = Math.min(1,Math.max(0,(frame-(18+i*8))/50));\n          const bP = bellCurveLate(bRaw);\n          const bA = fadeIn(18+i*8)*ex;\n          const w = (b.v/maxV)*350;\n          return (\n            <div key={i} style={{display:'flex',alignItems:'center',marginBottom:20,height:36}}>\n              <div style={{width:100,fontSize:16,color:rgba(textColor,bA*0.7),textAlign:'right',paddingRight:16}}>{b.l}</div>\n              <div style={{height:'100%',width:w*bP,background:`linear-gradient(90deg,${rgba(blobColor1,bA)},${rgba(blobColor2,bA)})`,borderRadius:4}}/>\n              <div style={{fontSize:18,fontWeight:600,color:rgba(textColor,bA),marginLeft:12}}>{b.v}%</div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Timeline (bottom) */}\n      <div style={{position:'absolute',left:140,bottom:140,width:650,height:70}}>\n        <div style={{position:'absolute',left:0,top:10,width:tlW,height:2,backgroundColor:rgba(textColor,tlA*0.2)}}/>\n        {['2023','2024','2025','2026'].map((yr,i) => (\n          <div key={i} style={{position:'absolute',left:i*180,top:0,transform:`translateY(${nd[i].y}px)`}}>\n            <div style={{width:7,height:7,borderRadius:'50%',backgroundColor:rgba(accentColor,nd[i].a)}}/>\n            <div style={{fontFamily:titleFont,fontSize:20,color:rgba(textColor,nd[i].a),marginTop:12}}>{yr}</div>\n          </div>\n        ))}\n      </div>\n\n      {/* Name tag */}\n      <div style={{position:'absolute',left:140,bottom:80}}>\n        <div style={{fontSize:20,fontWeight:500,color:rgba(textColor,nmA),borderLeft:`3px solid ${rgba(accentColor,nmA)}`,paddingLeft:12}}>\n          Dr. Aisha Patel — AI Research\n        </div>\n      </div>\n\n      {/* Team member blobs (right bottom) */}\n      <div style={{position:'absolute',right:120,bottom:120,display:'flex',gap:24}}>\n        {[blobColor1,blobColor2,accentColor].map((c,i) => (\n          <div key={i} style={{width:60,height:60,borderRadius:'50%',backgroundColor:rgba(c,tmA[i]*0.12),border:`2px solid ${rgba(c,tmA[i]*0.5)}`}}/>\n        ))}\n      </div>\n    </div>\n  );\n};"
 },
