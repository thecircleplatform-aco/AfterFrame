  "thumb": "/thumbnails/d8ed2e4b-8b7e-4b4d-8942-7ac0c4b7800a.jpg",
  "code": "const CreativePortfolio = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n  \n  const backgroundColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const titleFont = props.titleFont;\n  const labelFont = props.labelFont;\n  const titleColor = props.titleColor;\n  const labelColor = props.labelColor;\n  \n  const v1 = props.seg1Val;\n  const v2 = props.seg2Val;\n  const v3 = props.seg3Val;\n  const v4 = props.seg4Val;\n  const total = v1 + v2 + v3 + v4;\n  \n  const p1 = (v1 / total) * 360;\n  const p2 = (v2 / total) * 360;\n  const p3 = (v3 / total) * 360;\n  const p4 = (v4 / total) * 360;\n  \n  const start1 = -90;\n  const start2 = start1 + p1;\n  const start3 = start2 + p2;\n  const start4 = start3 + p3;\n  \n  const safeSpring = (delay) => spring({\n    frame: Math.max(0, frame - delay),\n    fps: fps || 30,\n    config: { damping: 18, stiffness: 90 }\n  });\n  \n  const titleOpacity = safeSpring(0);\n  const p1Anim = safeSpring(24);\n  const p2Anim = safeSpring(48);\n  const p3Anim = safeSpring(72);\n  const p4Anim = safeSpring(96);\n  const bgAnim = safeSpring(10);\n  \n  const washOffset = interpolate(frame, [0, 180], [0, 20]);\n\n  const polarToCartesian = (cx, cy, radius, angleInDegrees) => {\n    const angleInRadians = (angleInDegrees * Math.PI) / 180.0;\n    return {\n      x: cx + radius * Math.cos(angleInRadians),\n      y: cy + radius * Math.sin(angleInRadians)\n    };\n  };\n\n  const getArcPath = (cx, cy, radius, startAngle, endAngle) => {\n    if (endAngle - startAngle < 0.01) endAngle = startAngle + 0.01;\n    const start = polarToCartesian(cx, cy, radius, startAngle);\n    const end = polarToCartesian(cx, cy, radius, endAngle);\n    const largeArcFlag = endAngle - startAngle <= 180 ? \"0\" : \"1\";\n    return [\n      \"M\", start.x, start.y,\n      \"A\", radius, radius, 0, largeArcFlag, 1, end.x, end.y\n    ].join(\" \");\n  };\n\n  const hexToRgba = (colorStr, alpha) => {\n    if (!colorStr || typeof colorStr !== 'string') return `rgba(0,0,0,${alpha})`;\n    if (!colorStr.startsWith('#')) return colorStr;\n    const hex = colorStr.replace('#', '');\n    const r = parseInt(hex.length === 3 ? hex.slice(0, 1).repeat(2) : hex.slice(0, 2), 16);\n    const g = parseInt(hex.length === 3 ? hex.slice(1, 2).repeat(2) : hex.slice(2, 4), 16);\n    const b = parseInt(hex.length === 3 ? hex.slice(2, 3).repeat(2) : hex.slice(4, 6), 16);\n    return `rgba(${isNaN(r) ? 0 : r}, ${isNaN(g) ? 0 : g}, ${isNaN(b) ? 0 : b}, ${alpha})`;\n  };\n\n  const renderPieSegment = (cx, cy, radius, strokeWidth, color, startAngle, endAngle, progress, label, val) => {\n    const currentEndAngle = interpolate(progress, [0, 1], [startAngle, endAngle]);\n    const isVisible = progress > 0.01;\n    const midAngle = (startAngle + endAngle) / 2;\n    const lineStart = polarToCartesian(cx, cy, radius + strokeWidth / 2 + 10, midAngle);\n    const lineMid = polarToCartesian(cx, cy, radius + strokeWidth / 2 + 50, midAngle);\n    const isLeft = midAngle > 90 && midAngle < 270;\n    const lineEnd = { x: lineMid.x + (isLeft ? -50 : 50), y: lineMid.y };\n    \n    const textBaseAlpha = Math.max(0, interpolate(progress, [0.8, 1], [0, 1]));\n    const lineStroke = hexToRgba(labelColor, textBaseAlpha * 0.4);\n    const textMainFill = hexToRgba(labelColor, textBaseAlpha);\n    const textSubFill = hexToRgba(labelColor, textBaseAlpha * 0.7);\n\n    return (\n      <g key={label}>\n        {isVisible && (\n          <path\n            d={getArcPath(cx, cy, radius, startAngle, currentEndAngle)}\n            fill=\"none\"\n            stroke={color}\n            strokeWidth={strokeWidth}\n          />\n        )}\n        {progress > 0.8 && (\n          <g>\n            <path \n              d={`M ${lineStart.x} ${lineStart.y} L ${lineMid.x} ${lineMid.y} L ${lineEnd.x} ${lineEnd.y}`}\n              fill=\"none\"\n              stroke={lineStroke}\n              strokeWidth=\"2\"\n            />\n            <text\n              x={lineEnd.x + (isLeft ? -15 : 15)}\n              y={lineEnd.y + 5}\n              fontFamily={labelFont}\n              fontSize=\"24\"\n              fill={textMainFill}\n              textAnchor={isLeft ? \"end\" : \"start\"}\n              fontWeight=\"500\"\n              letterSpacing=\"1px\"\n            >\n              {label.toUpperCase()}\n            </text>\n            <text\n              x={lineEnd.x + (isLeft ? -15 : 15)}\n              y={lineEnd.y + 30}\n              fontFamily={labelFont}\n              fontSize=\"18\"\n              fill={textSubFill}\n              textAnchor={isLeft ? \"end\" : \"start\"}\n            >\n              {val}%\n            </text>\n          </g>\n        )}\n      </g>\n    );\n  };\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden',\n    display: 'flex'\n  };\n\n  const bgOpacity = interpolate(bgAnim, [0, 1], [0, 0.7]);\n  const dividerOpacity = interpolate(titleOpacity, [0, 1], [0, 0.2]);\n  const dividerScale = titleOpacity;\n  const titleTranslateY = interpolate(titleOpacity, [0, 1], [40, 0]);\n  const centerDecorAlpha = interpolate(titleOpacity, [0, 1], [0, 0.3]);\n\n  return (\n    <div style={rootStyle}>\n      {/* Watercolor Background Washes */}\n      <div style={{ position: 'absolute', inset: 0, opacity: bgOpacity }}>\n        <svg style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', zIndex: 0 }}>\n          <defs>\n            <filter id=\"watercolorBlur\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"100\" />\n            </filter>\n          </defs>\n          <g filter=\"url(#watercolorBlur)\">\n            <circle cx={400 - washOffset} cy={200 + washOffset} r=\"400\" fill={hexToRgba(props.seg1Color, 0.6)} />\n            <circle cx={1600 + washOffset} cy={900 - washOffset} r=\"500\" fill={hexToRgba(props.seg3Color, 0.4)} />\n            <circle cx={800} cy={1000} r=\"450\" fill={hexToRgba(props.seg2Color, 0.5)} />\n            <circle cx={1400} cy={100} r=\"350\" fill={hexToRgba(props.seg4Color, 0.4)} />\n          </g>\n        </svg>\n      </div>\n      \n      {/* Vertical divider line */}\n      <div style={{\n        position: 'absolute',\n        left: '50%',\n        top: '15%',\n        bottom: '15%',\n        width: '1px',\n        backgroundColor: labelColor,\n        opacity: dividerOpacity,\n        transform: `scaleY(${dividerScale})`,\n        transformOrigin: 'top'\n      }} />\n\n      {/* Typography */}\n      <div style={{\n        position: 'absolute',\n        left: 200,\n        top: 360,\n        width: 700,\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 60,\n        zIndex: 10,\n        opacity: titleOpacity,\n        transform: `translateY(${titleTranslateY}px)`\n      }}>\n        <h1 style={{\n          fontFamily: titleFont,\n          fontSize: 88,\n          lineHeight: 1.1,\n          color: titleColor,\n          margin: 0,\n          fontWeight: 400,\n          whiteSpace: 'pre-wrap'\n        }}>\n          {titleText}\n        </h1>\n        <p style={{\n          fontFamily: labelFont,\n          fontSize: 16,\n          color: labelColor,\n          margin: 0,\n          fontWeight: 400,\n          opacity: 0.8,\n          whiteSpace: 'pre-wrap',\n          lineHeight: 1.5\n        }}>\n          {subtitleText}\n        </p>\n      </div>\n\n      {/* Pie Chart */}\n      <svg style={{ position: 'absolute', right: 50, top: 140, width: 900, height: 800, zIndex: 10 }}>\n        <g transform=\"translate(450, 400)\">\n          {renderPieSegment(0, 0, 180, 120, props.seg1Color, start1, start2, p1Anim, props.seg1Label, v1)}\n          {renderPieSegment(0, 0, 180, 120, props.seg2Color, start2, start3, p2Anim, props.seg2Label, v2)}\n          {renderPieSegment(0, 0, 180, 120, props.seg3Color, start3, start4, p3Anim, props.seg3Label, v3)}\n          {renderPieSegment(0, 0, 180, 120, props.seg4Color, start4, start1 + 360, p4Anim, props.seg4Label, v4)}\n          \n          {/* Center Decor */}\n          <circle cx={0} cy={0} r={5} fill={hexToRgba(labelColor, centerDecorAlpha)} />\n        </g>\n      </svg>\n    </div>\n  );\n};"
 },
