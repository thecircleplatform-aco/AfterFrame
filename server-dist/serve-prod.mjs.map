  "thumb": "/thumbnails/5e58a6dd-e2f0-49bd-8377-9dd352bd2aac.jpg",
  "code": "const BarChartMG = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const yAxisMax = props.yAxisMax;\n  const womenValue = props.womenValue;\n  const menValue = props.menValue;\n  const womenColor = props.womenColor;\n  const menColor = props.menColor;\n  const bgColor = props.bgColor;\n  const noiseIntensity = props.noiseIntensity;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    fontFamily: 'Roboto, sans-serif',\n    color: '#1a1a1a',\n    overflow: 'hidden'\n  };\n\n  const chartBottom = 930;\n  const chartLeft = 250;\n  const chartHeight = 550;\n  const baselineValue = 16;\n  const activeYMax = Math.max(20, yAxisMax);\n  const valueRange = activeYMax - baselineValue;\n\n  const ticks = [];\n  for (let i = 18; i <= activeYMax; i += 2) {\n    ticks.push(i);\n  }\n\n  const contentOpacity = interpolate(frame, [0, 15], [0, 1], {extrapolateRight: 'clamp'});\n  const springW = spring({ frame: Math.max(0, frame - 15), fps: safeFps, config: { damping: 17, stiffness: 120 } });\n  const springM = spring({ frame: Math.max(0, frame - 25), fps: safeFps, config: { damping: 17, stiffness: 120 } });\n\n  return (\n    <div style={rootStyle}>\n      <svg width=\"100%\" height=\"100%\" style={{ position: 'absolute', top: 0, left: 0, pointerEvents: 'none', mixBlendMode: 'multiply', opacity: noiseIntensity }}>\n        <filter id=\"noiseFilter\">\n          <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"3\" stitchTiles=\"stitch\" />\n          <feColorMatrix type=\"saturate\" values=\"0\" />\n        </filter>\n        <rect width=\"100%\" height=\"100%\" filter=\"url(#noiseFilter)\" />\n      </svg>\n      <div style={{\n        position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n        background: 'radial-gradient(circle, rgba(0,0,0,0) 50%, rgba(0,0,0,0.05) 100%)',\n        pointerEvents: 'none'\n      }} />\n\n      <div style={{ opacity: contentOpacity, width: '100%', height: '100%', position: 'absolute', top: 0, left: 0 }}>\n        <div style={{ position: 'absolute', left: 160, top: 120, fontSize: 64, fontWeight: 800, letterSpacing: '-1px' }}>\n          {titleText}\n        </div>\n        <div style={{ position: 'absolute', left: 160, top: 200, fontSize: 40, fontWeight: 400, fontStyle: 'italic', color: '#444' }}>\n          {subtitleText}\n        </div>\n\n        <div style={{ position: 'absolute', left: 1250, top: 310, display: 'flex', alignItems: 'center', gap: 12 }}>\n          <div style={{ width: 32, height: 32, backgroundColor: womenColor }} />\n          <div style={{ fontSize: 28, color: '#333' }}>Buyers</div>\n        </div>\n        <div style={{ position: 'absolute', left: 1450, top: 310, display: 'flex', alignItems: 'center', gap: 12 }}>\n          <div style={{ width: 32, height: 32, backgroundColor: menColor }} />\n          <div style={{ fontSize: 28, color: '#333' }}>Renters</div>\n        </div>\n\n        <div style={{ position: 'absolute', left: 160, top: 310, fontSize: 28, color: '#333' }}>\n          Age (years)\n        </div>\n\n        <div style={{ position: 'absolute', left: chartLeft, top: 380, width: 2, height: chartHeight, backgroundColor: '#1a1a1a' }} />\n        <div style={{ position: 'absolute', left: chartLeft, top: chartBottom, width: 1400, height: 2, backgroundColor: '#1a1a1a' }} />\n\n        {ticks.map(val => {\n          const yPos = chartBottom - ((val - baselineValue) / valueRange) * chartHeight;\n          return (\n            <div key={val} style={{\n              position: 'absolute',\n              left: chartLeft - 80,\n              top: yPos - 17,\n              width: 60,\n              textAlign: 'right',\n              fontSize: 28,\n              color: '#333'\n            }}>\n              {val}\n            </div>\n          );\n        })}\n\n        <div style={{\n          position: 'absolute',\n          left: 950 - 100,\n          top: chartBottom + 24,\n          width: 200,\n          textAlign: 'center',\n          fontSize: 32,\n          color: '#333'\n        }}>\n          1960\n        </div>\n\n        <div style={{\n          position: 'absolute',\n          left: 680,\n          bottom: DESIGN_HEIGHT - chartBottom,\n          width: 250,\n          height: Math.max(0, ((womenValue - baselineValue) / valueRange) * chartHeight),\n          backgroundColor: womenColor,\n          transformOrigin: 'bottom',\n          transform: `scaleY(${springW})`\n        }} />\n        <div style={{\n          position: 'absolute',\n          left: 970,\n          bottom: DESIGN_HEIGHT - chartBottom,\n          width: 250,\n          height: Math.max(0, ((menValue - baselineValue) / valueRange) * chartHeight),\n          backgroundColor: menColor,\n          transformOrigin: 'bottom',\n          transform: `scaleY(${springM})`\n        }} />\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "9c22e1ef-0735-46a9-9e63-c4f276aa6592",
  "name": "MindSpace — Chapter Five: Growth",
  "category": "uncategorized",
  "description": "A WebGL-powered chapter title card featuring animated glowing fluid backgrounds, large glass-styled numerals, and smooth spring-revealing typographic elements.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "chapterLabel": "Chapter Five",
