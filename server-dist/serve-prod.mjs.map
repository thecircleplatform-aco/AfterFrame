  "thumb": "/thumbnails/79b030e8-cd48-4065-8beb-4cd3644ab9fe.jpg",
  "code": "const CoralBulletOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const props = item.props || {};\n\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const text1 = props.text1;\n  const text2 = props.text2;\n  const text3 = props.text3;\n  const text4 = props.text4;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const CARD_W = 735;\n  const CARD_H = 160;\n  const VID_LEFT = 1350;\n  const VID_TOP = 172;\n  const VID_W = 514;\n  const VID_H = 715;\n  const VID_RX = 26;\n\n  const ENTER_DUR = 14;\n  const SLIDE_DIST = 50;\n  const TEXT_DELAY = 6;\n  const EXIT_START = 155;\n  const EXIT_DUR = 14;\n  const cardEnterFrames = [20, 45, 70, 95];\n\n  const easeOutCubic = t => 1 - Math.pow(1 - t, 3);\n  const easeInCubic  = t => Math.pow(t, 3);\n\n  const getCardAnim = (enterFrame) => {\n    if (frame < enterFrame) return { opacity: 0, tx: -SLIDE_DIST, show: false };\n    if (frame < enterFrame + ENTER_DUR) {\n      const t = easeOutCubic((frame - enterFrame) / ENTER_DUR);\n      return { opacity: t, tx: (1 - t) * -SLIDE_DIST, show: true };\n    }\n    if (frame < EXIT_START) return { opacity: 1, tx: 0, show: true };\n    if (frame < EXIT_START + EXIT_DUR) {\n      const t = easeInCubic((frame - EXIT_START) / EXIT_DUR);\n      return { opacity: 1 - t, tx: t * -SLIDE_DIST, show: true };\n    }\n    return { opacity: 0, tx: -SLIDE_DIST, show: false };\n  };\n\n  const getTextAnim = (enterFrame) => {\n    const tIn = enterFrame + TEXT_DELAY;\n    if (frame < tIn) return { opacity: 0, tx: -SLIDE_DIST * 0.5 };\n    if (frame < tIn + ENTER_DUR) {\n      const t = easeOutCubic((frame - tIn) / ENTER_DUR);\n      return { opacity: t, tx: (1 - t) * -SLIDE_DIST * 0.5 };\n    }\n    if (frame < EXIT_START) return { opacity: 1, tx: 0 };\n    if (frame < EXIT_START + EXIT_DUR) {\n      const t = easeInCubic((frame - EXIT_START) / EXIT_DUR);\n      return { opacity: 1 - t, tx: t * -SLIDE_DIST * 0.5 };\n    }\n    return { opacity: 0, tx: -SLIDE_DIST * 0.5 };\n  };\n\n  // Coral: cream icon circle, deep brown stroke — warm & cohesive\n  const S = '#5a2747';\n  const icons = [\n    // House — Americans move a lot, avg 11 times in a lifetime\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={S} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z\"/>\n      <polyline points=\"9 21 9 12 15 12 15 21\"/>\n    </svg>,\n    // Coffee cup — US is top coffee consumer per capita\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={S} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M17 8h1a4 4 0 0 1 0 8h-1\"/>\n      <path d=\"M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z\"/>\n      <line x1=\"6\" y1=\"1\" x2=\"6\" y2=\"4\"/>\n      <line x1=\"10\" y1=\"1\" x2=\"10\" y2=\"4\"/>\n      <line x1=\"14\" y1=\"1\" x2=\"14\" y2=\"4\"/>\n    </svg>,\n    // Sun — most American vacations are road trips\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={S} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"4\"/>\n      <line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"4\"/>\n      <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"22\"/>\n      <line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\"/>\n      <line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\"/>\n      <line x1=\"2\" y1=\"12\" x2=\"4\" y2=\"12\"/>\n      <line x1=\"20\" y1=\"12\" x2=\"22\" y2=\"12\"/>\n      <line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\"/>\n      <line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\"/>\n    </svg>,\n    // Book — public libraries offer free books & Wi-Fi\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={S} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/>\n      <path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/>\n    </svg>,\n  ];\n\n  const cards = [\n    { text: text1, icon: icons[0], x: 99,  cy: 179, enterFrame: cardEnterFrames[0] },\n    { text: text2, icon: icons[1], x: 402, cy: 417, enterFrame: cardEnterFrames[1] },\n    { text: text3, icon: icons[2], x: 99,  cy: 662, enterFrame: cardEnterFrames[2] },\n    { text: text4, icon: icons[3], x: 402, cy: 907, enterFrame: cardEnterFrames[3] },\n  ];\n\n  // Card colors: coral fill, cream icon circle\n  const CARD_BG = '#c974cd';\n  const ICON_BG = '#FAF3E8';\n  const TEXT_COLOR = '#FAF3E8';\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      fontFamily: fontFamily,\n      overflow: 'hidden',\n    }}>\n      {/* SVG mask background — punches transparent hole for video */}\n      {!transparentBackground && (\n        <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={{ position: 'absolute', top: 0, left: 0 }}>\n          <defs>\n            <mask id=\"coralMask\">\n              <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} fill=\"white\" />\n              <rect x={VID_LEFT} y={VID_TOP} width={VID_W} height={VID_H} rx={VID_RX} ry={VID_RX} fill=\"black\" />\n            </mask>\n          </defs>\n          <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} fill={bgColor} mask=\"url(#coralMask)\" />\n        </svg>\n      )}\n\n      {/* Video window border: coral stroke */}\n      <div style={{\n        position: 'absolute',\n        left: VID_LEFT, top: VID_TOP, width: VID_W, height: VID_H,\n        borderRadius: VID_RX,\n        backgroundColor: 'transparent',\n        border: '4px solid #c974cd',\n        boxShadow: '0 12px 40px rgba(201,116,205,0.25), 0 4px 16px rgba(0,0,0,0.10)',\n        boxSizing: 'border-box',\n      }} />\n\n      {/* Bullet cards */}\n      {cards.map((card, i) => {\n        const anim = getCardAnim(card.enterFrame);\n        if (!anim.show) return null;\n        const textAnim = getTextAnim(card.enterFrame);\n        return (\n          <div key={i} style={{\n            position: 'absolute',\n            left: card.x,\n            top: card.cy - CARD_H / 2,\n            width: CARD_W,\n            height: CARD_H,\n            backgroundColor: CARD_BG,\n            borderRadius: 18,\n            display: 'flex',\n            alignItems: 'center',\n            paddingLeft: 16,\n            boxSizing: 'border-box',\n            opacity: anim.opacity,\n            transform: `translateX(${anim.tx}px)`,\n          }}>\n            <div style={{\n              width: 90, height: 90,\n              backgroundColor: ICON_BG,\n              borderRadius: '50%',\n              display: 'flex',\n              justifyContent: 'center',\n              alignItems: 'center',\n              flexShrink: 0,\n            }}>\n              {card.icon}\n            </div>\n            <div style={{\n              marginLeft: 26,\n              fontSize: 38,\n              fontWeight: '700',\n              color: TEXT_COLOR,\n              letterSpacing: '-0.4px',\n              whiteSpace: 'nowrap',\n              opacity: textAnim.opacity,\n              transform: `translateX(${textAnim.tx}px)`,\n            }}>\n              {card.text}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
 },
