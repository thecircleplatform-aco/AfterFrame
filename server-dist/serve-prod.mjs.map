  "thumb": "/thumbnails/9d11fc67-dc78-4d78-b797-f0d76c816858.jpg",
  "code": "const SavingsCalculator = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n\n  const titleText    = props.titleText;\n  const card1Amount  = props.card1Amount;\n  const card1Label   = props.card1Label;\n  const card2Amount  = props.card2Amount;\n  const card2Label   = props.card2Label;\n  const card3Amount  = props.card3Amount;\n  const card3Label   = props.card3Label;\n  const primaryColor = props.primaryColor;\n  const bgColor      = props.bgColor;\n  const cardBgColor  = props.cardBgColor;\n  const fontFamily   = props.fontFamily;\n\n  const DESIGN_WIDTH  = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width  || DESIGN_WIDTH)  / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const MARGIN  = 50;\n  const PANEL_X = MARGIN;\n  const PANEL_Y = MARGIN;\n  const PANEL_W = 1380;\n  const PANEL_H = DESIGN_HEIGHT - MARGIN * 2;\n\n  const TH_W = 380;\n  const TH_H = 500;\n  const TH_X = 1490;\n  const TH_Y = (DESIGN_HEIGHT - TH_H) / 2;\n  const TH_R = 28;\n\n  // ── Easing helpers ───────────────────────────────────────────────\n  const easeOut = (t) => 1 - (1 - t) * (1 - t);\n  const lerpE = (start, end, f0, f1) => {\n    if (frame <= f0) return start;\n    if (frame >= f1) return end;\n    return start + (end - start) * easeOut((frame - f0) / (f1 - f0));\n  };\n  const fadeIn = (f0, f1) => {\n    if (frame < f0) return 0;\n    if (frame >= f1) return 1;\n    return (frame - f0) / (f1 - f0);\n  };\n\n  // ── Animation values ─────────────────────────────────────────────\n  const panelWipeW    = lerpE(0, PANEL_W, 0, 20);\n  const panelClipPath = `inset(0 ${PANEL_W - panelWipeW}px 0 0 round 48px)`;\n\n  const titleOpacity    = fadeIn(18, 34);\n  const titleTranslateY = lerpE(24, 0, 18, 34);\n\n  const cards12Scale   = lerpE(0.82, 1, 32, 48);\n  const cards12Opacity = fadeIn(32, 48);\n\n  const c12PillOpacity  = fadeIn(32, 42);\n  const c12PillY        = lerpE(12, 0, 32, 42);\n  const c12IconOpacity  = fadeIn(42, 54);\n  const c12IconY        = lerpE(14, 0, 42, 54);\n  const c12LabelOpacity = fadeIn(54, 64);\n  const c12LabelY       = lerpE(10, 0, 54, 64);\n\n  const opOpacity = fadeIn(58, 70);\n\n  const card3ShellScale   = lerpE(0.82, 1, 66, 80);\n  const card3ShellOpacity = fadeIn(66, 80);\n\n  const c3PillOpacity  = fadeIn(80, 94);\n  const c3PillY        = lerpE(12, 0, 80, 94);\n  const c3IconOpacity  = fadeIn(94, 108);\n  const c3IconY        = lerpE(14, 0, 94, 108);\n  const c3LabelOpacity = fadeIn(108, 122);\n  const c3LabelY       = lerpE(10, 0, 108, 122);\n\n  // ── SVG cutout path ──────────────────────────────────────────────\n  const cutoutPath =\n    `M 0 0 L ${DESIGN_WIDTH} 0 L ${DESIGN_WIDTH} ${DESIGN_HEIGHT} L 0 ${DESIGN_HEIGHT} Z ` +\n    `M ${TH_X+TH_R} ${TH_Y} L ${TH_X+TH_W-TH_R} ${TH_Y} ` +\n    `Q ${TH_X+TH_W} ${TH_Y} ${TH_X+TH_W} ${TH_Y+TH_R} ` +\n    `L ${TH_X+TH_W} ${TH_Y+TH_H-TH_R} ` +\n    `Q ${TH_X+TH_W} ${TH_Y+TH_H} ${TH_X+TH_W-TH_R} ${TH_Y+TH_H} ` +\n    `L ${TH_X+TH_R} ${TH_Y+TH_H} ` +\n    `Q ${TH_X} ${TH_Y+TH_H} ${TH_X} ${TH_Y+TH_H-TH_R} ` +\n    `L ${TH_X} ${TH_Y+TH_R} ` +\n    `Q ${TH_X} ${TH_Y} ${TH_X+TH_R} ${TH_Y} Z`;\n\n  // ── Static styles ────────────────────────────────────────────────\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    fontFamily: fontFamily,\n    overflow: 'hidden',\n  };\n\n  const panelStyle = {\n    position: 'absolute',\n    top: PANEL_Y, left: PANEL_X,\n    width: PANEL_W, height: PANEL_H,\n    backgroundColor: bgColor,\n    borderRadius: 48,\n    clipPath: panelClipPath,\n    display: 'flex', flexDirection: 'column',\n    alignItems: 'center', justifyContent: 'center',\n    gap: 52, padding: '52px 56px',\n    boxSizing: 'border-box',\n    overflow: 'hidden',\n  };\n\n  const titleStyle = {\n    fontSize: 48, fontWeight: 800, color: '#0a1a26',\n    textAlign: 'center', letterSpacing: '-0.02em', lineHeight: 1.15,\n    margin: 0,\n    opacity: titleOpacity,\n    transform: `translateY(${titleTranslateY}px)`,\n  };\n\n  const rowStyle = {\n    display: 'flex', flexDirection: 'row',\n    alignItems: 'center', justifyContent: 'center',\n    gap: 20,\n  };\n\n  // Card wrapper: pill on top, square card in middle, label below\n  const cardWrapBase = {\n    display: 'flex', flexDirection: 'column',\n    alignItems: 'center', gap: 14,\n  };\n\n  const card12WrapStyle = {\n    ...cardWrapBase,\n    opacity: cards12Opacity,\n    transform: `scale(${cards12Scale})`,\n  };\n\n  const card3WrapStyle = {\n    ...cardWrapBase,\n    opacity: card3ShellOpacity,\n    transform: `scale(${card3ShellScale})`,\n  };\n\n  // The square card itself — only holds the icon\n  const squareCardStyle = {\n    width: 260, height: 260,\n    backgroundColor: cardBgColor,\n    borderRadius: 36,\n    border: '7px solid #FFFFFF',\n    boxShadow: '0 14px 32px rgba(0,0,0,0.10)',\n    display: 'flex', alignItems: 'center', justifyContent: 'center',\n    overflow: 'hidden',\n  };\n\n  const pillStyle = (opacity, ty) => ({\n    backgroundColor: primaryColor,\n    padding: '8px 22px', borderRadius: 26,\n    color: '#FFFFFF', fontSize: 26, fontWeight: 700,\n    letterSpacing: '-0.01em',\n    opacity, transform: `translateY(${ty}px)`,\n    flexShrink: 0,\n  });\n\n  const iconWrap = (opacity, ty) => ({\n    opacity, transform: `translateY(${ty}px)`,\n  });\n\n  const labelStyle = (opacity, ty) => ({\n    fontSize: 23, fontWeight: 700, color: '#192b35',\n    textAlign: 'center', lineHeight: 1.35, whiteSpace: 'pre-line',\n    opacity, transform: `translateY(${ty}px)`,\n  });\n\n  const baseOpStyle = {\n    width: 62, height: 62,\n    backgroundColor: '#FFFFFF', borderRadius: 18,\n    boxShadow: '0 6px 16px rgba(0,0,0,0.08)',\n    display: 'flex', justifyContent: 'center', alignItems: 'center',\n    fontSize: 42, fontWeight: 700, color: '#0a1a26',\n    flexShrink: 0,\n    opacity: opOpacity,\n    alignSelf: 'center',\n    marginTop: 14 + 14 + 8, // roughly align operator to card center (pill h + gap)\n  };\n\n  const thBorderStyle = {\n    position: 'absolute',\n    top: TH_Y, left: TH_X, width: TH_W, height: TH_H,\n    borderRadius: TH_R,\n    border: `6px solid ${primaryColor}`,\n    backgroundColor: 'transparent',\n    boxSizing: 'border-box',\n    pointerEvents: 'none',\n  };\n\n  // ── Icons (larger: 130px render size) ───────────────────────────\n  const BankIcon = () => (\n    <svg width=\"130\" height=\"130\" viewBox=\"0 0 100 100\">\n      <rect x=\"12\" y=\"78\" width=\"76\" height=\"8\" rx=\"3\" fill=\"#CBD5E1\" />\n      <rect x=\"20\" y=\"68\" width=\"60\" height=\"10\" rx=\"2\" fill=\"#8da6b5\" />\n      <rect x=\"24\" y=\"40\" width=\"9\" height=\"28\" fill=\"#5c7788\" />\n      <rect x=\"40\" y=\"40\" width=\"9\" height=\"28\" fill=\"#5c7788\" />\n      <rect x=\"56\" y=\"40\" width=\"9\" height=\"28\" fill=\"#5c7788\" />\n      <rect x=\"72\" y=\"40\" width=\"9\" height=\"28\" fill=\"#5c7788\" />\n      <polygon points=\"50,10 92,40 8,40\" fill=\"#405866\" />\n      <circle cx=\"50\" cy=\"54\" r=\"13\" fill=\"#00e2fc\" />\n      <text x=\"50\" y=\"60\" textAnchor=\"middle\" fontSize=\"15\" fontWeight=\"800\" fill=\"#006a65\" fontFamily=\"sans-serif\">$</text>\n    </svg>\n  );\n\n  const HouseIcon = () => (\n    <svg width=\"130\" height=\"130\" viewBox=\"0 0 100 100\">\n      <rect x=\"18\" y=\"46\" width=\"64\" height=\"44\" rx=\"3\" fill=\"#E2E8F0\" />\n      <polygon points=\"50,10 95,46 5,46\" fill=\"#00a18f\" />\n      <rect x=\"39\" y=\"62\" width=\"22\" height=\"28\" rx=\"2\" fill=\"#00a8b1\" />\n      <circle cx=\"57\" cy=\"76\" r=\"2.5\" fill=\"#005853\" />\n      <rect x=\"23\" y=\"55\" width=\"13\" height=\"14\" rx=\"2\" fill=\"#75d6f5\" />\n      <rect x=\"64\" y=\"55\" width=\"13\" height=\"14\" rx=\"2\" fill=\"#75d6f5\" />\n      <rect x=\"70\" y=\"16\" width=\"9\" height=\"20\" rx=\"2\" fill=\"#405866\" />\n    </svg>\n  );\n\n  const BagIcon = () => (\n    <svg width=\"130\" height=\"130\" viewBox=\"0 0 100 100\">\n      <path d=\"M 36 26 L 28 10 L 72 10 L 64 26 Z\" fill=\"#006a65\" />\n      <rect x=\"32\" y=\"22\" width=\"36\" height=\"7\" rx=\"3.5\" fill=\"#005853\" />\n      <ellipse cx=\"50\" cy=\"62\" rx=\"28\" ry=\"30\" fill=\"#00e2fc\" />\n      <text x=\"50\" y=\"71\" textAnchor=\"middle\" fontSize=\"30\" fontWeight=\"800\" fill=\"#006a65\" fontFamily=\"sans-serif\">$</text>\n    </svg>\n  );\n\n  return (\n    <div style={rootStyle}>\n\n      {/* White bg with transparent cutout for talking head */}\n      <svg style={{position:'absolute',top:0,left:0,pointerEvents:'none'}}\n        width={DESIGN_WIDTH} height={DESIGN_HEIGHT}>\n        <path d={cutoutPath} fill=\"#FFFFFF\" fillRule=\"evenodd\" />\n      </svg>\n\n      {/* Left panel */}\n      <div style={panelStyle}>\n        <div style={titleStyle}>{titleText}</div>\n\n        <div style={rowStyle}>\n\n          {/* ── Card 1: Emergency Fund ── */}\n          <div style={card12WrapStyle}>\n            <div style={pillStyle(c12PillOpacity, c12PillY)}>{card1Amount}</div>\n            <div style={squareCardStyle}>\n              <div style={iconWrap(c12IconOpacity, c12IconY)}><BankIcon /></div>\n            </div>\n            <div style={labelStyle(c12LabelOpacity, c12LabelY)}>{card1Label}</div>\n          </div>\n\n          {/* Plus operator */}\n          <div style={baseOpStyle}>+</div>\n\n          {/* ── Card 2: Down Payment ── */}\n          <div style={card12WrapStyle}>\n            <div style={pillStyle(c12PillOpacity, c12PillY)}>{card2Amount}</div>\n            <div style={squareCardStyle}>\n              <div style={iconWrap(c12IconOpacity, c12IconY)}><HouseIcon /></div>\n            </div>\n            <div style={labelStyle(c12LabelOpacity, c12LabelY)}>{card2Label}</div>\n          </div>\n\n          {/* Equals operator */}\n          <div style={baseOpStyle}>=</div>\n\n          {/* ── Card 3: Savings Goal ── */}\n          <div style={card3WrapStyle}>\n            <div style={pillStyle(c3PillOpacity, c3PillY)}>{card3Amount}</div>\n            <div style={squareCardStyle}>\n              <div style={iconWrap(c3IconOpacity, c3IconY)}><BagIcon /></div>\n            </div>\n            <div style={labelStyle(c3LabelOpacity, c3LabelY)}>{card3Label}</div>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Purple border ring for talking head area */}\n      <div style={thBorderStyle} />\n\n    </div>\n  );\n};\n"
 },
