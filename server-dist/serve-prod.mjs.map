  "thumb": "/thumbnails/03decebd-7066-4257-b21c-250151c5c8d2.jpg",
  "code": "const SpecCardOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const { durationInFrames } = useVideoConfig();\n  const props = item.props || {};\n\n  const transparentBackground = props.transparentBackground;\n  const panelColor = props.panelColor;\n  const accentColor = props.accentColor;\n  const textColor = props.textColor;\n  const brandColor = props.brandColor;\n  const fontFamily = props.fontFamily;\n  const textOffsetX = props.textOffsetX !== undefined ? props.textOffsetX : 0;\n\n  const brandText = props.brandText;\n  const titleText = props.titleText;\n  const priceText = props.priceText;\n\n  const specsArray = [\n    props.spec1, props.spec2, props.spec3, props.spec4,\n    props.spec5, props.spec6, props.spec7, props.spec8,\n    props.spec9, props.spec10, props.spec11\n  ].filter(s => s && s.trim() !== '');\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const introDuration = 25;\n  const outroDuration = 25;\n  const outroStart = durationInFrames - outroDuration;\n  const OFFSCREEN = -1100;\n\n  const panelX = (() => {\n    if (frame <= introDuration) {\n      return interpolate(frame, [0, introDuration], [OFFSCREEN, 0], {\n        easing: Easing.out(Easing.cubic),\n        extrapolateLeft: 'clamp',\n        extrapolateRight: 'clamp'\n      });\n    }\n    if (frame >= outroStart) {\n      return interpolate(frame, [outroStart, durationInFrames], [0, OFFSCREEN], {\n        easing: Easing.in(Easing.cubic),\n        extrapolateLeft: 'clamp',\n        extrapolateRight: 'clamp'\n      });\n    }\n    return 0;\n  })();\n\n  const getAnimStyle = (index) => {\n    const startFrame = 20 + index * 2;\n    const opacity = interpolate(frame, [startFrame, startFrame + 12], [0, 1], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' });\n    const y = interpolate(frame, [startFrame, startFrame + 15], [18, 0], {\n      easing: Easing.out(Easing.cubic),\n      extrapolateRight: 'clamp',\n      extrapolateLeft: 'clamp'\n    });\n    return { opacity, transform: `translateY(${y}px)` };\n  };\n\n  const actualAccentColor = transparentBackground ? 'transparent' : accentColor;\n  const panelGradient = transparentBackground\n    ? 'transparent'\n    : `linear-gradient(to right, ${panelColor} 0%, #130900 100%)`;\n\n  const SKEW_DEG = 5;\n  const PANEL_W = 860;\n  const PANEL_TOTAL_W = PANEL_W + 120;\n  // Text area: centered inside the visible panel, with symmetric padding\n  // skew compensation: at PANEL_W width, skewX(-5deg) shifts right edge by ~75px\n\n  return (\n    <div style={{\n      position: 'absolute',\n      top: 0,\n      left: 0,\n      width: DESIGN_WIDTH,\n      height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      backgroundColor: 'transparent',\n      overflow: 'hidden',\n      fontFamily: fontFamily\n    }}>\n      <div style={{\n        position: 'absolute',\n        top: 0,\n        left: 0,\n        width: PANEL_TOTAL_W,\n        height: DESIGN_HEIGHT,\n        transform: `translateX(${panelX}px)`\n      }}>\n        {/* Accent strip */}\n        {!transparentBackground && (\n          <div style={{\n            position: 'absolute',\n            top: 0,\n            left: PANEL_W - 4,\n            width: 12,\n            height: DESIGN_HEIGHT,\n            backgroundColor: actualAccentColor,\n            transform: `skewX(-${SKEW_DEG}deg)`,\n            transformOrigin: 'top left'\n          }} />\n        )}\n        {/* Main panel with gradient */}\n        <div style={{\n          position: 'absolute',\n          top: 0,\n          left: 0,\n          width: PANEL_W,\n          height: DESIGN_HEIGHT,\n          background: panelGradient,\n          transform: `skewX(-${SKEW_DEG}deg)`,\n          transformOrigin: 'top left'\n        }} />\n        {/* Text content — centered in panel, adjustable via textOffsetX */}\n        <div style={{\n          position: 'absolute',\n          top: 0,\n          left: 60 + textOffsetX,\n          width: 700,\n          height: DESIGN_HEIGHT,\n          display: 'flex',\n          alignItems: 'center',\n          justifyContent: 'flex-start'\n        }}>\n          <div style={{\n            width: '100%',\n            display: 'flex',\n            flexDirection: 'column'\n          }}>\n            <div style={{\n              ...getAnimStyle(0),\n              fontSize: '20px',\n              fontWeight: 800,\n              color: brandColor,\n              letterSpacing: '3px',\n              textTransform: 'uppercase',\n              marginBottom: '8px'\n            }}>\n              {brandText}\n            </div>\n            <div style={{\n              ...getAnimStyle(1),\n              fontSize: '54px',\n              fontWeight: 800,\n              marginTop: '20px',\n              marginBottom: '8px',\n              color: textColor,\n              lineHeight: 1.1\n            }}>\n              {titleText}\n            </div>\n            <div style={{\n              ...getAnimStyle(2),\n              fontSize: '24px',\n              fontWeight: 500,\n              marginBottom: '32px',\n              color: textColor,\n              opacity: getAnimStyle(2).opacity * 0.85\n            }}>\n              {priceText}\n            </div>\n            <div style={{ display: 'flex', flexDirection: 'column', gap: '13px' }}>\n              {specsArray.map((spec, index) => (\n                <div key={index} style={{\n                  ...getAnimStyle(3 + index),\n                  fontSize: '22px',\n                  fontWeight: 700,\n                  color: textColor,\n                  lineHeight: 1.3\n                }}>\n                  {spec}\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "05ae4e10-0bf7-4611-bd7e-135b9e2c8ee9",
  "name": "Progress Bar",
  "category": "infographics",
  "description": "A stacked-paper retro loading card with scrolling marquee text and an animated progress bar.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "mainText": "FETCHING COURSE....",
   "marqueeText": "fetching course •",
   "topBarColor": "#ff7865",
   "progressColor": "#8dccf0",
   "targetProgress": 85
  },
  "propSchema": [
   {
    "key": "mainText",
    "type": "text",
    "defaultValue": "FETCHING COURSE....",
    "label": "Main Loading Text"
   },
   {
    "key": "marqueeText",
    "type": "text",
    "defaultValue": "fetching course •",
    "label": "Marquee Text"
   },
   {
    "key": "topBarColor",
    "type": "color",
    "defaultValue": "#ff7865",
    "label": "Top Bar Color"
   },
   {
    "key": "progressColor",
    "type": "color",
    "defaultValue": "#8dccf0",
    "label": "Progress Bar Color"
   },
   {
    "key": "targetProgress",
    "type": "number",
    "defaultValue": 85,
    "label": "Target Progress (%)",
    "min": 0,
    "step": 1
   }
  ],
  "thumb": "/thumbnails/05ae4e10-0bf7-4611-bd7e-135b9e2c8ee9.jpg",
  "code": "const RetroLoadingCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const mainText = props.mainText || 'FETCHING COURSE....';\n  const marqueeText = props.marqueeText || 'fetching course •';\n  const topBarColor = props.topBarColor || '#ff7865';\n  const progressColor = props.progressColor || '#8dccf0';\n  const targetProgress = props.targetProgress ?? 85;\n  const fontFamily = props.fontFamily || '\"Press Start 2P\", monospace';\n\n  const DESIGN_WIDTH = 860;\n  const DESIGN_HEIGHT = 200;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15, stiffness: 120 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const entranceSpring = safeSpring(0, { damping: 14, stiffness: 100 });\n  const translateY = interpolate(entranceSpring, [0, 1], [250, 0]);\n\n  const progressStartFrame = 30;\n  const progressDuration = safeFps * 3;\n  const progressRaw = Math.min(1, Math.max(0, (frame - progressStartFrame) / progressDuration));\n  const progressEased = Easing.inOut(Easing.ease)(progressRaw);\n  const currentProgress = progressEased * targetProgress;\n\n  const marqueeOffset = frame * 1.5;\n  const marqueeContent = new Array(30).fill(marqueeText).join(' ');\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    fontFamily\n  };\n\n  const cardWidth = 740;\n  const cardHeight = 130;\n  const cardLeft = (DESIGN_WIDTH - cardWidth) / 2;\n  const cardTop = (DESIGN_HEIGHT - cardHeight - 12) / 2; // Offset for shadows\n\n  const cardBaseStyle = {\n    position: 'absolute',\n    width: cardWidth,\n    height: cardHeight,\n    border: '2px solid #000',\n    boxSizing: 'border-box',\n    backgroundColor: '#ffffff'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={{\n        position: 'absolute',\n        top: 0,\n        left: 0,\n        width: '100%',\n        height: '100%',\n        transform: `translateY(${translateY}px)`\n      }}>\n        {/* Shadow 2 */}\n        <div style={{ ...cardBaseStyle, top: cardTop + 12, left: cardLeft + 12 }} />\n        \n        {/* Shadow 1 */}\n        <div style={{ ...cardBaseStyle, top: cardTop + 6, left: cardLeft + 6 }} />\n        \n        {/* Main Card */}\n        <div style={{ ...cardBaseStyle, top: cardTop, left: cardLeft, display: 'flex', flexDirection: 'column' }}>\n          \n          {/* Top Bar */}\n          <div style={{\n            width: '100%',\n            height: 24,\n            backgroundColor: topBarColor,\n            borderBottom: '2px solid #000',\n            boxSizing: 'border-box',\n            overflow: 'hidden',\n            display: 'flex',\n            alignItems: 'center'\n          }}>\n            <div style={{\n              whiteSpace: 'nowrap',\n              transform: `translateX(-${marqueeOffset}px)`,\n              color: '#ffffff',\n              fontSize: 10,\n              lineHeight: 1\n            }}>\n              {marqueeContent}\n            </div>\n          </div>\n\n          {/* Card Body */}\n          <div style={{\n            flex: 1,\n            display: 'flex',\n            flexDirection: 'column',\n            justifyContent: 'center',\n            padding: '0 24px',\n            gap: '16px'\n          }}>\n            <div style={{\n              fontSize: 20,\n              color: '#000000',\n              lineHeight: 1\n            }}>\n              {mainText}\n            </div>\n            \n            <div style={{\n              width: '100%',\n              height: 20,\n              border: '1px solid #000',\n              boxSizing: 'border-box',\n              position: 'relative'\n            }}>\n              <div style={{\n                position: 'absolute',\n                top: 0,\n                left: 0,\n                height: '100%',\n                backgroundColor: progressColor,\n                width: `${currentProgress}%`\n              }} />\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
