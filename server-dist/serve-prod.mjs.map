  "code": "const CreativeWatercolorTimeline = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n  const {\n    titleText,\n    year1, text1,\n    year2, text2,\n    year3, text3,\n    year4, text4,\n    titleFontFamily,\n    bodyFontFamily,\n    lineColor,\n    accentColor1,\n    accentColor2,\n    bgColor,\n    transparentBackground\n  } = props;\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden'\n  };\n\n  const getRgba = (color, alpha) => {\n    if (!color) return `rgba(0,0,0,${alpha})`;\n    const hexMatch = color.match(/^#?([a-f\\d]{2})([a-f\\d]{2})([a-f\\d]{2})$/i);\n    if (hexMatch) {\n      return `rgba(${parseInt(hexMatch[1], 16)}, ${parseInt(hexMatch[2], 16)}, ${parseInt(hexMatch[3], 16)}, ${alpha})`;\n    }\n    const shortHexMatch = color.match(/^#?([a-f\\d])([a-f\\d])([a-f\\d])$/i);\n    if (shortHexMatch) {\n      return `rgba(${parseInt(shortHexMatch[1]+shortHexMatch[1], 16)}, ${parseInt(shortHexMatch[2]+shortHexMatch[2], 16)}, ${parseInt(shortHexMatch[3]+shortHexMatch[3], 16)}, ${alpha})`;\n    }\n    return color;\n  };\n\n  const titleOpacity = interpolate(frame, [0, 20], [0, 1], { extrapolateRight: 'clamp' });\n  const titleY = interpolate(frame, [0, 20], [20, 0], { extrapolateRight: 'clamp' });\n\n  const lineProgress = interpolate(frame, [15, 60], [0, 1], { extrapolateRight: 'clamp' });\n  const lineHeight = lineProgress * 650;\n\n  const nodes = [\n    { year: year1, text: text1, y: 350, delay: 45 },\n    { year: year2, text: text2, y: 500, delay: 75 },\n    { year: year3, text: text3, y: 650, delay: 105 },\n    { year: year4, text: text4, y: 800, delay: 135 }\n  ];\n\n  return (\n    <div style={rootStyle}>\n      {!transparentBackground && (\n        <>\n          <svg width=\"1200\" height=\"1200\" viewBox=\"0 0 100 100\" style={{ position: 'absolute', left: -300, top: -400 }}>\n            <defs>\n              <radialGradient id=\"grad-bg-1\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n                <stop offset=\"0%\" stopColor={getRgba(accentColor2, 0.25)} />\n                <stop offset=\"50%\" stopColor={getRgba(accentColor1, 0.1)} />\n                <stop offset=\"100%\" stopColor={getRgba(accentColor1, 0)} />\n              </radialGradient>\n            </defs>\n            <circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"url(#grad-bg-1)\" />\n          </svg>\n          <svg width=\"1400\" height=\"1400\" viewBox=\"0 0 100 100\" style={{ position: 'absolute', right: -400, bottom: -500 }}>\n            <defs>\n              <radialGradient id=\"grad-bg-2\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n                <stop offset=\"0%\" stopColor={getRgba(accentColor1, 0.2)} />\n                <stop offset=\"60%\" stopColor={getRgba(accentColor2, 0.05)} />\n                <stop offset=\"100%\" stopColor={getRgba(accentColor2, 0)} />\n              </radialGradient>\n            </defs>\n            <circle cx=\"50\" cy=\"50\" r=\"50\" fill=\"url(#grad-bg-2)\" />\n          </svg>\n        </>\n      )}\n\n      <div style={{\n        position: 'absolute', top: 120, left: 0, right: 0, textAlign: 'center',\n        opacity: titleOpacity, transform: `translateY(${titleY}px)`,\n        fontFamily: titleFontFamily, fontSize: 64, color: lineColor,\n        letterSpacing: '0.1em', fontWeight: 'bold'\n      }}>\n        {titleText}\n      </div>\n\n      <div style={{ position: 'absolute', top: 0, left: 0, width: 1920, height: 1080 }}>\n        <div style={{\n          position: 'absolute', left: 959, top: 250, width: 2,\n          height: lineHeight, backgroundColor: lineColor\n        }} />\n\n        {nodes.map((node, i) => {\n          const progress = interpolate(frame, [node.delay, node.delay + 20], [0, 1], { extrapolateRight: 'clamp' });\n          const scale = safeSpring(node.delay);\n          const yOffset = interpolate(progress, [0, 1], [15, 0]);\n\n          return (\n            <div key={i} style={{\n              position: 'absolute', top: node.y, left: 960,\n              width: 0, height: 0, display: 'flex', alignItems: 'center', justifyContent: 'center'\n            }}>\n              \n              <div style={{ position: 'absolute', transform: `scale(${scale})` }}>\n                 <div style={{ position: 'absolute', left: -25, top: -25, width: 50, height: 50 }}>\n                    <svg width=\"50\" height=\"50\"><circle cx=\"24\" cy=\"26\" r=\"22\" fill={getRgba(accentColor1, 0.6)}/></svg>\n                 </div>\n                 <div style={{ position: 'absolute', left: -25, top: -25, width: 50, height: 50 }}>\n                    <svg width=\"50\" height=\"50\"><circle cx=\"27\" cy=\"24\" r=\"18\" fill={getRgba(accentColor2, 0.7)}/></svg>\n                 </div>\n                 <div style={{ position: 'absolute', left: -25, top: -25, width: 50, height: 50 }}>\n                    <svg width=\"50\" height=\"50\"><circle cx=\"25\" cy=\"25\" r=\"4\" fill={lineColor}/></svg>\n                 </div>\n              </div>\n\n              <div style={{\n                position: 'absolute', right: 60, width: 300, textAlign: 'right',\n                opacity: progress, transform: `translateY(${yOffset}px)`,\n                fontFamily: titleFontFamily, fontSize: 40, color: lineColor, fontWeight: 'bold'\n              }}>\n                {node.year}\n              </div>\n\n              <div style={{\n                position: 'absolute', left: 60, width: 450, textAlign: 'left',\n                opacity: progress, transform: `translateY(${yOffset}px)`,\n                fontFamily: bodyFontFamily, fontSize: 28, color: lineColor, fontWeight: 'normal',\n                whiteSpace: 'normal', overflowWrap: 'break-word', lineHeight: 1.4\n              }}>\n                {node.text}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "207da43b-d3e8-4f05-81b9-25fbe97c50f4",
  "name": "Creative Watercolor — Universal Anchor",
  "category": "uncategorized",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgColor": "#F6EBEA",
   "transparentBackground": false,
   "textColor": "#192834",
   "washColor1": "#df93b4",
   "washColor2": "#98c8ba",
   "washColor3": "#b0d9ef",
   "titleFont": "Playfair Display",
   "bodyFont": "Inter"
  },
  "propSchema": [
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#F6EBEA",
    "label": "Background"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
    "defaultValue": false,
    "label": "Transparent BG"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#192834",
    "label": "Text Color"
   },
   {
    "key": "washColor1",
    "type": "color",
    "defaultValue": "#df93b4",
    "label": "Wash Pink"
   },
   {
    "key": "washColor2",
    "type": "color",
    "defaultValue": "#98c8ba",
    "label": "Wash Blue"
   },
   {
    "key": "washColor3",
    "type": "color",
    "defaultValue": "#b0d9ef",
    "label": "Wash Peach"
   },
   {
    "key": "titleFont",
    "type": "font",
    "defaultValue": "Playfair Display",
    "label": "Title Font"
   },
   {
    "key": "bodyFont",
    "type": "font",
