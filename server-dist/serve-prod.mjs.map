  ],
  "thumb": "/thumbnails/8744f05e-4976-4430-a14e-85a167301c14.jpg",
  "code": "const ParallelogramCallout = ({item}) => {\n  const frame = useCurrentFrame();\n  const { durationInFrames } = useVideoConfig();\n  const props = item.props || {};\n  const textContent = props.textContent;\n  const boxColor = props.boxColor;\n  const textColor = props.textColor;\n  const skewAngle = props.skewAngle;\n  const fontFamily = props.fontFamily;\n  const transparentBackground = props.transparentBackground;\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const IN_END = 36;\n  const OUT_START = durationInFrames - 28;\n  // In: slow start, accelerates hard near the end — peak velocity at ~85% of duration\n  // cubic-bezier(0.6, 0, 0.1, 1): long flat start, steep drop near end\n  const easeIn  = Easing.bezier(0.6, 0, 0.1, 1);\n  // Out: launches fast immediately, decelerates gently — mirror of in\n  const easeOut = Easing.bezier(0.9, 0, 0.4, 1);\n  const slideIn = interpolate(frame, [0, IN_END], [1, 0], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp',\n    easing: easeIn\n  });\n  const slideOut = interpolate(frame, [OUT_START, durationInFrames], [0, 1], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp',\n    easing: easeOut\n  });\n  const slideT = frame < OUT_START ? slideIn : slideOut;\n  const FONT_SIZE = 72;\n  const PAD_H = 36;\n  const PAD_V = 24;\n  const SHAPE_H = FONT_SIZE + PAD_V * 2;\n  const skewDeg = typeof skewAngle === 'number' ? skewAngle : 15;\n  const OFFSET = Math.tan(skewDeg * Math.PI / 180) * SHAPE_H;\n  const txt = textContent ? String(textContent).toUpperCase() : '';\n  const SHAPE_W = Math.round(txt.length * FONT_SIZE * 0.58 + PAD_H * 2);\n  const TOTAL_W = SHAPE_W + OFFSET;\n  const pts = '0,' + SHAPE_H + ' ' + SHAPE_W + ',' + SHAPE_H + ' ' + TOTAL_W + ',0 ' + OFFSET + ',0';\n  const RIGHT_MARGIN = 150;\n  const BOTTOM_MARGIN = 100;\n  const svgLeft = DESIGN_WIDTH - RIGHT_MARGIN - TOTAL_W;\n  const svgTop  = DESIGN_HEIGHT - BOTTOM_MARGIN - SHAPE_H;\n  const slideOffsetX = slideT * (DESIGN_WIDTH - svgLeft + 50);\n  const actualLeft = svgLeft + slideOffsetX;\n  const textX = OFFSET + PAD_H;\n  const textY = SHAPE_H / 2;\n  const scaleStr = 'scale(' + scale + ')';\n  const svgLeftStr = actualLeft + 'px';\n  const svgTopStr  = svgTop + 'px';\n  const rootStyle = {\n    position:'absolute', top:0, left:0,\n    width:DESIGN_WIDTH, height:DESIGN_HEIGHT,\n    transform:scaleStr, transformOrigin:'top left',\n    overflow:'hidden',\n    backgroundColor: transparentBackground ? 'transparent' : '#e1e9f6'\n  };\n  const svgStyle = { position:'absolute', left:svgLeftStr, top:svgTopStr, overflow:'visible' };\n  return (\n    <div style={rootStyle}>\n      <svg width={TOTAL_W} height={SHAPE_H} style={svgStyle}>\n        <polygon points={pts} fill={boxColor} />\n        <text\n          x={textX} y={textY}\n          fill={textColor}\n          fontFamily={fontFamily}\n          fontSize={FONT_SIZE}\n          fontWeight=\"900\"\n          dominantBaseline=\"middle\"\n          textAnchor=\"start\"\n          style={{textTransform:'uppercase', letterSpacing:'1px'}}\n        >{textContent}</text>\n      </svg>\n    </div>\n  );\n};"
 },
 {
  "id": "200c97a4-3958-4074-ba27-1080eb91a5ce",
