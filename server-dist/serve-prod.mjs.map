  "thumb": "/thumbnails/847102e7-ec7f-4c4c-ad8a-f015f5b31fc7.jpg",
  "code": "const RegionalBarChart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'WISHLISTS BY PLATFORM';\n  const subtitleText = props.subtitleText || 'Launch Week Totals (in K)';\n  const bgGradientStart = props.bgGradientStart || '#3b4860';\n  const bgGradientEnd = props.bgGradientEnd || '#4d5768';\n  const barColor = props.barColor || '#ffffff';\n  const trackColor = props.trackColor || 'rgba(255, 255, 255, 0.1)';\n  const gridColor = props.gridColor || 'rgba(255, 255, 255, 0.15)';\n  const textColor = props.textColor || '#ffffff';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n  const monoFont = '\"IBM Plex Mono\", monospace';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    background: `linear-gradient(135deg, ${bgGradientStart}, ${bgGradientEnd})`,\n    fontFamily: fontFamily,\n    color: textColor,\n    overflow: 'hidden'\n  };\n\n  const titleSpring = spring({ frame, fps, config: { damping: 16 } });\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [-30, 0]);\n\n  const subSpring = spring({ frame: Math.max(0, frame - 5), fps, config: { damping: 16 } });\n  const subOpacity = interpolate(subSpring, [0, 1], [0, 0.8]);\n  const subY = interpolate(subSpring, [0, 1], [-20, 0]);\n\n  const gridSpring = spring({ frame: Math.max(0, frame - 15), fps, config: { damping: 20 } });\n  const gridOpacity = interpolate(gridSpring, [0, 1], [0, 1]);\n\n  const data = [\n    { label: 'North America', value: 82 },\n    { label: 'Europe', value: 67 },\n    { label: 'Asia Pacific', value: 91 },\n    { label: 'Latin America', value: 43 },\n    { label: 'Middle East', value: 28 },\n  ];\n\n  const gridLines = [0, 25, 50, 75, 100].map(val => ({\n    val,\n    bottom: `${val}%`,\n  }));\n\n  const bars = data.map((d, i) => {\n    const barSpring = spring({ \n      frame: Math.max(0, frame - 25 - i * 6), \n      fps, \n      config: { damping: 15, mass: 0.9 } \n    });\n    const valOpacity = interpolate(barSpring, [0.7, 1], [0, 1], { \n      extrapolateRight: 'clamp', \n      extrapolateLeft: 'clamp' \n    });\n    const valOffset = interpolate(barSpring, [0.7, 1], [15, 0], { \n      extrapolateRight: 'clamp', \n      extrapolateLeft: 'clamp' \n    });\n    \n    return {\n      ...d,\n      heightPct: d.value,\n      currentHeight: d.value * barSpring,\n      displayValue: Math.round(d.value * barSpring),\n      valOpacity,\n      valOffset\n    };\n  });\n\n  return (\n    <div style={rootStyle}>\n      {/* Header */}\n      <div style={{ position: 'absolute', top: 120, width: '100%', textAlign: 'center' }}>\n        <h1 style={{\n          margin: 0,\n          fontSize: 56,\n          fontWeight: 600,\n          letterSpacing: '4px',\n          opacity: titleOpacity,\n          transform: `translateY(${titleY}px)`,\n          textTransform: 'uppercase'\n        }}>{titleText}</h1>\n        <h2 style={{\n          margin: '12px 0 0 0',\n          fontSize: 24,\n          fontWeight: 300,\n          letterSpacing: '1px',\n          opacity: subOpacity,\n          transform: `translateY(${subY}px)`\n        }}>{subtitleText}</h2>\n      </div>\n\n      {/* Chart Area */}\n      <div style={{\n        position: 'absolute',\n        top: 360,\n        left: 260,\n        width: 1400,\n        height: 520,\n        opacity: gridOpacity\n      }}>\n        {/* Grid Lines */}\n        {gridLines.map(line => (\n          <div key={line.val} style={{\n            position: 'absolute',\n            bottom: line.bottom,\n            left: 0,\n            width: '100%',\n            borderBottom: `1px solid ${gridColor}`,\n            display: 'flex',\n            alignItems: 'center'\n          }}>\n            <span style={{\n              position: 'absolute',\n              left: -60,\n              fontSize: 18,\n              fontWeight: 400,\n              fontFamily: monoFont,\n              opacity: 0.7\n            }}>{line.val}</span>\n          </div>\n        ))}\n\n        {/* Bars Container */}\n        <div style={{\n          position: 'absolute',\n          top: 0, left: 0, width: '100%', height: '100%',\n          display: 'flex',\n          justifyContent: 'space-around',\n          alignItems: 'flex-end',\n          paddingLeft: 40,\n          paddingRight: 40,\n          boxSizing: 'border-box'\n        }}>\n          {bars.map((bar) => (\n            <div key={bar.label} style={{\n              position: 'relative',\n              width: 100,\n              height: '100%'\n            }}>\n              {/* Track */}\n              <div style={{\n                position: 'absolute',\n                bottom: 0, left: 0,\n                width: '100%', height: '100%',\n                backgroundColor: trackColor\n              }} />\n\n              {/* Filled Bar */}\n              <div style={{\n                position: 'absolute',\n                bottom: 0, left: 0,\n                width: '100%',\n                height: `${bar.currentHeight}%`,\n                backgroundColor: barColor,\n                transformOrigin: 'bottom'\n              }} />\n\n              {/* Value Label */}\n              <div style={{\n                position: 'absolute',\n                bottom: `${bar.currentHeight}%`,\n                left: 0, width: '100%',\n                textAlign: 'center',\n                marginBottom: 20,\n                transform: `translateY(-${bar.valOffset}px)`,\n                opacity: bar.valOpacity,\n                fontSize: 28,\n                fontWeight: 500,\n                fontFamily: monoFont,\n              }}>\n                {bar.displayValue}\n              </div>\n\n              {/* X Axis Label */}\n              <div style={{\n                position: 'absolute',\n                top: '100%',\n                left: '50%',\n                transform: 'translateX(-50%)',\n                marginTop: 24,\n                width: 160,\n                textAlign: 'center',\n                fontSize: 18,\n                fontWeight: 300,\n                opacity: 0.9,\n                lineHeight: 1.3\n              }}>\n                {bar.label}\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
