  "code": "const withAlphaRG = (color, alpha) => {\n  const m = String(color).match(/rgba?\\(\\s*(\\d+),\\s*(\\d+),\\s*(\\d+)(?:,\\s*([\\d.]+))?\\s*\\)/);\n  if (m) {\n    const a = parseFloat(m[4] || '1') * alpha;\n    return 'rgba(' + m[1] + ',' + m[2] + ',' + m[3] + ',' + a.toFixed(4) + ')';\n  }\n  return color;\n};\n\nconst evalBezierRG = (seg, t) => {\n  const mt = 1 - t;\n  return [\n    mt * mt * mt * seg[0][0] + 3 * mt * mt * t * seg[1][0] + 3 * mt * t * t * seg[2][0] + t * t * t * seg[3][0],\n    mt * mt * mt * seg[0][1] + 3 * mt * mt * t * seg[1][1] + 3 * mt * t * t * seg[2][1] + t * t * t * seg[3][1],\n  ];\n};\n\nconst getSegLenRG = (seg) => {\n  let length = 0;\n  let prev = evalBezierRG(seg, 0);\n  for (let i = 1; i <= 48; i++) {\n    const cur = evalBezierRG(seg, i / 48);\n    const dx = cur[0] - prev[0];\n    const dy = cur[1] - prev[1];\n    length += Math.sqrt(dx * dx + dy * dy);\n    prev = cur;\n  }\n  return length;\n};\n\nconst RetentionGraphWhite = ({ item }) => {\n  const frame = useCurrentFrame();\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const SEGS = [\n    [[0, 160], [30, 160], [50, 90], [80, 90]],\n    [[80, 90], [120, 90], [150, 265], [200, 265]],\n    [[200, 265], [240, 265], [260, 220], [300, 220]],\n    [[300, 220], [350, 220], [378, 295], [420, 295]],\n    [[420, 295], [452, 295], [470, 278], [500, 278]],\n    [[500, 278], [548, 278], [575, 345], [645, 382]],\n    [[645, 382], [740, 408], [848, 400], [950, 400]],\n  ];\n\n  const PATH_D =\n    'M 0 160 C 30 160, 50 90, 80 90 ' +\n    'C 120 90, 150 265, 200 265 ' +\n    'C 240 265, 260 220, 300 220 ' +\n    'C 350 220, 378 295, 420 295 ' +\n    'C 452 295, 470 278, 500 278 ' +\n    'C 548 278, 575 345, 645 382 ' +\n    'C 740 408, 848 400, 950 400';\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const fontFamily = props.fontFamily;\n  const lineColor = props.lineColor;\n  const fillColorStart = props.fillColorStart;\n  const fillColorEnd = props.fillColorEnd;\n  const bgColorOuter = props.bgColorOuter;\n  const transparentBackground = props.transparentBackground;\n\n  const SEG_LENS = React.useMemo(() => SEGS.map(getSegLenRG), []);\n  const TOTAL_LEN = React.useMemo(() => SEG_LENS.reduce((s, l) => s + l, 0), [SEG_LENS]);\n\n  const buildAreaPath = (progress) => {\n    if (progress <= 0) return null;\n    const targetLen = progress * TOTAL_LEN;\n    const points = [[0, 100]];\n    let accumulated = 0;\n    let done = false;\n    for (let si = 0; si < SEGS.length && !done; si++) {\n      const seg = SEGS[si];\n      const segLen = SEG_LENS[si];\n      let prevPoint = evalBezierRG(seg, 0);\n      let cumulativeInSegment = 0;\n      for (let i = 1; i <= 32 && !done; i++) {\n        const t = i / 32;\n        const cur = evalBezierRG(seg, t);\n        const dx = cur[0] - prevPoint[0];\n        const dy = cur[1] - prevPoint[1];\n        const stepLen = Math.sqrt(dx * dx + dy * dy);\n        cumulativeInSegment += stepLen;\n        if (accumulated + cumulativeInSegment >= targetLen) {\n          const overshoot = accumulated + cumulativeInSegment - targetLen;\n          const ratio = stepLen === 0 ? 0 : 1 - overshoot / stepLen;\n          points.push([\n            prevPoint[0] + (cur[0] - prevPoint[0]) * ratio,\n            prevPoint[1] + (cur[1] - prevPoint[1]) * ratio,\n          ]);\n          done = true;\n        } else {\n          points.push([cur[0], cur[1]]);\n          prevPoint = cur;\n        }\n      }\n      if (!done) accumulated += segLen;\n    }\n    if (points.length < 2) return null;\n    const tip = points[points.length - 1];\n    return (\n      'M ' + points.map((p) => p[0].toFixed(2) + ' ' + p[1].toFixed(2)).join(' L ') +\n      ' L ' + tip[0].toFixed(2) + ' 460 L 0 460 Z'\n    );\n  };\n\n  const introProgress = interpolate(frame, [0, 15], [0, 1], { extrapolateRight: 'clamp' });\n  const cardY = interpolate(frame, [0, 20], [32, 0], {\n    extrapolateRight: 'clamp',\n    easing: Easing.out(Easing.quad),\n  });\n  const axisProgress = interpolate(frame, [10, 30], [0, 1], { extrapolateRight: 'clamp' });\n  const lineProgress = interpolate(frame, [38, 110], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const lineOffset = (1 - lineProgress) * 1000;\n  const dotOffset = -lineProgress * 1000;\n  const dotOpacity = 0; // dot removed\n\n  const areaPath = buildAreaPath(lineProgress);\n\n  const cardLeft = 360;\n  const cardTop = 190;\n  const cardW = 1200;\n  const cardH = 700;\n\n  const gridOpacity = axisProgress * 0.095;\n  const gridColor = 'rgba(255,255,255,' + gridOpacity.toFixed(4) + ')';\n\n  const itemId = item && (item.id || item.name);\n  const uid = 'rg-' + (itemId ? String(itemId).replace(/[^a-zA-Z0-9_-]/g, '_') : 'chart');\n\n  const ids = {\n    fillV: uid + '-fill-v',\n    fillH: uid + '-fill-h',\n    glowHuge: uid + '-glow-huge',\n    glowMedium: uid + '-glow-medium',\n    glowSmall: uid + '-glow-small',\n    areaEdge: uid + '-area-edge',\n  };\n\n  const labelColor = 'rgba(202,227,246,' + (0.52 * axisProgress).toFixed(4) + ')';\n  const xLabelColor = 'rgba(202,227,246,' + (0.58 * axisProgress).toFixed(4) + ')';\n\n  const labelStyle = {\n    position: 'absolute',\n    width: 130,\n    height: 40,\n    left: 22,\n    textAlign: 'right',\n    color: labelColor,\n    fontSize: 15,\n    fontWeight: 400,\n    letterSpacing: '-0.2px',\n    lineHeight: 1.18,\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'flex-end',\n    textShadow: '0 0 14px rgba(255,255,255,0.10)',\n    fontFamily: fontFamily,\n  };\n\n  const xLabelStyle = {\n    position: 'absolute',\n    top: 572,\n    color: xLabelColor,\n    fontSize: 15,\n    fontWeight: 400,\n    textShadow: '0 0 14px rgba(255,255,255,0.08)',\n    fontFamily: fontFamily,\n  };\n\n  // White-first: glow uses pure white, accent color reduced to a subtle tint\n  const glowSoftStroke = 'rgba(255,255,255,0.22)';\n  const glowMainStroke = 'rgba(255,255,255,0.45)';\n  const whiteLineStroke = 'rgba(255,255,255,0.80)';\n  const dotGlowStroke = 'rgba(255,255,255,' + (dotOpacity * 0.7).toFixed(4) + ')';\n  const dotWhiteStroke = 'rgba(255,255,255,' + dotOpacity.toFixed(4) + ')';\n\n  const fillVStart88 = withAlphaRG(fillColorStart, 0.88);\n  const fillVEnd88 = withAlphaRG(fillColorEnd, 0.88);\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: transparentBackground ? 'transparent' : bgColorOuter,\n    fontFamily: fontFamily,\n    overflow: 'hidden',\n  };\n\n  return (\n    <div style={rootStyle}>\n      {!transparentBackground && (\n        <>\n          <div\n            style={{\n              position: 'absolute',\n              inset: 0,\n              background:\n                'radial-gradient(circle at 38% -8%, rgba(30,44,50,0.9) 0%, rgba(20,20,28,0.7) 40%, transparent 70%),' +\n                'linear-gradient(135deg, #0d0d12 0%, #0a0a0e 55%, #111114 100%)',\n            }}\n          />\n          <div\n            style={{\n              position: 'absolute',\n              width: 900,\n              height: 520,\n              left: 240,\n              top: -170,\n              background: 'radial-gradient(ellipse, rgba(255,255,255,0.04), transparent 65%)',\n              filter: 'blur(42px)',\n            }}\n          />\n          <div\n            style={{\n              position: 'absolute',\n              width: 620,\n              height: 460,\n              right: 180,\n              top: 130,\n              background: 'radial-gradient(ellipse, rgba(255,255,255,0.025), transparent 70%)',\n              filter: 'blur(55px)',\n            }}\n          />\n        </>\n      )}\n\n      <div\n        style={{\n          position: 'absolute',\n          left: cardLeft - 70,\n          top: cardTop + cardY - 70,\n          width: cardW + 140,\n          height: cardH + 140,\n          pointerEvents: 'none',\n          background: 'radial-gradient(ellipse at 28% 8%, rgba(255,255,255,0.04), transparent 58%)',\n          filter: 'blur(36px)',\n        }}\n      />\n\n      <div\n        style={{\n          position: 'absolute',\n          width: cardW,\n          height: cardH,\n          left: cardLeft,\n          top: cardTop + cardY,\n          opacity: introProgress,\n          borderRadius: 24,\n          background:\n            'linear-gradient(135deg, rgba(38,38,48,0.88) 0%, rgba(22,22,30,0.92) 50%, rgba(14,14,20,0.96) 100%)',\n          border: '1px solid rgba(255,255,255,0.14)',\n          boxShadow:\n            '0 40px 120px rgba(0,0,0,0.85),' +\n            '0 0 60px rgba(255,255,255,0.04),' +\n            'inset 0 1px 0 rgba(255,255,255,0.22),' +\n            'inset 0 -1px 0 rgba(255,255,255,0.04),' +\n            'inset 1px 0 0 rgba(255,255,255,0.06)',\n          overflow: 'hidden',\n        }}\n      >\n        <div\n          style={{\n            position: 'absolute',\n            top: -160,\n            left: -120,\n            width: 720,\n            height: 620,\n            background:\n              'radial-gradient(ellipse at 25% 25%, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.03) 36%, transparent 68%)',\n            pointerEvents: 'none',\n          }}\n        />\n\n        <div\n          style={{\n            position: 'absolute',\n            inset: 0,\n            pointerEvents: 'none',\n            background:\n              'linear-gradient(135deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.025) 18%, transparent 48%),' +\n              'radial-gradient(circle at 18% 0%, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.02) 28%, transparent 58%)',\n          }}\n        />\n\n        <div\n          style={{\n            position: 'absolute',\n            left: 1,\n            right: 1,\n            top: 0,\n            height: 1,\n            background:\n              'linear-gradient(90deg, transparent, rgba(255,255,255,0.32), rgba(255,255,255,0.18), transparent)',\n          }}\n        />\n\n        <div\n          style={{\n            position: 'absolute',\n            left: 0,\n            top: 24,\n            bottom: 24,\n            width: 1,\n            background:\n              'linear-gradient(180deg, transparent, rgba(255,255,255,0.158), transparent)',\n          }}\n        />\n\n        <div\n          style={{\n            position: 'absolute',\n            right: 54,\n            top: 36,\n            fontSize: 50,\n            fontWeight: 700,\n            fontFamily: fontFamily,\n            color: 'rgba(255,255,255,0.96)',\n            letterSpacing: '-1.2px',\n            textShadow:\n              '0 1px 0 rgba(255,255,255,0.22),' +\n              '0 0 24px rgba(255,255,255,0.12),' +\n              '0 10px 30px rgba(0,0,0,0.5)',\n          }}\n        >\n          {titleText}\n        </div>\n\n        <div style={{ ...labelStyle, top: 125 }}>Peak</div>\n        <div style={{ ...labelStyle, top: 218 }}>Strong<br />Typical</div>\n        <div style={{ ...labelStyle, top: 322 }}>Typical</div>\n        <div style={{ ...labelStyle, top: 416 }}>Mild<br />Typical</div>\n        <div style={{ ...labelStyle, top: 515 }}>Drop</div>\n\n        <div style={{ ...xLabelStyle, left: 178 }}>0:00</div>\n        <div style={{ ...xLabelStyle, right: 68 }}>1:00</div>\n\n        <div\n          style={{\n            position: 'absolute',\n            left: 178,\n            top: 130,\n            width: 950,\n            height: 500,\n          }}\n        >\n          <svg\n            width=\"950\"\n            height=\"470\"\n            viewBox=\"0 0 950 470\"\n            style={{ overflow: 'visible' }}\n          >\n            <defs>\n              <linearGradient id={ids.fillV} x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0%\" stopColor={fillVStart88} />\n                <stop offset=\"34%\" stopColor=\"rgba(255,255,255,0.10)\" />\n                <stop offset=\"68%\" stopColor=\"rgba(255,255,255,0.04)\" />\n                <stop offset=\"100%\" stopColor={fillVEnd88} />\n              </linearGradient>\n\n              <linearGradient id={ids.fillH} x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n                <stop offset=\"0%\" stopColor=\"rgba(255,255,255,0.12)\" />\n                <stop offset=\"16%\" stopColor=\"rgba(255,255,255,0.05)\" />\n                <stop offset=\"38%\" stopColor=\"rgba(255,255,255,0.01)\" />\n                <stop offset=\"100%\" stopColor=\"rgba(255,255,255,0)\" />\n              </linearGradient>\n\n              <filter id={ids.glowHuge} x=\"-60%\" y=\"-60%\" width=\"220%\" height=\"220%\" colorInterpolationFilters=\"sRGB\">\n                <feGaussianBlur stdDeviation=\"26\" />\n              </filter>\n\n              <filter id={ids.glowMedium} x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\" colorInterpolationFilters=\"sRGB\">\n                <feGaussianBlur stdDeviation=\"10\" />\n              </filter>\n\n              <filter id={ids.glowSmall} x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\" colorInterpolationFilters=\"sRGB\">\n                <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n                <feMerge><feMergeNode in=\"blur\" /><feMergeNode in=\"SourceGraphic\" /></feMerge>\n              </filter>\n\n              <filter id={ids.areaEdge} x=\"-20%\" y=\"-120%\" width=\"140%\" height=\"340%\" colorInterpolationFilters=\"sRGB\">\n                <feGaussianBlur stdDeviation=\"13\" result=\"blur\" />\n                <feMerge><feMergeNode in=\"blur\" /><feMergeNode in=\"SourceGraphic\" /></feMerge>\n              </filter>\n            </defs>\n\n            {[0, 100, 200, 300, 400].map((y) => (\n              <line key={y} x1=\"0\" y1={y} x2=\"950\" y2={y} stroke={gridColor} strokeWidth=\"1\" />\n            ))}\n            <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"460\" stroke={gridColor} strokeWidth=\"1\" />\n\n            {areaPath && (\n              <React.Fragment>\n                <path d={areaPath} fill={'url(#' + ids.fillV + ')'} />\n                <path d={areaPath} fill={'url(#' + ids.fillH + ')'} />\n              </React.Fragment>\n            )}\n\n            <path\n              d={PATH_D}\n              pathLength=\"1000\"\n              strokeDasharray=\"1000\"\n              strokeDashoffset={lineOffset}\n              fill=\"none\"\n              stroke=\"rgba(255,255,255,0.12)\"\n              strokeWidth=\"14\"\n              filter={'url(#' + ids.areaEdge + ')'}\n            />\n\n            <path\n              d={PATH_D}\n              pathLength=\"1000\"\n              strokeDasharray=\"1000\"\n              strokeDashoffset={lineOffset}\n              stroke={glowSoftStroke}\n              strokeWidth=\"56\"\n              fill=\"none\"\n              filter={'url(#' + ids.glowHuge + ')'}\n            />\n\n            <path\n              d={PATH_D}\n              pathLength=\"1000\"\n              strokeDasharray=\"1000\"\n              strokeDashoffset={lineOffset}\n              stroke={glowMainStroke}\n              strokeWidth=\"18\"\n              fill=\"none\"\n              filter={'url(#' + ids.glowMedium + ')'}\n            />\n\n            <path\n              d={PATH_D}\n              pathLength=\"1000\"\n              strokeDasharray=\"1000\"\n              strokeDashoffset={lineOffset}\n              stroke={lineColor}\n              strokeWidth=\"3.2\"\n              fill=\"none\"\n              filter={'url(#' + ids.glowSmall + ')'}\n            />\n\n            <path\n              d={PATH_D}\n              pathLength=\"1000\"\n              strokeDasharray=\"1000\"\n              strokeDashoffset={lineOffset}\n              stroke={whiteLineStroke}\n              strokeWidth=\"1.15\"\n              fill=\"none\"\n            />\n\n          </svg>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "53dd0f34-fa25-4999-b317-5122f11d258c",
  "name": "Revenue counter stat reveal overlay",
  "category": "data-visualization",
  "description": "A revenue counter that animates a title fading in with a glow effect, followed by a number that rolls up from zero to your target value with a neon light trail.",
  "tags": [
   "long-form",
   "short-form",
   "talking-head",
   "screen-recording"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "My Monthly Food Vlog Revenue",
   "prefix": "$",
   "targetValue": "10000",
   "titleColor": "#e5f8fa",
   "numberColor": "#e5f8fa",
   "fontFamily": "Montserrat",
   "transparentBackground": true
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "My Monthly Food Vlog Revenue",
