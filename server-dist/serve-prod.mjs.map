  "thumb": "/thumbnails/6cb35207-77ab-4538-8b60-9fe32f493460.jpg",
  "code": "const CreativeWatercolor = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const textColor = props.textColor;\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const footerText = props.footerText;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n\n  const washBlue = props.washBlue;\n  const washPink = props.washPink;\n  const washPeach = props.washPeach;\n  const washFlower = props.washFlower;\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 20, stiffness: 100 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const titleSpring = safeSpring(15);\n  const subtitleSpring = safeSpring(25);\n  const lineSpring = safeSpring(35);\n  const footerSpring = safeSpring(40);\n  const washAlpha = interpolate(frame, [0, 45], [0, 1], { extrapolateRight: 'clamp' });\n  const washScale = interpolate(frame, [0, 120], [0.95, 1.05], { extrapolateRight: 'clamp' });\n  const flowerRotate = interpolate(frame, [0, 120], [-5, 5], { extrapolateRight: 'clamp' });\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  const hexToRgba = (hex, alpha) => {\n    let r = 0, g = 0, b = 0;\n    const cleanHex = hex.replace('#', '');\n    if (cleanHex.length === 3) {\n      r = parseInt(cleanHex[0] + cleanHex[0], 16);\n      g = parseInt(cleanHex[1] + cleanHex[1], 16);\n      b = parseInt(cleanHex[2] + cleanHex[2], 16);\n    } else if (cleanHex.length === 6) {\n      r = parseInt(cleanHex.substring(0, 2), 16);\n      g = parseInt(cleanHex.substring(2, 4), 16);\n      b = parseInt(cleanHex.substring(4, 6), 16);\n    }\n    return `rgba(${r}, ${g}, ${b}, ${alpha})`;\n  };\n\n  const transformBezier = (points, tx, ty, rotDeg, scale) => {\n    return points.map(pt => {\n      const rad = rotDeg * (Math.PI / 180);\n      const scaledX = pt.x * scale;\n      const scaledY = pt.y * scale;\n      const rx = scaledX * Math.cos(rad) - scaledY * Math.sin(rad);\n      const ry = scaledX * Math.sin(rad) + scaledY * Math.cos(rad);\n      return { x: rx + tx, y: ry + ty };\n    });\n  };\n\n  const getPetalStr = (rotDeg, scale, tx, ty) => {\n    const pts = [\n      {x: 0, y: 0}, {x: 40, y: -40}, {x: 60, y: -130},\n      {x: 0, y: -190}, {x: -60, y: -130}, {x: -40, y: -40}\n    ];\n    const t = transformBezier(pts, tx, ty, rotDeg, scale);\n    return `M ${t[0].x},${t[0].y} C ${t[1].x},${t[1].y} ${t[2].x},${t[2].y} ${t[3].x},${t[3].y} C ${t[4].x},${t[4].y} ${t[5].x},${t[5].y} ${t[0].x},${t[0].y} Z`;\n  };\n\n  const getLeafStr = (rotDeg, scale, tx, ty) => {\n    const pts = [\n      {x: 0, y: 0}, {x: -50, y: 40}, {x: -80, y: 100},\n      {x: -20, y: 180}, {x: 20, y: 100}, {x: -10, y: 40}\n    ];\n    const t = transformBezier(pts, tx, ty, rotDeg, scale);\n    return `M ${t[0].x},${t[0].y} C ${t[1].x},${t[1].y} ${t[2].x},${t[2].y} ${t[3].x},${t[3].y} C ${t[4].x},${t[4].y} ${t[5].x},${t[5].y} ${t[0].x},${t[0].y} Z`;\n  };\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden',\n    display: 'flex',\n    flexDirection: 'row',\n    width: 1920,\n    height: 1080,\n  };\n\n  const leftContainer = {\n    position: 'absolute',\n    left: 0,\n    top: 0,\n    width: '50%',\n    height: '100%',\n    opacity: washAlpha,\n  };\n\n  const textContainer = {\n    position: 'absolute',\n    left: '50%',\n    top: '20%',\n    width: '45%',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'flex-start',\n  };\n\n  const titleStyle = {\n    fontFamily: titleFont,\n    fontSize: 88,\n    fontWeight: 300,\n    color: textColor,\n    lineHeight: 1.15,\n    letterSpacing: '0.02em',\n    whiteSpace: 'pre-wrap',\n    opacity: titleSpring,\n    transform: `translateY(${(1 - titleSpring) * 40}px)`,\n    margin: 0,\n  };\n\n  const subtitleStyle = {\n    fontFamily: bodyFont,\n    fontSize: 28,\n    fontWeight: 400,\n    color: textColor,\n    lineHeight: 1.4,\n    whiteSpace: 'pre-wrap',\n    opacity: subtitleSpring,\n    transform: `translateY(${(1 - subtitleSpring) * 30}px)`,\n    marginTop: 100,\n  };\n\n  const footerContainer = {\n    position: 'absolute',\n    bottom: 0,\n    left: '5%',\n    width: '90%',\n    height: 120,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n  };\n\n  const separatorLine = {\n    width: '100%',\n    height: 2,\n    backgroundColor: textColor,\n    transform: `scaleX(${lineSpring})`,\n    transformOrigin: 'left',\n    opacity: 0.8,\n  };\n\n  const footerTextStyle = {\n    fontFamily: bodyFont,\n    fontSize: 16,\n    fontWeight: 500,\n    color: textColor,\n    letterSpacing: '0.1em',\n    textAlign: 'right',\n    marginTop: 20,\n    opacity: footerSpring,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={leftContainer}>\n        <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 960 1080\">\n          <defs>\n            <radialGradient id=\"gradBlue\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={hexToRgba(washBlue, 0.6)} />\n              <stop offset=\"60%\" stopColor={hexToRgba(washBlue, 0.4)} />\n              <stop offset=\"100%\" stopColor={hexToRgba(washBlue, 0)} />\n            </radialGradient>\n            <radialGradient id=\"gradPink\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={hexToRgba(washPink, 0.55)} />\n              <stop offset=\"70%\" stopColor={hexToRgba(washPink, 0.3)} />\n              <stop offset=\"100%\" stopColor={hexToRgba(washPink, 0)} />\n            </radialGradient>\n            <radialGradient id=\"gradPeach\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={hexToRgba(washPeach, 0.6)} />\n              <stop offset=\"80%\" stopColor={hexToRgba(washPeach, 0.2)} />\n              <stop offset=\"100%\" stopColor={hexToRgba(washPeach, 0)} />\n            </radialGradient>\n            <radialGradient id=\"gradPeachLeaf\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={hexToRgba(washPeach, 0.42)} />\n              <stop offset=\"80%\" stopColor={hexToRgba(washPeach, 0.14)} />\n              <stop offset=\"100%\" stopColor={hexToRgba(washPeach, 0)} />\n            </radialGradient>\n            <radialGradient id=\"gradPinkLeaf\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={hexToRgba(washPink, 0.33)} />\n              <stop offset=\"70%\" stopColor={hexToRgba(washPink, 0.18)} />\n              <stop offset=\"100%\" stopColor={hexToRgba(washPink, 0)} />\n            </radialGradient>\n            <radialGradient id=\"gradFlower\" cx=\"50%\" cy=\"50%\" r=\"100%\">\n              <stop offset=\"0%\" stopColor=\"#fff\" />\n              <stop offset=\"50%\" stopColor={hexToRgba(washFlower, 0.9)} />\n              <stop offset=\"100%\" stopColor={hexToRgba(washFlower, 0.1)} />\n            </radialGradient>\n            <radialGradient id=\"gradCenter\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={hexToRgba('#9bcaff', 0.9)} />\n              <stop offset=\"100%\" stopColor={hexToRgba('#6ab0ea', 0)} />\n            </radialGradient>\n          </defs>\n\n          <g transform={`translate(480, 540) scale(${washScale}) translate(-480, -540)`}>\n            {/* Background Washes */}\n            <circle cx=\"350\" cy=\"800\" r=\"500\" fill=\"url(#gradBlue)\" />\n            <circle cx=\"500\" cy=\"200\" r=\"600\" fill=\"url(#gradPink)\" />\n            <circle cx=\"150\" cy=\"450\" r=\"450\" fill=\"url(#gradPeach)\" />\n            \n            {/* Stem and soft foliage */}\n            <path d=\"M 300,1000 C 400,800 350,600 380,450\" fill=\"none\" stroke={hexToRgba(washPeach, 0.4)} strokeWidth=\"4\" />\n            \n            {/* Leaves on stem sides */}\n            <path d={getLeafStr(-50, 0.7, 330, 720)} fill=\"url(#gradPeachLeaf)\" />\n            <path d={getLeafStr(55, 0.7, 370, 620)} fill=\"url(#gradPinkLeaf)\" />\n\n            {/* Main Flower Overlay */}\n            {[0, 72, 144, 216, 288].map(angle => (\n              <path key={angle} d={getPetalStr(angle + flowerRotate, 1.1, 380, 450)} fill=\"url(#gradFlower)\" />\n            ))}\n            <circle cx=\"380\" cy=\"450\" r=\"44\" fill=\"url(#gradCenter)\" />\n          </g>\n        </svg>\n      </div>\n\n      <div style={textContainer}>\n        <h1 style={titleStyle}>{titleText}</h1>\n        <p style={subtitleStyle}>{subtitleText}</p>\n      </div>\n\n      <div style={footerContainer}>\n        <div style={separatorLine} />\n        <div style={footerTextStyle}>{footerText}</div>\n      </div>\n    </div>\n  );\n};"
 },
 {
