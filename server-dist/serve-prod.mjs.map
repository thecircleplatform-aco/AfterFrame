    "key": "opt2Value",
    "type": "number",
    "defaultValue": 27,
    "label": "Option 2 Votes"
   },
   {
    "key": "opt3Value",
    "type": "number",
    "defaultValue": 18,
    "label": "Option 3 Votes"
   },
   {
    "key": "opt4Value",
    "type": "number",
    "defaultValue": 7,
    "label": "Option 4 Votes"
   },
   {
    "key": "barColorWinner",
    "type": "color",
    "defaultValue": "#aae356",
    "label": "Winner Bar Color"
   },
   {
    "key": "barColorOthers",
    "type": "color",
    "defaultValue": "#cccccc",
    "label": "Other Bars Color"
   }
  ],
  "thumb": "/thumbnails/4de08f53-df3a-47ed-bd45-e541386b27fa.jpg",
  "code": "const PollCard = ({item}) => {\n  const baseFrame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const backgroundImage = props.backgroundImage;\n  const questionText = props.questionText;\n  const votesText = props.votesText;\n  const sourceName = props.sourceName;\n  const sourceTime = props.sourceTime;\n  const badgeColor = props.badgeColor;\n  const barColorWinner = props.barColorWinner;\n  const barColorOthers = props.barColorOthers;\n  const opt1Label = props.opt1Label;\n  const opt2Label = props.opt2Label;\n  const opt3Label = props.opt3Label;\n  const opt4Label = props.opt4Label;\n  const opt1Value = props.opt1Value;\n  const opt2Value = props.opt2Value;\n  const opt3Value = props.opt3Value;\n  const opt4Value = props.opt4Value;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n\n  const frame = Math.floor(baseFrame / 3) * 3;\n  const rawProgress = interpolate(frame, [6, 54], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const easeOutCubic = (x) => 1 - Math.pow(1 - x, 3);\n  const progress = easeOutCubic(rawProgress);\n\n  const options = [\n    { label: opt1Label, value: opt1Value, isWinner: true },\n    { label: opt2Label, value: opt2Value, isWinner: false },\n    { label: opt3Label, value: opt3Value, isWinner: false },\n    { label: opt4Label, value: opt4Value, isWinner: false },\n  ];\n\n  const total = options.reduce((s, o) => s + (o.value || 0), 0) || 100;\n\n  return (\n    <div style={{ position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, fontFamily: 'Roboto, sans-serif' }}>\n      {backgroundImage ? (\n        <Img src={backgroundImage} style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', objectFit: 'cover', zIndex: 0 }} />\n      ) : (\n        <div style={{ position: 'absolute', inset: 0, backgroundColor: '#a3b86e', zIndex: 0 }} />\n      )}\n\n      <div style={{ position: 'absolute', left: '17%', top: '19%', width: '66%', zIndex: 2, display: 'flex', flexDirection: 'column' }}>\n\n        <div style={{ display: 'flex', alignItems: 'center', gap: 20, marginBottom: 28 }}>\n          <div style={{ width: 72, height: 72, borderRadius: '50%', backgroundColor: badgeColor, display: 'flex', justifyContent: 'center', alignItems: 'center', fontWeight: 900, fontSize: 20, fontFamily: 'Roboto, sans-serif', color: '#fff', flexShrink: 0 }}>\n            {(sourceName || '').substring(0, 3).toUpperCase()}\n          </div>\n          <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n            <span style={{ fontWeight: 800, fontSize: 30, color: '#000' }}>{sourceName}</span>\n            <span style={{ fontSize: 26, color: '#888' }}>{sourceTime}</span>\n          </div>\n        </div>\n\n        <div style={{ fontWeight: 700, fontSize: 36, color: '#000', marginBottom: 10, lineHeight: 1.35 }}>{questionText}</div>\n        <div style={{ fontSize: 24, color: '#888', marginBottom: 36 }}>{votesText}</div>\n\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>\n          {options.map((opt, i) => {\n            const pct = total > 0 ? Math.round((opt.value / total) * 100) : 0;\n            const barW = progress * pct;\n            const rollingNum = Math.floor(progress * pct);\n            const displayNum = frame >= 54 ? pct + '%' : rollingNum + '%';\n            return (\n              <div key={i} style={{ position: 'relative', width: '100%', height: 82, border: '1.5px solid rgba(0,0,0,0.12)', borderRadius: 8, overflow: 'hidden', display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px', boxSizing: 'border-box' }}>\n                <div style={{ position: 'absolute', top: 0, left: 0, bottom: 0, width: `${barW}%`, backgroundColor: opt.isWinner ? barColorWinner : barColorOthers, zIndex: 1 }} />\n                <div style={{ position: 'relative', zIndex: 2, fontSize: 26, fontWeight: 600, color: opt.isWinner ? '#000' : '#555' }}>{opt.label}</div>\n                <div style={{ position: 'relative', zIndex: 2, fontSize: opt.isWinner ? 44 : 30, fontWeight: opt.isWinner ? 800 : 600, color: opt.isWinner ? '#000' : '#444', minWidth: 120, textAlign: 'right', fontVariantNumeric: 'tabular-nums' }}>{displayNum}</div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "7f1570f1-c211-4143-b15d-76849729d786",
  "name": "Search Interface Simulator",
  "category": "social-ui",
  "description": "Authentic Google search homepage recreation with a card interface, typing animation, and smooth scale effects.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "searchText": "",
   "cardColor": "#FFFFFF",
   "showCardBackground": "true"
  },
  "propSchema": [
   {
    "key": "searchText",
    "type": "text",
    "defaultValue": "",
    "label": "Search query"
   },
   {
    "key": "cardColor",
    "type": "color",
    "defaultValue": "#FFFFFF",
    "label": "Background color"
   },
   {
    "key": "showCardBackground",
    "type": "text",
    "defaultValue": "true",
    "label": "Show background"
   }
  ],
  "thumb": "/thumbnails/7f1570f1-c211-4143-b15d-76849729d786.jpg",
  "code": "const GoogleSearchOverlay = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const props = item.props || {};\n  const searchText = props.searchText || '';\n  const showCardBackground = props.showCardBackground !== undefined ? props.showCardBackground : true;\n  const cardColor = props.cardColor || '#FFFFFF';\n\n  const colors = {\n    blue: '#dd5847',\n    red: '#EA4335',\n    yellow: '#84d2ff',\n    green: '#34A853',\n    textGray: '#5F6368',\n    borderGray: '#DFE1E5',\n    bgGray: '#F8F9FA',\n  };\n\n  const totalFrames = 8 * fps;\n  const entranceDuration = 1.5 * fps;\n  const fadeOutStart = 7.5 * fps;\n  const typeStart = 2.5 * fps;\n  const typeEnd = 6.5 * fps;\n\n  // 1. Slide up entrance\n  const slideY = interpolate(frame, [0, entranceDuration], [DESIGN_HEIGHT * 0.6, 0], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  // 2. Ken Burns slow zoom — applied to entire wrapper\n  const kenBurns = interpolate(frame, [0, totalFrames], [1.0, 1.1], {\n    easing: Easing.inOut(Easing.ease),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  // 3. Search bar pop\n  const barScale = interpolate(frame, [2 * fps, 2.5 * fps], [1, 1.04], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const barShadowBlur = interpolate(frame, [2 * fps, 2.5 * fps], [8, 20], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  // 4. Typing\n  const typeProgress = interpolate(frame, [typeStart, typeEnd], [0, searchText.length], {\n    easing: Easing.linear,\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const currentText = searchText.substring(0, Math.floor(typeProgress));\n  const showCursor = frame >= typeStart && frame <= typeEnd + fps * 0.5;\n  const cursorVisible = Math.floor(frame / 14) % 2 === 0;\n\n  // 5. Fade out\n  const globalOpacity = interpolate(frame, [0, 10, fadeOutStart, totalFrames], [0, 1, 1, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    opacity: globalOpacity,\n    overflow: 'hidden',\n  };\n\n  // The single content wrapper — both slideY and kenBurns applied here together\n  const contentStyle = {\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    transform: `translateY(${slideY}px) scale(${kenBurns})`,\n    transformOrigin: 'center center',\n    willChange: 'transform',\n    backgroundColor: showCardBackground ? cardColor : 'transparent',\n  };\n\n  const logoStyle = {\n    fontFamily: 'Arial, sans-serif',\n    fontSize: 96,\n    fontWeight: 'bold',\n    letterSpacing: -2,\n    marginBottom: 44,\n    userSelect: 'none',\n    lineHeight: 1,\n  };\n\n  const searchBarStyle = {\n    width: 700,\n    height: 64,\n    borderRadius: 32,\n    border: `1.5px solid ${colors.borderGray}`,\n    display: 'flex',\n    alignItems: 'center',\n    padding: '0 16px 0 20px',\n    marginBottom: 36,\n    backgroundColor: '#fff',\n    boxShadow: `0 2px ${barShadowBlur}px rgba(32,33,36,0.18)`,\n    transform: `scale(${barScale})`,\n    transformOrigin: 'center center',\n    willChange: 'transform',\n  };\n\n  const inputAreaStyle = {\n    flex: 1,\n    fontSize: 20,\n    fontFamily: 'Arial, sans-serif',\n    color: '#202124',\n    display: 'flex',\n    alignItems: 'center',\n    marginLeft: 14,\n    height: '100%',\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n  };\n\n  const buttonContainerStyle = {\n    display: 'flex',\n    gap: 14,\n  };\n\n  const buttonStyle = {\n    backgroundColor: colors.bgGray,\n    border: '1px solid transparent',\n    borderRadius: 4,\n    color: '#3c4043',\n    fontFamily: 'Arial, sans-serif',\n    fontSize: 15,\n    padding: '0 20px',\n    height: 38,\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    cursor: 'pointer',\n  };\n\n  const iconsAreaStyle = {\n    display: 'flex',\n    alignItems: 'center',\n    gap: 2,\n    flexShrink: 0,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={contentStyle}>\n        {/* Google Logo */}\n        <div style={logoStyle}>\n          <span style={{ color: colors.blue }}>G</span>\n          <span style={{ color: colors.red }}>o</span>\n          <span style={{ color: colors.yellow }}>o</span>\n          <span style={{ color: colors.blue }}>g</span>\n          <span style={{ color: colors.green }}>l</span>\n          <span style={{ color: colors.red }}>e</span>\n        </div>\n\n        {/* Search Bar */}\n        <div style={searchBarStyle}>\n          {/* Plus icon */}\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill={colors.textGray} style={{ flexShrink: 0 }}>\n            <path d=\"M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z\"/>\n          </svg>\n\n          {/* Text input area */}\n          <div style={inputAreaStyle}>\n            <span style={{ color: '#202124' }}>{currentText}</span>\n            {showCursor && cursorVisible && (\n              <span style={{\n                display: 'inline-block',\n                width: 2,\n                height: 22,\n                backgroundColor: colors.blue,\n                marginLeft: 1,\n                verticalAlign: 'middle',\n                flexShrink: 0,\n              }} />\n            )}\n          </div>\n\n          {/* Right icons */}\n          <div style={iconsAreaStyle}>\n            {/* Mic */}\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style={{ padding: 4 }}>\n              <path d=\"M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z\" fill=\"#dd5847\"/>\n              <path d=\"M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z\" fill=\"#34A853\"/>\n            </svg>\n            {/* Lens */}\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style={{ padding: 4 }}>\n              <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\" fill=\"#EA4335\"/>\n            </svg>\n            {/* AI Mode pill */}\n            <div style={{\n              background: 'linear-gradient(90deg, #dd5847, #EA4335, #84d2ff, #34A853)',\n              padding: 1.5,\n              borderRadius: 20,\n              marginLeft: 8,\n              flexShrink: 0,\n            }}>\n              <div style={{\n                background: '#fff',\n                borderRadius: 20,\n                padding: '4px 12px',\n                fontSize: 13,\n                fontFamily: 'Arial, sans-serif',\n                fontWeight: '600',\n                display: 'flex',\n                alignItems: 'center',\n                gap: 5,\n                color: '#202124',\n                whiteSpace: 'nowrap',\n              }}>\n                <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\">\n                  <defs>\n                    <linearGradient id=\"aiGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                      <stop offset=\"0%\" stopColor=\"#dd5847\"/>\n                      <stop offset=\"100%\" stopColor=\"#EA4335\"/>\n                    </linearGradient>\n                  </defs>\n                  <path d=\"M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z\" fill=\"url(#aiGrad)\"/>\n                </svg>\n                AI Mode\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Buttons */}\n        <div style={buttonContainerStyle}>\n          <div style={buttonStyle}>Signal Search</div>\n          <div style={buttonStyle}>I'm Feeling Nerdy</div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "83a77388-8670-4df0-bd5e-b4e3b59c92ce",
  "name": "Bullet Points Overlay",
  "category": "talking-head-overlays",
  "description": "A split-screen layout overlay featuring a talking-head video placeholder and four staggered bullet points that instantly pop onto the screen in sequence.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgColor": "#f2f5fb",
   "transparentBackground": false,
   "text1": "Brew with fresh whole beans",
   "text2": "Grind fine for bold flavor",
   "text3": "Master water temperature",
   "text4": "Rest to unlock aroma",
   "fontFamily": "Inter, sans-serif"
  },
  "propSchema": [
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#e1e9f6",
    "label": "Background color"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
    "defaultValue": false,
    "label": "Transparent background"
   },
   {
    "key": "text1",
    "type": "text",
    "defaultValue": "Brew with fresh whole beans",
    "label": "Bullet 1 text"
   },
   {
    "key": "text2",
    "type": "text",
    "defaultValue": "Grind fine for bold flavor",
    "label": "Bullet 2 text"
   },
   {
    "key": "text3",
    "type": "text",
    "defaultValue": "Master water temperature",
    "label": "Bullet 3 text"
   },
   {
    "key": "text4",
    "type": "text",
    "defaultValue": "Rest to unlock aroma",
    "label": "Bullet 4 text"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Inter, sans-serif",
    "label": "Font family"
   }
  ],
  "thumb": "/thumbnails/83a77388-8670-4df0-bd5e-b4e3b59c92ce.jpg",
  "code": "const BulletPointOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const props = item.props || {};\n\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const text1 = props.text1;\n  const text2 = props.text2;\n  const text3 = props.text3;\n  const text4 = props.text4;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Layout constants\n  const CARD_W = 735;\n  const CARD_H = 160;\n  const VID_LEFT = 1350;\n  const VID_TOP = 172;\n  const VID_W = 514;\n  const VID_H = 715;\n  const VID_RX = 26;\n\n  // Animation timing\n  const ENTER_DUR = 14;\n  const SLIDE_DIST = 50;\n  const TEXT_DELAY = 6;\n  const EXIT_START = 155;\n  const EXIT_DUR = 14;\n  const cardEnterFrames = [20, 45, 70, 95];\n\n  const easeOutCubic = t => 1 - Math.pow(1 - t, 3);\n  const easeInCubic  = t => Math.pow(t, 3);\n\n  const getCardAnim = (enterFrame) => {\n    if (frame < enterFrame) return { opacity: 0, tx: -SLIDE_DIST, show: false };\n    if (frame < enterFrame + ENTER_DUR) {\n      const t = easeOutCubic((frame - enterFrame) / ENTER_DUR);\n      return { opacity: t, tx: (1 - t) * -SLIDE_DIST, show: true };\n    }\n    if (frame < EXIT_START) return { opacity: 1, tx: 0, show: true };\n    if (frame < EXIT_START + EXIT_DUR) {\n      const t = easeInCubic((frame - EXIT_START) / EXIT_DUR);\n      return { opacity: 1 - t, tx: t * -SLIDE_DIST, show: true };\n    }\n    return { opacity: 0, tx: -SLIDE_DIST, show: false };\n  };\n\n  const getTextAnim = (enterFrame) => {\n    const tIn = enterFrame + TEXT_DELAY;\n    if (frame < tIn) return { opacity: 0, tx: -SLIDE_DIST * 0.5 };\n    if (frame < tIn + ENTER_DUR) {\n      const t = easeOutCubic((frame - tIn) / ENTER_DUR);\n      return { opacity: t, tx: (1 - t) * -SLIDE_DIST * 0.5 };\n    }\n    if (frame < EXIT_START) return { opacity: 1, tx: 0 };\n    if (frame < EXIT_START + EXIT_DUR) {\n      const t = easeInCubic((frame - EXIT_START) / EXIT_DUR);\n      return { opacity: 1 - t, tx: t * -SLIDE_DIST * 0.5 };\n    }\n    return { opacity: 0, tx: -SLIDE_DIST * 0.5 };\n  };\n\n  // SVG icon paths — dark gray stroke on white circle, consistent with overall gray palette\n  const ICON_STROKE = '#272e3b';\n  const icons = [\n    // Chef hat / cook\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={ICON_STROKE} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6z\"/>\n      <line x1=\"6\" y1=\"17\" x2=\"18\" y2=\"17\"/>\n    </svg>,\n    // Leaf / herb\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={ICON_STROKE} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z\"/>\n      <path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"/>\n    </svg>,\n    // Flame / heat\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={ICON_STROKE} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/>\n    </svg>,\n    // Jar / ferment\n    <svg width=\"46\" height=\"46\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={ICON_STROKE} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M8 2h8l1 7H7L8 2z\"/>\n      <path d=\"M7 9c0 5 2 8 5 11 3-3 5-6 5-11\"/>\n      <line x1=\"7\" y1=\"13\" x2=\"17\" y2=\"13\"/>\n    </svg>,\n  ];\n\n  const cards = [\n    { text: text1, icon: icons[0], x: 99,  cy: 179, enterFrame: cardEnterFrames[0] },\n    { text: text2, icon: icons[1], x: 402, cy: 417, enterFrame: cardEnterFrames[1] },\n    { text: text3, icon: icons[2], x: 99,  cy: 662, enterFrame: cardEnterFrames[2] },\n    { text: text4, icon: icons[3], x: 402, cy: 907, enterFrame: cardEnterFrames[3] },\n  ];\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      fontFamily: fontFamily,\n      overflow: 'hidden',\n    }}>\n      {/* SVG background with rounded-rect hole punched via mask */}\n      {!transparentBackground && (\n        <svg\n          width={DESIGN_WIDTH}\n          height={DESIGN_HEIGHT}\n          style={{ position: 'absolute', top: 0, left: 0 }}\n        >\n          <defs>\n            <mask id=\"cutoutMask\">\n              {/* White = show background */}\n              <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} fill=\"white\" />\n              {/* Black = punch hole with correct border-radius */}\n              <rect x={VID_LEFT} y={VID_TOP} width={VID_W} height={VID_H} rx={VID_RX} ry={VID_RX} fill=\"black\" />\n            </mask>\n          </defs>\n          {/* Background rect with hole */}\n          <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} fill={bgColor} mask=\"url(#cutoutMask)\" />\n        </svg>\n      )}\n\n      {/* Talking-head window frame — border + shadow only, hole is transparent */}\n      <div style={{\n        position: 'absolute',\n        left: VID_LEFT,\n        top: VID_TOP,\n        width: VID_W,\n        height: VID_H,\n        borderRadius: VID_RX,\n        backgroundColor: 'transparent',\n        border: '5px solid #ffffff',\n        boxShadow: '0 16px 56px rgba(0,1,9,0.28), 0 4px 18px rgba(0,1,9,0.14)',\n        boxSizing: 'border-box',\n      }} />\n\n      {/* Bullet cards */}\n      {cards.map((card, i) => {\n        const anim = getCardAnim(card.enterFrame);\n        if (!anim.show) return null;\n        const textAnim = getTextAnim(card.enterFrame);\n        return (\n          <div key={i} style={{\n            position: 'absolute',\n            left: card.x,\n            top: card.cy - CARD_H / 2,\n            width: CARD_W,\n            height: CARD_H,\n            backgroundColor: '#dbe3f2',\n            borderRadius: 18,\n            display: 'flex',\n            alignItems: 'center',\n            paddingLeft: 16,\n            boxSizing: 'border-box',\n            opacity: anim.opacity,\n            transform: `translateX(${anim.tx}px)`,\n          }}>\n            <div style={{\n              width: 90, height: 90,\n              backgroundColor: '#ffffff',\n              borderRadius: '50%',\n              display: 'flex',\n              justifyContent: 'center',\n              alignItems: 'center',\n              flexShrink: 0,\n            }}>\n              {card.icon}\n            </div>\n            <div style={{\n              marginLeft: 26,\n              fontSize: 38,\n              fontWeight: '700',\n              color: '#131a27',\n              letterSpacing: '-0.4px',\n              whiteSpace: 'nowrap',\n              opacity: textAnim.opacity,\n              transform: `translateX(${textAnim.tx}px)`,\n            }}>\n              {card.text}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
 },
