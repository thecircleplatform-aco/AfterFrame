  "thumb": "/thumbnails/4444d0ce-ac02-4831-ad25-dd90b6aea350.jpg",
  "code": "const ProjectPhases = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n  \n  const safeFps = fps || 30;\n  \n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const textColor = props.textColor;\n  const accentColor = props.accentColor;\n  const fontFamily = props.fontFamily;\n  \n  // Timing calculations\n  const titleOpacity = interpolate(frame, [0, 20], [0, 1], { extrapolateRight: 'clamp' });\n  const titleY = interpolate(frame, [0, 20], [30, 0], { extrapolateRight: 'clamp' });\n  \n  const lineLength = interpolate(frame, [15, 60], [0, 1600], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' });\n  \n  const nodes = [\n    { title: props.phase1Title, desc: props.phase1Desc, delay: 45, align: 'left', offset: 0 },\n    { title: props.phase2Title, desc: props.phase2Desc, delay: 75, align: 'center', offset: -200 },\n    { title: props.phase3Title, desc: props.phase3Desc, delay: 105, align: 'center', offset: -200 },\n    { title: props.phase4Title, desc: props.phase4Desc, delay: 135, align: 'right', offset: -400 }\n  ];\n\n  // Background blob animation variables\n  const b1x = 960 + Math.sin(frame / 60) * 300;\n  const b1y = 540 + Math.cos(frame / 45) * 200;\n  const b2x = 400 + Math.cos(frame / 70) * 400;\n  const b2y = 800 + Math.sin(frame / 50) * 300;\n  const b3x = 1500 + Math.sin(frame / 55) * 350;\n  const b3y = 200 + Math.cos(frame / 65) * 250;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: bgColor,\n    overflow: 'hidden'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {!props.transparentBackground && (\n        <div style={{ position: 'absolute', inset: 0 }}>\n          <div style={{\n            position: 'absolute',\n            width: 1400, height: 1400,\n            borderRadius: '50%',\n            background: 'radial-gradient(circle, rgba(129,98,0, 0.5) 0%, rgba(129,98,0, 0) 65%)',\n            left: b1x - 700, top: b1y - 700\n          }} />\n          <div style={{\n            position: 'absolute',\n            width: 1200, height: 1200,\n            borderRadius: '50%',\n            background: 'radial-gradient(circle, rgba(181,92,0, 0.45) 0%, rgba(181,92,0, 0) 65%)',\n            left: b2x - 600, top: b2y - 600\n          }} />\n          <div style={{\n            position: 'absolute',\n            width: 1600, height: 1600,\n            borderRadius: '50%',\n            background: 'radial-gradient(circle, rgba(185,108,0, 0.4) 0%, rgba(185,108,0, 0) 65%)',\n            left: b3x - 800, top: b3y - 800\n          }} />\n        </div>\n      )}\n\n      <div style={{ position: 'absolute', inset: 0 }}>\n        {/* Title */}\n        <div style={{\n          position: 'absolute',\n          left: 160,\n          top: 180,\n          fontFamily,\n          fontStyle: 'italic',\n          color: textColor,\n          fontSize: 64,\n          fontWeight: 800,\n          letterSpacing: '-0.02em',\n          opacity: titleOpacity,\n          transform: `translateY(${titleY}px)`\n        }}>\n          {props.titleText}\n        </div>\n\n        {/* Timeline Base Line */}\n        <div style={{\n          position: 'absolute',\n          left: 160,\n          top: 540,\n          height: 3,\n          width: lineLength,\n          backgroundColor: accentColor,\n          opacity: 0.5,\n          borderRadius: 2\n        }} />\n\n        {/* Nodes and Labels */}\n        {nodes.map((node, i) => {\n          const xPos = 160 + i * (1600 / 3);\n          const isVisible = frame >= node.delay;\n          const nodeSpring = spring({ \n            frame: Math.max(0, frame - node.delay), \n            fps: safeFps, \n            config: { damping: 15 } \n          });\n          const textOpacity = interpolate(frame, [node.delay + 10, node.delay + 25], [0, 1], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' });\n          const textY = interpolate(frame, [node.delay + 10, node.delay + 25], [20, 0], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' });\n\n          return (\n            <React.Fragment key={i}>\n              {/* Glow Node */}\n              <div style={{\n                position: 'absolute',\n                left: xPos - 12,\n                top: 540 - 12,\n                width: 24,\n                height: 24,\n                borderRadius: '50%',\n                backgroundColor: accentColor,\n                transform: `scale(${nodeSpring})`,\n                boxShadow: `0 0 24px 4px rgba(255, 255, 255, 0.4)`,\n                display: isVisible ? 'block' : 'none'\n              }} />\n\n              {/* Node Text Content */}\n              <div style={{\n                position: 'absolute',\n                left: xPos + node.offset,\n                top: 590,\n                width: 400,\n                textAlign: node.align,\n                opacity: textOpacity,\n                transform: `translateY(${textY}px)`,\n                fontFamily,\n                fontStyle: 'italic',\n                display: frame >= node.delay + 10 ? 'block' : 'none'\n              }}>\n                <div style={{\n                  color: textColor,\n                  fontSize: 30,\n                  fontWeight: 800,\n                  marginBottom: 8,\n                  letterSpacing: '0.02em'\n                }}>\n                  {node.title}\n                </div>\n                <div style={{\n                  color: textColor,\n                  fontSize: 22,\n                  fontWeight: 400,\n                  opacity: 0.8\n                }}>\n                  {node.desc}\n                </div>\n              </div>\n            </React.Fragment>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
