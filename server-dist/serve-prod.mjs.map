  "thumb": "/thumbnails/17a91a44-4a0d-42c3-a0fa-f9a7d0613fe5.jpg",
  "code": "const TitleCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const { durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const line3Text = props.line3Text;\n  const line4aText = props.line4aText;\n  const line4bText = props.line4bText;\n  const accentColor = props.accentColor;\n  const textColor = props.textColor;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 800;\n  const DESIGN_HEIGHT = 450;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const outroStart = Math.max(1, durationInFrames - 15);\n  const outroEnd = Math.max(outroStart + 1, durationInFrames);\n\n  const easeInQuad = (t) => t * t;\n  const t = interpolate(frame, [outroStart, outroEnd], [0, 1], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n  const outTranslateX = easeInQuad(t) * -110;\n  const speed = 2 * t;\n  const blurAmount = speed * 4;\n  const motionFilter = t > 0.02 ? 'blur(' + blurAmount + 'px)' : 'none';\n\n  const dropShadow = '3px 4px 6px rgba(0,0,0,0.6)';\n\n  const words1 = (line1Text || '').split(' ').filter(Boolean);\n  const words2 = (line2Text || '').split(' ').filter(Boolean);\n  const words3 = (line3Text || '').split(' ').filter(Boolean);\n  const words4a = (line4aText || '').split(' ').filter(Boolean);\n  const words4b = (line4bText || '').split(' ').filter(Boolean);\n\n  const start2 = words1.length;\n  const start3 = start2 + words2.length;\n  const start4a = start3 + words3.length;\n  const start4b = start4a + words4a.length;\n\n  const INTRO_DELAY = 8;  // 开头延迟稍长\n  const WORD_INTERVAL = 7; // 每词间隔7帧，更从容\n\n  const renderWords = (wordsArray, fontSize, fontWeight, color, startIndex) => {\n    return wordsArray.map((word, i) => {\n      const delay = INTRO_DELAY + (startIndex + i) * WORD_INTERVAL;\n      const visible = frame >= delay;\n      return (\n        <span key={startIndex + i} style={{\n          visibility: visible ? 'visible' : 'hidden',\n          fontSize, fontWeight, color,\n          textShadow: dropShadow,\n          lineHeight: 1.1,\n          letterSpacing: fontSize === '90px' ? '-0.02em' : '-0.01em',\n        }}>{word + '\\u00A0'}</span>\n      );\n    });\n  };\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: 'scale(' + scale + ')', transformOrigin: 'top left',\n    }}>\n      <div style={{\n        transform: 'translateX(' + outTranslateX + '%)',\n        filter: motionFilter,\n        display: 'flex', flexDirection: 'column', alignItems: 'flex-start',\n        padding: '30px', fontFamily,\n        willChange: 'transform, filter',\n      }}>\n        <div style={{ lineHeight: 1.0 }}>{renderWords(words1, '90px', 900, accentColor, 0)}</div>\n        <div style={{ lineHeight: 1.1, marginTop: '4px' }}>{renderWords(words2, '45px', 600, textColor, start2)}</div>\n        <div style={{ lineHeight: 1.0, marginTop: '4px' }}>{renderWords(words3, '90px', 900, accentColor, start3)}</div>\n        <div style={{ lineHeight: 1.0, marginTop: '4px', display: 'flex', alignItems: 'baseline' }}>\n          {renderWords(words4a, '90px', 900, accentColor, start4a)}\n          {renderWords(words4b, '45px', 600, textColor, start4b)}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "874f586e-280e-4ea1-b224-a2213ca3c25e",
  "name": "Typewriter indicator animation",
  "category": "uncategorized",
  "description": "A Vox-style definition card with a shoot-on-threes posterized animation frame rate. Features a typewriter headline, height-revealed subtitles, and an animated highlighter wipe.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "headlineText": "Roasting",
   "subtitleLine1": "Slow conversion of raw coffee beans",
   "subtitleLine2": "using controlled heat",
   "headlineFont": "Roboto, sans-serif",
