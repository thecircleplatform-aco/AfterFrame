  "code": "const CartoonStyleShowcase = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const transparentBackground = props.transparentBackground;\n  const bgColor = transparentBackground ? 'transparent' : (props.bgColor);\n  const primaryColor = props.primaryColor;\n  const accentColor = props.accentColor;\n  const fontFamily = props.fontFamily;\n  const bodyFontFamily = props.bodyFontFamily;\n\n  const safeSpring = (delay = 0, config = { damping: 15, mass: 0.8, stiffness: 120 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps, config });\n  };\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: bgColor,\n    overflow: 'hidden',\n    fontFamily,\n    color: primaryColor,\n  };\n\n  // Timings based on brief\n  const titleDelay = 0;\n  const chartDelay = 36;\n  const nameDelay = 72;\n  const bulletDelays = [108, 120, 132];\n  const quoteDelay = 150;\n  const timelineDelay = 174;\n\n  // Title Animation\n  const titlePop = safeSpring(titleDelay);\n  const titleY = interpolate(titlePop, [0, 1], [50, 0]);\n\n  // Chart Animations\n  const bar1Width = safeSpring(chartDelay, { damping: 18 }) * (props.chartVal1);\n  const bar2Width = safeSpring(chartDelay + 6, { damping: 18 }) * (props.chartVal2);\n  const bar3Width = safeSpring(chartDelay + 12, { damping: 18 }) * (props.chartVal3);\n\n  // Name Tag\n  const namePop = safeSpring(nameDelay);\n  \n  // Quote Animation\n  const quotePop = safeSpring(quoteDelay);\n  \n  // Timeline Animation\n  const timelineDraw = safeSpring(timelineDelay, { damping: 20 });\n\n  const Sparkle = ({ left, top, delay, size = 40, rotation = 0, item }) => {\n    const s = safeSpring(delay);\n    return (\n      <div style={{ position: 'absolute', left, top, width: size, height: size, transform: `scale(${s}) rotate(${rotation}deg)` }}>\n        <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 24 24\" style={{ overflow: 'visible' }}>\n          <path\n            d=\"M12 0 C12 10, 22 12, 22 12 C22 12, 12 14, 12 24 C12 14, 2 12, 2 12 C2 12, 12 10, 12 0 Z\"\n            fill=\"transparent\"\n            stroke={accentColor}\n            strokeWidth=\"1.5\"\n          />\n        </svg>\n      </div>\n    );\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* 1. Chapter Title */}\n      <div style={{ position: 'absolute', left: 120, top: 120, transform: `scale(${titlePop}) translateY(${titleY}px)`, opacity: titlePop }}>\n        <div style={{ position: 'relative', display: 'inline-block', marginBottom: 20 }}>\n          <svg style={{ position: 'absolute', inset: -20, width: 'calc(100% + 40px)', height: 'calc(100% + 40px)' }}>\n            <ellipse cx=\"50%\" cy=\"50%\" rx=\"48%\" ry=\"48%\" fill=\"transparent\" stroke={accentColor} strokeWidth=\"3\" />\n          </svg>\n          <span style={{ fontSize: 24, fontWeight: 'bold', color: primaryColor, position: 'relative' }}>{props.estdText}</span>\n        </div>\n        <h1 style={{ fontSize: 130, margin: 0, lineHeight: 0.9, textTransform: 'uppercase', letterSpacing: '-2px' }}>\n          {(props.titleText).split('\\n').map((line, i) => (\n            <div key={i}>{line}</div>\n          ))}\n        </h1>\n      </div>\n      <Sparkle left={80} top={80} delay={titleDelay + 10} rotation={15} />\n      <Sparkle left={550} top={350} delay={titleDelay + 20} size={60} rotation={45} />\n\n      {/* 2. Data Chart */}\n      <div style={{ position: 'absolute', right: 160, top: 120, width: 450, opacity: Math.min(1, frame - chartDelay > 0 ? 1 : 0) }}>\n        {[[props.chartLabel1, bar1Width], [props.chartLabel2, bar2Width], [props.chartLabel3, bar3Width]].map((item, i) => (\n          <div key={i} style={{ marginBottom: 30 }}>\n            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 10, fontSize: 28, fontFamily: bodyFontFamily, fontWeight: 'bold' }}>\n              <span>{item[0]}</span>\n              <span>{Math.round(item[1])}%</span>\n            </div>\n            <div style={{ width: '100%', height: 24, backgroundColor: 'rgba(60,81,0, 0.1)', borderRadius: 12, border: `2px solid ${primaryColor}` }}>\n              <div style={{ width: `${item[1]}%`, height: '100%', backgroundColor: primaryColor, borderRadius: 10, borderRight: `4px solid ${accentColor}` }} />\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* 3. Name Tag */}\n      <div style={{ position: 'absolute', left: 120, bottom: 260, transform: `scale(${namePop})` }}>\n        <div style={{ border: `4px solid ${primaryColor}`, borderRadius: 20, backgroundColor: bgColor, padding: '20px 40px', boxShadow: `8px 8px 0px ${accentColor}` }}>\n          <div style={{ fontSize: 24, fontFamily: bodyFontFamily, color: accentColor, fontWeight: 'bold' }}>MEET THE ARTIST</div>\n          <div style={{ fontSize: 48, marginTop: 5 }}>{props.nameTag}</div>\n          <div style={{ fontSize: 28, fontFamily: bodyFontFamily, marginTop: 10 }}>{props.roleTag}</div>\n        </div>\n      </div>\n\n      {/* 4. Bullet Points */}\n      <div style={{ position: 'absolute', right: 650, top: 400, width: 500, fontFamily: bodyFontFamily }}>\n        {[props.bullet1, props.bullet2, props.bullet3].map((text, i) => {\n          const bPop = safeSpring(bulletDelays[i]);\n          return (\n            <div key={i} style={{ display: 'flex', alignItems: 'center', marginBottom: 25, transform: `translateX(${(1 - bPop) * 50}px)`, opacity: bPop }}>\n              <svg width=\"32\" height=\"32\" viewBox=\"0 0 32 32\" style={{ marginRight: 20, flexShrink: 0 }}>\n                <path d=\"M16 2 L22 10 L30 16 L22 22 L16 30 L10 22 L2 16 L10 10 Z\" fill={accentColor} />\n              </svg>\n              <span style={{ fontSize: 36, fontWeight: 'bold' }}>{text}</span>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* 5. Highlight Quote */}\n      <div style={{ position: 'absolute', right: 160, bottom: 260, width: 500, transform: `scale(${quotePop})`, opacity: quotePop }}>\n        <div style={{ position: 'relative', padding: 30, border: `3px solid ${primaryColor}`, borderRadius: '30px 30px 30px 0px', backgroundColor: 'rgba(0,145,145, 0.05)' }}>\n          <div style={{ position: 'absolute', top: -30, left: -20, fontSize: 80, color: accentColor, lineHeight: 1 }}>\"</div>\n          <p style={{ fontFamily: bodyFontFamily, fontSize: 26, fontStyle: 'italic', margin: 0, lineHeight: 1.4 }}>\n            {props.quoteText}\n          </p>\n        </div>\n      </div>\n\n      {/* 6. Timeline */}\n      <div style={{ position: 'absolute', left: 120, right: 120, bottom: 80, height: 100 }}>\n        {/* Line at circle center: circles are 24px, center = 12px */}\n        {frame >= 174 && <div style={{ position: 'absolute', top: 10, left: 20, right: 20, height: 4, backgroundColor: `rgba(60,81,0, 0.2)` }} />}\n        <div style={{ position: 'absolute', top: 10, left: 20, width: `calc((100% - 40px) * ${timelineDraw})`, height: 4, backgroundColor: primaryColor }} />\n        \n        <div style={{ display: 'flex', justifyContent: 'space-between', position: 'relative', padding: '0 20px' }}>\n        {[props.timeline1, props.timeline2, props.timeline3, props.timeline4].map((val, i) => {\n          const stepDelay = timelineDelay + i * 15;\n          const sPop = safeSpring(stepDelay);\n          return (\n            <div key={i} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', transform: `scale(${sPop})` }}>\n              <div style={{ width: 24, height: 24, borderRadius: 12, backgroundColor: bgColor, border: `4px solid ${i === 3 ? accentColor : primaryColor}`, zIndex: 2 }} />\n              <div style={{ marginTop: 12, fontSize: 24, fontWeight: 'bold' }}>{val}</div>\n            </div>\n          );\n        })}\n        </div>\n      </div>\n      \n      {/* Extra Sparkles */}\n      <Sparkle left={1700} top={250} delay={chartDelay + 20} size={50} rotation={-10} />\n      <Sparkle left={900} top={150} delay={100} size={30} />\n      <Sparkle left={400} top={850} delay={nameDelay + 20} size={45} rotation={25} />\n\n    </div>\n  );\n};"
 },
