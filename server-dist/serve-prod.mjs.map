  "thumb": "/thumbnails/e0d468df-601e-4ac6-befe-9870696b4f2c.jpg",
  "code": "const FruitShoppingTips = ({item}) => {\n  // Hooks\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  // Responsive scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Safe spring helper\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  // Content - matching reference: small title line → big title → subtitle → tips\n  const titleLine1 = \"The 4 Rules for\";\n  const titleLine2 = \"\\”Melon Buying\\”\";\n  const subtitle = \"How to spot the sweetest melon\";\n  const tips = [\"Weight\", \"Aroma\", \"Softspots\", \"Stem Color\"];\n\n  // Animation timing\n  const cardSlideIn = safeSpring(0, { damping: 18 });\n  const titleFadeIn = safeSpring(10, { damping: 15 });\n\n  // Card slide from right - 45% of 1920 = 864px, add extra for smooth entry\n  const cardX = interpolate(cardSlideIn, [0, 1], [900, 0]);\n\n  // Title animation\n  const titleOpacity = interpolate(titleFadeIn, [0, 1], [0, 1]);\n  const titleY = interpolate(titleFadeIn, [0, 1], [10, 0]);\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n  };\n\n  // Card container - full height panel on right side, 45% width\n  const cardContainerStyle = {\n    position: 'absolute',\n    right: 0,\n    top: 0,\n    width: '45%',\n    height: '100%',\n    transform: `translateX(${cardX}px)`,\n  };\n\n  // Card style - full height panel with glassmorphism effect\n  const cardStyle = {\n    backgroundColor: 'rgba(255, 255, 255, 0.95)',\n    backdropFilter: 'blur(20px)',\n    width: '100%',\n    height: '100%',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    boxShadow: '-8px 0 48px rgba(0, 0, 0, 0.12)',\n  };\n\n  // Content wrapper - centered like reference\n  const contentWrapperStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    width: '100%',\n    padding: '60px',\n  };\n\n  // Title line 1 - smaller text above main title\n  const titleLine1Style = {\n    fontSize: 42,\n    fontWeight: 500,\n    color: '#1a1a1a',\n    fontFamily: 'Inter, sans-serif',\n    marginBottom: 8,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  // Title line 2 - biggest, with quotes\n  const titleLine2Style = {\n    fontSize: 72,\n    fontWeight: 800,\n    color: '#1a1a1a',\n    fontFamily: 'Inter, Montserrat, sans-serif',\n    letterSpacing: '-0.02em',\n    marginBottom: 20,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  // Subtitle - italic, smaller\n  const subtitleStyle = {\n    fontSize: 24,\n    fontWeight: 400,\n    fontStyle: 'italic',\n    color: '#666',\n    fontFamily: 'Inter, sans-serif',\n    marginBottom: 56,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  // Tips list - vertical stack, centered, generous spacing\n  const listStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    gap: 28,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardContainerStyle}>\n        <div style={cardStyle}>\n          <div style={contentWrapperStyle}>\n            {/* Title line 1 - smaller */}\n            <div style={titleLine1Style}>{titleLine1}</div>\n\n            {/* Title line 2 - biggest with quotes */}\n            <div style={titleLine2Style}>{titleLine2}</div>\n\n            {/* Subtitle - italic */}\n            <div style={subtitleStyle}>{subtitle}</div>\n\n            {/* Tips list - text with macaron colored underlines */}\n            <div style={listStyle}>\n              {tips.map((tip, index) => {\n                // Macaron pastel colors - deeper for white background\n                const macaronColors = [\n                  'rgba(0,202,178, 0.55)',  // Rose pink\n                  'rgba(132,222,152, 0.55)',  // Warm peach\n                  'rgba(219,179,53, 0.55)',  // Fresh mint\n                  'rgba(69,187,247, 0.55)',  // Clear sky\n                ];\n\n                const tipDelay = 20 + index * 12;\n                const tipSpring = safeSpring(tipDelay, { damping: 14 });\n                const tipOpacity = interpolate(tipSpring, [0, 1], [0, 1]);\n                const tipY = interpolate(tipSpring, [0, 1], [20, 0]);\n\n                // Underline animation - draws after text appears, ease-out (fast to slow)\n                const underlineDelay = tipDelay + 6;\n                const underlineProgress = interpolate(frame - underlineDelay * safeFps / 30, [0, 12], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n                const underlineScale = Easing.out(Easing.cubic)(underlineProgress);\n\n                const tipRowStyle = {\n                  display: 'flex',\n                  justifyContent: 'center',\n                  opacity: tipOpacity,\n                  transform: `translateY(${tipY}px)`,\n                };\n\n                const textWrapperStyle = {\n                  position: 'relative',\n                  display: 'inline-block',\n                  textAlign: 'center',\n                };\n\n                const tipTextStyle = {\n                  fontSize: 40,\n                  color: '#1a1a1a',\n                  fontFamily: 'Inter, sans-serif',\n                  fontWeight: 700,\n                  position: 'relative',\n                  zIndex: 1,\n                };\n\n                const highlightStyle = {\n                  position: 'absolute',\n                  bottom: 4,\n                  left: '50%',\n                  transform: `translateX(-50%) scaleX(${underlineScale})`,\n                  height: 14,\n                  width: '100%',\n                  backgroundColor: macaronColors[index % macaronColors.length],\n                  borderRadius: 4,\n                  zIndex: 0,\n                };\n\n                return (\n                  <div key={index} style={tipRowStyle}>\n                    <div style={textWrapperStyle}>\n                      <span style={tipTextStyle}>{tip}</span>\n                      <div style={highlightStyle} />\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
