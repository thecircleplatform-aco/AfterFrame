  "thumb": "/thumbnails/3554d937-05c5-4ffb-835d-aa8db1a48ace.jpg",
  "code": "const DoodleOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const tag1Text = props.tag1Text;\n  const tag2Text = props.tag2Text;\n  const listItems = [\n    props.listItem1,\n    props.listItem2,\n    props.listItem3,\n    props.listItem4,\n    props.listItem5\n  ];\n  const primaryColor = props.primaryColor;\n  const textColor = props.textColor;\n  const titleFont = props.titleFont;\n  const listFont = props.listFont;\n  const isTransparent = props.transparentBackground === true || props.transparentBackground === 'true';\n  const bgColor = props.bgColor;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay, config) => {\n    return spring({ frame: Math.max(0, frame - (delay || 0)), fps: safeFps, config: config || { damping: 14, mass: 0.8, stiffness: 120 } });\n  };\n\n  const windowX = 140;\n  const windowY = 240;\n  const windowW = 740;\n  const windowH = 680;\n  const windowRx = 40;\n\n  const titleSpring = safeSpring(5);\n  const tag1Spring = safeSpring(35);\n  const tag2Spring = safeSpring(45);\n\n  const titleOpacity = Math.min(1, Math.max(0, interpolate(titleSpring, [0, 1], [0, 1])));\n\n  const renderedListItems = listItems.map(function(text, i) {\n    const itemSpring = safeSpring(55 + i * 8);\n    const itemOpacity = Math.min(1, Math.max(0, interpolate(itemSpring, [0, 1], [0, 1])));\n    const itemY = interpolate(itemSpring, [0, 1], [40, 0]);\n    return { text: text, itemOpacity: itemOpacity, itemY: itemY, key: i };\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: 'scale(' + scale + ')',\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    overflow: 'hidden'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {!isTransparent && (\n        <svg style={{ position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, zIndex: 0 }}>\n          <defs>\n            <mask id=\"video-cutout-mask\">\n              <rect width=\"100%\" height=\"100%\" fill=\"white\" />\n              {/* Cutout is full size from frame 0 — no animation */}\n              <rect x={windowX} y={windowY} width={windowW} height={windowH} rx={windowRx} fill=\"black\" />\n            </mask>\n          </defs>\n          <rect width=\"100%\" height=\"100%\" fill={bgColor} mask=\"url(#video-cutout-mask)\" />\n        </svg>\n      )}\n\n      <div style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', zIndex: 1 }}>\n\n        {/* Title */}\n        <div style={{\n          position: 'absolute',\n          top: 90,\n          width: '100%',\n          textAlign: 'center',\n          fontSize: 100,\n          fontFamily: titleFont,\n          color: textColor,\n          transform: 'scale(' + titleSpring + ')',\n          opacity: titleOpacity,\n          fontWeight: 'bold',\n          letterSpacing: '2px'\n        }}>\n          {titleText}\n        </div>\n\n        {/* Window border — static, no animation */}\n        <div style={{\n          position: 'absolute',\n          left: windowX,\n          top: windowY,\n          width: windowW,\n          height: windowH,\n          border: '6px solid ' + primaryColor,\n          borderRadius: windowRx,\n          boxSizing: 'border-box'\n        }}>\n          <div style={{\n            position: 'absolute',\n            inset: -16,\n            border: '3px dashed ' + primaryColor,\n            borderRadius: (windowRx + 8),\n            opacity: 0.5\n          }} />\n        </div>\n\n        {/* Tag 1 */}\n        <div style={{\n          position: 'absolute',\n          left: windowX + windowW - 60,\n          top: windowY - 40,\n          transform: 'scale(' + tag1Spring + ') rotate(10deg)',\n          transformOrigin: 'center center'\n        }}>\n          <div style={{\n            backgroundColor: primaryColor,\n            color: '#FFFFFF',\n            padding: '12px 36px',\n            borderRadius: '255px 15px 225px 15px/15px 225px 15px 255px',\n            fontFamily: titleFont,\n            fontSize: 44,\n            boxShadow: '6px 6px 0px rgba(0,0,0,0.1)',\n            border: '3px solid white',\n            whiteSpace: 'nowrap'\n          }}>\n            {tag1Text}\n          </div>\n        </div>\n\n        {/* Tag 2 */}\n        <div style={{\n          position: 'absolute',\n          left: windowX - 40,\n          top: windowY + windowH - 70,\n          transform: 'scale(' + tag2Spring + ') rotate(-8deg)',\n          transformOrigin: 'center center'\n        }}>\n          <div style={{\n            backgroundColor: primaryColor,\n            color: '#FFFFFF',\n            padding: '12px 36px',\n            borderRadius: '15px 255px 15px 225px/225px 15px 255px 15px',\n            fontFamily: titleFont,\n            fontSize: 44,\n            boxShadow: '-6px 6px 0px rgba(0,0,0,0.1)',\n            border: '3px solid white',\n            whiteSpace: 'nowrap'\n          }}>\n            {tag2Text}\n          </div>\n        </div>\n\n        {/* List */}\n        <div style={{\n          position: 'absolute',\n          left: 1020,\n          top: 300,\n          width: 800,\n          display: 'flex',\n          flexDirection: 'column',\n          gap: 65\n        }}>\n          {renderedListItems.map(function(listItem) {\n            return (\n              <div key={listItem.key} style={{\n                display: 'flex',\n                alignItems: 'center',\n                transform: 'translateY(' + listItem.itemY + 'px)',\n                opacity: listItem.itemOpacity\n              }}>\n                <div style={{\n                  width: 28,\n                  height: 28,\n                  backgroundColor: primaryColor,\n                  borderRadius: '60% 40% 50% 50%/50% 50% 60% 40%',\n                  marginRight: 32,\n                  flexShrink: 0,\n                  boxShadow: '3px 3px 0px rgba(0,0,0,0.08)'\n                }} />\n                <div style={{\n                  fontSize: 50,\n                  fontFamily: listFont,\n                  color: textColor,\n                  fontWeight: 600,\n                  lineHeight: 1.2\n                }}>\n                  {listItem.text}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "ab423e37-dbc8-4e05-944a-8f0a1895332e",
  "name": "Keyword Roller",
  "category": "text-effects",
  "description": "A seamless vertical slot-machine style text overlay that cycles through a list of keywords. Features a synthetic motion blur effect during rapid vertical transitions.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "word1": "COZY",
   "word2": "CRAFTED",
   "word3": "HANDMADE",
   "word4": "CURATED",
   "word5": "WARM",
   "word6": "TIMELESS",
   "textColor": "#e9f5ff",
   "fontFamily": "Inter, sans-serif"
  },
  "propSchema": [
   {
    "key": "word1",
    "type": "text",
    "defaultValue": "COZY",
    "label": "Word 1"
   },
   {
    "key": "word2",
    "type": "text",
    "defaultValue": "CRAFTED",
    "label": "Word 2"
   },
   {
    "key": "word3",
    "type": "text",
    "defaultValue": "HANDMADE",
    "label": "Word 3"
   },
   {
    "key": "word4",
    "type": "text",
    "defaultValue": "CURATED",
    "label": "Word 4"
   },
   {
    "key": "word5",
    "type": "text",
    "defaultValue": "WARM",
    "label": "Word 5"
   },
   {
    "key": "word6",
    "type": "text",
    "defaultValue": "TIMELESS",
    "label": "Word 6"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#e9f5ff",
    "label": "Text color"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Inter, sans-serif",
    "label": "Font"
   }
  ],
  "thumb": "/thumbnails/ab423e37-dbc8-4e05-944a-8f0a1895332e.jpg",
  "code": "const VerticalScrollRoller = ({item}) => {\n  const frame = useCurrentFrame();\n  const props = item.props || {};\n\n  const words = [\n    props.word1,\n    props.word2,\n    props.word3,\n    props.word4,\n    props.word5,\n    props.word6,\n  ].filter(Boolean);\n\n  const validWords = words.length > 0 ? words : ['TONE'];\n  const fontFamily = props.fontFamily;\n  const textColor = props.textColor;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const ENTER_FRAMES = 14; // spring settle frames (longer to allow bounce)\n  const HOLD = 18;         // frames to hold at center\n  const EXIT_FRAMES = 8;   // frames to exit\n  const INTERVAL = ENTER_FRAMES + HOLD;\n\n  const slots = Array.from({length: 15}).map((_, i) => ({\n    word: validWords[i % validWords.length],\n    index: i,\n  }));\n\n  const textStyle = {\n    fontFamily,\n    fontSize: '160px',\n    fontWeight: 900,\n    color: textColor,\n    textTransform: 'uppercase',\n    margin: 0,\n    lineHeight: 1,\n    textAlign: 'center',\n    whiteSpace: 'nowrap',\n    letterSpacing: '0.02em',\n    userSelect: 'none',\n  };\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      backgroundColor: 'transparent',\n      overflow: 'hidden',\n    }}>\n      {slots.map(({word, index}) => {\n        const startTime = index * INTERVAL;\n        const enterEnd = startTime + ENTER_FRAMES;\n        const exitStart = enterEnd + HOLD;\n        const exitEnd = exitStart + EXIT_FRAMES;\n\n        if (frame < startTime || frame > exitEnd + 2) return null;\n\n        // --- compute Y position ---\n        let y = 0;\n        let phase = 'hold';\n\n        if (frame <= enterEnd) {\n          phase = 'enter';\n          // Spring: fast drop with slight overshoot then settle — damping=18 gives gentle bounce\n          const spr = spring({\n            frame: frame - startTime,\n            fps: 30,\n            from: -240,\n            to: 0,\n            config: { damping: 18, stiffness: 200, mass: 1 },\n          });\n          y = spr;\n        } else if (frame >= exitStart) {\n          phase = 'exit';\n          // Ease-in acceleration downward — no bounce on exit\n          const t = interpolate(frame, [exitStart, exitEnd], [0, 1], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'});\n          y = interpolate(Easing.in(Easing.cubic)(t), [0, 1], [0, 900]);\n        }\n\n        // --- main opacity ---\n        let mainOpacity = 1;\n        if (phase === 'enter') {\n          mainOpacity = interpolate(frame, [startTime, startTime + 4], [0.15, 1], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'});\n        } else if (phase === 'exit') {\n          mainOpacity = interpolate(frame, [exitStart, exitEnd], [1, 0], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'});\n        }\n\n        // Motion blur: speed → blur radius + scaleY stretch\n        // Enter: fast at start (blur=12px), decelerates to 0 (no blur at bounce)\n        // Exit: accelerates from 0 to fast (blur=14px at bottom)\n        let blurPx = 0;\n        let stretchY = 1;\n        if (phase === 'enter') {\n          const speed = interpolate(frame, [startTime, startTime + ENTER_FRAMES * 0.55], [1, 0], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'});\n          blurPx = speed * 12;\n          stretchY = 1 + speed * 0.25;\n        } else if (phase === 'exit') {\n          const speed = interpolate(frame, [exitStart, exitEnd], [0, 1], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'});\n          blurPx = speed * 14;\n          stretchY = 1 + speed * 0.3;\n        }\n\n        const centerY = DESIGN_HEIGHT / 2;\n\n        return (\n          <div key={index} style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', pointerEvents: 'none' }}>\n            <div style={{\n              position: 'absolute',\n              top: centerY,\n              left: 0, right: 0,\n              transform: `translateY(calc(-50% + ${y}px)) scaleY(${stretchY})`,\n              opacity: mainOpacity,\n              filter: blurPx > 0.3 ? `blur(${blurPx.toFixed(1)}px)` : 'none',\n              willChange: 'transform, filter',\n              ...textStyle,\n            }}>\n              {word}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
 },
