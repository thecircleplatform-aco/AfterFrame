  "thumb": "/thumbnails/1afea496-4002-4a6e-9a22-2e8da948f086.jpg",
  "code": "const TechTrendsSlide = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const numberText = props.numberText;\n  const primaryText = props.primaryText;\n  const subText = props.subText;\n  const textColor = props.textColor;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const numberFont = props.numberFont;\n  const titleFont = props.titleFont;\n\n  const safeFps = fps || 30;\n  \n  // Background toggling\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'space-between',\n    padding: '0 300px'\n  };\n\n  // Animation springs\n  const titleSlide = spring({frame: Math.max(0, frame - 10), fps: safeFps, config: {damping: 16}});\n  const subSlide = spring({frame: Math.max(0, frame - 20), fps: safeFps, config: {damping: 16}});\n  const topNumScale = spring({frame: Math.max(0, frame - 5), fps: safeFps, config: {damping: 15}});\n  const botNumScale = spring({frame: Math.max(0, frame - 15), fps: safeFps, config: {damping: 15}});\n\n  // Blob floating motion\n  const blob1X = interpolate(frame, [0, 120], [1000, 950]);\n  const blob1Y = interpolate(frame, [0, 120], [300, 400]);\n  const blob2X = interpolate(frame, [0, 120], [1300, 1400]);\n  const blob2Y = interpolate(frame, [0, 120], [500, 420]);\n\n  // Split numbers to stack them\n  const halfLen = Math.ceil(numberText.length / 2);\n  const topNum = numberText.substring(0, halfLen);\n  const botNum = numberText.substring(halfLen);\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Organic Gradient Blob */}\n      <div style={{position: 'absolute', inset: 0, opacity: 0.6, pointerEvents: 'none'}}>\n        <svg width=\"100%\" height=\"100%\" style={{position: 'absolute', top: 0, left: 0}}>\n          <defs>\n            <filter id=\"blobBlur\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n              <feGaussianBlur stdDeviation=\"140\" />\n            </filter>\n          </defs>\n          <g filter=\"url(#blobBlur)\">\n            <circle cx={blob1X} cy={blob1Y} r=\"350\" fill={blobColor1} />\n            <circle cx={blob2X} cy={blob2Y} r=\"400\" fill={blobColor2} />\n          </g>\n        </svg>\n      </div>\n\n      {/* Left Content: Title & Subtitle */}\n      <div style={{\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 16,\n        zIndex: 10,\n        marginTop: -50\n      }}>\n        <div style={{\n          fontFamily: titleFont,\n          fontSize: 56,\n          letterSpacing: '5px',\n          fontWeight: 400,\n          color: textColor,\n          opacity: titleSlide,\n          transform: `translateX(${interpolate(titleSlide, [0, 1], [-40, 0])}px)`\n        }}>\n          {primaryText}\n        </div>\n        <div style={{\n          fontFamily: titleFont,\n          fontSize: 20,\n          lineHeight: 1.4,\n          color: textColor,\n          maxWidth: 320,\n          whiteSpace: 'pre-wrap',\n          opacity: subSlide * 0.7,\n          transform: `translateX(${interpolate(subSlide, [0, 1], [-40, 0])}px)`\n        }}>\n          {subText}\n        </div>\n      </div>\n\n      {/* Right Content: Pixel Numbers */}\n      <div style={{\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        zIndex: 10\n      }}>\n        <div style={{\n          fontFamily: numberFont,\n          fontSize: 220,\n          lineHeight: 0.85,\n          color: textColor,\n          fontWeight: 700,\n          opacity: topNumScale,\n          transform: `translateY(${interpolate(topNumScale, [0, 1], [60, 0])}px) scale(${interpolate(topNumScale, [0, 1], [0.8, 1])})`\n        }}>\n          {topNum}\n        </div>\n        <div style={{\n          fontFamily: numberFont,\n          fontSize: 220,\n          lineHeight: 0.85,\n          color: textColor,\n          fontWeight: 700,\n          opacity: botNumScale,\n          transform: `translateY(${interpolate(botNumScale, [0, 1], [60, 0])}px) scale(${interpolate(botNumScale, [0, 1], [0.8, 1])})`\n        }}>\n          {botNum}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
