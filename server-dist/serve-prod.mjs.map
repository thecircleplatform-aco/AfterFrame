  "thumb": "/thumbnails/0280ff3f-b1af-498b-9069-b849929f8df9.jpg",
  "code": "const SmartTitles = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  \n  const props = item.props || {};\n  const nameText = props.nameText || 'DIANA MERCER';\n  const subtitleText = props.subtitleText || 'Head of Home Decor';\n  const cardColor = props.cardColor || '#eff3ff';\n  const nameColor = props.nameColor || '#010109';\n  const subtitleColor = props.subtitleColor || '#404450';\n  const borderColor = props.borderColor || '#010109';\n  const fontFamily = props.fontFamily || '\"Press Start 2P\", monospace';\n  \n  const DESIGN_WIDTH = 760;\n  const DESIGN_HEIGHT = 160;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const entrance = safeSpring(0, { damping: 14, stiffness: 80 });\n  const yOffset = interpolate(entrance, [0, 1], [DESIGN_HEIGHT, 0]);\n\n  const globalFadeOut = interpolate(frame, [durationInFrames - 15, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    opacity: globalFadeOut,\n    fontFamily: fontFamily\n  };\n\n  const cardWidth = 620;\n  const cardHeight = 140;\n  const startX = 20;\n  const startY = 4;\n\n  const getCardStyle = (offsetX, offsetY) => ({\n    position: 'absolute',\n    left: startX + offsetX,\n    top: startY + offsetY + yOffset,\n    width: cardWidth,\n    height: cardHeight,\n    backgroundColor: cardColor,\n    border: `2px solid ${borderColor}`,\n    boxSizing: 'border-box'\n  });\n\n  const nameStartFrame = 12;\n  const nameEndFrame = 36;\n  const charsToShow = Math.floor(interpolate(frame, [nameStartFrame, nameEndFrame], [0, nameText.length], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }));\n  const visibleName = nameText.slice(0, charsToShow);\n  const invisibleName = nameText.slice(charsToShow);\n\n  const subtitleFade = interpolate(frame, [nameEndFrame, nameEndFrame + 15], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  return (\n    <div style={rootStyle}>\n      <div style={getCardStyle(12, 12)} />\n      <div style={getCardStyle(6, 6)} />\n      <div style={getCardStyle(0, 0)}>\n        <div style={{\n          position: 'absolute',\n          top: '35px',\n          width: '100%',\n          textAlign: 'center',\n          color: nameColor,\n          fontSize: '22px',\n          lineHeight: '1.2',\n          whiteSpace: 'pre',\n          textTransform: 'uppercase'\n        }}>\n          <span>{visibleName}</span>\n          <span style={{opacity: 0}}>{invisibleName}</span>\n        </div>\n        <div style={{\n          position: 'absolute',\n          top: '85px',\n          left: '40px',\n          color: subtitleColor,\n          fontSize: '10px',\n          opacity: subtitleFade,\n          letterSpacing: '1px'\n        }}>\n          {subtitleText}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "62cceb8b-a33f-45b0-a5ff-2a2be3fe2107",
  "name": "Skewed Chapter Label",
  "category": "title-cards",
  "description": "Skewed chapter label with bold headline, subtitle, and optional badge number for fast transitions.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "mainText": "AMERICA'S TOP PLAYLIST?",
   "subText": "STREAMING APP RANKING",
   "sphereNumber": "",
   "animSpeed": 1,
   "exitDuration": 3
  },
  "propSchema": [
   {
    "key": "mainText",
    "type": "text",
    "defaultValue": "AMERICA'S TOP PLAYLIST?",
    "label": "Main title"
   },
   {
    "key": "subText",
