   }
  ],
  "thumb": "/thumbnails/64a9ecbd-cf02-434f-8a36-f2567d061b18.jpg",
  "code": "const SphereCounter = ({ item }) => {\n    const frame = useCurrentFrame();\n    const { fps } = useVideoConfig();\n    const props = item.props || {};\n\n    const targetNumber = props.targetNumber;\n    const prefix = props.prefix;\n    const sphereCenterColor = props.sphereCenterColor;\n    const sphereEdgeColor = props.sphereEdgeColor;\n    const textColor = props.textColor;\n    const fontFamily = props.fontFamily;\n    const transparentBackground = props.transparentBackground;\n    const backgroundColor = props.backgroundColor;\n\n    const DESIGN_WIDTH = 1920;\n    const DESIGN_HEIGHT = 1080;\n    const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n    const rootStyle = {\n        position: 'absolute', top: 0, left: 0,\n        width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n        transform: `scale(${scale})`, transformOrigin: 'top left',\n        backgroundColor: transparentBackground === 'true' || transparentBackground === true ? 'transparent' : backgroundColor,\n        overflow: 'hidden',\n    };\n\n    const safeFps = fps || 30;\n\n    const scale1 = spring({ frame: Math.max(0, frame - 5), fps: safeFps, config: { damping: 14, stiffness: 80 } });\n    const scale2 = spring({ frame: Math.max(0, frame - 12), fps: safeFps, config: { damping: 14, stiffness: 80 } });\n\n    const float1 = Math.sin(frame / 25) * 30;\n    const float2 = Math.sin((frame + 40) / 20) * 20;\n\n    const NUMBER_DELAY = 40;\n    const numberOpacity = interpolate(frame, [NUMBER_DELAY, NUMBER_DELAY + 10], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n    const characters = String(targetNumber).split('');\n    const digitHeight = 300;\n    const fadeZone = 0.35;\n\n    const sequences = React.useMemo(() => {\n        return characters.map((char, index) => {\n            if (!/[0-9]/.test(char)) return null;\n            const targetDigitInt = parseInt(char, 10);\n            const cycles = 2 + Math.floor(index / 2);\n            const seq = [];\n            for (let i = 0; i < cycles; i++) {\n                for (let j = 0; j < 10; j++) seq.push(j);\n            }\n            for (let j = 0; j <= targetDigitInt; j++) seq.push(j);\n            return seq;\n        });\n    }, [targetNumber]);\n\n    const fadePercent = Math.round(fadeZone * 100);\n    const digitMask = `linear-gradient(to bottom, transparent 0%, black ${fadePercent}%, black ${100 - fadePercent}%, transparent 100%)`;\n\n    return (\n        <div style={rootStyle}>\n            <div style={{\n                position: 'absolute', bottom: '15%', left: '22%',\n                width: 450, height: 450, borderRadius: '50%',\n                background: `radial-gradient(circle at 35% 35%, ${sphereCenterColor}, ${sphereEdgeColor})`,\n                boxShadow: `0 30px 60px rgba(0,0,0,0.7), inset -20px -20px 50px rgba(0,0,0,0.6)`,\n                transform: `translateY(${float1}px) scale(${scale1})`,\n                transformOrigin: 'center center'\n            }} />\n\n            <div style={{\n                position: 'absolute', top: '18%', right: '28%',\n                width: 200, height: 200, borderRadius: '50%',\n                background: `radial-gradient(circle at 35% 35%, ${sphereCenterColor}, ${sphereEdgeColor})`,\n                boxShadow: `0 20px 40px rgba(0,0,0,0.6), inset -10px -10px 30px rgba(0,0,0,0.5)`,\n                transform: `translateY(${float2}px) scale(${scale2})`,\n                transformOrigin: 'center center'\n            }} />\n\n            <div style={{\n                position: 'absolute', top: 0, left: 0, right: 0, bottom: 0,\n                display: 'flex', flexDirection: 'row',\n                alignItems: 'center', justifyContent: 'center',\n                zIndex: 10, opacity: numberOpacity,\n            }}>\n                {prefix && (\n                    <div style={{\n                        height: digitHeight,\n                        lineHeight: `${digitHeight}px`,\n                        fontSize: 280, fontWeight: 700,\n                        color: textColor, fontFamily,\n                        marginRight: 25,\n                        textShadow: '0 15px 40px rgba(0,0,0,0.6)'\n                    }}>\n                        {prefix}\n                    </div>\n                )}\n\n                {characters.map((char, i) => {\n                    const seq = sequences[i];\n                    if (seq) {\n                        const totalItems = seq.length;\n                        const delay = NUMBER_DELAY + i * 6;\n                        const progress = spring({\n                            frame: Math.max(0, frame - delay),\n                            fps: safeFps,\n                            config: { damping: 18, stiffness: 70, mass: 1.2 }\n                        });\n                        const translateY = progress * -(totalItems - 1) * digitHeight;\n\n                        return (\n                            <div key={`${i}-${char}`} style={{\n                                height: digitHeight,\n                                overflow: 'hidden',\n                                position: 'relative',\n                                width: 'auto',\n                                WebkitMaskImage: digitMask,\n                                maskImage: digitMask,\n                            }}>\n                                <div style={{ display: 'flex', flexDirection: 'column', transform: `translateY(${translateY}px)` }}>\n                                    {seq.map((num, idx) => (\n                                        <div key={idx} style={{\n                                            height: digitHeight,\n                                            lineHeight: `${digitHeight}px`,\n                                            fontSize: 280, fontWeight: 700,\n                                            color: textColor, fontFamily,\n                                            textAlign: 'center',\n                                            textShadow: '0 15px 40px rgba(0,0,0,0.6)'\n                                        }}>\n                                            {num}\n                                        </div>\n                                    ))}\n                                </div>\n                            </div>\n                        );\n                    }\n\n                    return (\n                        <div key={`${i}-${char}`} style={{\n                            height: digitHeight,\n                            lineHeight: `${digitHeight}px`,\n                            fontSize: 280, fontWeight: 700,\n                            color: textColor, fontFamily,\n                            textShadow: '0 15px 40px rgba(0,0,0,0.6)'\n                        }}>\n                            {char}\n                        </div>\n                    );\n                })}\n            </div>\n        </div>\n    );\n};"
 },
 {
  "id": "61b838f2-a46c-4118-91e4-1c2d61e5b184",
  "name": "MindSpace — Quote Card",
  "category": "uncategorized",
  "description": "A vibrant blue-purple gradient quote card that pops in smoothly without bouncing, featuring large stylish oversized quote marks on the corners.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "quoteText": "You don't have to plan every mile. You just have to leave room for the detour.",
   "quoteColor": "#ffffff",
   "textColor": "#ffffff",
   "fontFamily": "DM Sans",
   "transparentBackground": true
  },
  "propSchema": [
   {
    "key": "quoteText",
    "type": "text",
