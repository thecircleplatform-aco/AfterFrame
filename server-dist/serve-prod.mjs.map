  "thumb": "/thumbnails/dbbdb754-7b3f-49c9-afd6-c4fea2afeec3.jpg",
  "code": "const LowerThird = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const nameText = props.nameText;\n  const roleText = props.roleText;\n  const panelColor = props.panelColor;\n  const textColor = props.textColor;\n  const borderColor = props.borderColor;\n  const fontFamily = props.fontFamily;\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const intro = safeSpring(0);\n  const introVal = interpolate(intro, [0, 1], [0, 1]);\n  const introY = interpolate(intro, [0, 1], [30, 0]);\n\n  const fadeOutStart = Math.max(0, durationInFrames - 20);\n  const outroVal = interpolate(frame, [fadeOutStart, durationInFrames - 1], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const yOffset = introY + interpolate(outroVal, [0, 1], [0, 30]);\n  const opacity = introVal - outroVal;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: 'transparent',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  const ltPanelBg = panelColor || '#F3EBE1';\n\n  const panelStyle = {\n    position: 'relative',\n    width: 600,\n    height: 120,\n    backgroundColor: ltPanelBg,\n    backgroundImage: `radial-gradient(circle, rgba(0,0,0,0) 40%, rgba(58,43,25,0.08) 100%)`,\n    opacity,\n    transform: `translateY(${yOffset}px)`,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    boxShadow: '4px 4px 15px rgba(0,0,0,0.25)',\n    fontFamily: fontFamily,\n    color: textColor,\n    boxSizing: 'border-box',\n    padding: '20px',\n  };\n\n  const CornerFlourishLT = ({ style, item }) => (\n    <div style={{ position: 'absolute', width: 18, height: 18, overflow: 'hidden', ...style }}>\n      <svg viewBox=\"0 0 150 150\" width=\"18\" height=\"18\">\n        <g stroke={borderColor} fill=\"none\" strokeWidth=\"2.5\" strokeLinecap=\"round\">\n          <path d=\"M 0,150 C 0,50 50,0 150,0\" />\n          <path d=\"M 15,150 C 15,70 70,15 150,15\" />\n          <path d=\"M 30,150 C 30,90 70,50 110,40 C 130,35 140,45 130,60 C 115,80 90,60 95,45 C 100,35 110,35 115,45\" />\n          <path d=\"M 150,30 C 90,30 50,70 40,110 C 35,130 45,140 60,130 C 80,115 60,90 45,95 C 35,100 35,110 45,115\" />\n          <circle cx=\"20\" cy=\"20\" r=\"4\" fill={borderColor} />\n          <path d=\"M 0,0 L 25,0 C 25,25 0,25 0,25 Z\" fill={borderColor} stroke=\"none\" />\n        </g>\n      </svg>\n    </div>\n  );\n\n  return (\n    <div style={rootStyle}>\n      <div style={panelStyle}>\n        {/* Outer + Inner border */}\n        <svg style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }}>\n          <rect x=\"6\" y=\"6\" width=\"588\" height=\"108\" fill=\"none\" stroke={borderColor} strokeWidth=\"1\" />\n          <rect x=\"10\" y=\"10\" width=\"580\" height=\"100\" fill=\"none\" stroke={borderColor} strokeWidth=\"0.5\" />\n        </svg>\n        {/* Corner flourishes */}\n        <CornerFlourishLT style={{ top: 10, left: 10 }} />\n        <CornerFlourishLT style={{ top: 10, right: 10, transform: 'scaleX(-1)' }} />\n        <CornerFlourishLT style={{ bottom: 10, left: 10, transform: 'scaleY(-1)' }} />\n        <CornerFlourishLT style={{ bottom: 10, right: 10, transform: 'scale(-1, -1)' }} />\n\n        <div style={{\n          fontSize: '36px',\n          fontWeight: 600,\n          letterSpacing: '1px',\n          margin: 0,\n          zIndex: 1,\n          lineHeight: 1.2\n        }}>\n          {nameText}\n        </div>\n        \n        {/* Divider */}\n        <div style={{\n          width: '60%',\n          height: '1px',\n          backgroundColor: borderColor,\n          margin: '6px 0',\n          zIndex: 1\n        }} />\n\n        <div style={{\n          fontSize: '22px',\n          fontStyle: 'italic',\n          letterSpacing: '0.5px',\n          margin: 0,\n          zIndex: 1,\n        }}>\n          {roleText}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
