  "thumb": "/thumbnails/924f80bf-9391-405e-8307-7a9bd628e208.jpg",
  "code": "const AnimatedMenu = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const props = item.props || {};\n  const text1 = props.text1;\n  const text2 = props.text2;\n  const text3 = props.text3;\n  const iconColor = props.iconColor;\n  const textColor = props.textColor;\n  const bgColor = props.bgColor;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1000;\n  const DESIGN_HEIGHT = 500;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    paddingLeft: 80,\n    overflow: 'hidden'\n  };\n\n  const renderWord = (word, wordDelay) => {\n    const wordMovement = spring({ frame: Math.max(0, frame - wordDelay), fps: safeFps, config: { damping: 28, stiffness: 160 } });\n    const wordX = interpolate(wordMovement, [0, 1], [30, 0]);\n    const wordOpacity = interpolate(frame, [wordDelay, wordDelay + 6], [0, 1], {\n      extrapolateRight: 'clamp',\n      extrapolateLeft: 'clamp'\n    });\n    return (\n      <span key={word + wordDelay} style={{\n        display: 'inline-block',\n        transform: `translateX(${wordX}px)`,\n        opacity: wordOpacity,\n        marginRight: 16\n      }}>\n        {word}\n      </span>\n    );\n  };\n\n  const renderRow = (text, rowIndex) => {\n    const rowDelay = rowIndex * 15;\n    const iconDelay = rowDelay;\n    const words = text.split(' ');\n\n    const iconScale = spring({ frame: Math.max(0, frame - iconDelay), fps: safeFps, config: { damping: 28, stiffness: 180 } });\n    const iconOpacity = interpolate(frame, [iconDelay, iconDelay + 5], [0, 1], {\n      extrapolateRight: 'clamp',\n      extrapolateLeft: 'clamp'\n    });\n\n    return (\n      <div key={rowIndex} style={{\n        display: 'flex',\n        alignItems: 'center',\n        marginBottom: rowIndex === 2 ? 0 : 50\n      }}>\n        <div style={{\n          width: 50,\n          height: 60,\n          display: 'flex',\n          justifyContent: 'center',\n          alignItems: 'center',\n          transform: `scale(${iconScale})`,\n          opacity: iconOpacity,\n          flexShrink: 0\n        }}>\n          <svg width=\"36\" height=\"42\" viewBox=\"0 0 36 42\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <polygon points=\"0,0 36,21 0,42\" fill={iconColor} />\n          </svg>\n        </div>\n        <div style={{\n          marginLeft: 30,\n          fontFamily,\n          fontSize: 84,\n          fontWeight: 700,\n          letterSpacing: '-0.03em',\n          color: textColor,\n          display: 'flex',\n          alignItems: 'center',\n          whiteSpace: 'nowrap'\n        }}>\n          {words.map((word, wi) => renderWord(word, rowDelay + 6 + wi * 6))}\n        </div>\n      </div>\n    );\n  };\n\n  return (\n    <div style={rootStyle}>\n      {renderRow(text1, 0)}\n      {renderRow(text2, 1)}\n      {renderRow(text3, 2)}\n    </div>\n  );\n};"
 },
