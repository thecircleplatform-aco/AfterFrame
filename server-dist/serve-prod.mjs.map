  "thumb": "/thumbnails/fb80f5e4-170e-4cd0-a9da-e59829d9e8d5.jpg",
  "code": "const Y2KBulletOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const fontFamily = props.fontFamily;\n  const text1 = props.text1;\n  const text2 = props.text2;\n  const text3 = props.text3;\n  const text4 = props.text4;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    overflow: 'hidden'\n  };\n\n  const ChefHat = (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2A1B5E\" strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z\"/>\n      <line x1=\"6\" y1=\"17\" x2=\"18\" y2=\"17\"/>\n    </svg>\n  );\n\n  const Leaf = (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2A1B5E\" strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"/>\n      <path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"/>\n    </svg>\n  );\n\n  const Flame = (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2A1B5E\" strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/>\n    </svg>\n  );\n\n  const Jar = (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2A1B5E\" strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M10 2v3\"/><path d=\"M14 2v3\"/><path d=\"M7 5h10a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z\"/>\n    </svg>\n  );\n\n  const cardsData = [\n    { x: 99, y: 179, text: text1, icon: ChefHat },\n    { x: 402, y: 417, text: text2, icon: Leaf },\n    { x: 99, y: 662, text: text3, icon: Flame },\n    { x: 402, y: 907, text: text4, icon: Jar },\n  ];\n\n  const cardsElements = cardsData.map((card, i) => {\n    const enterStart = 20 + i * 25;\n    const exitStart = 155;\n\n    const enterProgress = interpolate(frame, [enterStart, enterStart + 14], [0, 1], {\n      extrapolateRight: 'clamp',\n      extrapolateLeft: 'clamp',\n      easing: Easing.out(Easing.cubic)\n    });\n\n    const exitProgress = interpolate(frame, [exitStart, exitStart + 14], [0, 1], {\n      extrapolateRight: 'clamp',\n      extrapolateLeft: 'clamp',\n      easing: Easing.in(Easing.cubic)\n    });\n\n    const overallProgress = Math.max(0, enterProgress - exitProgress);\n    const slideX = interpolate(overallProgress, [0, 1], [-50, 0]);\n\n    const textEnterStart = enterStart + 6;\n    const textEnterProgress = interpolate(frame, [textEnterStart, textEnterStart + 14], [0, 1], {\n      extrapolateRight: 'clamp',\n      extrapolateLeft: 'clamp',\n      easing: Easing.out(Easing.cubic)\n    });\n    const textOverallProgress = Math.max(0, textEnterProgress - exitProgress);\n    const textSlideX = interpolate(textOverallProgress, [0, 1], [-15, 0]);\n\n    if (overallProgress <= 0 && frame < enterStart) return null;\n\n    const cardStyle = {\n      position: 'absolute',\n      left: card.x + slideX,\n      top: card.y - 80,\n      width: 735,\n      height: 160,\n      borderRadius: 18,\n      backgroundColor: '#FFFFFF',\n      opacity: overallProgress,\n      display: 'flex',\n      alignItems: 'center',\n      padding: '0 32px',\n      boxShadow: '8px 8px 0px #2A1B5E',\n      border: '3px solid #2A1B5E',\n      boxSizing: 'border-box'\n    };\n\n    const iconCircleStyle = {\n      width: 90,\n      height: 90,\n      borderRadius: 45,\n      backgroundColor: '#FF54B0',\n      display: 'flex',\n      justifyContent: 'center',\n      alignItems: 'center',\n      border: '3px solid #2A1B5E',\n      boxShadow: '4px 4px 0px rgba(42,27,94,0.3)',\n      flexShrink: 0\n    };\n\n    const textStyle = {\n      marginLeft: 32,\n      color: '#2A1B5E',\n      fontFamily: fontFamily,\n      fontSize: 38,\n      fontWeight: 900,\n      textTransform: 'uppercase',\n      opacity: textOverallProgress,\n      transform: `translateX(${textSlideX}px)`,\n      whiteSpace: 'nowrap',\n      overflow: 'hidden',\n      textOverflow: 'ellipsis',\n      flexGrow: 1\n    };\n\n    return (\n      <div key={i} style={cardStyle}>\n        <div style={iconCircleStyle}>\n          {card.icon}\n        </div>\n        <div style={textStyle}>\n          {card.text}\n        </div>\n      </div>\n    );\n  });\n\n  const bgSvgStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0\n  };\n\n  const glowFrameStyle = {\n    position: 'absolute',\n    left: 1350,\n    top: 172,\n    width: 514,\n    height: 715,\n    borderRadius: 26,\n    border: '4px solid #21D3F0',\n    boxShadow: '0 0 25px 2px rgba(33,211,240,0.8), inset 0 0 15px 2px rgba(33,211,240,0.5)',\n    pointerEvents: 'none',\n    boxSizing: 'border-box'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={bgSvgStyle}>\n        <defs>\n          <mask id=\"hole-mask\">\n            <rect width=\"100%\" height=\"100%\" fill=\"white\" />\n            <rect x={1350} y={172} width={514} height={715} rx={26} fill=\"black\" />\n          </mask>\n        </defs>\n        {!transparentBackground && (\n          <rect width=\"100%\" height=\"100%\" fill={bgColor} mask=\"url(#hole-mask)\" />\n        )}\n      </svg>\n\n      <div style={glowFrameStyle} />\n\n      {cardsElements}\n    </div>\n  );\n};"
 },
 {
  "id": "8303fddb-dba0-474b-a1cc-58f40728482b",
  "name": "Numbered Talking Head Overlay",
  "category": "talking-head-overlays",
  "description": "Full-screen overlay that frames a talking head video on the right with a transparent cutout, while numbered bullet points snap into place on the left.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "backgroundColor": "#F4F6FB",
   "textColor": "#22304A",
   "fontFamily": "Inter, sans-serif",
   "bullet1Text": "Pick 3-4 wallet features that reflect what users actually need",
   "bullet2Text": "Ship an equal amount of polish for each feature",
   "bullet3Text": "Check your usage data in 3-6 months to see which feature performs better",
   "bullet4Text": "Adjust your roadmap based on results",
   "bullet5Text": "Stay consistent and keep iterating"
  },
  "propSchema": [
   {
    "key": "backgroundColor",
    "type": "color",
    "defaultValue": "#4f4f6a",
    "label": "Background Color"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#FFFFFF",
    "label": "Text & Outline Color"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Inter, sans-serif",
    "label": "Font Family"
   },
   {
    "key": "bullet1Text",
    "type": "text",
    "defaultValue": "Pick 3-4 wallet features that reflect what users actually need",
    "label": "Bullet 1 Text"
   },
   {
    "key": "bullet2Text",
    "type": "text",
    "defaultValue": "Ship an equal amount of polish for each feature",
    "label": "Bullet 2 Text"
   },
   {
    "key": "bullet3Text",
    "type": "text",
    "defaultValue": "Check your usage data in 3-6 months to see which feature performs better",
    "label": "Bullet 3 Text"
   },
   {
    "key": "bullet4Text",
    "type": "text",
    "defaultValue": "Adjust your roadmap based on results",
    "label": "Bullet 4 Text"
   },
   {
    "key": "bullet5Text",
    "type": "text",
    "defaultValue": "Stay consistent and keep iterating",
    "label": "Bullet 5 Text"
   }
  ],
  "thumb": "/thumbnails/8303fddb-dba0-474b-a1cc-58f40728482b.jpg",
  "code": "const TalkingHeadOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps = 30} = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.backgroundColor;\n  const textColor = props.textColor;\n  const font = props.fontFamily;\n\n  const bullets = [\n    props.bullet1Text,\n    props.bullet2Text,\n    props.bullet3Text,\n    props.bullet4Text,\n    props.bullet5Text,\n  ];\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const CUTOUT_X = 1210;\n  const CUTOUT_W = 624;\n  const CUTOUT_H = Math.round(CUTOUT_W * 4 / 3); // 3:4 → 832px\n  const CUTOUT_Y = Math.round((1080 - CUTOUT_H) / 2); // vertically centered → 124px\n\n  const LIST_LEFT = 80;\n  const CIRCLE_SIZE = 90;\n  const GAP = 28;\n  const TEXT_MAX_WIDTH = CUTOUT_X - 40 - LIST_LEFT - CIRCLE_SIZE - GAP; // 972px\n\n  const ROW_H = 130;\n  const TOTAL_LIST_H = ROW_H * 5; // 650px\n  const LIST_TOP = Math.round((DESIGN_HEIGHT - TOTAL_LIST_H) / 2) + 20; // ~235px\n\n  const BALL_TRAVEL = 350;\n  const BALL_START_OFFSET = -BALL_TRAVEL;\n\n  const BULLET_DURATION = 1.5;\n  const FIRST_BULLET_START = 0.3;\n\n  const ROLL_FRAMES = Math.round(0.5 * fps);    // 15f\n  const BOUNCE_FRAMES = Math.round(0.35 * fps); // 11f\n  const TYPE_START_F = ROLL_FRAMES + BOUNCE_FRAMES;\n  const TYPE_FRAMES = Math.round(0.8 * fps);    // 24f\n\n  // Physical rotation over the travel distance (cumulative degrees turned)\n  const TRAVEL_DEG = (BALL_TRAVEL / (Math.PI * CIRCLE_SIZE)) * 360; // ~446°\n  // The remainder after full 360° turns tells us how far off \"upright\" we'd end up\n  const remainder = TRAVEL_DEG % 360; // ~86°\n  // So we pre-rotate the ball by -remainder at the start (it looks tilted ~-86°)\n  // As it rolls exactly TRAVEL_DEG, it arrives at -remainder + TRAVEL_DEG = multiple of 360° = upright (0°)\n  const START_ROTATION = -remainder; // e.g. ~-86°  (number faces ~-86° at frame 0 of this bullet)\n\n  function getBulletState(i) {\n    const startFrame = (FIRST_BULLET_START + i * BULLET_DURATION) * fps;\n    const localFrame = frame - startFrame;\n    if (localFrame < 0) return { visible: false };\n\n    let ballOffset = 0;\n    // Default: upright (0° extra offset from multiples of 360)\n    let ballRotation = 0;\n\n    if (localFrame < ROLL_FRAMES) {\n      // Roll phase: ease-out quart\n      const t = localFrame / ROLL_FRAMES;\n      const ease = 1 - Math.pow(1 - t, 4);\n      ballOffset = BALL_START_OFFSET * (1 - ease);\n      // Rotation goes continuously from START_ROTATION → 0° as ball travels BALL_TRAVEL\n      // At t=0: START_ROTATION. At t=1: START_ROTATION + TRAVEL_DEG = 0 (mod 360 multiples)\n      ballRotation = START_ROTATION + ease * TRAVEL_DEG;\n    } else if (localFrame < TYPE_START_F) {\n      // Bounce phase: only position bounces, rotation stays at 0° (number upright)\n      const t = (localFrame - ROLL_FRAMES) / BOUNCE_FRAMES;\n      const decay = Math.exp(-5 * t);\n      ballOffset = decay * Math.sin(t * Math.PI * 2.2) * 10;\n      ballRotation = 0;\n    }\n    // After bounce: ballOffset = 0, ballRotation = 0 (upright)\n\n    let typeProgress = 0;\n    if (localFrame >= TYPE_START_F) {\n      const t = (localFrame - TYPE_START_F) / TYPE_FRAMES;\n      typeProgress = Math.min(1, 1 - Math.pow(Math.max(0, 1 - t), 2.2));\n    }\n\n    return { visible: true, ballOffset, ballRotation, typeProgress };\n  }\n\n  // Text styles shared between phantom and visible layers\n  const textStyle = {\n    width: TEXT_MAX_WIDTH,\n    fontSize: '40px',\n    lineHeight: '1.35',\n    fontWeight: '500',\n    letterSpacing: '-0.01em',\n    wordBreak: 'break-word',\n    overflowWrap: 'break-word',\n  };\n\n  return (\n    <div style={{\n      position: 'absolute',\n      top: 0, left: 0,\n      width: DESIGN_WIDTH,\n      height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      backgroundColor: 'transparent',\n      fontFamily: font,\n      overflow: 'hidden',\n    }}>\n      {/* SVG background with static cutout */}\n      <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={{ position: 'absolute', top: 0, left: 0 }}>\n        <defs>\n          <mask id=\"bgMask\">\n            <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} fill=\"white\" />\n            <rect x={CUTOUT_X} y={CUTOUT_Y} width={CUTOUT_W} height={CUTOUT_H} rx=\"28\" fill=\"black\" />\n          </mask>\n        </defs>\n        <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} fill={bgColor} mask=\"url(#bgMask)\" />\n        <rect x={CUTOUT_X} y={CUTOUT_Y} width={CUTOUT_W} height={CUTOUT_H} rx=\"28\" fill=\"none\" stroke={textColor} strokeWidth=\"5\" />\n      </svg>\n\n      {/* Bullet rows */}\n      {bullets.map((text, i) => {\n        const state = getBulletState(i);\n        if (!state.visible) return null;\n\n        const rowCenterY = LIST_TOP + i * ROW_H + ROW_H / 2;\n        const charCount = Math.floor(state.typeProgress * text.length);\n        const displayText = text.slice(0, charCount);\n        const isTyping = state.typeProgress > 0 && state.typeProgress < 1;\n        const cursorOn = isTyping && Math.floor(frame / 4) % 2 === 0;\n\n        return (\n          <div key={i} style={{\n            position: 'absolute',\n            top: rowCenterY,\n            left: LIST_LEFT,\n            transform: 'translateY(-50%)',\n            display: 'flex',\n            flexDirection: 'row',\n            alignItems: 'center',\n            gap: GAP,\n            width: CIRCLE_SIZE + GAP + TEXT_MAX_WIDTH,\n          }}>\n            {/* Ball */}\n            <div style={{\n              flexShrink: 0,\n              width: CIRCLE_SIZE,\n              height: CIRCLE_SIZE,\n              borderRadius: '50%',\n              backgroundColor: textColor,\n              color: bgColor,\n              display: 'flex',\n              alignItems: 'center',\n              justifyContent: 'center',\n              fontSize: '40px',\n              fontWeight: 'bold',\n              transform: `translateX(${state.ballOffset}px) rotate(${state.ballRotation}deg)`,\n            }}>\n              {String(i + 1)}\n            </div>\n\n            {/*\n              Text wrapper: position relative so children can stack.\n              The PHANTOM layer (visibility:hidden, full text) always occupies\n              the final height — the flex container never resizes during typing.\n              The VISIBLE layer (position:absolute, inset 0) shows the typed chars,\n              positioned on top of the phantom so it never shifts the layout.\n            */}\n            <div style={{ position: 'relative', width: TEXT_MAX_WIDTH }}>\n              {/* Phantom: full text, invisible, holds the final height */}\n              <div style={{\n                ...textStyle,\n                visibility: 'hidden',\n                userSelect: 'none',\n                pointerEvents: 'none',\n              }}>\n                {text}\n              </div>\n\n              {/* Visible typed text: absolutely positioned, no layout influence */}\n              {state.typeProgress > 0 && (\n                <div style={{\n                  ...textStyle,\n                  position: 'absolute',\n                  top: 0,\n                  left: 0,\n                  color: textColor,\n                }}>\n                  {displayText}\n                  {cursorOn && (\n                    <span style={{\n                      display: 'inline-block',\n                      width: '3px',\n                      height: '40px',\n                      backgroundColor: textColor,\n                      marginLeft: '5px',\n                      verticalAlign: 'text-bottom',\n                    }} />\n                  )}\n                </div>\n              )}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
 },
 {
