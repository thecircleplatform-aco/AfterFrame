  "thumb": "/thumbnails/9b186c75-5a70-429d-bcfb-a09805172ef9.jpg",
  "code": "const BudgetPieChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  // --- Editable Properties ---\n  const props = item.props || {};\n  const titleText = props.titleText || 'Content Budget Mix';\n  const mainFont = props.mainFont || 'Inter, sans-serif';\n  const accentFont = props.accentFont || 'Inter, sans-serif';\n  const bgColor = props.bgColor || '#E8E6F0';\n  const cardColor = props.cardColor || '#ffffff';\n  const textColor = props.textColor || '#2D3436';\n\n  // Segment Data (5 Segments)\n  const segments = [\n    {\n      label: props.seg1Label || 'Licensing',\n      value: props.seg1Value !== undefined ? Number(props.seg1Value) : 24,\n      color: props.seg1Color || '#2eeacf', // Cyan — matches 柱状图1/3, 饼状图1\n    },\n    {\n      label: props.seg2Label || 'Promotion',\n      value: props.seg2Value !== undefined ? Number(props.seg2Value) : 20,\n      color: props.seg2Color || '#009c47', // Blue — matches 柱状图1, 饼状图1\n    },\n    {\n      label: props.seg3Label || 'Tech',\n      value: props.seg3Value !== undefined ? Number(props.seg3Value) : 7,\n      color: props.seg3Color || '#d4a800', // Orange — matches 柱状图2/3, 折线图2\n    },\n    {\n      label: props.seg4Label || 'Payouts',\n      value: props.seg4Value !== undefined ? Number(props.seg4Value) : 3,\n      color: props.seg4Color || '#009dd9', // Pink-Red — matches 折线图3\n    },\n    {\n      label: props.seg5Label || 'Support',\n      value: props.seg5Value !== undefined ? Number(props.seg5Value) : 27,\n      color: props.seg5Color || '#bf5cb8', // Purple — matches 折线图2\n    },\n  ];\n\n  // --- Layout Constants ---\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // --- Helpers ---\n  const totalValue = segments.reduce((acc, seg) => acc + seg.value, 0);\n  \n  // Prepare Slice Data\n  let accumulatedAngle = 0;\n  const radius = 175;\n  const center = { x: 240, y: 240 }; // Center of SVG viewport for pie\n  const circumference = 2 * Math.PI * radius;\n\n  const sliceData = segments.map((seg) => {\n    const percent = seg.value / totalValue;\n    const angle = percent * 360;\n    const startAngle = accumulatedAngle;\n    accumulatedAngle += angle;\n    return {\n      ...seg,\n      percent,\n      angle,\n      startAngle,\n      strokeLength: circumference * percent,\n    };\n  });\n\n  // --- Animations ---\n  // Entrance spring\n  const entrance = spring({\n    frame,\n    fps,\n    config: { damping: 20, stiffness: 90 },\n  });\n\n  // Staggered KPI Text\n  const kpiOpacity = (index) =>\n    spring({\n      frame: frame - index * 5,\n      fps,\n      config: { damping: 20 },\n    });\n\n  // Pie Rotation / Draw\n  // We animate the 'progress' of the pie drawing from 0 to 1\n  const pieProgress = spring({\n    frame: frame - 10,\n    fps,\n    config: { mass: 1, damping: 25, stiffness: 80 },\n  });\n\n  // (virus rotation removed — replaced with static dot grid)\n\n  // --- Styles ---\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: bgColor,\n    fontFamily: mainFont,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    overflow: 'hidden',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  const cardStyle = {\n    position: 'relative',\n    width: 1400,\n    height: 800,\n    backgroundColor: cardColor,\n    borderRadius: 40,\n    boxShadow: '0 20px 60px rgba(0,0,0,0.08)',\n    display: 'flex',\n    flexDirection: 'column',\n    padding: '60px 80px',\n    opacity: entrance,\n    transform: `translateY(${interpolate(entrance, [0, 1], [50, 0])}px)`,\n    overflow: 'hidden',\n    zIndex: 2,\n  };\n\n  const headerStyle = {\n    display: 'flex',\n    justifyContent: 'space-between',\n    alignItems: 'flex-start',\n    marginBottom: 24,\n    zIndex: 5,\n  };\n\n  const titleStyle = {\n    fontSize: 56,\n    fontWeight: 700,\n    color: textColor,\n    margin: 0,\n    letterSpacing: '-0.02em',\n  };\n\n  const kpiContainerStyle = {\n    display: 'flex',\n    gap: 40,\n  };\n\n  const contentRowStyle = {\n    display: 'flex',\n    flex: 1,\n    alignItems: 'center',\n    justifyContent: 'center',\n    gap: 60,\n    position: 'relative',\n    zIndex: 5,\n  };\n\n  // --- Watermark Component --- dot grid, consistent with 折线图3 style\n  const DotGridWatermark = () => {\n    const cols = 6, rows = 6, spacing = 22;\n    const dots = [];\n    for (let r = 0; r < rows; r++) {\n      for (let c = 0; c < cols; c++) {\n        dots.push(<circle key={`${r}-${c}`} cx={c * spacing} cy={r * spacing} r={3} fill={textColor} />);\n      }\n    }\n    return (\n      <svg\n        width={cols * spacing}\n        height={rows * spacing}\n        viewBox={`0 0 ${cols * spacing} ${rows * spacing}`}\n        style={{\n          position: 'absolute',\n          right: 40,\n          bottom: 40,\n          opacity: 0.07,\n          zIndex: 1,\n        }}\n      >\n        {dots}\n      </svg>\n    );\n  };\n\n  // --- Triangle Icon Component ---\n  const ArrowIcon = ({ color, item }) => (\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" style={{ display: 'inline-block', marginLeft: 6, marginBottom: 2 }}>\n      <path d=\"M12 4l-8 12h16z\" fill={color} />\n    </svg>\n  );\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Watermark Pattern inside Card Context if needed, or global. Prompt says \"Virus icon watermark background light\". Put inside card for cleaner look. */}\n      \n      <div style={cardStyle}>\n        <DotGridWatermark />\n\n        {/* Header Section: Title & KPI Row */}\n        <div style={headerStyle}>\n          <div>\n            <h1 style={titleStyle}>{titleText}</h1>\n            <div style={{ fontSize: 24, color: '#888', marginTop: 10 }}>Global Streaming Q3</div>\n          </div>\n          \n          {/* KPI summary removed — info already in right-side legend */}\n        </div>\n\n        {/* Main Chart Area */}\n        <div style={contentRowStyle}>\n          {/* Pie Chart SVG */}\n          <svg width=\"480\" height=\"480\" viewBox=\"0 0 480 480\">\n            {/* Base Circle (Track) */}\n            <circle cx=\"240\" cy=\"240\" r={radius} fill=\"none\" stroke=\"#f0f0f0\" strokeWidth=\"60\" />\n            \n            {/* Animated Segments */}\n            {sliceData.map((seg, i) => {\n              // Calculate DASH ARRAY for animation\n              // We want to simulate \"drawing\" the circle. \n              // The stroke-dasharray will be [length, circumference]. \n              // The rotation places it correctly.\n              \n              // To animate drawing from 0: interpolate dasharray or use a mask.\n              // Simplest approach with stroke-dasharray: \n              // The segment length is `seg.strokeLength`. \n              // We animate the rendered length from 0 to seg.strokeLength * pieProgress.\n              \n              const currentLength = seg.strokeLength * pieProgress;\n              const gapLength = circumference - currentLength;\n\n              return (\n                <circle\n                  key={i}\n                  cx=\"240\"\n                  cy=\"240\"\n                  r={radius}\n                  fill=\"none\"\n                  stroke={seg.color}\n                  strokeWidth=\"60\"\n                  strokeDasharray={`${currentLength} ${gapLength}`}\n                  strokeDashoffset={0} // We rotate the element instead of offsetting the dash for start position\n                  transform={`rotate(${-90 + seg.startAngle} 240 240)`}\n                  style={{ opacity: pieProgress > 0.05 ? 1 : 0 }}\n                />\n              );\n            })}\n            \n            {/* Center Text/Icon inside Donut */}\n            <g opacity={Math.max(0, pieProgress - 0.2)}>\n                <text\n                    x=\"240\" y=\"228\"\n                    textAnchor=\"middle\"\n                    fill=\"#333\"\n                    fontSize=\"20\"\n                    fontWeight=\"600\"\n                    fontFamily={mainFont}\n                >\n                    TOTAL\n                </text>\n                <text\n                    x=\"240\" y=\"270\"\n                    textAnchor=\"middle\"\n                    fill=\"#333\"\n                    fontSize=\"40\"\n                    fontWeight=\"800\"\n                    fontFamily={accentFont}\n                >\n                    {totalValue}%\n                </text>\n            </g>\n          </svg>\n\n          {/* Legend / Detailed Labels */}\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 24, minWidth: 300 }}>\n            {sliceData.map((seg, i) => {\n                const labelEntrance = spring({ frame: frame - 15 - (i * 3), fps, config: { damping: 20 } });\n                return (\n                  <div \n                    key={i} \n                    style={{ \n                        display: 'flex', \n                        alignItems: 'center', \n                        gap: 15,\n                        opacity: labelEntrance,\n                        transform: `translateX(${interpolate(labelEntrance, [0, 1], [30, 0])}px)`\n                    }}\n                  >\n                    {/* Color indicator dot */}\n                    <div style={{ width: 16, height: 16, borderRadius: '50%', backgroundColor: seg.color }} />\n                    \n                    {/* Text content */}\n                    <div>\n                        <div style={{ fontSize: 18, color: '#555', fontWeight: 600 }}>{seg.label}</div>\n                        <div style={{ display: 'flex', alignItems: 'center' }}>\n                            <span style={{ fontSize: 28, fontFamily: accentFont, fontWeight: 700, color: seg.color }}>\n                                {Math.round(seg.value)}%\n                            </span>\n                            <ArrowIcon color={seg.color} />\n                        </div>\n                    </div>\n                  </div>\n                );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "5e015143-44fa-4cc4-bb04-f692e011a1ee",
  "name": "Donut Chart - Market Share",
  "category": "data-visualization",
  "description": "A clean, vibrant donut chart infographic with animated segments, a legend, and a stylized DNA helix watermark.",
  "width": 1920,
