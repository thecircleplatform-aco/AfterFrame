    "defaultValue": "Wind",
    "label": "Ring 2 Label"
   },
   {
    "key": "val3",
    "type": "number",
    "defaultValue": 58,
    "label": "Ring 3 Value %",
    "min": 0,
    "step": 1
   },
   {
    "key": "label3",
    "type": "text",
    "defaultValue": "Hydro",
    "label": "Ring 3 Label"
   },
   {
    "key": "val4",
