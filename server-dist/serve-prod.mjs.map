    "label": "Tier 3 Price"
   }
  ],
  "thumb": "/thumbnails/ec40c650-4d7d-476f-a891-fe4d722fdcca.jpg",
  "code": "const BroadcastOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const dividerColor = props.dividerColor;\n  const l1Label = props.l1Label;\n  const l1Value = props.l1Value;\n  const l2Label = props.l2Label;\n  const l2Value = props.l2Value;\n  const l3Label = props.l3Label;\n  const l3Value = props.l3Value;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const PANEL_W = 620;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const SLIDE_DUR   = 36;\n  const easeBellIn  = Easing.bezier(0.4, 0, 0.1, 1);\n  const easeBellOut = Easing.bezier(0.9, 0.1, 0.6, 1);\n  const easeTextIn  = Easing.bezier(0.16, 1, 0.3, 1);\n\n  const bgIn  = interpolate(frame, [0, SLIDE_DUR], [-PANEL_W, 0], { extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: easeBellIn });\n  const bgOut = interpolate(frame, [durationInFrames - SLIDE_DUR, durationInFrames], [0, -PANEL_W], { extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: easeBellOut });\n  const panelX = frame < durationInFrames / 2 ? bgIn : bgOut;\n\n  const TEXT_IN_START = 14, TEXT_IN_DUR = 42;\n  const textIn  = interpolate(frame, [TEXT_IN_START, TEXT_IN_START + TEXT_IN_DUR], [-PANEL_W, 0], { extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: easeTextIn });\n  const textOut = interpolate(frame, [durationInFrames - SLIDE_DUR, durationInFrames], [0, -PANEL_W], { extrapolateLeft:'clamp', extrapolateRight:'clamp', easing: easeBellOut });\n  const textX = frame < durationInFrames / 2 ? textIn : textOut;\n\n  // Dot grid — single SVG, single global drift, no per-column phase offset\n  // This eliminates the jitter caused by independent per-column translate values\n  const COL_COUNT   = 14;\n  const DOT_SPACING = 36;\n  const COL_WIDTH   = PANEL_W / COL_COUNT;\n  const DOTS_PER_COL = Math.ceil((DESIGN_HEIGHT + DOT_SPACING) / DOT_SPACING) + 2;\n  const DRIFT_SPEED = 0.20;\n\n  // Single global Y drift — all columns move in perfect unison\n  const globalDrift = (frame * DRIFT_SPEED) % DOT_SPACING;\n\n  const dotGrid = React.useMemo(() => {\n    const circles = [];\n    for (let ci = 0; ci < COL_COUNT; ci++) {\n      const baseX   = (ci + 0.5) * COL_WIDTH;\n      const dotSize = random(`ds${ci}`) * 1.6 + 1.6;\n      const opacity = random(`op${ci}`) * 0.22 + 0.18;\n      for (let di = 0; di < DOTS_PER_COL; di++) {\n        const xOff   = (random(`wx${ci}-${di}`) - 0.5) * 12;\n        const sizeVar = random(`sv${ci}-${di}`) * 0.8;\n        const opVar   = (random(`ov${ci}-${di}`) - 0.5) * 0.1;\n        circles.push({\n          key: `${ci}-${di}`,\n          cx: baseX + xOff,\n          cy: di * DOT_SPACING - DOT_SPACING,\n          r: dotSize + sizeVar,\n          opacity: Math.max(0.05, opacity + opVar),\n        });\n      }\n    }\n    return circles;\n  }, []);\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n  };\n\n  const textStyle = {\n    fontFamily: \"'Barlow Condensed', sans-serif\",\n    fontWeight: 800, fontStyle: 'italic',\n    fontSize: '72px', lineHeight: '1.05',\n    margin: 0, padding: 0,\n    display: 'flex', alignItems: 'baseline',\n    letterSpacing: '-0.5px', whiteSpace: 'nowrap',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={{\n        position: 'absolute', left: 0, top: 0,\n        width: PANEL_W, height: DESIGN_HEIGHT,\n        backgroundColor: bgColor,\n        transform: `translateX(${panelX}px)`,\n        borderRight: `3px solid ${dividerColor}`,\n        boxSizing: 'border-box',\n        overflow: 'hidden',\n        willChange: 'transform',\n      }}>\n        {/* Single SVG — one global translateY for all dots, zero jitter */}\n        <svg\n          style={{ position:'absolute', left:0, top:0, pointerEvents:'none', overflow:'visible' }}\n          width={PANEL_W} height={DESIGN_HEIGHT}\n          viewBox={`0 0 ${PANEL_W} ${DESIGN_HEIGHT}`}\n        >\n          <g transform={`translate(0, ${globalDrift})`}>\n            {dotGrid.map(d => (\n              <circle key={d.key} cx={d.cx} cy={d.cy} r={d.r} fill=\"#ffffff\" opacity={d.opacity} />\n            ))}\n          </g>\n        </svg>\n      </div>\n\n      <div style={{\n        position: 'absolute', left: 0, top: 0,\n        width: PANEL_W, height: DESIGN_HEIGHT,\n        transform: `translateX(${textX}px)`,\n        overflow: 'hidden', willChange: 'transform', pointerEvents: 'none',\n      }}>\n        <div style={{\n          position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n          display: 'flex', flexDirection: 'column', justifyContent: 'center',\n          paddingLeft: '52px', paddingRight: '40px',\n          gap: '20px', boxSizing: 'border-box',\n        }}>\n          <div style={textStyle}>\n            <span style={{color:'#000000', marginRight:'12px'}}>{l1Label}</span>\n            <span style={{color:'#ffffff'}}>{l1Value}</span>\n          </div>\n          <div style={textStyle}>\n            <span style={{color:'#000000', marginRight:'12px'}}>{l2Label}</span>\n            <span style={{color:'#ffffff'}}>{l2Value}</span>\n          </div>\n          <div style={textStyle}>\n            <span style={{color:'#000000', marginRight:'12px'}}>{l3Label}</span>\n            <span style={{color:'#ffffff'}}>{l3Value}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "99e8292a-f939-469e-82c8-3ff5334ae41b",
