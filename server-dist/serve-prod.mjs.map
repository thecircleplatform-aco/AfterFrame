  "thumb": "/thumbnails/f3fb5e13-4727-45d2-8c1d-fb963b354a1e.jpg",
  "code": "const ProjectAllocation = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const titleFont = props.titleFont;\n  const labelFont = props.labelFont;\n  const titleColor = props.titleColor;\n  const color1 = props.color1;\n  const color2 = props.color2;\n  const color3 = props.color3;\n  const blobColor = props.blobColor;\n  const backgroundColor = props.transparentBackground ? 'transparent' : props.bgColor;\n\n  // --- Easing curves ---\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n  const bellCurveLate = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return t < 0.4\n      ? 0.15 * Math.pow(t / 0.4, 2.5)\n      : 0.15 + 0.85 * (1 - Math.pow(1 - (t - 0.4) / 0.6, 2.8));\n  };\n\n  // --- Exit ---\n  const totalFrames = durationInFrames || 180;\n  const exitStart = totalFrames - 25;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / 25));\n  const exitProgress = exitRaw * exitRaw;\n  const exitOpacity = 1 - exitProgress;\n  const exitScale = 1 - exitProgress * 0.02;\n\n  // --- Blob: opacity fade in over 40 frames, scale settle ---\n  const blobFadeRaw = Math.min(1, Math.max(0, frame / 40));\n  const blobOpacity = smoothSettle(blobFadeRaw) * 0.8;\n\n  // --- Title: starts frame 5, 50 frames ---\n  const titleRaw = Math.min(1, Math.max(0, (frame - 5) / 50));\n  const titleProgress = smoothSettle(titleRaw);\n  const titleOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - 5) / 18)));\n  const titleY = (1 - titleProgress) * 50;\n\n  // --- Donut chart: bellCurveLate, staggered from frame 25 ---\n  const cx = 1250;\n  const cy = 540;\n  const r = 260;\n  const sw = 100;\n  const c = 2 * Math.PI * r;\n\n  const v1 = 0.45;\n  const v2 = 0.30;\n  const v3 = 0.25;\n\n  const l1 = v1 * c;\n  const l2 = v2 * c;\n  const l3 = v3 * c;\n\n  const chart1Raw = Math.min(1, Math.max(0, (frame - 25) / 65));\n  const chart2Raw = Math.min(1, Math.max(0, (frame - 31) / 65));\n  const chart3Raw = Math.min(1, Math.max(0, (frame - 37) / 65));\n\n  const s1 = bellCurveLate(chart1Raw);\n  const s2 = bellCurveLate(chart2Raw);\n  const s3 = bellCurveLate(chart3Raw);\n\n  // --- Labels: appear when chart segment at ~55% ---\n  const labelDelay1 = 25 + 65 * 0.55;\n  const labelDelay2 = 31 + 65 * 0.55;\n  const labelDelay3 = 37 + 65 * 0.55;\n\n  const labelAnim = (delay) => {\n    const raw = Math.min(1, Math.max(0, (frame - delay) / 20));\n    return smoothSettle(raw);\n  };\n\n  const label1Op = labelAnim(labelDelay1);\n  const label2Op = labelAnim(labelDelay2);\n  const label3Op = labelAnim(labelDelay3);\n\n  const getPos = (valStart, valMid, radiusOffset) => {\n    const angle = (valStart + valMid / 2) * 2 * Math.PI;\n    return {\n      x: cx + Math.sin(angle) * (r + radiusOffset),\n      y: cy - Math.cos(angle) * (r + radiusOffset)\n    };\n  };\n\n  const pos1 = getPos(0, v1, 140);\n  const pos2 = getPos(v1, v2, 140);\n  const pos3 = getPos(v1 + v2, v3, 140);\n\n  return (\n    <div style={{position: 'absolute', inset: 0, backgroundColor, overflow: 'hidden', opacity: exitOpacity, transform: `scale(${exitScale})`}}>\n      <div style={{position: 'absolute', inset: 0, opacity: blobOpacity}}>\n        <svg style={{position: 'absolute', width: '100%', height: '100%', pointerEvents: 'none'}}>\n          <defs>\n            <radialGradient id=\"blobGrad\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n              <stop offset=\"0%\" stopColor={blobColor} stopOpacity={1} />\n              <stop offset=\"100%\" stopColor={blobColor} stopOpacity={0} />\n            </radialGradient>\n          </defs>\n          <circle cx=\"1600\" cy=\"850\" r=\"700\" fill=\"url(#blobGrad)\" />\n        </svg>\n      </div>\n\n      <svg style={{position: 'absolute', width: '100%', height: '100%', pointerEvents: 'none'}}>\n        <g transform={`rotate(-90 ${cx} ${cy})`}>\n          <circle cx={cx} cy={cy} r={r} fill=\"none\" stroke={color1} strokeWidth={sw}\n            strokeDasharray={`${s1 * l1} ${c}`} strokeDashoffset={0} strokeLinecap=\"butt\" />\n          <circle cx={cx} cy={cy} r={r} fill=\"none\" stroke={color2} strokeWidth={sw}\n            strokeDasharray={`${s2 * l2} ${c}`} strokeDashoffset={-l1} strokeLinecap=\"butt\" />\n          <circle cx={cx} cy={cy} r={r} fill=\"none\" stroke={color3} strokeWidth={sw}\n            strokeDasharray={`${s3 * l3} ${c}`} strokeDashoffset={-(l1 + l2)} strokeLinecap=\"butt\" />\n        </g>\n      </svg>\n\n      <div style={{\n        position: 'absolute',\n        left: 150,\n        top: 380,\n        width: 700,\n        display: 'flex',\n        flexDirection: 'column',\n        opacity: titleOpacity,\n        transform: `translateY(${titleY}px)`\n      }}>\n        {titleText.split('\\\\n').map((line, i) => (\n          <h1 key={i} style={{\n            margin: 0,\n            fontFamily: titleFont,\n            fontSize: 120,\n            fontWeight: 400,\n            color: titleColor,\n            lineHeight: 1.05,\n            letterSpacing: '-0.03em',\n            textTransform: 'uppercase'\n          }}>\n            {line}\n          </h1>\n        ))}\n      </div>\n\n      <div style={{\n        position: 'absolute', left: pos1.x, top: pos1.y,\n        transform: 'translate(-50%, -50%)', opacity: label1Op,\n        fontFamily: labelFont, fontSize: 30, fontWeight: 300, color: titleColor, textAlign: 'center'\n      }}>\n        <div>Lodging</div>\n        <div style={{fontWeight: 400, marginTop: 4}}>45%</div>\n      </div>\n\n      <div style={{\n        position: 'absolute', left: pos2.x, top: pos2.y,\n        transform: 'translate(-50%, -50%)', opacity: label2Op,\n        fontFamily: labelFont, fontSize: 30, fontWeight: 300, color: titleColor, textAlign: 'center'\n      }}>\n        <div>Transit</div>\n        <div style={{fontWeight: 400, marginTop: 4}}>30%</div>\n      </div>\n\n      <div style={{\n        position: 'absolute', left: pos3.x, top: pos3.y,\n        transform: 'translate(-50%, -50%)', opacity: label3Op,\n        fontFamily: labelFont, fontSize: 30, fontWeight: 300, color: titleColor, textAlign: 'center'\n      }}>\n        <div>Dining</div>\n        <div style={{fontWeight: 400, marginTop: 4}}>25%</div>\n      </div>\n    </div>\n  );\n};"
 },
