  "code": "const NumberedListCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const row1Text = props.row1Text;\n  const row2Text = props.row2Text;\n  const row3Text = props.row3Text;\n  const badge1Color = props.badge1Color;\n  const badge2Color = props.badge2Color;\n  const badge3Color = props.badge3Color;\n  const fontFamily = props.fontFamily;\n  const textColor = props.textColor;\n  const backgroundColor = props.backgroundColor;\n  const bandColor = props.bandColor;\n  const numberColor = props.numberColor;\n  const wordDelay = props.wordDelay;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const PANEL_IN = 22;\n  const BADGE_DURATION = 14;\n  const WORD_ANIM_DURATION = 18;\n  const ROW_GAP = 6;\n\n  const rowsData = [\n    { text: row1Text || '', badgeColor: badge1Color },\n    { text: row2Text || '', badgeColor: badge2Color },\n    { text: row3Text || '', badgeColor: badge3Color }\n  ];\n\n  const rowStartFrames = [];\n  let cursor = PANEL_IN;\n  rowsData.forEach((row) => {\n    rowStartFrames.push(cursor);\n    const wordCount = row.text.split(' ').filter(Boolean).length;\n    const lastWordStart = cursor + BADGE_DURATION + (wordCount - 1) * wordDelay;\n    cursor = lastWordStart + WORD_ANIM_DURATION + ROW_GAP;\n  });\n\n  const blobs = [\n    'M62,8 C88,2 114,28 116,58 C118,92 94,118 62,112 C30,106 4,82 8,50 C12,18 36,14 62,8 Z',\n    'M52,12 C82,2 116,18 112,54 C108,90 88,116 52,112 C16,108 2,84 6,50 C10,16 22,22 52,12 Z',\n    'M68,8 C98,12 114,38 116,68 C118,98 88,114 56,116 C24,118 6,94 4,62 C2,30 38,4 68,8 Z'\n  ];\n\n  const panelY = interpolate(frame, [0, PANEL_IN], [1080, 0], {\n    easing: Easing.bezier(0.22, 1, 0.36, 1),\n    extrapolateRight: 'clamp'\n  });\n\n  // S-curve band grows slowly over 400 frames\n  const bandGrow = interpolate(frame, [PANEL_IN, PANEL_IN + 400], [1, 0], {\n    easing: Easing.bezier(0.4, 0, 0.2, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  return (\n    <div style={{ position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: `scale(${scale})`, transformOrigin: 'top left', overflow: 'hidden' }}>\n      <div style={{ width: DESIGN_WIDTH, height: DESIGN_HEIGHT, backgroundColor: backgroundColor, transform: `translateY(${panelY}px)`, position: 'relative', display: 'flex', flexDirection: 'column', justifyContent: 'center', alignItems: 'center' }}>\n\n        {/* S-curve band — same shape language as Principle card */}\n        <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', pointerEvents: 'none' }}>\n          <path\n            d=\"M -300 1100 C 200 1350, 700 580, 1200 380 C 1550 240, 1900 210, 2300 190\"\n            pathLength=\"1\"\n            stroke={bandColor}\n            strokeWidth=\"500\"\n            fill=\"none\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n            strokeDasharray=\"1\"\n            strokeDashoffset={bandGrow}\n          />\n        </svg>\n\n        <div style={{ position: 'relative', display: 'flex', flexDirection: 'column', justifyContent: 'center', alignItems: 'flex-start', width: '1200px', gap: '80px', zIndex: 1 }}>\n          {rowsData.map((row, index) => {\n            const baseFrame = rowStartFrames[index];\n            const badgeFade = interpolate(frame, [baseFrame, baseFrame + BADGE_DURATION], [0, 1], {\n              easing: Easing.bezier(0.22, 1, 0.36, 1),\n              extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n            });\n            const words = row.text.split(' ').filter(Boolean);\n            const wordsStartFrame = baseFrame + BADGE_DURATION;\n\n            return (\n              <div key={index} style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', gap: '40px', width: '100%' }}>\n                <div style={{ position: 'relative', width: '120px', height: '120px', flexShrink: 0, opacity: badgeFade }}>\n                  <svg width=\"120\" height=\"120\" viewBox=\"0 0 120 120\" style={{ position: 'absolute', top: 0, left: 0 }}>\n                    <path d={blobs[index]} fill={row.badgeColor} />\n                  </svg>\n                  <div style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', display: 'flex', justifyContent: 'center', alignItems: 'center', color: numberColor, fontSize: '52px', fontFamily: fontFamily, fontWeight: '800', lineHeight: '1' }}>\n                    {index + 1}\n                  </div>\n                </div>\n                <div style={{ flex: 1, fontSize: '72px', fontFamily: fontFamily, color: textColor, fontWeight: 'bold', lineHeight: '1.2', paddingTop: '8px' }}>\n                  {words.map((word, wIndex) => {\n                    const wordStart = wordsStartFrame + wIndex * wordDelay;\n                    const wordX = interpolate(frame, [wordStart, wordStart + WORD_ANIM_DURATION], [20, 0], {\n                      easing: Easing.bezier(0.22, 1, 0.36, 1),\n                      extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n                    });\n                    const wordOp = interpolate(frame, [wordStart, wordStart + 12], [0, 1], {\n                      extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n                    });\n                    return (\n                      <span key={wIndex} style={{ display: 'inline-block', whiteSpace: 'pre' }}>\n                        <span style={{ display: 'inline-block', transform: `translateX(${wordX}px)`, opacity: wordOp }}>{word}</span>\n                        {' '}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
