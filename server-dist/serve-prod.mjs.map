  "thumb": "/thumbnails/4109203d-775b-4a3c-8f35-7f5a53e1a7b6.jpg",
  "code": "const Component = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n\n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const textColor = props.textColor;\n  const badgeBgColor = props.badgeBgColor;\n  const sansFont = props.sansFont;\n  const scriptFont = props.scriptFont;\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  // Animations\n  const fadeOut = interpolate(frame, [durationInFrames - 15, durationInFrames - 1], [1, 0], {extrapolateRight: 'clamp'});\n  \n  const bgSwooshLen = 4000;\n  const bgSwooshOffset = interpolate(frame, [0, 90], [bgSwooshLen, 0], {extrapolateRight: 'clamp'});\n  \n  const titleScale = safeSpring(10);\n  const titleOpacity = interpolate(frame, [10, 20], [0, 1], {extrapolateRight: 'clamp'});\n\n  const badgeScale = safeSpring(20);\n  const asteriskRot = interpolate(frame, [25, 60], [-180, 0], {extrapolateRight: 'clamp'});\n\n  const sidePanelOp = interpolate(frame, [35, 50], [0, 1], {extrapolateRight: 'clamp'});\n  const sidePanelY = interpolate(frame, [35, 50], [40, 0], {extrapolateRight: 'clamp'});\n\n  const chartAnim = safeSpring(45);\n  const timelineAnim = safeSpring(50);\n\n  // Layout Data\n  const bullets = [props.bullet1, props.bullet2, props.bullet3];\n  const chartData = [\n    { label: props.chartLabel1, val: props.chartVal1 },\n    { label: props.chartLabel2, val: props.chartVal2 },\n    { label: props.chartLabel3, val: props.chartVal3 }\n  ];\n  const timelineNodes = [props.timeline1, props.timeline2, props.timeline3, props.timeline4];\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: bgColor,\n    color: textColor,\n    fontFamily: sansFont,\n    overflow: 'hidden',\n    opacity: fadeOut,\n    display: 'flex'\n  };\n\n  const svgStyle = {\n    position: 'absolute',\n    inset: 0,\n    width: '100%',\n    height: '100%',\n    pointerEvents: 'none'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Decorative SVG Lines Behind */}\n      <svg style={svgStyle} viewBox=\"0 0 1920 1080\">\n        <path \n          d=\"M 100,800 C 400,200 800,1000 1300,400 C 1600,100 1700,600 1900,900\" \n          stroke={textColor} \n          strokeWidth=\"3\" \n          fill=\"none\" \n          strokeDasharray={bgSwooshLen} \n          strokeDashoffset={bgSwooshOffset} \n        />\n        <path \n          d=\"M 200,200 C 500,600 900,100 1400,700 C 1700,1000 1800,300 2000,500\" \n          stroke={textColor} \n          strokeWidth=\"1.5\" \n          fill=\"none\" \n          strokeDasharray={bgSwooshLen} \n          strokeDashoffset={bgSwooshOffset + 200} \n        />\n      </svg>\n\n      {/* 1. Chapter Title */}\n      <div style={{\n        position: 'absolute',\n        left: 460,\n        top: 240,\n        width: 1000,\n        height: 600,\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        justifyContent: 'center',\n        transform: `scale(${titleScale})`,\n        opacity: titleOpacity\n      }}>\n        <div style={{display: 'flex', alignItems: 'center', lineHeight: 0.8, marginBottom: 20}}>\n          <span style={{fontFamily: scriptFont, fontSize: 360, margin: '0 -10px', transform: 'rotate(-5deg) translateY(-20px)'}}>{props.titleW1S}</span>\n          <span style={{fontSize: 280, fontWeight: '900', letterSpacing: '-0.04em', textTransform: 'uppercase'}}>{props.titleW1}</span>\n        </div>\n        <div style={{display: 'flex', alignItems: 'center', lineHeight: 0.8, marginBottom: 20}}>\n          <span style={{fontSize: 280, fontWeight: '900', letterSpacing: '-0.04em', textTransform: 'uppercase'}}>{props.titleW2}</span>\n          <span style={{fontFamily: scriptFont, fontSize: 360, margin: '0 -20px 0 -10px', transform: 'rotate(8deg) translateY(-10px)'}}>{props.titleW2S}</span>\n          <span style={{fontSize: 280, fontWeight: '900', letterSpacing: '-0.04em', textTransform: 'uppercase'}}>{props.titleW2_2}</span>\n        </div>\n        <div style={{display: 'flex', alignItems: 'center', lineHeight: 0.8}}>\n          <span style={{fontFamily: scriptFont, fontSize: 360, margin: '0 -10px 0 -40px', transform: 'rotate(-10deg)'}}>{props.titleW3S1}</span>\n          <span style={{fontSize: 280, fontWeight: '900', letterSpacing: '-0.04em', textTransform: 'uppercase'}}>{props.titleW3}</span>\n          <span style={{fontFamily: scriptFont, fontSize: 360, margin: '0 -40px 0 -10px', transform: 'rotate(5deg)'}}>{props.titleW3S2}</span>\n        </div>\n      </div>\n\n      {/* 3. Name Tag */}\n      <div style={{\n        position: 'absolute',\n        top: 60,\n        left: 60,\n        padding: '16px 48px',\n        backgroundColor: badgeBgColor,\n        border: `3px solid ${textColor}`,\n        borderRadius: 50,\n        fontSize: 24,\n        fontWeight: 'bold',\n        textTransform: 'uppercase',\n        transform: `scale(${badgeScale})`\n      }}>\n        {props.badgeText}\n      </div>\n\n      {/* Decorative Asterisk */}\n      <div style={{\n        position: 'absolute',\n        top: 60,\n        right: 60,\n        width: 72,\n        height: 72,\n        backgroundColor: badgeBgColor,\n        border: `3px solid ${textColor}`,\n        borderRadius: '50%',\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'center',\n        fontSize: 48,\n        transform: `scale(${badgeScale})`\n      }}>\n        <span style={{transform: `rotate(${asteriskRot}deg)`, display: 'block', marginTop: 12}}>*</span>\n      </div>\n\n      {/* 4. Bullet Points (Bottom Left) */}\n      <div style={{\n        position: 'absolute',\n        bottom: 80,\n        left: 60,\n        width: 340,\n        opacity: sidePanelOp,\n        transform: `translateY(${sidePanelY}px)`\n      }}>\n        <div style={{fontSize: 18, fontWeight: '900', textTransform: 'uppercase', marginBottom: 16, borderBottom: `2px solid ${textColor}`, paddingBottom: 8}}>Core Traits</div>\n        <ul style={{listStyle: 'none', padding: 0, margin: 0, fontSize: 22, fontWeight: 'bold', lineHeight: 1.4}}>\n          {bullets.map((b, i) => (\n            <li key={i} style={{marginBottom: 12, display: 'flex', alignItems: 'flex-start'}}>\n              <span style={{marginRight: 12}}>•</span>\n              <span>{b}</span>\n            </li>\n          ))}\n        </ul>\n      </div>\n\n      {/* 5. Highlight Quote (Bottom Right) */}\n      <div style={{\n        position: 'absolute',\n        bottom: 80,\n        right: 60,\n        width: 380,\n        opacity: sidePanelOp,\n        transform: `translateY(${sidePanelY}px)`\n      }}>\n        <div style={{fontFamily: scriptFont, fontSize: 56, lineHeight: 1.1, textAlign: 'right'}}>\n          \"{props.quoteText}\"\n        </div>\n      </div>\n\n      {/* 2. Data Chart (Top Right / Mid) */}\n      <div style={{\n        position: 'absolute',\n        top: 380,\n        right: 60,\n        width: 340,\n        opacity: sidePanelOp,\n        transform: `translateY(${sidePanelY}px)`\n      }}>\n        <div style={{fontSize: 18, fontWeight: '900', textTransform: 'uppercase', marginBottom: 24, borderBottom: `2px solid ${textColor}`, paddingBottom: 8}}>Signals</div>\n        {chartData.map((b, i) => (\n          <div key={i} style={{marginBottom: 24}}>\n            <div style={{display: 'flex', justifyContent: 'space-between', fontSize: 20, fontWeight: 'bold', marginBottom: 8, textTransform: 'uppercase'}}>\n              <span>{b.label}</span>\n              <span>{b.val}%</span>\n            </div>\n            <div style={{height: 8, background: 'rgba(0,0,0,0.1)', borderRadius: 4, overflow: 'hidden'}}>\n              <div style={{\n                height: '100%', \n                width: `${b.val}%`, \n                background: textColor, \n                transform: `scaleX(${chartAnim})`, \n                transformOrigin: 'left'\n              }} />\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* 6. Timeline (Top Left / Mid) */}\n      <div style={{\n        position: 'absolute',\n        top: 440,\n        left: 60,\n        width: 340,\n        opacity: sidePanelOp,\n        transform: `translateY(${sidePanelY}px)`\n      }}>\n        <div style={{fontSize: 18, fontWeight: '900', textTransform: 'uppercase', marginBottom: 32, borderBottom: `2px solid ${textColor}`, paddingBottom: 8}}>Workflow</div>\n        <div style={{position: 'relative', width: '100%', height: 60}}>\n          <div style={{\n            position: 'absolute', \n            top: 7, \n            left: 0, \n            width: '100%', \n            height: 3, \n            background: textColor,\n            transform: `scaleX(${timelineAnim})`,\n            transformOrigin: 'left'\n          }} />\n          <div style={{display: 'flex', justifyContent: 'space-between', position: 'relative'}}>\n            {timelineNodes.map((node, i) => {\n              const nodeScale = safeSpring(55 + (i * 5));\n              return (\n                <div key={i} style={{display: 'flex', flexDirection: 'column', alignItems: 'center'}}>\n                  <div style={{\n                    width: 16, \n                    height: 16, \n                    borderRadius: 8, \n                    background: textColor, \n                    border: `3px solid ${bgColor}`,\n                    transform: `scale(${nodeScale})`\n                  }} />\n                  <div style={{\n                    marginTop: 16, \n                    fontSize: 16, \n                    fontWeight: 'bold', \n                    textTransform: 'uppercase',\n                    opacity: nodeScale\n                  }}>\n                    {node}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n    </div>\n  );\n};"
 },
