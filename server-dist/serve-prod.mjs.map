  "thumb": "/thumbnails/29c9bddc-0e29-4665-bc2a-bf966aeaac6b.jpg",
  "code": "const WarmWatercolor = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.transparentBackground ? 'transparent' : (props.bgColor);\n  const titleText = props.titleText;\n  const bodyText = props.bodyText;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n  const textColor = props.textColor;\n  const accentColor1 = props.accentColor1;\n  const accentColor2 = props.accentColor2;\n\n  const safeFps = fps || 30;\n  const outFrame = durationInFrames - 15;\n  \n  const globalOpacity = interpolate(frame, [outFrame, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  const titleOpacity = interpolate(frame, [10, 35], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const titleY = interpolate(frame, [10, 45], [40, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  const lineScale = spring({ frame: Math.max(0, frame - 25), fps: safeFps, config: { damping: 20 } });\n\n  const bodyOpacity = interpolate(frame, [40, 65], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const bodyY = interpolate(frame, [40, 75], [40, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  const washOpacity = interpolate(frame, [0, 90], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const washScale = interpolate(frame, [0, durationInFrames], [0.95, 1.05]);\n\n  return (\n    <div style={{\n      position: 'absolute',\n      inset: 0,\n      backgroundColor: bgColor,\n      opacity: globalOpacity,\n      display: 'flex',\n      flexDirection: 'column',\n      alignItems: 'center',\n      justifyContent: 'center',\n      overflow: 'hidden'\n    }}>\n      \n      {/* Top Left Wash Elements */}\n      <div style={{\n        position: 'absolute',\n        top: -50,\n        left: -50,\n        width: 600,\n        height: 400,\n        opacity: washOpacity,\n        transform: `scale(${washScale})`,\n        pointerEvents: 'none'\n      }}>\n        <div style={{ position: 'absolute', inset: 0, opacity: 0.15 }}>\n          <svg width=\"600\" height=\"400\" viewBox=\"0 0 600 400\" xmlns=\"http://www.w3.org/2000/svg\">\n             <g transform=\"translate(0, 0)\">\n               <path d=\"M0,0 L600,0 C500,150 350,200 250,150 C150,100 80,300 0,400 Z\" fill={accentColor1} />\n             </g>\n          </svg>\n        </div>\n        <div style={{ position: 'absolute', inset: 0, opacity: 0.12 }}>\n          <svg width=\"600\" height=\"400\" viewBox=\"0 0 600 400\" xmlns=\"http://www.w3.org/2000/svg\">\n             <g transform=\"translate(0, 0)\">\n               <path d=\"M0,0 L450,0 C380,100 250,150 150,120 C80,100 30,200 0,250 Z\" fill={accentColor2} />\n             </g>\n          </svg>\n        </div>\n      </div>\n\n      {/* Bottom Right Wash Elements */}\n      <div style={{\n        position: 'absolute',\n        bottom: -100,\n        right: -100,\n        width: 800,\n        height: 800,\n        opacity: washOpacity,\n        transform: `scale(${washScale})`,\n        pointerEvents: 'none'\n      }}>\n        <div style={{ position: 'absolute', inset: 0, opacity: 0.15 }}>\n          <svg width=\"800\" height=\"800\" viewBox=\"0 0 800 800\" xmlns=\"http://www.w3.org/2000/svg\">\n             <g transform=\"translate(0, 0)\">\n               <path d=\"M800,800 L0,800 C150,550 350,500 450,600 C550,700 700,450 800,350 Z\" fill={accentColor2} />\n             </g>\n          </svg>\n        </div>\n        <div style={{ position: 'absolute', inset: 0, opacity: 0.20 }}>\n          <svg width=\"800\" height=\"800\" viewBox=\"0 0 800 800\" xmlns=\"http://www.w3.org/2000/svg\">\n             <g transform=\"translate(0, 0)\">\n               <path d=\"M800,800 L200,800 C350,650 500,600 600,650 C700,700 750,550 800,500 Z\" fill={accentColor1} />\n             </g>\n          </svg>\n        </div>\n      </div>\n\n      {/* Main Content Container */}\n      <div style={{\n        position: 'relative',\n        zIndex: 10,\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        maxWidth: 1000,\n        textAlign: 'center',\n        padding: '0 40px'\n      }}>\n        <h1 style={{\n          margin: 0,\n          fontFamily: titleFont,\n          fontWeight: 300,\n          fontSize: 64,\n          letterSpacing: '0.22em',\n          color: textColor,\n          opacity: titleOpacity,\n          transform: `translateY(${titleY}px)`,\n          textTransform: 'uppercase',\n          lineHeight: 1.2\n        }}>\n          {titleText}\n        </h1>\n\n        <div style={{\n          width: 140,\n          height: 2,\n          backgroundColor: textColor,\n          marginTop: 45,\n          marginBottom: 45,\n          opacity: 0.4,\n          transform: `scaleX(${lineScale})`,\n          transformOrigin: 'center'\n        }} />\n\n        <p style={{\n          margin: 0,\n          fontFamily: bodyFont,\n          fontWeight: 400,\n          fontSize: 28,\n          lineHeight: 1.65,\n          color: textColor,\n          opacity: bodyOpacity,\n          transform: `translateY(${bodyY}px)`,\n          whiteSpace: 'pre-wrap'\n        }}>\n          {bodyText}\n        </p>\n      </div>\n    </div>\n  );\n}"
 },
