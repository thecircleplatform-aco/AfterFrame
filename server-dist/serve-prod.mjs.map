  "thumb": "/thumbnails/7e255237-89e4-40c7-b7f2-bc9c6acfb934.jpg",
  "code": "const MinimalGradientCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n\n  const parseHex = (hex) => {\n    if (!hex) return [0, 0, 0];\n    const h = hex.replace('#', '');\n    const r = parseInt(h.length === 3 ? h[0]+h[0] : h.substring(0,2), 16) || 0;\n    const g = parseInt(h.length === 3 ? h[1]+h[1] : h.substring(2,4), 16) || 0;\n    const b = parseInt(h.length === 3 ? h[2]+h[2] : h.substring(4,6), 16) || 0;\n    return [r, g, b];\n  };\n\n  const rgba = (r, g, b, a) => `rgba(${r},${g},${b},${a})`;\n\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n\n  // Exit (last 25 frames) — NO root opacity/transform\n  const totalFrames = durationInFrames || 150;\n  const exitStart = totalFrames - 25;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / 25));\n  const exitAlpha = 1 - exitRaw * exitRaw;\n\n  // Blob: scale settle + gentle drift\n  const blobFadeRaw = Math.min(1, Math.max(0, frame / 40));\n  const blobAlpha = smoothSettle(blobFadeRaw) * 0.8 * exitAlpha;\n  const blobScaleRaw = Math.min(1, Math.max(0, frame / 45));\n  const blobScale = 1.05 - 0.05 * smoothSettle(blobScaleRaw);\n  const blobDriftX = Math.sin(frame / 55) * 8;\n  const blobDriftY = Math.cos(frame / 75) * 6;\n\n  // Title line 1: starts frame 8, 50 frames\n  const t1Raw = Math.min(1, Math.max(0, (frame - 8) / 50));\n  const t1Progress = smoothSettle(t1Raw);\n  const t1Y = (1 - t1Progress) * 70;\n  const t1Alpha = smoothSettle(Math.min(1, Math.max(0, (frame - 8) / 18))) * exitAlpha;\n\n  // Title line 2: starts frame 22, 50 frames\n  const t2Raw = Math.min(1, Math.max(0, (frame - 22) / 50));\n  const t2Progress = smoothSettle(t2Raw);\n  const t2Y = (1 - t2Progress) * 70;\n  const t2Alpha = smoothSettle(Math.min(1, Math.max(0, (frame - 22) / 18))) * exitAlpha;\n\n  // Body: starts frame 50, 35 frames\n  const bBodyRaw = Math.min(1, Math.max(0, (frame - 50) / 35));\n  const bBodyProgress = smoothSettle(bBodyRaw);\n  const bBodyY = (1 - bBodyProgress) * 40;\n  const bBodyAlpha = smoothSettle(Math.min(1, Math.max(0, (frame - 50) / 15))) * exitAlpha;\n\n  const [txR, txG, txB] = parseHex(props.textColor);\n  const textRgba = (a) => rgba(txR, txG, txB, a);\n\n  // Blob gradient with alpha baked in\n  const blobBg = blobAlpha > 0.01\n    ? `radial-gradient(circle, ${rgba(...parseHex(props.blobColor1), blobAlpha)} 0%, ${rgba(...parseHex(props.blobColor2), blobAlpha * 0.5)} 40%, transparent 75%)`\n    : 'transparent';\n\n  return (\n    <div style={{\n      position: 'absolute',\n      inset: 0,\n      backgroundColor: bgColor,\n      overflow: 'hidden',\n      display: 'flex'\n    }}>\n      {/* Blob */}\n      <div style={{\n        position: 'absolute',\n        right: '-15%',\n        top: '-20%',\n        width: '1400px',\n        height: '1400px',\n        borderRadius: '50%',\n        background: blobBg,\n        transform: `translate(${blobDriftX}px, ${blobDriftY}px) scale(${blobScale})`,\n        transformOrigin: 'center center',\n        pointerEvents: 'none'\n      }} />\n\n      {/* Content */}\n      <div style={{\n        position: 'absolute',\n        left: '12%',\n        top: '25%',\n        width: '55%',\n        display: 'flex',\n        flexDirection: 'column',\n        gap: '10px'\n      }}>\n        <div style={{\n          fontFamily: props.titleFont,\n          fontSize: '120px',\n          fontWeight: 400,\n          color: textRgba(t1Alpha),\n          lineHeight: 1.05,\n          letterSpacing: '0.02em',\n          textTransform: 'uppercase',\n          transform: `translateY(${t1Y}px)`\n        }}>\n          {props.titleLine1}\n        </div>\n        <div style={{\n          fontFamily: props.titleFont,\n          fontSize: '120px',\n          fontWeight: 300,\n          fontStyle: 'italic',\n          color: textRgba(t2Alpha),\n          lineHeight: 1.05,\n          letterSpacing: '0.12em',\n          textTransform: 'uppercase',\n          transform: `translateY(${t2Y}px)`\n        }}>\n          {props.titleLine2}\n        </div>\n        <div style={{\n          fontFamily: props.bodyFont,\n          fontSize: '30px',\n          fontWeight: 300,\n          color: textRgba(bBodyAlpha),\n          lineHeight: 1.5,\n          marginTop: '60px',\n          transform: `translateY(${bBodyY}px)`,\n          whiteSpace: 'normal',\n          overflowWrap: 'break-word'\n        }}>\n          {props.bodyText}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "f3fb5e13-4727-45d2-8c1d-fb963b354a1e",
  "name": "Minimal Gradient — Data Chart",
  "category": "uncategorized",
  "description": "A refined minimal presentation slide featuring a sequential animated donut chart, an organic soft gradient background, and large elegant typography.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "Trip\\nBudget",
   "titleFont": "Playfair Display",
   "labelFont": "Inter",
   "titleColor": "#1a1a1a",
   "bgColor": "#fcfaf8",
   "transparentBackground": false,
   "blobColor": "#ffe9e1",
   "color1": "#98d8fe",
