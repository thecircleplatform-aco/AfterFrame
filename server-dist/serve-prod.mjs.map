    "label": "Line 2 Normal"
   },
   {
    "key": "line2TextHighlight",
    "type": "text",
    "defaultValue": "fitness",
    "label": "Line 2 Highlight"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Playfair Display",
    "label": "Font"
   },
   {
    "key": "primaryColor",
    "type": "color",
    "defaultValue": "#ffffff",
    "label": "Text Color"
   },
   {
    "key": "highlightColor",
    "type": "color",
    "defaultValue": "#9ac244",
    "label": "Highlight Color"
   },
   {
    "key": "gradientColor",
    "type": "color",
    "defaultValue": "rgba(0,0,0,0.8)",
    "label": "Gradient Color"
   },
   {
    "key": "slideDuration",
    "type": "number",
    "defaultValue": 20,
    "label": "Slide Duration"
   },
   {
    "key": "revealAt",
    "type": "number",
    "defaultValue": 12,
    "label": "Reveal At"
   },
   {
    "key": "wordDelay",
    "type": "number",
    "defaultValue": 5,
    "label": "Word Delay"
   }
  ],
  "thumb": "/thumbnails/ec5bfc1f-7826-40ad-9657-46b33ab730e6.jpg",
  "code": "const SubtitleOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2TextNormal = props.line2TextNormal;\n  const line2TextHighlight = props.line2TextHighlight;\n  const fontFamily = props.fontFamily;\n  const primaryColor = props.primaryColor;\n  const highlightColor = props.highlightColor;\n  const gradientColor = props.gradientColor;\n  const slideDuration = props.slideDuration;\n  const revealAt = Math.min(props.revealAt, slideDuration - 1);\n  const wordDelay = props.wordDelay;\n  const wordDuration = slideDuration;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const gradientProgress = interpolate(frame, [0, slideDuration], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n    easing: Easing.bezier(0.95, 0, 0.05, 1)\n  });\n  // translate3d 替代 translateY，渐变层走 GPU 合成，避免光栅化抖动\n  const gradientY = interpolate(gradientProgress, [0, 1], [200, 0]);\n  const gradientOpacity = interpolate(frame, [revealAt, slideDuration], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n    easing: Easing.out(Easing.quad)\n  });\n\n  const line1Words = (line1Text || '').split(' ');\n  const line2Words = (line2TextNormal || '').trim().split(' ').filter(Boolean);\n  const highlightWord = line2TextHighlight || '';\n  const wordInterval = Math.round(slideDuration * 0.2);\n\n  const getWordProgress = (wordIndex) => {\n    const localFrame = Math.max(0, frame - wordDelay - wordIndex * wordInterval);\n    return interpolate(localFrame, [0, wordDuration], [0, 1], {\n      extrapolateLeft: 'clamp',\n      extrapolateRight: 'clamp',\n      easing: Easing.bezier(0.22, 1, 0.36, 1)\n    });\n  };\n\n  const wordStyle = (wordIndex) => {\n    const p = getWordProgress(wordIndex);\n    const yOffset = interpolate(p, [0, 1], [22, 0]);\n    return {\n      display: 'inline-block',\n      opacity: p,\n      // translate3d 替代 translateY，强制每个词提升为独立 GPU 合成层\n      transform: `translate3d(0, ${yOffset}px, 0)`,\n      willChange: 'transform',\n      marginRight: '0.28em',\n      transformOrigin: 'bottom center'\n    };\n  };\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      // translate3d(0,0,0) 前置 scale，根容器强制 GPU 合成层\n      transform: `translate3d(0, 0, 0) scale(${scale})`,\n      transformOrigin: 'top left',\n      willChange: 'transform',\n      backgroundColor: 'transparent',\n      overflow: 'hidden'\n    }}>\n      {/* 渐变层：translate3d 替代 translateY，百分比单位保持不变 */}\n      <div style={{\n        position: 'absolute',\n        bottom: 0, left: 0,\n        width: '100%', height: '50%',\n        background: `linear-gradient(to top, ${gradientColor}, transparent)`,\n        transform: `translate3d(0, ${gradientY}%, 0)`,\n        willChange: 'transform',\n        opacity: gradientOpacity,\n        zIndex: 1\n      }} />\n      <div style={{\n        position: 'absolute',\n        bottom: '12%',\n        left: 0, right: 0,\n        fontFamily: fontFamily,\n        fontSize: '115px',\n        fontWeight: 400,\n        color: primaryColor,\n        lineHeight: 1.15,\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        gap: '8px',\n        textShadow: '0px 8px 24px rgba(0,0,0,0.4)',\n        zIndex: 10\n      }}>\n        <div style={{ display: 'flex', flexWrap: 'wrap', justifyContent: 'center', alignItems: 'baseline' }}>\n          {line1Words.map((word, i) => (\n            <span key={i} style={wordStyle(i)}>{word}</span>\n          ))}\n        </div>\n        <div style={{ display: 'flex', flexWrap: 'wrap', justifyContent: 'center', alignItems: 'baseline' }}>\n          {line2Words.map((word, i) => (\n            <span key={i} style={wordStyle(line1Words.length + i)}>{word}</span>\n          ))}\n          <span style={{ ...wordStyle(line1Words.length + line2Words.length), color: highlightColor }}>\n            {highlightWord}\n          </span>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "9be0ad20-a161-485b-854f-2695a8710123",
  "name": "Manychat-style card slide-up with text mask reveal",
