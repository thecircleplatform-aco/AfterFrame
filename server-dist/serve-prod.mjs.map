  "thumb": "/thumbnails/a8881761-23dc-4cb7-ac6e-11aa29aa6df7.jpg",
  "code": "const EditorialNameCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const firstName = props.firstName;\n  const lastName = props.lastName;\n  const role = props.role;\n  const bgColor = props.bgColor;\n  const textColor = props.textColor;\n  const lineColor = props.lineColor;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const safeFps = fps || 30;\n  const cardHeight = 380;\n\n  // ── Exit ──────────────────────────────────────────────────────────────\n  const exitDuration = 24;\n  const exitStart = durationInFrames - exitDuration;\n  const isExiting = frame >= exitStart;\n  const exitT = isExiting\n    ? interpolate(frame, [exitStart, durationInFrames - 1], [0, 1], { extrapolateRight: 'clamp' })\n    : 0;\n  const exitEased = Easing.in(Easing.cubic)(exitT);\n  const exitSlide = interpolate(exitEased, [0, 1], [0, cardHeight + 20]);\n\n  // ── Entrance: card slides up ──────────────────────────────────────────\n  const cardEnter = spring({\n    frame,\n    fps: safeFps,\n    config: { damping: 22, stiffness: 100, mass: 0.8 },\n  });\n  const cardSlideIn = interpolate(cardEnter, [0, 1], [cardHeight, 0]);\n  const cardTranslateY = isExiting ? exitSlide : cardSlideIn;\n\n  // ── Text: fade only, no translateY ────────────────────────────────────\n  const fadeIn = (delay) =>\n    interpolate(frame, [delay, delay + 10], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  const name1Op   = isExiting ? interpolate(exitEased, [0, 0.4], [1, 0]) : fadeIn(14);\n  const name2Op   = isExiting ? interpolate(exitEased, [0, 0.4], [1, 0]) : fadeIn(20);\n  const lineWidth = isExiting\n    ? interpolate(exitEased, [0, 0.6], [150, 0])\n    : interpolate(\n        spring({ frame: Math.max(0, frame - 26), fps: safeFps, config: { damping: 30, stiffness: 100, mass: 0.8 } }),\n        [0, 1], [0, 150]\n      );\n  const titleOp = isExiting ? interpolate(exitEased, [0, 0.3], [1, 0]) : fadeIn(32);\n  const ghostOp = isExiting ? interpolate(exitEased, [0, 1], [0.15, 0]) : interpolate(cardEnter, [0, 1], [0, 0.15]);\n\n  const gpuText = {\n    transform: 'translateZ(0)',\n    WebkitFontSmoothing: 'antialiased',\n    backfaceVisibility: 'hidden',\n  };\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    overflow: 'hidden',\n    fontFamily: 'serif',\n  };\n\n  const cardStyle = {\n    position: 'absolute',\n    bottom: 0, left: 0,\n    width: '100%',\n    height: cardHeight,\n    backgroundColor: bgColor,\n    transform: `translateY(${cardTranslateY}px)`,\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    padding: '0 120px',\n    boxSizing: 'border-box',\n    overflow: 'hidden',\n    willChange: 'transform',\n  };\n\n  const contentContainer = {\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    zIndex: 2,\n    width: '100%',\n  };\n\n  const nameBlock = {\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n  };\n\n  const firstNameStyle = {\n    ...gpuText,\n    fontSize: '120px',\n    fontWeight: '800',\n    lineHeight: '0.9',\n    color: textColor,\n    textTransform: 'uppercase',\n    opacity: name1Op,\n  };\n\n  const lastNameStyle = {\n    ...gpuText,\n    fontSize: '60px',\n    fontWeight: '400',\n    color: textColor,\n    marginTop: '10px',\n    letterSpacing: '2px',\n    textTransform: 'uppercase',\n    opacity: name2Op,\n  };\n\n  const separatorStyle = {\n    height: '2px',\n    backgroundColor: lineColor,\n    width: lineWidth,\n    margin: '0 50px',\n    marginTop: '40px',\n    alignSelf: 'flex-start',\n    flexShrink: 0,\n  };\n\n  const titleStyle = {\n    ...gpuText,\n    fontSize: '32px',\n    fontStyle: 'italic',\n    color: textColor,\n    opacity: titleOp,\n    marginTop: '25px',\n    alignSelf: 'flex-start',\n    whiteSpace: 'nowrap',\n  };\n\n  const ghostStyle = {\n    position: 'absolute',\n    right: '-50px',\n    bottom: '-100px',\n    width: '800px',\n    height: '800px',\n    opacity: ghostOp,\n    zIndex: 1,\n    pointerEvents: 'none',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <div style={ghostStyle}>\n          <svg viewBox=\"0 0 200 200\" width=\"100%\" height=\"100%\">\n            <path\n              fill={textColor}\n              d=\"M100,130 C130,130 150,160 160,200 L40,200 C50,160 70,130 100,130 M100,50 C125,50 140,80 130,110 C120,130 80,130 70,110 C60,80 75,50 100,50 Z\"\n            />\n          </svg>\n        </div>\n        <div style={contentContainer}>\n          <div style={nameBlock}>\n            <div style={firstNameStyle}>{firstName}</div>\n            <div style={lastNameStyle}>{lastName}</div>\n          </div>\n          <div style={separatorStyle} />\n          <div style={titleStyle}>{role}</div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "63ea06e3-3c00-4a22-920d-5b7e8df2b21b",
  "name": "Hand-Drawn Paper Lower Third",
