  "thumb": "/thumbnails/fc1c2614-8907-4dd4-b0ea-0ef7f272a3e0.jpg",
  "code": "const ListOverlay = ({ item }) => {\n  const frame = useCurrentFrame();\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const item1Text = props.item1Text;\n  const item2Text = props.item2Text;\n  const item3Text = props.item3Text;\n  const item4Text = props.item4Text;\n  const accentColor = props.accentColor;\n  const textColor = props.textColor;\n  const fontFamily = props.fontFamily;\n  const transparentBackground = props.transparentBackground;\n\n  const DESIGN_WIDTH = 1200;\n  const iw = item?.width || DESIGN_WIDTH;\n  const ih = item?.height || 1080;\n  const scale = iw / DESIGN_WIDTH;\n  const DESIGN_HEIGHT = Math.ceil(ih / scale);\n\n  const totalFrames = 240;\n  const slideInDur = 30;\n  const slideOutStart = totalFrames - 30;\n\n  // Bell-curve: slow → fast(peak late) → slow\n  const enterEase = Easing.bezier(0.12, 0.0, 0.20, 1.0);\n  // Exit mirror: slow → fast(peak early) → slow\n  const exitEase = Easing.bezier(0.80, 0.0, 0.88, 1.0);\n\n  const enterTx = interpolate(frame, [0, slideInDur], [DESIGN_WIDTH, 0], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: enterEase,\n  });\n  const exitTx = interpolate(frame, [slideOutStart, slideOutStart + 30], [0, DESIGN_WIDTH], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: exitEase,\n  });\n  const tx = frame < slideInDur ? enterTx : (frame >= slideOutStart ? exitTx : 0);\n\n  const co = slideInDur;\n\n  const titleChars = (titleText || '').split('');\n  const tStagger = titleChars.length > 1 ? 22 / titleChars.length : 0;\n  const titleElements = titleChars.map((char, i) => {\n    const p = interpolate(frame - co - i * tStagger, [0, 15], [0, 1], {\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.quad)\n    });\n    return (\n      <span key={`t${i}`} style={{\n        display: 'inline-block', whiteSpace: 'pre',\n        opacity: p, transform: `translateY(${interpolate(p,[0,1],[-18,0])}px)`\n      }}>{char}</span>\n    );\n  });\n\n  const r = 22;\n  const circumference = 2 * Math.PI * r;\n  const itemData = [\n    { text: item1Text || '', start: co + 20 },\n    { text: item2Text || '', start: co + 60 },\n    { text: item3Text || '', start: co + 100 },\n    { text: item4Text || '', start: co + 140 },\n  ];\n\n  const listElements = itemData.map((listItem, idx) => {\n    const s = listItem.start;\n    const strokeP = interpolate(frame - s, [0, 18], [0, 1], {\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.inOut(Easing.quad)\n    });\n    const dashOffset = circumference * (1 - strokeP);\n    const numP = interpolate(frame - (s + 10), [0, 14], [0, 1], {\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.quad)\n    });\n    const words = listItem.text.split(' ').filter(Boolean);\n    const wordElements = words.map((word, w) => {\n      const wp = interpolate(frame - (s + 16 + w * 4), [0, 14], [0, 1], {\n        extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.quad)\n      });\n      return (\n        <span key={`w${idx}-${w}`}>\n          <span style={{ display:'inline-block', opacity:wp, transform:`translateY(${interpolate(wp,[0,1],[-18,0])}px)` }}>{word}</span>{' '}\n        </span>\n      );\n    });\n    const fIdFar = `gFar${idx}`;\n    const fIdNear = `gNear${idx}`;\n    const cx = 40; const cy = 40;\n    return (\n      <div key={`li${idx}`} style={{ display:'flex', alignItems:'center', marginBottom:46 }}>\n        <div style={{ position:'relative', width:60, height:60, flexShrink:0, marginRight:40 }}>\n          <svg width=\"120\" height=\"120\" viewBox=\"0 0 80 80\"\n            style={{ position:'absolute', top:-30, left:-30, transform:'rotate(-90deg) scaleY(-1)', overflow:'visible' }}>\n            <defs>\n              <filter id={fIdFar} x=\"-200%\" y=\"-200%\" width=\"500%\" height=\"500%\">\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"20\" result=\"b1\"/>\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"9\" result=\"b2\"/>\n                <feMerge><feMergeNode in=\"b1\"/><feMergeNode in=\"b1\"/><feMergeNode in=\"b2\"/></feMerge>\n              </filter>\n              <filter id={fIdNear} x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"4\" result=\"b\"/>\n                <feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n              </filter>\n            </defs>\n            <circle cx={cx} cy={cy} r={r} fill=\"transparent\" stroke={accentColor} strokeWidth=\"3\"\n              strokeDasharray={circumference} strokeDashoffset={dashOffset} strokeLinecap=\"round\"\n              filter={`url(#${fIdFar})`} opacity={strokeP * 0.9}/>\n            <circle cx={cx} cy={cy} r={r} fill=\"transparent\" stroke={accentColor} strokeWidth=\"3\"\n              strokeDasharray={circumference} strokeDashoffset={dashOffset} strokeLinecap=\"round\"\n              filter={`url(#${fIdNear})`} opacity={strokeP}/>\n            <circle cx={cx} cy={cy} r={r} fill=\"transparent\" stroke={accentColor} strokeWidth=\"3\"\n              strokeDasharray={circumference} strokeDashoffset={dashOffset} strokeLinecap=\"round\"\n              opacity={strokeP}/>\n          </svg>\n          <div style={{\n            position:'absolute', inset:0,\n            display:'flex', justifyContent:'center', alignItems:'center',\n            fontFamily, color:textColor, fontSize:28, fontWeight:'bold',\n            opacity:numP,\n            transform:`translate(${interpolate(numP,[0,1],[10,0])}px,${interpolate(numP,[0,1],[14,0])}px)`,\n          }}>{idx + 1}</div>\n        </div>\n        <div style={{ fontFamily, color:textColor, fontSize:38, lineHeight:1.4, flex:1 }}>{wordElements}</div>\n      </div>\n    );\n  });\n\n  // Root div: NO overflow:hidden — the panel must be able to exist outside its own canvas bounds\n  // translateX pushes the entire rendered panel: positive = off to the right, 0 = in place\n  // The host canvas/compositor clips what's outside the screen — we just move the panel\n  return (\n    <div style={{\n      position:'absolute', top:0, left:0,\n      width:DESIGN_WIDTH, height:DESIGN_HEIGHT,\n      transform:`scale(${scale}) translateX(${tx}px)`,\n      transformOrigin:'top left',\n      // NO overflow:hidden — don't clip the panel, let it slide freely\n    }}>\n      <div style={{\n        position:'absolute', top:0, left:0,\n        width:'100%', height:'100%',\n        backgroundColor: transparentBackground ? 'transparent' : 'rgb(8,6,14)',\n      }}>\n        <div style={{\n          position:'absolute', bottom:-60, right:-60,\n          width:800, height:700, zIndex:0, pointerEvents:'none',\n          background:`radial-gradient(ellipse at 85% 90%, ${accentColor}80 0%, ${accentColor}38 28%, ${accentColor}12 50%, transparent 68%)`,\n        }}/>\n        <div style={{ position:'absolute', top:0, left:0, width:8, height:'100%', backgroundColor:'rgba(255,255,255,0.50)', zIndex:2 }}/>\n        <div style={{ position:'absolute', top:0, left:8, width:4, height:'100%', backgroundColor:'rgba(60,60,60,0.90)', zIndex:2 }}/>\n        <div style={{ position:'relative', zIndex:1, padding:'200px 90px 60px 100px', boxSizing:'border-box' }}>\n          <div style={{ fontFamily, color:textColor, fontSize:42, fontWeight:'bold', marginBottom:64, lineHeight:1.2, whiteSpace:'nowrap' }}>\n            {titleElements}\n          </div>\n          {listElements}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
