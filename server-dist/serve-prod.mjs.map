  "thumb": "/thumbnails/6e2cda87-034d-4a76-8fd5-1f0bea0d6b00.jpg",
  "code": "const ChartComponent = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const safeFps = fps || 30;\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'Weekly Taste Score';\n  const kpi1Value = props.kpi1Value || '5%';\n  const kpi1Label = props.kpi1Label || 'more variety';\n  const kpi2Value = props.kpi2Value || '-3%';\n  const kpi2Label = props.kpi2Label || 'more variety';\n  const posColor = props.posColor || '#ff8572';\n  const negColor = props.negColor || '#8fd6ff';\n  const bgColor = props.bgColor || '#E8E6F0';\n  const cardColor = props.cardColor || '#FFFFFF';\n\n  const data = [\n    { day: 'Sun', value: props.valSun !== undefined ? Number(props.valSun) : 24 },\n    { day: 'Mon', value: props.valMon !== undefined ? Number(props.valMon) : 14 },\n    { day: 'Tue', value: props.valTue !== undefined ? Number(props.valTue) : -10 },\n    { day: 'Wed', value: props.valWed !== undefined ? Number(props.valWed) : -17 },\n    { day: 'Thu', value: props.valThu !== undefined ? Number(props.valThu) : -5 },\n    { day: 'Fri', value: props.valFri !== undefined ? Number(props.valFri) : 18 },\n    { day: 'Sat', value: props.valSat !== undefined ? Number(props.valSat) : 24 },\n  ];\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeSpring = (delay = 0, config = { damping: 15, mass: 0.8 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const cardProgress = safeSpring(5, { damping: 16 });\n  const cardOpacity = interpolate(frame, [5, 15], [0, 1], { extrapolateRight: 'clamp' });\n  const headerOpacity = interpolate(frame, [15, 25], [0, 1], { extrapolateRight: 'clamp' });\n  const headerY = interpolate(frame, [15, 25], [20, 0], { extrapolateRight: 'clamp' });\n\n  // Chart dimensions\n  // chartHeight: total height of the chart plotting area (above + below zero line)\n  // zeroY: pixel position of the zero baseline from the top of the chart container\n  const chartHeight = 420;\n  const zeroY = chartHeight / 2; // 210px — zero line is exactly in the middle\n  const valueMultiplier = zeroY / 100; // pixels per 1% value\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    fontFamily: 'Inter, sans-serif',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    overflow: 'hidden',\n  };\n\n  const cardStyle = {\n    width: 1400,\n    height: 800,\n    backgroundColor: cardColor,\n    borderRadius: 40,\n    boxShadow: '0 25px 50px -12px rgba(0, 0, 0, 0.08)',\n    padding: '60px 80px 60px 80px',\n    boxSizing: 'border-box',\n    position: 'relative',\n    transform: `translateY(${(1 - cardProgress) * 50}px)`,\n    opacity: cardOpacity,\n    overflow: 'hidden',\n  };\n\n  const watermarkStyle = {\n    position: 'absolute',\n    top: '50%',\n    left: '50%',\n    transform: 'translate(-50%, -50%)',\n    fontSize: '500px',\n    fontWeight: 800,\n    color: 'rgba(0, 0, 0, 0.03)',\n    pointerEvents: 'none',\n    zIndex: 0,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <div style={watermarkStyle}>₿</div>\n\n        {/* Header */}\n        <div style={{\n          display: 'flex',\n          justifyContent: 'space-between',\n          alignItems: 'flex-start',\n          opacity: headerOpacity,\n          transform: `translateY(${headerY}px)`,\n          zIndex: 10,\n          position: 'relative',\n        }}>\n          <h1 style={{ margin: 0, fontSize: '56px', color: '#0f2e2f', fontWeight: 800, letterSpacing: '-1px' }}>\n            {titleText}\n          </h1>\n          <div style={{ display: 'flex', gap: '60px' }}>\n            <div>\n              <div style={{ fontSize: '56px', fontWeight: 800, color: posColor, lineHeight: 1 }}>{kpi1Value}</div>\n              <div style={{ fontSize: '20px', fontWeight: 500, color: '#577b7a', marginTop: '8px', textTransform: 'uppercase', letterSpacing: '1px' }}>{kpi1Label}</div>\n            </div>\n            <div>\n              <div style={{ fontSize: '56px', fontWeight: 800, color: negColor, lineHeight: 1 }}>{kpi2Value}</div>\n              <div style={{ fontSize: '20px', fontWeight: 500, color: '#577b7a', marginTop: '8px', textTransform: 'uppercase', letterSpacing: '1px' }}>{kpi2Label}</div>\n            </div>\n          </div>\n        </div>\n\n        {/* Chart wrapper: chartHeight (bars) + 40px (day labels below zero line) */}\n        <div style={{\n          marginTop: '60px',\n          position: 'relative',\n          height: chartHeight + 40,\n          zIndex: 10,\n          overflow: 'visible',\n        }}>\n          {/* Y-axis grid lines — all positioned relative to this wrapper using zeroY */}\n          {[100, 50, 0, -50, -100].map((tick, i) => {\n            // top of this tick line = zeroY - (tick * valueMultiplier)\n            const topPos = zeroY - tick * valueMultiplier;\n            const isZero = tick === 0;\n            const gridOpacity = interpolate(frame, [20 + i * 3, 30 + i * 3], [0, 1], { extrapolateRight: 'clamp' });\n\n            return (\n              <div key={tick} style={{\n                position: 'absolute',\n                top: topPos,\n                left: 0,\n                right: 0,\n                display: 'flex',\n                alignItems: 'center',\n                transform: 'translateY(-50%)',\n                opacity: gridOpacity,\n              }}>\n                <div style={{\n                  width: '60px',\n                  textAlign: 'right',\n                  paddingRight: '20px',\n                  fontSize: '18px',\n                  color: '#89a9a8',\n                  fontWeight: 600,\n                }}>\n                  {tick}%\n                </div>\n                <div style={{\n                  flex: 1,\n                  height: isZero ? '2px' : '1px',\n                  backgroundColor: isZero ? '#89a9a8' : 'transparent',\n                  borderTop: isZero ? 'none' : '2px dashed #E2E8F0',\n                }} />\n              </div>\n            );\n          })}\n\n          {/* Bars row — same coordinate system as grid, left offset for Y-axis labels */}\n          <div style={{\n            position: 'absolute',\n            top: 0,\n            left: '80px',\n            right: 0,\n            height: chartHeight,\n            display: 'flex',\n            overflow: 'visible',\n          }}>\n            {data.map((d, i) => {\n              const isPositive = d.value >= 0;\n              const barHeight = Math.abs(d.value) * valueMultiplier;\n              const barScale = safeSpring(30 + i * 4);\n              const labelOpacity = interpolate(frame, [40 + i * 4, 50 + i * 4], [0, 1], { extrapolateRight: 'clamp' });\n\n              // Bar top position (from top of chart container):\n              // Positive bar: grows upward from zeroY → top = zeroY - barHeight\n              // Negative bar: grows downward from zeroY → top = zeroY\n              const barTop = isPositive ? zeroY - barHeight : zeroY;\n\n              return (\n                <div key={d.day} style={{ flex: 1, position: 'relative', display: 'flex', justifyContent: 'center', overflow: 'visible' }}>\n                  {/* Bar */}\n                  <div style={{\n                    position: 'absolute',\n                    top: barTop,\n                    width: '64px',\n                    height: Math.max(barHeight, 2),\n                    backgroundColor: isPositive ? posColor : negColor,\n                    borderRadius: isPositive ? '12px 12px 0 0' : '0 0 12px 12px',\n                    transformOrigin: isPositive ? 'bottom center' : 'top center',\n                    transform: `scaleY(${barScale})`,\n                  }} />\n\n                  {/* Day label — below zero line for positive bars, below bar bottom for negative bars */}\n                  <div style={{\n                    position: 'absolute',\n                    top: isPositive ? zeroY + 12 : barTop + barHeight + 12,\n                    fontSize: '20px',\n                    fontWeight: 600,\n                    color: '#577b7a',\n                    opacity: labelOpacity,\n                    whiteSpace: 'nowrap',\n                  }}>\n                    {d.day}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "f7361a72-e5c6-4ed7-aebf-95fd541676d5",
