  "thumb": "/thumbnails/7e9f53fa-3036-47a6-a27f-48acf2e49e48.jpg",
  "code": "const DottedSlidePanel = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const backgroundColor = props.backgroundColor;\n  const dotColor = props.dotColor;\n  const textColor = props.textColor;\n  const accentColor = props.badgeBgColor;\n  const bandColor = props.badgeColor;\n  const titleText = props.titleText;\n  const accentLineIndex = Number(props.badgeText) || 3;\n  const accentWordCount = 2;\n  const fontFamily = props.fontFamily;\n\n  const slideDuration = 18;\n  const wordInterval = 4;\n  const wordDelay = 28;\n  const wordEase = Easing.bezier(0.22, 1, 0.36, 1);\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const PANEL_EXTRA = 300;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const bgTop = interpolate(\n    frame, [0, 26], [DESIGN_HEIGHT, -PANEL_EXTRA],\n    { easing: Easing.bezier(0.76, 0, 0.24, 1), extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n  const dotOpacity = interpolate(\n    frame, [26, 44], [0, 1],\n    { easing: Easing.out(Easing.quad), extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n  const bandOffset = interpolate(\n    frame, [26, 80], [1, 0],\n    { easing: Easing.bezier(0.25, 1, 0.4, 1), extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  // word animation: frame-driven x and opacity\n  const makeSpan = (word, wordIndex, isLast) => {\n    const start = wordDelay + wordIndex * wordInterval;\n    const end = start + slideDuration;\n    const x = interpolate(frame, [start, end], [180, 0], {\n      easing: wordEase, extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n    });\n    const op = interpolate(frame, [start, start + 10], [0, 1], {\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n    });\n    return (\n      <span key={word + wordIndex} style={{\n        display: 'inline-block',\n        opacity: op,\n        transform: 'translateX(' + x + 'px)',\n        marginRight: isLast ? 0 : '0.22em'\n      }}>{word}</span>\n    );\n  };\n\n  const titleLines = titleText.split(/\\\\n|\\n/);\n  let gi = 0;\n\n  const renderedLines = titleLines.map((line, lineIdx) => {\n    const words = line.trim().split(' ');\n    const isAccent = (lineIdx + 1) === accentLineIndex;\n\n    if (!isAccent) {\n      const spans = words.map((word, wi) => {\n        const idx = gi; gi++;\n        return makeSpan(word, idx, wi === words.length - 1);\n      });\n      return (\n        <div key={lineIdx} style={{ display: 'block', textAlign: 'center', lineHeight: 1.22 }}>\n          <span style={{ display: 'inline-block' }}>{spans}</span>\n        </div>\n      );\n    }\n\n    const ulWords = words.slice(0, accentWordCount);\n    const restWords = words.slice(accentWordCount);\n\n    const ulSpans = ulWords.map((word, wi) => {\n      const idx = gi; gi++;\n      return makeSpan(word, idx, wi === ulWords.length - 1);\n    });\n    const ulLastIdx = gi - 1;\n    const ulLandFrame = wordDelay + ulLastIdx * wordInterval + slideDuration;\n    const ulW = interpolate(frame, [ulLandFrame, ulLandFrame + 20], [0, 100], {\n      easing: wordEase, extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n    });\n    const ulOp = interpolate(frame, [ulLandFrame, ulLandFrame + 8], [0, 1], {\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n    });\n\n    const restSpans = restWords.map((word, wi) => {\n      const idx = gi; gi++;\n      return makeSpan(word, idx, wi === restWords.length - 1);\n    });\n\n    return (\n      <div key={lineIdx} style={{ display: 'block', textAlign: 'center', lineHeight: 1.22, marginBottom: 8 }}>\n        <span style={{\n          display: 'inline-block', position: 'relative',\n          paddingBottom: 10, marginRight: restWords.length > 0 ? '0.22em' : 0\n        }}>\n          {ulSpans}\n          <span style={{\n            position: 'absolute', bottom: 0, left: 0,\n            height: 6, width: ulW + '%',\n            backgroundColor: accentColor, borderRadius: 3, opacity: ulOp, display: 'block'\n          }} />\n        </span>\n        {restWords.length > 0 && <span style={{ display: 'inline-block' }}>{restSpans}</span>}\n      </div>\n    );\n  });\n\n  const lastWordLand = wordDelay + (gi - 1) * wordInterval + slideDuration;\n  const exitStart = Math.min(lastWordLand + 10, durationInFrames - 24);\n  const exitY = interpolate(\n    frame, [exitStart, exitStart + 22], [0, DESIGN_HEIGHT + PANEL_EXTRA],\n    { easing: Easing.bezier(0.76, 0, 0.24, 1), extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: 'scale(' + scale + ')', transformOrigin: 'top left',\n      overflow: 'hidden'\n    }}>\n      <div style={{\n        position: 'absolute', top: bgTop, left: 0,\n        width: DESIGN_WIDTH, height: DESIGN_HEIGHT + PANEL_EXTRA,\n        backgroundColor: backgroundColor,\n        transform: 'translateY(' + exitY + 'px)'\n      }}>\n        <svg width=\"100%\" height=\"100%\" style={{ position: 'absolute', top: 0, left: 0 }}>\n          <defs>\n            <pattern id=\"mgdots2\" width=\"30\" height=\"30\" patternUnits=\"userSpaceOnUse\">\n              <circle cx=\"15\" cy=\"15\" r=\"1.5\" fill={dotColor} />\n            </pattern>\n          </defs>\n          <rect width=\"100%\" height=\"100%\" fill=\"url(#mgdots2)\" opacity={dotOpacity} />\n        </svg>\n        <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT + PANEL_EXTRA} style={{ position: 'absolute', top: 0, left: 0 }}>\n          <path\n            d={'M -300 '+(920+PANEL_EXTRA)+' C 300 '+(1100+PANEL_EXTRA)+', 900 '+(480+PANEL_EXTRA)+', 1400 '+(320+PANEL_EXTRA)+' C 1700 '+(220+PANEL_EXTRA)+', 2000 '+(200+PANEL_EXTRA)+', 2300 '+(180+PANEL_EXTRA)}\n            pathLength=\"1\" fill=\"none\" stroke={bandColor} strokeWidth=\"320\"\n            strokeLinecap=\"round\" strokeLinejoin=\"round\"\n            strokeDasharray=\"1\" strokeDashoffset={bandOffset}\n          />\n        </svg>\n        <div style={{\n          position: 'absolute', top: PANEL_EXTRA, left: 0,\n          width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n          display: 'flex', flexDirection: 'column',\n          alignItems: 'center', justifyContent: 'center',\n          zIndex: 10, padding: '0 160px', boxSizing: 'border-box'\n        }}>\n          <div style={{\n            fontFamily: fontFamily, fontSize: 90, fontWeight: 700,\n            color: textColor, textAlign: 'center',\n            letterSpacing: '-0.01em', width: '100%'\n          }}>\n            {renderedLines}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "dcdf9f3a-2878-4788-af40-69007b040f8c",
  "name": "Principle card with diagonal band grow animation",
  "category": "uncategorized",
  "description": "A warm, elegant title sequence with a wide sweeping background curve and cascading, spring-animated text elements.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "backgroundColor": "#f8f5ee",
   "curveColor": "#eee9de",
   "cardColor": "#ffffff",
   "textColor": "#0d0c0a",
   "iconPrimaryColor": "#6cdc89",
   "iconSecondaryColor": "#57a368",
   "iconStrokeColor": "#16311b",
   "badgeText": "Rule 1",
   "titleText": "Book the Trip\nBefore You Overthink",
   "fontFamily": "Playfair Display, Georgia, serif"
  },
  "propSchema": [
   {
    "key": "backgroundColor",
    "type": "color",
    "defaultValue": "#f8f5ee",
    "label": "Background Color"
   },
   {
    "key": "curveColor",
    "type": "color",
    "defaultValue": "#eee9de",
    "label": "Curve Color"
   },
   {
    "key": "cardColor",
    "type": "color",
    "defaultValue": "#ffffff",
    "label": "Card Color"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#0d0c0a",
    "label": "Text Color"
   },
   {
    "key": "iconPrimaryColor",
    "type": "color",
    "defaultValue": "#6cdc89",
    "label": "Icon Primary Color"
   },
   {
    "key": "iconSecondaryColor",
    "type": "color",
    "defaultValue": "#57a368",
    "label": "Icon Secondary Color"
   },
   {
    "key": "iconStrokeColor",
    "type": "color",
    "defaultValue": "#16311b",
    "label": "Icon Stroke Color"
   },
   {
    "key": "badgeText",
    "type": "text",
    "defaultValue": "Rule 1",
    "label": "Badge Text"
   },
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "Book the Trip\nBefore You Overthink",
    "label": "Title Text"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Playfair Display, Georgia, serif",
    "label": "Font"
   }
  ],
  "thumb": "/thumbnails/dcdf9f3a-2878-4788-af40-69007b040f8c.jpg",
  "code": "const PrincipleCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const backgroundColor = props.backgroundColor;\n  const curveColor = props.curveColor;\n  const cardColor = props.cardColor;\n  const textColor = props.textColor;\n  const badgeText = props.badgeText;\n  const titleText = props.titleText;\n  const fontFamily = props.fontFamily;\n  const iconPrimaryColor = props.iconPrimaryColor;\n  const iconSecondaryColor = props.iconSecondaryColor;\n  const iconStrokeColor = props.iconStrokeColor;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const PANEL_EXTRA = 300;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const float = (rampIn, period, amp, phase = 0) => {\n    const t = Math.max(0, frame - rampIn);\n    return Math.sin((t / period) * Math.PI * 2 + phase) * amp * Math.min(1, t / 24);\n  };\n  const iconFloatY = float(52, 110, 10, 0);\n  const iconFloatR = float(52, 130, 0.8, 1.1);\n  const titleFloatY = float(90, 95, 7, 2.3);\n  const titleFloatR = float(90, 120, 0.4, 0.5);\n\n  const bgTop = interpolate(\n    frame, [0, 22],\n    [DESIGN_HEIGHT, -PANEL_EXTRA],\n    { easing: Easing.bezier(0.76, 0, 0.24, 1), extrapolateRight: 'clamp' }\n  );\n\n  const iconEntrance = spring({\n    frame: Math.max(0, frame - 24), fps: safeFps,\n    config: { damping: 14, stiffness: 120, mass: 0.65 }\n  });\n\n  const badgeEntrance = spring({\n    frame: Math.max(0, frame - 33), fps: safeFps,\n    config: { damping: 14, stiffness: 120, mass: 0.65 }\n  });\n\n  const titleLines = titleText.split(/\\\\n|\\n/);\n  let wordIndex = 0;\n  const renderedTitle = titleLines.map((line, lineIdx) => {\n    const words = line.trim().split(' ');\n    const lineSpans = words.map((word) => {\n      const delay = 42 + wordIndex * 5;\n      wordIndex++;\n      const wOpacity = interpolate(frame, [delay, delay + 14], [0, 1],\n        { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n      const wY = interpolate(frame, [delay, delay + 14], [18, 0],\n        { easing: Easing.out(Easing.quad), extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n      return (\n        <span key={word + delay} style={{\n          display: 'inline-block',\n          opacity: wOpacity,\n          // translate3d 前置，强制独立 GPU 合成层，避免 translateY 亚像素跳帧\n          transform: `translate3d(0, ${wY}px, 0)`,\n          willChange: 'transform',\n          marginRight: '0.26em'\n        }}>{word}</span>\n      );\n    });\n    return (\n      <div key={lineIdx} style={{ display: 'block', lineHeight: 1.18 }}>\n        {lineSpans}\n      </div>\n    );\n  });\n\n  const curveOffset = interpolate(\n    frame, [68, 116], [1, 0],\n    { easing: Easing.bezier(0.25, 1, 0.4, 1),\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  const exitStart = durationInFrames - 22;\n  const exitSlideY = interpolate(\n    frame,\n    [exitStart, durationInFrames - 2], [0, DESIGN_HEIGHT + PANEL_EXTRA],\n    { easing: Easing.bezier(0.76, 0, 0.24, 1),\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      // translate3d(0,0,0) 前置 scale，强制根容器提升为 GPU 合成层\n      transform: `translate3d(0, 0, 0) scale(${scale})`,\n      transformOrigin: 'top left',\n      willChange: 'transform',\n      overflow: 'hidden'\n    }}>\n\n      <div style={{\n        position: 'absolute',\n        top: bgTop,\n        left: 0,\n        width: DESIGN_WIDTH,\n        height: DESIGN_HEIGHT + PANEL_EXTRA,\n        backgroundColor: backgroundColor,\n        // 面板滑动层：translate3d 替代 translateY，绕开光栅化抖动\n        transform: `translate3d(0, ${exitSlideY}px, 0)`,\n        willChange: 'transform'\n      }}>\n\n        <svg\n          width={DESIGN_WIDTH}\n          height={DESIGN_HEIGHT + PANEL_EXTRA}\n          viewBox={`0 0 ${DESIGN_WIDTH} ${DESIGN_HEIGHT + PANEL_EXTRA}`}\n          style={{ position: 'absolute', top: 0, left: 0 }}\n        >\n          <g transform={`translate(0, ${PANEL_EXTRA})`}>\n            <path\n              d=\"M -300 920 C 300 1100, 900 480, 1400 320 C 1700 220, 2000 200, 2300 180\"\n              pathLength=\"1\"\n              fill=\"none\"\n              stroke={curveColor}\n              strokeWidth=\"380\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              strokeDasharray=\"1\"\n              strokeDashoffset={curveOffset}\n            />\n          </g>\n        </svg>\n\n        <div style={{\n          position: 'absolute',\n          top: PANEL_EXTRA,\n          left: 0,\n          width: '100%',\n          height: DESIGN_HEIGHT,\n          display: 'flex', flexDirection: 'column',\n          alignItems: 'center', justifyContent: 'center',\n          zIndex: 10\n        }}>\n\n          {/* 浮动组：translate3d 替代 translateY，willChange 提升合成层 */}\n          <div style={{\n            display: 'flex', flexDirection: 'column', alignItems: 'center',\n            transform: `translate3d(0, ${iconFloatY}px, 0) rotate(${iconFloatR}deg)`,\n            willChange: 'transform',\n            marginBottom: 44\n          }}>\n            <div style={{\n              width: 200, height: 200,\n              backgroundColor: cardColor,\n              borderRadius: 44,\n              display: 'flex', alignItems: 'center', justifyContent: 'center',\n              boxShadow: '0 20px 50px rgba(0,0,0,0.07)',\n              // scale 前置 translate3d(0,0,0)，强制图标卡独立合成层\n              transform: `translate3d(0, 0, 0) scale(${iconEntrance})`,\n              willChange: 'transform',\n              marginBottom: 28\n            }}>\n              <svg width=\"110\" height=\"110\" viewBox=\"0 0 100 100\">\n                <rect x=\"22\" y=\"32\" width=\"58\" height=\"36\" rx=\"5\"\n                  fill={iconSecondaryColor} stroke={iconStrokeColor} strokeWidth=\"2.8\"\n                  transform=\"rotate(8 51 50)\"/>\n                <rect x=\"18\" y=\"25\" width=\"58\" height=\"36\" rx=\"5\"\n                  fill={iconPrimaryColor} stroke={iconStrokeColor} strokeWidth=\"2.8\"/>\n                <rect x=\"24\" y=\"31\" width=\"46\" height=\"24\" rx=\"2\"\n                  fill=\"none\" stroke={iconStrokeColor} strokeWidth=\"1.4\"/>\n                <circle cx=\"47\" cy=\"43\" r=\"8\" fill=\"#a9f2bb\" stroke={iconStrokeColor} strokeWidth=\"1.6\"/>\n                <text x=\"47\" y=\"48\" fontSize=\"12\" fontFamily=\"sans-serif\" fontWeight=\"900\"\n                  textAnchor=\"middle\" fill={iconStrokeColor}>$</text>\n              </svg>\n            </div>\n\n            <div style={{\n              backgroundColor: cardColor,\n              padding: '10px 30px',\n              borderRadius: 10,\n              border: '1.5px solid rgba(0,0,0,0.08)',\n              boxShadow: '0 6px 16px rgba(0,0,0,0.05)',\n              transform: `translate3d(0, 0, 0) scale(${badgeEntrance})`,\n              willChange: 'transform'\n            }}>\n              <p style={{\n                fontFamily, fontSize: 34, fontWeight: 500,\n                color: textColor, margin: 0, letterSpacing: '-0.01em'\n              }}>{badgeText}</p>\n            </div>\n          </div>\n\n          {/* 标题浮动层：translate3d 替代 translateY */}\n          <div style={{\n            transform: `translate3d(0, ${titleFloatY}px, 0) rotate(${titleFloatR}deg)`,\n            willChange: 'transform',\n            fontFamily,\n            fontSize: 98, fontWeight: 700,\n            color: textColor, textAlign: 'center',\n            lineHeight: 1.18, letterSpacing: '-0.02em'\n          }}>\n            {renderedTitle}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "614fbd3c-90b1-4e2b-b52d-e78876757b4b",
  "name": "Quote card slide-in with word-by-word reveal",
  "category": "uncategorized",
  "description": "A semi-transparent quote card drops in smoothly from the top, followed by a word-by-word fade and slide-in effect for the typography.",
  "width": 1920,
