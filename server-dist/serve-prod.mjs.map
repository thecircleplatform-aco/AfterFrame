  "thumb": "/thumbnails/2c38ab81-0d44-485f-9981-a3e36ef785b6.jpg",
  "code": "const LiquidPresentation = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const titleFont = props.titleFont;\n  const subtitleFont = props.subtitleFont;\n  const titleColor = props.titleColor;\n  const subtitleColor = props.subtitleColor;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n\n  const safeFps = fps || 30;\n\n  // Animations for text\n  const titleSpring = spring({\n    frame: Math.max(0, frame - 15),\n    fps: safeFps,\n    config: { damping: 15, stiffness: 80 }\n  });\n  const subtitleSpring = spring({\n    frame: Math.max(0, frame - 25),\n    fps: safeFps,\n    config: { damping: 15, stiffness: 80 }\n  });\n\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [50, 0]);\n\n  const subtitleOpacity = interpolate(subtitleSpring, [0, 1], [0, 1]);\n  const subtitleY = interpolate(subtitleSpring, [0, 1], [-20, 0]);\n\n  // Background organic liquid motion\n  const slowFrame = frame * 0.5;\n  const wave1Rot = Math.sin(slowFrame / 30) * 8;\n  const wave1Scale = 1.1 + Math.sin(slowFrame / 40) * 0.15;\n  const wave1Y = Math.cos(slowFrame / 25) * 50;\n\n  const wave2Rot = Math.cos(slowFrame / 35) * -5;\n  const wave2Scale = 1.2 + Math.cos(slowFrame / 45) * 0.1;\n  const wave2Y = Math.sin(slowFrame / 30) * -60;\n\n  const wave3Rot = Math.sin(slowFrame / 40) * 6;\n  const wave3Scale = 1.3 + Math.sin(slowFrame / 35) * 0.12;\n  const wave3X = Math.cos(slowFrame / 30) * 70;\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor, overflow: 'hidden' }}>\n      {!transparentBackground && (\n        <svg \n          width=\"1920\" \n          height=\"1080\" \n          viewBox=\"0 0 1920 1080\" \n          style={{ position: 'absolute', inset: 0 }}\n        >\n          <defs>\n            <linearGradient id=\"liquidBase\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n              <stop offset=\"0%\" stopColor=\"#060018\" />\n              <stop offset=\"100%\" stopColor=\"#300028\" />\n            </linearGradient>\n            <linearGradient id=\"liquidFlow1\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n              <stop offset=\"0%\" stopColor=\"#660047\" stopOpacity=\"0.9\" />\n              <stop offset=\"50%\" stopColor=\"#8400a1\" stopOpacity=\"0.6\" />\n              <stop offset=\"100%\" stopColor=\"#ff4bbe\" stopOpacity=\"0.9\" />\n            </linearGradient>\n            <linearGradient id=\"liquidFlow2\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n              <stop offset=\"0%\" stopColor=\"#00a2a2\" stopOpacity=\"0.8\" />\n              <stop offset=\"100%\" stopColor=\"#c656e6\" stopOpacity=\"0.7\" />\n            </linearGradient>\n            <linearGradient id=\"liquidFlow3\" x1=\"50%\" y1=\"100%\" x2=\"50%\" y2=\"0%\">\n              <stop offset=\"0%\" stopColor=\"#be0088\" stopOpacity=\"0.85\" />\n              <stop offset=\"100%\" stopColor=\"#de86f9\" stopOpacity=\"0.4\" />\n            </linearGradient>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#liquidBase)\" />\n\n          {/* Deep back wave */}\n          <g transform={`translate(960, 540) rotate(${wave1Rot}) scale(${wave1Scale}) translate(-960, -540) translate(0, ${wave1Y})`}>\n            <path \n              d=\"M-400,300 C200,-100 800,800 1400,400 C1900,100 2300,500 2300,500 L2300,1400 L-400,1400 Z\" \n              fill=\"url(#liquidFlow1)\" \n            />\n          </g>\n\n          {/* Mid magenta/blue wave */}\n          <g transform={`translate(960, 540) rotate(${wave2Rot}) scale(${wave2Scale}) translate(-960, -540) translate(0, ${wave2Y})`}>\n            <path \n              d=\"M-300,700 C300,1100 900,400 1500,800 C2000,1100 2400,600 2400,600 L2400,1500 L-300,1500 Z\" \n              fill=\"url(#liquidFlow2)\" \n            />\n          </g>\n\n          {/* Top highlight flowing wave */}\n          <g transform={`translate(960, 540) rotate(${wave3Rot}) scale(${wave3Scale}) translate(-960, -540) translate(${wave3X}, -100)`}>\n            <path \n              d=\"M-200,-200 C400,-400 900,500 1600,0 C2100,-300 2400,200 2400,200 L2400,800 C1900,900 1300,300 700,600 C100,800 -200,300 -200,300 Z\" \n              fill=\"url(#liquidFlow3)\" \n            />\n          </g>\n        </svg>\n      )}\n\n      <div style={{\n        position: 'absolute',\n        bottom: 120,\n        left: 100,\n        width: '1200px',\n        opacity: titleOpacity,\n        transform: `translateY(${titleY}px)`\n      }}>\n        <h1 style={{\n          margin: 0,\n          fontFamily: titleFont,\n          fontSize: 96,\n          fontWeight: 800,\n          fontStyle: 'italic',\n          color: titleColor,\n          lineHeight: 1.15,\n          letterSpacing: '-0.015em',\n          textShadow: '0px 15px 40px rgba(0,0,0,0.6)'\n        }}>\n          {titleText}\n        </h1>\n      </div>\n\n      <div style={{\n        position: 'absolute',\n        top: 100,\n        right: 100,\n        width: '450px',\n        textAlign: 'right',\n        opacity: subtitleOpacity,\n        transform: `translateY(${subtitleY}px)`\n      }}>\n        <h2 style={{\n          margin: 0,\n          fontFamily: subtitleFont,\n          fontSize: 30,\n          fontWeight: 400,\n          color: subtitleColor,\n          lineHeight: 1.4,\n          letterSpacing: '0.01em',\n          textShadow: '0px 8px 20px rgba(0,0,0,0.5)',\n          opacity: 0.95\n        }}>\n          {subtitleText}\n        </h2>\n      </div>\n    </div>\n  );\n};"
 },
