  "code": "const Component = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  \n  const bgColor = props.bgColor;\n  const accentColor = props.accentColor;\n  const transparentBackground = props.transparentBackground;\n  const fontFamily = props.fontFamily;\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 20, stiffness: 150 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const sBrand = safeSpring(5);\n  const sTitle = safeSpring(15, { damping: 28, stiffness: 60 });\n  const sBullets = safeSpring(30);\n  const sName = safeSpring(40);\n  const sQuote = safeSpring(50);\n  const sChart = safeSpring(60);\n  const sTimeLine = safeSpring(75);\n\n  const bulletItems = [\n    props.bullet1,\n    props.bullet2,\n    props.bullet3\n  ].map((text, i) => {\n    const itemSpring = safeSpring(25 + i * 5);\n    return {\n      text,\n      opacity: itemSpring,\n      translateX: (1 - itemSpring) * -50\n    };\n  });\n\n  const chartItems = [\n    { label: props.chartLabel1, value: Number(props.chartValue1) || 0 },\n    { label: props.chartLabel2, value: Number(props.chartValue2) || 0 },\n    { label: props.chartLabel3, value: Number(props.chartValue3) || 0 }\n  ].map((item, i) => {\n    const barSpring = safeSpring(55 + i * 8);\n    return {\n      ...item,\n      barScale: barSpring,\n      displayValue: Math.round(item.value * barSpring)\n    };\n  });\n\n  const timelineItems = [\n    props.time1,\n    props.time2,\n    props.time3,\n    props.time4\n  ].map((text, i) => {\n    const ptSpring = safeSpring(65 + i * 5);\n    return {\n      text,\n      scale: ptSpring\n    };\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: transparentBackground ? 'transparent' : bgColor,\n    fontFamily: fontFamily,\n    display: 'grid',\n    gridTemplateColumns: '55% 45%',\n    padding: '100px',\n    boxSizing: 'border-box',\n    overflow: 'hidden',\n    color: accentColor\n  };\n\n  const leftColumnStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'space-between',\n    height: '100%',\n    paddingRight: '60px'\n  };\n\n  const rightColumnStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'space-between',\n    height: '100%',\n    paddingLeft: '60px',\n    borderLeft: `4px solid rgba(255,211,248, ${sTitle * 0.2})`\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={leftColumnStyle}>\n        <div>\n          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', marginBottom: '60px' }}>\n            {[0, 1, 2].map(i => (\n              <div key={i} style={{ width: `${sBrand * 80}px`, height: '12px', backgroundColor: accentColor }} />\n            ))}\n          </div>\n          \n          <div style={{ display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>\n            {frame >= 15 && <div style={{ \n              transform: `translateY(${(1 - sTitle) * 100}%)`, \n              fontSize: '140px', \n              fontWeight: 700, \n              lineHeight: 1, \n              letterSpacing: '-0.02em', \n              textTransform: 'capitalize' \n            }}>\n              {props.chapterText1}\n            </div>}\n            {frame >= 15 && <div style={{ \n              transform: `translateY(${(1 - sTitle) * 100}%)`, \n              fontSize: '180px', \n              fontWeight: 900, \n              lineHeight: 0.9, \n              letterSpacing: '-0.03em', \n              textTransform: 'uppercase' \n            }}>\n              {props.chapterText2}\n            </div>}\n          </div>\n        </div>\n\n        <div style={{ display: 'flex', flexDirection: 'column', gap: '24px', marginTop: '60px' }}>\n          {bulletItems.map((item, i) => (\n            <div key={i} style={{ \n              display: 'flex', \n              alignItems: 'center', \n              gap: '20px', \n              opacity: item.opacity, \n              transform: `translateX(${item.translateX}px)` \n            }}>\n              <div style={{ width: '20px', height: '20px', backgroundColor: accentColor }} />\n              <div style={{ fontSize: '36px', fontWeight: 600, textTransform: 'uppercase', letterSpacing: '0.02em' }}>\n                {item.text}\n              </div>\n            </div>\n          ))}\n        </div>\n\n        <div style={{ position: 'relative', marginTop: 'auto', width: '100%', opacity: sTimeLine }}>\n          <div style={{ \n            position: 'absolute', \n            top: '10px', \n            left: 0, \n            right: 0, \n            height: '4px', \n            backgroundColor: accentColor, \n            transformOrigin: 'left', \n            transform: `scaleX(${sTimeLine})` \n          }} />\n          <div style={{ display: 'flex', justifyContent: 'space-between', position: 'relative', zIndex: 1 }}>\n            {timelineItems.map((item, i) => (\n              <div key={i} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '16px', transform: `scale(${item.scale})` }}>\n                <div style={{ width: '24px', height: '24px', borderRadius: '50%', backgroundColor: bgColor, border: `6px solid ${accentColor}` }} />\n                <div style={{ fontSize: '28px', fontWeight: 800, letterSpacing: '0.05em' }}>{item.text}</div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      <div style={rightColumnStyle}>\n        <div style={{ textAlign: 'right', display: 'flex', flexDirection: 'column', alignItems: 'flex-end', opacity: sName, transform: `translateY(${(1-sName)*-30}px)` }}>\n          <div style={{ \n            display: 'inline-block', \n            backgroundColor: accentColor, \n            color: '#000', \n            padding: '12px 24px', \n            fontSize: '72px', \n            fontWeight: 900, \n            textTransform: 'uppercase', \n            lineHeight: 1 \n          }}>\n            {props.nameText}\n          </div>\n          <div style={{ \n            display: 'inline-block', \n            border: `6px solid ${accentColor}`, \n            color: accentColor, \n            padding: '8px 20px', \n            fontSize: '36px', \n            fontWeight: 700, \n            marginTop: '12px', \n            textTransform: 'uppercase',\n            lineHeight: 1\n          }}>\n            {props.roleText}\n          </div>\n        </div>\n\n        <div style={{ \n          fontStyle: 'italic', \n          fontSize: '52px', \n          fontWeight: 700, \n          lineHeight: 1.2, \n          borderLeft: `12px solid ${accentColor}`, \n          paddingLeft: '32px', \n          opacity: sQuote, \n          transform: `translateX(${(1-sQuote)*20}px)` \n        }}>\n          \"{props.quoteText}\"\n        </div>\n\n        <div style={{ display: 'flex', flexDirection: 'column', gap: '36px', marginTop: 'auto', opacity: sChart }}>\n          {chartItems.map((c, i) => (\n            <div key={i} style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>\n              <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '32px', fontWeight: 800, textTransform: 'uppercase', letterSpacing: '0.04em' }}>\n                <span>{c.label}</span>\n                <span>{c.displayValue}%</span>\n              </div>\n              <div style={{ width: '100%', height: '20px', border: `4px solid ${accentColor}`, padding: '2px', boxSizing: 'border-box' }}>\n                <div style={{ \n                  width: `${c.value}%`, \n                  height: '100%', \n                  backgroundColor: accentColor, \n                  transformOrigin: 'left', \n                  transform: `scaleX(${c.barScale})` \n                }} />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
