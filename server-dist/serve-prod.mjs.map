  "thumb": "/thumbnails/a73aa354-9e8c-459a-a94a-78b0547d9a67.jpg",
  "code": "const CinematicTitle = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const labelPrefixText = props.labelPrefixText;\n  const labelNumberText = props.labelNumberText;\n  const titleText = props.titleText;\n  const glowColor = props.glowColor;\n  const backgroundColor = props.backgroundColor;\n  const transparentBackground = props.transparentBackground;\n  const titleFontFamily = props.titleFontFamily;\n  const labelFontFamily = props.labelFontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const easeInOut = (t) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;\n  const easeIn = (t) => t * t * t;\n\n  const fadeInEnd = 15;\n  const fadeOutStart = Math.max(fadeInEnd + 1, durationInFrames - 20);\n  const fadeOutEnd = Math.max(fadeOutStart + 1, durationInFrames);\n\n  const masterOpacity = interpolate(\n    frame,\n    [0, fadeInEnd, fadeOutStart, fadeOutEnd],\n    [0, 1, 1, 0],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  const glowBuild = interpolate(frame, [9, 40], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  const labelRaw = interpolate(frame, [10, 42], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const labelEased = easeIn(labelRaw);\n  const labelBlur = interpolate(labelEased, [0, 1], [9, 0]);\n\n  const titleRaw = interpolate(frame, [18, 55], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const titleEased = easeInOut(titleRaw);\n  const titleOpacity = interpolate(titleRaw, [0, 0.4, 1], [0, 0.9, 1]);\n  const titleY = interpolate(titleEased, [0, 1], [-40, 0]);\n  const titleBlur = interpolate(titleEased, [0, 1], [12, 0]);\n  const titleShadow = `0 0 16px ${glowColor}99, 0 0 40px ${glowColor}2e`;\n\n  const gc = glowColor || '#f3f2ff';\n  const bgColor = transparentBackground ? 'transparent' : (backgroundColor || '#161422');\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      backgroundColor: bgColor,\n      overflow: 'hidden',\n    }}>\n      {/* Dot grid */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n        backgroundImage: 'radial-gradient(circle, rgba(243,242,255,0.18) 1px, transparent 1px)',\n        backgroundSize: '28px 28px',\n        pointerEvents: 'none',\n      }} />\n\n      {/* Film grain */}\n      <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', opacity: 0.06, pointerEvents: 'none' }}>\n        <filter id=\"cg\">\n          <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.7\" numOctaves=\"4\" stitchTiles=\"stitch\"/>\n          <feColorMatrix type=\"saturate\" values=\"0\"/>\n        </filter>\n        <rect width=\"100%\" height=\"100%\" filter=\"url(#cg)\"/>\n      </svg>\n\n      {/* 中心大辉光 — 强且宽 */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n        background: `radial-gradient(ellipse 62% 52% at 50% 52%, rgba(243,242,255,0.28) 0%, rgba(243,242,255,0.10) 35%, rgba(243,242,255,0.01) 65%, transparent 80%)`,\n        opacity: glowBuild * masterOpacity,\n        pointerEvents: 'none',\n      }} />\n\n      {/* 外缘散射环 — 亮-暗-亮 */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n        background: `radial-gradient(ellipse 110% 110% at 50% 50%, transparent 55%, rgba(243,242,255,0.04) 72%, rgba(243,242,255,0.07) 88%, rgba(243,242,255,0.03) 100%)`,\n        opacity: glowBuild * masterOpacity,\n        pointerEvents: 'none',\n      }} />\n\n      {/* 四角暗角压边 */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n        background: `radial-gradient(ellipse 80% 75% at 50% 50%, transparent 40%, rgba(2,1,8,0.55) 100%)`,\n        pointerEvents: 'none',\n      }} />\n\n      {/* Content */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n        display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center',\n        opacity: masterOpacity,\n      }}>\n        {/* Label */}\n        <div style={{\n          display: 'flex', alignItems: 'baseline', gap: '14px',\n          marginBottom: '80px',\n          opacity: labelEased,\n          filter: `blur(${labelBlur}px)`,\n          color: gc,\n          fontFamily: labelFontFamily,\n          letterSpacing: '0.06em',\n        }}>\n          <span style={{ fontWeight: 300, fontSize: '30px', textTransform: 'capitalize', opacity: 0.88 }}>\n            {labelPrefixText}\n          </span>\n          <span style={{ fontWeight: 700, fontSize: '34px' }}>\n            {labelNumberText}\n          </span>\n        </div>\n\n        {/* Title */}\n        <h1 style={{\n          margin: 0, padding: 0,\n          fontFamily: titleFontFamily,\n          fontWeight: 900,\n          fontSize: '200px',\n          lineHeight: 1,\n          color: gc,\n          textTransform: 'uppercase',\n          letterSpacing: '-0.01em',\n          opacity: titleOpacity,\n          transform: `translateY(${titleY}px)`,\n          filter: `blur(${titleBlur}px)`,\n          textShadow: titleShadow,\n        }}>\n          {titleText}\n        </h1>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "8744f05e-4976-4430-a14e-85a167301c14",
  "name": "Dark Tech — Callout Tag",
  "category": "uncategorized",
  "description": "A sharp, skewed parallelogram callout that reveals from the vertical center outward, acting as a clean mask for the text inside.",
  "width": 1920,
