  "thumb": "/thumbnails/e816057d-bd49-4a82-880c-d4555a9c1dce.jpg",
  "code": "const TalkingHeadKeywordCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const line2AccentText = props.line2AccentText;\n  const line3Text = props.line3Text;\n  const line4Text = props.line4Text;\n  const fontFamily = props.fontFamily;\n  const fontSize = props.fontSize;\n  const lineSpacing = props.lineSpacing;\n  const textColor = props.textColor;\n  const accentColor = props.accentColor;\n  const backgroundColor = props.backgroundColor;\n  const transparentBackground = props.transparentBackground;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    fontFamily: fontFamily,\n  };\n\n  const line1Opacity = frame >= 10 ? 1 : 0;\n  const line2Opacity = frame >= 20 ? 1 : 0;\n  const line3Opacity = frame >= 30 ? 1 : 0;\n  const line4Opacity = frame >= 40 ? 1 : 0;\n\n  const textContainerStyle = {\n    position: 'absolute',\n    left: 72,\n    top: 0,\n    width: 1018, // 1090 - 72 (clips precisely at the video cutout edge)\n    height: 1080,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    gap: `${lineSpacing}px`,\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n    zIndex: 10,\n  };\n\n  const textBaseStyle = {\n    fontSize: `${fontSize}px`,\n    fontWeight: 700,\n    lineHeight: 1,\n  };\n\n  return (\n    <div style={rootStyle}>\n      {!transparentBackground && (\n        <svg width=\"1920\" height=\"1080\" style={{position: 'absolute', top: 0, left: 0}}>\n          <defs>\n            <mask id=\"video-cutout\">\n              <rect width=\"1920\" height=\"1080\" fill=\"white\" />\n              <rect x=\"1090\" y=\"55\" width=\"774\" height=\"970\" rx=\"44\" fill=\"black\" />\n            </mask>\n          </defs>\n          <rect \n            width=\"1920\" \n            height=\"1080\" \n            fill={backgroundColor} \n            mask=\"url(#video-cutout)\" \n          />\n          <rect \n            x=\"1090\" \n            y=\"55\" \n            width=\"774\" \n            height=\"970\" \n            rx=\"44\" \n            fill=\"none\" \n            stroke=\"rgba(0,0,0,0.07)\" \n            strokeWidth=\"2\" \n          />\n        </svg>\n      )}\n\n      <div style={textContainerStyle}>\n        <div style={{...textBaseStyle, color: textColor, opacity: line1Opacity}}>\n          {line1Text}\n        </div>\n        <div style={{...textBaseStyle, color: textColor, opacity: line2Opacity}}>\n          {line2Text}\n          <span style={{color: accentColor}}>{line2AccentText}</span>\n        </div>\n        <div style={{...textBaseStyle, color: textColor, opacity: line3Opacity}}>\n          {line3Text}\n        </div>\n        <div style={{...textBaseStyle, color: accentColor, opacity: line4Opacity}}>\n          {line4Text}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "b90365b4-68f6-4de6-9d79-96f6bb9f90e4",
  "name": "Bold Glitch Title",
  "category": "text-effects",
  "description": "A bold typography title card that reveals with electric strobe flickers, holds with a neon glow and intermittent micro-glitches, and fades out cleanly.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/b90365b4-68f6-4de6-9d79-96f6bb9f90e4.jpg",
  "code": "const BoldGlitchTitle05 = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n  const mainTitle = props.mainTitle || 'SHOP THE LOOK';\n  const subtitleText = props.subtitleText || 'COZY HOME COLLECTION';\n  const textColor = props.textColor || '#FFFFFF';\n  const glowColor = props.glowColor || 'rgba(255,255,255,0.5)';\n  const bgOpacity = props.bgOpacity !== undefined ? parseFloat(props.bgOpacity) : 0.88;\n\n  const DESIGN_WIDTH = 1920, DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width||DESIGN_WIDTH)/DESIGN_WIDTH, (item?.height||DESIGN_HEIGHT)/DESIGN_HEIGHT);\n\n  const outStart = Math.max(0, durationInFrames - 30);\n\n  let textOpacity = 1, shadowStr = 'none', scanI = 0.06;\n\n  if (frame < 8) {\n    textOpacity = 0.08; scanI = 0.35;\n  } else if (frame < 12) {\n    textOpacity = frame%2===0 ? 1 : 0.1;\n    scanI = 0.5;\n  } else if (frame < 25) {\n    const n = Math.abs(Math.sin(frame*12.9898)*43758.5453)%1;\n    textOpacity = n>0.3 ? 1 : 0.6;\n    const spread = n>0.5 ? 22 : 0;\n    shadowStr = `0 0 6px ${textColor}, 0 0 ${spread}px ${glowColor}`;\n    scanI = 0.3;\n  } else if (frame < outStart) {\n    const micro = (frame-25)%22<2;\n    textOpacity = micro ? 0.7 : 1;\n    shadowStr = `0 0 28px ${glowColor}`;\n    scanI = 0.06;\n  } else if (frame < outStart+10) {\n    const n = Math.abs(Math.sin(frame*78.233)*43758.5453)%1;\n    textOpacity = n>0.5 ? 1 : 0.15;\n    shadowStr = n>0.5 ? `0 0 22px ${glowColor}` : 'none';\n    scanI = 0.45;\n  } else {\n    const fp = (frame-(outStart+10))/20;\n    textOpacity = interpolate(fp,[0,1],[1,0],{extrapolateRight:'clamp'});\n    shadowStr = `0 0 ${interpolate(fp,[0,1],[30,0],{extrapolateRight:'clamp'})}px ${glowColor}`;\n    scanI = 0.3;\n  }\n\n  // Fine glitch slices during flicker phases\n  const isFlicker = frame < 25 || frame >= outStart;\n  const NUM_SLICES = 12;\n  const sliceShifts = Array.from({length:NUM_SLICES}).map((_,i) => {\n    if (!isFlicker) return 0;\n    const maxS = frame<12 ? 40 : 18;\n    const active = random(`fa${i}${Math.floor(frame/2)}`) > 0.72;\n    return active ? (random(`fs${i}${frame}`)-0.5)*2*maxS : 0;\n  });\n\n  // RGB offset during flicker\n  const rgbActive = frame < 25 || frame >= outStart;\n  const rOff = rgbActive ? (random('r'+frame)-0.5)*2*(frame<12?18:9) : 0;\n  const cOff = rgbActive ? (random('c'+frame)-0.5)*2*(frame<12?18:9)*-1 : 0;\n\n  const rootStyle = {\n    position:'absolute', top:0, left:0, width:DESIGN_WIDTH, height:DESIGN_HEIGHT,\n    transform:`scale(${scale})`, transformOrigin:'top left',\n    backgroundColor:`rgba(10,10,10,${bgOpacity})`, overflow:'hidden'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Scanlines */}\n      <div style={{\n        position:'absolute', top:0, left:0, width:'100%', height:'100%',\n        background:'repeating-linear-gradient(to bottom, transparent 0px, transparent 3px, rgba(0,0,0,0.4) 4px, rgba(0,0,0,0.4) 5px)',\n        opacity:scanI, pointerEvents:'none', mixBlendMode:'overlay', zIndex:20\n      }}/>\n\n      {/* RGB Red layer */}\n      {rOff !== 0 && <div style={{position:'absolute', top:0, left:rOff, width:'100%', height:'100%', mixBlendMode:'screen', opacity:0.55}}>\n        <div style={{position:'absolute', top:'48%', left:'50%', transform:'translate(-50%,-50%)',\n          fontFamily:'\"Montserrat\",\"Inter\",sans-serif', fontWeight:900, fontSize:'125px',\n          textTransform:'uppercase', color:'#789e00', whiteSpace:'nowrap', opacity:textOpacity}}>{mainTitle}</div>\n      </div>}\n      {/* RGB Cyan layer */}\n      {cOff !== 0 && <div style={{position:'absolute', top:0, left:cOff, width:'100%', height:'100%', mixBlendMode:'screen', opacity:0.55}}>\n        <div style={{position:'absolute', top:'48%', left:'50%', transform:'translate(-50%,-50%)',\n          fontFamily:'\"Montserrat\",\"Inter\",sans-serif', fontWeight:900, fontSize:'125px',\n          textTransform:'uppercase', color:'#00e8e9', whiteSpace:'nowrap', opacity:textOpacity}}>{mainTitle}</div>\n      </div>}\n\n      {/* Main text */}\n      <div style={{position:'absolute', top:'48%', left:'50%', transform:'translate(-50%,-50%)',\n        fontFamily:'\"Montserrat\",\"Inter\",sans-serif', fontWeight:900, fontSize:'125px',\n        textTransform:'uppercase', color:textColor, opacity:textOpacity, textShadow:shadowStr,\n        whiteSpace:'nowrap', textAlign:'center', lineHeight:1}}>{mainTitle}</div>\n\n      {/* Subtitle */}\n      <div style={{position:'absolute', top:'56%', left:'50%', transform:'translate(-50%,-50%)',\n        fontFamily:'\"Montserrat\",\"Inter\",sans-serif', fontWeight:400, fontSize:'20px',\n        letterSpacing:'0.2em', textTransform:'uppercase', color:textColor,\n        opacity:textOpacity, textShadow:shadowStr, whiteSpace:'nowrap', textAlign:'center', lineHeight:1}}>{subtitleText}</div>\n\n      {/* Fine glitch slice overlays */}\n      {sliceShifts.map((shift,i) => shift !== 0 && (\n        <div key={i} style={{\n          position:'absolute', top:0, left:shift, width:'100%', height:'100%',\n          clipPath:`inset(${(i/NUM_SLICES)*100}% 0 ${100-((i+1)/NUM_SLICES)*100}% 0)`\n        }}>\n          <div style={{position:'absolute', top:'48%', left:'50%', transform:'translate(-50%,-50%)',\n            fontFamily:'\"Montserrat\",\"Inter\",sans-serif', fontWeight:900, fontSize:'125px',\n            textTransform:'uppercase', color:textColor, opacity:textOpacity*0.8,\n            textShadow:shadowStr, whiteSpace:'nowrap'}}>{mainTitle}</div>\n        </div>\n      ))}\n    </div>\n  );\n};\n"
 },
 {
  "id": "6d5ae7e6-e458-40ef-8633-383bfc0e8279",
  "name": "Finance Explainer — Chapter Title Card (Light)",
  "category": "text-effects",
  "description": "A cinematic chapter title card for finance explainer series — displays a series label and bold main title with a highlight color flash on a light background.",
  "tags": [
   "long-form",
   "short-form",
   "intro"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "seriesTitle": "CODE UNPACKED",
   "mainTitle": "SIGNAL, DECODED",
   "highlightColor": "#c4ff15",
   "transparentBackground": false,
   "fontFamilySeries": "Roboto",
   "fontFamilyMain": "Roboto"
  },
  "propSchema": [
   {
    "key": "seriesTitle",
    "type": "text",
    "defaultValue": "CODE UNPACKED",
    "label": "Series Title"
   },
   {
    "key": "mainTitle",
    "type": "text",
    "defaultValue": "SIGNAL, DECODED",
    "label": "Main Title"
   },
   {
    "key": "highlightColor",
    "type": "color",
    "defaultValue": "#c4ff15",
    "label": "Highlight Color"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
    "defaultValue": false,
    "label": "Transparent Background"
   },
   {
    "key": "fontFamilySeries",
    "type": "font",
    "defaultValue": "Roboto",
    "label": "Font (Series)"
   },
   {
    "key": "fontFamilyMain",
    "type": "font",
    "defaultValue": "Roboto",
    "label": "Font (Main)"
   }
  ],
  "thumb": "/thumbnails/6d5ae7e6-e458-40ef-8633-383bfc0e8279.jpg",
  "code": "const CinematicTitle = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const seriesTitle = props.seriesTitle;\n  const mainTitle = props.mainTitle;\n  const highlightColor = props.highlightColor;\n  const bgColor = \"#e8e6e0\";\n  const transparentBackground = props.transparentBackground;\n  const fontFamilySeries = props.fontFamilySeries;\n  const fontFamilyMain = props.fontFamilyMain;\n\n  const safeFps = fps || 30;\n  const safeDuration = durationInFrames || 330;\n  // Cut at 0.8s (24 frames) — instant switch, no fade\n  const cutFrame = Math.round(safeFps * 0.8);\n\n  const parseHex = (hex) => {\n    if (!hex || !hex.startsWith('#')) return [255, 234, 0];\n    let c = hex.substring(1).split('');\n    if(c.length === 3){\n        c = [c[0], c[0], c[1], c[1], c[2], c[2]];\n    }\n    c = '0x' + c.join('');\n    return [(c>>16)&255, (c>>8)&255, c&255];\n  };\n  const rgb = parseHex(highlightColor);\n\n  const isHighlight = frame < cutFrame;\n  const textColor = isHighlight ? highlightColor : '#111111';\n  const textShadow = 'none';\n\n  const scale = interpolate(frame, [0, safeDuration], [1, 1.05]);\n\n  const splitTitle = (title) => {\n    if (!title) return { left: '', right: '' };\n    const commaIdx = title.lastIndexOf(',');\n    if (commaIdx !== -1) {\n      return {\n        left: title.substring(0, commaIdx + 1) + ' ',\n        right: title.substring(commaIdx + 1).trim()\n      };\n    }\n    const spaceIdx = title.lastIndexOf(' ');\n    if (spaceIdx !== -1) {\n      return {\n        left: title.substring(0, spaceIdx + 1),\n        right: title.substring(spaceIdx + 1)\n      };\n    }\n    return { left: '', right: title };\n  };\n\n  const { left, right } = React.useMemo(() => splitTitle(mainTitle), [mainTitle]);\n\n  const watermarks = React.useMemo(() => {\n    const symbols = ['∑','∫','π','Δ','α','β','∞','≈','≠','≤','≥','Ω','µ','√'];\n    const out = [];\n    let seed = 12345;\n    const rng = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };\n    for (let i = 0; i < 40; i++) {\n      out.push({ id: i, char: symbols[Math.floor(rng() * symbols.length)],\n        left: rng()*110-5 + '%', top: rng()*110-5 + '%',\n        size: 150 + rng()*450, rot: (rng()-0.5)*120, opacity: 0.02+rng()*0.03 });\n    }\n    return out;\n  }, []);\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: transparentBackground ? 'transparent' : bgColor,\n    overflow: 'hidden'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Grid layer — identical to Background Layer MG */}\n      {!transparentBackground && (\n        <div style={{ position: 'absolute', inset: 0, zIndex: 1, pointerEvents: 'none' }}>\n          <svg width=\"100%\" height=\"100%\">\n            <defs>\n              <pattern id=\"title_grid\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\">\n                <path d=\"M 40 0 L 40 80 M 0 40 L 80 40\" stroke=\"#999\" strokeOpacity=\"0.06\" strokeWidth=\"1.5\"/>\n                <path d=\"M 33 40 L 47 40 M 40 33 L 40 47\" stroke=\"#999\" strokeOpacity=\"0.15\" strokeWidth=\"2\"/>\n              </pattern>\n            </defs>\n            <rect width=\"100%\" height=\"100%\" fill=\"url(#title_grid)\"/>\n          </svg>\n        </div>\n      )}\n      {/* Watermark symbols — identical to Background Layer MG */}\n      {!transparentBackground && (\n        <div style={{ position: 'absolute', inset: 0, zIndex: 2, pointerEvents: 'none' }}>\n          {watermarks.map(wm => (\n            <div key={wm.id} style={{\n              position: 'absolute', left: wm.left, top: wm.top,\n              fontSize: wm.size, color: '#888', opacity: wm.opacity,\n              transform: 'rotate(' + wm.rot + 'deg)', lineHeight: 1, fontFamily: 'serif',\n            }}>{wm.char}</div>\n          ))}\n        </div>\n      )}\n      {/* Film grain */}\n      <div style={{ position: 'absolute', inset: 0, opacity: 0.06, pointerEvents: 'none', zIndex: 3 }}>\n        <svg style={{ width: '100%', height: '100%' }}>\n          <filter id=\"film-grain\">\n            <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.75\" numOctaves=\"3\" stitchTiles=\"stitch\" />\n            <feColorMatrix type=\"saturate\" values=\"0\" />\n          </filter>\n          <rect width=\"100%\" height=\"100%\" filter=\"url(#film-grain)\" />\n        </svg>\n      </div>\n\n      <div style={{\n        position: 'absolute',\n        inset: 0,\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        justifyContent: 'center',\n        transform: `scale(${scale})`,\n        transformOrigin: 'center center',\n        padding: '0 80px',\n        zIndex: 10\n      }}>\n        <div style={{\n          fontFamily: fontFamilySeries,\n          fontWeight: 400,\n          fontSize: 32,\n          letterSpacing: '0.15em',\n          color: '#555555',\n          textTransform: 'uppercase',\n          marginBottom: 24,\n          textAlign: 'center'\n        }}>\n          {seriesTitle}\n        </div>\n\n        <div style={{\n          fontFamily: fontFamilyMain,\n          fontWeight: 900,\n          fontSize: 130,\n          letterSpacing: '-0.02em',\n          textTransform: 'uppercase',\n          lineHeight: 1.1,\n          textAlign: 'center',\n          whiteSpace: 'pre-wrap',\n          maxWidth: 1700\n        }}>\n          {left && <span style={{ color: '#111111' }}>{left}</span>}\n          <span style={{ color: textColor, textShadow: textShadow }}>{right}</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
