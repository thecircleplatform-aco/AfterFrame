  "thumb": "/thumbnails/5a3d3074-e947-454c-be17-61763d195186.jpg",
  "code": "const MinimalGradientTitle = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const chapterNumber = props.chapterNumber;\n  const titleLine1 = props.titleLine1;\n  const titleLine2 = props.titleLine2;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const textColor = props.textColor;\n  const fontFamily = props.fontFamily;\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  // --- Easing ---\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n\n  // --- Exit ---\n  const totalFrames = durationInFrames || 120;\n  const exitStart = totalFrames - 25;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / 25));\n  const exitProgress = exitRaw * exitRaw;\n  const exitOpacity = 1 - exitProgress;\n  const exitScale = 1 - exitProgress * 0.02;\n\n  // --- Blob: scale 1.06 → 1.0 over 45 frames, opacity fade in ---\n  const blobFadeRaw = Math.min(1, Math.max(0, frame / 40));\n  const blobOpacity = smoothSettle(blobFadeRaw) * 0.8;\n  const blobScaleRaw = Math.min(1, Math.max(0, frame / 45));\n  const blobScale = 1.06 - 0.06 * smoothSettle(blobScaleRaw);\n  // Gentle sin/cos drift (amplitude ≤ 8px)\n  const blobDriftX = Math.sin(frame / 50) * 8;\n  const blobDriftY = Math.cos(frame / 70) * 6;\n\n  // --- Chapter number: starts frame 10, 50 frames ---\n  const chapterRaw = Math.min(1, Math.max(0, (frame - 10) / 50));\n  const chapterProgress = smoothSettle(chapterRaw);\n  const chapterOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - 10) / 18)));\n  const chapterY = (1 - chapterProgress) * 60;\n\n  // --- Title line 1: starts frame 35, 45 frames ---\n  const t1Raw = Math.min(1, Math.max(0, (frame - 35) / 45));\n  const t1Progress = smoothSettle(t1Raw);\n  const t1Opacity = smoothSettle(Math.min(1, Math.max(0, (frame - 35) / 15)));\n  const t1Y = (1 - t1Progress) * 55;\n\n  // --- Title line 2: starts frame 50, 45 frames ---\n  const t2Raw = Math.min(1, Math.max(0, (frame - 50) / 45));\n  const t2Progress = smoothSettle(t2Raw);\n  const t2Opacity = smoothSettle(Math.min(1, Math.max(0, (frame - 50) / 15)));\n  const t2Y = (1 - t2Progress) * 55;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden',\n    fontFamily,\n    color: textColor,\n    opacity: exitOpacity,\n    transform: `scale(${exitScale})`\n  };\n\n  const chapterStyle = {\n    position: 'absolute',\n    top: 140,\n    left: 180,\n    fontSize: 96,\n    fontStyle: 'italic',\n    fontWeight: 400,\n    opacity: chapterOpacity,\n    transform: `translateY(${chapterY}px)`,\n    lineHeight: 1,\n    letterSpacing: '-0.02em',\n  };\n\n  const titleContainerStyle = {\n    position: 'absolute',\n    bottom: 160,\n    right: 180,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'flex-end',\n    gap: 10,\n  };\n\n  const title1Style = {\n    fontSize: 120,\n    fontWeight: 400,\n    fontStyle: 'normal',\n    textTransform: 'uppercase',\n    opacity: t1Opacity,\n    transform: `translateY(${t1Y}px)`,\n    lineHeight: 0.9,\n    letterSpacing: '0.05em',\n  };\n\n  const title2Style = {\n    fontSize: 120,\n    fontWeight: 400,\n    fontStyle: 'italic',\n    textTransform: 'uppercase',\n    opacity: t2Opacity,\n    transform: `translateY(${t2Y}px)`,\n    lineHeight: 0.9,\n    letterSpacing: '0.02em',\n  };\n\n  const blobStyle = {\n    position: 'absolute',\n    top: -100,\n    left: 450,\n    width: 1200,\n    height: 1200,\n    opacity: blobOpacity,\n    transform: `translate(${blobDriftX}px, ${blobDriftY}px) scale(${blobScale})`,\n    transformOrigin: 'center center',\n    pointerEvents: 'none',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <svg viewBox=\"0 0 1200 1200\" style={blobStyle}>\n        <defs>\n          <linearGradient id=\"organicGrad\" x1=\"20%\" y1=\"10%\" x2=\"80%\" y2=\"90%\">\n            <stop offset=\"0%\" stopColor={blobColor1} />\n            <stop offset=\"100%\" stopColor={blobColor2} />\n          </linearGradient>\n          <filter id=\"softBlur\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n            <feGaussianBlur stdDeviation=\"120\" />\n          </filter>\n        </defs>\n        <ellipse cx=\"600\" cy=\"600\" rx=\"350\" ry=\"450\" fill=\"url(#organicGrad)\" filter=\"url(#softBlur)\" />\n      </svg>\n\n      <div style={chapterStyle}>{chapterNumber}</div>\n\n      <div style={titleContainerStyle}>\n        <div style={title1Style}>{titleLine1}</div>\n        <div style={title2Style}>{titleLine2}</div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "7e255237-89e4-40c7-b7f2-bc9c6acfb934",
  "name": "Minimal Gradient — Company Introduction",
  "category": "uncategorized",
  "description": "An elegant minimal layout with oversized typography, extreme whitespace, and a soft drifting gradient orb in the corner.",
