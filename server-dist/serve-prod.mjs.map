  "thumb": "/thumbnails/4103210c-e3ee-4589-8626-307036bc61a3.jpg",
  "code": "const EditorialShowcase = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n  \n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 18, stiffness: 90, mass: 0.8 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const backgroundColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    padding: '100px',\n    boxSizing: 'border-box',\n    display: 'flex',\n    flexDirection: 'column',\n    fontFamily: props.fontSans,\n    color: props.textColor,\n    overflow: 'hidden'\n  };\n\n  const chapterSpring = safeSpring(5);\n  const chapterOpacity = chapterSpring;\n  const chapterY = (1 - chapterSpring) * 30;\n\n  const chartElements = [\n    { label: props.chartLabel1, valueText: props.chartValue1, fill: props.chartFill1, color: props.accentCopper },\n    { label: props.chartLabel2, valueText: props.chartValue2, fill: props.chartFill2, color: props.accentAmber },\n    { label: props.chartLabel3, valueText: props.chartValue3, fill: props.chartFill3, color: props.accentTan }\n  ].map((item, idx) => {\n    const s = safeSpring(15 + idx * 8);\n    return (\n      <div key={idx} style={{ marginBottom: 32, opacity: s, transform: `translateX(${(1 - s) * 20}px)` }}>\n        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 12, fontSize: 24, fontWeight: 600 }}>\n          <span>{item.label}</span>\n          <span style={{ fontFamily: props.fontSerif, fontStyle: 'italic', fontWeight: 400, color: props.textSecondaryColor }}>{item.valueText}</span>\n        </div>\n        <div style={{ height: 6, backgroundColor: 'rgba(255,255,255,0.1)', borderRadius: 3, overflow: 'hidden' }}>\n          <div style={{ height: '100%', width: `${s * item.fill}%`, backgroundColor: item.color, borderRadius: 3 }} />\n        </div>\n      </div>\n    );\n  });\n\n  const nameSpring = safeSpring(30);\n  const nameLineScale = safeSpring(35);\n\n  const bulletElements = [\n    props.bullet1, props.bullet2, props.bullet3\n  ].map((text, idx) => {\n    const s = safeSpring(40 + idx * 6);\n    return (\n      <div key={idx} style={{ display: 'flex', alignItems: 'center', gap: 20, marginBottom: 24, opacity: s, transform: `translateX(${(1 - s) * -20}px)` }}>\n        <div style={{ width: 8, height: 8, borderRadius: '50%', backgroundColor: props.accentCopper, flexShrink: 0 }} />\n        <div style={{ fontSize: 26, color: props.textSecondaryColor, fontWeight: 500 }}>{text}</div>\n      </div>\n    );\n  });\n\n  const quoteSpring = safeSpring(60);\n\n  const tlLineSpring = safeSpring(70);\n  const timelineElements = [\n    { year: props.tlYear1, text: props.tlText1 },\n    { year: props.tlYear2, text: props.tlText2 },\n    { year: props.tlYear3, text: props.tlText3 },\n    { year: props.tlYear4, text: props.tlText4 }\n  ].map((item, idx) => {\n    const s = safeSpring(75 + idx * 8);\n    return (\n      <div key={idx} style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-start', opacity: s, transform: `translateY(${(1 - s) * 15}px)`, width: '22%' }}>\n        <div style={{ width: 12, height: 12, borderRadius: 6, backgroundColor: props.accentTan, marginTop: 6, marginBottom: 28, border: `4px solid ${props.bgColor}`, boxSizing: 'content-box', zIndex: 2 }} />\n        <div style={{ fontSize: 32, fontWeight: 800, marginBottom: 12, letterSpacing: 1 }}>{item.year}</div>\n        <div style={{ fontSize: 20, color: props.textSecondaryColor, lineHeight: 1.5, fontWeight: 500, paddingRight: 20 }}>{item.text}</div>\n      </div>\n    );\n  });\n\n  return (\n    <div style={rootStyle}>\n      <div style={{ display: 'flex', gap: '140px', flex: 1 }}>\n        \n        {/* Left Column */}\n        <div style={{ flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'space-between', paddingBottom: '40px' }}>\n          <div style={{ opacity: chapterOpacity, transform: `translateY(${chapterY}px)` }}>\n            <div style={{ fontSize: 20, letterSpacing: 6, fontWeight: 700, color: props.textSecondaryColor, marginBottom: 32, textTransform: 'uppercase' }}>\n              {props.chapterSubtitle}\n            </div>\n            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>\n              <div style={{ display: 'flex', alignItems: 'baseline', gap: 24, flexWrap: 'wrap' }}>\n                <span style={{ fontSize: 92, fontWeight: 800, letterSpacing: 1 }}>{props.chapterTitleSans1}</span>\n                <span style={{ fontSize: 100, fontFamily: props.fontSerif, fontStyle: 'italic', fontWeight: 400, letterSpacing: -2 }}>{props.chapterTitleSerif}</span>\n              </div>\n              <div style={{ fontSize: 92, fontWeight: 800, letterSpacing: 1 }}>{props.chapterTitleSans2}</div>\n            </div>\n          </div>\n          \n          <div style={{ opacity: nameSpring, transform: `translateY(${(1 - nameSpring) * 20}px)` }}>\n            <div style={{ width: `${nameLineScale * 80}px`, height: 4, backgroundColor: props.accentCopper, marginBottom: 24 }} />\n            <div style={{ fontSize: 44, fontWeight: 800, letterSpacing: 1, marginBottom: 8 }}>{props.nameText}</div>\n            <div style={{ fontSize: 26, color: props.textSecondaryColor, fontFamily: props.fontSerif, fontStyle: 'italic' }}>{props.roleText}</div>\n          </div>\n        </div>\n\n        {/* Right Column */}\n        <div style={{ flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'space-between', paddingBottom: '40px' }}>\n          <div style={{ width: '100%', paddingRight: '40px' }}>\n            {chartElements}\n          </div>\n          \n          <div style={{ marginTop: 20 }}>\n            {bulletElements}\n          </div>\n          \n          <div style={{\n            opacity: quoteSpring, \n            transform: `translateY(${(1 - quoteSpring) * 20}px)`,\n            borderLeft: `4px solid ${props.accentAmber}`,\n            paddingLeft: 36,\n            maxWidth: '90%',\n            marginTop: 20\n          }}>\n            <div style={{ fontSize: 38, fontFamily: props.fontSerif, fontStyle: 'italic', lineHeight: 1.4, color: props.textColor }}>\n              \"{props.quoteText}\"\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Timeline Footer */}\n      <div style={{ position: 'relative', marginTop: 40, height: 160 }}>\n        {frame >= 70 && <div style={{ position: 'absolute', top: 14, left: 0, right: 0, height: 4, backgroundColor: 'rgba(255,255,255,0.06)' }} />}\n        <div style={{ position: 'absolute', top: 14, left: 0, height: 4, width: `${tlLineSpring * 100}%`, backgroundColor: props.accentTan }} />\n        <div style={{ position: 'absolute', top: 0, left: 0, right: 0, display: 'flex', justifyContent: 'space-between' }}>\n          {timelineElements}\n        </div>\n      </div>\n    </div>\n  );\n};"
 }
]