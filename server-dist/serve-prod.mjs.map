    "code": "const ShortsBeforeAfter = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const beforeLabel = p.beforeLabel || 'BEFORE';\n  const afterLabel = p.afterLabel || 'AFTER';\n  const beforeText = p.beforeText || '';\n  const afterText = p.afterText || '';\n  const beforeColor = p.beforeColor || '#f87171';\n  const afterColor = p.afterColor || '#4ade80';\n  const textColor = p.textColor || '#fafafa';\n  const a = spring({ frame, fps, config: { damping: 15, stiffness: 100 } });\n  const b = spring({ frame: frame - 10, fps, config: { damping: 15, stiffness: 100 } });\n  const exit = interpolate(frame, [durationInFrames - 10, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const card = (label, text, color, enter, align) => (\n    <div style={{\n      width: 880, opacity: enter * exit,\n      transform: `translateX(${(1 - enter) * (align === 'left' ? -40 : 40)}px)`,\n      background: 'rgba(15,23,42,0.88)',\n      borderRadius: 24,\n      padding: '28px 32px',\n      borderLeft: `8px solid ${color}`,\n      marginBottom: 24,\n    }}>\n      <div style={{ fontSize: 24, fontWeight: 900, color, letterSpacing: 2, marginBottom: 10 }}>{label}</div>\n      <div style={{ fontSize: 40, fontWeight: 800, color: textColor }}>{text}</div>\n    </div>\n  );\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent', justifyContent: 'center', alignItems: 'center' }}>\n      <div>\n        {card(beforeLabel, beforeText, beforeColor, a, 'left')}\n        {card(afterLabel, afterText, afterColor, b, 'right')}\n      </div>\n    </AbsoluteFill>\n  );\n};"
