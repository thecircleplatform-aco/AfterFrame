  ],
  "thumb": "/thumbnails/34151422-9674-4a31-a2a7-ade3932e0aef.jpg",
  "code": "const VoxNewsCard = ({item}) => {\n  const baseFrame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const frame = Math.floor(baseFrame / 3) * 3;\n\n  const props = item.props || {};\n  const headlineLine1 = props.headlineLine1;\n  const headlineLine2 = props.headlineLine2;\n  const headlineLine3 = props.headlineLine3;\n  const bylineText = props.bylineText;\n  const sourceName = props.sourceName;\n  const sourceColor = props.sourceColor;\n  const highlightColor = props.highlightColor;\n  const backgroundColor = props.backgroundColor;\n  const headlineFont = props.headlineFont;\n  const sourceFont = props.sourceFont;\n  const bylineFont = props.bylineFont;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const canvasScale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Highlight wipe: easeOutCubic, quantized\n  const highlightPct = interpolate(frame, [0, 24], [0, 100], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateRight: 'clamp'\n  });\n\n  // Ken Burns: raw frame, GPU layer\n  const kenBurns = interpolate(baseFrame, [0, durationInFrames || 150], [1.0, 1.03], {\n    extrapolateRight: 'clamp'\n  });\n\n  const watermarks = React.useMemo(() => {\n    const symbols = ['∑','∫','π','Δ','α','β','∞','≈','≠','≤','≥','Ω','µ','√'];\n    const out = [];\n    let seed = 12345;\n    const rng = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };\n    for (let i = 0; i < 40; i++) {\n      out.push({ id: i, char: symbols[Math.floor(rng() * symbols.length)],\n        left: `${rng()*110-5}%`, top: `${rng()*110-5}%`,\n        size: 150 + rng()*450, rot: (rng()-0.5)*120, opacity: 0.02+rng()*0.03 });\n    }\n    return out;\n  }, []);\n\n  // Split line1: prefix = first word, highlighted = rest\n  const words = headlineLine1 ? headlineLine1.split(' ') : [];\n  const prefix = words[0] ? words[0] + ' ' : '';\n  const highlightedPart = words.slice(1).join(' ');\n\n  // CSS background-size gradient highlight — zero layout impact, pure inline\n  const highlightSpanStyle = {\n    background: `linear-gradient(${highlightColor}, ${highlightColor}) no-repeat left center`,\n    backgroundSize: `${highlightPct}% 88%`,\n    paddingBottom: 4,\n  };\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${canvasScale})`, transformOrigin: 'top left',\n      overflow: 'hidden', backgroundColor,\n    }}>\n\n      {/* Static background grid */}\n      <div style={{ position: 'absolute', inset: 0, zIndex: 1 }}>\n        <svg width=\"100%\" height=\"100%\">\n          <defs>\n            <pattern id=\"vgrid\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\">\n              <path d=\"M 40 0 L 40 80 M 0 40 L 80 40\" stroke=\"#999\" strokeOpacity=\"0.06\" strokeWidth=\"1.5\"/>\n              <path d=\"M 33 40 L 47 40 M 40 33 L 40 47\" stroke=\"#999\" strokeOpacity=\"0.15\" strokeWidth=\"2\"/>\n            </pattern>\n          </defs>\n          <rect width=\"100%\" height=\"100%\" fill=\"url(#vgrid)\"/>\n        </svg>\n      </div>\n\n      {/* Static watermark symbols */}\n      <div style={{ position: 'absolute', inset: 0, zIndex: 2 }}>\n        {watermarks.map(wm => (\n          <div key={wm.id} style={{\n            position: 'absolute', left: wm.left, top: wm.top,\n            fontSize: wm.size, color: '#888', opacity: wm.opacity,\n            transform: `rotate(${wm.rot}deg)`, lineHeight: 1, fontFamily: 'serif',\n          }}>{wm.char}</div>\n        ))}\n      </div>\n\n      {/* Ken Burns content layer */}\n      <div style={{\n        position: 'absolute', inset: 0, zIndex: 10,\n        transform: `translate3d(0,0,0) scale(${kenBurns})`,\n        transformOrigin: '50% 50%',\n        willChange: 'transform',\n      }}>\n        <div style={{\n          position: 'absolute', left: 240, top: 0, width: 1440, height: '100%',\n          display: 'flex', flexDirection: 'column', justifyContent: 'center', alignItems: 'flex-start',\n          fontFamily: bylineFont,\n        }}>\n\n          {/* Source badge */}\n          <div style={{ backgroundColor: sourceColor, padding: '10px 24px', marginBottom: 36 }}>\n            <span style={{ color: '#fff', fontFamily: sourceFont, fontSize: 44, fontWeight: 'bold', letterSpacing: '0.05em', lineHeight: 1 }}>\n              {sourceName}\n            </span>\n          </div>\n\n          {/* Headline — 3 lines matching reference layout */}\n          <div style={{ fontSize: 78, fontWeight: 900, lineHeight: 1.18, color: '#111', letterSpacing: '-0.02em', margin: 0, fontFamily: headlineFont }}>\n            {/* Line 1: prefix plain, rest highlighted */}\n            <div style={{ whiteSpace: 'nowrap' }}>\n              <span>{prefix}</span>\n              <span style={highlightSpanStyle}>{highlightedPart}</span>\n            </div>\n            <div style={{ whiteSpace: 'nowrap' }}>{headlineLine2}</div>\n            <div style={{ whiteSpace: 'nowrap' }}>{headlineLine3}</div>\n          </div>\n\n          {/* Byline */}\n          <div style={{ fontSize: 30, fontWeight: 'normal', color: '#444', marginTop: 36, fontFamily: bylineFont }}>\n            {bylineText}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "fc1c2614-8907-4dd4-b0ea-0ef7f272a3e0",
  "name": "Numbered list card — 4 items with circle stroke animation",
  "category": "uncategorized",
  "description": "A clean, dark editorial overlay displaying a sequenced numbered list with animated glowing circle badges and cascading text items.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "4 Ways to Fund Your Startup",
   "item1Text": "Grant Funding",
   "item2Text": "Corporate Partners",
   "item3Text": "Investor Rounds",
   "item4Text": "Carbon Credits",
   "accentColor": "#c359af",
   "textColor": "#ffffff",
   "fontFamily": "Inter",
   "transparentBackground": false
  },
  "propSchema": [
   {
