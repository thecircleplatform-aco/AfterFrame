  "thumb": "/thumbnails/751adbfe-0a1d-4d9d-97d5-21d050c75442.jpg",
  "code": "const TitleCardDrop = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const glowColor = props.glowColor;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const lines = [\n    { text: line1Text, fontSize: 180 },\n    { text: line2Text, fontSize: 180 },\n  ];\n\n  let charCount = 0;\n  const computedLines = lines.map(line => ({\n    ...line,\n    chars: line.text.split('').map(char => {\n      const index = charCount++;\n      return { char, index };\n    })\n  }));\n\n  const totalChars = charCount;\n  const stagger = 32 / Math.max(1, totalChars);\n\n  // 淡出：直接算好，乘进每个字母，不用父级 opacity\n  const fadeOutStart = Math.max(0, durationInFrames - 18);\n  const globalOpacity = interpolate(\n    frame,\n    [fadeOutStart, durationInFrames - 1],\n    [1, 0],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      backgroundColor: 'transparent',\n      display: 'flex', flexDirection: 'column',\n      alignItems: 'center', justifyContent: 'center',\n    }}>\n      <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center' }}>\n        {computedLines.map((line, lineIdx) => (\n          <div\n            key={lineIdx}\n            style={{\n              display: 'block',\n              textAlign: 'center',\n              whiteSpace: 'nowrap',\n              lineHeight: 0.88,\n            }}\n          >\n            {line.chars.map((charItem, charIdx) => {\n              const delay = charItem.index * stagger;\n              const progress = interpolate(\n                frame - delay,\n                [0, 14],\n                [0, 1],\n                { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic) }\n              );\n              const y = interpolate(progress, [0, 1], [-65, 0]);\n              const blur = interpolate(progress, [0, 1], [14, 0]);\n              // 淡入 * 淡出，合并成单一 opacity，无父级 opacity\n              const charOpacityIn = interpolate(progress, [0, 0.5, 1], [0, 0.9, 1], { extrapolateRight: 'clamp' });\n              const finalOpacity = charOpacityIn * globalOpacity;\n\n              return (\n                <span\n                  key={charIdx}\n                  style={{\n                    fontFamily: `${fontFamily}, Impact, sans-serif`,\n                    fontWeight: 400,\n                    fontSize: `${line.fontSize}px`,\n                    color: '#f6f0ff',\n                    lineHeight: 0.88,\n                    textTransform: 'uppercase',\n                    letterSpacing: '0.01em',\n                    textShadow: `0 0 8px ${glowColor}, 0 0 22px ${glowColor}, 0 0 50px rgba(246,240,255,0.4), 0 0 90px rgba(246,240,255,0.15)`,\n                    transform: `translateY(${y}px)`,\n                    filter: blur > 0.05 ? `blur(${blur}px)` : 'none',\n                    opacity: finalOpacity,\n                    display: 'inline-block',\n                    whiteSpace: 'pre',\n                  }}\n                >\n                  {charItem.char === ' ' ? '\\u00A0' : charItem.char}\n                </span>\n              );\n            })}\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};"
 },
 {
