  "thumb": "/thumbnails/5957f338-1913-4571-8f5d-07304f691bec.jpg",
  "code": "const ContributorsCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const m1Name = props.member1Name;\n  const m1Role = props.member1Role;\n  const m1Image = props.member1Image;\n  \n  const m2Name = props.member2Name;\n  const m2Role = props.member2Role;\n  const m2Image = props.member2Image;\n\n  const m3Name = props.member3Name;\n  const m3Role = props.member3Role;\n  const m3Image = props.member3Image;\n\n  const textColor = props.textColor;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const fontFamily = props.fontFamily;\n\n  const backgroundColor = props.transparentBackground ? 'transparent' : props.bgColor;\n\n  // Timings based on brief: \n  // Title at 0s, Mem1 at 0.8s (24f), Mem2 at 1.8s (54f), Mem3 at 2.8s (84f)\n  const safeFps = fps || 30;\n  const springConfig = { damping: 15, mass: 0.8, stiffness: 100 };\n\n  const titleSpring = spring({ frame, fps: safeFps, config: springConfig });\n  const m1Spring = spring({ frame: Math.max(0, frame - 24), fps: safeFps, config: springConfig });\n  const m2Spring = spring({ frame: Math.max(0, frame - 54), fps: safeFps, config: springConfig });\n  const m3Spring = spring({ frame: Math.max(0, frame - 84), fps: safeFps, config: springConfig });\n\n  // Subtle ambient motion for background blobs\n  const blobX = Math.sin(frame / 40) * 40;\n  const blobY = Math.cos(frame / 35) * 40;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    fontFamily,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    overflow: 'hidden'\n  };\n\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [30, 0]);\n\n  const PixelFrameCard = ({ name, role, image, animSpring, item }) => {\n    const yOffset = interpolate(animSpring, [0, 1], [60, 0]);\n    const opacity = animSpring;\n    \n    return (\n      <div style={{\n        display: 'flex', \n        flexDirection: 'column', \n        alignItems: 'center',\n        transform: `translateY(${yOffset}px)`,\n        opacity,\n        width: 320\n      }}>\n        <div style={{ width: 320, height: 320, position: 'relative', marginBottom: 32 }}>\n          {image ? (\n            <Img \n              src={image} \n              style={{ position: 'absolute', top: 10, left: 10, width: 300, height: 300, objectFit: 'cover', filter: 'grayscale(20%)' }}\n            />\n          ) : (\n            <div style={{ position: 'absolute', top: 10, left: 10, width: 300, height: 300, backgroundColor: 'rgba(0,0,0,0.04)' }} />\n          )}\n          <svg width=\"320\" height=\"320\" viewBox=\"0 0 320 320\" style={{ position: 'absolute', inset: 0, pointerEvents: 'none' }}>\n            <path fill={textColor} d=\"\n              M 20 0 h 280 v 10 h -280 z\n              M 20 310 h 280 v 10 h -280 z\n              M 0 20 h 10 v 280 h -10 z\n              M 310 20 h 10 v 280 h -10 z\n              M 10 10 h 10 v 10 h -10 z\n              M 300 10 h 10 v 10 h -10 z\n              M 10 300 h 10 v 10 h -10 z\n              M 300 300 h 10 v 10 h -10 z\n            \" />\n          </svg>\n        </div>\n        <div style={{ color: textColor, fontSize: 28, fontWeight: 700, marginBottom: 8, textAlign: 'center', lineHeight: 1.2 }}>{name}</div>\n        <div style={{ color: textColor, fontSize: 20, fontWeight: 400, opacity: 0.7, textAlign: 'center' }}>{role}</div>\n      </div>\n    );\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Ambient Blobs */}\n      {!props.transparentBackground && (\n        <>\n          <div style={{\n            position: 'absolute',\n            top: '5%',\n            left: '15%',\n            width: 900,\n            height: 900,\n            transform: `translate(${blobX}px, ${blobY}px)`,\n            background: `radial-gradient(circle, ${blobColor1} 0%, transparent 65%)`,\n            opacity: 0.4,\n            zIndex: 0\n          }} />\n          <div style={{\n            position: 'absolute',\n            bottom: '5%',\n            right: '10%',\n            width: 1000,\n            height: 1000,\n            transform: `translate(${-blobX}px, ${-blobY}px)`,\n            background: `radial-gradient(circle, ${blobColor2} 0%, transparent 65%)`,\n            opacity: 0.4,\n            zIndex: 0\n          }} />\n        </>\n      )}\n\n      {/* Content Container */}\n      <div style={{ position: 'relative', zIndex: 10, display: 'flex', flexDirection: 'column', alignItems: 'center', width: '100%' }}>\n        \n        <div style={{\n          color: textColor,\n          fontSize: 36,\n          fontWeight: 400,\n          letterSpacing: '0.4em',\n          textTransform: 'uppercase',\n          marginBottom: 100,\n          opacity: titleOpacity,\n          transform: `translateY(${titleY}px)`\n        }}>\n          {titleText}\n        </div>\n\n        <div style={{ display: 'flex', gap: 120 }}>\n          <PixelFrameCard name={m1Name} role={m1Role} image={m1Image} animSpring={m1Spring} />\n          <PixelFrameCard name={m2Name} role={m2Role} image={m2Image} animSpring={m2Spring} />\n          <PixelFrameCard name={m3Name} role={m3Role} image={m3Image} animSpring={m3Spring} />\n        </div>\n\n      </div>\n    </div>\n  );\n};"
 },
