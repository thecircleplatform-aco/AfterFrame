  "thumb": "/thumbnails/1d52fd05-95dc-4cee-b7ea-4ffff59b6f2d.jpg",
  "code": "const PieChartOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const label1 = props.label1;\n  const label2 = props.label2;\n  const color1 = props.color1;\n  const color2 = props.color2;\n  const bgColor = props.bgColor;\n  const textColor = props.textColor;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Phase 1: 白色圆盘从中心弹出 (0~20帧)\n  const discScale = spring({ frame, fps, config: { damping: 10, stiffness: 160, mass: 0.8 } });\n\n  // Phase 2: 橙色扇区 0→25% (30~55帧)\n  const phase2Progress = interpolate(frame, [30, 55], [0, 1], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n\n  // Phase 3: 橙色扇区 25%→50% (70~95帧)\n  const phase3Progress = interpolate(frame, [70, 95], [0, 1], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n\n  // 最终橙色扇区角度：0→180度\n  const orangeDeg = (phase2Progress * 90) + (phase3Progress * 90);\n\n  // 标注在最终状态后淡入\n  const labelOpacity = interpolate(frame, [95, 110], [0, 1], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n\n  // 中心文字：初始显示 100% Emergency Fund，橙色出现后隐藏\n  const centerTextOpacity = interpolate(frame, [20, 30], [1, 0], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp'\n  });\n\n  const labelBaseStyle = {\n    position: 'absolute',\n    opacity: labelOpacity,\n    fontFamily: 'Inter, system-ui, sans-serif',\n    fontWeight: 800, fontSize: 34,\n    color: textColor,\n    whiteSpace: 'pre-line', textAlign: 'center', lineHeight: 1.25, width: 280,\n  };\n\n  // Use CSS conic-gradient instead of SVG arc path.\n  // conic-gradient has no degeneracy at any angle (including 90°, 180°, 270°),\n  // completely eliminating the SVG arc flip/flash bug.\n  const pieStyle = {\n    width: 360,\n    height: 360,\n    borderRadius: '50%',\n    background: 'conic-gradient(from -90deg, ' + color1 + ' 0deg, ' + color1 + ' ' + orangeDeg + 'deg, ' + color2 + ' ' + orangeDeg + 'deg, ' + color2 + ' 360deg)',\n    boxShadow: '0px 12px 32px rgba(0,0,0,0.18)',\n    flexShrink: 0,\n  };\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: 'scale(' + scale + ')', transformOrigin: 'top left',\n      backgroundColor: '#ffffff',\n      display: 'flex', alignItems: 'center', justifyContent: 'center',\n    }}>\n      <div style={{\n        width: 1140, height: 800,\n        backgroundColor: bgColor, borderRadius: 40,\n        display: 'flex', justifyContent: 'center', alignItems: 'center',\n        boxShadow: '0 25px 50px -12px rgba(0,0,0,0.1)',\n        position: 'relative',\n      }}>\n        <div style={{\n          position: 'relative', width: 400, height: 400,\n          transform: 'scale(' + discScale + ')',\n          transformOrigin: 'center center',\n          display: 'flex', alignItems: 'center', justifyContent: 'center',\n        }}>\n          <div style={pieStyle} />\n\n          {/* 中心文字：100% Emergency Fund，橙色出现前显示 */}\n          <div style={{\n            position: 'absolute', top: 0, left: 0, width: 400, height: 400,\n            display: 'flex', alignItems: 'center', justifyContent: 'center',\n            opacity: centerTextOpacity,\n            pointerEvents: 'none',\n          }}>\n            <div style={{\n              fontFamily: 'Inter, system-ui, sans-serif',\n              fontWeight: 800, fontSize: 32,\n              color: '#111', textAlign: 'center', lineHeight: 1.3,\n            }}>100%{String.fromCharCode(10)}Emergency Fund</div>\n          </div>\n\n          {/* 外部标注 */}\n          <div style={{ ...labelBaseStyle, left: 420, top: 20 }}>{label1}</div>\n          <div style={{ ...labelBaseStyle, right: 420, bottom: 20 }}>{label2}</div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "7e9f53fa-3036-47a6-a27f-48acf2e49e48",
  "name": "Principle card — dot background, text left-slide",
  "category": "uncategorized",
  "description": "A cream panel with a dotted background that slides up from the bottom, followed by text elements sliding in from the left using a fast-to-slow cubic bezier easing.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "backgroundColor": "#f8f5ee",
   "dotColor": "#eee9de",
   "textColor": "#1A1A1A",
   "badgeBgColor": "#fc83bc",
   "badgeColor": "#E8E3D8",
   "titleText": "Drinking 3 liters of water is not extra —\nit's the simplest habit\nmost people skip",
   "badgeText": "2",
   "fontFamily": "Playfair Display, Georgia, serif"
  },
  "propSchema": [
