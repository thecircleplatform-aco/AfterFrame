    "code": "const KbCollageSplit = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const W = 1920, H = 1080;\n  const ink = '#2c2620';\n  const accent = p.accentColor || '#f7a8b8';\n  const butter = '#ffd66e';\n  const personRight = String(p.personSide || 'right') !== 'left';\n  const ratio = Math.min(0.72, Math.max(0.45, Number(p.contentRatio) || 0.6));\n  const splitX = Math.round(W * ratio);\n  const edgeX = personRight ? splitX : W - splitX;\n  const title = String(p.title == null ? '' : p.title);\n  const subtitle = p.subtitle == null ? '' : String(p.subtitle);\n  const enter = spring({ frame, fps, config: { damping: 13, stiffness: 125 } });\n  const popIn = spring({ frame: frame - 5, fps, config: { damping: 11, stiffness: 150 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const sway = Math.sin((frame / 140) * Math.PI * 2);\n  const mask = personRight\n    ? 'linear-gradient(90deg, #000 0 ' + splitX + 'px, transparent ' + splitX + 'px)'\n    : 'linear-gradient(90deg, transparent 0 ' + (W - splitX) + 'px, #000 ' + (W - splitX) + 'px)';\n  const teeth = 30;\n  const seg = H / teeth;\n  let zig = '';\n  for (let i = 0; i < teeth; i += 1) {\n    zig += (personRight ? '100% ' : '0 ') + ((i + 0.5) * seg) + 'px, ' + (personRight ? '30% ' : '70% ') + ((i + 1) * seg) + 'px, ';\n  }\n  const clip = personRight\n    ? 'polygon(0 0, 30% 0, ' + zig + '0 100%)'\n    : 'polygon(100% 0, 70% 0, ' + zig + '100% 100%)';\n  const contentX = personRight ? 130 : (W - splitX) + 130;\n  const lines = title.split('\\n');\n  return (\n    <AbsoluteFill style={{ opacity: exit }}>\n      <AbsoluteFill style={{ backgroundColor: '#faf5eb', WebkitMaskImage: mask, maskImage: mask, opacity: enter }}>\n        <div style={{ position: 'absolute', inset: 0, backgroundImage: 'radial-gradient(circle 2.5px, #ddd2bd 2.5px, transparent 3px)', backgroundSize: '64px 64px', backgroundPosition: '32px 32px' }} />\n        <div style={{ position: 'absolute', left: personRight ? splitX - 300 : W - splitX - 40, top: -60, width: 340, height: 220, background: accent + '80', transform: 'rotate(-9deg)', borderRadius: 8 }} />\n        <div style={{ position: 'absolute', left: personRight ? splitX - 180 : W - splitX - 160, bottom: -70, width: 280, height: 200, background: butter + '8c', transform: 'rotate(7deg)', borderRadius: 8 }} />\n      </AbsoluteFill>\n      <div style={{ position: 'absolute', left: personRight ? edgeX - 40 : edgeX - 60, top: 0, width: 100, height: H, background: '#faf5eb', clipPath: clip, WebkitClipPath: clip, filter: 'drop-shadow(' + (personRight ? '5px' : '-5px') + ' 0 0 #2c262024)' }} />\n      <div style={{ position: 'absolute', left: contentX, top: 190 + (1 - enter) * 30, opacity: enter, maxWidth: splitX - 280 }}>\n        <div style={{ display: 'inline-block', background: '#fffdf6', border: '2.5px solid ' + ink, borderRadius: 999, padding: '9px 26px', fontSize: 26, fontWeight: 800, color: ink, letterSpacing: 3, marginBottom: 40, transform: 'rotate(-2deg)', boxShadow: '4px 5px 0 ' + ink + '26' }}>口播拼贴</div>\n        {lines.map((ln, i) => (\n          <div key={i} style={{ fontSize: 100, fontWeight: 800, color: ink, lineHeight: 1.22, letterSpacing: 2 }}>\n            <span style={{ background: i === lines.length - 1 ? 'linear-gradient(0deg, ' + accent + '99 0 40%, transparent 40%)' : 'none', padding: '0 8px 4px' }}>{ln}</span>\n          </div>\n        ))}\n        {subtitle ? (\n          <div style={{ marginTop: 30, fontSize: 33, fontWeight: 700, color: ink + 'ba', letterSpacing: 4, borderBottom: '3.5px dashed ' + ink + '66', display: 'inline-block', paddingBottom: 12 }}>{subtitle}</div>\n        ) : null}\n      </div>\n      <svg viewBox=\"0 0 100 100\" style={{ position: 'absolute', width: 88, height: 88, left: personRight ? splitX - 240 : W - splitX + 150, top: 150 + sway * 5, transform: 'rotate(' + (14 + sway * 5) + 'deg)', opacity: popIn }}>\n        <path d=\"M50 6 L60 38 L94 38 L66 57 L76 90 L50 70 L24 90 L34 57 L6 38 L40 38 Z\" fill={butter} stroke={ink} strokeWidth=\"4\" strokeLinejoin=\"round\" />\n      </svg>\n      <div style={{ position: 'absolute', left: personRight ? splitX + 60 : 60, top: 54, width: 170, height: 46, background: accent + 'a6', transform: 'rotate(-6deg)', boxShadow: '0 3px 10px #2c262018', opacity: popIn }} />\n      <div style={{ position: 'absolute', right: personRight ? 60 : undefined, left: personRight ? undefined : W - splitX + 40, bottom: 52, width: 150, height: 42, background: butter + 'a6', transform: 'rotate(5deg)', boxShadow: '0 3px 10px #2c262018', opacity: popIn }} />\n    </AbsoluteFill>\n  );\n};"
