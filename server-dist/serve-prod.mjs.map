    "code": "const KbBeigeGrid = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const W = 1920, H = 1080, M = 96;\n  const ink = '#292421';\n  const accent = p.accentColor || '#ffd66e';\n  const paper = p.bgColor || '#f6f1e6';\n  const pos = String(p.position || 'bottom-right');\n  const R = Math.min(300, Math.max(110, Number(p.size) || 160));\n  const left = pos.indexOf('left') >= 0;\n  const top = pos.indexOf('top') >= 0;\n  const cx = left ? M + R : W - M - R;\n  const cy = top ? M + R : H - M - R;\n  const title = p.title == null ? '' : String(p.title);\n  const subtitle = p.subtitle == null ? '' : String(p.subtitle);\n  const handle = p.handle == null ? '' : String(p.handle);\n  const enter = spring({ frame, fps, config: { damping: 13, stiffness: 130 } });\n  const popIn = spring({ frame: frame - 5, fps, config: { damping: 11, stiffness: 150 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const sway = Math.sin((frame / 130) * Math.PI * 2);\n  const hole = 'radial-gradient(circle ' + R + 'px at ' + cx + 'px ' + cy + 'px, transparent ' + (R - 1) + 'px, #000 ' + R + 'px)';\n  const titleX = left ? cx + R + 110 : 120;\n  return (\n    <AbsoluteFill style={{ opacity: exit }}>\n      <AbsoluteFill style={{ backgroundColor: paper, WebkitMaskImage: hole, maskImage: hole, opacity: enter }}>\n        <div style={{ position: 'absolute', inset: 0, backgroundImage: 'linear-gradient(90deg, #d3c5a3a6 2px, transparent 2px), linear-gradient(180deg, #d3c5a3a6 2px, transparent 2px)', backgroundSize: '76px 76px', backgroundPosition: '38px 26px' }} />\n        <div style={{ position: 'absolute', inset: 34, border: '2.5px solid ' + ink + 'd9', borderRadius: 26 }} />\n      </AbsoluteFill>\n      {title ? (\n        <div style={{ position: 'absolute', left: titleX, top: 128 + (1 - enter) * 30, opacity: enter, maxWidth: 1040, transform: 'rotate(' + (-0.6 + (1 - enter) * -2) + 'deg)' }}>\n          <span style={{ display: 'inline-block', fontSize: 86, fontWeight: 800, color: ink, lineHeight: 1.3, letterSpacing: 2, background: 'linear-gradient(0deg, ' + accent + ' 0 46%, transparent 46%)', padding: '0 18px 6px' }}>{title}</span>\n          {subtitle ? (\n            <div style={{ marginTop: 26, marginLeft: 20, display: 'inline-block', fontSize: 33, fontWeight: 700, color: ink + 'cc', letterSpacing: 3, borderBottom: '3.5px dashed #e8582e', paddingBottom: 12 }}>{subtitle}</div>\n          ) : null}\n        </div>\n      ) : null}\n      <div style={{ position: 'absolute', left: (left ? cx + R + 76 : titleX) - 6, top: 96, width: 168, height: 46, background: accent + '8c', transform: 'rotate(-7deg)', boxShadow: '0 3px 10px #29242118', opacity: enter }} />\n      <svg viewBox=\"0 0 100 100\" style={{ position: 'absolute', width: 96, height: 96, left: left ? W - 300 : Math.round(0.62 * W), top: 210 + sway * 5, transform: 'rotate(' + (12 + sway * 6) + 'deg)', opacity: popIn }}>\n        <path d=\"M50 6 L60 38 L94 38 L66 57 L76 90 L50 70 L24 90 L34 57 L6 38 L40 38 Z\" fill={accent} stroke={ink} strokeWidth=\"4\" strokeLinejoin=\"round\" />\n      </svg>\n      <svg viewBox=\"0 0 120 60\" style={{ position: 'absolute', width: 150, height: 75, left: cx + (left ? R + 26 : -R - 176), top: cy - R - 66 + sway * 4, transform: left ? 'scaleX(-1) rotate(8deg)' : 'rotate(8deg)', opacity: popIn }}>\n        <path d=\"M8 12 C 40 2, 78 6, 102 34\" fill=\"none\" stroke={ink} strokeWidth=\"5\" strokeLinecap=\"round\" strokeDasharray=\"3 9\" />\n        <path d=\"M92 26 L104 36 L88 40 Z\" fill={ink} />\n      </svg>\n      <div style={{ position: 'absolute', left: cx - R, top: cy - R, width: R * 2, height: R * 2, transform: 'scale(' + (0.72 + popIn * 0.28) + ')' }}>\n        <div style={{ position: 'absolute', inset: -12, borderRadius: '50%', border: '11px solid #fffdf8', boxShadow: '0 0 0 3px ' + ink + ', 10px 12px 0 ' + ink + '21' }} />\n      </div>\n      {handle ? (\n        <div style={{ position: 'absolute', left: cx, top: cy + R - 4, transform: 'translateX(-50%) rotate(3deg)', opacity: popIn, background: '#fffdf8', border: '2.5px solid ' + ink, borderRadius: 999, padding: '8px 24px', fontSize: 27, fontWeight: 800, color: ink, whiteSpace: 'nowrap', boxShadow: '4px 5px 0 ' + ink + '2b' }}>{handle}</div>\n      ) : null}\n    </AbsoluteFill>\n  );\n};"
  },
