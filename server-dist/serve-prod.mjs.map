  ],
  "thumb": "/thumbnails/0d6f793e-8501-479e-bd78-f75dc32fb0aa.jpg",
  "code": "const FruitChecklist = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  // CONFIGURATION\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // EDITABLE PROPERTIES\n  const po = item?.propertyOverrides || {};\n  const item1Text = po.item1Text ?? \"CARBON FRAME\";\n  const item2Text = po.item2Text ?? \"DISC BRAKES\";\n  const item3Text = po.item3Text ?? \"URBAN RIDING GEAR\";\n  const textColor = po.textColor ?? \"#FFFFFF\";\n  const checkColor = po.checkColor ?? \"#de72c9\";\n  const boxBorderColor = po.boxBorderColor ?? \"#FFFFFF\";\n  const listX = po.listX ?? 150;\n  const listY = po.listY ?? 650;\n  const rowSpacing = po.rowSpacing ?? 120;\n  const fontSize = po.fontSize ?? 60;\n\n  // CONTENT\n  const items = [\n    { id: 1, text: item1Text, startFrame: 10 },\n    { id: 2, text: item2Text, startFrame: 40 },\n    { id: 3, text: item3Text, startFrame: 70 }\n  ];\n\n  const CHECK_DELAY = 15;\n  const EXIT_START_FRAME = 105;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: 'transparent',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    fontFamily: 'Inter, Roboto, sans-serif',\n    fontWeight: 900,\n    overflow: 'hidden'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {items.map((listItem, i) => {\n        const slideProgress = spring({\n          frame: frame - listItem.startFrame,\n          fps,\n          config: { damping: 16, stiffness: 120, mass: 0.8 }\n        });\n\n        const checkStartFrame = listItem.startFrame + CHECK_DELAY;\n        const checkProgress = spring({\n          frame: frame - checkStartFrame,\n          fps,\n          config: { damping: 14, stiffness: 100 }\n        });\n\n        const isVisible = frame >= listItem.startFrame;\n        const checkVisible = frame >= checkStartFrame;\n\n        const boxRotationProgress = spring({\n          frame: frame - listItem.startFrame,\n          fps,\n          config: { damping: 8, stiffness: 150, mass: 0.6 }\n        });\n\n        const exitFrames = frame - EXIT_START_FRAME;\n        const exitDuration = 18;\n        const isExiting = frame >= EXIT_START_FRAME;\n        const exitRaw = Math.min(Math.max(exitFrames / exitDuration, 0), 1);\n        const exitEased = 1 - Math.pow(1 - exitRaw, 3);\n\n        const enterY = interpolate(slideProgress, [0, 1], [60, 0]);\n        const translateY = enterY;\n        const enterOpacity = isVisible ? interpolate(slideProgress, [0, 1], [0, 1]) : 0;\n        const exitOpacity = isExiting ? interpolate(exitEased, [0, 1], [1, 0]) : 1;\n        const opacity = enterOpacity * exitOpacity;\n        const boxRotation = isVisible ? interpolate(boxRotationProgress, [0, 1], [25, 0]) : 25;\n        const checkOpacity = checkVisible ? 1 : 0;\n\n        const rowStyle = {\n          position: 'absolute',\n          left: listX,\n          top: listY + (i * rowSpacing),\n          display: 'flex',\n          alignItems: 'center',\n          gap: '30px',\n          transform: `translateY(${translateY}px)`,\n          opacity,\n        };\n\n        const boxStyle = {\n          width: '60px',\n          height: '60px',\n          backgroundColor: 'transparent',\n          border: `5px solid ${boxBorderColor}`,\n          display: 'flex',\n          justifyContent: 'center',\n          alignItems: 'center',\n          position: 'relative',\n          transform: `rotate(${boxRotation}deg)`,\n        };\n\n        const textStyle = {\n          fontSize: `${fontSize}px`,\n          color: textColor,\n          textTransform: 'uppercase',\n          margin: 0,\n          lineHeight: 1,\n          textShadow: '2px 2px 0px #000000, 0 8px 20px rgba(0,0,0,0.6)',\n          letterSpacing: '-1px'\n        };\n\n        return (\n          <div key={listItem.id} style={rowStyle}>\n            <div style={boxStyle}>\n              <svg\n                width=\"85\"\n                height=\"85\"\n                viewBox=\"0 0 100 100\"\n                style={{ overflow: 'visible', opacity: checkOpacity, position: 'absolute', top: '-15px', left: '-15px' }}\n              >\n                <path\n                  d=\"M 8 50 Q 22 68 32 80\"\n                  fill=\"none\"\n                  stroke={checkColor}\n                  strokeWidth=\"18\"\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  strokeDasharray=\"80\"\n                  strokeDashoffset={interpolate(checkProgress, [0, 0.4], [80, 0], {extrapolateRight: 'clamp'})}\n                />\n                <polygon\n                  points=\"24,72 40,88 98,-8 88,-2\"\n                  fill={checkColor}\n                  style={{\n                    clipPath: `inset(${interpolate(checkProgress, [0.3, 1], [100, 0], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'})}% 0 0 0)`\n                  }}\n                />\n              </svg>\n            </div>\n            <h1 style={textStyle}>{listItem.text}</h1>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
 },
 {
  "id": "e0d468df-601e-4ac6-befe-9870696b4f2c",
  "name": "Fruit Shopping Tips",
  "category": "infographics",
  "description": "Four-tip explainer card with a bold headline, subtitle, and editable checklist items.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleLine1": "The 4 Rules for",
   "titleLine2": "\"Melon Buying\"",
   "subtitle": "How to spot the sweetest melon",
   "tip1": "Weight",
   "tip2": "Aroma",
   "tip3": "Softspots",
   "tip4": "Stem Color"
  },
  "propSchema": [
