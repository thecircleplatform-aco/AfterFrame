  "thumb": "/thumbnails/2995a5a5-7240-4c9a-8528-c167b8dce239.jpg",
  "code": "const RetroAlertCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'NEW ROAST DROPPED';\n  const subtitleText = props.subtitleText || 'Fresh beans shipping to all members';\n  const tickerText = props.tickerText || 'BEAN ALERT';\n  \n  const cardColor = props.cardColor || '#FFFFFF';\n  const headerColor = props.headerColor || '#ff1d08';\n  const shadowColor = props.shadowColor || '#000000';\n  const textColor = props.textColor || '#000000';\n  const tickerColor = props.tickerColor || '#FFFFFF';\n  \n  const titleFont = props.titleFont || '\"Silkscreen\", sans-serif';\n  const bodyFont = props.bodyFont || '\"VT323\", monospace';\n\n  const DESIGN_WIDTH = 660;\n  const DESIGN_HEIGHT = 220;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const bounce = spring({\n    frame,\n    fps,\n    config: { stiffness: 250, damping: 10, mass: 1.1 }\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  const cardRotation = interpolate(bounce, [0, 1], [-8, 0]);\n  \n  const cardStyle = {\n    width: 540,\n    height: 150,\n    backgroundColor: cardColor,\n    border: '3px solid #000',\n    boxShadow: `4px 4px 0px ${cardColor}, 8px 8px 0px ${shadowColor}`,\n    transform: `scale(${bounce}) rotate(${cardRotation}deg)`,\n    transformOrigin: 'center center',\n    display: 'flex',\n    flexDirection: 'column',\n    position: 'relative',\n  };\n\n  const headerStyle = {\n    backgroundColor: headerColor,\n    borderBottom: '3px solid #000',\n    height: 32,\n    display: 'flex',\n    alignItems: 'center',\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n    width: '100%',\n    boxSizing: 'border-box',\n  };\n\n  const tickerRepeated = Array(40).fill(tickerText).join(\"  +++  \");\n  const tickerMove = -(frame * 2.5);\n\n  const tickerStyle = {\n    fontFamily: bodyFont,\n    fontSize: '18px',\n    color: tickerColor,\n    textTransform: 'uppercase',\n    transform: `translateX(${tickerMove}px)`,\n    paddingLeft: '10px',\n    whiteSpace: 'nowrap',\n  };\n\n  const bodyStyle = {\n    flex: 1,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    padding: '0 20px',\n    textAlign: 'center',\n    boxSizing: 'border-box',\n  };\n\n  const titleStyle = {\n    fontFamily: titleFont,\n    fontSize: '28px',\n    fontWeight: 'bold',\n    color: textColor,\n    textTransform: 'uppercase',\n    marginBottom: '8px',\n    lineHeight: 1.1,\n  };\n\n  const subtitleStyle = {\n    fontFamily: bodyFont,\n    fontSize: '24px',\n    color: textColor,\n    opacity: 0.85,\n    lineHeight: 1.1,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n         <div style={headerStyle}>\n            <div style={tickerStyle}>{tickerRepeated}</div>\n         </div>\n         <div style={bodyStyle}>\n            <div style={titleStyle}>{titleText}</div>\n            <div style={subtitleStyle}>{subtitleText}</div>\n         </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "7c576ae9-ee31-4727-ad3b-b71891bc3e21",
  "name": "Cinematic Welcome Screen",
  "category": "title-cards",
  "description": "Elegant cinematic welcome screen with dark charcoal background, drifting diagonal text texture, and refined serif typography.",
  "width": 1920,
  "height": 1080,
