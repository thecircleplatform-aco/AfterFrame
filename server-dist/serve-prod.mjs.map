  "thumb": "/thumbnails/ec6ac23d-85e8-4b16-9135-7665f5a03aa8.jpg",
  "code": "const PaperFlashcards = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const p = item.props || {};\n\n  const row1w1 = p.row1w1 || 'input';\n  const row1w2 = p.row1w2 || 'goals';\n  const row2w1 = p.row2w1 || 'output';\n  const row2w2 = p.row2w2 || 'goals';\n  const row3w1 = p.row3w1 || 'outcome';\n  const row3w2 = p.row3w2 || 'goals';\n  const note1  = p.note1  || 'spend 15 hours/week\\non my channel';\n  const note2  = p.note2  || 'post 1 video\\nevery week';\n  const note3  = p.note3  || 'gain x subscribers\\nevery month';\n  const textColor = p.textColor || '#708a3b';\n\n  const DESIGN_WIDTH  = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scl = Math.min(\n    (item?.width  || DESIGN_WIDTH)  / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n  const F = fps || 30;\n\n  // Intro / outro slide timing\n  const INTRO = Math.round(0.8 * F);   // 0.8s slide-in\n  const TOTAL = Math.round(11 * F);    // total 11s\n  const OUTRO_START = TOTAL - Math.round(0.8 * F); // last 0.8s slide-out\n\n  // 1拍三 slide offset (choppy, no easing)\n  const q3frame = Math.floor(frame / 3) * 3;\n  let slideY = 0;\n  if (q3frame < INTRO) {\n    // Slide in: from DESIGN_HEIGHT down to 0, in steps\n    const steps = Math.floor(INTRO / 3);\n    const step = Math.floor(q3frame / 3);\n    slideY = Math.round(DESIGN_HEIGHT * (1 - step / steps));\n  } else if (q3frame >= OUTRO_START) {\n    // Slide out: from 0 up to -DESIGN_HEIGHT\n    const steps = Math.floor((TOTAL - OUTRO_START) / 3);\n    const step = Math.floor((q3frame - OUTRO_START) / 3);\n    slideY = -Math.round(DESIGN_HEIGHT * (step / steps));\n  }\n\n  // Offset inner frame so original animation timing is preserved\n  const innerFrame = Math.max(0, frame - INTRO);\n\n  // Static paper background\n  const bg = '#def0e3';\n  const noiseSeed = 7;\n\n  // Static ink dots — small, sparse, natural\n  const dots = Array.from({ length: 22 }, (_, i) => {\n    const h = (n) => Math.abs(Math.sin(n * 9301.7 + i * 127.1) % 1);\n    return {\n      x: h(1) * 100,\n      y: h(2) * 100,\n      sz: 1.0 + h(3) * 2.5,\n      op: 0.12 + h(4) * 0.22,\n    };\n  });\n\n  // 1拍三 helpers\n  const q3 = (f) => Math.floor(f / 3) * 3;\n\n  const wordAnim = (t) => {\n    if (innerFrame < t) return { op: 0, ty: 20 };\n    const loc = q3(innerFrame - t);\n    if (loc < 3) return { op: 0.7, ty: 10 };\n    return { op: 1, ty: 0 };\n  };\n\n  const choppyOp = (t) => {\n    if (innerFrame < t) return 0;\n    const loc = q3(innerFrame - t);\n    if (loc < 3) return 0.5;\n    if (loc < 6) return 0.8;\n    return 1;\n  };\n\n  // Timing\n  const c1  = Math.floor(0.4 * F);\n  const w1a = c1,      w1b = c1 + 6;\n  const c2  = Math.floor(1.8 * F);\n  const w2a = c2,      w2b = c2 + 6;\n  const c3  = Math.floor(3.2 * F);\n  const w3a = c3,      w3b = c3 + 6;\n  const n1  = w1b + 8;\n  const n2  = w2b + 8;\n  const n3  = w3b + 8;\n\n  const CARD_W = 740;\n  const CARD_H = 112;\n\n  // Horizontally centred, with small organic offsets per row (matching original video)\n  const centerX   = (DESIGN_WIDTH - CARD_W) / 2; // = 590, all cards same left\n  const card1Left = centerX;\n  const card2Left = centerX;\n  const card3Left = centerX;\n  const card1Top  = 270;\n  const card2Top  = 480;\n  const card3Top  = 672;\n\n  const Word = ({ text, t }) => {\n    const { op, ty } = wordAnim(t);\n    return (\n      <span style={{\n        display: 'inline-block',\n        opacity: op,\n        transform: `translateY(${ty}px)`,\n        fontFamily: '\"Nunito\", sans-serif',\n        fontWeight: '800',\n        fontSize: '74px',\n        color: textColor,\n        letterSpacing: '-1px',\n        lineHeight: 1,\n      }}>\n        {text}\n      </span>\n    );\n  };\n\n  // Card entrance: 1拍三 scale pop — 3 steps over 9 frames\n  const cardAnim = (tw1) => {\n    if (innerFrame < tw1) return { scaleV: 0, ty: 16, op: 0 };\n    const step = Math.min(3, Math.floor((innerFrame - tw1) / 3));\n    if (step === 0) return { scaleV: 0.7, ty: 12, op: 0.6 };\n    if (step === 1) return { scaleV: 1.08, ty: 4,  op: 0.85 };\n    if (step === 2) return { scaleV: 1.0,  ty: 0,  op: 1 };\n    return { scaleV: 1.0, ty: 0, op: 1 };\n  };\n\n  const Card = ({ w1, w2, tw1, tw2, left, top }) => {\n    if (innerFrame < tw1) return null;\n    const { scaleV, ty, op } = cardAnim(tw1);\n    return (\n      <div style={{\n        position: 'absolute',\n        left,\n        top,\n        width: CARD_W,\n        height: CARD_H,\n        opacity: op,\n        transform: `translateY(${ty}px) scale(${scaleV})`,\n        transformOrigin: 'center center',\n        backgroundColor: 'rgba(255,255,255,0.88)',\n        borderRadius: '18px',\n        border: '1.5px solid rgba(0,0,0,0.06)',\n        boxShadow: '3px 5px 0 rgba(0,0,0,0.06)',\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'center',\n        gap: '18px',\n        overflow: 'hidden',\n      }}>\n        <Word text={w1} t={tw1} />\n        <Word text={w2} t={tw2} />\n      </div>\n    );\n  };\n\n  // Note text\n  const Note = ({ text, t, style }) => {\n    const op = choppyOp(t);\n    if (op === 0) return null;\n    return (\n      <div style={{ position: 'absolute', opacity: op, pointerEvents: 'none', ...style }}>\n        <span style={{\n          display: 'block',\n          fontFamily: '\"Nunito\", sans-serif',\n          fontStyle: 'italic',\n          fontWeight: '400',\n          fontSize: '34px',\n          color: textColor,\n          whiteSpace: 'pre-line',\n          lineHeight: 1.4,\n          textAlign: 'center',\n        }}>{text}</span>\n      </div>\n    );\n  };\n\n  // SVG arrow — absolute positioned, connects note to card edge\n  // We pass exact pixel coords for start and end of the arc\n  const Arrow = ({ t, x1, y1, x2, y2 }) => {\n    if (innerFrame < t) return null;\n    // Calculate bounding box\n    const minX = Math.min(x1, x2) - 20;\n    const minY = Math.min(y1, y2) - 60;\n    const maxX = Math.max(x1, x2) + 20;\n    const maxY = Math.max(y1, y2) + 20;\n    const w = maxX - minX;\n    const h = maxY - minY;\n    const lx1 = x1 - minX;\n    const ly1 = y1 - minY;\n    const lx2 = x2 - minX;\n    const ly2 = y2 - minY;\n    const cpx = (lx1 + lx2) / 2;\n    const cpy = Math.min(ly1, ly2) - 70;\n    const pathD = `M ${lx1} ${ly1} Q ${cpx} ${cpy} ${lx2} ${ly2}`;\n\n    // Path length estimate\n    const pathLen = Math.round(Math.sqrt(Math.pow(lx2-lx1,2) + Math.pow(ly2-ly1,2)) * 1.4);\n\n    // 1拍三 growth: 5 steps × 3 frames = 15 frames total\n    // Use direct floor division (no nested q3) to prevent shrink-back on boundary frames\n    const stepCount = 5;\n    const step = Math.min(stepCount, Math.floor((innerFrame - t) / 3));\n    const revealLen = Math.round(pathLen * (step / stepCount));\n\n    // Two-layer reveal: dashed line underneath, cover mask on top shrinking from right.\n    // Layer 1: fixed \"13 9\" dashed path (always full length)\n    // Layer 2: background-color solid path with dasharray \"0 revealLen 99999\"\n    //          — hides everything from revealLen onwards (no loop logic, no edge-case bugs)\n    const headOpacity = step >= stepCount ? 0.75 : 0;\n    const coverStart = revealLen > 0 ? revealLen : 0;\n\n    return (\n      <svg\n        style={{ position: 'absolute', left: minX, top: minY, overflow: 'visible', pointerEvents: 'none' }}\n        width={w} height={h} viewBox={`0 0 ${w} ${h}`} fill=\"none\"\n      >\n        {/* Layer 1: full dashed line */}\n        <path\n          d={pathD}\n          stroke=\"#2a2a2a\"\n          strokeWidth=\"5\"\n          strokeDasharray=\"13 9\"\n          strokeLinecap=\"round\"\n          fill=\"none\"\n        />\n        {/* Layer 2: cover mask — hides the portion not yet revealed */}\n        <path\n          d={pathD}\n          stroke=\"#def0e3\"\n          strokeWidth=\"7\"\n          strokeDasharray={`0 ${coverStart} 99999`}\n          strokeLinecap=\"butt\"\n          fill=\"none\"\n        />\n        <circle cx={lx2} cy={ly2} r=\"4\" fill=\"#2a2a2a\" opacity={headOpacity} />\n      </svg>\n    );\n  };\n\n  // Precise note + arrow positions matching original video:\n  // Note1: top-left, its right edge connects to card1 top-left corner area\n  //   note1 centre ~(300, 130), card1 top-left ~(530, 165)\n  // Note2: right side, its left edge connects to card2 right edge\n  //   note2 centre ~(1480, 330), card2 right edge ~(1240, 430)\n  // Note3: bottom-left, its right edge connects to card3 left edge\n  //   note3 centre ~(240, 660), card3 left ~(460, 614)\n\n  return (\n    <div style={{\n      width: DESIGN_WIDTH,\n      height: DESIGN_HEIGHT,\n      transform: `scale(${scl}) translateY(${slideY}px)`,\n      transformOrigin: 'top left',\n      backgroundColor: bg,\n      position: 'relative',\n      overflow: 'hidden',\n    }}>\n\n      {/* Static paper texture — single soft noise layer */}\n      <svg style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', pointerEvents: 'none' }}>\n        <filter id=\"paper-texture\" x=\"0%\" y=\"0%\" width=\"100%\" height=\"100%\" colorInterpolationFilters=\"sRGB\">\n          <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.65\" numOctaves=\"4\" stitchTiles=\"stitch\" seed={noiseSeed} result=\"noise\" />\n          <feColorMatrix type=\"saturate\" values=\"0\" in=\"noise\" result=\"grey\" />\n          <feBlend in=\"SourceGraphic\" in2=\"grey\" mode=\"overlay\" result=\"blended\" />\n          <feComponentTransfer in=\"blended\">\n            <feFuncA type=\"linear\" slope=\"0.15\" />\n          </feComponentTransfer>\n        </filter>\n        <rect width=\"100%\" height=\"100%\" filter=\"url(#paper-texture)\" fill=\"#93c5c4\" />\n      </svg>\n\n      {/* Ink dots */}\n      {dots.map((d, i) => (\n        <div key={i} style={{\n          position: 'absolute',\n          left: `${d.x}%`, top: `${d.y}%`,\n          width: d.sz, height: d.sz,\n          borderRadius: '50%',\n          backgroundColor: '#1c1410',\n          opacity: d.op,\n          pointerEvents: 'none',\n        }} />\n      ))}\n\n      {/* Cards */}\n      <Card w1={row1w1} w2={row1w2} tw1={w1a} tw2={w1b} left={card1Left} top={card1Top} />\n      <Card w1={row2w1} w2={row2w2} tw1={w2a} tw2={w2b} left={card2Left} top={card2Top} />\n      <Card w1={row3w1} w2={row3w2} tw1={w3a} tw2={w3b} left={card3Left} top={card3Top} />\n\n      {/* Note 1 — top left, arrow curves to card1 top-left */}\n      <Note text={note1} t={n1} style={{ top: 140, left: 100, width: 320, textAlign: 'center' }} />\n      <Arrow t={n1} x1={420} y1={230} x2={card1Left + 40} y2={card1Top + 8} />\n\n      {/* Note 2 — right side, arrow from card2 right edge to note */}\n      <Note text={note2} t={n2} style={{ top: 396, right: 90, width: 300, textAlign: 'center' }} />\n      <Arrow t={n2} x1={DESIGN_WIDTH - 90 - 300 + 20} y1={card2Top + 20} x2={card2Left + CARD_W + 12} y2={card2Top + 56} />\n\n      {/* Note 3 — bottom left, arrow to card3 left edge */}\n      <Note text={note3} t={n3} style={{ top: 740, left: 80, width: 330, textAlign: 'center' }} />\n      <Arrow t={n3} x1={410} y1={792} x2={card3Left + 16} y2={card3Top + CARD_H - 24} />\n\n    </div>\n  );\n};\n"
 },
 {
  "id": "cc793049-2b5e-4e06-b952-9834524bb169",
  "name": "Golden Chapter Card",
  "category": "title-cards",
  "description": "Luxury-inspired chapter card with bold typography, gold accents, and a clean editorial layout.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "mainText": "STUDIO PORTFOLIO",
   "subText": "FEATURED SHOTS",
   "sphereNumber": "",
   "animSpeed": 1,
   "exitDuration": 3
  },
  "propSchema": [
   {
    "key": "mainText",
    "type": "text",
    "defaultValue": "STUDIO PORTFOLIO",
    "label": "Main title"
   },
   {
    "key": "subText",
    "type": "text",
    "defaultValue": "FEATURED SHOTS",
    "label": "Subtitle"
   },
   {
    "key": "sphereNumber",
    "type": "text",
    "defaultValue": "",
    "label": "Badge number"
   },
   {
    "key": "animSpeed",
    "type": "number",
    "defaultValue": 1,
    "label": "Animation speed"
   },
   {
    "key": "exitDuration",
    "type": "number",
    "defaultValue": 3,
    "label": "Exit start (sec)"
   }
  ],
  "thumb": "/thumbnails/cc793049-2b5e-4e06-b952-9834524bb169.jpg",
  "code": "const GoldenChapterCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  // Editable properties\n  const mainText = item?.propertyOverrides?.mainText ?? 'STUDIO PORTFOLIO';\n  const subText = item?.propertyOverrides?.subText ?? 'FEATURED SHOTS';\n  const sphereNumber = item?.propertyOverrides?.sphereNumber ?? '';\n  const sphereXProp = item?.propertyOverrides?.sphereX ?? 1200;\n  const sphereYProp = item?.propertyOverrides?.sphereY ?? 480;\n  const bannerMaxWidth = item?.propertyOverrides?.bannerMaxWidth ?? 520;\n  const bannerPaddingRight = item?.propertyOverrides?.bannerPaddingRight ?? 30;\n  const animSpeed = item?.propertyOverrides?.animSpeed ?? 1;\n  const exitDurationSec = item?.propertyOverrides?.exitDuration ?? 3;\n\n  // Canvas Logic\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Animation timing\n  const exitStartFrame = fps * exitDurationSec;\n  const entranceDuration = 40;\n  const isExiting = frame >= exitStartFrame;\n  const exitFrame = frame - exitStartFrame;\n  const reversedFrame = isExiting ? Math.max(0, entranceDuration - exitFrame) : frame;\n  const effectiveFrame = isExiting ? reversedFrame : frame;\n  const scaledFrame = effectiveFrame / Math.max(0.1, animSpeed);\n\n  // Animations\n  const sphereSpring = spring({\n    frame: scaledFrame,\n    fps,\n    config: { damping: 20, stiffness: 120, mass: 0.6 },\n  });\n\n  const bannerSpring = spring({\n    frame: scaledFrame - 15,\n    fps,\n    config: { damping: 18, stiffness: 80 },\n  });\n\n  const textSpring = spring({\n    frame: scaledFrame - 25,\n    fps,\n    config: { damping: 22, stiffness: 90 },\n  });\n\n  // Interpolations\n  const sphereScale = interpolate(sphereSpring, [0, 1], [0, 1]);\n\n  const bannerWidth = interpolate(bannerSpring, [0, 1], [0, bannerMaxWidth]);\n  const bannerOpacity = interpolate(bannerSpring, [0, 0.2], [0, 1]);\n\n  const contentOpacity = interpolate(textSpring, [0, 1], [0, 1]);\n  const contentTranslate = interpolate(textSpring, [0, 1], [30, 0]);\n\n  // 3D ball number rotation\n  const spinProgress = spring({ frame: scaledFrame, fps, config: { damping: 25, stiffness: 100, mass: 0.8 } });\n  const rotateY = interpolate(spinProgress, [0, 1], [-180, 0]);\n  const numberScaleX = Math.cos(rotateY * Math.PI / 180);\n  const numberOpacity = rotateY > -90 ? 1 : 0;\n\n  // Styling Constants\n  const POS_X = sphereXProp;\n  const POS_Y = sphereYProp;\n  const SPHERE_SIZE = 140;\n  const BANNER_HEIGHT = 110;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    fontFamily: '\"Montserrat\", \"Inter\", sans-serif',\n  };\n\n  const containerStyle = {\n    position: 'absolute',\n    top: POS_Y - (SPHERE_SIZE / 2),\n    left: POS_X - (SPHERE_SIZE / 2),\n    width: SPHERE_SIZE + 600,\n    height: SPHERE_SIZE + 50,\n  };\n\n  const bannerStyle = {\n    position: 'absolute',\n    top: (SPHERE_SIZE - BANNER_HEIGHT) / 2,\n    left: SPHERE_SIZE / 2,\n    width: bannerWidth,\n    height: BANNER_HEIGHT,\n    backgroundColor: '#111111',\n    border: '2px solid #dab8ff',\n    borderLeft: 'none',\n    borderRadius: '0 12px 12px 0',\n    overflow: 'hidden',\n    opacity: bannerOpacity,\n    boxShadow: '0 8px 25px rgba(0,0,0,0.4)',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    paddingLeft: SPHERE_SIZE / 2 + 30,\n    paddingRight: bannerPaddingRight,\n  };\n\n  const textContainerStyle = {\n    opacity: contentOpacity,\n    transform: `translateX(${contentTranslate}px)`,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n  };\n\n  const mainTextStyle = {\n    color: '#dab8ff',\n    fontSize: '32px',\n    fontWeight: 800,\n    letterSpacing: '1px',\n    marginBottom: '2px',\n    whiteSpace: 'nowrap',\n    textTransform: 'uppercase',\n    textShadow: '0 2px 10px rgba(218,184,255, 0.2)',\n  };\n\n  const subTextStyle = {\n    color: '#e3cbff',\n    fontSize: '16px',\n    fontWeight: 600,\n    letterSpacing: '3px',\n    textTransform: 'uppercase',\n  };\n\n  const subStripStyle = {\n    marginTop: '6px',\n    width: '100%',\n    height: '4px',\n    backgroundColor: '#3e408d',\n    borderRadius: '2px',\n  };\n\n  const sphereStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: SPHERE_SIZE,\n    height: SPHERE_SIZE,\n    borderRadius: '50%',\n    background: 'radial-gradient(circle at 35% 35%, #e3cbff 0%, #dab8ff 45%, #937bfd 80%, #4b4eac 100%)',\n    boxShadow: '0 15px 35px rgba(0,0,0,0.5), inset -8px -8px 20px rgba(0,0,0,0.2), inset 8px 8px 20px rgba(255,255,255,0.15)',\n    transform: `scale(${sphereScale})`,\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    zIndex: 10,\n    overflow: 'hidden',\n  };\n\n  const numberStyle = {\n    color: '#1c1d49',\n    fontSize: '72px',\n    fontWeight: 900,\n    fontFamily: '\"Oswald\", sans-serif',\n    transform: `scaleX(${numberScaleX})`,\n    opacity: numberOpacity,\n    textShadow: numberScaleX > 0.5 ? '2px 2px 4px rgba(0,0,0,0.3)' : 'none',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={containerStyle}>\n        <div style={bannerStyle}>\n          <div style={textContainerStyle}>\n            <div style={mainTextStyle}>{mainText}</div>\n            <div style={subTextStyle}>{subText}</div>\n            <div style={subStripStyle} />\n          </div>\n        </div>\n        <div style={sphereStyle}>\n          {sphereNumber ? <span style={numberStyle}>{sphereNumber}</span> : null}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "1ed40a68-6303-427a-94f9-5197a0af7869",
  "name": "Location Title Card",
