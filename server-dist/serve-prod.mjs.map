  "thumb": "/thumbnails/f767f837-0255-49c4-8f17-01a168f1f7a3.jpg",
  "code": "const MinimalGradientAnchor = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const textColor = props.textColor;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const chartColor1 = props.chartColor1;\n  const chartColor2 = props.chartColor2;\n  const chartColor3 = props.chartColor3;\n\n  const parseHex = (hex) => {\n    if (!hex) return [0,0,0];\n    const h = hex.replace('#','');\n    return [parseInt(h.substring(0,2),16)||0, parseInt(h.substring(2,4),16)||0, parseInt(h.substring(4,6),16)||0];\n  };\n  const rgba = (hex, a) => { const [r,g,b] = parseHex(hex); return `rgba(${r},${g},${b},${a})`; };\n\n  const smoothSettle = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,3.5);\n  const bellCurveLate = (t) => t<=0?0:t>=1?1:t<0.4?0.15*Math.pow(t/0.4,2.5):0.15+0.85*(1-Math.pow(1-(t-0.4)/0.6,2.8));\n  const lineDraw = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,2.8);\n\n  // Exit (last 25f)\n  const total = durationInFrames || 150;\n  const exitRaw = Math.max(0, Math.min(1, (frame-(total-25))/25));\n  const ex = 1 - exitRaw*exitRaw;\n\n  // Stagger helper: element starts at `delay`, takes `dur` frames\n  const anim = (delay, dur) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/dur)));\n  const fadeIn = (delay) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/15)));\n\n  // Blob\n  const blobA = anim(0, 40) * ex;\n  const blobScale = 1.05 - 0.05*anim(0,45);\n  const driftX = Math.sin(frame/55)*6;\n  const driftY = Math.cos(frame/70)*5;\n\n  // Chapter + Title (delay 5)\n  const ttA = fadeIn(5)*ex;\n  const ttY = (1-anim(5,48))*50;\n\n  // Body (delay 20)\n  const bdA = fadeIn(20)*ex;\n  const bdY = (1-anim(20,40))*35;\n\n  // Name tag (delay 30)\n  const nmA = fadeIn(30)*ex;\n  const nmY = (1-anim(30,35))*25;\n\n  // Timeline line (delay 15)\n  const tlW = lineDraw(Math.min(1, Math.max(0,(frame-15)/50)))*680;\n  const tlA = fadeIn(15)*ex;\n\n  // Timeline nodes (stagger from 25, every 5f)\n  const nd = [0,1,2,3].map(i => {\n    const d = 25+i*5;\n    return { a: fadeIn(d)*ex, y: (1-anim(d,30))*18 };\n  });\n\n  // Donut chart (delay 20, 60f)\n  const chRaw = Math.min(1, Math.max(0,(frame-20)/60));\n  const chP = bellCurveLate(chRaw);\n  const chLblA = anim(20+60*0.55, 18)*ex;\n\n  const cx=160, cy=160, r=110, sw=32;\n  const C = 2*Math.PI*r;\n  const segs = [{p:0.45,c:chartColor1},{p:0.35,c:chartColor2},{p:0.20,c:chartColor3}];\n  let offset = 0;\n\n  return (\n    <div style={{position:'absolute',inset:0,backgroundColor:bgColor,overflow:'hidden',fontFamily:bodyFont}}>\n      {/* Blobs */}\n      <div style={{position:'absolute',top:'-12%',right:'-8%',width:1300,height:1300,\n        background:`radial-gradient(circle,${rgba(blobColor1,blobA*0.55)} 0%,transparent 60%)`,\n        transform:`translate(${driftX}px,${driftY}px) scale(${blobScale})`,transformOrigin:'center'}}/>\n      <div style={{position:'absolute',bottom:'-18%',left:'-6%',width:1100,height:1100,\n        background:`radial-gradient(circle,${rgba(blobColor2,blobA*0.4)} 0%,transparent 60%)`,\n        transform:`translate(${-driftX}px,${-driftY}px) scale(${blobScale})`,transformOrigin:'center'}}/>\n\n      {/* Chapter + Title */}\n      <div style={{position:'absolute',left:140,top:100,transform:`translateY(${ttY}px)`}}>\n        <div style={{fontFamily:titleFont,fontStyle:'italic',fontSize:100,color:rgba(textColor,ttA*0.7),letterSpacing:'-0.02em',lineHeight:1}}>01</div>\n        <div style={{fontFamily:titleFont,fontSize:130,fontWeight:400,textTransform:'uppercase',color:rgba(textColor,ttA),lineHeight:0.9,letterSpacing:'0.05em',marginTop:10}}>JOURNEY</div>\n        <div style={{fontFamily:titleFont,fontSize:130,fontWeight:400,fontStyle:'italic',textTransform:'uppercase',color:rgba(textColor,ttA),lineHeight:0.9,letterSpacing:'0.02em'}}>ROUTES</div>\n      </div>\n\n      {/* Body text */}\n      <div style={{position:'absolute',left:140,top:560,width:550,transform:`translateY(${bdY}px)`}}>\n        <div style={{fontSize:30,lineHeight:1.5,color:rgba(textColor,bdA*0.85),whiteSpace:'pre-wrap'}}>\n          We create meaningful experiences through thoughtful design.\n        </div>\n      </div>\n\n      {/* Name tag */}\n      <div style={{position:'absolute',left:140,bottom:100,transform:`translateY(${nmY}px)`}}>\n        <div style={{fontSize:22,fontWeight:500,color:rgba(textColor,nmA),borderLeft:`3px solid ${rgba(chartColor1,nmA)}`,paddingLeft:14}}>\n          Elena Rossi — Creative Director\n        </div>\n      </div>\n\n      {/* Timeline (bottom center) */}\n      <div style={{position:'absolute',left:140,top:720,width:750,height:90}}>\n        <div style={{position:'absolute',left:0,top:10,width:tlW,height:2,backgroundColor:rgba(textColor,tlA*0.25)}}/>\n        {['2020','2021','2023','2025'].map((yr,i) => (\n          <div key={i} style={{position:'absolute',left:i*200,top:0,transform:`translateY(${nd[i].y}px)`}}>\n            <div style={{width:8,height:8,borderRadius:'50%',backgroundColor:rgba(blobColor2,nd[i].a),marginBottom:8}}/>\n            <div style={{fontFamily:titleFont,fontStyle:'italic',fontSize:24,color:rgba(textColor,nd[i].a)}}>{yr}</div>\n            <div style={{fontSize:13,color:rgba(textColor,nd[i].a*0.6),letterSpacing:'0.1em',textTransform:'uppercase',marginTop:4}}>WAYPOINT</div>\n          </div>\n        ))}\n      </div>\n\n      {/* Donut chart (right) */}\n      <div style={{position:'absolute',right:180,top:200,width:320,height:320}}>\n        <svg width={320} height={320} style={{transform:'rotate(-90deg)'}}>\n          {segs.map((s,i) => {\n            const len = s.p*C*chP;\n            const dash = `${len} ${C}`;\n            const el = <circle key={i} cx={cx} cy={cy} r={r} fill=\"none\" stroke={rgba(s.c,ex)} strokeWidth={sw} strokeDasharray={dash} strokeDashoffset={-offset} strokeLinecap=\"butt\"/>;\n            offset += s.p*C;\n            return el;\n          })}\n        </svg>\n        {/* Labels */}\n        {[{pct:'45%',ang:-45},{pct:'35%',ang:96},{pct:'20%',ang:216}].map((l,i) => {\n          const lx = cx+Math.cos(l.ang*Math.PI/180)*145;\n          const ly = cy+Math.sin(l.ang*Math.PI/180)*145;\n          return <div key={`l${i}`} style={{position:'absolute',left:lx-20,top:ly-10,width:40,textAlign:'center',fontSize:18,fontWeight:600,color:rgba(textColor,chLblA)}}>{l.pct}</div>;\n        })}\n      </div>\n\n      {/* Team circles hint (right side, below chart) */}\n      <div style={{position:'absolute',right:180,bottom:160,display:'flex',gap:30}}>\n        {[chartColor1,chartColor2,chartColor3].map((c,i) => {\n          const cA = fadeIn(35+i*6)*ex;\n          return <div key={i} style={{width:70,height:70,borderRadius:'50%',border:`2px solid ${rgba(c,cA*0.6)}`,backgroundColor:rgba(c,cA*0.08)}}/>; \n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
