  "thumb": "/thumbnails/aa69b6e7-ef97-4baf-8594-c614d4d12117.jpg",
  "code": "const PaperTextOverlay = ({item}) => { const frame = useCurrentFrame(); const {fps} = useVideoConfig(); const props = item.props || {}; const line1Text = props.line1Text; const line2PreText = props.line2PreText; const highlightedWords = props.highlightedWords; const highlightColor = props.highlightColor; const textColor = props.textColor; const fontFamily = props.fontFamily; const DESIGN_WIDTH = 1600; const DESIGN_HEIGHT = 380; const iw = item && item.width ? item.width : DESIGN_WIDTH; const ih = item && item.height ? item.height : DESIGN_HEIGHT; const scale = Math.min(iw / DESIGN_WIDTH, ih / DESIGN_HEIGHT); const safeFps = fps || 30; const STAGGER = 4; const line1Words = String(line1Text).split(' ').filter(w => w.length > 0); const line2PreWords = String(line2PreText).split(' ').filter(w => w.length > 0); const highWords = String(highlightedWords).split(' ').filter(w => w.length > 0); const totalLine1 = line1Words.length; const totalLine2Pre = line2PreWords.length; const getY = (index) => { const delay = index * STAGGER; const spr = spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping: 40, stiffness: 120, mass: 1 } }); return interpolate(spr, [0, 1], [28, 0]); }; const getOp = (index) => { const delay = index * STAGGER; const t = Math.min(Math.max((frame - delay) / 15, 0), 1); return t * (2 - t); }; const hlStart = (totalLine1 + totalLine2Pre) * STAGGER; const hlDuration = 30; const t = Math.min(Math.max((frame - hlStart) / hlDuration, 0), 1); const hlReveal = t * t; const revealPct = (hlReveal * 100).toFixed(3); const maskVal = 'linear-gradient(to right, black ' + revealPct + '%, transparent ' + revealPct + '%)'; const nH = 80; const nV = 15; const stepH = 100 / nH; const stepV = 100 / nV; const ampH = 2.2; const ampV = 0.4; const noiseH = (seed) => (random(seed) - 0.5) * ampH + (random(seed + 0.37) - 0.5) * ampH * 0.35; const noiseV = (seed) => (random(seed) - 0.5) * ampV + (random(seed + 0.37) - 0.5) * ampV * 0.35; const topPts = Array.from({length: nH + 1}, (_, i) => { const x = i * stepH; const y = noiseH(i * 7 + 1); return x.toFixed(2) + ',' + y.toFixed(2); }).join(' L '); const rightPts = Array.from({length: nV + 1}, (_, i) => { const y = i * stepV; const x = 100 + noiseV(nH + i * 13 + 2); return x.toFixed(2) + ',' + y.toFixed(2); }).join(' L '); const botPts = Array.from({length: nH + 1}, (_, i) => { const x = 100 - i * stepH; const y = 100 + noiseH(2 * nH + i * 7 + 3); return x.toFixed(2) + ',' + y.toFixed(2); }).join(' L '); const leftPts = Array.from({length: nV + 1}, (_, i) => { const y = 100 - i * stepV; const x = noiseV(3 * nH + i * 13 + 4); return x.toFixed(2) + ',' + y.toFixed(2); }).join(' L '); const pathD = 'M 0,0 L ' + topPts + ' L ' + rightPts + ' L ' + botPts + ' L ' + leftPts + ' Z'; const rootStyle = { position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: 'scale(' + scale + ')', transformOrigin: 'top left', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', fontFamily: fontFamily, fontWeight: 800, fontSize: '88px', color: textColor, lineHeight: 1.1 }; const line1Style = { display: 'flex', flexWrap: 'wrap', justifyContent: 'center', gap: '0.28em' }; const line2Style = { display: 'flex', flexWrap: 'wrap', justifyContent: 'center', alignItems: 'center', gap: '0.28em', marginTop: '0.02em' }; const hlWrapStyle = { position: 'relative', display: 'inline-flex', gap: '0.28em', padding: '0 0.3em' }; const hlSvgContainerStyle = { position: 'absolute', top: '-6px', left: '-12px', right: '-12px', bottom: '-6px', zIndex: 0, WebkitMaskImage: maskVal, maskImage: maskVal }; const hlSvgStyle = { width: '100%', height: '100%', display: 'block' }; const l1Items = line1Words.map((w, i) => { const wStyle = { transform: 'translateY(' + getY(i) + 'px)', opacity: getOp(i), display: 'inline-block' }; return <span key={'l1' + i} style={wStyle}>{w}</span>; }); const l2Items = line2PreWords.map((w, i) => { const idx = totalLine1 + i; const wStyle = { transform: 'translateY(' + getY(idx) + 'px)', opacity: getOp(idx), display: 'inline-block' }; return <span key={'l2' + i} style={wStyle}>{w}</span>; }); const hiItems = highWords.map((w, i) => { const idx = totalLine1 + totalLine2Pre + i; const wStyle = { transform: 'translateY(' + getY(idx) + 'px)', opacity: getOp(idx), display: 'inline-block', position: 'relative', zIndex: 2 }; return <span key={'hi' + i} style={wStyle}>{w}</span>; }); return (<div style={rootStyle}><div style={line1Style}>{l1Items}</div><div style={line2Style}>{l2Items}<span style={hlWrapStyle}><span style={hlSvgContainerStyle}><svg style={hlSvgStyle} viewBox=\"-3 -3 106 106\" preserveAspectRatio=\"none\"><path d={pathD} fill={highlightColor} fillOpacity=\"0.82\"/></svg></span>{hiItems}</span></div></div>); };"
 },
 {
  "id": "751adbfe-0a1d-4d9d-97d5-21d050c75442",
  "name": "Letter drop title — HOW DO YOU DIFFERENTIATE",
