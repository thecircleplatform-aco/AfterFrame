  "thumb": "/thumbnails/10d5638b-dc0f-4362-8cf8-f6bb14340331.jpg",
  "code": "const NewspaperLowerThird = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  // Editable Properties\n  const props = item.props || {};\n  const nameText = props.nameText || 'Dana Ruiz';\n  const titleText = props.titleText || 'Level Designer · Pixel Foundry Studio';\n  const paperColor = props.paperColor || '#eaf2ff';\n  const inkColor = props.inkColor || '#131a27';\n  const fontSize = Number(props.fontSize) || 90;\n  const jitterSpeed = Number(props.jitterSpeed) || 10;\n\n  // Responsive Scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Animation Timing\n  // 1. Entrance\n  const entranceSpring = spring({\n    frame,\n    fps,\n    config: { damping: 15, stiffness: 120, mass: 0.8 },\n  });\n\n  // 2. Texture Cycle (Jitter effect: 3 states, changes every jitterSpeed frames)\n  const textureSeed = Math.floor(frame / jitterSpeed) % 3;\n\n  // 3. Exit (Fade out near end)\n  const exitStartFrame = durationInFrames - 20;\n  const opacity = interpolate(\n    frame,\n    [0, 10, exitStartFrame, durationInFrames - 1],\n    [0, 1, 1, 0],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  // 4. Text Slide Up\n  const textTranslateY = interpolate(entranceSpring, [0, 1], [40, 0]);\n\n  // 5. Subtle Organic Warp (Breathing)\n  const warpAmount = Math.sin(frame / 60) * 2;\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    justifyContent: 'flex-start',\n    alignItems: 'flex-end',\n    padding: '0 0 120px 120px',\n    boxSizing: 'border-box',\n    fontFamily: '\"Georgia\", \"Times New Roman\", serif',\n    opacity,\n  };\n\n  const cardStyle = {\n    position: 'relative',\n    backgroundColor: paperColor,\n    padding: '40px 60px',\n    maxWidth: '800px',\n    minWidth: '500px',\n    transform: `translateY(${interpolate(entranceSpring, [0, 1], [50, 0])}px) rotate(${warpAmount * 0.1}deg)`,\n    filter: `url(#paper-roughness-${textureSeed}) drop-shadow(0px 10px 15px rgba(0,1,9,0.3))`,\n  };\n\n  const textContainerStyle = {\n    position: 'relative',\n    transform: `translateY(${textTranslateY}px)`,\n    color: inkColor,\n  };\n\n  const nameStyle = {\n    fontSize: `${fontSize}px`,\n    fontWeight: 'bold',\n    lineHeight: 1,\n    marginBottom: '10px',\n    letterSpacing: '-1px',\n  };\n\n  const titleStyle = {\n    fontSize: `${fontSize * 0.45}px`,\n    fontStyle: 'italic',\n    opacity: 0.85,\n    lineHeight: 1.2,\n    fontFamily: '\"Times New Roman\", serif',\n  };\n\n  const spotStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    right: 0,\n    bottom: 0,\n    opacity: 0.15,\n    backgroundImage: `radial-gradient(${inkColor} 1px, transparent 0)`,\n    backgroundSize: '30px 30px',\n    backgroundPosition: `${textureSeed * 10}px ${textureSeed * 5}px`,\n    mixBlendMode: 'multiply',\n    pointerEvents: 'none',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <svg style={{ position: 'absolute', width: 0, height: 0 }}>\n        <defs>\n          {[0, 1, 2].map((seed) => (\n            <filter id={`paper-roughness-${seed}`} key={seed}>\n              <feTurbulence\n                type=\"fractalNoise\"\n                baseFrequency=\"0.04\"\n                numOctaves=\"5\"\n                seed={seed + 100}\n                result=\"noise\"\n              />\n              <feDisplacementMap\n                in=\"SourceGraphic\"\n                in2=\"noise\"\n                scale=\"6\"\n                xChannelSelector=\"R\"\n                yChannelSelector=\"G\"\n              />\n            </filter>\n          ))}\n        </defs>\n      </svg>\n\n      <div style={cardStyle}>\n        <div style={spotStyle} />\n        <div style={textContainerStyle}>\n          <div style={nameStyle}>{nameText}</div>\n          <div style={titleStyle}>{titleText}</div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
