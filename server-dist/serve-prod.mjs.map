  "thumb": "/thumbnails/442ab610-d550-44e7-901a-aa5d23fef8a9.jpg",
  "code": "const VideoProgressBarV2 = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const primaryColor = props.primaryColor;\n  const highlightColor = props.highlightColor || primaryColor;\n  const promptText = props.promptText;\n  const highlightWord = props.highlightWord;\n  const segment1 = props.segment1;\n  const segment2 = props.segment2;\n  const segment3 = props.segment3;\n  const segment4 = props.segment4;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const progress = Math.min(1, Math.max(0, frame / (durationInFrames - 1)));\n  const percentage = Math.floor(progress * 100);\n  const totalSecs = Math.round(durationInFrames / fps);\n\n  // Larger video window — fills more vertical space\n  const WIN_W = 1160;\n  const WIN_H = 640;\n  const WIN_R = 24;\n\n  // Layout constants (absolute positions within 1920x1080)\n  // Title above window, gap 32px; window top at 110px\n  const TITLE_TOP = 60;\n  const WIN_TOP = 150;\n  // Shadow div center offset from vertical center\n  // Canvas center = 540. Win center Y = WIN_TOP + WIN_H/2 = 110 + 320 = 430\n  // offset from 50% (540): 430 - 540 = -110\n  const WIN_CENTER_OFFSET_Y = WIN_TOP + WIN_H / 2 - DESIGN_HEIGHT / 2; // -110\n\n  const UI_TOP = WIN_TOP + WIN_H; // 750 — percentage/pills/bar start here\n\n  const renderPromptText = () => {\n    if (!highlightWord || !promptText) return promptText;\n    const regex = new RegExp(`(${highlightWord})`, 'gi');\n    const parts = promptText.split(regex);\n    return parts.map((part, i) =>\n      part.toLowerCase() === highlightWord.toLowerCase() ? (\n        <span key={i} style={{ color: highlightColor, fontWeight: 700 }}>{part}</span>\n      ) : (\n        <span key={i}>{part}</span>\n      )\n    );\n  };\n\n  const segments = [segment1, segment2, segment3, segment4];\n  const activeIndex = Math.min(3, Math.floor(progress * 4));\n  const numTicks = 80;\n\n  return (\n    <div style={{\n      position: 'absolute',\n      top: 0, left: 0,\n      width: DESIGN_WIDTH,\n      height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      fontFamily: fontFamily,\n      backgroundColor: 'transparent',\n    }}>\n\n      {/*\n        ── MASK via box-shadow ──\n        The div is the exact size of the video window.\n        box-shadow 3000px white fills everything outside the rounded rect.\n        The window interior stays transparent so the video layer below shows through.\n      */}\n      <div style={{\n        position: 'absolute',\n        top: WIN_TOP,\n        left: (DESIGN_WIDTH - WIN_W) / 2,\n        width: WIN_W,\n        height: WIN_H,\n        borderRadius: WIN_R,\n        backgroundColor: 'transparent',\n        boxShadow: '0 0 0 3000px #ffffff',\n      }} />\n\n      {/* ── Title ── */}\n      <div style={{\n        position: 'absolute',\n        top: TITLE_TOP,\n        left: 0,\n        right: 0,\n        display: 'flex',\n        justifyContent: 'center',\n        fontSize: 48,\n        fontWeight: 500,\n        color: '#27272a',\n        letterSpacing: '-0.02em',\n        zIndex: 2,\n      }}>\n        {renderPromptText()}\n      </div>\n\n      {/* ── Bottom UI ── */}\n      <div style={{\n        position: 'absolute',\n        top: UI_TOP,\n        left: 0,\n        right: 0,\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        zIndex: 2,\n      }}>\n\n        {/* Percentage badge */}\n        <div style={{\n          marginTop: 20,\n          padding: '5px 18px',\n          backgroundColor: '#f4f4f5',\n          borderRadius: 20,\n          fontSize: 19,\n          fontWeight: 600,\n          color: '#71717a',\n        }}>\n          {percentage}%\n        </div>\n\n        {/* Segment pills */}\n        <div style={{ display: 'flex', gap: 20, marginTop: 16 }}>\n          {segments.map((seg, i) => {\n            const isActive = i === activeIndex;\n            const startFrame = (i / 4) * durationInFrames;\n            const sp = spring({\n              frame: Math.max(0, frame - startFrame),\n              fps,\n              config: { damping: 14, stiffness: 200 },\n            });\n            const scaleVal = isActive ? interpolate(sp, [0, 1], [1, 1.06]) : 1;\n            return (\n              <div key={i} style={{\n                padding: '12px 28px',\n                borderRadius: 14,\n                backgroundColor: isActive ? primaryColor : '#f4f4f5',\n                color: isActive ? '#ffffff' : '#52525b',\n                fontSize: 20,\n                fontWeight: 600,\n                transform: `scale(${scaleVal})`,\n                boxShadow: isActive ? `0 10px 20px ${primaryColor}40` : 'none',\n                display: 'flex',\n                alignItems: 'center',\n                justifyContent: 'center',\n              }}>\n                {seg}\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Floating progress bar card */}\n        <div style={{\n          display: 'flex',\n          alignItems: 'center',\n          gap: 20,\n          marginTop: 24,\n          backgroundColor: '#ffffff',\n          padding: '16px 60px',\n          borderRadius: 28,\n          boxShadow: '0 8px 32px rgba(0,0,0,0.10)',\n        }}>\n          <div style={{ fontSize: 17, color: '#a1a1aa', fontWeight: 500, fontVariantNumeric: 'tabular-nums' }}>\n            00 sec\n          </div>\n          <div style={{ display: 'flex', gap: 6 }}>\n            {Array.from({length: numTicks}).map((_, i) => {\n              const fillP = i / (numTicks - 1);\n              const isFilled = fillP <= progress;\n              const ds = spring({\n                frame: isFilled ? Math.max(0, frame - Math.floor(fillP * durationInFrames)) : 0,\n                fps,\n                config: { damping: 15 },\n              });\n              const dotScale = isFilled ? interpolate(ds, [0, 1], [0.5, 1]) : 1;\n              return (\n                <div key={i} style={{\n                  width: 4,\n                  height: 15,\n                  borderRadius: 2,\n                  backgroundColor: isFilled ? primaryColor : '#e4e4e7',\n                  transform: `scaleY(${dotScale})`,\n                  transformOrigin: 'bottom',\n                }} />\n              );\n            })}\n          </div>\n          <div style={{ fontSize: 17, color: '#a1a1aa', fontWeight: 500, fontVariantNumeric: 'tabular-nums' }}>\n            {totalSecs} sec\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
