    "type": "text",
    "defaultValue": "Round-the-clock output",
    "label": "Right Bullet 4"
   },
   {
    "key": "rightB5",
    "type": "text",
    "defaultValue": "New green jobs sector",
    "label": "Right Bullet 5"
   }
  ],
  "thumb": "/thumbnails/0f42b597-2b83-4e6c-9a7b-19f9b0b0ef98.jpg",
  "code": "const PresidentialReconstruction = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const props = item.props || {};\n  \n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n  const accentColor = '#866f4b';\n  const textColor = props.textColor;\n  const titleText = props.titleText;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n\n  const safeFps = fps || 30;\n  const getFadeSlide = (delayFrames) => {\n    const fade = interpolate(frame - delayFrames, [0, 15], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n    const slide = interpolate(frame - delayFrames, [0, 15], [20, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n    return { opacity: fade, transform: `translateY(${slide}px)` };\n  };\n\n  const titleAnim = getFadeSlide(0);\n  \n  const leftData = {\n    header: props.leftHeader,\n    bullets: [props.leftB1, props.leftB2, props.leftB3, props.leftB4, props.leftB5],\n    delayBase: 24, // 0.8s\n    bulletDelays: [36, 48, 60, 72, 84]\n  };\n\n  const rightData = {\n    header: props.rightHeader,\n    bullets: [props.rightB1, props.rightB2, props.rightB3, props.rightB4, props.rightB5],\n    delayBase: 96, // 3.2s\n    bulletDelays: [108, 120, 132, 144, 156]\n  };\n\n  const fadeOutStart = Math.max(0, durationInFrames - 20);\n  const globalFadeOut = interpolate(frame, [fadeOutStart, durationInFrames - 1], [1, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'flex-start',\n    overflow: 'hidden',\n    opacity: globalFadeOut,\n  };\n\n  const renderIcon = (type) => (\n    <svg width=\"60\" height=\"60\" viewBox=\"0 0 100 100\" fill=\"none\" stroke={textColor} strokeWidth=\"3\" style={{ marginBottom: '20px' }}>\n      <circle cx=\"50\" cy=\"45\" r=\"20\" />\n      <path d=\"M20,90 Q50,60 80,90\" />\n      {type === 'glasses' && (\n        <g>\n          <circle cx=\"42\" cy=\"42\" r=\"6\" />\n          <circle cx=\"58\" cy=\"42\" r=\"6\" />\n          <line x1=\"48\" y1=\"42\" x2=\"52\" y2=\"42\" />\n        </g>\n      )}\n      {type === 'hair' && (\n        <path d=\"M30,40 Q50,15 70,40\" />\n      )}\n      <line x1=\"30\" y1=\"10\" x2=\"70\" y2=\"10\" strokeWidth=\"1\" />\n      <line x1=\"30\" y1=\"95\" x2=\"70\" y2=\"95\" strokeWidth=\"1\" />\n    </svg>\n  );\n\n  const Column = ({ data, iconType, item }) => {\n    const headerAnim = getFadeSlide(data.delayBase);\n    return (\n      <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', width: '450px' }}>\n        <div style={{ ...headerAnim, display: 'flex', flexDirection: 'column', alignItems: 'center' }}>\n          {renderIcon(iconType)}\n          <h2 style={{ fontFamily: titleFont, fontSize: '36px', color: textColor, margin: '0 0 40px 0', fontWeight: 'bold' }}>\n            {data.header}\n          </h2>\n        </div>\n        <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-start', gap: '20px', width: '100%' }}>\n          {data.bullets.map((bullet, i) => {\n            const bulletAnim = getFadeSlide(data.bulletDelays[i]);\n            return (\n              <div key={i} style={{ ...bulletAnim, display: 'flex', flexDirection: 'row', alignItems: 'flex-start' }}>\n                <span style={{ fontSize: '22px', color: textColor, marginRight: '15px', lineHeight: '1.2' }}>•</span>\n                <span style={{ fontFamily: bodyFont, fontSize: '22px', color: textColor, lineHeight: '1.4' }}>\n                  {bullet}\n                </span>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    );\n  };\n\n  const borderOp = interpolate(frame, [5, 20], [0, 1], { extrapolateRight: 'clamp' });\n  const borderScaleRaw = spring({ frame: Math.max(0, frame - 5), fps: safeFps, config: { damping: 20, mass: 1, stiffness: 100 } });\n  const borderScale = 0.95 + borderScaleRaw * 0.05;\n\n  const CornerFlourish = ({ style, item }) => (\n    <div style={{ position: 'absolute', width: 150, height: 150, ...style }}>\n      <svg viewBox=\"0 0 150 150\" width=\"100%\" height=\"100%\">\n        <g stroke={accentColor} fill=\"none\" strokeWidth=\"1.5\" strokeLinecap=\"round\">\n          <path d=\"M 0,150 C 0,50 50,0 150,0\" />\n          <path d=\"M 15,150 C 15,70 70,15 150,15\" />\n          <path d=\"M 30,150 C 30,90 70,50 110,40 C 130,35 140,45 130,60 C 115,80 90,60 95,45 C 100,35 110,35 115,45\" />\n          <path d=\"M 150,30 C 90,30 50,70 40,110 C 35,130 45,140 60,130 C 80,115 60,90 45,95 C 35,100 35,110 45,115\" />\n          <circle cx=\"20\" cy=\"20\" r=\"2.5\" fill={accentColor} />\n          <path d=\"M 0,0 L 25,0 C 25,25 0,25 0,25 Z\" fill={accentColor} stroke=\"none\" />\n        </g>\n      </svg>\n    </div>\n  );\n\n  return (\n    <div style={rootStyle}>\n      {/* Frame border */}\n      <div style={{ position: 'absolute', top: 50, bottom: 50, left: 60, right: 60, border: `2px solid ${accentColor}`, padding: 12, opacity: borderOp, transform: `scale(${borderScale})` }}>\n        <div style={{ width: '100%', height: '100%', border: `1px solid ${accentColor}`, position: 'relative', boxSizing: 'border-box' }}>\n          <CornerFlourish style={{ top: 0, left: 0 }} />\n          <CornerFlourish style={{ top: 0, right: 0, transform: 'scaleX(-1)' }} />\n          <CornerFlourish style={{ bottom: 0, left: 0, transform: 'scaleY(-1)' }} />\n          <CornerFlourish style={{ bottom: 0, right: 0, transform: 'scale(-1, -1)' }} />\n        </div>\n      </div>\n\n      {/* Content */}\n      <div style={{ position: 'relative', width: '100%', height: '100%', padding: '120px 100px', display: 'flex', flexDirection: 'column', alignItems: 'center' }}>\n        <h1 style={{ ...titleAnim, fontFamily: titleFont, fontSize: '72px', color: textColor, margin: '0 0 100px 0', fontWeight: 'normal', letterSpacing: '1px' }}>\n          {titleText}\n        </h1>\n\n        <div style={{ display: 'flex', flexDirection: 'row', justifyContent: 'center', gap: '160px', width: '100%' }}>\n          <Column data={leftData} iconType=\"hair\" />\n          <Column data={rightData} iconType=\"glasses\" />\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
