  "thumb": "/thumbnails/97d3b441-1916-48bc-a11c-9af4ff6fb0be.jpg",
  "code": "const ConcentricRings = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const titleText = props.titleText || 'CLUB BUDGET SPLIT';\n  const subtitleText = props.subtitleText || 'Funding Share by Program Team';\n  const bgStart = props.bgGradientStart || '#294f53';\n  const bgEnd = props.bgGradientEnd || '#435c5e';\n  const ringColor = props.ringColor || '#FFFFFF';\n  const trackColor = props.trackColor || 'rgba(255, 255, 255, 0.15)';\n  const lineColor = props.lineColor || 'rgba(255, 255, 255, 0.4)';\n  const titleFont = props.titleFont || 'Inter, sans-serif';\n  const numberFont = props.numberFont || '\"IBM Plex Mono\", monospace';\n\n  const data = [\n    { label: props.label1 || 'Route Planning', value: Number(props.val1 ?? 84), radius: 320 },\n    { label: props.label2 || 'Gear & Kit', value: Number(props.val2 ?? 71), radius: 250 },\n    { label: props.label3 || 'Safety Checks', value: Number(props.val3 ?? 58), radius: 180 },\n    { label: props.label4 || 'Coordination', value: Number(props.val4 ?? 39), radius: 110 },\n  ];\n\n  // Layout: center the chart vertically, title at top center\n  const cx = 500;\n  const cy = 600;\n  const midX1 = 1050;\n  const midX2 = 1250;\n  const lineEndX = 1360;\n  const textStartX = 1390;\n  const strokeWidth = 40;\n  const labelYs = [360, 510, 660, 810];\n\n  const safeFps = fps || 30;\n\n  // Title/subtitle: delay by at least 1 frame so frame=0 is fully hidden\n  const titleOpacity = spring({ frame: Math.max(0, frame - 1), fps: safeFps, config: { damping: 20 } });\n  const subtitleOpacity = spring({ frame: Math.max(0, frame - 12), fps: safeFps, config: { damping: 20 } });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    background: `linear-gradient(135deg, ${bgStart} 0%, ${bgEnd} 100%)`,\n    overflow: 'hidden',\n    fontFamily: titleFont,\n  };\n\n  return (\n    <div style={rootStyle}>\n\n      {/* Title — top center */}\n      <div style={{\n        position: 'absolute', top: 80, left: 0, width: '100%',\n        textAlign: 'center',\n        opacity: titleOpacity,\n        transform: `translateY(${(1 - titleOpacity) * 20}px)`\n      }}>\n        <h1 style={{ margin: 0, fontSize: 56, fontWeight: 600, color: props.titleColor || '#FFF', letterSpacing: '4px', textTransform: 'uppercase' }}>\n          {titleText}\n        </h1>\n        <h2 style={{\n          margin: '12px 0 0 0', fontSize: 28, fontWeight: 300,\n          color: props.textColor || 'rgba(255,255,255,0.6)', letterSpacing: '1px',\n          opacity: subtitleOpacity,\n          transform: `translateY(${(1 - subtitleOpacity) * 16}px)`\n        }}>\n          {subtitleText}\n        </h2>\n      </div>\n\n      <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={{ position: 'absolute', top: 0, left: 0 }}>\n\n        {/* Leader Lines:\n            Frame timeline (all frame-based for precise timing):\n            - Frame 5–35: track rings fade in inner→outer (accompaniment)\n            - Frame 20–55: trunk grows from innermost ring rightward to forkX (35 frames)\n            - Dots appear as trunk passes each ring edge\n            - Frame 55–95: 4 branches grow simultaneously from forkX to labels (40 frames)\n        */}\n        {(() => {\n          const sortedByRadius = [...data].sort((a, b) => a.radius - b.radius);\n          const innermost = sortedByRadius[0];\n\n          const trunkStartX = cx + innermost.radius;\n          const trunkY = cy;\n          const forkX = midX1;\n          const trunkLen = forkX - trunkStartX;\n\n          // Trunk: frames 20→55\n          const trunkStartFrame = 20;\n          const trunkEndFrame = 55;\n          const trunkProgress = interpolate(frame, [trunkStartFrame, trunkEndFrame], [0, 1], {\n            extrapolateLeft: 'clamp', extrapolateRight: 'clamp',\n            easing: Easing.out(Easing.cubic)\n          });\n\n          // Branches: frames 55→85, linear easing so growth is visible from frame 1\n          const branchStartFrame = 55;\n          const branchEndFrame = 85;\n          const branchProgress = interpolate(frame, [branchStartFrame, branchEndFrame], [0, 1], {\n            extrapolateLeft: 'clamp', extrapolateRight: 'clamp',\n            easing: Easing.out(Easing.quad)\n          });\n\n          const trunkTipX = interpolate(trunkProgress, [0, 1], [trunkStartX, forkX], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n          return (\n            <g>\n              {/* Trunk */}\n              {trunkProgress > 0 && (\n                <line x1={trunkStartX} y1={trunkY} x2={trunkTipX} y2={trunkY}\n                  stroke={lineColor} strokeWidth={2} />\n              )}\n\n              {/* White dot at each ring's right edge — fades in as trunk passes */}\n              {sortedByRadius.map((d, i) => {\n                const dotX = cx + d.radius;\n                const fraction = (dotX - trunkStartX) / trunkLen;\n                // dot appears when trunk tip reaches this x\n                const dotFrame = trunkStartFrame + fraction * (trunkEndFrame - trunkStartFrame);\n                const dotOpacity = interpolate(frame, [dotFrame, dotFrame + 6], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n                if (dotOpacity <= 0) return null;\n                return (\n                  <circle key={`dot-ring-${i}`} cx={dotX} cy={trunkY} r={5}\n                    fill={ringColor} opacity={dotOpacity} />\n                );\n              })}\n\n              {/* 4 Branches — strokeDashoffset growth from forkX outward */}\n              {branchProgress > 0 && data.map((d, i) => {\n                const labelY = labelYs[i];\n                // Fixed full path: forkX,trunkY → midX2,labelY → lineEndX,labelY\n                const diagLen = Math.sqrt(Math.pow(midX2 - forkX, 2) + Math.pow(labelY - trunkY, 2));\n                const horizLen = lineEndX - midX2;\n                const totalLen = diagLen + horizLen;\n                const dashOffset = totalLen * (1 - branchProgress);\n\n                // End dot appears when branch fully drawn\n                const endDotOpacity = interpolate(frame, [branchEndFrame - 2, branchEndFrame + 4], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n                return (\n                  <g key={`branch-${i}`}>\n                    <path\n                      d={`M ${forkX},${trunkY} L ${midX2},${labelY} L ${lineEndX},${labelY}`}\n                      stroke={lineColor} strokeWidth={2} fill=\"none\"\n                      strokeDasharray={totalLen}\n                      strokeDashoffset={dashOffset}\n                    />\n                    {endDotOpacity > 0 && (\n                      <circle cx={lineEndX} cy={labelY} r={4} fill={ringColor} opacity={endDotOpacity} />\n                    )}\n                  </g>\n                );\n              })}\n            </g>\n          );\n        })()}\n\n        {/* Concentric Ring Tracks + Animated Value Rings */}\n        <g transform={`rotate(-90 ${cx} ${cy})`}>\n          {data.map((d, i) => {\n            // innerToOuterIndex: 0 = innermost (r=110), 3 = outermost (r=320)\n            // data array is [r=320, r=250, r=180, r=110], so i=3 is innermost\n            const innerToOuterIndex = data.length - 1 - i;\n\n            // Track ring: fades in early (frames 5→17 per ring, inner first)\n            // This accompanies the trunk/dot animation starting at frame 20\n            const trackDelay = innerToOuterIndex * 10 + 5;\n            const trackOpacity = interpolate(frame, [trackDelay, trackDelay + 12], [0, 1], {\n              extrapolateLeft: 'clamp', extrapolateRight: 'clamp',\n              easing: Easing.out(Easing.cubic)\n            });\n\n            // Fill arc: starts later (frame 30+, inner first), soft spring\n            const delay = innerToOuterIndex * 14 + 30;\n            const progress = spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping: 28, mass: 2.0, stiffness: 60 } });\n            const circumference = 2 * Math.PI * d.radius;\n            const offset = circumference * (1 - (progress * (d.value / 100)));\n            // Fill arc fades in by frame range (not spring progress) — guaranteed smooth\n            const fillOpacity = interpolate(frame, [delay, delay + 10], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic) });\n\n            return (\n              <g key={`ring-${i}`}>\n                {/* Track — fades in early as accompaniment to trunk/dots */}\n                <circle\n                  cx={cx} cy={cy} r={d.radius}\n                  stroke={trackColor} strokeWidth={strokeWidth} fill=\"none\"\n                  opacity={trackOpacity}\n                />\n                {/* Value Ring — fades in + grows after tracks are visible */}\n                <circle\n                  cx={cx} cy={cy} r={d.radius}\n                  stroke={ringColor} strokeWidth={strokeWidth} fill=\"none\"\n                  strokeLinecap=\"round\"\n                  strokeDasharray={circumference}\n                  strokeDashoffset={offset}\n                  opacity={fillOpacity}\n                />\n              </g>\n            );\n          })}\n        </g>\n      </svg>\n\n      {/* Data Labels — also innermost first */}\n      {data.map((d, i) => {\n        const innerToOuterIndex = data.length - 1 - i;\n        const delay = innerToOuterIndex * 14 + 90; // after rings + lines settle\n        const textOpacity = spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping: 24, mass: 1.5 } });\n        const slideX = interpolate(textOpacity, [0, 1], [-30, 0]);\n        const ringDelay = innerToOuterIndex * 14 + 30;\n        const progress = spring({ frame: Math.max(0, frame - ringDelay), fps: safeFps, config: { damping: 28, mass: 2.0, stiffness: 60 } });\n        const currentVal = Math.round(progress * d.value);\n\n        return (\n          <div\n            key={`text-${i}`}\n            style={{\n              position: 'absolute',\n              top: labelYs[i] - 48,\n              left: textStartX,\n              opacity: textOpacity,\n              transform: `translateX(${slideX}px)`,\n              display: 'flex',\n              flexDirection: 'column',\n              justifyContent: 'center',\n              height: 96\n            }}\n          >\n            <div style={{ fontFamily: numberFont, fontSize: 56, fontWeight: 500, color: ringColor, lineHeight: 1 }}>\n              {currentVal}%\n            </div>\n            <div style={{\n              fontFamily: titleFont, fontSize: 22, fontWeight: 400,\n              color: props.textColor || 'rgba(255,255,255,0.7)', textTransform: 'uppercase',\n              letterSpacing: '2px', marginTop: 6\n            }}>\n              {d.label}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
 },
 {
  "id": "a456f6df-9683-4ff9-b4be-d80208b92d16",
  "name": "Pie Chart - User Age Distribution",
  "category": "data-visualization",
  "description": "Elegant animated pie chart with sweeping segments, percentage labels, and clean typography. Ideal for demographics or statistical breakdowns.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgStart": "#fdf5fa",
   "bgEnd": "#f7e9f2",
   "baseColor": "#d9488a",
   "textColor": "#471b33",
   "sliceStrokeColor": "#fdf5fa"
  },
  "propSchema": [],
  "thumb": "/thumbnails/a456f6df-9683-4ff9-b4be-d80208b92d16.jpg",
  "code": "const UserDemographicsChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const title = props.title || 'LISTENER DEMOGRAPHICS';\n  const subtitle = props.subtitle || 'Age Group Breakdown';\n  const bgStart = props.bgStart || '#100e24';\n  const bgEnd = props.bgEnd || '#32314b';\n  const baseColor = props.baseColor || '#ce70c5';\n\n  const slices = [\n    { label: props.label1 || 'Age 16-24', value: Number(props.val1) || 42, opacity: 1.0 },\n    { label: props.label2 || 'Age 25-34', value: Number(props.val2) || 31, opacity: 0.75 },\n    { label: props.label3 || 'Age 35-44', value: Number(props.val3) || 17, opacity: 0.5 },\n    { label: props.label4 || 'Age 45+',   value: Number(props.val4) || 10, opacity: 0.28 },\n  ];\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const CX = DESIGN_WIDTH / 2;\n  const CY = DESIGN_HEIGHT / 2 + 60;\n  const RADIUS = 300;\n  const LABEL_R = RADIUS + 90;\n\n  const total = slices.reduce((a, b) => a + b.value, 0) || 1;\n  let accumulated = 0;\n  const processed = slices.map((s) => {\n    const pct = s.value / total;\n    const startP = accumulated;\n    accumulated += pct;\n    const midAngle = (startP + pct / 2) * 2 * Math.PI - Math.PI / 2;\n    return { ...s, pct, startP, endP: accumulated, midAngle };\n  });\n\n  const getCoords = (p, r) => {\n    const x = Math.cos(2 * Math.PI * p - Math.PI / 2) * r;\n    const y = Math.sin(2 * Math.PI * p - Math.PI / 2) * r;\n    return [x, y];\n  };\n\n  const makeSlicePath = (startP, endP, r) => {\n    const [sx, sy] = getCoords(startP, r);\n    const [ex, ey] = getCoords(endP, r);\n    const large = endP - startP > 0.5 ? 1 : 0;\n    return `M 0 0 L ${sx} ${sy} A ${r} ${r} 0 ${large} 1 ${ex} ${ey} Z`;\n  };\n\n  const titleSpring = spring({ frame, fps: safeFps, config: { damping: 22, stiffness: 90 } });\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [-40, 0]);\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      background: `linear-gradient(135deg, ${bgStart} 0%, ${bgEnd} 100%)`,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      overflow: 'hidden', fontFamily: \"'Inter', sans-serif\", color: props.textColor || '#f7d9ed',\n    }}>\n      <div style={{\n        position: 'absolute', top: 0, left: 0, right: 0, height: 3,\n        background: `linear-gradient(90deg, transparent, ${baseColor}, transparent)`,\n        opacity: titleOpacity,\n      }} />\n\n      <div style={{\n        position: 'absolute', top: 80, width: '100%', textAlign: 'center',\n        opacity: titleOpacity, transform: `translateY(${titleY}px)`,\n      }}>\n        <div style={{ fontSize: 76, fontWeight: 900, letterSpacing: '0.08em', textTransform: 'uppercase',\n          textShadow: `0 0 40px ${baseColor}88` }}>{title}</div>\n        <div style={{ fontSize: 28, fontWeight: 300, marginTop: 14, opacity: 0.7, letterSpacing: '0.12em' }}>{subtitle}</div>\n      </div>\n\n      {/* Pie chart */}\n      <div style={{\n        position: 'absolute',\n        left: CX - RADIUS, top: CY - RADIUS,\n        width: RADIUS * 2, height: RADIUS * 2,\n      }}>\n        <svg width={RADIUS * 2} height={RADIUS * 2}\n          viewBox={`${-RADIUS} ${-RADIUS} ${RADIUS * 2} ${RADIUS * 2}`}\n          style={{ overflow: 'visible' }}>\n\n          {processed.map((sl, i) => {\n            const delay = 18 + i * 10;\n            const entrance = spring({ frame: Math.max(0, frame - delay), fps: safeFps,\n              config: { stiffness: 70, damping: 16 } });\n            const animEnd = interpolate(entrance, [0, 1], [sl.startP, sl.endP]);\n            const scaleV = interpolate(entrance, [0, 1], [0, 1]);\n            if (frame < delay) return null;\n\n            return (\n              <g key={i} transform={`scale(${scaleV})`}>\n                <path\n                  d={makeSlicePath(sl.startP, animEnd, RADIUS)}\n                  fill={`rgba(206,112,197,${sl.opacity})`}\n                  stroke={props.sliceStrokeColor || 'rgba(16,14,36,0.8)'} strokeWidth={3}\n                />\n              </g>\n            );\n          })}\n        </svg>\n\n        {/* Labels */}\n        {processed.map((sl, i) => {\n          const delay = 30 + i * 10;\n          const lEntrance = spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping: 20 } });\n          if (frame < delay) return null;\n\n          const lx = Math.cos(sl.midAngle) * LABEL_R;\n          const ly = Math.sin(sl.midAngle) * LABEL_R;\n          const isLeft = lx < 0;\n\n          return (\n            <div key={`lbl-${i}`} style={{\n              position: 'absolute',\n              left: RADIUS + lx, top: RADIUS + ly,\n              opacity: lEntrance,\n              transform: `translate(${isLeft ? '-100%' : '0'}, -50%)`,\n              padding: isLeft ? '0 0 0 0' : '0',\n            }}>\n              <div style={{ fontSize: 44, fontWeight: 800,\n                fontFamily: \"'IBM Plex Mono', monospace\", lineHeight: 1,\n                color: baseColor, textShadow: `0 0 12px ${baseColor}` }}>\n                {sl.value}%\n              </div>\n              <div style={{ fontSize: 22, opacity: 0.85, marginTop: 4, whiteSpace: 'nowrap' }}>\n                {sl.label}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      <div style={{\n        position: 'absolute', bottom: 0, left: 0, right: 0, height: 2,\n        background: `linear-gradient(90deg, transparent, ${baseColor}88, transparent)`,\n        opacity: titleOpacity,\n      }} />\n    </div>\n  );\n};\n"
 },
