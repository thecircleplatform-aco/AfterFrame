  "thumb": "/thumbnails/6f06cbe0-4bd3-4382-91cd-e8d6c01a155a.jpg",
  "code": "const FruitShoppingTips = ({item, props}) => {\n  // Hooks\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  // Editable props with defaults\n  const titleLine1 = props?.titleLine1 ?? \"The 4 Rules for\";\n  const titleLine2 = props?.titleLine2 ?? '\"Throw Pillow Shopping\"';\n  const subtitle = props?.subtitle ?? \"How to pick the coziest accents\";\n  const tip1 = props?.tip1 ?? \"Fabric\";\n  const tip2 = props?.tip2 ?? \"Fill\";\n  const tip3 = props?.tip3 ?? \"Stitching\";\n  const tip4 = props?.tip4 ?? \"Seasonal\";\n  const tips = [tip1, tip2, tip3, tip4];\n\n  const cardBgColor = props?.cardBgColor ?? \"rgba(255, 255, 255, 0.95)\";\n  const titleColor = props?.titleColor ?? \"#1a1a1a\";\n  const subtitleColor = props?.subtitleColor ?? \"#666\";\n  const tip1Color = props?.tip1Color ?? \"rgba(255,135,116, 0.55)\";\n  const tip2Color = props?.tip2Color ?? \"rgba(128,209,255, 0.55)\";\n  const tip3Color = props?.tip3Color ?? \"rgba(0,210,210, 0.55)\";\n  const tip4Color = props?.tip4Color ?? \"rgba(176,157,252, 0.55)\";\n  const tipColors = [tip1Color, tip2Color, tip3Color, tip4Color];\n\n  // Responsive scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Safe spring helper\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  // Animation timing\n  const cardSlideIn = safeSpring(0, { damping: 18 });\n  const titleFadeIn = safeSpring(10, { damping: 15 });\n\n  // Card slide from right\n  const cardX = interpolate(cardSlideIn, [0, 1], [900, 0]);\n\n  // Title animation\n  const titleOpacity = interpolate(titleFadeIn, [0, 1], [0, 1]);\n  const titleY = interpolate(titleFadeIn, [0, 1], [10, 0]);\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n  };\n\n  const cardContainerStyle = {\n    position: 'absolute',\n    right: 0,\n    top: 0,\n    width: '45%',\n    height: '100%',\n    transform: `translateX(${cardX}px)`,\n  };\n\n  const cardStyle = {\n    backgroundColor: cardBgColor,\n    backdropFilter: 'blur(20px)',\n    width: '100%',\n    height: '100%',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    boxShadow: '-8px 0 48px rgba(0, 0, 0, 0.12)',\n  };\n\n  const contentWrapperStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    width: '100%',\n    padding: '60px',\n  };\n\n  const titleLine1Style = {\n    fontSize: 42,\n    fontWeight: 500,\n    color: titleColor,\n    fontFamily: 'Inter, sans-serif',\n    marginBottom: 8,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  const titleLine2Style = {\n    fontSize: 72,\n    fontWeight: 800,\n    color: titleColor,\n    fontFamily: 'Inter, Montserrat, sans-serif',\n    letterSpacing: '-0.02em',\n    marginBottom: 20,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  const subtitleStyle = {\n    fontSize: 24,\n    fontWeight: 400,\n    fontStyle: 'italic',\n    color: subtitleColor,\n    fontFamily: 'Inter, sans-serif',\n    marginBottom: 56,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  const listStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    gap: 28,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardContainerStyle}>\n        <div style={cardStyle}>\n          <div style={contentWrapperStyle}>\n            <div style={titleLine1Style}>{titleLine1}</div>\n            <div style={titleLine2Style}>{titleLine2}</div>\n            <div style={subtitleStyle}>{subtitle}</div>\n\n            <div style={listStyle}>\n              {tips.map((tip, index) => {\n                const tipDelay = 20 + index * 12;\n                const tipSpring = safeSpring(tipDelay, { damping: 14 });\n                const tipOpacity = interpolate(tipSpring, [0, 1], [0, 1]);\n                const tipY = interpolate(tipSpring, [0, 1], [20, 0]);\n\n                const underlineDelay = tipDelay + 6;\n                const underlineProgress = interpolate(frame - underlineDelay * safeFps / 30, [0, 12], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n                const underlineScale = Easing.out(Easing.cubic)(underlineProgress);\n\n                const tipRowStyle = {\n                  display: 'flex',\n                  justifyContent: 'center',\n                  opacity: tipOpacity,\n                  transform: `translateY(${tipY}px)`,\n                };\n\n                const textWrapperStyle = {\n                  position: 'relative',\n                  display: 'inline-block',\n                  textAlign: 'center',\n                };\n\n                const tipTextStyle = {\n                  fontSize: 40,\n                  color: titleColor,\n                  fontFamily: 'Inter, sans-serif',\n                  fontWeight: 700,\n                  position: 'relative',\n                  zIndex: 1,\n                };\n\n                const highlightStyle = {\n                  position: 'absolute',\n                  bottom: 4,\n                  left: '50%',\n                  transform: `translateX(-50%) scaleX(${underlineScale})`,\n                  height: 14,\n                  width: '100%',\n                  backgroundColor: tipColors[index % tipColors.length],\n                  borderRadius: 4,\n                  zIndex: 0,\n                };\n\n                return (\n                  <div key={index} style={tipRowStyle}>\n                    <div style={textWrapperStyle}>\n                      <span style={tipTextStyle}>{tip}</span>\n                      <div style={highlightStyle} />\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
