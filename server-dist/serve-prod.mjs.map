  "thumb": "/thumbnails/f4ed16bb-209c-4f61-89ea-4eb6a6909163.jpg",
  "code": "const PriceTagCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n\n  const priceText = props.priceText;\n  const labelText = props.labelText;\n  const cardColor = props.cardColor;\n  const textColor = props.textColor;\n  const transparentBackground = props.transparentBackground;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 600;\n  const DESIGN_HEIGHT = 500;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const totalFrames = 90;\n  const exitDuration = 18;\n  const exitStart = totalFrames - exitDuration;\n\n  const entrance = spring({\n    frame,\n    fps: safeFps,\n    config: { damping: 40, stiffness: 120, mass: 1 }\n  });\n\n  const exit = spring({\n    frame: Math.max(0, frame - exitStart),\n    fps: safeFps,\n    config: { damping: 40, stiffness: 120, mass: 1 }\n  });\n\n  const translateY = interpolate(entrance, [0, 1], [300, 0]) + interpolate(exit, [0, 1], [0, 300]);\n\n  const entranceOpacity = interpolate(frame, [8, 20], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const exitOpacity = interpolate(frame, [exitStart, exitStart + 10], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const opacity = Math.min(entranceOpacity, exitOpacity);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: transparentBackground ? 'transparent' : '#111111',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    overflow: 'hidden',\n  };\n\n  const cardStyle = {\n    width: 440,\n    height: 360,\n    backgroundColor: cardColor,\n    borderRadius: 40,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    transform: `translateY(${translateY}px)`,\n    opacity: opacity,\n    padding: '0 32px',\n    boxSizing: 'border-box'\n  };\n\n  const priceStyle = {\n    color: textColor,\n    fontFamily: fontFamily,\n    fontStyle: 'italic',\n    fontSize: 130,\n    fontWeight: 300,\n    lineHeight: 0.95,\n    margin: 0,\n    padding: 0,\n    letterSpacing: '-0.01em',\n    whiteSpace: 'nowrap'\n  };\n\n  const labelStyle = {\n    color: textColor,\n    fontFamily: fontFamily,\n    fontStyle: 'italic',\n    fontSize: 40,\n    fontWeight: 650,\n    marginTop: 14,\n    letterSpacing: '0.08em',\n    textTransform: 'uppercase',\n    whiteSpace: 'nowrap'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <div style={priceStyle}>{priceText}</div>\n        <div style={labelStyle}>{labelText}</div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "ec40c650-4d7d-476f-a891-fe4d722fdcca",
  "name": "Dark Tech — Price Tier Panel",
  "category": "uncategorized",
  "description": "A dynamic half-screen overlay sliding in from the left, featuring a subtle floating dot background and bold broadcast-style condensed text. The right half remains perfectly transparent.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgColor": "#56647e",
   "dividerColor": "#888888",
   "l1Label": "Basic:",
