    "code": "const KbChalkboard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const W = 1920, H = 1080, M = 100;\n  const chalk = '#f3efe4';\n  const yellow = '#f5d76e';\n  const pink = '#f2a3b3';\n  const pos = String(p.position || 'bottom-right');\n  const R = Math.min(300, Math.max(110, Number(p.size) || 160));\n  const left = pos.indexOf('left') >= 0;\n  const top = pos.indexOf('top') >= 0;\n  const cx = left ? M + R : W - M - R;\n  const cy = top ? M + R : H - M - R;\n  const title = p.title == null ? '' : String(p.title);\n  const subtitle = p.subtitle == null ? '' : String(p.subtitle);\n  const handle = p.handle == null ? '' : String(p.handle);\n  const enter = spring({ frame, fps, config: { damping: 14, stiffness: 120 } });\n  const popIn = spring({ frame: frame - 6, fps, config: { damping: 12, stiffness: 140 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const drawLen = interpolate(frame, [6, 34], [330, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const sway = Math.sin((frame / 150) * Math.PI * 2);\n  const hole = 'radial-gradient(circle ' + R + 'px at ' + cx + 'px ' + cy + 'px, transparent ' + (R - 1) + 'px, #000 ' + R + 'px)';\n  const titleX = left ? cx + R + 100 : 140;\n  return (\n    <AbsoluteFill style={{ opacity: exit }}>\n      <AbsoluteFill style={{ backgroundColor: '#2e3a33', WebkitMaskImage: hole, maskImage: hole, opacity: enter }}>\n        <div style={{ position: 'absolute', inset: 0, background: 'radial-gradient(ellipse at 50% 45%, transparent 60%, #1f2a2466 100%)' }} />\n        <div style={{ position: 'absolute', left: 300, top: 620, width: 260, height: 90, background: '#f3efe408', transform: 'rotate(-6deg)' }} />\n        <div style={{ position: 'absolute', left: 1100, top: 300, width: 200, height: 70, background: '#f3efe406', transform: 'rotate(4deg)' }} />\n        <div style={{ position: 'absolute', inset: 40, border: '3px dashed ' + chalk + 'a6', borderRadius: 18 }} />\n        <div style={{ position: 'absolute', left: 0, bottom: 0, width: '100%', height: 7, background: '#c9a06273' }} />\n      </AbsoluteFill>\n      {title ? (\n        <div style={{ position: 'absolute', left: titleX, top: 130 + (1 - enter) * 26, opacity: enter, maxWidth: 1000 }}>\n          <div style={{ fontSize: 90, fontWeight: 800, color: chalk, lineHeight: 1.28, letterSpacing: 4, textShadow: '1.5px 1.5px 0 #1f2a24' }}>{title}</div>\n          <svg viewBox=\"0 0 340 18\" style={{ width: 340, height: 18, marginTop: 14 }}>\n            <path d=\"M6 11 Q 40 3, 76 10 T 148 10 T 220 10 T 292 10 T 332 9\" fill=\"none\" stroke={yellow} strokeWidth=\"5\" strokeLinecap=\"round\" strokeDasharray=\"330\" strokeDashoffset={drawLen} />\n          </svg>\n          {subtitle ? (\n            <div style={{ marginTop: 18, fontSize: 33, fontWeight: 700, color: chalk + 'c9', letterSpacing: 6 }}>{subtitle}</div>\n          ) : null}\n        </div>\n      ) : null}\n      <svg viewBox=\"0 0 100 100\" style={{ position: 'absolute', width: 84, height: 84, left: left ? W - 280 : Math.round(0.63 * W), top: 200 + sway * 5, transform: 'rotate(' + (10 + sway * 6) + 'deg)', opacity: popIn }}>\n        <path d=\"M50 8 L59 38 L90 38 L64 56 L74 88 L50 68 L26 88 L36 56 L10 38 L41 38 Z\" fill=\"none\" stroke={yellow} strokeWidth=\"5\" strokeLinejoin=\"round\" />\n      </svg>\n      <svg viewBox=\"0 0 90 90\" style={{ position: 'absolute', width: 60, height: 60, left: left ? W - 380 : Math.round(0.58 * W), top: 320 - sway * 4, transform: 'rotate(-8deg)', opacity: popIn }}>\n        <path d=\"M45 10 L51 34 L76 34 L55 48 L63 74 L45 58 L27 74 L35 48 L14 34 L39 34 Z\" fill=\"none\" stroke={pink} strokeWidth=\"5\" strokeLinejoin=\"round\" />\n      </svg>\n      <svg viewBox=\"0 0 120 60\" style={{ position: 'absolute', width: 140, height: 70, left: cx + (left ? R + 24 : -R - 166), top: cy - R - 60 + sway * 4, transform: left ? 'scaleX(-1) rotate(9deg)' : 'rotate(9deg)', opacity: popIn }}>\n        <path d=\"M8 12 C 40 2, 78 6, 102 34\" fill=\"none\" stroke={pink} strokeWidth=\"5\" strokeLinecap=\"round\" strokeDasharray=\"4 8\" />\n        <path d=\"M92 26 L104 36 L88 40 Z\" fill={pink} />\n      </svg>\n      <div style={{ position: 'absolute', left: cx - R, top: cy - R, width: R * 2, height: R * 2, transform: 'scale(' + (0.74 + popIn * 0.26) + ') rotate(' + sway * 1.2 + 'deg)' }}>\n        <div style={{ position: 'absolute', inset: -6, borderRadius: '50%', border: '5px solid ' + chalk }} />\n        <div style={{ position: 'absolute', inset: -20, borderRadius: '50%', border: '3px dashed ' + yellow + 'b3', transform: 'rotate(' + (frame * 0.14) + 'deg)' }} />\n      </div>\n      {handle ? (\n        <div style={{ position: 'absolute', left: cx, top: top ? cy + R + 26 : cy - R - 70, transform: 'translateX(-50%) rotate(-2deg)', opacity: popIn, border: '3px solid ' + chalk, borderRadius: 10, padding: '7px 22px', fontSize: 27, fontWeight: 800, color: chalk, whiteSpace: 'nowrap', background: '#2e3a33e6' }}>{handle}</div>\n      ) : null}\n    </AbsoluteFill>\n  );\n};"
  },
