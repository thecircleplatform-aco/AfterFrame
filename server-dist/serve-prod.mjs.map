  "code": "const Timeline = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const m1Year = props.m1Year;\n  const m1Text = props.m1Text;\n  const m2Year = props.m2Year;\n  const m2Text = props.m2Text;\n  const m3Year = props.m3Year;\n  const m3Text = props.m3Text;\n  const m4Year = props.m4Year;\n  const m4Text = props.m4Text;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const lineColor = props.lineColor;\n  const textColor = props.textColor;\n  const descColor = props.descColor;\n  const gradientColor1 = props.gradientColor1;\n  const gradientColor2 = props.gradientColor2;\n  const fontFamily = props.fontFamily;\n  const titleFontFamily = props.titleFontFamily;\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  const titleSpring = safeSpring(0);\n  const lineProgress = interpolate(frame, [15, 60], [0, 100], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' });\n\n  const nodes = [\n    { year: m1Year, desc: m1Text, delay: 45 },\n    { year: m2Year, desc: m2Text, delay: 75 },\n    { year: m3Year, desc: m3Text, delay: 105 },\n    { year: m4Year, desc: m4Text, delay: 135 },\n  ];\n\n  return (\n    <div style={{\n      position: 'absolute',\n      inset: 0,\n      backgroundColor,\n      overflow: 'hidden',\n      fontFamily,\n      color: textColor\n    }}>\n      {/* Soft gradient blobs */}\n      <div style={{\n        position: 'absolute',\n        top: '-20%',\n        left: '40%',\n        width: '1200px',\n        height: '1200px',\n        background: `radial-gradient(circle, ${gradientColor1} 0%, rgba(255,255,255,0) 60%)`,\n        opacity: 0.6,\n        mixBlendMode: 'normal'\n      }} />\n      <div style={{\n        position: 'absolute',\n        top: '30%',\n        left: '10%',\n        width: '1000px',\n        height: '1000px',\n        background: `radial-gradient(circle, ${gradientColor2} 0%, rgba(255,255,255,0) 60%)`,\n        opacity: 0.4,\n        mixBlendMode: 'normal'\n      }} />\n\n      {/* Title area */}\n      <div style={{\n        position: 'absolute',\n        top: 200,\n        left: 200,\n        opacity: titleSpring,\n        transform: `translateY(${(1 - titleSpring) * 30}px)`,\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 12\n      }}>\n        <div style={{ display: 'flex', alignItems: 'center', gap: 20 }}>\n          <div style={{ width: 24, height: 24, backgroundColor: lineColor }} />\n          <h1 style={{\n            margin: 0,\n            fontSize: 56,\n            fontWeight: 800,\n            letterSpacing: '0.05em',\n            fontFamily: titleFontFamily,\n            color: lineColor\n          }}>{titleText}</h1>\n        </div>\n        <p style={{\n          margin: 0,\n          fontSize: 28,\n          color: descColor,\n          fontWeight: 400,\n          paddingLeft: 44\n        }}>{subtitleText}</p>\n      </div>\n\n      {/* Timeline area */}\n      <div style={{\n        position: 'absolute',\n        top: 600,\n        left: 200,\n        width: 1520,\n        height: 4,\n        display: 'flex',\n        alignItems: 'center'\n      }}>\n        {/* Track background */}\n        <div style={{\n          position: 'absolute',\n          left: 0,\n          right: 0,\n          height: '100%',\n          backgroundColor: 'rgba(0,0,0,0.05)'\n        }} />\n        \n        {/* Animated line fill */}\n        <div style={{\n          position: 'absolute',\n          left: 0,\n          width: `${lineProgress}%`,\n          height: '100%',\n          backgroundColor: lineColor\n        }} />\n\n        {/* Timeline nodes */}\n        {nodes.map((node, i) => {\n          const pct = (i / (nodes.length - 1)) * 100;\n          const nodeSpring = safeSpring(node.delay);\n          \n          return (\n            <div key={i} style={{\n              position: 'absolute',\n              left: `${pct}%`,\n              top: 0,\n              display: 'flex',\n              flexDirection: 'column',\n              alignItems: 'flex-start'\n            }}>\n              {/* Square Pixel Marker */}\n              <div style={{\n                position: 'absolute',\n                left: -12,\n                top: -10,\n                width: 24,\n                height: 24,\n                backgroundColor: lineColor,\n                transform: `scale(${nodeSpring})`,\n                border: `4px solid ${bgColor}`,\n                boxSizing: 'border-box'\n              }} />\n              \n              {/* Node content */}\n              <div style={{\n                position: 'absolute',\n                top: 40,\n                left: -12,\n                width: 320,\n                opacity: nodeSpring,\n                transform: `translateY(${(1 - nodeSpring) * 20}px)`\n              }}>\n                <div style={{\n                  fontSize: 42,\n                  fontWeight: 800,\n                  color: lineColor,\n                  marginBottom: 12,\n                  fontFamily: titleFontFamily,\n                  letterSpacing: '-0.02em'\n                }}>\n                  {node.year}\n                </div>\n                <div style={{\n                  fontSize: 20,\n                  fontWeight: 400,\n                  color: descColor,\n                  lineHeight: 1.4,\n                  whiteSpace: 'normal',\n                  overflowWrap: 'break-word'\n                }}>\n                  {node.desc}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "ca1b1b60-d036-4dfb-a02c-1b511a45a27f",
  "name": "Tech Trends 2026 — Universal Anchor",
  "category": "uncategorized",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgColor": "#f5f5f7",
   "transparentBackground": false,
   "textColor": "#222222",
   "blobColor1": "#f79367",
   "blobColor2": "#f99ca2",
   "accentColor": "#f38279",
