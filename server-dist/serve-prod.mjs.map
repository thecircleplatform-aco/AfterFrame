  "thumb": "/thumbnails/7d205758-dac2-4df5-9735-7ad781d792af.jpg",
  "code": "const ChartAnimation = ({ item }) => { const frame = useCurrentFrame(); const { fps } = useVideoConfig(); const props = item.props || {}; const formula1 = props.formula1; const formula2 = props.formula2; const formula3prefix = props.formula3prefix; const formula3result = props.formula3result; const accentColor = props.accentColor; const barDarkColor = props.barDarkColor; const transparentBackground = props.transparentBackground; const DESIGN_WIDTH = 1920; const DESIGN_HEIGHT = 1080; const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT); const CHAR_DELAY = 1.5; const CHAR_DUR = 10; const charStyle = (startFrame) => { const p = interpolate(frame, [startFrame, startFrame + CHAR_DUR], [0, 1], { easing: Easing.out(Easing.cubic), extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }); return { display: 'inline-block', opacity: p, transform: `translateY(${(1 - p) * 20}px)` }; }; const RevealText = ({ text, lineStart, color, item }) => ( <div style={{ height: '1.7em', overflow: 'hidden', textAlign: 'center', fontSize: 32, fontWeight: 'bold', lineHeight: '1.7em' }}> {text.split('').map((ch, i) => ( <span key={i} style={charStyle(lineStart + i * CHAR_DELAY)}> <span style={{ color: color || '#222' }}>{ch === ' ' ? ' ' : ch}</span> </span> ))} </div> ); const line1End = 2 + formula1.length * CHAR_DELAY + 10; const LINE_GAP = 8; const L1 = 2; const L2 = line1End + LINE_GAP; const line2End = L2 + formula2.length * CHAR_DELAY + 10; const L3p = line2End + LINE_GAP; const L3r = L3p + formula3prefix.length * CHAR_DELAY; const Line3 = ({item}) => ( <div style={{ height: '1.7em', overflow: 'hidden', textAlign: 'center', fontSize: 32, fontWeight: 'bold', lineHeight: '1.7em' }}> {formula3prefix.split('').map((ch, i) => ( <span key={'p'+i} style={charStyle(L3p + i * CHAR_DELAY)}> <span style={{ color: '#333' }}>{ch === ' ' ? ' ' : ch}</span> </span> ))} {formula3result.split('').map((ch, i) => ( <span key={'r'+i} style={charStyle(L3r + i * CHAR_DELAY)}> <span style={{ color: accentColor }}>{ch === ' ' ? ' ' : ch}</span> </span> ))} </div> ); const BAR_DUR = 30; const BAR_STEP = 35; const groups = [ { id: 1, label: 'Year 1', h1: 120, h2: 120, gStart: 3 }, { id: 2, label: 'Year 2', h1: 120, h2: 240, gStart: 3 + BAR_STEP }, { id: 3, label: 'Year 3', h1: 120, h2: 360, gStart: 3 + BAR_STEP * 2 }, { id: 4, label: 'Year 4', h1: 120, h2: 480, gStart: 3 + BAR_STEP * 3 }, { id: 5, label: 'Year 5', h1: 120, h2: 600, gStart: 3 + BAR_STEP * 4 } ]; const xPositions = [460, 700, 940, 1180, 1420]; const barScale = (startFrame) => interpolate(frame, [startFrame, startFrame + BAR_DUR], [0, 1], { easing: Easing.out(Easing.cubic), extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }); const chartBaseY = 850; const chartTopY = 250; const leftAxisX = 340; const rightAxisX = 1540; const chartHeight = chartBaseY - chartTopY; const yLabels = [ { y: 750, left: '$3.6K/yr', right: '$3K' }, { y: 650, left: '$3.6K/yr', right: '$6K' }, { y: 550, left: '$3.6K/yr', right: '$9K' }, { y: 450, left: '$3.6K/yr', right: '$12K' }, { y: 350, left: '$3.6K/yr', right: '$15K' }, { y: 250, left: '$3.6K/yr', right: '$18K' } ]; const ticksLeft = yLabels.slice(0, 1).map(l => ( <React.Fragment key={'left'+l.y}> <div style={{ position: 'absolute', top: l.y-1, left: leftAxisX-10, width: 20, height: 2, backgroundColor: '#222' }} /> <div style={{ position: 'absolute', top: l.y-14, left: leftAxisX-160, width: 140, textAlign: 'right', fontSize: 18, color: '#888', fontWeight: 'bold' }}>{l.left}</div> </React.Fragment> )); const ticksRight = yLabels.map(l => ( <React.Fragment key={'right'+l.y}> <div style={{ position: 'absolute', top: l.y-1, left: rightAxisX-10, width: 20, height: 2, backgroundColor: '#222' }} /> <div style={{ position: 'absolute', top: l.y-14, left: rightAxisX+20, width: 120, textAlign: 'left', fontSize: 18, color: '#444', fontWeight: 'bold' }}>{l.right}</div> </React.Fragment> )); const barW = 70; const gap = 8; const renderedGroups = groups.map((g, i) => { const x = xPositions[i]; const s1 = barScale(g.gStart); const s2 = barScale(g.gStart + 3); return ( <React.Fragment key={g.id}> <div style={{ position: 'absolute', bottom: 1000-chartBaseY, left: x-barW-gap/2, width: barW, height: g.h1, backgroundColor: barDarkColor, transform: `scaleY(${s1})`, transformOrigin: 'bottom' }} /> <div style={{ position: 'absolute', bottom: 1000-chartBaseY, left: x+gap/2, width: barW, height: g.h2, backgroundColor: accentColor, transform: `scaleY(${s2})`, transformOrigin: 'bottom' }} /> <div style={{ position: 'absolute', top: chartBaseY+20, left: x-60, width: 120, textAlign: 'center', fontSize: 20, fontWeight: 'bold', color: '#444' }}>{g.label}</div> </React.Fragment> ); }); return ( <div style={{ position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: `scale(${scale})`, transformOrigin: 'top left', backgroundColor: transparentBackground ? 'transparent' : '#F4F5F7', fontFamily: 'sans-serif' }}> <div style={{ position: 'absolute', top: 40, left: 40, width: 1840, height: 1000, backgroundColor: '#FFFFFF', borderRadius: 20, border: '2px solid #222', boxSizing: 'border-box', overflow: 'hidden' }}> <div style={{ position: 'absolute', inset: 0, backgroundImage: 'linear-gradient(to right, #E5E5E5 2px, transparent 2px), linear-gradient(to bottom, #E5E5E5 2px, transparent 2px)', backgroundSize: '100px 100px', backgroundPosition: '40px 50px' }} /> <div style={{ position: 'absolute', top: 60, left: 0, width: 1840 }}> <RevealText text={formula1} lineStart={L1} color='#222' /> <RevealText text={formula2} lineStart={L2} color='#222' /> <Line3 /> </div> {ticksLeft} {ticksRight} <div style={{ position: 'absolute', top: chartTopY, left: leftAxisX, width: 2, height: chartHeight+2, backgroundColor: '#222' }} /> <div style={{ position: 'absolute', top: chartTopY, left: rightAxisX, width: 2, height: chartHeight+2, backgroundColor: '#222' }} /> <div style={{ position: 'absolute', top: chartBaseY, left: leftAxisX, width: rightAxisX-leftAxisX+2, height: 2, backgroundColor: '#222' }} /> {renderedGroups} </div> </div> ); }"
