  "thumb": "/thumbnails/73711b77-044d-46c6-944b-007e145e9f81.jpg",
  "code": "const ArtDecoShowcase = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const safeFps = fps || 30;\n  const getSpring = (delay, damping = 15) => spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping } });\n  const clampInterpolate = (fr, inR, outR) => interpolate(fr, inR, outR, { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  // Colors\n  const isTransparent = props.transparentBackground;\n  const bgColor = isTransparent ? 'transparent' : props.bgColor;\n  const textColor = props.textColor;\n  const burgundy = props.primaryColor;\n  const coral = props.accentCoral;\n  const teal = props.accentTeal;\n  const gold = props.accentGold;\n  const pink = props.accentPink;\n  const fontFamily = props.fontFamily;\n\n  // Timings\n  const bgSp = getSpring(0, 20);\n  const titleSp = getSpring(10);\n  const row1Sp = getSpring(20);\n  const row2Sp = getSpring(40);\n\n  // Corner scales for decorative fans\n  const r1 = 350 * bgSp;\n  const r2 = 270 * bgSp;\n  const r3 = 190 * bgSp;\n  const r4 = 110 * bgSp;\n  const r5 = 50 * bgSp;\n\n  const CornerFans = ({ cx, cy }) => (\n    <g>\n      <circle cx={cx} cy={cy} r={r1} fill={burgundy} />\n      <circle cx={cx} cy={cy} r={r2} fill={teal} />\n      <circle cx={cx} cy={cy} r={r3} fill={coral} />\n      <circle cx={cx} cy={cy} r={r4} fill={pink} />\n      <circle cx={cx} cy={cy} r={r5} fill={gold} />\n    </g>\n  );\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor: bgColor, overflow: 'hidden', fontFamily, color: textColor }}>\n      {/* SVG Background Layer - Art Deco Frames & Corners */}\n      <svg width=\"1920\" height=\"1080\" style={{ position: 'absolute', inset: 0 }}>\n        {CornerFans({ cx: 0, cy: 0 })}\n        {CornerFans({ cx: 1920, cy: 0 })}\n        {CornerFans({ cx: 0, cy: 1080 })}\n        {CornerFans({ cx: 1920, cy: 1080 })}\n        \n        <rect x=\"40\" y=\"40\" width=\"1840\" height=\"1000\" fill=\"none\" stroke={gold} strokeWidth=\"2\" strokeOpacity={clampInterpolate(frame, [10, 30], [0, 1])} />\n        <rect x=\"55\" y=\"55\" width=\"1810\" height=\"970\" fill=\"none\" stroke={teal} strokeWidth=\"1\" strokeOpacity={clampInterpolate(frame, [15, 35], [0, 0.6])} />\n      </svg>\n\n      {/* 1. Chapter Title */}\n      <div style={{\n        position: 'absolute', top: 100, width: '100%', textAlign: 'center',\n        opacity: clampInterpolate(frame, [10, 25], [0, 1]),\n        transform: `translateY(${clampInterpolate(frame, [10, 25], [20, 0])}px)`\n      }}>\n        <h1 style={{ fontSize: 52, margin: 0, letterSpacing: '0.15em', fontWeight: 600, textTransform: 'uppercase', textShadow: `0px 4px 12px rgba(0,0,0,0.5)` }}>\n          {props.titleText}\n        </h1>\n        <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', marginTop: 15, gap: 20 }}>\n           <div style={{ height: 1, width: 250 * titleSp, backgroundColor: gold }} />\n           <div style={{ width: 10, height: 10, backgroundColor: coral, transform: `rotate(45deg) scale(${titleSp})` }} />\n           <div style={{ height: 1, width: 250 * titleSp, backgroundColor: gold }} />\n        </div>\n      </div>\n\n      {/* 2. Data Chart (Left) */}\n      <div style={{ position: 'absolute', left: 150, top: 280, width: 450, opacity: row1Sp }}>\n        <h3 style={{ fontSize: 22, letterSpacing: '0.1em', marginBottom: 35, color: gold, textTransform: 'uppercase' }}>Artistic Legacy</h3>\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 30 }}>\n          {[\n            { label: props.chartLabel1, val: props.chartVal1, color: coral, sp: getSpring(30) },\n            { label: props.chartLabel2, val: props.chartVal2, color: gold, sp: getSpring(35) },\n            { label: props.chartLabel3, val: props.chartVal3, color: teal, sp: getSpring(40) }\n          ].map((bar, i) => {\n            const currentVal = Math.floor(clampInterpolate(frame, [30 + (i*5), 50 + (i*5)], [0, bar.val]));\n            return (\n              <div key={i} style={{ width: '100%' }}>\n                <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 10, fontSize: 20, fontWeight: 500 }}>\n                  <span>{bar.label}</span>\n                  <span style={{ color: bar.color, width: 50, textAlign: 'right' }}>{currentVal}%</span>\n                </div>\n                <div style={{ width: '100%', height: 14, border: `1px solid ${gold}80`, padding: 2, boxSizing: 'border-box' }}>\n                  <div style={{ width: `${Math.max(0, Math.min(100, bar.val * bar.sp))}%`, height: '100%', backgroundColor: bar.color }} />\n                </div>\n              </div>\n            )\n          })}\n        </div>\n      </div>\n\n      {/* 3. Name Tag (Center) */}\n      <div style={{ \n        position: 'absolute', left: 735, top: 300, width: 450,\n        opacity: row1Sp, transform: `scale(${row1Sp})`\n      }}>\n        <div style={{ border: `2px solid ${gold}`, padding: 8, backgroundColor: 'rgba(26, 16, 18, 0.9)' }}>\n          <div style={{ border: `1px solid ${teal}`, padding: '40px 20px', textAlign: 'center' }}>\n            <h2 style={{ fontSize: 44, margin: '0 0 10px 0', letterSpacing: '0.1em', color: textColor, textTransform: 'uppercase' }}>\n              {props.nameFirst}\n            </h2>\n            <p style={{ fontSize: 22, fontStyle: 'italic', margin: 0, color: coral, letterSpacing: '0.05em' }}>\n              {props.nameRole}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* 4. Highlight Quote (Right) */}\n      <div style={{ \n        position: 'absolute', left: 1320, top: 310, width: 450,\n        opacity: row1Sp, transform: `translateX(${clampInterpolate(frame, [25, 40], [30, 0])}px)`\n      }}>\n        <div style={{ position: 'relative', padding: '20px 0' }}>\n          <span style={{ \n            position: 'absolute', top: -50, left: -30, fontSize: 160, \n            color: gold, opacity: 0.15, lineHeight: 1, fontFamily: 'serif' \n          }}>\n            “\n          </span>\n          <p style={{ fontSize: 34, fontStyle: 'italic', lineHeight: 1.5, margin: 0, position: 'relative', zIndex: 1, color: textColor }}>\n            \"{props.quoteText}\"\n          </p>\n          <div style={{ width: 80 * getSpring(40), height: 2, backgroundColor: coral, marginTop: 40 }} />\n        </div>\n      </div>\n\n      {/* 5. Bullet Points (Left Bottom) */}\n      <div style={{ position: 'absolute', left: 150, top: 720, width: 450 }}>\n        <h3 style={{ fontSize: 22, letterSpacing: '0.1em', marginBottom: 35, color: gold, textTransform: 'uppercase', opacity: clampInterpolate(frame, [40, 55], [0, 1]) }}>\n          Key Movements\n        </h3>\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 24 }}>\n          {[props.bullet1, props.bullet2, props.bullet3].map((txt, i) => {\n            const itemDelay = 45 + (i * 10);\n            const itemSp = getSpring(itemDelay);\n            return (\n              <div key={i} style={{ \n                display: 'flex', alignItems: 'center', gap: 20, opacity: itemSp, \n                transform: `translateX(${clampInterpolate(frame, [itemDelay, itemDelay+15], [20, 0])}px)` \n              }}>\n                <div style={{ width: 10, height: 10, borderRadius: '50%', backgroundColor: pink, transform: `scale(${itemSp})`, boxShadow: `0 0 8px ${pink}80` }} />\n                <span style={{ fontSize: 24, letterSpacing: '0.03em' }}>{txt}</span>\n              </div>\n            )\n          })}\n        </div>\n      </div>\n\n      {/* 6. Timeline (Center/Right Bottom) */}\n      <div style={{ position: 'absolute', left: 735, top: 720, width: 1035, opacity: clampInterpolate(frame, [45, 60], [0, 1]) }}>\n        <h3 style={{ fontSize: 22, letterSpacing: '0.1em', marginBottom: 60, color: gold, textTransform: 'uppercase' }}>\n          Era Timeline\n        </h3>\n        <div style={{ position: 'relative', height: 100 }}>\n          {/* Main Line */}\n          <div style={{ position: 'absolute', top: 11, left: 0, height: 2, width: `${clampInterpolate(frame, [50, 80], [0, 100])}%`, backgroundColor: teal }} />\n          \n          {/* Nodes */}\n          {[props.timeline1, props.timeline2, props.timeline3, props.timeline4].map((yr, i) => {\n            const nodeDelay = 55 + (i * 10);\n            const nodeSp = getSpring(nodeDelay);\n            return (\n              <div key={i} style={{ \n                position: 'absolute', left: `${(i / 3) * 100}%`, top: 0, \n                display: 'flex', flexDirection: 'column', alignItems: 'center', \n                transform: `translateX(-50%)` \n              }}>\n                <div style={{\n                  width: 24, height: 24, borderRadius: '50%',\n                  backgroundColor: burgundy, border: `3px solid ${gold}`,\n                  transform: `scale(${nodeSp})`\n                }} />\n                <span style={{\n                  marginTop: 25, fontSize: 26, color: textColor, fontWeight: 'bold', letterSpacing: '0.05em',\n                  opacity: clampInterpolate(frame, [nodeDelay, nodeDelay+10], [0, 1])\n                }}>\n                  {yr}\n                </span>\n              </div>\n            )\n          })}\n        </div>\n      </div>\n    </div>\n  );\n}"
 },
