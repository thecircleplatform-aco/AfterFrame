   }
  ],
  "thumb": "/thumbnails/a9f9348f-eb15-4064-b5d8-f164dd82cb9b.jpg",
  "code": "const GlowingRingOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\nconst DESIGN_WIDTH = 1920;\nconst DESIGN_HEIGHT = 1080;\nconst scale = Math.min(\n  (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n  (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n);\n\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const bullet1 = props.bullet1;\n  const bullet2 = props.bullet2;\n  const bullet3 = props.bullet3;\n  const fontFamily = props.fontFamily;\n  const glowIntensity = props.glowIntensity;\n  const dotDensity = props.dotDensity;\n  const ringColor = props.ringColor;\n  const transparentBackground = props.transparentBackground;\n\n  const W = 1920;\n  const H = 1080;\n  const canvasScale = Math.min((item?.width || W) / W, (item?.height || H) / H);\n  const safeFps = fps || 30;\n\n  const ringGrowScale = spring({ frame, fps: safeFps, config: { damping: 22, stiffness: 32, mass: 1.6 } });\n  const ringOpacity = interpolate(frame, [0, 12], [0, 1], { extrapolateRight: 'clamp' });\n\n  const tF = Math.max(0, frame - 45);\n  const titleY = interpolate(tF, [0, 28], [-28, 0], { easing: Easing.out(Easing.cubic), extrapolateRight: 'clamp' });\n  const titleOpacity = interpolate(tF, [0, 18], [0, 1], { extrapolateRight: 'clamp' });\n\n  const b1F = Math.max(0, frame - 66);\n  const b1Y = interpolate(b1F, [0, 18], [14, 0], { easing: Easing.out(Easing.quad), extrapolateRight: 'clamp' });\n  const b1O = interpolate(frame, [66, 82], [0, 1], { extrapolateRight: 'clamp' });\n\n  const b2F = Math.max(0, frame - 96);\n  const b2Y = interpolate(b2F, [0, 18], [14, 0], { easing: Easing.out(Easing.quad), extrapolateRight: 'clamp' });\n  const b2O = interpolate(frame, [96, 112], [0, 1], { extrapolateRight: 'clamp' });\n\n  const b3F = Math.max(0, frame - 126);\n  const b3Y = interpolate(b3F, [0, 18], [14, 0], { easing: Easing.out(Easing.quad), extrapolateRight: 'clamp' });\n  const b3O = interpolate(frame, [126, 142], [0, 1], { extrapolateRight: 'clamp' });\n\n  // Single-layer sparse dot grid — matches reference image: subtle, evenly spaced, low opacity\n  // dotDensity=6 → spacing ~38px; higher density = smaller spacing\n  const dotSpacing = Math.max(28, 64 - dotDensity * 3);\n\n  const ringSize = 700;\n  const ringTop = (H - ringSize) / 2 - 50;\n  const ringLeft = (W - ringSize) / 2;\n  const gi = glowIntensity;\n  const titleTop = ringTop + ringSize + 18;\n\n  const ringBoxShadow = [\n    `0 0 ${gi * 2}px 2px rgba(246,240,255,1.0)`,\n    `0 0 ${gi * 8}px 8px rgba(246,240,255,0.75)`,\n    `0 0 ${gi * 20}px 20px rgba(246,240,255,0.45)`,\n    `0 0 ${gi * 45}px 35px rgba(246,240,255,0.22)`,\n    `0 0 ${gi * 80}px 55px rgba(246,240,255,0.10)`,\n    `inset 0 0 ${gi * 4}px 4px rgba(246,240,255,0.90)`,\n    `inset 0 0 ${gi * 12}px 10px rgba(246,240,255,0.55)`,\n    `inset 0 0 ${gi * 28}px 20px rgba(246,240,255,0.25)`,\n  ].join(', ');\n\n  const textGlow = '0 0 8px rgba(246,240,255,0.9), 0 0 20px rgba(246,240,255,0.5), 0 0 40px rgba(246,240,255,0.25)';\n  const titleGlow = '0 0 10px rgba(246,240,255,0.85), 0 0 24px rgba(246,240,255,0.45)';\n\n  const bulletBase = {\n    color: '#f6f0ff',\n    fontSize: '44px',\n    fontWeight: 700,\n    textAlign: 'center',\n    lineHeight: '1.45',\n    width: '100%',\n    wordWrap: 'break-word',\n    textShadow: textGlow,\n  };\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: W, height: H,\n      transform: `scale(${canvasScale})`, transformOrigin: 'top left',\n      backgroundColor: transparentBackground ? 'transparent' : '#0f0916',\n      overflow: 'hidden',\n      fontFamily: fontFamily,\n    }}>\n\n      {/* Single-layer dot field — sparse and clean like reference */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0, right: 0, bottom: 0,\n        backgroundImage: `radial-gradient(circle, rgba(246,240,255,0.40) 1px, transparent 1px)`,\n        backgroundSize: `${dotSpacing}px ${dotSpacing}px`,\n      }} />\n\n      <div style={{\n        position: 'absolute',\n        top: ringTop,\n        left: ringLeft,\n        width: ringSize,\n        height: ringSize,\n        borderRadius: '50%',\n        border: `14px solid ${ringColor}`,\n        backgroundColor: 'rgba(58,52,65, 0.92)',\n        boxShadow: ringBoxShadow,\n        transform: `scale(${ringGrowScale})`,\n        opacity: ringOpacity,\n        display: 'flex',\n        flexDirection: 'column',\n        justifyContent: 'center',\n        alignItems: 'center',\n        gap: '36px',\n        padding: '70px 80px',\n        boxSizing: 'border-box',\n      }}>\n        <div style={{ ...bulletBase, opacity: b1O, transform: `translateY(${b1Y}px)` }}>{bullet1}</div>\n        <div style={{ ...bulletBase, opacity: b2O, transform: `translateY(${b2Y}px)` }}>{bullet2}</div>\n        <div style={{ ...bulletBase, opacity: b3O, transform: `translateY(${b3Y}px)` }}>{bullet3}</div>\n      </div>\n\n      <div style={{\n        position: 'absolute',\n        top: titleTop,\n        width: '100%',\n        textAlign: 'center',\n        color: '#f6f0ff',\n        fontSize: '34px',\n        fontWeight: 600,\n        letterSpacing: '1.5px',\n        textShadow: titleGlow,\n        transform: `translateY(${titleY}px)`,\n        opacity: titleOpacity,\n      }}>{titleText}</div>\n    </div>\n  );\n}"
 },
 {
