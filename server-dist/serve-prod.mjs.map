  "name": "Paper texture text pop-up animation",
  "category": "uncategorized",
  "description": "Full-canvas animated text layout featuring staggered word-by-word slide-ups and a stylized paper-edge marker highlight block dynamically wiping over selected words.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "line1Text": "Most learners waste hours on courses",
   "line2PreText": "that teach",
