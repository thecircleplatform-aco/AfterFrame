  "thumb": "/thumbnails/49e0b581-862b-42fc-bb6b-a17d0c3d1668.jpg",
  "code": "const ClarifyChapterTitle = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const iconEmoji = props.iconEmoji;\n  const line1Text = props.line1Text;\n  const line2Highlight = props.line2Highlight;\n  const line2NormalAfter = props.line2NormalAfter;\n  const highlightColor = props.highlightColor;\n  const textColor = props.textColor;\n  const backgroundColor = props.backgroundColor;\n  const waveColor = props.waveColor;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const enterSlide = interpolate(frame, [0, 10], [1080, 0], {\n    easing: Easing.bezier(0.22, 1, 0.36, 1),\n    extrapolateRight: 'clamp'\n  });\n  const enterOpacity = interpolate(frame, [0, 10], [0, 1], {\n    extrapolateRight: 'clamp'\n  });\n\n  const exitStart = Math.max(10, durationInFrames - 12);\n  const exitSlide = interpolate(frame, [exitStart, durationInFrames - 1], [0, 1080], {\n    easing: Easing.inOut(Easing.ease),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n  const exitBlur = interpolate(frame, [exitStart, durationInFrames - 1], [0, 18], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  const totalY = enterSlide + exitSlide;\n\n  const iconScale = spring({\n    frame: Math.max(0, frame - 8),\n    fps: safeFps,\n    config: { damping: 15, stiffness: 250 }\n  });\n\n  const renderText = (text, startIndex, color) => {\n    if (!text) return null;\n    return text.split('').map((char, i) => {\n      const index = startIndex + i;\n      const delay = 18 + index * 2;\n      const fade = interpolate(frame, [delay, delay + 8], [0, 1], {\n        extrapolateRight: 'clamp',\n        extrapolateLeft: 'clamp'\n      });\n      const slide = interpolate(frame, [delay, delay + 8], [28, 0], {\n        extrapolateRight: 'clamp',\n        extrapolateLeft: 'clamp'\n      });\n      return (\n        <span\n          key={index}\n          style={{\n            display: 'inline-block',\n            opacity: fade,\n            // translate3d 替代 translateY，强制字符层提升为独立 GPU 合成层\n            transform: `translate3d(0, ${slide}px, 0)`,\n            willChange: 'transform',\n            color: color,\n            whiteSpace: 'pre'\n          }}\n        >\n          {char}\n        </span>\n      );\n    });\n  };\n\n  return (\n    <div style={{\n      position: 'absolute',\n      top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      // translate3d(0,0,0) 前置 scale，强制根容器提升为 GPU 合成层\n      transform: `translate3d(0, 0, 0) scale(${scale})`,\n      transformOrigin: 'top left',\n      willChange: 'transform',\n      backgroundColor: 'transparent',\n    }}>\n      <div style={{\n        position: 'absolute',\n        top: 0, left: 0,\n        width: '100%', height: '100%',\n        // translate3d 替代 translateY，面板整体滑动走 GPU 合成\n        transform: `translate3d(0, ${totalY}px, 0)`,\n        willChange: 'transform',\n        opacity: enterOpacity,\n        filter: `blur(${exitBlur}px)`,\n        backgroundColor: backgroundColor,\n        overflow: 'hidden'\n      }}>\n\n        <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', pointerEvents: 'none', filter: 'drop-shadow(0px 16px 32px rgba(0,0,0,0.04))' }}>\n          <path d=\"M 0 0 L 1920 0 L 1920 200 C 1300 450, 600 50, 0 300 Z\" fill={waveColor} />\n        </svg>\n        <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', pointerEvents: 'none', filter: 'drop-shadow(0px -16px 32px rgba(0,0,0,0.04))' }}>\n          <path d=\"M 0 1080 L 1920 1080 L 1920 800 C 1200 1050, 500 700, 0 900 Z\" fill={waveColor} />\n        </svg>\n\n        <div style={{\n          position: 'absolute',\n          top: 0, left: 0, width: '100%', height: '100%',\n          display: 'flex', flexDirection: 'column',\n          alignItems: 'center', justifyContent: 'center',\n          zIndex: 10\n        }}>\n          <div style={{\n            width: 180, height: 180,\n            borderRadius: 40,\n            backgroundColor: '#ffffff',\n            display: 'flex', alignItems: 'center', justifyContent: 'center',\n            boxShadow: '0px 24px 48px rgba(0,0,0,0.06)',\n            // scale 前置 translate3d(0,0,0)，强制图标卡独立 GPU 合成层\n            transform: `translate3d(0, 0, 0) scale(${iconScale})`,\n            willChange: 'transform',\n            marginBottom: 60,\n            fontSize: 90\n          }}>\n            {iconEmoji}\n          </div>\n\n          <div style={{\n            fontFamily: fontFamily,\n            fontWeight: 700,\n            fontSize: 120,\n            lineHeight: 1.15,\n            textAlign: 'center',\n            display: 'flex',\n            flexDirection: 'column',\n            alignItems: 'center',\n            letterSpacing: '-0.02em'\n          }}>\n            <div>\n              {renderText(line1Text, 0, textColor)}\n            </div>\n            <div>\n              {renderText(line2Highlight, (line1Text || '').length, highlightColor)}\n              {renderText(line2NormalAfter, (line1Text || '').length + (line2Highlight || '').length, textColor)}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
