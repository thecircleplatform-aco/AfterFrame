    "defaultValue": 7,
    "label": "Y-Axis Max Value"
   },
   {
    "key": "yAxisSteps",
    "type": "number",
    "defaultValue": 7,
    "label": "Number of Grid Lines",
    "min": 2,
    "step": 1
   },
   {
    "key": "valueSuffix",
