  "code": "const ChapterTitleCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n  const chapterLabel = props.chapterLabel;\n  const titleText = props.titleText;\n  const chapterNumber = props.chapterNumber;\n  const primaryColor = props.primaryColor;\n  const accentColor = props.accentColor;\n  const bloomColor = props.bloomColor;\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n  const t = frame / safeFps;\n  const canvasRef = React.useRef(null);\n  const glRef = React.useRef(null);\n  const progRef = React.useRef(null);\n  const bufRef = React.useRef(null);\n  React.useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const gl = canvas.getContext('webgl', { preserveDrawingBuffer: true, alpha: false, antialias: true });\n    if (!gl) return;\n    glRef.current = gl;\n    const vs = gl.createShader(gl.VERTEX_SHADER);\n    gl.shaderSource(vs, `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`);\n    gl.compileShader(vs);\n    const fs = gl.createShader(gl.FRAGMENT_SHADER);\n    gl.shaderSource(fs, `\n      precision highp float;\n      uniform vec2 res; uniform float time; uniform vec3 c1; uniform vec3 c2; uniform vec3 c3;\n      float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453123); }\n      float blob(vec2 uv, vec2 p, float r) { float d = distance(uv, p); return exp(-(d*d)/(r*r)); }\n      void main() {\n        vec2 baseUv = gl_FragCoord.xy / res.xy;\n        vec2 uv = baseUv; uv.x *= res.x / res.y;\n        float tt = time;\n        vec3 dark = vec3(0.018, 0.016, 0.050);\n        vec3 navy = vec3(0.032, 0.026, 0.095);\n        vec3 col = dark;\n        col += c2 * blob(uv, vec2(1.28 + 0.010*sin(tt*0.22), 0.88 + 0.008*cos(tt*0.18)), 0.18) * 1.10;\