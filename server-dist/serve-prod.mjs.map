    "code": "const ShortsQuoteCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const quote = p.quote || '';\n  const author = p.author || '';\n  const card = p.cardColor || '#0f172aee';\n  const textColor = p.textColor || '#f8fafc';\n  const accent = p.accentColor || '#a78bfa';\n  const enter = spring({ frame, fps, config: { damping: 16, stiffness: 90 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent', justifyContent: 'center', alignItems: 'center' }}>\n      <div style={{\n        width: 900,\n        opacity: enter * exit,\n        transform: `scale(${0.92 + enter * 0.08})`,\n        background: card,\n        borderRadius: 32,\n        padding: '64px 56px',\n        border: `1px solid ${accent}55`,\n        boxShadow: `0 24px 80px #000a, 0 0 0 1px ${accent}22`,\n      }}>\n        <div style={{ fontSize: 72, color: accent, lineHeight: 1, marginBottom: 24, fontWeight: 800 }}>\"</div>\n        <div style={{\n          fontSize: 48,\n          fontWeight: 700,\n          color: textColor,\n          lineHeight: 1.45,\n          letterSpacing: 1,\n        }}>{quote}</div>\n        {author ? (\n          <div style={{ marginTop: 40, fontSize: 28, color: textColor, opacity: 0.65, textAlign: 'right' }}>{author}</div>\n        ) : null}\n      </div>\n    </AbsoluteFill>\n  );\n};"
