  "thumb": "/thumbnails/4792b7a4-126f-48ac-9a0c-7dfcd9a2891b.jpg",
  "code": "const Component = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const fontFamily = props.fontFamily;\n  const text1 = props.text1;\n  const text2 = props.text2;\n  const text3 = props.text3;\n  const text4 = props.text4;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    fontFamily: fontFamily,\n  };\n\n  const iconColor = '#C2504A';\n  const strokeWidth = 2.4;\n\n  const ChefIcon = ({item}) => (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={iconColor} strokeWidth={strokeWidth} strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z\"/>\n      <line x1=\"6\" x2=\"18\" y1=\"17\" y2=\"17\"/>\n    </svg>\n  );\n  const LeafIcon = ({item}) => (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={iconColor} strokeWidth={strokeWidth} strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"/>\n      <path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"/>\n    </svg>\n  );\n  const FlameIcon = ({item}) => (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={iconColor} strokeWidth={strokeWidth} strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/>\n    </svg>\n  );\n  const JarIcon = ({item}) => (\n    <svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={iconColor} strokeWidth={strokeWidth} strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M10 2v4\"/>\n      <path d=\"M14 2v4\"/>\n      <path d=\"M18 6H6a2 2 0 0 0-2 2v2h16V8a2 2 0 0 0-2-2Z\"/>\n      <path d=\"M4 10v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10\"/>\n      <path d=\"M9 16h6\"/>\n    </svg>\n  );\n\n  const cards = [\n    { text: text1, x: 99, cy: 179, icon: ChefIcon },\n    { text: text2, x: 402, cy: 417, icon: LeafIcon },\n    { text: text3, x: 99, cy: 662, icon: FlameIcon },\n    { text: text4, x: 402, cy: 907, icon: JarIcon },\n  ];\n\n  const holeX = 1350;\n  const holeY = 172;\n  const holeW = 514;\n  const holeH = 715;\n  const holeR = 26;\n\n  const bgOpacity = 1;\n\n  const videoBorderStyle = {\n    position: 'absolute', left: holeX, top: holeY, width: holeW, height: holeH,\n    borderRadius: holeR, border: '5px solid #FDFAF4',\n    boxShadow: '0 8px 32px rgba(45, 36, 32, 0.15)',\n    boxSizing: 'border-box',\n    opacity: Math.max(0, bgOpacity),\n  };\n\n  return (\n    <div style={rootStyle}>\n      {!transparentBackground && (\n        <svg width=\"1920\" height=\"1080\" style={{ position: 'absolute', top: 0, left: 0, opacity: Math.max(0, bgOpacity) }}>\n          <defs>\n            <mask id=\"video-hole-mask\">\n              <rect width=\"1920\" height=\"1080\" fill=\"white\" />\n              <rect x={holeX} y={holeY} width={holeW} height={holeH} rx={holeR} fill=\"black\" />\n            </mask>\n          </defs>\n          <rect width=\"1920\" height=\"1080\" fill={bgColor} mask=\"url(#video-hole-mask)\" />\n        </svg>\n      )}\n      \n      <div style={videoBorderStyle} />\n\n      {cards.map((card, i) => {\n        const enterStart = [20, 45, 70, 95][i];\n        const exitStart = 155;\n\n        const enterProgress = interpolate(frame, [enterStart, enterStart + 14], [0, 1], {\n          extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic)\n        });\n        const exitProgress = interpolate(frame, [exitStart, exitStart + 14], [0, 1], {\n          extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.in(Easing.cubic)\n        });\n\n        const opacity = Math.max(0, enterProgress - exitProgress);\n        const translateX = interpolate(enterProgress, [0, 1], [-50, 0]) + interpolate(exitProgress, [0, 1], [0, -50]);\n\n        const textEnterProgress = interpolate(frame, [enterStart + 6, enterStart + 6 + 14], [0, 1], {\n          extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic)\n        });\n        const textOpacity = Math.max(0, textEnterProgress);\n\n        const cardStyle = {\n          position: 'absolute',\n          left: card.x,\n          top: card.cy - 80,\n          width: 735,\n          height: 160,\n          backgroundColor: '#F2CDD8',\n          borderRadius: 18,\n          display: 'flex',\n          alignItems: 'center',\n          padding: '0 32px',\n          boxSizing: 'border-box',\n          opacity: opacity,\n          transform: `translateX(${translateX}px)`,\n          boxShadow: '0 4px 16px rgba(45, 36, 32, 0.08)'\n        };\n\n        const iconContainerStyle = {\n          width: 90,\n          height: 90,\n          borderRadius: 45,\n          backgroundColor: '#FFFDF8',\n          display: 'flex',\n          justifyContent: 'center',\n          alignItems: 'center',\n          flexShrink: 0,\n        };\n\n        const textStyle = {\n          marginLeft: 32,\n          fontSize: 36,\n          fontWeight: 600,\n          color: '#38302A',\n          opacity: textOpacity,\n          whiteSpace: 'nowrap',\n          overflow: 'hidden',\n          textOverflow: 'ellipsis',\n        };\n\n        const Icon = card.icon;\n\n        return (\n          <div key={`card-${i}`} style={cardStyle}>\n            <div style={iconContainerStyle}>\n              <Icon />\n            </div>\n            <div style={textStyle}>{card.text}</div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};"
 },
