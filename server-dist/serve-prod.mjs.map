  "thumb": "/thumbnails/798fa1a8-771d-4c97-b900-8a9004266304.jpg",
  "code": "const Component = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'Weekly Recipe Saves';\n  const kpiValue = props.kpiValue || '45%';\n  const kpiSubtext1 = props.kpiSubtext1 || 'more engagement';\n  const kpiSubtext2 = props.kpiSubtext2 || 'Information about your recipe activity';\n  const barColor = props.barColor || '#1bc4ad';\n  const kpiColor = props.kpiColor || '#22ac55';\n  const bgColor = props.bgColor || '#E8E6F0';\n  const cardBg = props.cardBg || '#FFFFFF';\n  const fontMain = props.fontMain || 'Inter, sans-serif';\n  const fontMono = props.fontMono || '\"IBM Plex Mono\", monospace';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const cardSpring = safeSpring(5, { damping: 14, mass: 1.2 });\n  const contentSpring = safeSpring(15, { damping: 16 });\n  const areaSpring = safeSpring(20, { damping: 18, mass: 1.5 });\n\n  const chartData = [\n    { day: 'Sunday', val: 21 },\n    { day: 'Monday', val: 10 },\n    { day: 'Tuesday', val: 28 },\n    { day: 'Wednesday', val: 41 },\n    { day: 'Thursday', val: 33 },\n    { day: 'Friday', val: 46 },\n    { day: 'Saturday', val: 60 },\n  ];\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    fontFamily: fontMain,\n    overflow: 'hidden',\n  };\n\n  const cardStyle = {\n    width: 1400,\n    height: 800,\n    backgroundColor: cardBg,\n    borderRadius: 40,\n    boxShadow: '0 30px 80px rgba(0, 0, 0, 0.08)',\n    display: 'flex',\n    flexDirection: 'row',\n    padding: '80px 80px',\n    boxSizing: 'border-box',\n    position: 'relative',\n    overflow: 'hidden',\n    opacity: cardSpring,\n    transform: `translateY(${50 - cardSpring * 50}px)`,\n  };\n\n  const leftColStyle = {\n    width: 500,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'flex-start',\n    position: 'relative',\n    zIndex: 2,\n    opacity: contentSpring,\n    transform: `translateX(${20 - contentSpring * 20}px)`,\n  };\n\n  const rightColStyle = {\n    flex: 1,\n    marginLeft: 80,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    zIndex: 2,\n  };\n\n  const titleStyle = {\n    fontSize: 56,\n    fontWeight: 600,\n    color: '#333333',\n    letterSpacing: '-0.5px',\n    marginBottom: 20,\n  };\n\n  const kpiStyle = {\n    fontSize: 140,\n    fontWeight: 800,\n    color: kpiColor,\n    lineHeight: 1,\n    letterSpacing: '-4px',\n    marginBottom: 30,\n  };\n\n  const subtext1Style = {\n    fontSize: 28,\n    fontWeight: 700,\n    color: '#222222',\n    marginBottom: 12,\n  };\n\n  const subtext2Style = {\n    fontSize: 20,\n    fontWeight: 400,\n    color: '#777777',\n    lineHeight: 1.5,\n  };\n\n  const areaChartStyle = {\n    position: 'absolute',\n    bottom: -20,\n    left: -40,\n    width: 480,\n    height: 220,\n    zIndex: -1,\n    clipPath: `inset(0 ${100 - areaSpring * 100}% 0 0)`,\n  };\n\n  const watermarkStyle = {\n    position: 'absolute',\n    right: -80,\n    bottom: -80,\n    width: 140,\n    height: 140,\n    opacity: 0.07,\n    zIndex: 1,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        {/* Dot Grid Watermark */}\n        <svg style={watermarkStyle} viewBox=\"0 0 100 100\">\n          {Array.from({length: 6}).map((_, row) =>\n            Array.from({length: 6}).map((_, col) => (\n              <circle\n                key={row * 6 + col}\n                cx={col * 20 + 10}\n                cy={row * 20 + 10}\n                r=\"3\"\n                fill=\"#000000\"\n              />\n            ))\n          )}\n        </svg>\n\n        <div style={leftColStyle}>\n          <div style={titleStyle}>{titleText}</div>\n          <div style={kpiStyle}>{kpiValue}</div>\n          <div style={subtext1Style}>{kpiSubtext1}</div>\n          <div style={subtext2Style}>{kpiSubtext2}</div>\n          \n          {/* Subtle area line chart background for the left column */}\n          <svg style={areaChartStyle} viewBox=\"0 0 600 300\" preserveAspectRatio=\"none\">\n            <defs>\n              <linearGradient id=\"areaGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                <stop offset=\"0%\" stopColor={kpiColor} stopOpacity=\"0.2\" />\n                <stop offset=\"100%\" stopColor={kpiColor} stopOpacity=\"0.0\" />\n              </linearGradient>\n            </defs>\n            <path \n              d=\"M0,200 C100,200 150,120 250,140 C350,160 400,60 500,80 C550,90 580,40 600,40 L600,300 L0,300 Z\"\n              fill=\"url(#areaGrad)\"\n            />\n            <path \n              d=\"M0,200 C100,200 150,120 250,140 C350,160 400,60 500,80 C550,90 580,40 600,40\"\n              fill=\"none\"\n              stroke={kpiColor}\n              strokeWidth=\"4\"\n              strokeOpacity=\"0.4\"\n            />\n          </svg>\n        </div>\n\n        <div style={rightColStyle}>\n          {chartData.map((d, i) => {\n            const bSpring = safeSpring(30 + i * 4, { damping: 14 });\n            const fillWidth = bSpring * d.val;\n            \n            return (\n              <div \n                key={d.day} \n                style={{\n                  display: 'flex', \n                  alignItems: 'center', \n                  marginBottom: i === chartData.length - 1 ? 0 : 36,\n                  opacity: bSpring + 0.2\n                }}\n              >\n                <div style={{\n                  width: 140, \n                  fontSize: 22, \n                  fontWeight: 600, \n                  color: '#666666'\n                }}>\n                  {d.day}\n                </div>\n                \n                <div style={{\n                  flex: 1, \n                  height: 32, \n                  backgroundColor: '#F0F2F5', \n                  borderRadius: 16, \n                  overflow: 'hidden', \n                  position: 'relative'\n                }}>\n                  <div style={{\n                    position: 'absolute',\n                    top: 0,\n                    left: 0,\n                    height: '100%',\n                    width: `${fillWidth}%`,\n                    backgroundColor: barColor,\n                    borderRadius: 16,\n                  }} />\n                </div>\n                \n                <div style={{\n                  width: 90, \n                  textAlign: 'right', \n                  fontSize: 26, \n                  fontWeight: 700, \n                  fontFamily: fontMono,\n                  color: barColor\n                }}>\n                  {Math.round(fillWidth)}%\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
