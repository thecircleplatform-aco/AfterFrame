  "thumb": "/thumbnails/264faf42-2010-4812-94c6-b3c389204815.jpg",
  "code": "const VictorianChart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n\n  const title = props.title;\n  const label1 = props.label1;\n  const val1 = Number(props.val1);\n  const color1 = props.color1;\n  const label2 = props.label2;\n  const val2 = Number(props.val2);\n  const color2 = props.color2;\n  const label3 = props.label3;\n  const val3 = Number(props.val3);\n  const color3 = props.color3;\n  const label4 = props.label4;\n  const val4 = Number(props.val4);\n  const color4 = props.color4;\n\n  const textColor = props.textColor;\n  const bgColor = props.bgColor;\n  const fontFamily = props.fontFamily;\n  const isTransparent = props.transparentBackground;\n  const backgroundColor = isTransparent ? 'transparent' : bgColor;\n  const accentColorChart = '#926859';\n\n  // Parse hex to r,g,b for rgba usage\n  const parseHex = (hex) => {\n    if (!hex) return [0, 0, 0];\n    const h = hex.replace('#', '');\n    const r = parseInt(h.length === 3 ? h[0]+h[0] : h.substring(0,2), 16) || 0;\n    const g = parseInt(h.length === 3 ? h[1]+h[1] : h.substring(2,4), 16) || 0;\n    const b = parseInt(h.length === 3 ? h[2]+h[2] : h.substring(4,6), 16) || 0;\n    return [r, g, b];\n  };\n\n  const [tr, tg, tb] = parseHex(textColor);\n  const rgba = (r, g, b, a) => `rgba(${r},${g},${b},${a})`;\n  const textRgba = (a) => rgba(tr, tg, tb, a);\n\n  const [ar, ag, ab] = parseHex('#926859');\n  const accentRgba = (a) => rgba(ar, ag, ab, a);\n\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n  const bellCurveLate = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return t < 0.4\n      ? 0.15 * Math.pow(t / 0.4, 2.5)\n      : 0.15 + 0.85 * (1 - Math.pow(1 - (t - 0.4) / 0.6, 2.8));\n  };\n\n  // Exit\n  const totalFrames = durationInFrames || 180;\n  const exitStart = totalFrames - 30;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / (totalFrames - 1 - exitStart)));\n  const exitAlpha = 1 - exitRaw * exitRaw;\n\n  // Border fade in\n  const borderAlpha = smoothSettle(Math.min(1, Math.max(0, frame / 35))) * exitAlpha;\n\n  // Title\n  const titleRaw = Math.min(1, Math.max(0, (frame - 10) / 45));\n  const titleProgress = smoothSettle(titleRaw);\n  const titleAlpha = smoothSettle(Math.min(1, Math.max(0, (frame - 10) / 18))) * exitAlpha;\n\n  const titleY = (1 - titleProgress) * 30;\n\n  // Grid\n  const gridRaw = Math.min(1, Math.max(0, (frame - 15) / 40));\n  const gridProgress = smoothSettle(gridRaw);\n  const gridAlpha = 0.3 * gridProgress * exitAlpha;\n\n  // Bar data\n  const data = [\n    { label: label1, value: val1, color: color1, delay: 30 },\n    { label: label2, value: val2, color: color2, delay: 50 },\n    { label: label3, value: val3, color: color3, delay: 70 },\n    { label: label4, value: val4, color: color4, delay: 90 },\n  ];\n\n  const chartMax = Math.max(50, val1, val2, val3, val4);\n  const xMax = Math.ceil(chartMax / 10) * 10;\n\n  const gridLines = [];\n  for (let i = 0; i <= xMax; i += 10) {\n    gridLines.push(i);\n  }\n\n  const chartBorderScale = 0.95 + borderAlpha * 0.05;\n\n  const CornerFlourishChart = ({ style, item }) => (\n    <div style={{ position: 'absolute', width: 150, height: 150, ...style }}>\n      <svg viewBox=\"0 0 150 150\" width=\"100%\" height=\"100%\">\n        <g stroke={accentColorChart} fill=\"none\" strokeWidth=\"1.5\" strokeLinecap=\"round\" opacity={borderAlpha}>\n          <path d=\"M 0,150 C 0,50 50,0 150,0\" />\n          <path d=\"M 15,150 C 15,70 70,15 150,15\" />\n          <path d=\"M 30,150 C 30,90 70,50 110,40 C 130,35 140,45 130,60 C 115,80 90,60 95,45 C 100,35 110,35 115,45\" />\n          <path d=\"M 150,30 C 90,30 50,70 40,110 C 35,130 45,140 60,130 C 80,115 60,90 45,95 C 35,100 35,110 45,115\" />\n          <circle cx=\"20\" cy=\"20\" r=\"2.5\" fill={accentColorChart} />\n          <path d=\"M 0,0 L 25,0 C 25,25 0,25 0,25 Z\" fill={accentColorChart} stroke=\"none\" />\n        </g>\n      </svg>\n    </div>\n  );\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor, fontFamily, overflow: 'hidden', opacity: exitAlpha }}>\n      {/* Border */}\n      <div style={{\n        position: 'absolute', top: 50, left: 60, right: 60, bottom: 50,\n        border: `2px solid ${accentRgba(borderAlpha)}`,\n        padding: 12,\n        transform: `scale(${chartBorderScale})`,\n        boxSizing: 'border-box'\n      }}>\n        <div style={{ width: '100%', height: '100%', border: `1px solid ${accentRgba(borderAlpha)}`, position: 'relative', boxSizing: 'border-box' }}>\n          <CornerFlourishChart style={{ top: 0, left: 0 }} />\n          <CornerFlourishChart style={{ top: 0, right: 0, transform: 'scaleX(-1)' }} />\n          <CornerFlourishChart style={{ bottom: 0, left: 0, transform: 'scaleY(-1)' }} />\n          <CornerFlourishChart style={{ bottom: 0, right: 0, transform: 'scale(-1, -1)' }} />\n        </div>\n      </div>\n\n      {/* Title */}\n      <div style={{\n        position: 'absolute', top: 120, left: 0, width: '100%',\n        textAlign: 'center', fontSize: 72, fontWeight: 'bold',\n        color: textRgba(titleAlpha),\n        transform: `translateY(${titleY}px)`\n      }}>\n        {title}\n      </div>\n\n      {/* Chart area */}\n      <div style={{ position: 'absolute', top: 280, left: 400, width: 1200, height: 650 }}>\n        {/* Grid lines */}\n        <div style={{ position: 'absolute', inset: 0 }}>\n          {gridLines.map((val, i) => {\n            const xPos = (val / xMax) * 1200;\n            return (\n              <div key={`g${i}`} style={{\n                position: 'absolute', left: xPos, top: 0, bottom: 0,\n                width: 1\n              }}>\n                <div style={{\n                  position: 'absolute', top: 0, bottom: 0, width: 1,\n                  backgroundColor: textRgba(gridAlpha)\n                }} />\n                <div style={{\n                  position: 'absolute', bottom: -40, left: -40, width: 80,\n                  textAlign: 'center', fontSize: 22, color: textRgba(gridProgress * exitAlpha)\n                }}>\n                  {val}%\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Bars */}\n        <div style={{\n          position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column',\n          justifyContent: 'space-evenly'\n        }}>\n          {data.map((d, i) => {\n            const barRaw = Math.min(1, Math.max(0, (frame - d.delay) / 55));\n            const barProgress = bellCurveLate(barRaw);\n            const w = (d.value / xMax) * 1200;\n            const labelAlpha = smoothSettle(Math.min(1, Math.max(0, (frame - d.delay) / 20))) * exitAlpha;\n            const valAlpha = barProgress > 0.6 ? smoothSettle((barProgress - 0.6) / 0.4) * exitAlpha : 0;\n            const [cr, cg, cb] = parseHex(d.color);\n            const barColorAlpha = barProgress * exitAlpha;\n            return (\n              <div key={`b${i}`} style={{\n                display: 'flex', alignItems: 'center', height: 80, position: 'relative'\n              }}>\n                <div style={{\n                  position: 'absolute', left: -340, width: 300,\n                  textAlign: 'right', fontSize: 22, fontWeight: 'bold',\n                  color: textRgba(labelAlpha)\n                }}>\n                  {d.label}\n                </div>\n                <div style={{\n                  height: '100%', backgroundColor: rgba(cr, cg, cb, barColorAlpha),\n                  width: w * barProgress,\n                  display: 'flex', alignItems: 'center', paddingLeft: 24,\n                  overflow: 'hidden', whiteSpace: 'nowrap'\n                }}>\n                  <span style={{ fontSize: 22, fontWeight: 'bold', color: rgba(255, 255, 255, valAlpha) }}>\n                    {d.value}%\n                  </span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
