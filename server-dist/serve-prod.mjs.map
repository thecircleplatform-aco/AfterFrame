  "thumb": "/thumbnails/3f1510e3-5908-46ac-87f4-1714a57671f0.jpg",
  "code": "const Showcase = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n  \n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const accentColor = props.accentColor;\n  const textColor = props.textColor;\n  const titleFont = props.titleFontFamily;\n  const monoFont = props.monoFontFamily;\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay) => spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping: 15, stiffness: 100 } });\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: bgColor,\n    fontFamily: monoFont,\n    color: textColor,\n    display: 'grid',\n    gridTemplateColumns: 'repeat(3, 1fr)',\n    gridTemplateRows: 'repeat(2, 1fr)',\n    gap: '40px',\n    padding: '80px',\n    boxSizing: 'border-box'\n  };\n\n  const cellStyle = (index) => ({\n    border: `4px solid ${accentColor}`,\n    position: 'relative',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    padding: '40px',\n    overflow: 'hidden',\n    opacity: interpolate(frame - index * 10, [0, 10], [0, 1], { extrapolateRight: 'clamp' }),\n    transform: `translateY(${interpolate(safeSpring(index * 10), [0, 1], [50, 0])}px)`\n  });\n\n  // Component 1: Chapter Title\n  const chapterTitleCell = (\n    <div style={cellStyle(0)}>\n      <div style={{ position: 'absolute', top: 20, left: 20, opacity: 0.5 }}>// 01 CHAPTER</div>\n      <div style={{ fontFamily: titleFont, fontSize: '72px', fontWeight: 'bold', lineHeight: 1, textTransform: 'uppercase' }}>\n        {props.chapterTitle1}\n      </div>\n      <div style={{ fontFamily: titleFont, fontSize: '64px', fontWeight: 'bold', color: accentColor, marginTop: '10px', textTransform: 'uppercase' }}>\n        {props.chapterTitle2}\n      </div>\n    </div>\n  );\n\n  // Component 2: Data Chart\n  const chartScale = safeSpring(20);\n  const renderBar = (label, pct, value, index) => (\n    <div key={label} style={{ marginBottom: '20px' }}>\n      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '8px', fontSize: '18px', fontWeight: 'bold' }}>\n        <span>{label}</span>\n        <span>{value}</span>\n      </div>\n      <div style={{ width: '100%', height: '24px', backgroundColor: '#333' }}>\n        <div style={{ width: `${pct * chartScale}%`, height: '100%', backgroundColor: accentColor }} />\n      </div>\n    </div>\n  );\n  const dataChartCell = (\n    <div style={cellStyle(1)}>\n      <div style={{ position: 'absolute', top: 20, left: 20, opacity: 0.5 }}>// 02 METRICS</div>\n      <div style={{ marginTop: '30px' }}>\n        {renderBar(props.chartLabel1, 92, props.chartValue1, 0)}\n        {renderBar(props.chartLabel2, 85, props.chartValue2, 1)}\n        {renderBar(props.chartLabel3, 78, props.chartValue3, 2)}\n      </div>\n    </div>\n  );\n\n  // Component 3: Name Tag\n  const tagWidth = interpolate(safeSpring(30), [0, 1], [0, 100]);\n  const nameTagCell = (\n    <div style={{...cellStyle(2), justifyContent: 'flex-start', padding: 0}}>\n       <div style={{ position: 'absolute', top: 20, left: 20, opacity: 0.5 }}>// 03 IDENTITY</div>\n       <div style={{ marginTop: '80px', padding: '0 40px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', width: '100%', boxSizing: 'border-box' }}>\n         <div style={{ fontSize: '32px', fontWeight: 'bold' }}>{props.nameTagLeft}</div>\n         <div style={{ backgroundColor: accentColor, color: bgColor, padding: '10px 20px', fontSize: '32px', fontWeight: 'bold' }}>{props.nameTagRight}</div>\n       </div>\n       <div style={{ height: '8px', backgroundColor: accentColor, width: `${tagWidth}%`, position: 'absolute', bottom: 40, left: 40 }} />\n    </div>\n  );\n\n  // Component 4: Bullet Points\n  const bulletPointsCell = (\n    <div style={cellStyle(3)}>\n      <div style={{ position: 'absolute', top: 20, left: 20, opacity: 0.5 }}>// 04 STRATEGY</div>\n      <div style={{ marginTop: '30px', display: 'flex', flexDirection: 'column', gap: '24px' }}>\n        {[props.bullet1, props.bullet2, props.bullet3].map((text, i) => (\n          <div key={i} style={{ display: 'flex', alignItems: 'center', opacity: interpolate(safeSpring(40 + i * 10), [0, 1], [0, 1]) }}>\n            <div style={{ width: '20px', height: '20px', backgroundColor: accentColor, marginRight: '20px' }} />\n            <div style={{ fontSize: '28px' }}>{text}</div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n\n  // Component 5: Highlight Quote\n  const quoteCell = (\n    <div style={{...cellStyle(4), backgroundColor: accentColor, color: bgColor, border: 'none'}}>\n      <div style={{ position: 'absolute', top: 20, left: 20, opacity: 0.5 }}>// 05 VISION</div>\n      <div style={{ fontFamily: titleFont, fontSize: '48px', fontStyle: 'italic', fontWeight: 'bold', lineHeight: 1.2, opacity: interpolate(safeSpring(50), [0, 1], [0, 1]) }}>\n        \"{props.quoteText}\"\n      </div>\n    </div>\n  );\n\n  // Component 6: Timeline\n  const timelineScale = safeSpring(60);\n  const timelineCell = (\n    <div style={cellStyle(5)}>\n      <div style={{ position: 'absolute', top: 20, left: 20, opacity: 0.5 }}>// 06 ROADMAP</div>\n      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', position: 'relative', marginTop: '40px' }}>\n        <div style={{ position: 'absolute', top: '50%', left: 0, height: '4px', backgroundColor: accentColor, width: `${timelineScale * 100}%`, transform: 'translateY(-50%)' }} />\n        {[props.time1, props.time2, props.time3, props.time4].map((t, i) => (\n          <div key={i} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', zIndex: 1, opacity: interpolate(safeSpring(70 + i * 5), [0, 1], [0, 1]) }}>\n            <div style={{ width: '24px', height: '24px', backgroundColor: bgColor, border: `4px solid ${accentColor}`, borderRadius: '50%', marginBottom: '16px' }} />\n            <div style={{ fontSize: '24px', fontWeight: 'bold', backgroundColor: bgColor, padding: '4px 8px' }}>{t}</div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n\n  return (\n    <div style={rootStyle}>\n      {chapterTitleCell}\n      {dataChartCell}\n      {nameTagCell}\n      {bulletPointsCell}\n      {quoteCell}\n      {timelineCell}\n    </div>\n  );\n};"
 },
