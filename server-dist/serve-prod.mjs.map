  ],
  "thumb": "/thumbnails/7fa3108f-346f-42ba-b707-b15e8282fe6e.jpg",
  "code": "const RetroPopCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const quoteText = props.quoteText || \"A GREAT PODCAST ISN'T JUST WHAT YOU SAY — IT'S HOW YOU LISTEN\";\n  const tickerText = props.tickerText || \"NOW PLAYING\";\n  const headerColor = props.headerColor || \"#db8476\";\n  const cardBgColor = props.cardBgColor || \"#FFFFFF\";\n  const borderColor = props.borderColor || \"#000000\";\n  const shadowColor = props.shadowColor || \"#000000\";\n  const font = props.fontFamily || '\"VT323\", \"IBM Plex Mono\", monospace';\n\n  const DESIGN_WIDTH = 700;\n  const DESIGN_HEIGHT = 260;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  // Bouncy entrance after a short delay\n  const scaleAnim = spring({\n    frame: Math.max(0, frame - 5),\n    fps: safeFps,\n    config: { damping: 12, stiffness: 150, mass: 1 }\n  });\n  // Slight tilt during entrance for extra character\n  const rotAnim = interpolate(scaleAnim, [0, 1], [-4, 0]);\n\n  // Continuous ticker animation\n  const tickerSpeed = 2;\n  const tickerX = -(frame * tickerSpeed);\n  const repeatedTicker = Array(50).fill(`${tickerText}  +  `).join(\"\");\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  const cardStyle = {\n    width: 620,\n    height: 180,\n    backgroundColor: cardBgColor,\n    border: `2px solid ${borderColor}`,\n    boxShadow: `8px 8px 0px ${shadowColor}`,\n    display: 'flex',\n    flexDirection: 'column',\n    transform: `scale(${scaleAnim}) rotate(${rotAnim}deg)`,\n    fontFamily: font,\n    position: 'relative',\n  };\n\n  const headerStyle = {\n    height: 32,\n    backgroundColor: headerColor,\n    borderBottom: `2px solid ${borderColor}`,\n    display: 'flex',\n    alignItems: 'center',\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n  };\n\n  const tickerStyle = {\n    transform: `translateX(${tickerX}px)`,\n    color: borderColor,\n    fontSize: 18,\n    letterSpacing: 2,\n    paddingTop: 4,\n    textTransform: 'uppercase',\n  };\n\n  const bodyStyle = {\n    flex: 1,\n    padding: '10px 40px',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  const textStyle = {\n    color: borderColor,\n    fontSize: 26,\n    lineHeight: 1.3,\n    textAlign: 'center',\n    textTransform: 'uppercase',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <div style={headerStyle}>\n          <div style={tickerStyle}>{repeatedTicker}</div>\n        </div>\n        <div style={bodyStyle}>\n          <div style={textStyle}>{quoteText}</div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
