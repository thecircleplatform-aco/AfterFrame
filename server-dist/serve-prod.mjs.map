  "thumb": "/thumbnails/d2154a1c-35fa-4685-bbe6-e577adab14bb.jpg",
  "code": "const AnimatedChart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n  const safeFps = fps || 30;\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const unitText = props.unitText;\n  const textColor = props.textColor;\n  const bgBaseColor = props.bgBaseColor;\n  const bgGlowColor = props.bgGlowColor;\n  const barColorTop = props.barColor;\n  const data = [\n    { label: props.label1, val: Number(props.val1), delay: 9 },\n    { label: props.label2, val: Number(props.val2), delay: 21 },\n    { label: props.label3, val: Number(props.val3), delay: 33 },\n    { label: props.label4, val: Number(props.val4), delay: 45 },\n    { label: props.label5, val: Number(props.val5), delay: 57 },\n    { label: props.label6, val: Number(props.val6), delay: 69 }\n  ];\n  const maxVal = Math.max(...data.map(d => d.val), 1);\n  const maxBarHeight = 450;\n  const titleSpring = spring({ frame: Math.max(0, frame - 5), fps: safeFps, config: { damping: 40, mass: 1, stiffness: 100 }});\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [30, 0]);\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: bgBaseColor,\n    fontFamily: \"'DM Sans', 'Inter', 'Helvetica Neue', Arial, sans-serif\",\n    overflow: 'hidden',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n  };\n  return (\n    <div style={rootStyle}>\n      {/* 双色光晕背景 */}\n      <div style={{ position: 'absolute', left: 0, right: 0, bottom: 0, height: '80%', background: `radial-gradient(ellipse at 35% 100%, ${bgGlowColor} 0%, transparent 60%)`, opacity: 0.75 }} />\n      <div style={{ position: 'absolute', left: 0, right: 0, bottom: 0, height: '70%', background: `radial-gradient(ellipse at 68% 100%, #00baa3 0%, transparent 55%)`, opacity: 0.35 }} />\n      {/* 标题区 */}\n      <div style={{ position: 'absolute', left: 200, top: 150, opacity: titleOpacity, transform: `translateY(${titleY}px)` }}>\n        <div style={{ color: textColor, fontSize: 84, fontWeight: 900, letterSpacing: '-0.02em', marginBottom: 16 }}>{titleText}</div>\n        <div style={{ color: textColor, fontSize: 48, fontWeight: 700, letterSpacing: '-0.01em', opacity: 0.75 }}>{subtitleText}</div>\n      </div>\n      {/* 柱状图区 */}\n      <div style={{ position: 'absolute', left: 200, top: 350, width: 1520, height: 600, display: 'flex', flexDirection: 'row', justifyContent: 'space-between' }}>\n        {data.map((d, i) => {\n          const progress = spring({ frame: Math.max(0, frame - d.delay), fps: safeFps, config: { damping: 40, mass: 1, stiffness: 100 } });\n          const currentVal = Math.round(interpolate(progress, [0, 1], [0, d.val]));\n          const h = (d.val / maxVal) * maxBarHeight * Math.max(0, progress);\n          const colOpacity = interpolate(progress, [0, 1], [0, 1]);\n          const barGradient = `linear-gradient(to top, #4c7475, ${barColorTop})`;\n          return (\n            <div key={i} style={{ width: 140, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'flex-end' }}>\n              <div style={{ opacity: colOpacity, marginBottom: 20, fontSize: 42, fontWeight: 800, color: textColor, letterSpacing: '-0.03em' }}>\n                {currentVal}{unitText}\n              </div>\n              <div style={{ width: '100%', height: h, background: barGradient, borderRadius: '6px 6px 0 0', boxShadow: `0 0 24px rgba(0,186,163,${colOpacity * 0.45})` }} />\n              <div style={{ opacity: colOpacity, marginTop: 24, fontSize: 36, fontWeight: 800, color: textColor, textTransform: 'uppercase', letterSpacing: '0.05em' }}>\n                {d.label}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "5a3d3074-e947-454c-be17-61763d195186",
  "name": "Minimal Gradient — Chapter Title Card",
