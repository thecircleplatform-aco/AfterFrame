   }
  ],
  "thumb": "/thumbnails/6fba5c4c-4003-41c3-b1ea-3482b1214293.jpg",
  "code": "const VoxAreaChart = ({ item }) => {\n  const baseFrame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const frame = Math.floor(baseFrame / 3) * 3;\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const blueText = props.blueText;\n  const pinkText = props.pinkText;\n  const backgroundColor = props.backgroundColor;\n  const blueColor = props.blueColor;\n  const pinkColor = props.pinkColor;\n  const yellowColor = props.yellowColor;\n  const transparentBackground = props.transparentBackground;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const startX = 180;\n  const endX = 1740;\n  const startY = 910;\n  const endY = 340;\n  const chartW = endX - startX;\n  const chartH = startY - endY;\n  const maxVal = 16;\n\n  const mapX = (year) => startX + ((year - 1999) / 24) * chartW;\n  const mapY = (val) => startY - (val / maxVal) * chartH;\n\n  const blueData = [\n    {x:1999,y:14.6},{x:2001,y:12.9},{x:2003,y:11.2},{x:2005,y:8.8},\n    {x:2007,y:7.5},{x:2009,y:6.3},{x:2011,y:4.6},{x:2013,y:2.8},\n    {x:2015,y:1.9},{x:2017,y:1.5},{x:2019,y:1.1},{x:2021,y:1.2},{x:2023,y:1.3}\n  ];\n\n  const pinkData = [\n    {x:1999,y:0},{x:2003,y:0},{x:2008,y:0.1},{x:2010,y:0.3},\n    {x:2012,y:1.0},{x:2014,y:2.2},{x:2016,y:3.9},{x:2018,y:7.4},\n    {x:2020,y:10.1},{x:2022,y:13.3},{x:2023,y:14.4}\n  ];\n\n  const buildPath = (data) => {\n    let p = 'M ' + mapX(data[0].x) + ' ' + startY + ' ';\n    data.forEach(d => { p += 'L ' + mapX(d.x) + ' ' + mapY(d.y) + ' '; });\n    p += 'L ' + mapX(data[data.length-1].x) + ' ' + startY + ' Z';\n    return p;\n  };\n\n  const bluePathStr = buildPath(blueData);\n  const pinkPathStr = buildPath(pinkData);\n  const yTicks = [0,2,4,6,8,10,12,14,16];\n  const xTicks = [1999,2003,2008,2013,2018,2023];\n\n  const yAxisTop = interpolate(frame, [0,15], [startY, endY-30], {extrapolateRight:'clamp'});\n  const xAxisRight = interpolate(frame, [0,15], [startX, endX+30], {extrapolateRight:'clamp'});\n  const ticksOpacity = interpolate(frame, [5,20], [0,1], {extrapolateLeft:'clamp',extrapolateRight:'clamp'});\n  const blueRevealW = interpolate(frame, [15,90], [0, chartW+50], {extrapolateLeft:'clamp',extrapolateRight:'clamp'});\n  const pinkRevealW = interpolate(frame, [30,105], [0, chartW+50], {extrapolateLeft:'clamp',extrapolateRight:'clamp'});\n\n  const itunesSpring = spring({frame: Math.max(0, frame-45), fps:safeFps, config:{damping:15}});\n  const itunesLineY = interpolate(itunesSpring, [0,1], [startY, mapY(16)]);\n  const crossSpring = spring({frame: Math.max(0, frame-75), fps:safeFps, config:{damping:15}});\n  const crossLineY = interpolate(crossSpring, [0,1], [startY, mapY(16)]);\n\n  const textOpacity = interpolate(frame, [105,120], [0,1], {extrapolateLeft:'clamp',extrapolateRight:'clamp'});\n  const bg = transparentBackground ? 'transparent' : (backgroundColor || '#e8e6e0');\n\n  const watermarks = React.useMemo(() => {\n    const symbols = ['∑','∫','π','Δ','α','β','∞','≈','≠','≤','≥','Ω','µ','√'];\n    const out = [];\n    let seed = 12345;\n    const rng = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };\n    for (let i = 0; i < 40; i++) {\n      out.push({ id: i, char: symbols[Math.floor(rng() * symbols.length)],\n        left: `${rng()*110-5}%`, top: `${rng()*110-5}%`,\n        size: 150 + rng()*450, rot: (rng()-0.5)*120, opacity: 0.02+rng()*0.03 });\n    }\n    return out;\n  }, []);\n\n  return (\n    <div style={{position:'absolute',top:0,left:0,width:DESIGN_WIDTH,height:DESIGN_HEIGHT,transform:'scale('+scale+')',transformOrigin:'top left',backgroundColor:bg,overflow:'hidden'}}>\n\n      {!transparentBackground && (\n        <>\n          {/* Grid background — from News Card */}\n          <div style={{ position: 'absolute', inset: 0, zIndex: 1 }}>\n            <svg width=\"100%\" height=\"100%\">\n              <defs>\n                <pattern id=\"acgrid\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\">\n                  <path d=\"M 40 0 L 40 80 M 0 40 L 80 40\" stroke=\"#999\" strokeOpacity=\"0.06\" strokeWidth=\"1.5\"/>\n                  <path d=\"M 33 40 L 47 40 M 40 33 L 40 47\" stroke=\"#999\" strokeOpacity=\"0.15\" strokeWidth=\"2\"/>\n                </pattern>\n              </defs>\n              <rect width=\"100%\" height=\"100%\" fill=\"url(#acgrid)\"/>\n            </svg>\n          </div>\n\n          {/* Watermark symbols — from News Card */}\n          <div style={{ position: 'absolute', inset: 0, zIndex: 2 }}>\n            {watermarks.map(wm => (\n              <div key={wm.id} style={{\n                position: 'absolute', left: wm.left, top: wm.top,\n                fontSize: wm.size, color: '#888', opacity: wm.opacity,\n                transform: `rotate(${wm.rot}deg)`, lineHeight: 1, fontFamily: 'serif',\n              }}>{wm.char}</div>\n            ))}\n          </div>\n        </>\n      )}\n\n      {/* Title + subtitle — left aligned */}\n      <div style={{position:'absolute',top:160,left:startX,opacity:textOpacity,display:'flex',flexDirection:'column',gap:10,zIndex:10}}>\n        <div style={{fontFamily:'Georgia, serif',fontSize:36,color:'#111',fontWeight:'normal'}}>{titleText}</div>\n        <div style={{fontFamily:'Georgia, serif',fontSize:22,fontStyle:'italic',color:'#555'}}>{subtitleText}</div>\n      </div>\n\n      {/* Legend — right-aligned, same top as title, horizontal layout */}\n      <div style={{position:'absolute',top:168,right:DESIGN_WIDTH-endX,display:'flex',flexDirection:'row',alignItems:'center',gap:28,opacity:textOpacity,zIndex:10}}>\n        <div style={{display:'flex',alignItems:'center',gap:10}}>\n          <div style={{width:16,height:16,backgroundColor:blueColor,flexShrink:0}}/>\n          <span style={{fontFamily:'Georgia, serif',fontSize:20,color:'#333',whiteSpace:'nowrap'}}>{blueText}</span>\n        </div>\n        <div style={{display:'flex',alignItems:'center',gap:10}}>\n          <div style={{width:16,height:16,backgroundColor:pinkColor,flexShrink:0}}/>\n          <span style={{fontFamily:'Georgia, serif',fontSize:20,color:'#333',whiteSpace:'nowrap'}}>{pinkText}</span>\n        </div>\n      </div>\n\n      <div style={{position:'absolute',left:startX,top:0,width:blueRevealW,height:DESIGN_HEIGHT,overflow:'hidden',pointerEvents:'none',zIndex:10}}>\n        <svg style={{position:'absolute',left:-startX,top:0,width:DESIGN_WIDTH,height:DESIGN_HEIGHT}}>\n          <path d={bluePathStr} fill={blueColor} opacity={0.85}/>\n        </svg>\n      </div>\n\n      <div style={{position:'absolute',left:startX,top:0,width:pinkRevealW,height:DESIGN_HEIGHT,overflow:'hidden',pointerEvents:'none',zIndex:10}}>\n        <svg style={{position:'absolute',left:-startX,top:0,width:DESIGN_WIDTH,height:DESIGN_HEIGHT}}>\n          <path d={pinkPathStr} fill={pinkColor} opacity={0.75}/>\n        </svg>\n      </div>\n\n      <svg style={{position:'absolute',width:'100%',height:'100%',overflow:'visible',zIndex:10}}>\n        {yTicks.map(t => (\n          <line key={'g'+t} x1={startX} x2={endX} y1={mapY(t)} y2={mapY(t)} stroke=\"#000\" strokeWidth={0.8} opacity={ticksOpacity*0.05}/>\n        ))}\n        <line x1={startX} x2={startX} y1={startY} y2={yAxisTop} stroke=\"#222\" strokeWidth={2}/>\n        <line x1={startX} x2={xAxisRight} y1={startY} y2={startY} stroke=\"#222\" strokeWidth={2}/>\n        {yTicks.map(t => (\n          <g key={'y'+t} style={{opacity:ticksOpacity}}>\n            <line x1={startX-8} x2={startX} y1={mapY(t)} y2={mapY(t)} stroke=\"#222\" strokeWidth={1.5}/>\n            <text x={startX-16} y={mapY(t)} textAnchor=\"end\" alignmentBaseline=\"middle\" fontFamily=\"Georgia, serif\" fontSize={22} fill=\"#333\">${t}B</text>\n          </g>\n        ))}\n        {xTicks.map(t => (\n          <g key={'x'+t} style={{opacity:ticksOpacity}}>\n            <line x1={mapX(t)} x2={mapX(t)} y1={startY} y2={startY+8} stroke=\"#222\" strokeWidth={1.5}/>\n            <text x={mapX(t)} y={startY+36} textAnchor=\"middle\" fontFamily=\"Georgia, serif\" fontSize={26} fontStyle=\"italic\" fill=\"#333\">{t}</text>\n          </g>\n        ))}\n        <line x1={mapX(2003)} x2={mapX(2003)} y1={startY} y2={itunesLineY} stroke={yellowColor} strokeWidth={3.5}/>\n        <line x1={mapX(2016)} x2={mapX(2016)} y1={startY} y2={crossLineY} stroke={yellowColor} strokeWidth={3.5}/>\n        <text x={mapX(2003)} y={mapY(16)-18} textAnchor=\"middle\" fontFamily=\"Georgia, serif\" fontSize={30} fontStyle=\"italic\" fill=\"#111\" opacity={textOpacity}>Etsy Launch</text>\n        <text x={mapX(2016)} y={mapY(16)-18} textAnchor=\"middle\" fontFamily=\"Georgia, serif\" fontSize={30} fontStyle=\"italic\" fill=\"#111\" opacity={textOpacity}>Online Surpasses Storefront</text>\n      </svg>\n\n      <div style={{position:'absolute',top:startY-chartH/2,left:58,transform:'translate(-50%,-50%) rotate(-90deg)',fontFamily:'Georgia, serif',fontSize:22,color:'#333',whiteSpace:'nowrap',opacity:ticksOpacity,zIndex:10}}>\n        Revenue (billions USD)\n      </div>\n\n    </div>\n  );\n};\n"
 },
