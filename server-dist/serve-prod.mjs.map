  "thumb": "/thumbnails/d82c1bd4-4654-4f92-809d-32eba00a88f0.jpg",
  "code": "const GeekbenchChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const titleText = props.titleText;\n  const fontFamily = props.fontFamily;\n  const textColor = props.textColor;\n  const subtextColor = props.subtextColor;\n  const backgroundColor = props.backgroundColor;\n  const transparentBackground = props.transparentBackground;\n\n  const g1Phone = props.g1Phone;\n  const g1Chip = props.g1Chip;\n  const g2Phone = props.g2Phone;\n  const g2Chip = props.g2Chip;\n  const g3Phone = props.g3Phone;\n  const g3Chip = props.g3Chip;\n\n  const singleColorStart = props.singleColorStart;\n  const singleColorEnd = props.singleColorEnd;\n  const multiColorStart = props.multiColorStart;\n  const multiColorEnd = props.multiColorEnd;\n\n  // User-editable scores — bar width is proportional to these values\n  const g1Single = typeof props.g1Single === 'number' ? props.g1Single : 3575;\n  const g1Multi  = typeof props.g1Multi  === 'number' ? props.g1Multi  : 10736;\n  const g2Single = typeof props.g2Single === 'number' ? props.g2Single : 2912;\n  const g2Multi  = typeof props.g2Multi  === 'number' ? props.g2Multi  : 8987;\n  const g3Single = typeof props.g3Single === 'number' ? props.g3Single : 1874;\n  const g3Multi  = typeof props.g3Multi  === 'number' ? props.g3Multi  : 5995;\n\n  // Hard limits — user never touches these, they just keep bars in safe range\n  // BAR_MAX_PX = CONTENT_W(1536) - PHONE_COL_W(360) - LABEL_COL_W(110) = 1066px\n  // This ensures the longest bar ends exactly at CONTENT_RIGHT, never beyond\n  const BAR_MAX_PX = 1066;\n  const BAR_MIN_PX = 140;    // bars always wide enough to show the number inside\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const bgColor = transparentBackground\n    ? 'transparent'\n    : interpolateColors(Math.min(frame, 15), [0, 15], ['#000000', backgroundColor]);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    fontFamily: fontFamily,\n    overflow: 'hidden',\n  };\n\n  const titleSpring = spring({ frame: Math.max(0, frame - 9), fps, config: { damping: 28, stiffness: 200, mass: 1 }, overshootClamping: true });\n  const titleOpacity = Math.min(1, titleSpring / 0.4);\n  const titleTranslateY = (1 - titleSpring) * 20;\n\n  // Layout — 10% safe zone on all sides: left/right 192px, top/bottom 108px\n  const SAFE_H = 192;  // horizontal margin\n  const SAFE_V = 108;  // vertical margin\n  const CONTENT_LEFT = SAFE_H;        // 192px from left\n  const CONTENT_RIGHT = DESIGN_WIDTH - SAFE_H;  // 1728px\n  const CONTENT_TOP = SAFE_V;         // 108px from top\n  const CONTENT_BOTTOM = DESIGN_HEIGHT - SAFE_V; // 972px\n  const CONTENT_W = CONTENT_RIGHT - CONTENT_LEFT; // 1536px\n  const PHONE_COL_W = 360;  // wider to accommodate longer names\n  const LABEL_COL_W = 110;\n  // Reference score: the highest possible value maps to BAR_MAX_PX\n  const MAX_SCORE = Math.max(g1Single, g1Multi, g2Single, g2Multi, g3Single, g3Multi);\n\n  // Vertical layout: title + 3 groups evenly distributed within safe zone\n  // Title area ~80px, remaining ~784px split into 3 groups of ~240px each with 32px gaps\n  const TITLE_TOP = CONTENT_TOP + 10;\n  const GROUPS_TOP = CONTENT_TOP + 100;\n  const GROUP_H = Math.floor((CONTENT_BOTTOM - GROUPS_TOP) / 3); // ~257px each\n  const GROUP_Y = [\n    GROUPS_TOP,\n    GROUPS_TOP + GROUP_H,\n    GROUPS_TOP + GROUP_H * 2,\n  ];\n\n  const BAR_HEIGHT = 58;\n  const NUM_FONTSIZE = 36;          // large bold number inside bar\n  const LABEL_FONTSIZE = 21;        // bar label outside bar\n\n  const groups = [\n    {\n      id: 1, phone: g1Phone, chip: g1Chip,\n      single: g1Single, multi: g1Multi,\n      textStart: 24, singleStart: 30, multiStart: 54,\n      y: GROUP_Y[0],\n    },\n    {\n      id: 2, phone: g2Phone, chip: g2Chip,\n      single: g2Single, multi: g2Multi,\n      textStart: 84, singleStart: 90, multiStart: 114,\n      y: GROUP_Y[1],\n    },\n    {\n      id: 3, phone: g3Phone, chip: g3Chip,\n      single: g3Single, multi: g3Multi,\n      textStart: 144, singleStart: 150, multiStart: 174,\n      y: GROUP_Y[2],\n    },\n  ];\n\n  return (\n    <div style={rootStyle}>\n      {/* Divider lines */}\n      {!transparentBackground && (\n        <>\n          <div style={{\n            position: 'absolute', top: GROUP_Y[1] - 4, left: CONTENT_LEFT, width: CONTENT_W,\n            height: 1, backgroundColor: '#cccccc', opacity: titleOpacity,\n          }} />\n          <div style={{\n            position: 'absolute', top: GROUP_Y[2] - 4, left: CONTENT_LEFT, width: CONTENT_W,\n            height: 1, backgroundColor: '#cccccc', opacity: titleOpacity,\n          }} />\n        </>\n      )}\n\n      {/* Title */}\n      <h1 style={{\n        position: 'absolute', top: TITLE_TOP, left: CONTENT_LEFT, width: CONTENT_W,\n        textAlign: 'center', fontSize: 52, fontWeight: 800, color: textColor,\n        margin: 0, opacity: titleOpacity,\n        transform: `translateY(${titleTranslateY}px)`,\n        letterSpacing: '-1px',\n      }}>\n        {titleText}\n      </h1>\n\n      {groups.map((g) => {\n        // Phone name: slide in from left — direct spring math, no interpolate mapping\n        const textSpring = spring({ frame: Math.max(0, frame - g.textStart), fps, config: { damping: 28, stiffness: 200, mass: 1 }, overshootClamping: true });\n        const textOpacity = Math.min(1, textSpring / 0.4);\n        const textX = (1 - textSpring) * -24;\n\n        // Chip subtitle: slide up + fade in\n        // Using interpolate with easing instead of spring to avoid oscillation artifacts\n        const chipFrame = Math.max(0, frame - (g.textStart + 8));\n        const chipRaw = Math.min(1, chipFrame / 12); // 12 frames = 0.4s, linear 0→1\n        const chipEased = 1 - Math.pow(1 - chipRaw, 3); // easeOutCubic — no oscillation possible\n        const chipOpacity = chipEased;\n        const chipBlur = Math.max(0, (1 - chipEased) * 4);\n        const chipY = (1 - chipEased) * 10;\n\n        const singleSpring = spring({ frame: Math.max(0, frame - g.singleStart), fps, config: { damping: 20, stiffness: 90, mass: 1 }, overshootClamping: true });\n        const multiSpring = spring({ frame: Math.max(0, frame - g.multiStart), fps, config: { damping: 20, stiffness: 90, mass: 1 }, overshootClamping: true });\n\n        // Target widths proportional to score, hard-clamped so bars never overflow or get too thin\n        const singleTargetW = Math.min(BAR_MAX_PX, Math.max(BAR_MIN_PX, (g.single / MAX_SCORE) * BAR_MAX_PX));\n        const multiTargetW  = Math.min(BAR_MAX_PX, Math.max(BAR_MIN_PX, (g.multi  / MAX_SCORE) * BAR_MAX_PX));\n\n        const singleWidth = singleSpring * singleTargetW;\n        const multiWidth = multiSpring * multiTargetW;\n\n        // Number roll: easeOut curve — fast start, slow finish\n        // t goes 0→1 linearly, easeOut(t) = 1 - (1-t)^3 accelerates early, decelerates at end\n        const singleNumRaw = interpolate(singleSpring, [0.7, 1], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n        const singleEased = 1 - Math.pow(1 - singleNumRaw, 3);\n        const singleCurrent = Math.round(singleEased * g.single);\n\n        const multiNumRaw = interpolate(multiSpring, [0.7, 1], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n        const multiEased = 1 - Math.pow(1 - multiNumRaw, 3);\n        const multiCurrent = Math.round(multiEased * g.multi);\n\n        const labelOpacity = textOpacity; // labels fade in with the group text\n\n        const renderBar = (label, width, gradStart, gradEnd, numProgress, current) => (\n          <div style={{ display: 'flex', alignItems: 'center', height: BAR_HEIGHT }}>\n            {/* Label OUTSIDE bar, fixed width column */}\n            <div style={{\n              width: LABEL_COL_W,\n              textAlign: 'right',\n              paddingRight: 12,\n              boxSizing: 'border-box',\n              fontSize: LABEL_FONTSIZE,\n              fontWeight: 700,\n              color: gradStart,\n              opacity: labelOpacity,\n              flexShrink: 0,\n            }}>\n              {label}\n            </div>\n\n            {/* Bar with number inside */}\n            <div style={{\n              height: BAR_HEIGHT,\n              width: Math.max(0, width),\n              background: `linear-gradient(90deg, ${gradStart}, ${gradEnd})`,\n              borderRadius: BAR_HEIGHT / 2,\n              position: 'relative',\n              overflow: 'hidden',\n              flexShrink: 0,\n            }}>\n              {/* Number inside bar, left-aligned */}\n              {numProgress > 0 && (\n                <div style={{\n                  position: 'absolute',\n                  left: 20,\n                  top: 0,\n                  height: '100%',\n                  display: 'flex',\n                  alignItems: 'center',\n                }}>\n                  <span style={{\n                    color: '#fff',\n                    fontWeight: 800,\n                    fontSize: NUM_FONTSIZE,\n                    textShadow: '0 1px 4px rgba(0,0,0,0.25)',\n                    letterSpacing: '-0.5px',\n                  }}>\n                    {current.toLocaleString()}\n                  </span>\n                </div>\n              )}\n            </div>\n          </div>\n        );\n\n        return (\n          <div key={g.id} style={{\n            position: 'absolute',\n            top: g.y,\n            left: CONTENT_LEFT,\n            width: CONTENT_W,\n            height: GROUP_H,\n            display: 'flex',\n            alignItems: 'center',\n          }}>\n            {/* Phone name + chip — animated independently */}\n            <div style={{ width: PHONE_COL_W, flexShrink: 0, display: 'flex', flexDirection: 'column', gap: 6 }}>\n              {/* Phone name: slides in from left */}\n              <div style={{\n                opacity: textOpacity,\n                transform: `translateX(${textX}px)`,\n                fontSize: 34, fontWeight: 800, color: textColor, lineHeight: 1, whiteSpace: 'nowrap',\n              }}>{g.phone}</div>\n              {/* Chip subtitle: slides up after phone name, with blur+fade pre-reveal */}\n              <div style={{\n                opacity: chipOpacity,\n                transform: `translateY(${chipY}px) translateZ(0)`,\n                filter: `blur(${chipBlur}px)`,\n                willChange: 'transform, opacity, filter',\n                fontSize: 18, fontWeight: 500, color: subtextColor, whiteSpace: 'nowrap',\n              }}>{g.chip}</div>\n            </div>\n\n            {/* Bar rows */}\n            <div style={{ display: 'flex', flexDirection: 'column', gap: 18 }}>\n              {renderBar('Price', singleWidth, singleColorStart, singleColorEnd, singleNumRaw, singleCurrent)}\n              {renderBar('Ambiance', multiWidth, multiColorStart, multiColorEnd, multiNumRaw, multiCurrent)}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
 },
 {
  "id": "7ef378f4-bbee-4529-8e79-30d5591e3017",
  "name": "Coordinates Weather Dashboard",
  "category": "data-visualization",
  "description": "A tactical weather station dashboard with topographic lines, crosshair grids, and rolling counter animations for temperature and pressure data.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/7ef378f4-bbee-4529-8e79-30d5591e3017.jpg",
  "code": "const WeatherDataBoard = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  // Properties\n  const tempValue = props.tempValue || '-12.5°';\n  const pressureValue = props.pressureValue || '1008.6 hPa';\n  const labelText = props.labelText || 'FIELD SENSOR';\n  const readingText = props.readingText || 'READING: 0083';\n  const accentColor = props.accentColor || '#ffd4f5';\n  const primaryFont = props.primaryFont || 'IBM Plex Mono, monospace';\n  const labelFont = props.labelFont || 'Inter, sans-serif';\n  const logoUrl = props.logoUrl || '';\n  const showGrid = props.showGrid !== false;\n\n  // Canvas Config\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Animation Helpers\n  const safeSpring = (delay) => spring({\n    frame: frame - delay,\n    fps,\n    config: { damping: 15, stiffness: 120, mass: 0.8 }\n  });\n\n  // Staggered Character Reveal Component\n  const RollingText = ({ text, delayOffset = 0, style, fontSize, item }) => {\n    return (\n      <div style={{ display: 'flex', flexDirection: 'row', overflow: 'hidden', ...style }}>\n        {text.split('').map((char, i) => {\n          const delay = delayOffset + (i * 3);\n          const progress = safeSpring(delay);\n          \n          const translateY = interpolate(progress, [0, 1], [100, 0]);\n          const opacity = interpolate(progress, [0, 1], [0, 1]);\n          \n          return (\n            <span \n              key={i} \n              style={{ \n                display: 'inline-block', \n                transform: `translateY(${translateY}%)`, \n                opacity,\n                fontSize,\n                whiteSpace: 'pre',\n                lineHeight: 1\n              }}\n            >\n              {char}\n            </span>\n          );\n        })}\n      </div>\n    );\n  };\n\n  // Entrance for static elements\n  const opacitySpring = spring({ frame, fps, config: { damping: 20 } });\n  const lineProgress = spring({ frame: frame - 10, fps, config: { damping: 200, mass: 5 } }); // Slow draw\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: '#080808',\n    color: 'white',\n    fontFamily: labelFont,\n    overflow: 'hidden',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n  };\n\n  // Topographic Lines (Simulated with SVG)\n  const pathStyle = {\n    fill: 'none',\n    stroke: '#FFFFFF',\n    strokeWidth: 1.5,\n    opacity: 0.08,\n    strokeDasharray: 3000,\n    strokeDashoffset: interpolate(lineProgress, [0, 1], [3000, 0]),\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Texture: Topographic Lines */}\n      <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={{ position: 'absolute', top: 0, left: 0 }}>\n        <path d=\"M-100,400 C400,200 800,600 1200,500 S1800,200 2100,400\" style={pathStyle} />\n        <path d=\"M-100,600 C500,400 900,800 1300,700 S1900,400 2100,600\" style={{...pathStyle, strokeDashoffset: interpolate(lineProgress, [0, 1], [3000, 500])}} />\n        <path d=\"M-100,800 C600,700 1000,950 1400,850 S2000,600 2100,800\" style={{...pathStyle, strokeDashoffset: interpolate(lineProgress, [0, 1], [3000, 1000])}} />\n        <path d=\"M-100,200 C300,100 700,300 1100,200 S1700,50 2100,150\" style={{...pathStyle, strokeDashoffset: interpolate(lineProgress, [0, 1], [3000, 200])}} />\n        <path d=\"M500,0 C600,300 400,600 600,1080\" style={{...pathStyle, opacity: 0.05}} />\n        <path d=\"M1500,0 C1400,300 1600,600 1400,1080\" style={{...pathStyle, opacity: 0.05}} />\n      </svg>\n\n      {/* Crosshair Grid */}\n      {showGrid && (\n        <div style={{ position: 'absolute', inset: 0, opacity: 0.15 }}>\n          <div style={{ position: 'absolute', top: '50%', left: 0, right: 0, height: 1, backgroundColor: 'white' }} />\n          <div style={{ position: 'absolute', left: '33%', top: 0, bottom: 0, width: 1, backgroundColor: 'white' }} />\n          <div style={{ position: 'absolute', left: '66%', top: 0, bottom: 0, width: 1, backgroundColor: 'white' }} />\n          {/* Crosses */}\n          {[33, 66].map(x => (\n             <div key={x} style={{ position: 'absolute', left: `${x}%`, top: '50%', width: 40, height: 40, transform: 'translate(-50%, -50%)' }}>\n               <div style={{ position: 'absolute', top: 19, left: 0, right: 0, height: 2, backgroundColor: 'white' }} />\n               <div style={{ position: 'absolute', left: 19, top: 0, bottom: 0, width: 2, backgroundColor: 'white' }} />\n             </div>\n          ))}\n        </div>\n      )}\n\n      {/* Logo Area */}\n      <div style={{ position: 'absolute', top: 60, right: 80, opacity: opacitySpring }}>\n        {logoUrl ? (\n          <Img src={logoUrl} style={{ height: 60, width: 'auto', objectFit: 'contain' }} />\n        ) : (\n          <div style={{ \n            width: 60, height: 60, border: '2px solid white', borderRadius: '50%', \n            display: 'flex', alignItems: 'center', justifyContent: 'center' \n          }}>\n            <div style={{ width: 10, height: 10, backgroundColor: accentColor, borderRadius: '50%' }} />\n          </div>\n        )}\n      </div>\n\n      {/* Main Data Content */}\n      <div style={{ position: 'absolute', top: '50%', left: 120, transform: 'translateY(-50%)' }}>\n        \n        {/* Label 1 */}\n        <div style={{ \n          fontSize: 24, \n          letterSpacing: '0.15em', \n          fontWeight: 500, \n          marginBottom: 10, \n          opacity: opacitySpring,\n          display: 'flex', alignItems: 'center', gap: 15\n        }}>\n           <div style={{ width: 40, height: 2, backgroundColor: accentColor }} />\n           {labelText}\n        </div>\n\n        {/* Temperature */}\n        <RollingText \n          text={tempValue} \n          fontSize={180} \n          delayOffset={10} \n          style={{ \n            fontFamily: primaryFont, \n            fontWeight: 700, \n            color: accentColor,\n            marginBottom: -20\n          }} \n        />\n\n        {/* Pressure */}\n        <RollingText \n          text={pressureValue} \n          fontSize={120} \n          delayOffset={25} \n          style={{ \n            fontFamily: primaryFont, \n            fontWeight: 400, \n            color: accentColor,\n            opacity: 0.9\n          }} \n        />\n\n        {/* Reading Label */}\n        <div style={{ \n          marginTop: 30, \n          fontSize: 24, \n          fontFamily: primaryFont,\n          opacity: interpolate(spring({frame: frame-40, fps}), [0, 1], [0, 0.7]) \n        }}>\n          {readingText}\n        </div>\n      </div>\n\n      {/* Decorative Corner Stats */}\n      <div style={{ \n        position: 'absolute', bottom: 60, right: 80, \n        textAlign: 'right', opacity: opacitySpring, \n        fontFamily: primaryFont, fontSize: 16, color: '#666'\n      }}>\n        <div>LAT 51.507 N</div>\n        <div>LON 0.128 W</div>\n      </div>\n\n    </div>\n  );\n};"
 },
