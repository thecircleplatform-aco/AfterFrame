  "thumb": "/thumbnails/874f586e-280e-4ea1-b224-a2213ca3c25e.jpg",
  "code": "const VoxDefinitionCard = ({item}) => {\n    const frame = useCurrentFrame();\n\n    const props = item.props || {};\n    const headlineText = props.headlineText;\n    const subtitleLine1 = props.subtitleLine1;\n    const subtitleLine2 = props.subtitleLine2;\n    const highlightColor = props.highlightColor;\n    const backgroundColor = props.backgroundColor;\n    const transparentBackground = props.transparentBackground;\n    const headlineFont = props.headlineFont;\n    const subtitleFont = props.subtitleFont;\n\n    const DESIGN_WIDTH = 1920;\n    const DESIGN_HEIGHT = 1080;\n    const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n    const pFrame = Math.floor(frame / 3) * 3;\n    const easeOutCubic = t => 1 - Math.pow(1 - t, 3);\n    const easeInOut = t => t < 0.5 ? 2*t*t : -1+(4-2*t)*t;\n    const getP = (f, s, e) => f < s ? 0 : f >= e ? 1 : (f-s)/(e-s);\n\n    const arrowProgress = easeInOut(getP(pFrame, 0, 20));\n    const arrowDash = 300 * (1 - arrowProgress);\n    const arrowHeadOpacity = getP(pFrame, 15, 21);\n\n    const safeH = headlineText || '';\n    const nChars = Math.floor(getP(pFrame, 0, 30) * safeH.length);\n    const typed = safeH.slice(0, nChars);\n\n    const l1LineH = 60;\n    const gap = 16;\n    const l1H = easeOutCubic(getP(pFrame, 30, 51)) * (l1LineH + gap);\n    const l2H = easeOutCubic(getP(pFrame, 39, 54)) * l1LineH;\n    const hlW = easeOutCubic(getP(pFrame, 54, 78)) * 100;\n\n    const headlineStyle = {\n        fontSize: 90, fontWeight: 'bold', color: 'white',\n        fontFamily: headlineFont, lineHeight: 1.1, whiteSpace: 'nowrap', margin: 0\n    };\n    const subtitleStyle = {\n        height: l1LineH, lineHeight: l1LineH + 'px', fontSize: 44,\n        fontStyle: 'italic', color: '#aaaaaa', fontFamily: subtitleFont,\n        whiteSpace: 'nowrap', margin: 0\n    };\n\n    return (\n        <div style={{position:'absolute',top:0,left:0,width:DESIGN_WIDTH,height:DESIGN_HEIGHT,transform:'scale('+scale+')',transformOrigin:'top left',backgroundColor:transparentBackground?'transparent':backgroundColor}}>\n\n            {/* Arrow + Headline block — centered independently */}\n            <div style={{position:'absolute',top:'50%',left:'50%',transform:'translate(-50%,-50%)',display:'flex',flexDirection:'column',alignItems:'center'}}>\n                <div style={{position:'relative',width:250,height:110,marginBottom:10}}>\n                    <svg width=\"250\" height=\"110\" style={{position:'absolute',top:0,left:0,overflow:'visible'}}>\n                        <path d=\"M 15 100 Q 30 10, 180 10\" fill=\"none\" stroke=\"#ffffff\" strokeWidth=\"3.5\" strokeDasharray=\"300\" strokeDashoffset={arrowDash} strokeLinecap=\"round\"/>\n                        <polyline points=\"165,-2 182,12 165,24\" fill=\"none\" stroke=\"#ffffff\" strokeWidth=\"3.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" opacity={arrowHeadOpacity}/>\n                    </svg>\n                </div>\n                <div style={{position:'relative'}}>\n                    <div style={{...headlineStyle,opacity:0,userSelect:'none'}}>{safeH}</div>\n                    <div style={{...headlineStyle,position:'absolute',top:0,left:0}}>{typed}</div>\n                </div>\n            </div>\n\n            {/* Subtitle lines — fixed position, completely independent from headline */}\n            <div style={{position:'absolute',top:'65%',left:'50%',transform:'translateX(-50%)',display:'flex',flexDirection:'column',alignItems:'center'}}>\n                <div style={{height:l1H,overflow:'hidden'}}>\n                    <div style={subtitleStyle}>{subtitleLine1}</div>\n                    <div style={{height:gap}}/>\n                </div>\n                <div style={{height:l2H,overflow:'hidden',display:'flex',justifyContent:'center'}}>\n                    <div style={{...subtitleStyle,position:'relative',display:'inline-block',padding:'0 8px'}}>\n                        <div style={{position:'absolute',left:0,top:4,bottom:4,width:hlW+'%',backgroundColor:highlightColor,opacity:0.9,zIndex:0}}/>\n                        <span style={{position:'relative',zIndex:1,color:'#aaaaaa'}}>{subtitleLine2}</span>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    );\n};"
 },
 {
  "id": "58b32a8f-8d9e-4521-85d6-277dfb37fd68",
