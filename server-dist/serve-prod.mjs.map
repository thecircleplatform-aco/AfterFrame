  "code": "const RetroPixelCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n\n  // Properties\n  const titleText = props.titleText || 'SYNCING LESSON...';\n  const headerText = props.headerText || 'BUFFER';\n  const headerColor = props.headerColor || '#ff7c69';\n  const progressColor = props.progressColor || '#a2dcff';\n  const cardColor = props.cardColor || '#FFFFFF';\n  const textColor = props.textColor || '#000000';\n  const accentColor = props.accentColor || '#000000';\n  const targetProgress = props.targetProgress !== undefined ? props.targetProgress : 75;\n  const fontFamily = props.fontFamily || '\"Press Start 2P\", \"Courier New\", monospace';\n\n  // Canvas & Scaling\n  const DESIGN_WIDTH = 680;\n  const DESIGN_HEIGHT = 220;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Animation\n  const entranceDelay = 5;\n  const entranceSpring = spring({\n    frame: Math.max(0, frame - entranceDelay),\n    fps: fps || 30,\n    config: { damping: 12, stiffness: 100, mass: 0.8 }\n  });\n\n  // Progress Animation\n  const progressStart = 25;\n  const progressDuration = 50;\n  const progressValue = interpolate(\n    frame,\n    [progressStart, progressStart + progressDuration],\n    [0, targetProgress],\n    {\n      extrapolateLeft: 'clamp',\n      extrapolateRight: 'clamp',\n      easing: Easing.out(Easing.quad),\n    }\n  );\n\n  // Ticker Animation\n  // Create a repeating string. Assuming ~12px char width, 50 repeats covers >4000px\n  const repeatedHeader = Array(50).fill(headerText).join(' ');\n  const tickerSpeed = 1.5; // pixels per frame\n  const tickerOffset = -(frame * tickerSpeed);\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    fontFamily,\n  };\n\n  const cardWidth = 440;\n  const cardHeight = 160;\n  const borderSize = 3;\n  const shadowOffset = 8;\n\n  const shadowStyle = {\n    position: 'absolute',\n    width: cardWidth,\n    height: cardHeight,\n    backgroundColor: accentColor,\n    top: shadowOffset,\n    left: shadowOffset,\n    opacity: entranceSpring,\n  };\n\n  const cardStyle = {\n    position: 'relative',\n    width: cardWidth,\n    height: cardHeight,\n    backgroundColor: cardColor,\n    border: `${borderSize}px solid ${accentColor}`,\n    display: 'flex',\n    flexDirection: 'column',\n    transform: `scale(${entranceSpring})`,\n    overflow: 'hidden',\n  };\n\n  const headerStyle = {\n    height: 36,\n    backgroundColor: headerColor,\n    borderBottom: `${borderSize}px solid ${accentColor}`,\n    display: 'flex',\n    alignItems: 'center',\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n    position: 'relative',\n  };\n\n  const tickerTextStyle = {\n    fontSize: 12,\n    color: textColor,\n    textTransform: 'uppercase',\n    transform: `translateX(${tickerOffset}px)`,\n    willChange: 'transform',\n    paddingLeft: 10,\n  };\n\n  const bodyStyle = {\n    flex: 1,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    padding: '0 30px',\n  };\n\n  const titleStyle = {\n    fontSize: 20,\n    lineHeight: 1.4,\n    color: textColor,\n    marginBottom: 20,\n    textTransform: 'uppercase',\n    whiteSpace: 'nowrap',\n    overflow: 'hidden',\n    textOverflow: 'ellipsis',\n  };\n\n  const progressTrackStyle = {\n    height: 24,\n    width: '100%',\n    border: `${borderSize}px solid ${accentColor}`,\n    position: 'relative',\n    backgroundColor: '#FFFFFF',\n  };\n\n  const progressFillStyle = {\n    height: '100%',\n    backgroundColor: progressColor,\n    width: `${progressValue}%`,\n    borderRight: progressValue > 0 ? `${borderSize}px solid ${accentColor}` : 'none',\n  };\n\n  // Retro glitch/pattern lines overlay on progress bar\n  const patternStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: '100%',\n    height: '100%',\n    backgroundImage: `linear-gradient(45deg, ${accentColor} 25%, transparent 25%, transparent 50%, ${accentColor} 50%, ${accentColor} 75%, transparent 75%, transparent)`,\n    backgroundSize: '8px 8px',\n    opacity: 0.1,\n    pointerEvents: 'none',\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Shadow Block */}\n      <div style={shadowStyle} />\n      \n      {/* Main Card */}\n      <div style={cardStyle}>\n        {/* Ticker Header */}\n        <div style={headerStyle}>\n          <div style={tickerTextStyle}>\n            {repeatedHeader}\n          </div>\n        </div>\n\n        {/* Card Body */}\n        <div style={bodyStyle}>\n          <div style={titleStyle}>{titleText}</div>\n          \n          {/* Progress Bar */}\n          <div style={progressTrackStyle}>\n            <div style={progressFillStyle} />\n            <div style={patternStyle} />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "9d11fc67-dc78-4d78-b797-f0d76c816858",
  "name": "Savings Plan Sidebar",
  "category": "infographics",
  "description": "A 1920x1080 graphic with an infographic on the left 75% and purely transparent space on the right 25% for a talking head. Elements pop in instantly and sequentially.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
