  "thumb": "/thumbnails/8a36f4ee-a5b8-435e-bfad-bd8e91820c9e.jpg",
  "code": "const EventAnnouncement = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  // Editable properties\n  const props = item.props || {};\n  const line1 = props.line1 || 'PUPPY HOUR';\n  const line2 = props.line2 || 'STARTS';\n  const subtitle = props.subtitle || 'Please keep leashes handy';\n  const primaryColor = props.primaryColor || '#1A1A1A';\n  const accentColor = props.accentColor || '#b2a5ff';\n  const gradientStart = props.gradientStart || '#ffe9e5'; // Light Blue\n  const gradientMid = props.gradientMid || '#f0edff';   // Warm Peach\n  const gradientEnd = props.gradientEnd || '#FFFFFF';   // White\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Background: Breathing Gradient Animation\n  // We oscillate the interpolation factor 't' over time to shift colors\n  const breatheDuration = 180; // frames (approx 6s loop)\n  const t = (1 + Math.sin((frame / breatheDuration) * Math.PI * 2)) / 2;\n\n  const bg1 = interpolateColors(t, [0, 0.5, 1], [gradientStart, gradientMid, gradientStart]);\n  const bg2 = interpolateColors(t, [0, 0.5, 1], [gradientMid, gradientEnd, gradientMid]);\n  const bg3 = interpolateColors(t, [0, 0.5, 1], [gradientEnd, gradientStart, gradientEnd]);\n\n  // Title Entrance: Spring with letter-spacing expansion\n  const springConfig = { damping: 100, stiffness: 200, mass: 3 };\n  const entrance = spring({ frame, fps, config: springConfig });\n  \n  const tracking = interpolate(entrance, [0, 1], [-0.08, -0.02]); // em units: tight to less tight\n  const titleOpacity = interpolate(entrance, [0, 1], [0, 1]);\n  const titleY = interpolate(entrance, [0, 1], [80, 0]);\n\n  // Sparkle Animation: Rotate and Pulse\n  const sparklePulse = 1 + Math.sin(frame / 20) * 0.15;\n  const sparkleRot = frame * 0.4;\n  // Sparkle enters slightly after title start\n  const sparkleEntrance = spring({ frame: Math.max(0, frame - 10), fps, config: { damping: 15 } });\n  const sparkleScale = interpolate(sparkleEntrance, [0, 1], [0, 1]);\n\n  // Subtitle Entrance\n  const subEntrance = spring({ frame: Math.max(0, frame - 25), fps, config: { damping: 20 } });\n  const subOpacity = interpolate(subEntrance, [0, 1], [0, 1]);\n  const subY = interpolate(subEntrance, [0, 1], [30, 0]);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    overflow: 'hidden',\n    fontFamily: 'Inter, sans-serif',\n  };\n\n  const backgroundStyle = {\n    position: 'absolute',\n    top: 0, left: 0, right: 0, bottom: 0,\n    background: `linear-gradient(135deg, ${bg1}, ${bg2}, ${bg3})`,\n    zIndex: 0,\n  };\n\n  const contentContainerStyle = {\n    position: 'relative',\n    zIndex: 1,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n  };\n\n  const titleStyle = {\n    fontSize: '200px',\n    lineHeight: '0.85',\n    fontWeight: 900,\n    color: primaryColor,\n    textTransform: 'uppercase',\n    textAlign: 'center',\n    letterSpacing: `${tracking}em`,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n    margin: 0,\n    textShadow: '0 10px 30px rgba(0,0,0,0.05)',\n  };\n\n  const subtitleStyle = {\n    fontSize: '42px',\n    fontWeight: 500,\n    color: primaryColor,\n    marginTop: '50px',\n    opacity: subOpacity,\n    transform: `translateY(${subY}px)`,\n    letterSpacing: '0.05em',\n  };\n\n  // Decorative Sparkle Positioned relative to title block\n  const starContainerStyle = {\n    position: 'absolute',\n    left: '-150px',\n    top: '-80px',\n    width: '160px',\n    height: '160px',\n    transform: `scale(${sparkleScale})`,\n    opacity: titleOpacity,\n  };\n\n  const starSvgStyle = {\n    width: '100%',\n    height: '100%',\n    transform: `rotate(${sparkleRot}deg) scale(${sparklePulse})`,\n    filter: `drop-shadow(0 0 15px ${accentColor})`,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={backgroundStyle} />\n      \n      <div style={contentContainerStyle}>\n        <div style={starContainerStyle}>\n          <svg viewBox=\"0 0 100 100\" style={starSvgStyle}>\n            <path \n              d=\"M 50 0 C 60 40 60 40 100 50 C 60 60 60 60 50 100 C 40 60 40 60 0 50 C 40 40 40 40 50 0 Z\" \n              fill={accentColor}\n            />\n          </svg>\n        </div>\n\n        <h1 style={titleStyle}>\n          <div>{line1}</div>\n          <div>{line2}</div>\n        </h1>\n        \n        <div style={subtitleStyle}>{subtitle}</div>\n      </div>\n    </div>\n  );\n};"
 },
 {
