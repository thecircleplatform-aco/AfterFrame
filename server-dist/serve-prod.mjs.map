  "thumb": "/thumbnails/6439d0c9-4297-4d3c-9b07-3132668de166.jpg",
  "code": "const WatercolorArtists = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const safeFps = fps || 30;\n  const bgColor = props.transparentBackground ? 'transparent' : (props.bgColor);\n  const titleText = props.titleText;\n  const titleFontFamily = props.titleFontFamily;\n  const textFontFamily = props.textFontFamily;\n\n  const hexToRgba = (hex, alpha) => {\n    if (!hex) return `rgba(0,0,0,${alpha})`;\n    let h = hex.replace('#', '');\n    if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];\n    const r = parseInt(h.substring(0, 2), 16) || 0;\n    const g = parseInt(h.substring(2, 4), 16) || 0;\n    const b = parseInt(h.substring(4, 6), 16) || 0;\n    return `rgba(${r}, ${g}, ${b}, ${alpha})`;\n  };\n\n  const renderSplash = (color, f_delay, index) => {\n    const f = Math.max(0, frame - f_delay);\n    const scale = spring({ frame: f, fps: safeFps, config: { damping: 14, mass: 1.2 } });\n    const rotate = interpolate(f, [0, 150], [index * 45, index * 45 + 15]);\n    const opacity = interpolate(f, [0, 30], [0, 0.8], { extrapolateRight: 'clamp' });\n\n    return (\n      <div style={{ position: 'absolute', width: 440, height: 440, left: -70, top: -70, transform: `scale(${scale}) rotate(${rotate}deg)`, opacity }}>\n        <svg width=\"440\" height=\"440\" viewBox=\"0 0 100 100\">\n          <defs>\n            <filter id={`blur2-${index}`} x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n              <feGaussianBlur stdDeviation=\"12\" />\n            </filter>\n          </defs>\n          <g transform=\"scale(0.95) translate(2.5, 2.5)\">\n            <path d=\"M 48 12 C 75 8, 88 28, 92 48 C 96 75, 72 88, 48 92 C 22 96, 8 72, 12 48 C 8 22, 22 12, 48 12 Z\" fill={hexToRgba(color, 0.5)} filter={`url(#blur2-${index})`} />\n          </g>\n        </svg>\n        <div style={{ position: 'absolute', inset: 0 }}>\n          <svg width=\"440\" height=\"440\" viewBox=\"0 0 100 100\">\n            <defs>\n              <filter id={`blur1-${index}`} x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n                <feGaussianBlur stdDeviation=\"6\" />\n              </filter>\n            </defs>\n            <path d=\"M 50 18 C 72 15, 82 35, 86 50 C 90 72, 70 82, 50 86 C 28 90, 15 70, 18 50 C 15 28, 28 18, 50 18 Z\" fill={hexToRgba(color, 0.7)} filter={`url(#blur1-${index})`} />\n          </svg>\n        </div>\n      </div>\n    );\n  };\n\n  const renderOrganicBorder = (color, f_delay, index) => {\n    const f = Math.max(0, frame - f_delay);\n    const scale = spring({ frame: f, fps: safeFps, config: { damping: 16 } });\n    const opacity = interpolate(f, [0, 30], [0, 0.9], { extrapolateRight: 'clamp' });\n    const rotate = interpolate(f, [0, 150], [-10, 5]);\n\n    return (\n      <div style={{ position: 'absolute', width: 350, height: 350, left: -25, top: -25, transform: `scale(${scale}) rotate(${rotate}deg)`, opacity }}>\n        <svg width=\"350\" height=\"350\" viewBox=\"0 0 100 100\">\n          <defs>\n            <filter id={`blur-border-${index}`} x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n              <feGaussianBlur stdDeviation=\"1.5\" />\n            </filter>\n          </defs>\n          <path d=\"M 50 4 C 76 6, 94 24, 96 50 C 98 76, 76 96, 50 96 C 24 96, 4 76, 4 50 C 4 24, 24 4, 50 4 Z\" fill=\"none\" stroke={hexToRgba(color, 0.8)} strokeWidth=\"2.5\" filter={`url(#blur-border-${index})`} />\n          <path d=\"M 50 8 C 80 12, 92 30, 92 50 C 92 70, 80 88, 50 92 C 20 88, 8 70, 8 50 C 8 30, 20 12, 50 8 Z\" fill=\"none\" stroke={hexToRgba(color, 0.5)} strokeWidth=\"1.5\" filter={`url(#blur-border-${index})`} />\n          <path d=\"M 50 1 C 70 1, 99 20, 99 50 C 99 80, 70 99, 50 99 C 30 99, 1 80, 1 50 C 1 20, 30 1, 50 1 Z\" fill=\"none\" stroke={hexToRgba(color, 0.3)} strokeWidth=\"1\" filter={`url(#blur-border-${index})`} />\n        </svg>\n      </div>\n    );\n  };\n\n  const renderMember = (name, role, color, image, delay, index) => {\n    const f = Math.max(0, frame - delay);\n    const y = interpolate(f, [0, 30], [60, 0], { extrapolateRight: 'clamp' });\n    const opacity = interpolate(f, [0, 20], [0, 1], { extrapolateRight: 'clamp' });\n\n    return (\n      <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', transform: `translateY(${y}px)`, opacity, width: 360 }}>\n        <div style={{ position: 'relative', width: 300, height: 300, marginBottom: 50 }}>\n          {renderSplash(color, delay, index)}\n          <div style={{ position: 'absolute', left: 0, top: 0, width: 300, height: 300, borderRadius: '50%', backgroundColor: 'rgba(255, 255, 255, 0.4)', overflow: 'hidden', display: 'flex', justifyContent: 'center', alignItems: 'center' }}>\n            {image && <Img src={image} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />}\n          </div>\n          {renderOrganicBorder(color, delay + 5, index)}\n        </div>\n        <div style={{ fontFamily: titleFontFamily, fontSize: 36, color: '#2A1E1E', marginBottom: 12, textAlign: 'center', lineHeight: 1.2 }}>\n          {name}\n        </div>\n        <div style={{ fontFamily: textFontFamily, fontSize: 16, color: '#5b645a', letterSpacing: '0.15em', textTransform: 'uppercase', textAlign: 'center' }}>\n          {role}\n        </div>\n      </div>\n    );\n  };\n\n  const titleF = Math.max(0, frame - 5);\n  const titleY = interpolate(titleF, [0, 35], [40, 0], { extrapolateRight: 'clamp' });\n  const titleOpacity = interpolate(titleF, [0, 25], [0, 1], { extrapolateRight: 'clamp' });\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor: bgColor, display: 'flex', flexDirection: 'column', alignItems: 'center', paddingTop: 140 }}>\n      <div style={{ fontFamily: titleFontFamily, fontSize: 64, color: '#1A1212', letterSpacing: '0.04em', transform: `translateY(${titleY}px)`, opacity: titleOpacity, marginBottom: 120 }}>\n        {titleText}\n      </div>\n      <div style={{ display: 'flex', flexDirection: 'row', gap: 140, justifyContent: 'center' }}>\n        {renderMember(props.name1, props.role1, props.color1, props.image1, 24, 1)}\n        {renderMember(props.name2, props.role2, props.color2, props.image2, 54, 2)}\n        {renderMember(props.name3, props.role3, props.color3, props.image3, 84, 3)}\n      </div>\n    </div>\n  );\n};"
 },
