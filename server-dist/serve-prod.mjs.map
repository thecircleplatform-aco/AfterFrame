  "thumb": "/thumbnails/3dde3474-65a5-4e46-b8f4-9717bc3fbf21.jpg",
  "code": "const CoursePromo = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const pinkColor = props.pinkColor;\n  const whiteColor = props.whiteColor;\n  const buttonColor = props.buttonColor;\n  const transparentBackground = props.transparentBackground;\n  const scriptFont = props.scriptFont;\n  const sansFont = props.sansFont;\n\n  // 设计尺寸对齐 item 实际尺寸\n  const DESIGN_WIDTH = 1050;\n  const DESIGN_HEIGHT = 591;\n\n  const hexToRgb = (hex) => {\n    const h = hex.replace('#', '');\n    const r = parseInt(h.substring(0,2), 16);\n    const g = parseInt(h.substring(2,4), 16);\n    const b = parseInt(h.substring(4,6), 16);\n    return {r, g, b};\n  };\n\n  const pink = hexToRgb(pinkColor);\n  const white = hexToRgb(whiteColor);\n  const btn = hexToRgb(buttonColor);\n\n  const freeAlpha = interpolate(frame, [0, 12], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const words = line2Text.split(' ');\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: 'scale(1)',\n    transformOrigin: 'top left',\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: transparentBackground ? 'transparent' : '#000b0a',\n    overflow: 'hidden',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center' }}>\n\n        {/* Line 1 */}\n        <div style={{\n          color: `rgba(${pink.r},${pink.g},${pink.b},${freeAlpha})`,\n          fontSize: 108,\n          fontFamily: scriptFont,\n          fontWeight: 400,\n          marginBottom: -14,\n          lineHeight: 1.05,\n        }}>\n          {line1Text}\n        </div>\n\n        {/* Line 2 */}\n        <div style={{ display: 'flex', flexDirection: 'row', gap: 10, marginBottom: 32 }}>\n          {words.map((word, i) => {\n            const delay = 4 + i * 6;\n            const alpha = interpolate(frame, [delay, delay + 12], [0, 1], {\n              extrapolateLeft: 'clamp',\n              extrapolateRight: 'clamp',\n            });\n            return (\n              <div key={i} style={{\n                color: `rgba(${white.r},${white.g},${white.b},${alpha})`,\n                fontSize: 96,\n                fontWeight: 700,\n                fontFamily: sansFont,\n                lineHeight: 1.0,\n              }}>\n                {word}\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Icons Row */}\n        <div style={{ display: 'flex', flexDirection: 'row', gap: 18 }}>\n          {[...Array(5)].map((_, i) => {\n            const delay = 18 + i * 4;\n            const iconAlpha = interpolate(frame, [delay, delay + 12], [0, 1], {\n              extrapolateLeft: 'clamp',\n              extrapolateRight: 'clamp',\n            });\n            return (\n              <div key={i} style={{\n                position: 'relative',\n                width: 72,\n                height: 72,\n                backgroundColor: `rgba(${btn.r},${btn.g},${btn.b},${iconAlpha})`,\n                borderRadius: 16,\n                display: 'flex',\n                alignItems: 'center',\n                justifyContent: 'center',\n                overflow: 'hidden',\n              }}>\n                <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style={{marginLeft: 4}}>\n                  <path d=\"M5 3l14 9-14 9V3z\" fill={`rgba(${white.r},${white.g},${white.b},${iconAlpha})`}/>\n                </svg>\n                <div style={{\n                  position: 'absolute',\n                  top: 4, right: 4,\n                  width: 20, height: 20,\n                  borderRadius: '50%',\n                  backgroundColor: `rgba(74,194,101,${iconAlpha})`,\n                  color: `rgba(${white.r},${white.g},${white.b},${iconAlpha})`,\n                  fontSize: 11,\n                  fontWeight: 700,\n                  fontFamily: sansFont,\n                  display: 'flex',\n                  alignItems: 'center',\n                  justifyContent: 'center',\n                }}>\n                  {i + 1}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "d490ac7f-2e06-469d-ab59-0584094ac5da",
  "name": "MindSpace — Kinetic Title Reveal",
  "category": "uncategorized",
  "description": "High-impact kinetic text overlay where large, bold text slides and smears in with horizontal motion blur sequentially, then exits aggressively in opposite directions. Designed for punchy talking-head edits.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "line1Text": "NEXT",
   "line2Text": "TRIP",
   "primaryColor": "#eff3ff",
   "fontFamily": "Impact, system-ui, sans-serif"
  },
  "propSchema": [
   {
