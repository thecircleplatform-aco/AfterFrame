    "label": "Shadow Color"
   }
  ],
  "thumb": "/thumbnails/988db173-b9f1-484e-bbed-9e33c238ff4a.jpg",
  "code": "const BezierSlidingText = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const fontSize = props.fontSize;\n  const fontFamily = props.fontFamily;\n  const textColor = props.textColor;\n  const shadowColor = props.shadowColor;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const customEase = Easing.bezier(0.8, 0, 0.2, 1);\n  const slideOffset = 45;\n  const wordDuration = 18;\n  const wordGap = 6; // 0.2s @ 30fps\n\n  const line1Words = (line1Text || '').split(' ');\n  const line2Words = (line2Text || '').split(' ');\n  const line2StartOffset = line1Words.length * wordGap + 8;\n\n  const renderWords = (words, lineStartFrame) => {\n    return words.map((word, i) => {\n      const wordStart = lineStartFrame + i * wordGap;\n      const wordEnd = wordStart + wordDuration;\n      const progress = interpolate(frame, [wordStart, wordEnd], [0, 1], {\n        easing: customEase,\n        extrapolateLeft: 'clamp',\n        extrapolateRight: 'clamp',\n      });\n      const x = interpolate(progress, [0, 1], [slideOffset, 0]);\n      const opacity = interpolate(progress, [0, 0.25], [0, 1], { extrapolateRight: 'clamp' });\n      return (\n        <span key={i} style={{\n          display: 'inline-block',\n          transform: `translateX(${x}px)`,\n          opacity,\n          marginRight: i < words.length - 1 ? `${fontSize * 0.22}px` : 0,\n          willChange: 'transform, opacity',\n        }}>\n          {word}\n        </span>\n      );\n    });\n  };\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    overflow: 'hidden',\n  };\n\n  const lineStyle = {\n    fontFamily,\n    fontSize: `${fontSize}px`,\n    fontWeight: 'bold',\n    color: textColor,\n    textShadow: `4px 4px 12px ${shadowColor}`,\n    margin: 0,\n    lineHeight: 1.25,\n    letterSpacing: '-0.02em',\n    display: 'flex',\n    flexWrap: 'nowrap',\n    alignItems: 'baseline',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={lineStyle}>\n        {renderWords(line1Words, 5)}\n      </div>\n      <div style={{ ...lineStyle, marginTop: `${fontSize * 0.08}px` }}>\n        {renderWords(line2Words, line2StartOffset)}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "4103210c-e3ee-4589-8626-307036bc61a3",
  "name": "Work-Life — Style Showcase HQ",
  "category": "uncategorized",
  "description": "A multi-component warm editorial composition showing typography, charts, and timeline layout with sophisticated serif/sans pairings.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "transparentBackground": false,
   "bgColor": "#545e83",
   "textColor": "#FFFFFF",
   "textSecondaryColor": "rgba(255, 255, 255, 0.7)",
   "accentCopper": "#8582f2",
   "accentAmber": "#c79cff",
   "accentTan": "#a296db",
   "fontSans": "Montserrat",
