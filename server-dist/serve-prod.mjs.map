  "thumb": "/thumbnails/82a91144-3342-4599-8fc0-a0b02f5d3933.jpg",
  "code": "const MarketSegmentChart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  // Properties\n  const props = item.props || {};\n  const titleText = props.titleText || 'USER SEGMENTS';\n  const subtitleText = props.subtitleText || 'MRR Share by Customer Tier';\n  const segmentLabel = props.segmentLabel || 'Enterprise Plans';\n  const segmentDesc = props.segmentDesc || 'Quarter-over-quarter growth in this tier has outpaced forecasts.';\n  const percentage = props.percentage !== undefined ? props.percentage : 57;\n  const bgGradientStart = props.bgGradientStart || '#45455f'; // Warm brown\n  const bgGradientEnd = props.bgGradientEnd || '#545467';   // Blue grey\n  const accentColor = props.accentColor || '#FFFFFF';\n  const titleFont = props.titleFont || 'Inter, sans-serif';\n  const monoFont = '\"IBM Plex Mono\", monospace';\n\n  // Canvas & Scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Animation Config\n  const entranceDuration = 45;\n  const textStagger = 10;\n  \n  // Helper for Entrance Springs\n  const springConfig = { damping: 15, mass: 0.8, stiffness: 100 };\n  const createSpring = (delay) => spring({\n    frame: Math.max(0, frame - delay),\n    fps,\n    config: springConfig\n  });\n\n  // Background Animation\n  const bgOpacity = interpolate(frame, [0, 20], [0, 1], { extrapolateRight: 'clamp' });\n\n  // Chart Math\n  const radius = 160;\n  const strokeWidth = 25;\n  const center = 200;\n  const size = 400;\n  const circumference = 2 * Math.PI * radius;\n  \n  // Chart Animation\n  const progressSpring = createSpring(10);\n  const currentPercentage = Math.round(interpolate(progressSpring, [0, 1], [0, percentage]));\n  const strokeDashoffset = interpolate(\n    progressSpring,\n    [0, 1],\n    [circumference, circumference - (circumference * percentage) / 100]\n  );\n\n  // Text Animations\n  const titleOpacity = interpolate(frame, [10, 30], [0, 1], { extrapolateRight: 'clamp' });\n  const titleY = interpolate(createSpring(10), [0, 1], [30, 0]);\n\n  const subOpacity = interpolate(frame, [20, 40], [0, 1], { extrapolateRight: 'clamp' });\n  const subY = interpolate(createSpring(20), [0, 1], [30, 0]);\n\n  const labelOpacity = interpolate(frame, [30, 50], [0, 1], { extrapolateRight: 'clamp' });\n  const labelX = interpolate(createSpring(30), [0, 1], [-30, 0]);\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    background: `linear-gradient(135deg, ${bgGradientStart}, ${bgGradientEnd})`,\n    opacity: bgOpacity,\n    color: props.textColor || '#ffffff',\n    fontFamily: titleFont,\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    overflow: 'hidden',\n  };\n\n  const contentContainer = {\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    width: '1400px',\n    justifyContent: 'space-between',\n  };\n\n  const chartContainer = {\n    position: 'relative',\n    width: size,\n    height: size,\n    flexShrink: 0,\n  };\n\n  const textContainer = {\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'flex-start',\n    width: '800px',\n    paddingLeft: '60px',\n  };\n\n  const counterStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: '100%',\n    height: '100%',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    fontSize: '96px',\n    fontWeight: '500',\n    fontFamily: monoFont,\n  };\n\n  const h1Style = {\n    fontSize: '56px',\n    fontWeight: '600',\n    letterSpacing: '4px',\n    textTransform: 'uppercase',\n    margin: '0 0 12px 0',\n    lineHeight: '1.1',\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  const h2Style = {\n    fontSize: '24px',\n    fontWeight: '300',\n    letterSpacing: '1px',\n    margin: '0 0 60px 0',\n    opacity: subOpacity,\n    transform: `translateY(${subY}px)`,\n  };\n\n  const labelStyle = {\n    fontSize: '36px',\n    fontWeight: '400',\n    color: accentColor,\n    marginBottom: '16px',\n  };\n\n  const descStyle = {\n    fontSize: '20px',\n    fontWeight: '300',\n    lineHeight: '1.6',\n    opacity: 0.8,\n    maxWidth: '600px',\n  };\n\n  const detailBlockStyle = {\n    borderLeft: `4px solid ${accentColor}`,\n    paddingLeft: '30px',\n    opacity: labelOpacity,\n    transform: `translateX(${labelX}px)`,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={contentContainer}>\n        \n        {/* Left Side: Chart */}\n        <div style={chartContainer}>\n          <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>\n            {/* Track */}\n            <circle\n              cx={center}\n              cy={center}\n              r={radius}\n              fill=\"none\"\n              stroke={props.trackColor || 'rgba(255,255,255,0.1)'}\n              strokeWidth={strokeWidth}\n            />\n            {/* Progress Ring */}\n            <circle\n              cx={center}\n              cy={center}\n              r={radius}\n              fill=\"none\"\n              stroke={accentColor}\n              strokeWidth={strokeWidth}\n              strokeLinecap=\"round\"\n              strokeDasharray={circumference}\n              strokeDashoffset={strokeDashoffset}\n              transform={`rotate(-90 ${center} ${center})`}\n            />\n          </svg>\n          <div style={counterStyle}>\n             {currentPercentage}%\n          </div>\n        </div>\n\n        {/* Right Side: Text */}\n        <div style={textContainer}>\n          <h1 style={h1Style}>{titleText}</h1>\n          <h2 style={h2Style}>{subtitleText}</h2>\n          \n          <div style={detailBlockStyle}>\n            <div style={labelStyle}>{segmentLabel}</div>\n            <div style={descStyle}>{segmentDesc}</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "97d3b441-1916-48bc-a11c-9af4ff6fb0be",
  "name": "Pie Chart - Resource Allocation",
  "category": "data-visualization",
  "description": "A clean, smooth sweeping pie chart with dashed connectors and organic easing.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "MEMBER RIDE FEEDBACK",
   "subtitleText": "Poll Results by Rating Category",
   "bgGradientStart": "#f2f8fe",
   "bgGradientEnd": "#e6f1fb",
   "ringColor": "#2e90e5",
   "trackColor": "rgba(46,144,229,0.15)",
   "lineColor": "rgba(20,53,80,0.4)",
