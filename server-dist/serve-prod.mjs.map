    "code": "const ShortsNameBar = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const nameText = p.nameText || '';\n  const titleText = p.titleText || '';\n  const accent = p.accentColor || '#22d3ee';\n  const bg = p.bgColor || 'rgba(15,23,42,0.88)';\n  const textColor = p.textColor || '#f1f5f9';\n  const enter = spring({ frame, fps, config: { damping: 16, stiffness: 110 } });\n  const exit = interpolate(frame, [durationInFrames - 10, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent' }}>\n      <div style={{\n        position: 'absolute',\n        left: 48,\n        bottom: 360,\n        opacity: enter * exit,\n        transform: `translateX(${(1 - enter) * -80}px)`,\n        display: 'flex',\n        alignItems: 'stretch',\n        maxWidth: 720,\n        borderRadius: 16,\n        overflow: 'hidden',\n        boxShadow: '0 12px 40px #0007',\n      }}>\n        <div style={{ width: 10, background: accent }} />\n        <div style={{ background: bg, padding: '22px 28px' }}>\n          <div style={{ fontSize: 40, fontWeight: 800, color: textColor, letterSpacing: 1 }}>{nameText}</div>\n          <div style={{ marginTop: 8, fontSize: 26, color: textColor, opacity: 0.75 }}>{titleText}</div>\n        </div>\n      </div>\n    </AbsoluteFill>\n  );\n};"
