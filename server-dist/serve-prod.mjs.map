  "thumb": "/thumbnails/200c97a4-3958-4074-ba27-1080eb91a5ce.jpg",
  "code": "const StartupPhaseFinalV5 = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const textLine1 = props.textLine1;\n  const textLine2 = props.textLine2;\n  const numberText = props.numberText;\n  const accentColor = props.accentColor;\n  const bgColor = props.bgColor;\n  const numColor = props.numColor;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const RECT_LEFT = 1106;\n  const RECT_TOP = 238;\n  const RECT_W = 512;\n  const RECT_H = 890;\n\n  const SQ_LEFT = 218;\n  const SQ_TOP = 686;\n\n  const LN_LEFT = 292;\n  const LN_TOP = 692;\n  const LINE_TARGET_W = RECT_LEFT - LN_LEFT + 18;\n\n  const cameraX = interpolate(frame, [0, durationInFrames - 1], [-34, 18], {\n    easing: Easing.bezier(0.45, 0, 0.55, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const textSlideX = interpolate(frame, [6, 26], [-110, 0], {\n    easing: Easing.bezier(0.16, 1, 0.3, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const squareScale = interpolate(frame, [8, 20], [0, 1], {\n    easing: Easing.bezier(0.22, 1, 0.36, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const squareOpacity = interpolate(frame, [8, 11, 20], [0, 0.78, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const squareDash = interpolate(frame, [8, 20], [208, 0], {\n    easing: Easing.bezier(0.25, 1, 0.5, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const lineW = interpolate(frame, [20, 44], [0, LINE_TARGET_W], {\n    easing: Easing.bezier(0.22, 0.9, 0.2, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const lineOpacity = interpolate(frame, [20, 24], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const canvasRef = React.useRef(null);\n\n  React.useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext('2d');\n    canvas.width = 960;\n    canvas.height = 540;\n    const imgData = ctx.createImageData(960, 540);\n    const d = imgData.data;\n    let s = 12345;\n    const r = () => {\n      s = (s * 9301 + 49297) % 233280;\n      return s / 233280;\n    };\n    for (let i = 0; i < d.length; i += 4) {\n      if (r() < 0.28) {\n        const c = Math.floor(35 + r() * 160);\n        d[i] = c;\n        d[i + 1] = c;\n        d[i + 2] = c;\n        d[i + 3] = Math.floor(18 + r() * 70);\n      } else {\n        d[i + 3] = 0;\n      }\n    }\n    ctx.putImageData(imgData, 0, 0);\n  }, []);\n\n  const useCustomOne = String(numberText).trim() === '1';\n\n  const oneCutoutPath = `\n    M 270 128\n    L 426 128\n    L 426 650\n    L 276 650\n    L 276 282\n    L 122 356\n    L 122 210\n    Z\n  `;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    overflow: 'hidden',\n  };\n\n  const cameraStyle = {\n    position: 'absolute',\n    top: 0,\n    bottom: 0,\n    left: -60,\n    right: -60,\n    transform: `translateX(${cameraX}px)`,\n  };\n\n  const rightGlowStyle = {\n    position: 'absolute',\n    inset: 0,\n    background:\n      'radial-gradient(ellipse 80% 80% at 100% 0%, rgba(120,105,105,0.42) 0%, rgba(55,50,50,0.22) 38%, transparent 72%)',\n  };\n\n  const gridStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundImage: `\n      linear-gradient(rgba(255,255,255,0.11) 2px, transparent 2px),\n      linear-gradient(90deg, rgba(255,255,255,0.11) 2px, transparent 2px)\n    `,\n    backgroundSize: '126px 126px',\n    backgroundPosition: '-20px -11px',\n    opacity: 0.78,\n  };\n\n  const vignetteStyle = {\n    position: 'absolute',\n    inset: 0,\n    pointerEvents: 'none',\n    background:\n      'linear-gradient(90deg, rgba(0,0,0,0.68) 0%, transparent 22%, transparent 76%, rgba(255,255,255,0.05) 100%)',\n  };\n\n  const canvasWrapStyle = {\n    position: 'absolute',\n    inset: 0,\n    pointerEvents: 'none',\n    opacity: 0.28,\n  };\n\n  const canvasElemStyle = {\n    width: '100%',\n    height: '100%',\n    imageRendering: 'pixelated',\n  };\n\n  const textWrapStyle = {\n    position: 'absolute',\n    left: 218,\n    top: 246,\n    transform: `translateX(${textSlideX}px)`,\n    fontFamily,\n    fontSize: 158,\n    fontWeight: 850,\n    color: '#ffffff',\n    lineHeight: 0.96,\n    letterSpacing: -6,\n  };\n\n  const sqSvgStyle = {\n    position: 'absolute',\n    left: SQ_LEFT,\n    top: SQ_TOP,\n    width: 96,\n    height: 96,\n    overflow: 'visible',\n    transform: `scale(${squareScale})`,\n    transformOrigin: '48px 48px',\n    opacity: squareOpacity,\n  };\n\n  const lnSvgStyle = {\n    position: 'absolute',\n    left: LN_LEFT,\n    top: LN_TOP,\n    width: 900,\n    height: 96,\n    overflow: 'visible',\n    opacity: lineOpacity,\n  };\n\n  const redBlockStyle = {\n    position: 'absolute',\n    left: RECT_LEFT,\n    top: RECT_TOP,\n    width: RECT_W,\n    height: RECT_H,\n    overflow: 'visible',\n    filter: 'drop-shadow(-22px 0 48px rgba(0,0,0,0.68))',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cameraStyle}>\n        <div style={rightGlowStyle} />\n        <div style={gridStyle} />\n\n        <div style={textWrapStyle}>\n          <div>{textLine1}</div>\n          <div>{textLine2}</div>\n        </div>\n\n        <svg style={sqSvgStyle} viewBox=\"0 0 96 96\">\n          <defs>\n            <filter id=\"sqGlowV5\" x=\"-100%\" y=\"-100%\" width=\"300%\" height=\"300%\">\n              <feGaussianBlur stdDeviation=\"12\" />\n            </filter>\n          </defs>\n          <rect x=\"20\" y=\"20\" width=\"52\" height=\"52\" fill=\"none\" stroke={accentColor} strokeWidth=\"22\" opacity=\"0.48\" filter=\"url(#sqGlowV5)\" strokeDasharray=\"208\" strokeDashoffset={squareDash} />\n          <rect x=\"20\" y=\"20\" width=\"52\" height=\"52\" fill=\"none\" stroke={accentColor} strokeWidth=\"10\" strokeDasharray=\"208\" strokeDashoffset={squareDash} />\n          <rect x=\"20\" y=\"20\" width=\"52\" height=\"52\" fill=\"none\" stroke=\"#ffb1a4\" strokeWidth=\"2.5\" opacity=\"0.92\" strokeDasharray=\"208\" strokeDashoffset={squareDash} />\n        </svg>\n\n        {lineW > 0 && (\n          <svg style={lnSvgStyle} viewBox=\"0 0 900 96\">\n            <defs>\n              <filter id=\"lineGlowV5\" x=\"-20%\" y=\"-200%\" width=\"140%\" height=\"500%\">\n                <feGaussianBlur stdDeviation=\"14\" />\n              </filter>\n            </defs>\n            <line x1=\"0\" y1=\"42\" x2={lineW} y2=\"42\" stroke={accentColor} strokeWidth=\"42\" opacity=\"0.42\" filter=\"url(#lineGlowV5)\" />\n            <line x1=\"0\" y1=\"42\" x2={lineW} y2=\"42\" stroke={accentColor} strokeWidth=\"11\" opacity=\"0.84\" />\n            <line x1=\"0\" y1=\"42\" x2={lineW} y2=\"42\" stroke=\"#ffaa9c\" strokeWidth=\"3\" opacity=\"0.95\" />\n          </svg>\n        )}\n\n        <svg style={redBlockStyle} viewBox={`0 0 ${RECT_W} ${RECT_H}`} preserveAspectRatio=\"none\">\n          <defs>\n            <linearGradient id=\"redBlockGradV5\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0%\" stopColor=\"#ff3932\" />\n              <stop offset=\"42%\" stopColor={accentColor} />\n              <stop offset=\"100%\" stopColor=\"#ab0e00\" />\n            </linearGradient>\n            <mask id=\"oneCutMaskV5\" maskUnits=\"userSpaceOnUse\">\n              <rect x=\"0\" y=\"0\" width={RECT_W} height={RECT_H} fill=\"#ffffff\" />\n              {useCustomOne ? (\n                <path d={oneCutoutPath} fill={numColor} />\n              ) : (\n                <text x=\"64\" y=\"668\" fontFamily=\"'Barlow Condensed', 'Arial Narrow', sans-serif\" fontSize=\"720\" fontWeight=\"900\" fontStyle=\"italic\" fill={numColor}>{numberText}</text>\n              )}\n            </mask>\n            <filter id=\"redNoiseV5\" x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">\n              <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.88\" numOctaves=\"3\" seed=\"7\" />\n              <feColorMatrix type=\"saturate\" values=\"0\" />\n              <feComponentTransfer>\n                <feFuncA type=\"table\" tableValues=\"0 0.12\" />\n              </feComponentTransfer>\n            </filter>\n          </defs>\n          <rect x=\"0\" y=\"0\" width={RECT_W} height={RECT_H} fill=\"url(#redBlockGradV5)\" mask=\"url(#oneCutMaskV5)\" />\n          <rect x=\"0\" y=\"0\" width={RECT_W} height={RECT_H} fill=\"#ffffff\" opacity=\"0.04\" filter=\"url(#redNoiseV5)\" mask=\"url(#oneCutMaskV5)\" />\n        </svg>\n\n        <div style={canvasWrapStyle}>\n          <canvas ref={canvasRef} style={canvasElemStyle} />\n        </div>\n        <div style={vignetteStyle} />\n      </div>\n    </div>\n  );\n};"
 },
 {
