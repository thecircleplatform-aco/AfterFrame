    "code": "const KbSplitNote = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const W = 1080, H = 1920;\n  const ink = '#38301f';\n  const red = '#d9553f';\n  const ratio = Math.min(0.62, Math.max(0.32, Number(p.splitRatio) || 0.5));\n  const splitY = Math.round(H * ratio);\n  const title = p.title == null ? '' : String(p.title);\n  const subtitle = p.subtitle == null ? '' : String(p.subtitle);\n  const handle = p.handle == null ? '' : String(p.handle);\n  const enter = spring({ frame, fps, config: { damping: 13, stiffness: 125 } });\n  const popIn = spring({ frame: frame - 5, fps, config: { damping: 11, stiffness: 150 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const sway = Math.sin((frame / 140) * Math.PI * 2);\n  const mask = 'linear-gradient(180deg, #000 0 ' + splitY + 'px, transparent ' + splitY + 'px)';\n  const teeth = 22;\n  const seg = W / teeth;\n  let zig = '';\n  for (let i = 0; i < teeth; i += 1) {\n    zig += ((i + 0.5) * seg) + 'px 100%, ' + ((i + 1) * seg) + 'px 30%, ';\n  }\n  const clip = 'polygon(0 0, 100% 0, 100% 30%, ' + zig + '0 30%)';\n  return (\n    <AbsoluteFill style={{ opacity: exit }}>\n      <AbsoluteFill style={{ backgroundColor: '#fdf0b8', WebkitMaskImage: mask, maskImage: mask, opacity: enter }}>\n        <div style={{ position: 'absolute', inset: 0, backgroundImage: 'repeating-linear-gradient(180deg, transparent 0 88px, #dcc98a99 88px 90.5px)', backgroundPosition: '0 40px' }} />\n        <div style={{ position: 'absolute', left: 60, top: 0, width: 2.5, height: splitY, background: red + '4d' }} />\n      </AbsoluteFill>\n      <div style={{ position: 'absolute', left: W / 2 - 110, top: -14 + (1 - enter) * -30, width: 220, height: 58, background: '#f7a8b8b3', transform: 'rotate(-2deg)', boxShadow: '0 4px 12px #38301f1c', opacity: enter }} />\n      <div style={{ position: 'absolute', left: 0, right: 0, top: Math.round(splitY * 0.40) + (1 - enter) * 30, opacity: enter, textAlign: 'center', padding: '0 90px', transform: 'translateY(-50%)' }}>\n        <div style={{ display: 'inline-block', fontSize: 96, fontWeight: 800, color: ink, lineHeight: 1.24, letterSpacing: 3, background: 'linear-gradient(0deg, #ffffffa6 0 40%, transparent 40%)', padding: '0 20px 6px', transform: 'rotate(-0.8deg)' }}>{title}</div>\n        {subtitle ? (\n          <div style={{ marginTop: 30, display: 'inline-block', fontSize: 35, fontWeight: 700, color: ink + 'c4', letterSpacing: 3, borderBottom: '3.5px dashed ' + red + 'a6', paddingBottom: 12 }}>{subtitle}</div>\n        ) : null}\n      </div>\n      <svg viewBox=\"0 0 100 100\" style={{ position: 'absolute', width: 84, height: 84, left: 96, top: Math.round(splitY * 0.16) + sway * 5, transform: 'rotate(' + (-12 + sway * 5) + 'deg)', opacity: popIn }}>\n        <path d=\"M50 6 L60 38 L94 38 L66 57 L76 90 L50 70 L24 90 L34 57 L6 38 L40 38 Z\" fill=\"#ffd66e\" stroke={ink} strokeWidth=\"4\" strokeLinejoin=\"round\" />\n      </svg>\n      <div style={{ position: 'absolute', left: 0, top: splitY - 34, width: W, height: 44, background: '#fdf0b8', clipPath: clip, WebkitClipPath: clip, filter: 'drop-shadow(0 6px 0 #38301f1f)' }} />\n      {handle ? (\n        <div style={{ position: 'absolute', left: '50%', top: splitY + 44, transform: 'translateX(-50%) rotate(2deg)', opacity: popIn, background: '#fffdf6', border: '2.5px solid ' + ink, borderRadius: 999, padding: '10px 30px', fontSize: 30, fontWeight: 800, color: ink, whiteSpace: 'nowrap', boxShadow: '4px 5px 0 ' + ink + '2b' }}>{handle}</div>\n      ) : null}\n    </AbsoluteFill>\n  );\n};"
