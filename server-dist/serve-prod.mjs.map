  "propSchema": [],
  "thumb": "/thumbnails/7c576ae9-ee31-4727-ad3b-b71891bc3e21.jpg",
  "code": "const NeighborhoodWelcome = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'Begin.';\n  const subtitleText = props.subtitleText || \"You're ready.\";\n  const textureText = props.textureText || 'WELCOME TO THE CLASSROOM';\n  const bgColor = props.bgColor || '#1A1A1A';\n  const accentColor = props.accentColor || '#e7eedd';\n  const borderColor = props.borderColor || '#FFFFFF';\n\n  // Responsive scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Animation - Background Drift\n  const driftSpeed = 0.5;\n  \n  // Create SVG Data URI for the texture pattern\n  // The text is rendered with low opacity to create a subtle watermark effect\n  const svgContent = `\n    <svg width=\"600\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n      <text \n        x=\"50%\" y=\"50%\" \n        dominant-baseline=\"middle\" \n        text-anchor=\"middle\" \n        font-family=\"Impact, sans-serif\" \n        font-weight=\"bold\" \n        font-size=\"40\" \n        fill=\"${accentColor}\" \n        opacity=\"0.05\" \n        letter-spacing=\"4\"\n      >\n        ${textureText}\n      </text>\n    </svg>\n  `.trim();\n  // Encode to ensure safety in data URI\n  const bgPattern = `data:image/svg+xml;utf8,${encodeURIComponent(svgContent)}`;\n\n  // Slow, cinematic entrance spring\n  const entranceSpring = (delay) => spring({\n    frame: Math.max(0, frame - delay),\n    fps,\n    config: { mass: 3, damping: 200, stiffness: 100 },\n    durationInFrames: 60,\n  });\n\n  const titleAnim = entranceSpring(10);\n  const subAnim = entranceSpring(50);\n  const borderAnim = entranceSpring(0);\n\n  const titleOpacity = interpolate(titleAnim, [0, 1], [0, 1]);\n  const titleScale = interpolate(titleAnim, [0, 1], [0.95, 1]);\n  const titleY = interpolate(titleAnim, [0, 1], [20, 0]);\n\n  const subOpacity = interpolate(subAnim, [0, 1], [0, 1]);\n  const subScale = interpolate(subAnim, [0, 1], [0.95, 1]);\n  const subY = interpolate(subAnim, [0, 1], [20, 0]);\n  \n  const borderScaleX = interpolate(borderAnim, [0, 1], [0, 1]);\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    backgroundColor: bgColor,\n    color: accentColor,\n    fontFamily: '\"Times New Roman\", Times, serif',\n    overflow: 'hidden',\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    display: 'flex', flexDirection: 'column',\n    justifyContent: 'center', alignItems: 'center',\n  };\n\n  const patternStyle = {\n    position: 'absolute',\n    top: -600, left: -600, right: -600, bottom: -600, // Oversize to cover rotation\n    backgroundImage: `url('${bgPattern}')`,\n    backgroundRepeat: 'repeat',\n    // Rotate entire texture layer and drift background position\n    transform: 'rotate(-15deg)',\n    backgroundPosition: `${frame * driftSpeed}px ${frame * driftSpeed * 0.5}px`, \n    opacity: 1,\n    pointerEvents: 'none',\n    zIndex: 1,\n  };\n\n  const textContainerStyle = {\n    zIndex: 10,\n    textAlign: 'center',\n    display: 'flex',\n    flexDirection: 'column',\n    gap: '20px',\n    padding: '0 40px',\n  };\n\n  const h1Style = {\n    fontSize: '150px',\n    margin: 0,\n    fontWeight: 400,\n    letterSpacing: '-2px',\n    lineHeight: 1,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px) scale(${titleScale})`,\n    textShadow: '0 10px 40px rgba(0,0,0,0.6)',\n  };\n\n  const h2Style = {\n    fontSize: '80px',\n    margin: 0,\n    fontWeight: 400,\n    fontStyle: 'italic',\n    whiteSpace: 'pre-wrap',\n    opacity: subOpacity,\n    transform: `translateY(${subY}px) scale(${subScale})`,\n    textShadow: '0 10px 40px rgba(0,0,0,0.5)',\n  };\n\n  const borderLineStyle = {\n    position: 'absolute',\n    left: '100px', right: '100px',\n    height: '2px',\n    backgroundColor: borderColor,\n    opacity: 0.5,\n    transform: `scaleX(${borderScaleX})`,\n    zIndex: 20,\n    boxShadow: '0 0 10px rgba(255,255,255,0.2)',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={patternStyle} />\n      \n      <div style={{...borderLineStyle, top: '120px'}} />\n      <div style={{...borderLineStyle, bottom: '120px'}} />\n\n      <div style={textContainerStyle}>\n        <h1 style={h1Style}>{titleText}</h1>\n        <h2 style={h2Style}>{subtitleText}</h2>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "347681ff-bc76-452c-814b-4e82d4e5d255",
  "name": "Community Stats Title Transition",
  "category": "title-cards",
  "description": "Transparent title transition card with oversized white headline text that pops in and scales away over any background.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/347681ff-bc76-452c-814b-4e82d4e5d255.jpg",
  "code": "const CommunityStatsIntro = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const introTitle = props.introTitle || \"What's New in Your Dashboard\";\n  const titleColor = props.titleColor || '#2D2D2D';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Title entrance: spring scale + fade in\n  const titleSpring = spring({ frame: Math.max(0, frame), fps, config: { damping: 12, stiffness: 120 } });\n  const titleOpacity = interpolate(frame, [0, 15, 60, 75], [0, 1, 1, 0], { extrapolateRight: 'clamp' });\n  const titleScale = interpolate(titleSpring, [0, 1], [0.6, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [60, 0]);\n\n  // Decorations: slide in from edges\n  const decoProgress = spring({ frame: Math.max(0, frame - 5), fps, config: { damping: 20 } });\n  const topLeftX = interpolate(decoProgress, [0, 1], [-200, 0]);\n  const topRightY = interpolate(decoProgress, [0, 1], [-200, 0]);\n  const bottomRightX = interpolate(decoProgress, [0, 1], [200, 0]);\n  const decoOpacity = interpolate(frame, [0, 10, 60, 75], [0, 1, 1, 0], { extrapolateRight: 'clamp' });\n\n  const cBlueBg = props.cBlueBg || '#e6d1e2';\n  const cPurpleBg = props.cPurpleBg || '#7ec3c2';\n  const cMustard = props.cMustard || '#8baf3f';\n  const cOrange = props.cOrange || '#c06a00';\n  const cCharcoal = props.cCharcoal || '#2D2D2D';\n\n  const LeafShape = ({ color }) => (\n    <svg viewBox=\"0 0 100 100\" width=\"100%\" height=\"100%\">\n      <path fill={color} d=\"M50 0 C20 0 0 20 0 50 C0 80 50 100 50 100 C50 100 100 80 100 50 C100 20 80 0 50 0 Z\" />\n    </svg>\n  );\n  const Blob1 = ({ color }) => (\n    <svg viewBox=\"0 0 200 200\" width=\"100%\" height=\"100%\">\n      <path fill={color} d=\"M45.7,-76.3C58.9,-69.3,69.1,-55.5,77.3,-40.8C85.5,-26.1,91.7,-10.5,89.5,4.1C87.3,18.7,76.7,32.3,66.1,44.7C55.5,57.1,44.9,68.3,31.8,74.5C18.7,80.7,3.1,81.9,-11.2,79.5C-25.5,77.1,-38.5,71.1,-50.2,62.8C-61.9,54.5,-72.3,43.9,-78.6,31.2C-84.9,18.5,-87.1,3.7,-84.1,-10.1C-81.1,-23.9,-72.9,-36.7,-62.4,-47.1C-51.9,-57.5,-39.1,-65.5,-26.3,-72.8C-13.5,-80.1,0.7,-86.7,14.6,-83.9C28.5,-81.1,41.5,-68.9,45.7,-76.3Z\" transform=\"translate(100 100)\" />\n    </svg>\n  );\n\n  return (\n    <div style={{\n      position: 'absolute',\n      top: 0, left: 0,\n      width: DESIGN_WIDTH,\n      height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      backgroundColor: cBlueBg,\n      overflow: 'hidden',\n      fontFamily: 'Georgia, \"Times New Roman\", serif',\n    }}>\n      {/* Title */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0,\n        width: '100%', height: '100%',\n        display: 'flex', justifyContent: 'center', alignItems: 'center',\n        zIndex: 10,\n      }}>\n        <h1 style={{\n          fontSize: '80px',\n          fontWeight: 900,\n          textAlign: 'center',\n          maxWidth: '80%',\n          lineHeight: 1.2,\n          color: titleColor,\n          opacity: titleOpacity,\n          transform: `translateY(${titleY}px) scale(${titleScale})`,\n        }}>\n          {introTitle}\n        </h1>\n      </div>\n\n      {/* Top Left decoration */}\n      <div style={{\n        position: 'absolute', top: -50, left: -50,\n        width: 300, height: 300,\n        transform: `translate(${topLeftX}px, 0)`,\n        opacity: decoOpacity, zIndex: 2\n      }}>\n        <div style={{ position: 'absolute', width: '100%', height: '100%', transform: 'rotate(-45deg)' }}><LeafShape color={cOrange} /></div>\n        <div style={{ position: 'absolute', width: '60%', height: '60%', top: '40%', left: '40%' }}><Blob1 color={cPurpleBg} /></div>\n      </div>\n\n      {/* Top Right decoration */}\n      <div style={{\n        position: 'absolute', top: -100, right: -100,\n        width: 350, height: 350,\n        transform: `translate(0, ${topRightY}px)`,\n        opacity: decoOpacity, zIndex: 2\n      }}>\n        <div style={{ width: '100%', height: '100%', border: `8px solid ${cMustard}`, borderRadius: '50%' }} />\n      </div>\n\n      {/* Bottom Right decoration */}\n      <div style={{\n        position: 'absolute', bottom: -50, right: -50,\n        width: 400, height: 400,\n        transform: `translate(${bottomRightX}px, 0)`,\n        opacity: decoOpacity, zIndex: 2\n      }}>\n        <Blob1 color={cMustard} />\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "9d2bedfe-7840-4bfa-80d4-7e27074071bc",
  "name": "Community Welcome Screen",
  "category": "title-cards",
  "description": "Warm, organic intro with grain texture. 'CC' logo morphs into main title, followed by a framed tagline.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "You're In",
   "taglineText": "Glad you found us",
   "headerLabel1": "YOU'RE IN",
   "headerLabel2": "YOU'RE IN",
   "headerLabel3": "YOU'RE IN",
   "primaryColor": "#FFFFFF",
   "bgBlue": "#3e654c",
   "bgAmber": "#34583e",
   "logoUrl": ""
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "You're In",
    "label": "Title"
   },
   {
    "key": "taglineText",
    "type": "text",
    "defaultValue": "Glad you found us",
    "label": "Tagline"
   },
   {
    "key": "headerLabel1",
    "type": "text",
    "defaultValue": "YOU'RE IN",
    "label": "Header label 1"
   },
   {
    "key": "headerLabel2",
    "type": "text",
    "defaultValue": "YOU'RE IN",
    "label": "Header label 2"
   },
   {
    "key": "headerLabel3",
    "type": "text",
    "defaultValue": "YOU'RE IN",
    "label": "Header label 3"
   },
   {
    "key": "primaryColor",
    "type": "color",
    "defaultValue": "#FFFFFF",
    "label": "Text color"
   },
   {
    "key": "bgBlue",
    "type": "color",
    "defaultValue": "#3e654c",
    "label": "Background blue orb"
   },
   {
    "key": "bgAmber",
    "type": "color",
    "defaultValue": "#34583e",
    "label": "Background amber orb"
   },
   {
    "key": "logoUrl",
    "type": "image",
    "defaultValue": "",
    "label": "Logo image"
   }
  ],
  "thumb": "/thumbnails/9d2bedfe-7840-4bfa-80d4-7e27074071bc.jpg",
  "code": "const CommunityWelcome = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  \n  // Props\n  const props = item.props || {};\n  const titleText = props.titleText || 'You’re In';\n  const taglineText = props.taglineText || 'Glad you found us';\n  // Top header bar — 3 small caps labels\n  const headerLabel1 = props.headerLabel1 || 'YOU’RE IN';\n  const headerLabel2 = props.headerLabel2 || 'YOU’RE IN';\n  const headerLabel3 = props.headerLabel3 || 'YOU’RE IN';\n  // Background watermark text strips\n  const bgText1 = props.bgText1 || 'You’re In';\n  const bgText2 = props.bgText2 || 'Glad you found us';\n  const bgText3 = props.bgText3 || 'THE CREW';\n  const primaryColor = props.primaryColor || '#FFFFFF';\n  const logoUrl = props.logoUrl || '';\n  const bgBlue = props.bgBlue || '#3e654c';       // 鲜艳钴蓝 — 左侧主orb\n  const bgAmber = props.bgAmber || '#34583e';     // 暗琥珀棕 — 右下暖orb\n  const bgOrange = props.bgOrange || '#082e1c';   // 极深棕 — 辅助暗角\n  const bgGray = props.bgGray || '#0E0E14';       // 几乎纯黑 — 右侧压暗\n  const bgPurple = props.bgPurple || '#0A0A0F';   // 底色级别 — 几乎不可见\n  const bgTeal = props.bgTeal || '#0A0A0F';       // 底色级别 — 几乎不可见\n\n  // Canvas Specs\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Animation Config\n  const startDelay = 10;\n  const logoDuration = 50;\n  const morphTrigger = 60;\n  \n  // Springs\n  const logoEntrance = spring({\n    frame: frame - startDelay,\n    fps,\n    config: { damping: 12, stiffness: 100 }\n  });\n\n  const morphProgress = spring({\n    frame: frame - morphTrigger,\n    fps,\n    config: { damping: 20, stiffness: 80 }\n  });\n\n  const taglineEntrance = spring({\n    frame: frame - (morphTrigger + 20),\n    fps,\n    config: { damping: 15, stiffness: 100 }\n  });\n\n  // Background Animation (Slow Drift)\n  const bgDrift = Math.sin(frame / 120) * 50;\n  const bgPulse = Math.cos(frame / 150) * 0.2 + 1;\n\n  // Interpolations\n  // Logo — rotates, scales up, fades out with ease-in curve (slow start → accelerate out)\n  const logoRotation = interpolate(morphProgress, [0, 1], [0, 140]);\n  const logoScale = interpolate(morphProgress, [0, 1], [1, 1.8]);\n  const logoOpacity = interpolate(morphProgress, [0, 0.42], [1, 0], {\n    extrapolateRight: 'clamp',\n    easing: Easing.bezier(0.4, 0, 1, 1), // ease-in: holds visible longer, then dissolves fast at end\n  });\n\n  // Title Reveal — starts at 0.2 (after logo is already fading), fully visible by 0.55\n  const titleScale = interpolate(morphProgress, [0, 1], [0.92, 1]);\n  const titleOpacity = interpolate(morphProgress, [0.2, 0.55], [0, 1], { extrapolateRight: 'clamp' });\n  const titleBlur = interpolate(morphProgress, [0.2, 0.7], [8, 0], { extrapolateRight: 'clamp' });\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: '#08080E',\n    overflow: 'hidden',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, sans-serif',\n    color: primaryColor,\n  };\n\n  const noiseFilter = `\n    <svg width=\"0\" height=\"0\">\n      <filter id=\"grainy\">\n        <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"3\" stitchTiles=\"stitch\"/>\n        <feColorMatrix type=\"saturate\" values=\"0\"/>\n      </filter>\n    </svg>\n  `;\n\n  // Components\n  const Orb = ({ color, size, top, left, delay, item }) => {\n    const movement = Math.sin((frame + delay) / 100) * 30;\n    return (\n      <div style={{\n        position: 'absolute',\n        width: size,\n        height: size,\n        borderRadius: '50%',\n        background: color,\n        top,\n        left,\n        filter: 'blur(120px)',\n        opacity: 0.6,\n        transform: `translate(${movement}px, ${movement * 0.5}px) scale(${bgPulse})`,\n      }} />\n    );\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Layer */}\n      <div style={{ position: 'absolute', inset: 0, zIndex: 0 }}>\n        {/* Blue — large, center-left, dominant (matches reference) */}\n        <Orb color={bgBlue} size={1300} top={-200} left={-200} delay={0} />\n        {/* Amber — bottom right warm glow */}\n        <Orb color={bgAmber} size={900} top={450} left={900} delay={300} />\n        {/* Dark brown — bottom center, deep shadow layer */}\n        <Orb color={bgOrange} size={700} top={600} left={400} delay={600} />\n        {/* Near-black — right edge darkness */}\n        <Orb color={bgGray} size={600} top={0} left={1400} delay={900} />\n        {/* Almost invisible — extra depth bottom left */}\n        <Orb color={bgPurple} size={500} top={700} left={100} delay={400} />\n        {/* Almost invisible — top right corner fill */}\n        <Orb color={bgTeal} size={500} top={-100} left={1500} delay={700} />\n        <div style={{\n            position: 'absolute',\n            inset: 0,\n            opacity: 0.07,\n            filter: 'url(#grainy)',\n            zIndex: 1,\n            pointerEvents: 'none'\n        }} />\n      </div>\n      \n      {/* Inject SVG Filter */}\n      <div style={{ position: 'absolute', width: 0, height: 0 }} dangerouslySetInnerHTML={{ __html: noiseFilter }} />\n\n      {/* Decorative Header */}\n      <div style={{\n        position: 'absolute',\n        top: 60,\n        width: '100%',\n        display: 'flex',\n        justifyContent: 'center',\n        gap: 200,\n        zIndex: 2,\n        opacity: interpolate(frame, [0, 30], [0, 0.5]),\n        transform: `translateY(${interpolate(frame, [0, 30], [-50, 0], { extrapolateRight: 'clamp' })}px)`\n      }}>\n        {[headerLabel1, headerLabel2, headerLabel3].map((label, i) => (\n          <span key={i} style={{\n            fontSize: 16,\n            letterSpacing: '0.4em',\n            fontWeight: 600,\n            textTransform: 'uppercase',\n            opacity: 0.7\n          }}>\n            {label}\n          </span>\n        ))}\n      </div>\n\n      {/* ── BACKGROUND TEXT STRIPS: 3 different words, 3 fonts, left-right-left, 10% opacity ── */}\n      <div style={{ position: 'absolute', inset: 0, zIndex: 5, pointerEvents: 'none', overflow: 'hidden' }}>\n\n        {/* Row 1 — title word — left bleed — Playfair Display italic serif */}\n        <div style={{\n          position: 'absolute',\n          top: '10%',\n          left: '-6%',\n          fontSize: 320,\n          fontWeight: 900,\n          fontFamily: '\"Playfair Display\", \"Georgia\", serif',\n          fontStyle: 'italic',\n          color: 'rgba(255,255,255,0.02)',\n          whiteSpace: 'nowrap',\n          lineHeight: 1,\n          letterSpacing: '-0.02em',\n          opacity: interpolate(frame, [20, 55], [0, 1], { extrapolateRight: 'clamp' }),\n        }}>\n          {bgText1}\n        </div>\n\n        {/* Row 2 — tagline phrase — right bleed — Oswald condensed sans */}\n        <div style={{\n          position: 'absolute',\n          top: '37%',\n          right: '-5%',\n          fontSize: 280,\n          fontWeight: 700,\n          fontFamily: '\"Oswald\", \"Arial Narrow\", sans-serif',\n          textTransform: 'uppercase',\n          color: 'rgba(255,255,255,0.02)',\n          whiteSpace: 'nowrap',\n          lineHeight: 1,\n          letterSpacing: '0.03em',\n          opacity: interpolate(frame, [28, 60], [0, 1], { extrapolateRight: 'clamp' }),\n        }}>\n          {bgText2}\n        </div>\n\n        {/* Row 3 — header/banner word — left bleed — Abril Fatface fat display serif */}\n        <div style={{\n          position: 'absolute',\n          top: '63%',\n          left: '-3%',\n          fontSize: 310,\n          fontWeight: 400,\n          fontFamily: '\"Abril Fatface\", \"Georgia\", cursive',\n          color: 'rgba(255,255,255,0.02)',\n          whiteSpace: 'nowrap',\n          lineHeight: 1,\n          letterSpacing: '0.02em',\n          opacity: interpolate(frame, [36, 65], [0, 1], { extrapolateRight: 'clamp' }),\n        }}>\n          {bgText3}\n        </div>\n\n      </div>\n\n      {/* Center Content */}\n      <div style={{\n        position: 'absolute',\n        inset: 0,\n        display: 'flex',\n        flexDirection: 'column',\n        alignItems: 'center',\n        justifyContent: 'center',\n        zIndex: 10,\n      }}>\n        \n        <div style={{ position: 'relative', height: 340, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>\n            {/* Logo element — custom image if logoUrl set, else CC arcs */}\n            <div style={{\n                position: 'absolute',\n                opacity: logoOpacity,\n                transform: `scale(${logoScale}) rotate(${logoRotation}deg)`,\n                display: 'flex',\n                alignItems: 'center',\n                justifyContent: 'center',\n                gap: 10,\n            }}>\n                {logoUrl ? (\n                  /* Custom logo image */\n                  <Img\n                    src={logoUrl}\n                    style={{\n                      width: 220,\n                      height: 220,\n                      objectFit: 'contain',\n                      filter: 'brightness(0) invert(1)',\n                    }}\n                  />\n                ) : (\n                  /* Default CC arcs */\n                  <>\n                    <svg width=\"170\" height=\"170\" viewBox=\"0 0 100 100\" style={{ transform: 'rotate(-25deg)' }}>\n                      <circle\n                        cx=\"50\" cy=\"50\" r=\"40\"\n                        fill=\"none\"\n                        stroke={primaryColor}\n                        strokeWidth=\"12\"\n                        strokeDasharray=\"251\"\n                        strokeDashoffset={interpolate(logoEntrance, [0, 1], [251, 60])}\n                        strokeLinecap=\"round\"\n                      />\n                    </svg>\n                    <svg width=\"170\" height=\"170\" viewBox=\"0 0 100 100\" style={{ transform: 'rotate(205deg)' }}>\n                      <circle\n                        cx=\"50\" cy=\"50\" r=\"40\"\n                        fill=\"none\"\n                        stroke={primaryColor}\n                        strokeWidth=\"12\"\n                        strokeDasharray=\"251\"\n                        strokeDashoffset={interpolate(logoEntrance, [0, 1], [251, 60])}\n                        strokeLinecap=\"round\"\n                      />\n                    </svg>\n                  </>\n                )}\n            </div>\n\n            {/* The Main Title */}\n            <h1 style={{\n                fontSize: 280,\n                fontWeight: 900,\n                margin: 0,\n                letterSpacing: '-0.035em',\n                opacity: titleOpacity,\n                transform: `scale(${titleScale})`,\n                filter: `blur(${titleBlur}px)`,\n                textShadow: '0 10px 50px rgba(0,0,0,0.3)',\n                position: 'absolute',\n                whiteSpace: 'nowrap',\n            }}>\n                {titleText}\n            </h1>\n        </div>\n\n        {/* The Tagline Frame */}\n        <div style={{\n            marginTop: 50,\n            position: 'relative',\n            height: 110,\n            display: 'flex',\n            alignItems: 'center',\n            justifyContent: 'center'\n        }}>\n            {/* Expanding Background */}\n            <div style={{\n                position: 'absolute',\n                height: '100%',\n                borderRadius: 55,\n                border: `2px solid ${primaryColor}`,\n                backgroundColor: 'rgba(255,255,255,0.08)',\n                width: interpolate(taglineEntrance, [0, 1], [0, 680]),\n                opacity: interpolate(taglineEntrance, [0, 0.5], [0, 1]),\n            }} />\n\n            {/* Text */}\n            <span style={{\n                fontSize: 46,\n                fontWeight: 500,\n                letterSpacing: '0.04em',\n                zIndex: 2,\n                whiteSpace: 'nowrap',\n                opacity: interpolate(taglineEntrance, [0.5, 1], [0, 1]),\n                transform: `translateY(${interpolate(taglineEntrance, [0.5, 1], [14, 0])}px)`\n            }}>\n                {taglineText}\n            </span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "47caa17c-0e24-4447-b549-766163e8efe0",
  "name": "Countdown Timer Title Card",
  "category": "title-cards",
  "description": "A pop-up pixel art style countdown card with a scrolling magenta ticker, stacked shadow, and LCD numbers.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "startNumber": 10,
   "endNumber": 1,
   "tickerText": "LAUNCHING IN",
   "subText": "UNTIL LIVE",
   "accentColor": "#86b000",
   "bgColor": "#FFFFFF",
   "textColor": "#000000",
   "headerTextColor": "#FFFFFF"
  },
  "propSchema": [
   {
    "key": "startNumber",
    "type": "number",
    "defaultValue": 10,
    "label": "Start Number",
    "min": 1,
    "step": 1
   },
   {
    "key": "endNumber",
    "type": "number",
    "defaultValue": 1,
    "label": "End Number",
    "min": 0,
    "step": 1
   },
   {
    "key": "tickerText",
    "type": "text",
    "defaultValue": "LAUNCHING IN",
    "label": "Ticker Text"
   },
   {
    "key": "subText",
    "type": "text",
    "defaultValue": "UNTIL LIVE",
    "label": "Subtitle Text"
   },
   {
    "key": "accentColor",
    "type": "color",
    "defaultValue": "#86b000",
    "label": "Ticker Color"
   },
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#FFFFFF",
    "label": "Card Background"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#000000",
    "label": "Text Color"
   },
   {
    "key": "headerTextColor",
    "type": "color",
    "defaultValue": "#FFFFFF",
    "label": "Ticker Text Color"
   }
  ],
  "thumb": "/thumbnails/47caa17c-0e24-4447-b549-766163e8efe0.jpg",
  "code": "const Component = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const safeFps = fps || 30;\n\n  const props = item.props || {};\n  const startNumber = parseInt(props.startNumber || '10', 10);\n  const endNumber = parseInt(props.endNumber || '1', 10);\n  const tickerText = props.tickerText || 'LAUNCHING IN';\n  const subText = props.subText || 'UNTIL LIVE';\n  \n  const accentColor = props.accentColor || '#86b000';\n  const bgColor = props.bgColor || '#FFFFFF';\n  const textColor = props.textColor || '#000000';\n  const headerTextColor = props.headerTextColor || '#FFFFFF';\n  \n  const numberFont = props.numberFont || '\"VT323\", monospace';\n  const textFont = props.textFont || '\"Silkscreen\", cursive';\n\n  const DESIGN_WIDTH = 480;\n  const DESIGN_HEIGHT = 220;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  // Animations\n  const bounceScale = safeSpring(0, { damping: 12, stiffness: 120 });\n  \n  // Countdown logic: starts 1 second (safeFps frames) after bounce begins\n  const countdownStartFrame = safeFps;\n  const elapsedFrames = Math.max(0, frame - countdownStartFrame);\n  const secondsPassed = Math.floor(elapsedFrames / safeFps);\n  const currentNumber = startNumber - secondsPassed;\n  const displayNum = Math.max(endNumber, Math.min(startNumber, currentNumber));\n\n  // Ticker logic\n  const tickerX = -(frame * 1.5);\n  const repeatedTickerText = React.useMemo(() => {\n    return new Array(100).fill(tickerText).join(' • ');\n  }, [tickerText]);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center'\n  };\n\n  const cardStyle = {\n    width: 260,\n    height: 150,\n    backgroundColor: bgColor,\n    border: '2px solid #000',\n    boxShadow: '4px 4px 0px #000, 8px 8px 0px rgba(0,0,0,0.2)',\n    display: 'flex',\n    flexDirection: 'column',\n    transform: `scale(${bounceScale})`,\n    boxSizing: 'border-box'\n  };\n\n  const headerStyle = {\n    height: 24,\n    backgroundColor: accentColor,\n    borderBottom: '2px solid #000',\n    display: 'flex',\n    alignItems: 'center',\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n    boxSizing: 'border-box',\n    position: 'relative'\n  };\n\n  const tickerStyle = {\n    fontFamily: textFont,\n    fontSize: 10,\n    color: headerTextColor,\n    transform: `translateX(${tickerX}px)`,\n    letterSpacing: 1,\n    paddingLeft: 10\n  };\n\n  const bodyStyle = {\n    flex: 1,\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    position: 'relative',\n    overflow: 'hidden'\n  };\n\n  const numberStyle = {\n    fontFamily: numberFont,\n    fontSize: 80,\n    lineHeight: 1,\n    color: textColor,\n    margin: 0,\n    marginTop: 10,\n    textShadow: '2px 2px 0px rgba(0,0,0,0.1)'\n  };\n\n  const subTextStyle = {\n    fontFamily: textFont,\n    fontSize: 11,\n    color: textColor,\n    marginTop: 4,\n    letterSpacing: 1,\n    textTransform: 'uppercase'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <div style={headerStyle}>\n          <div style={tickerStyle}>\n            {repeatedTickerText}\n          </div>\n        </div>\n        <div style={bodyStyle}>\n          <div style={numberStyle}>{displayNum}</div>\n          <div style={subTextStyle}>{subText}</div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "c8675840-2115-4060-be44-0d6be2fc8827",
  "name": "Dial Chapter Card",
  "category": "title-cards",
  "description": "A refined chapter card featuring a rotating dial animation on the left and elegant serif typography on the right. Perfect for segment transitions or product highlights.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "mainTitle": "Spend smarter, not just faster",
   "subtitle": "Groceries · Transit · Coffee · Rent · Travel",
   "emoji": "🍎",
   "prevEmoji": "🍌",
   "prevTitle": "Groceries",
   "nextEmoji": "🍓",
   "nextTitle": "Coffee",
   "themeColor": "#a65246",
   "bgColor": "#F5F0E8",
   "trackColor": "#cc9161"
  },
  "propSchema": [
   {
    "key": "mainTitle",
    "type": "text",
    "defaultValue": "Spend smarter, not just faster",
    "label": "Main title"
   },
   {
    "key": "subtitle",
    "type": "text",
    "defaultValue": "Groceries · Transit · Coffee · Rent · Travel",
    "label": "Subtitle"
   },
   {
    "key": "emoji",
    "type": "text",
    "defaultValue": "🍎",
    "label": "Center emoji"
   },
   {
    "key": "prevEmoji",
    "type": "text",
    "defaultValue": "🍌",
    "label": "Previous emoji"
   },
   {
    "key": "prevTitle",
    "type": "text",
    "defaultValue": "Groceries",
    "label": "Previous label"
   },
   {
    "key": "nextEmoji",
    "type": "text",
    "defaultValue": "🍓",
    "label": "Next emoji"
   },
   {
    "key": "nextTitle",
    "type": "text",
    "defaultValue": "Coffee",
    "label": "Next label"
   },
   {
    "key": "themeColor",
    "type": "color",
    "defaultValue": "#a65246",
    "label": "Theme color"
   },
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#F5F0E8",
    "label": "Background color"
   },
   {
    "key": "trackColor",
    "type": "color",
    "defaultValue": "#cc9161",
    "label": "Track color"
   }
  ],
  "thumb": "/thumbnails/c8675840-2115-4060-be44-0d6be2fc8827.jpg",
  "code": "const DialChapterCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const props = item.props || {};\n  const mainTitle = props.mainTitle || 'Spend smarter, not just faster';\n  const subtitle = props.subtitle || 'Groceries · Transit · Coffee · Rent · Travel';\n  const emoji = props.emoji || '🍎';\n  const themeColor = props.themeColor || '#a65246';\n  const bgColor = props.bgColor || '#F5F0E8';\n  const trackColor = props.trackColor || '#cc9161';\n  const prevEmoji = props.prevEmoji || '🍌';\n  const prevTitle = props.prevTitle || 'Groceries';\n  const nextEmoji = props.nextEmoji || '🍓';\n  const nextTitle = props.nextTitle || 'Coffee';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // ── Easing helpers ──────────────────────────────────────────────\n  const easeOutExpo  = (t) => t === 1 ? 1 : 1 - Math.pow(2, -10 * t);\n  const easeOutQuart = (t) => 1 - Math.pow(1 - t, 4);\n  const easeInOutCubic = (t) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;\n  const easeInCubic  = (t) => t * t * t;\n\n  // Clamps frame into a 0→1 progress over [startF, endF]\n  const progress = (startF, endF, ease = (t) => t) => {\n    const t = Math.min(1, Math.max(0, (frame - startF) / (endF - startF)));\n    return ease(t);\n  };\n\n  // ── Timeline (all in frames) ────────────────────────────────────\n  const F = fps;\n  // Card entrance: slides up from bottom over 18 frames\n  const entranceEnd   = Math.round(F * 0.6);\n  // Banana label: fades in from frame 0, done by frame 14\n  const prevTextEnd   = Math.round(F * 0.47);\n  // Dial roll: starts at frame 18, settles by frame 60 (2s)\n  const rollStart     = Math.round(F * 0.6);\n  const rollEnd       = Math.round(F * 2.2);\n  // Apple text: starts right as roll is settling\n  const appleTextStart = Math.round(F * 1.7);\n  const appleTextEnd   = Math.round(F * 2.4);\n  // Strawberry text: follows apple closely\n  const nextTextStart  = Math.round(F * 2.0);\n  const nextTextEnd    = Math.round(F * 2.6);\n  // Exit\n  const exitStart     = Math.round(F * 6.5);\n  const exitEnd       = Math.round(F * 8.0);\n\n  // ── Animation values ────────────────────────────────────────────\n  const entranceP   = progress(0, entranceEnd, easeOutExpo);\n  const rollP       = progress(rollStart, rollEnd, easeInOutCubic);\n  const exitP       = progress(exitStart, exitEnd, easeInCubic);\n\n  // Card slide-up entrance + exit — start fully off-screen below\n  const globalY = interpolate(entranceP, [0, 1], [DESIGN_HEIGHT, 0])\n                - exitP * DESIGN_HEIGHT;\n\n  // Dial offset: starts at NODE_SPACING (nodes offset down), rolls to 0\n  const NODE_SPACING = 430;\n  const rollOffset = interpolate(rollP, [0, 1], [NODE_SPACING, 0]);\n\n  // Apple (center) text\n  const appleP = progress(appleTextStart, appleTextEnd, easeOutQuart);\n  const textOpacity = appleP;\n  const textSlideY  = interpolate(appleP, [0, 1], [40, 0]);\n\n  // Banana (prev) text: fades in early with card entrance\n  const prevFadeP   = progress(0, prevTextEnd, easeOutQuart);\n  // After roll completes, banana dims and shrinks\n  const prevDimP    = rollP; // 0→1 as roll progresses\n  const prevTextOpacity = prevFadeP * interpolate(prevDimP, [0, 1], [1, 1.0]);\n  const prevTextSlideX  = interpolate(prevFadeP, [0, 1], [-28, 0]);\n  const prevTextScale   = interpolate(prevDimP, [0, 1], [1, 0.70]);\n\n  // Strawberry (next) text — easeOutQuart, clean 0→1\n  const nextP = progress(nextTextStart, nextTextEnd, easeOutQuart);\n  const nextTextOpacity = nextP;\n  const nextTextSlideX  = interpolate(nextP, [0, 1], [-28, 0]);\n\n  // ── Arc geometry ────────────────────────────────────────────────\n  const arcRadius  = 900;\n  const arcCenterX = 310 - arcRadius;\n  const arcCenterY = DESIGN_HEIGHT / 2;\n  const nodeScreenX = 310;\n  const nodeSize   = 180;\n  const r          = nodeSize / 2;\n\n  const yToTheta = (screenY) => Math.atan2(screenY - arcCenterY, nodeScreenX - arcCenterX);\n\n  const centerNodeY = DESIGN_HEIGHT / 2;\n  const prevNodeY   = centerNodeY - NODE_SPACING;\n  const nextNodeY   = centerNodeY + NODE_SPACING;\n\n  const getNodePos = (baseY) => {\n    const screenY = baseY + rollOffset;\n    const theta = yToTheta(screenY);\n    return {\n      x: arcCenterX + arcRadius * Math.cos(theta),\n      y: arcCenterY + arcRadius * Math.sin(theta),\n      screenY,\n    };\n  };\n\n  const prev   = getNodePos(prevNodeY);\n  const center = getNodePos(centerNodeY);\n  const next   = getNodePos(nextNodeY);\n\n  // Arc path\n  const tTop   = yToTheta(-NODE_SPACING);\n  const tBot   = yToTheta(DESIGN_HEIGHT + NODE_SPACING);\n  const arcPath = [\n    'M', arcCenterX + arcRadius * Math.cos(tTop), arcCenterY + arcRadius * Math.sin(tTop),\n    'A', arcRadius, arcRadius, 0, 0, 1,\n    arcCenterX + arcRadius * Math.cos(tBot), arcCenterY + arcRadius * Math.sin(tBot),\n  ].join(' ');\n\n  // Node fade near screen edges\n  const edgeOpacity = (sy) => {\n    if (sy < -r || sy > DESIGN_HEIGHT + r) return 0;\n    return interpolate(sy, [-r, 80, DESIGN_HEIGHT - 80, DESIGN_HEIGHT + r], [0, 1, 1, 0], {\n      extrapolateLeft: 'clamp', extrapolateRight: 'clamp',\n    });\n  };\n\n  const labelGap = 160; // gap from circle edge to text — matches apple text offset\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      overflow: 'hidden',\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n    }}>\n      <div style={{\n        position: 'absolute', width: '100%', height: '100%',\n        transform: `translateY(${globalY}px)`,\n        backgroundColor: bgColor,\n        backgroundImage: `radial-gradient(${trackColor}35 1.5px, transparent 1.5px)`,\n        backgroundSize: '32px 32px',\n      }}>\n\n        <svg\n          width={DESIGN_WIDTH}\n          height={DESIGN_HEIGHT}\n          viewBox={`0 0 ${DESIGN_WIDTH} ${DESIGN_HEIGHT}`}\n          style={{ position: 'absolute', top: 0, left: 0, overflow: 'hidden' }}\n        >\n          <defs>\n            <clipPath id=\"cc\">\n              <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} />\n            </clipPath>\n            <filter id=\"ns\" x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\">\n              <feDropShadow dx=\"0\" dy=\"8\" stdDeviation=\"14\" floodColor=\"#00000030\" />\n            </filter>\n          </defs>\n\n          {/* ARC LINE */}\n          <path\n            d={arcPath}\n            fill=\"none\"\n            stroke={trackColor}\n            strokeWidth=\"3\"\n            opacity=\"0.7\"\n            clipPath=\"url(#cc)\"\n          />\n\n          {/* PREV NODE — banana */}\n          <circle cx={prev.x} cy={prev.y} r={r} fill={bgColor} opacity={edgeOpacity(prev.screenY)} />\n          <circle cx={prev.x} cy={prev.y} r={r} fill={themeColor} opacity={edgeOpacity(prev.screenY) * 0.4} />\n          <foreignObject x={prev.x - r} y={prev.y - r} width={nodeSize} height={nodeSize} opacity={edgeOpacity(prev.screenY)}>\n            <div style={{ width: nodeSize, height: nodeSize, display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '84px', lineHeight: 1 }}>{prevEmoji}</div>\n          </foreignObject>\n\n          {/* NEXT NODE — strawberry */}\n          <circle cx={next.x} cy={next.y} r={r} fill={bgColor} opacity={edgeOpacity(next.screenY)} />\n          <circle cx={next.x} cy={next.y} r={r} fill={themeColor} opacity={edgeOpacity(next.screenY) * 0.4} />\n          <foreignObject x={next.x - r} y={next.y - r} width={nodeSize} height={nodeSize} opacity={edgeOpacity(next.screenY)}>\n            <div style={{ width: nodeSize, height: nodeSize, display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '84px', lineHeight: 1 }}>{nextEmoji}</div>\n          </foreignObject>\n\n          {/* CENTER NODE — apple, on top */}\n          <circle cx={center.x} cy={center.y} r={r} fill={themeColor} filter=\"url(#ns)\" />\n          <foreignObject x={center.x - r} y={center.y - r} width={nodeSize} height={nodeSize}>\n            <div style={{\n              width: nodeSize, height: nodeSize,\n              display: 'flex', alignItems: 'center', justifyContent: 'center',\n              fontSize: '84px', lineHeight: 1,\n            }}>\n              {emoji}\n            </div>\n          </foreignObject>\n        </svg>\n\n        {/* PREV (BANANA) LABEL — anchored to actual node x/y on the arc */}\n        <div style={{\n          position: 'absolute',\n          left: prev.x + r + labelGap,\n          top: prev.y,\n          transform: `translateX(${prevTextSlideX}px) scale(${prevTextScale}) translateY(-50%)`,\n          transformOrigin: 'left center',\n          opacity: prevTextOpacity * edgeOpacity(prev.screenY),\n          pointerEvents: 'none',\n        }}>\n          <span style={{\n            fontFamily: 'Georgia, serif',\n            fontSize: '52px',\n            fontWeight: 'bold',\n            color: themeColor,\n            opacity: 0.6,\n            letterSpacing: '-1px',\n            lineHeight: 1,\n            whiteSpace: 'nowrap',\n            display: 'block',\n          }}>{prevTitle}</span>\n        </div>\n\n        {/* NEXT (STRAWBERRY) LABEL — anchored to actual node x/y on the arc */}\n        <div style={{\n          position: 'absolute',\n          left: next.x + r + labelGap,\n          top: next.y,\n          transform: `translateX(${nextTextSlideX}px) translateY(-50%)`,\n          transformOrigin: 'left center',\n          opacity: nextTextOpacity * edgeOpacity(next.screenY),\n          pointerEvents: 'none',\n        }}>\n          <span style={{\n            fontFamily: 'Georgia, serif',\n            fontSize: '36px',\n            fontWeight: 'bold',\n            color: themeColor,\n            opacity: 0.6,\n            letterSpacing: '-1px',\n            lineHeight: 1,\n            whiteSpace: 'nowrap',\n            display: 'block',\n          }}>{nextTitle}</span>\n        </div>\n\n        {/* CENTER (APPLE) TEXT */}\n        <div style={{\n          position: 'absolute',\n          left: 560, top: 0,\n          width: DESIGN_WIDTH - 560 - 80,\n          height: '100%',\n          display: 'flex', flexDirection: 'column', justifyContent: 'center',\n          opacity: textOpacity,\n          transform: `translateY(${textSlideY}px)`,\n        }}>\n          <h1 style={{\n            fontFamily: 'Georgia, serif',\n            fontSize: '108px', fontWeight: 'bold',\n            color: themeColor, lineHeight: 1.1,\n            margin: 0, marginBottom: '32px', letterSpacing: '-2px',\n          }}>\n            {mainTitle}\n          </h1>\n          <p style={{\n            fontFamily: 'Arial, sans-serif',\n            fontSize: '34px', fontWeight: 600,\n            color: themeColor, opacity: 0.75,\n            textTransform: 'uppercase', letterSpacing: '3px',\n            margin: 0,\n          }}>\n            {subtitle}\n          </p>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
 },
