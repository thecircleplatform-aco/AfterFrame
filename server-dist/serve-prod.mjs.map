    "label": "Value Suffix"
   }
  ],
  "thumb": "/thumbnails/d03ead86-a81b-4638-98d3-2fae21c1715b.jpg",
  "code": "const ChartComponent = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n\n  // Editable properties\n  const titleText = props.titleText || 'Monthly Learner Signups';\n  const bgColor = props.bgColor || '#212038';\n  const barColorStart = props.barColorStart || '#bd53aa';\n  const barColorEnd = props.barColorEnd || '#a191e6';\n  const xLabelsStr = props.xLabels || 'Jan, Feb, Mar, Apr, May, Jun';\n  const dataValuesStr = props.dataValues || '1.2, 1.8, 2.4, 3.1, 4.2, 5.8';\n  const yMax = parseFloat(props.yMax || '7');\n  const yAxisSteps = parseInt(props.yAxisSteps || '7', 10);\n  const valueSuffix = props.valueSuffix || 'K';\n  const fontFamily = props.fontFamily || '\"Noto Sans SC\", sans-serif';\n\n  // Responsive scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Data parsing\n  const labels = xLabelsStr.split(',').map((s) => s.trim());\n  const values = dataValuesStr.split(',').map((s) => {\n    const val = parseFloat(s.trim());\n    return isNaN(val) ? 0 : val;\n  });\n\n  // Layout configuration\n  const chartWidth = 1400;\n  const chartHeight = 600;\n  const chartLeft = 280;\n  const chartTop = 320;\n\n  // Safe spring helper\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = {damping: 15}) => {\n    return spring({frame: Math.max(0, frame - delay), fps: safeFps, config});\n  };\n\n  // Global Animations\n  const titleSpring = safeSpring(5, {damping: 16});\n  const titleOp = titleSpring;\n  const titleY = interpolate(titleSpring, [0, 1], [40, 0]);\n\n  const gridFade = safeSpring(15, {damping: 20});\n\n  // Grid lines generation\n  const stepsCount = yAxisSteps > 0 ? yAxisSteps : 7;\n  const gridLines = Array.from({length: stepsCount + 1}).map((_, i) => {\n    const percent = i / stepsCount;\n    const yVal = yMax * percent;\n    const isBase = i === 0;\n    return {percent, yVal, isBase, key: `grid-${i}`};\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    fontFamily: fontFamily,\n    overflow: 'hidden',\n    display: 'flex',\n    flexDirection: 'column',\n  };\n\n  const titleStyle = {\n    position: 'absolute',\n    left: chartLeft - 60,\n    top: 120,\n    fontSize: 64,\n    fontWeight: 800,\n    color: '#FFFFFF',\n    letterSpacing: '2px',\n    opacity: titleOp,\n    transform: `translateY(${titleY}px)`,\n  };\n\n  const chartContainerStyle = {\n    position: 'absolute',\n    left: chartLeft,\n    top: chartTop,\n    width: chartWidth,\n    height: chartHeight,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={titleStyle}>{titleText}</div>\n\n      <div style={chartContainerStyle}>\n        {/* Grid and Y-Axis */}\n        {gridLines.map((line) => (\n          <div\n            key={line.key}\n            style={{\n              position: 'absolute',\n              bottom: `${line.percent * 100}%`,\n              width: '100%',\n              height: 1,\n              backgroundColor: line.isBase\n                ? 'rgba(255, 255, 255, 0.4)'\n                : 'rgba(255, 255, 255, 0.08)',\n              opacity: gridFade,\n            }}\n          >\n            <div\n              style={{\n                position: 'absolute',\n                left: -120,\n                top: -16,\n                width: 100,\n                textAlign: 'right',\n                color: 'rgba(255, 255, 255, 0.6)',\n                fontSize: 22,\n                fontWeight: 500,\n              }}\n            >\n              {line.yVal % 1 === 0 ? line.yVal : line.yVal.toFixed(1)}\n              {valueSuffix}\n            </div>\n          </div>\n        ))}\n\n        {/* Bars and X-Axis */}\n        <div\n          style={{\n            display: 'flex',\n            justifyContent: 'space-around',\n            alignItems: 'flex-end',\n            width: '100%',\n            height: '100%',\n            position: 'absolute',\n            top: 0,\n            left: 0,\n            padding: '0 40px',\n            boxSizing: 'border-box',\n          }}\n        >\n          {values.map((v, i) => {\n            const delay = 20 + i * 8;\n            const barSpring = safeSpring(delay, {damping: 14, mass: 0.8});\n            const animatedHeight = barSpring * (v / Math.max(yMax, 0.1)) * chartHeight;\n            \n            const textOp = interpolate(barSpring, [0.6, 1], [0, 1], {\n              extrapolateRight: 'clamp',\n              extrapolateLeft: 'clamp',\n            });\n            const textY = interpolate(barSpring, [0.6, 1], [15, 0], {\n              extrapolateRight: 'clamp',\n              extrapolateLeft: 'clamp',\n            });\n\n            return (\n              <div\n                key={`bar-${i}`}\n                style={{\n                  display: 'flex',\n                  flexDirection: 'column',\n                  alignItems: 'center',\n                  justifyContent: 'flex-end',\n                  height: '100%',\n                  position: 'relative',\n                  width: 120,\n                }}\n              >\n                {/* Value Label Above Bar */}\n                <div\n                  style={{\n                    opacity: textOp,\n                    transform: `translateY(${textY}px)`,\n                    marginBottom: 16,\n                    fontSize: 34,\n                    fontWeight: 'bold',\n                    color: '#FFFFFF',\n                  }}\n                >\n                  {v}\n                  <span style={{fontSize: 20, opacity: 0.8, marginLeft: 2}}>{valueSuffix}</span>\n                </div>\n\n                {/* Bar */}\n                <div\n                  style={{\n                    width: 80,\n                    height: Math.max(animatedHeight, 0),\n                    background: `linear-gradient(to top, ${barColorStart}, ${barColorEnd})`,\n                    borderTopLeftRadius: 20,\n                    borderTopRightRadius: 20,\n                    boxShadow: '0 10px 30px -10px rgba(161,145,230, 0.3)',\n                  }}\n                />\n\n                {/* X-Axis Label */}\n                <div\n                  style={{\n                    position: 'absolute',\n                    bottom: -60,\n                    textAlign: 'center',\n                    width: '100%',\n                    fontSize: 26,\n                    fontWeight: 600,\n                    color: 'rgba(255, 255, 255, 0.8)',\n                    opacity: gridFade,\n                  }}\n                >\n                  {labels[i] || ''}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "c63df7ef-fc63-491b-ae4b-30a34d88d8ae",
  "name": "Bar Chart - Quarterly Revenue Comparison",
  "category": "data-visualization",
  "description": "A crisp and vibrant grouped bar chart showing quarterly performance of two products with count-up data labels, animated growth bars, and large summary KPIs.",
