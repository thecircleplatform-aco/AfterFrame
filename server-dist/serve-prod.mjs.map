  "durationInFrames": 90,
  "props": {
   "textContent": "PET CARE 2024",
   "boxColor": "#131a27",
   "textColor": "#edf4ff",
   "skewAngle": 15,
   "fontFamily": "Oswald, Impact, sans-serif",
   "transparentBackground": true
  },
  "propSchema": [
   {
    "key": "textContent",
    "type": "text",
    "defaultValue": "PET CARE 2024",
