[
 {
  "id": "ca391141-ac35-4672-a2ab-90980ddae765",
  "name": "Bar Chart - Annual Sales",
  "category": "data-visualization",
  "description": "Infographic vertical bar chart with staggered growth animation, gradient background, and editable data points.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgStart": "#fdf8f1",
   "bgEnd": "#f3e9db",
   "accentColor": "#4a2f18",
   "barColor": "#e78a2b"
  },
  "propSchema": [],
  "thumb": "/thumbnails/ca391141-ac35-4672-a2ab-90980ddae765.jpg",
  "code": "const AnnualSalesChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const title = props.title || 'ROASTERY GROWTH';\n  const subtitle = props.subtitle || 'Revenue Overview 2020-2025 (in 10M)';\n  const bgStart = props.bgStart || '#061025';\n  const bgEnd = props.bgEnd || '#28354c';\n  const accentColor = props.accentColor || '#f6dfc6';\n  const barColor = props.barColor || '#d29400';\n\n  const dataPoints = [\n    { label: props.label1 || '2019', value: Number(props.val1) || 42 },\n    { label: props.label2 || '2020', value: Number(props.val2) || 58 },\n    { label: props.label3 || '2021', value: Number(props.val3) || 71 },\n    { label: props.label4 || '2022', value: Number(props.val4) || 65 },\n    { label: props.label5 || '2023', value: Number(props.val5) || 89 },\n    { label: props.label6 || '2024', value: Number(props.val6) || 103 },\n  ];\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const CHART_W = 1300;\n  const CHART_H = 560;\n  const CHART_LEFT = (DESIGN_WIDTH - CHART_W) / 2;\n  const CHART_TOP = 320;\n  const BAR_W = 120;\n  const gap = (CHART_W - dataPoints.length * BAR_W) / (dataPoints.length - 1);\n  const maxVal = 120;\n  const gridVals = [0, 30, 60, 90, 120];\n\n  const titleSpring = spring({ frame, fps: safeFps, config: { damping: 22, stiffness: 90 } });\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [-40, 0]);\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      background: `linear-gradient(135deg, ${bgStart} 0%, ${bgEnd} 100%)`,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      overflow: 'hidden', fontFamily: \"'Inter', sans-serif\", color: accentColor,\n    }}>\n      <div style={{\n        position: 'absolute', top: 0, left: 0, right: 0, height: 3,\n        background: `linear-gradient(90deg, transparent, ${barColor}, transparent)`,\n        opacity: titleOpacity,\n      }} />\n\n      <div style={{\n        position: 'absolute', top: 80, width: '100%', textAlign: 'center',\n        opacity: titleOpacity, transform: `translateY(${titleY}px)`,\n      }}>\n        <div style={{ fontSize: 76, fontWeight: 900, letterSpacing: '0.08em', textTransform: 'uppercase',\n          textShadow: `0 0 40px ${barColor}99` }}>{title}</div>\n        <div style={{ fontSize: 28, fontWeight: 300, marginTop: 14, opacity: 0.7, letterSpacing: '0.12em' }}>{subtitle}</div>\n      </div>\n\n      <div style={{ position: 'absolute', top: CHART_TOP, left: CHART_LEFT, width: CHART_W, height: CHART_H }}>\n        {gridVals.map((val, i) => {\n          const y = CHART_H - (val / maxVal) * CHART_H;\n          const op = interpolate(frame, [10 + i * 4, 30 + i * 4], [0, 1], { extrapolateRight: 'clamp' });\n          return (\n            <div key={val} style={{ position: 'absolute', top: y, left: -60, right: 0 }}>\n              <div style={{ height: 1, background: `rgba(210,148,0,${val === 0 ? 0.4 : 0.15})`, opacity: op }} />\n              <span style={{ position: 'absolute', left: -10, top: -12, fontSize: 18,\n                fontFamily: \"'IBM Plex Mono', monospace\", opacity: op * 0.6, textAlign: 'right' }}>{val}</span>\n            </div>\n          );\n        })}\n\n        {dataPoints.map((pt, i) => {\n          const delay = 20 + i * 6;\n          const prog = spring({ frame: Math.max(0, frame - delay), fps: safeFps,\n            config: { mass: 1, damping: 16, stiffness: 85 } });\n          const barH = (pt.value / maxVal) * CHART_H;\n          const xPos = i * (BAR_W + gap);\n          const labelOp = interpolate(frame - delay - 8, [0, 12], [0, 1], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' });\n\n          return (\n            <div key={i} style={{ position: 'absolute', left: xPos, bottom: 0, width: BAR_W, height: CHART_H }}>\n              <div style={{\n                position: 'absolute', bottom: 0, width: '100%', height: '100%',\n                background: 'rgba(210,148,0,0.06)', borderRadius: '6px 6px 0 0',\n              }} />\n              <div style={{\n                position: 'absolute', bottom: 0, width: '100%', height: barH,\n                background: `linear-gradient(to top, ${barColor}, ${barColor}cc)`,\n                transform: `scaleY(${prog})`, transformOrigin: 'bottom',\n                borderRadius: '6px 6px 0 0',\n                boxShadow: `0 0 20px ${barColor}66`,\n              }} />\n              <div style={{\n                position: 'absolute', bottom: barH * prog + 14, width: '100%',\n                textAlign: 'center', fontSize: 26, fontWeight: 700,\n                opacity: labelOp, fontFamily: \"'IBM Plex Mono', monospace\",\n                color: barColor, textShadow: `0 0 12px ${barColor}`,\n              }}>{pt.value}</div>\n              <div style={{\n                position: 'absolute', bottom: -48, width: '100%', textAlign: 'center',\n                fontSize: 22, fontWeight: 600, opacity: labelOp * 0.85,\n                letterSpacing: '0.05em',\n              }}>{pt.label}</div>\n            </div>\n          );\n        })}\n      </div>\n\n      <div style={{\n        position: 'absolute', bottom: 0, left: 0, right: 0, height: 2,\n        background: `linear-gradient(90deg, transparent, ${barColor}88, transparent)`,\n        opacity: titleOpacity,\n      }} />\n    </div>\n  );\n};\n"
 },
 {
