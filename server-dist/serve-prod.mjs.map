    "label": "Title Text Color"
   }
  ],
  "thumb": "/thumbnails/0371e3ac-0449-4e8d-a5df-c758ccdbba44.jpg",
  "code": "const MultiLineChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  // Props with defaults\n  const props = item.props || {};\n  const titleText = props.titleText || 'Workspace Growth';\n  const kpi1Label = props.kpi1Label || 'Live Sessions';\n  const kpi1Value = props.kpi1Value || 12;\n  const kpi2Label = props.kpi2Label || 'Trial Starts';\n  const kpi2Value = props.kpi2Value || 9;\n  const xAxisLabelsStr = props.xAxisLabels || 'Sunday, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday';\n  const line1DataStr = props.line1Data || '20, 35, 28, 45, 38, 55, 62';\n  const line2DataStr = props.line2Data || '30, 28, 42, 35, 50, 45, 58';\n  \n  const line1Color = props.line1Color || '#24bbff';\n  const line2Color = props.line2Color || '#009c9c';\n  const bgColor = props.bgColor || '#E8E6F0';\n  const cardColor = props.cardColor || '#FFFFFF';\n  const titleColor = props.titleColor || '#2D2D35';\n  const gridColor = props.gridColor || '#EAE7F2';\n\n  // Parsing data safely\n  const labels = xAxisLabelsStr.split(',').map(s => s.trim());\n  const line1Data = line1DataStr.split(',').map(s => parseFloat(s.trim()) || 0);\n  const line2Data = line2DataStr.split(',').map(s => parseFloat(s.trim()) || 0);\n  const numPoints = Math.max(labels.length, line1Data.length, line2Data.length);\n\n  // Responsive scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Root style with transform\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    fontFamily: 'Inter, sans-serif',\n    overflow: 'hidden'\n  };\n\n  // Chart Dimensions\n  const chartWidth = 1160;\n  const chartHeight = 400;\n  const xStep = numPoints > 1 ? chartWidth / (numPoints - 1) : chartWidth;\n\n  // Pre-calculate paths and lengths for lines\n  const { d1, len1 } = React.useMemo(() => {\n    let d = '';\n    let len = 0;\n    for (let i = 0; i < line1Data.length; i++) {\n      const x = i * xStep;\n      const y = chartHeight - Math.min(100, Math.max(0, line1Data[i])) / 100 * chartHeight;\n      if (i === 0) d += `M ${x},${y}`;\n      else d += ` L ${x},${y}`;\n\n      if (i > 0) {\n        const prevX = (i - 1) * xStep;\n        const prevY = chartHeight - Math.min(100, Math.max(0, line1Data[i - 1])) / 100 * chartHeight;\n        len += Math.sqrt(Math.pow(x - prevX, 2) + Math.pow(y - prevY, 2));\n      }\n    }\n    return { d1: d, len1: len };\n  }, [line1Data, xStep]);\n\n  const { d2, len2 } = React.useMemo(() => {\n    let d = '';\n    let len = 0;\n    for (let i = 0; i < line2Data.length; i++) {\n      const x = i * xStep;\n      const y = chartHeight - Math.min(100, Math.max(0, line2Data[i])) / 100 * chartHeight;\n      if (i === 0) d += `M ${x},${y}`;\n      else d += ` L ${x},${y}`;\n\n      if (i > 0) {\n        const prevX = (i - 1) * xStep;\n        const prevY = chartHeight - Math.min(100, Math.max(0, line2Data[i - 1])) / 100 * chartHeight;\n        len += Math.sqrt(Math.pow(x - prevX, 2) + Math.pow(y - prevY, 2));\n      }\n    }\n    return { d2: d, len2: len };\n  }, [line2Data, xStep]);\n\n  // Animations\n  const cardY = interpolate(frame, [0, 20], [80, 0], { extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic) });\n  const cardOpacity = interpolate(frame, [0, 20], [0, 1], { extrapolateRight: 'clamp' });\n  const contentOpacity = interpolate(frame, [10, 30], [0, 1], { extrapolateRight: 'clamp' });\n\n  const animatedKpi1 = Math.floor(interpolate(frame, [20, 70], [0, kpi1Value], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' }));\n  const animatedKpi2 = Math.floor(interpolate(frame, [25, 75], [0, kpi2Value], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' }));\n\n  // Line animations drawing from left\n  const lineProgress = Easing.inOut(Easing.ease)(interpolate(frame, [30, 100], [0, 1], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' }));\n  const line1Offset = len1 * (1 - lineProgress);\n  const line2Offset = len2 * (1 - lineProgress);\n\n  return (\n    <div style={rootStyle}>\n      {/* Main White Card */}\n      <div style={{\n        position: 'absolute',\n        width: 1400,\n        height: 800,\n        left: 260,\n        top: 140,\n        backgroundColor: cardColor,\n        borderRadius: 40,\n        boxShadow: `0 30px 60px rgba(0,0,0,0.06)`,\n        transform: `translateY(${cardY}px)`,\n        opacity: cardOpacity,\n        overflow: 'hidden'\n      }}>\n        {/* Watermark Logo/Silhouette */}\n        <svg style={{ position: 'absolute', right: -50, bottom: -50, width: 600, height: 600, opacity: 0.03, fill: titleColor }} viewBox=\"0 0 24 24\">\n          <path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\" />\n        </svg>\n\n        <div style={{ opacity: contentOpacity }}>\n          {/* Header Area */}\n          <div style={{ position: 'absolute', left: 80, top: 60, right: 80, display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>\n            <h1 style={{ margin: 0, fontSize: 56, fontWeight: 800, color: titleColor, letterSpacing: '-0.5px' }}>{titleText}</h1>\n            <div style={{ display: 'flex', gap: 70 }}>\n              <div style={{ textAlign: 'right' }}>\n                <div style={{ fontSize: 22, fontWeight: 600, color: '#888', marginBottom: 6 }}>{kpi1Label}</div>\n                <div style={{ fontSize: 60, fontWeight: 800, color: line1Color, lineHeight: 1 }}>{animatedKpi1}%</div>\n              </div>\n              <div style={{ textAlign: 'right' }}>\n                <div style={{ fontSize: 22, fontWeight: 600, color: '#888', marginBottom: 6 }}>{kpi2Label}</div>\n                <div style={{ fontSize: 60, fontWeight: 800, color: line2Color, lineHeight: 1 }}>{animatedKpi2}%</div>\n              </div>\n            </div>\n          </div>\n\n          {/* Chart Grid & Y Axis */}\n          <div style={{ position: 'absolute', left: 80, top: 240, width: 1240, height: 460 }}>\n            {[100, 75, 50, 25, 0].map((val, i) => {\n              const isZero = val === 0;\n              return (\n                <div key={`y-${val}`} style={{ position: 'absolute', top: i * (chartHeight / 4), left: 0, width: '100%', display: 'flex', alignItems: 'center' }}>\n                  <div style={{ width: 60, textAlign: 'right', fontSize: 18, color: '#888', paddingRight: 20, fontWeight: 600 }}>{val}%</div>\n                  <div style={{ flex: 1, height: isZero ? 2 : 1.5, backgroundColor: gridColor, opacity: isZero ? 1 : 0.7 }} />\n                </div>\n              );\n            })}\n\n            {/* X Axis Labels */}\n            {labels.map((day, i) => {\n              const xOpacity = interpolate(frame, [20 + i * 5, 40 + i * 5], [0, 1], { extrapolateRight: 'clamp' });\n              return (\n                <div key={`x-${i}`} style={{ \n                  position: 'absolute', \n                  top: chartHeight + 20, \n                  left: 80 + i * xStep - 75, \n                  width: 150, \n                  textAlign: 'center', \n                  fontSize: 18, \n                  color: '#888', \n                  fontWeight: 600, \n                  opacity: xOpacity \n                }}>\n                  {day}\n                </div>\n              );\n            })}\n\n            {/* SVG Lines and Dots */}\n            <svg style={{ position: 'absolute', left: 80, top: 0, width: chartWidth, height: chartHeight, overflow: 'visible' }}>\n              {/* Line 2 (Purple) */}\n              <path \n                d={d2} \n                fill=\"none\" \n                stroke={line2Color} \n                strokeWidth={6} \n                strokeDasharray={len2} \n                strokeDashoffset={Math.max(0, line2Offset)} \n                strokeLinecap=\"round\" \n                strokeLinejoin=\"round\" \n              />\n              {line2Data.map((val, i) => {\n                const dotDelay = 30 + (i / Math.max(1, line2Data.length - 1)) * 70;\n                const dotScale = spring({ frame: frame - dotDelay, fps, config: { damping: 14 } });\n                const cy = chartHeight - Math.min(100, Math.max(0, val)) / 100 * chartHeight;\n                return (\n                  <circle \n                    key={`dot2-${i}`} \n                    cx={i * xStep} \n                    cy={cy} \n                    r={8} \n                    fill={cardColor} \n                    stroke={line2Color} \n                    strokeWidth={5} \n                    style={{ \n                      transform: `scale(${dotScale})`, \n                      transformOrigin: `${i * xStep}px ${cy}px` \n                    }} \n                  />\n                );\n              })}\n\n              {/* Line 1 (Orange) */}\n              <path \n                d={d1} \n                fill=\"none\" \n                stroke={line1Color} \n                strokeWidth={6} \n                strokeDasharray={len1} \n                strokeDashoffset={Math.max(0, line1Offset)} \n                strokeLinecap=\"round\" \n                strokeLinejoin=\"round\" \n              />\n              {line1Data.map((val, i) => {\n                const dotDelay = 30 + (i / Math.max(1, line1Data.length - 1)) * 70;\n                const dotScale = spring({ frame: frame - dotDelay, fps, config: { damping: 14 } });\n                const cy = chartHeight - Math.min(100, Math.max(0, val)) / 100 * chartHeight;\n                return (\n                  <circle \n                    key={`dot1-${i}`} \n                    cx={i * xStep} \n                    cy={cy} \n                    r={8} \n                    fill={cardColor} \n                    stroke={line1Color} \n                    strokeWidth={5} \n                    style={{ \n                      transform: `scale(${dotScale})`, \n                      transformOrigin: `${i * xStep}px ${cy}px` \n                    }} \n                  />\n                );\n              })}\n            </svg>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "26c175c6-f05d-4370-913a-c63b15b05314",
  "name": "Line Chart - Website Traffic",
  "category": "data-visualization",
  "description": "Animated dual-axis line chart with progressive drawing lines and popping data points in a clean infographic style.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgStart": "#f2fafc",
   "bgEnd": "#e5f4f8",
   "color1": "#0797d3",
   "color2": "#0bb7a9",
   "color3": "#7a6cf0",
   "textColor": "#0e3742",
   "gridColor": "rgba(14,55,66,0.13)"
  },
  "propSchema": [],
  "thumb": "/thumbnails/26c175c6-f05d-4370-913a-c63b15b05314.jpg",
  "code": "const WebsiteTrafficChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const title = props.title || 'CLUB RIDE STATS';\n  const subtitle = props.subtitle || '10-Week Rider Growth';\n  const bgStart = props.bgStart || '#061025';\n  const bgEnd = props.bgEnd || '#28354c';\n  const color1 = props.color1 || '#00a6dc';\n  const color2 = props.color2 || '#00cfcf';\n  const color3 = props.color3 || '#cac0ff';\n  const label1 = props.label1 || 'Rides (K)';\n  const label2 = props.label2 || 'New Riders (K)';\n  const label3 = props.label3 || 'Join Rate (%)';\n\n  const visits =   [2.1, 2.8, 3.5, 4.2, 3.8, 4.9, 5.6, 6.3];\n  const newUsers = [0.8, 1.1, 1.4, 1.9, 1.7, 2.3, 2.8, 3.1];\n  const convRate = [12,  15,  18,  16,  19,  22,  24,  21];\n  const weeks = ['W1','W2','W3','W4','W5','W6','W7','W8'];\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const ML = 220, MR = 180, MT = 320, MB = 200;\n  const CW = DESIGN_WIDTH - ML - MR;\n  const CH = DESIGN_HEIGHT - MT - MB;\n  const maxLeft = 7;\n  const maxRight = 25;\n\n  const getX = (i) => (i / (visits.length - 1)) * CW;\n  const getYL = (v) => CH - (v / maxLeft) * CH;\n  const getYR = (v) => CH - (v / maxRight) * CH;\n\n  const makePath = (data, yFn) => data.map((v, i) =>\n    `${i === 0 ? 'M' : 'L'} ${getX(i)} ${yFn(v)}`).join(' ');\n\n  const pathLen = (data, yFn) => {\n    let l = 0;\n    for (let i = 0; i < data.length - 1; i++) {\n      const dx = getX(i + 1) - getX(i);\n      const dy = yFn(data[i + 1]) - yFn(data[i]);\n      l += Math.sqrt(dx * dx + dy * dy);\n    }\n    return l;\n  };\n\n  const len1 = pathLen(visits, getYL);\n  const len2 = pathLen(newUsers, getYL);\n  const len3 = pathLen(convRate, getYR);\n\n  const prog1 = spring({ frame: Math.max(0, frame - 10), fps: safeFps, config: { stiffness: 38, damping: 22, mass: 1.5 } });\n  const prog2 = spring({ frame: Math.max(0, frame - 22), fps: safeFps, config: { stiffness: 38, damping: 22, mass: 1.5 } });\n  const prog3 = spring({ frame: Math.max(0, frame - 34), fps: safeFps, config: { stiffness: 38, damping: 22, mass: 1.5 } });\n\n  const titleSpring = spring({ frame, fps: safeFps, config: { damping: 22, stiffness: 90 } });\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [-40, 0]);\n\n  const gridL = [0, 2, 4, 6];\n  const gridR = [0, 5, 10, 15, 20, 25];\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      background: `linear-gradient(135deg, ${bgStart} 0%, ${bgEnd} 100%)`,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      overflow: 'hidden', fontFamily: \"'Inter', sans-serif\", color: props.textColor || '#cbe8fd',\n    }}>\n      <div style={{\n        position: 'absolute', top: 0, left: 0, right: 0, height: 3,\n        background: `linear-gradient(90deg, transparent, ${color1}, ${color2}, ${color3}, transparent)`,\n        opacity: titleOpacity,\n      }} />\n\n      <div style={{\n        position: 'absolute', top: 80, left: ML,\n        opacity: titleOpacity, transform: `translateY(${titleY}px)`,\n      }}>\n        <div style={{ fontSize: 76, fontWeight: 900, letterSpacing: '0.08em', textTransform: 'uppercase' }}>{title}</div>\n        <div style={{ fontSize: 28, fontWeight: 300, marginTop: 14, opacity: 0.7, letterSpacing: '0.1em' }}>{subtitle}</div>\n      </div>\n\n      {/* Legend */}\n      <div style={{\n        position: 'absolute', top: 100, right: MR,\n        display: 'flex', flexDirection: 'column', gap: 14,\n        opacity: interpolate(frame, [10, 28], [0, 1], { extrapolateRight: 'clamp' }),\n      }}>\n        {[\n          { color: color1, label: label1, dash: 'none', w: 6 },\n          { color: color2, label: label2, dash: '10,5', w: 4 },\n          { color: color3, label: label3, dash: '3,6', w: 4 },\n        ].map((l, i) => (\n          <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 14 }}>\n            <svg width={44} height={6}>\n              <line x1={0} y1={3} x2={44} y2={3} stroke={l.color} strokeWidth={l.w}\n                strokeDasharray={l.dash} strokeLinecap=\"round\" />\n            </svg>\n            <span style={{ fontSize: 20, fontWeight: 500, color: l.color }}>{l.label}</span>\n          </div>\n        ))}\n      </div>\n\n      <svg style={{ position: 'absolute', top: MT, left: ML }}\n        width={CW} height={CH} overflow=\"visible\">\n        <defs>\n          <filter id=\"glow3\"><feGaussianBlur stdDeviation=\"3\" result=\"b\" />\n            <feMerge><feMergeNode in=\"b\" /><feMergeNode in=\"SourceGraphic\" /></feMerge>\n          </filter>\n        </defs>\n\n        {/* Left grid */}\n        {gridL.map((v, i) => {\n          const y = getYL(v);\n          const op = interpolate(frame, [6 + i * 3, 22 + i * 3], [0, 0.25], { extrapolateRight: 'clamp' });\n          return (\n            <g key={`l${v}`} opacity={op}>\n              <line x1={0} y1={y} x2={CW} y2={y} stroke={props.gridColor || '#cbe8fd'} strokeWidth={1} />\n              <text x={-14} y={y + 6} fill={color1} fontSize={18}\n                fontFamily=\"'IBM Plex Mono', monospace\" textAnchor=\"end\" opacity={3}>{v}M</text>\n            </g>\n          );\n        })}\n\n        {/* Right grid labels */}\n        {gridR.map((v, i) => {\n          const y = getYR(v);\n          const op = interpolate(frame, [6 + i * 3, 22 + i * 3], [0, 0.7], { extrapolateRight: 'clamp' });\n          return (\n            <text key={`r${v}`} x={CW + 14} y={y + 6} fill={color3} fontSize={18}\n              fontFamily=\"'IBM Plex Mono', monospace\" textAnchor=\"start\" opacity={op}>{v}%</text>\n          );\n        })}\n\n        {/* X labels */}\n        {weeks.map((w, i) => {\n          const op = interpolate(frame, [18 + i * 3, 32 + i * 3], [0, 0.65], { extrapolateRight: 'clamp' });\n          return (\n            <text key={w} x={getX(i)} y={CH + 46} fill={props.textColor || '#cbe8fd'} fontSize={20}\n              fontFamily=\"'IBM Plex Mono', monospace\" textAnchor=\"middle\" opacity={op}>{w}</text>\n          );\n        })}\n\n        {/* Line 3 - conv rate */}\n        <path d={makePath(convRate, getYR)} fill=\"none\" stroke={color3} strokeWidth={4}\n          strokeDasharray={`${len3} ${len3}`} strokeDashoffset={interpolate(prog3, [0, 1], [len3, 0])}\n          strokeLinecap=\"round\" strokeDasharray2=\"3,6\" opacity={0.9} />\n\n        {/* Line 2 - new users */}\n        <path d={makePath(newUsers, getYL)} fill=\"none\" stroke={color2} strokeWidth={4}\n          strokeDasharray={`${len2} ${len2}`} strokeDashoffset={interpolate(prog2, [0, 1], [len2, 0])}\n          strokeLinecap=\"round\" opacity={0.9} />\n\n        {/* Line 1 - visits */}\n        <path d={makePath(visits, getYL)} fill=\"none\" stroke={color1} strokeWidth={6}\n          strokeDasharray={`${len1} ${len1}`} strokeDashoffset={interpolate(prog1, [0, 1], [len1, 0])}\n          strokeLinecap=\"round\" filter=\"url(#glow3)\" />\n\n        {/* Dots visits */}\n        {visits.map((v, i) => {\n          const tp = i / (visits.length - 1);\n          const s = spring({ frame: Math.max(0, frame - 10 - tp * 28), fps: safeFps, config: { stiffness: 120, damping: 12 } });\n          return prog1 >= tp - 0.05 ? (\n            <circle key={i} cx={getX(i)} cy={getYL(v)} r={8} fill={color1}\n              style={{ transformOrigin: `${getX(i)}px ${getYL(v)}px`, transform: `scale(${s})` }}\n              filter=\"url(#glow3)\" />\n          ) : null;\n        })}\n\n        {/* Dots new users */}\n        {newUsers.map((v, i) => {\n          const tp = i / (newUsers.length - 1);\n          const s = spring({ frame: Math.max(0, frame - 22 - tp * 28), fps: safeFps, config: { stiffness: 120, damping: 12 } });\n          return prog2 >= tp - 0.05 ? (\n            <circle key={i} cx={getX(i)} cy={getYL(v)} r={6} fill={bgEnd} stroke={color2} strokeWidth={3}\n              style={{ transformOrigin: `${getX(i)}px ${getYL(v)}px`, transform: `scale(${s})` }} />\n          ) : null;\n        })}\n\n        {/* Dots conv rate */}\n        {convRate.map((v, i) => {\n          const tp = i / (convRate.length - 1);\n          const s = spring({ frame: Math.max(0, frame - 34 - tp * 28), fps: safeFps, config: { stiffness: 120, damping: 12 } });\n          return prog3 >= tp - 0.05 ? (\n            <circle key={i} cx={getX(i)} cy={getYR(v)} r={5} fill={color3}\n              style={{ transformOrigin: `${getX(i)}px ${getYR(v)}px`, transform: `scale(${s})` }} />\n          ) : null;\n        })}\n      </svg>\n\n      <div style={{\n        position: 'absolute', bottom: 0, left: 0, right: 0, height: 2,\n        background: `linear-gradient(90deg, transparent, ${color1}88, ${color2}88, transparent)`,\n        opacity: titleOpacity,\n      }} />\n    </div>\n  );\n};\n"
 },
 {
  "id": "0273f371-8c99-4d7f-b51e-096edd9d2188",
  "name": "Pie Chart - Customer Satisfaction",
  "category": "data-visualization",
  "description": "4-ring concentric chart with sweeping animation and connecting value labels styled like an infographic.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "GRID CAPACITY MIX",
   "subtitleText": "Output Share by Energy Source",
   "bgGradientStart": "#fdf6f3",
   "bgGradientEnd": "#f9eae4",
   "trackColor": "rgba(232,101,74,0.16)",
   "lineColor": "rgba(69,32,26,0.45)",
   "textColor": "#45201a",
   "ringRgb": "226, 92, 62",
   "titleColor": "#45201a"
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "GRID CAPACITY MIX",
    "label": "Title"
   },
   {
    "key": "subtitleText",
    "type": "text",
    "defaultValue": "Output Share by Energy Source",
    "label": "Subtitle"
   },
   {
    "key": "bgGradientStart",
