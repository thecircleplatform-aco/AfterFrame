    "label": "Exit start (sec)"
   }
  ],
  "thumb": "/thumbnails/62cceb8b-a33f-45b0-a5ff-2a2be3fe2107.jpg",
  "code": "const SkewedChapterCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const mainText = item?.propertyOverrides?.mainText ?? \"AMERICA'S TOP PLAYLIST?\";\n  const subText = item?.propertyOverrides?.subText ?? 'STREAMING APP RANKING';\n  const sphereNumber = item?.propertyOverrides?.sphereNumber ?? '';\n  const bannerMaxWidth = item?.propertyOverrides?.bannerMaxWidth ?? 720;\n  const bannerPaddingRight = item?.propertyOverrides?.bannerPaddingRight ?? 20;\n  const animSpeed = item?.propertyOverrides?.animSpeed ?? 1;\n  const exitDurationSec = item?.propertyOverrides?.exitDuration ?? 3;\n\n  // Height increased to 210 to fully contain the circle (140px) with padding\n  const DESIGN_WIDTH = 950;\n  const DESIGN_HEIGHT = 210;\n\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const GREEN_PRIMARY = '#df6ed2';\n  const GREEN_DARK = '#d65fc9';\n  const BLACK_BG = '#1a1a1a';\n  const WHITE_BG = '#ffffff';\n\n  const CIRCLE_RADIUS = 70;\n  const CIRCLE_DIAMETER = CIRCLE_RADIUS * 2;\n  const CIRCLE_X = 50;\n  // Banner white bar center: bannerTop(15) + topBarTop(15) + topBarHeight/2(35) = 65px\n  // Circle top = banner center - radius = 65 - 70 = -5 ... shift banner down by 20 so circle fits\n  // bannerContainerTop = 35, white bar center = 35+15+35 = 85, CIRCLE_Y = 85-70 = 15\n  const CIRCLE_Y = 15;\n  const BANNER_TOP = 35;\n  const BANNER_LEFT = CIRCLE_X + CIRCLE_RADIUS + 10;\n  const BANNER_WIDTH = bannerMaxWidth;\n\n  const bannerDelay = 15;\n  const exitStartFrame = fps * exitDurationSec;\n  const entranceDuration = 40;\n\n  const isExiting = frame >= exitStartFrame;\n  const exitFrame = frame - exitStartFrame;\n  const reversedFrame = isExiting ? Math.max(0, entranceDuration - exitFrame) : frame;\n  const effectiveFrame = isExiting ? reversedFrame : frame;\n  const scaledFrame = effectiveFrame / Math.max(0.1, animSpeed);\n\n  const slideProgress = spring({ frame: scaledFrame, fps, config: { damping: 22, stiffness: 90, mass: 0.8 } });\n  const slideX = interpolate(slideProgress, [0, 1], [-DESIGN_WIDTH, 0], { extrapolateRight: 'clamp' });\n\n  const scaleProgress = spring({ frame: scaledFrame, fps, config: { damping: 20, stiffness: 120, mass: 0.6 } });\n  const circleScale = interpolate(scaleProgress, [0, 1], [0, 1], { extrapolateRight: 'clamp' });\n\n  const spinProgress = spring({ frame: scaledFrame, fps, config: { damping: 25, stiffness: 100, mass: 0.8 } });\n  const rotateY = interpolate(spinProgress, [0, 1], [-180, 0]);\n  const numberScaleX = Math.cos(rotateY * Math.PI / 180);\n  const numberOpacity = rotateY > -90 ? 1 : 0;\n\n  const bannerProgress = spring({ frame: scaledFrame - bannerDelay, fps, config: { damping: 18, stiffness: 80 } });\n\n  const textDelay = 10;\n  const textProgress = spring({ frame: scaledFrame - bannerDelay - textDelay, fps, config: { damping: 22, stiffness: 90 } });\n  const textOpacity = interpolate(textProgress, [0, 1], [0, 1], { extrapolateRight: 'clamp' });\n  const textSlideX = interpolate(textProgress, [0, 1], [-30, 0], { extrapolateRight: 'clamp' });\n\n  const rootStyle = {\n    position: 'absolute',\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: 'transparent',\n    transform: `scale(${scale}) translateX(${slideX}px)`,\n    transformOrigin: 'top left',\n    overflow: 'visible',\n    fontFamily: 'Inter, sans-serif',\n  };\n\n  const circleStyle = {\n    position: 'absolute',\n    left: CIRCLE_X,\n    top: CIRCLE_Y,\n    width: CIRCLE_DIAMETER,\n    height: CIRCLE_DIAMETER,\n    borderRadius: '50%',\n    background: `radial-gradient(circle at 35% 35%, ${GREEN_PRIMARY} 0%, ${GREEN_DARK} 70%, #ab4ca1 100%)`,\n    border: '5px solid white',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    boxShadow: '0 8px 20px rgba(0,0,0,0.35), inset -8px -8px 20px rgba(0,0,0,0.2), inset 8px 8px 20px rgba(255,255,255,0.1)',\n    transform: `scale(${circleScale})`,\n    zIndex: 10,\n    overflow: 'hidden',\n  };\n\n  const numberStyle = {\n    fontSize: '80px',\n    fontWeight: 900,\n    color: '#1a1a1a',\n    fontFamily: 'Oswald, sans-serif',\n    transform: `scaleX(${numberScaleX})`,\n    opacity: numberOpacity,\n    textShadow: numberScaleX > 0.5 ? '2px 2px 4px rgba(0,0,0,0.3)' : 'none',\n  };\n\n  const bannerContainerStyle = {\n    position: 'absolute',\n    left: BANNER_LEFT,\n    top: BANNER_TOP,\n    height: 150,\n    zIndex: 5,\n  };\n\n  const whiteBarFullWidth = BANNER_WIDTH - 50;\n  const whiteBarAnimWidth = interpolate(bannerProgress, [0, 1], [0, whiteBarFullWidth]);\n\n  const topBarStyle = {\n    position: 'absolute',\n    top: 15,\n    left: 0,\n    width: Math.max(0, whiteBarAnimWidth),\n    height: 70,\n    backgroundColor: WHITE_BG,\n    borderTop: '4px solid #111',\n    borderBottom: '4px solid #111',\n    transform: 'skewX(-15deg)',\n    transformOrigin: 'left center',\n    boxSizing: 'border-box',\n  };\n\n  const blackBarAnimWidth = whiteBarAnimWidth * 0.7;\n  const bottomBarStyle = {\n    position: 'absolute',\n    top: 72,\n    left: 15,\n    width: Math.max(0, blackBarAnimWidth),\n    height: 35,\n    backgroundColor: BLACK_BG,\n    transform: 'skewX(-15deg)',\n    transformOrigin: 'left center',\n    zIndex: 1,\n  };\n\n  const mainTitleStyle = {\n    position: 'absolute',\n    top: 32,\n    left: 70,\n    fontSize: '40px',\n    fontWeight: 900,\n    fontStyle: 'italic',\n    fontFamily: 'Oswald, sans-serif',\n    color: '#111111',\n    lineHeight: 1,\n    textTransform: 'uppercase',\n    whiteSpace: 'nowrap',\n    opacity: textOpacity,\n    transform: `translateX(${textSlideX}px)`,\n    zIndex: 10,\n    paddingRight: bannerPaddingRight,\n  };\n\n  const subTitleStyle = {\n    position: 'absolute',\n    top: 80,\n    left: 70,\n    fontSize: '18px',\n    fontWeight: 700,\n    color: GREEN_PRIMARY,\n    textTransform: 'uppercase',\n    letterSpacing: '3px',\n    whiteSpace: 'nowrap',\n    opacity: textOpacity,\n    transform: `translateX(${textSlideX}px)`,\n    zIndex: 10,\n    paddingRight: bannerPaddingRight,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={bannerContainerStyle}>\n        <div style={topBarStyle} />\n        <div style={bottomBarStyle} />\n        <div style={mainTitleStyle}>{mainText}</div>\n        <div style={subTitleStyle}>{subText}</div>\n      </div>\n      <div style={circleStyle}>\n        {sphereNumber ? <span style={numberStyle}>{sphereNumber}</span> : null}\n      </div>\n    </div>\n  );\n};"
 },
 {
