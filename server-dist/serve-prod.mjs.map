  "thumb": "/thumbnails/c63df7ef-fc63-491b-ae4b-30a34d88d8ae.jpg",
  "code": "const Component = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'Home Decor Sales';\n  const prodALabel = props.productALabel || 'Rugs Line';\n  const prodAColor = props.productAColor || '#3dbefd';\n  const kpiTargetA = Number(props.kpiValueA || 24);\n\n  const prodBLabel = props.productBLabel || 'Lamps Line';\n  const prodBColor = props.productBColor || '#00bdbe';\n  const kpiTargetB = Number(props.kpiValueB || 18);\n\n  const bgColor = props.bgColor || '#E8E6F0';\n  const titleColor = props.titleColor || '#333333';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 16 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const cardEntrance = safeSpring(0, { damping: 18 });\n  const cardY = interpolate(cardEntrance, [0, 1], [80, 0]);\n  const cardOpacity = interpolate(cardEntrance, [0, 1], [0, 1]);\n\n  const kpiProgress = safeSpring(10, { damping: 16 });\n  const kpiValA = Math.round(interpolate(kpiProgress, [0, 1], [0, kpiTargetA]));\n  const kpiValB = Math.round(interpolate(kpiProgress, [0, 1], [0, kpiTargetB]));\n\n  const chartData = [\n    { label: 'Q1', a: 65, b: 45 },\n    { label: 'Q2', a: 78, b: 62 },\n    { label: 'Q3', a: 55, b: 70 },\n    { label: 'Q4', a: 88, b: 52 },\n  ];\n\n  const baseDelay = 15;\n  const stagger = 8;\n\n  const processedData = chartData.map((d, i) => {\n    const delayA = baseDelay + i * stagger;\n    const delayB = delayA + 4;\n\n    const springA = safeSpring(delayA, { damping: 15 });\n    const springB = safeSpring(delayB, { damping: 15 });\n\n    const currentA = Math.round(interpolate(springA, [0, 1], [0, d.a]));\n    const currentB = Math.round(interpolate(springB, [0, 1], [0, d.b]));\n\n    const heightA = interpolate(springA, [0, 1], [0, d.a]);\n    const heightB = interpolate(springB, [0, 1], [0, d.b]);\n\n    const opacityA = interpolate(springA, [0, 0.5], [0, 1], { extrapolateRight: 'clamp' });\n    const opacityB = interpolate(springB, [0, 0.5], [0, 1], { extrapolateRight: 'clamp' });\n\n    return {\n      key: `group-${i}`,\n      label: d.label,\n      currentA,\n      currentB,\n      groupStyle: { display: 'flex', alignItems: 'flex-end', height: '100%', gap: 16, position: 'relative', width: 140, justifyContent: 'center' },\n      barAWrapperStyle: { display: 'flex', flexDirection: 'column', justifyContent: 'flex-end', alignItems: 'center', height: '100%', width: 56 },\n      barAValueStyle: { marginBottom: 12, fontSize: 22, fontWeight: 700, color: prodAColor, opacity: opacityA },\n      barAStyle: { width: '100%', height: `${heightA}%`, backgroundColor: prodAColor, borderRadius: '8px 8px 0 0' },\n      barBWrapperStyle: { display: 'flex', flexDirection: 'column', justifyContent: 'flex-end', alignItems: 'center', height: '100%', width: 56 },\n      barBValueStyle: { marginBottom: 12, fontSize: 22, fontWeight: 700, color: prodBColor, opacity: opacityB },\n      barBStyle: { width: '100%', height: `${heightB}%`, backgroundColor: prodBColor, borderRadius: '8px 8px 0 0' },\n      xAxisLabelStyle: { position: 'absolute', bottom: -50, fontSize: 24, color: '#888888', fontWeight: 600, textAlign: 'center', width: '100%' }\n    };\n  });\n\n  const rootStyle = { position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: `scale(${scale})`, transformOrigin: 'top left', backgroundColor: bgColor, fontFamily, overflow: 'hidden' };\n  const watermarkStyle = { position: 'absolute', top: '50%', left: '50%', transform: 'translate(-50%, -50%)', width: 1200, height: 1200, opacity: 0.03, fill: titleColor };\n  const cardStyle = { position: 'absolute', width: 1400, height: 800, left: 260, top: 140, backgroundColor: '#FFFFFF', borderRadius: 48, boxShadow: '0 40px 100px rgba(0,0,0,0.06)', padding: '60px 80px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', transform: `translateY(${cardY}px)`, opacity: cardOpacity };\n  const headerStyle = { display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', width: '100%' };\n  const titleStyle = { fontSize: 56, fontWeight: 800, color: titleColor, margin: 0, letterSpacing: '-1px' };\n  const kpisContainerStyle = { display: 'flex', gap: 70 };\n  const kpiBlockStyle = { display: 'flex', flexDirection: 'column', alignItems: 'flex-start' };\n  const kpiLabelStyle = { fontSize: 20, color: '#888888', fontWeight: 600, textTransform: 'uppercase', letterSpacing: '1px', marginBottom: 6 };\n  const kpiValueStyleA = { fontSize: 64, fontWeight: 800, color: prodAColor, lineHeight: 1 };\n  const kpiValueStyleB = { fontSize: 64, fontWeight: 800, color: prodBColor, lineHeight: 1 };\n  const chartAreaStyle = { position: 'relative', width: 'calc(100% - 80px)', height: 420, marginTop: 60, marginLeft: 80 };\n  const barsContainerStyle = { position: 'absolute', left: 0, top: 0, right: 0, bottom: 0, display: 'flex', justifyContent: 'space-around', alignItems: 'flex-end', paddingLeft: 20, paddingRight: 20 };\n\n  const yAxisLabels = [100, 75, 50, 25, 0];\n  const gridLines = yAxisLabels.map((val, i) => {\n    const isZero = val === 0;\n    return {\n      key: `grid-${i}`,\n      textLabel: `${val}%`,\n      lineStyle: { position: 'absolute', left: 0, right: 0, top: `${100 - val}%`, height: isZero ? 3 : 2, backgroundColor: isZero ? '#CCCCCC' : '#F0F0F0' },\n      labelStyle: { position: 'absolute', left: -80, top: -14, width: 60, textAlign: 'right', fontSize: 20, color: '#999999', fontWeight: 500 }\n    };\n  });\n\n  return (\n    <div style={rootStyle}>\n      <svg style={watermarkStyle} xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\">\n        <path d=\"M22.04 14.12c.79-1.22 1.09-2.73.57-4.16-1.07-2.92-4.66-3.72-7.85-3.72h-1.63V2.41h-2.18v3.83h-1.6V2.41h-2.18v3.83h-3v2.18h1.22c.98 0 1.54.49 1.54 1.54v11.75c0 1.05-.56 1.54-1.54 1.54h-1.22v2.18h3v3.83h2.18v-3.83h1.6v3.83h2.18v-3.83h2.72c3.41 0 7.21-1.07 8.16-4.57.51-1.89.14-3.61-.79-4.88zm-5.74-5.35c1.69 0 3.75.3 4.29 1.78.54 1.48-.68 2.54-2.37 2.54h-3.46v-4.32h1.54zm.8 12.3c-1.87 0-4.15-.33-4.75-1.98-.6-1.64.75-2.82 2.62-2.82h3.66v4.8h-1.53z\" />\n      </svg>\n      <div style={cardStyle}>\n        <div style={headerStyle}>\n          <h1 style={titleStyle}>{titleText}</h1>\n          <div style={kpisContainerStyle}>\n            <div style={kpiBlockStyle}>\n              <span style={kpiLabelStyle}>{prodALabel}</span>\n              <span style={kpiValueStyleA}>{kpiValA}%</span>\n            </div>\n            <div style={kpiBlockStyle}>\n              <span style={kpiLabelStyle}>{prodBLabel}</span>\n              <span style={kpiValueStyleB}>{kpiValB}%</span>\n            </div>\n          </div>\n        </div>\n        <div style={chartAreaStyle}>\n          {gridLines.map(g => (\n            <div key={g.key} style={g.lineStyle}>\n              <div style={g.labelStyle}>{g.textLabel}</div>\n            </div>\n          ))}\n          <div style={barsContainerStyle}>\n            {processedData.map(d => (\n              <div key={d.key} style={d.groupStyle}>\n                <div style={d.barAWrapperStyle}>\n                  <div style={d.barAValueStyle}>{d.currentA}%</div>\n                  <div style={d.barAStyle} />\n                </div>\n                <div style={d.barBWrapperStyle}>\n                  <div style={d.barBValueStyle}>{d.currentB}%</div>\n                  <div style={d.barBStyle} />\n                </div>\n                <div style={d.xAxisLabelStyle}>{d.label}</div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
