    "label": "Ring 4 Label"
   }
  ],
  "thumb": "/thumbnails/0273f371-8c99-4d7f-b51e-096edd9d2188.jpg",
  "code": "const PieChart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item?.props || {};\n  const titleText = props.titleText || 'INSTALLER FEEDBACK';\n  const subtitleText = props.subtitleText || 'Review Results by Rating Tier';\n  const bgStart = props.bgGradientStart || '#3b4860';\n  const bgEnd = props.bgGradientEnd || '#4d5768';\n  const titleFontFamily = props.titleFontFamily || 'Inter, sans-serif';\n  const monoFont = '\"IBM Plex Mono\", monospace';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    background: `linear-gradient(135deg, ${bgStart}, ${bgEnd})`,\n    overflow: 'hidden',\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center'\n  };\n\n  const rawData = React.useMemo(() => [\n    { label: props.label1 || 'Excellent', value: Number(props.val1 ?? 48), opacity: 1.0 },\n    { label: props.label2 || 'Good', value: Number(props.val2 ?? 31), opacity: 0.7 },\n    { label: props.label3 || 'Fair', value: Number(props.val3 ?? 14), opacity: 0.45 },\n    { label: props.label4 || 'Weak', value: Number(props.val4 ?? 7), opacity: 0.25 },\n  ], [props.label1, props.val1, props.label2, props.val2, props.label3, props.val3, props.label4, props.val4]);\n\n  const data = React.useMemo(() => {\n    const totalVal = rawData.reduce((acc, curr) => acc + curr.value, 0) || 1;\n    let currentPercent = 0;\n    return rawData.map(d => {\n      const pct = (d.value / totalVal) * 100;\n      const startPercent = currentPercent;\n      currentPercent += pct;\n      return { ...d, pct, startPercent, endPercent: currentPercent };\n    });\n  }, [rawData]);\n\n  const safeFps = fps || 30;\n\n  const sweepProgress = interpolate(frame, [15, 75], [0, 100], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateRight: 'clamp',\n    extrapolateLeft: 'clamp'\n  });\n\n  // Pie ring dimensions — strokeWidth must be much less than radius\n  const cx = 960;\n  const cy = 580;\n  const radius = 210;\n  const ringStrokeWidth = 90;\n  const circumference = 2 * Math.PI * radius;\n\n  const titleOpacity = spring({ frame: Math.max(0, frame - 5), fps: safeFps, config: { damping: 20 } });\n  const titleY = interpolate(titleOpacity, [0, 1], [-20, 0]);\n\n  return (\n    <div style={rootStyle}>\n      {/* Header */}\n      <div style={{\n        position: 'absolute', top: 100, left: 0, width: '100%', textAlign: 'center',\n        opacity: titleOpacity, transform: `translateY(${titleY}px)`\n      }}>\n        <div style={{ fontFamily: titleFontFamily, fontWeight: 600, fontSize: 56, color: props.titleColor || '#fff', letterSpacing: '4px', textTransform: 'uppercase' }}>\n          {titleText}\n        </div>\n        <div style={{ fontFamily: titleFontFamily, fontWeight: 300, fontSize: 24, color: props.textColor || 'rgba(255,255,255,0.7)', letterSpacing: '1px', marginTop: 10 }}>\n          {subtitleText}\n        </div>\n      </div>\n\n      {/* Pie Chart SVG */}\n      <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={{ position: 'absolute', top: 0, left: 0, overflow: 'visible' }}>\n        <g transform={`rotate(-90 ${cx} ${cy})`}>\n          {data.map((slice, i) => {\n            const animatedValue = Math.max(0, Math.min(slice.pct, sweepProgress - slice.startPercent));\n            if (animatedValue <= 0) return null;\n\n            // Use a small gap (2px) between segments for clean separation\n            const gapAngle = (2 / circumference) * 100;\n            const length = Math.max(0, (Math.max(0, animatedValue - gapAngle) / 100) * circumference);\n            const offset = -(slice.startPercent / 100) * circumference;\n\n            return (\n              <circle\n                key={`slice-${i}`}\n                cx={cx}\n                cy={cy}\n                r={radius}\n                fill=\"none\"\n                stroke={`rgba(${props.ringRgb || '255, 255, 255'}, ${slice.opacity})`}\n                strokeWidth={ringStrokeWidth}\n                strokeDasharray={`${length} ${circumference}`}\n                strokeDashoffset={offset}\n                strokeLinecap=\"butt\"\n              />\n            );\n          })}\n        </g>\n\n        {/* Callout Lines — solid, not dashed */}\n        {data.map((slice, i) => {\n          if (slice.pct === 0) return null;\n          const centerPercent = slice.startPercent + slice.pct / 2;\n          const triggerFrame = 15 + (centerPercent / 100) * 45;\n          const calloutPop = spring({ frame: Math.max(0, frame - triggerFrame), fps: safeFps, config: { damping: 14, stiffness: 80 } });\n\n          if (calloutPop === 0) return null;\n\n          // Angle from the center percent of this slice\n          const theta = (centerPercent / 100) * 2 * Math.PI;\n          const isRight = Math.sin(theta) >= 0;\n\n          const lineR1 = radius + ringStrokeWidth / 2 + 20;\n          const lineR2 = lineR1 + 60;\n\n          const lineX1 = cx + lineR1 * Math.sin(theta);\n          const lineY1 = cy - lineR1 * Math.cos(theta);\n          const lineX2 = cx + lineR2 * Math.sin(theta);\n          const lineY2 = cy - lineR2 * Math.cos(theta);\n          const lineX3 = isRight ? lineX2 + 50 : lineX2 - 50;\n          const lineY3 = lineY2;\n\n          const animX2 = interpolate(calloutPop, [0, 0.5, 1], [lineX1, lineX2, lineX2], { extrapolateRight: 'clamp' });\n          const animY2 = interpolate(calloutPop, [0, 0.5, 1], [lineY1, lineY2, lineY2], { extrapolateRight: 'clamp' });\n          const animX3 = interpolate(calloutPop, [0.5, 1], [lineX2, lineX3], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n          return (\n            <path\n              key={`line-${i}`}\n              d={`M ${lineX1} ${lineY1} L ${animX2} ${animY2} L ${animX3} ${lineY3}`}\n              stroke={props.lineColor || 'rgba(255,255,255,0.8)'}\n              strokeWidth=\"2\"\n              fill=\"none\"\n              opacity={calloutPop}\n            />\n          );\n        })}\n      </svg>\n\n      {/* Callout Text */}\n      {data.map((slice, i) => {\n        if (slice.pct === 0) return null;\n        const centerPercent = slice.startPercent + slice.pct / 2;\n        const triggerFrame = 15 + (centerPercent / 100) * 45;\n        const calloutPop = spring({ frame: Math.max(0, frame - triggerFrame - 5), fps: safeFps, config: { damping: 14 } });\n\n        if (calloutPop === 0) return null;\n\n        const theta = (centerPercent / 100) * 2 * Math.PI;\n        const isRight = Math.sin(theta) >= 0;\n        const lineR2 = radius + ringStrokeWidth / 2 + 80;\n        const lineX2 = cx + lineR2 * Math.sin(theta);\n        const lineX3 = isRight ? lineX2 + 50 : lineX2 - 50;\n        const lineY3 = cy - lineR2 * Math.cos(theta);\n\n        const divStyle = {\n          position: 'absolute',\n          top: lineY3,\n          left: isRight ? lineX3 + 15 : lineX3 - 15,\n          transform: `translate(${isRight ? 0 : '-100%'}, -50%) translateY(${10 - 10 * calloutPop}px)`,\n          opacity: calloutPop,\n          display: 'flex',\n          flexDirection: 'column',\n          alignItems: isRight ? 'flex-start' : 'flex-end'\n        };\n\n        return (\n          <div key={`text-${i}`} style={divStyle}>\n            <div style={{ fontFamily: monoFont, fontWeight: 500, fontSize: 48, color: props.titleColor || '#fff', lineHeight: 1 }}>\n              {Math.round(slice.pct)}%\n            </div>\n            <div style={{ fontFamily: titleFontFamily, fontWeight: 300, fontSize: 20, color: props.textColor || 'rgba(255,255,255,0.7)', textTransform: 'uppercase', letterSpacing: '2px', marginTop: 4 }}>\n              {slice.label}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n\n"
 },
