  "thumb": "/thumbnails/3515f6e1-019d-408d-9396-59cdea42abb1.jpg",
  "code": "const NeonTechOverlay = ({ item }) => {\n  const frame = useCurrentFrame();\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const text1 = props.text1;\n  const text2 = props.text2;\n  const text3 = props.text3;\n  const text4 = props.text4;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    overflow: 'hidden'\n  };\n\n  const bgStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0\n  };\n\n  const videoBorderStyle = {\n    position: 'absolute',\n    left: 1350,\n    top: 172,\n    width: 514,\n    height: 715,\n    borderRadius: 26,\n    border: '2px solid #79f599',\n    boxShadow: '0 0 20px rgba(121,245,153,0.4), inset 0 0 20px rgba(121,245,153,0.4)',\n    pointerEvents: 'none',\n    boxSizing: 'border-box'\n  };\n\n  const iconCircleStyle = {\n    width: 88,\n    height: 88,\n    borderRadius: 44,\n    backgroundColor: '#79f599',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    flexShrink: 0\n  };\n\n  const LucideIcon = ({ d, children, item }) => (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"44\"\n      height=\"44\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"#0A0A0A\"\n      strokeWidth=\"2.4\"\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n    >\n      {d ? <path d={d} /> : children}\n    </svg>\n  );\n\n  const icons = [\n    <LucideIcon><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\" /></LucideIcon>,\n    <LucideIcon>\n      <rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\" ry=\"2\" />\n      <rect x=\"9\" y=\"9\" width=\"6\" height=\"6\" />\n      <line x1=\"9\" y1=\"1\" x2=\"9\" y2=\"4\" />\n      <line x1=\"15\" y1=\"1\" x2=\"15\" y2=\"4\" />\n      <line x1=\"9\" y1=\"20\" x2=\"9\" y2=\"23\" />\n      <line x1=\"15\" y1=\"20\" x2=\"15\" y2=\"23\" />\n      <line x1=\"20\" y1=\"9\" x2=\"23\" y2=\"9\" />\n      <line x1=\"20\" y1=\"14\" x2=\"23\" y2=\"14\" />\n      <line x1=\"1\" y1=\"9\" x2=\"4\" y2=\"9\" />\n      <line x1=\"1\" y1=\"14\" x2=\"4\" y2=\"14\" />\n    </LucideIcon>,\n    <LucideIcon>\n      <rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\" />\n      <rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\" />\n      <line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\" />\n      <line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\" />\n    </LucideIcon>,\n    <LucideIcon><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" /></LucideIcon>\n  ];\n\n  const cards = [text1, text2, text3, text4];\n  const enterFrames = [20, 45, 70, 95];\n  const cyList = [179, 417, 662, 907];\n  const exitFrame = 155;\n\n  const cardData = cards.map((txt, i) => {\n    const enterF = enterFrames[i];\n    \n    const enterProgress = interpolate(frame, [enterF, enterF + 14], [0, 1], {\n        extrapolateLeft: 'clamp',\n        extrapolateRight: 'clamp',\n        easing: Easing.out(Easing.cubic)\n    });\n    const exitProgress = interpolate(frame, [exitFrame, exitFrame + 14], [0, 1], {\n        extrapolateLeft: 'clamp',\n        extrapolateRight: 'clamp',\n        easing: Easing.in(Easing.cubic)\n    });\n    const cardProgress = enterProgress - exitProgress;\n    const cardOpacity = Math.max(0, cardProgress);\n    const cardSlide = interpolate(cardProgress, [0, 1], [-50, 0]);\n\n    const textEnterF = enterF + 6;\n    const textEnterProgress = interpolate(frame, [textEnterF, textEnterF + 14], [0, 1], {\n        extrapolateLeft: 'clamp',\n        extrapolateRight: 'clamp',\n        easing: Easing.out(Easing.cubic)\n    });\n    const textProgress = textEnterProgress - exitProgress;\n    const textOpacity = Math.max(0, textProgress);\n    const textSlide = interpolate(textProgress, [0, 1], [-30, 0]);\n\n    return {\n        text: txt,\n        icon: icons[i],\n        cardStyle: {\n            position: 'absolute',\n            left: 99,\n            top: cyList[i] - 80,\n            width: 735,\n            height: 160,\n            backgroundColor: '#1C1C1C',\n            borderRadius: 18,\n            display: 'flex',\n            alignItems: 'center',\n            paddingLeft: 36,\n            boxSizing: 'border-box',\n            opacity: cardOpacity,\n            transform: `translateX(${cardSlide}px)`\n        },\n        textStyle: {\n            marginLeft: 40,\n            color: '#FFFFFF',\n            fontFamily: fontFamily,\n            fontSize: 38,\n            fontWeight: 600,\n            letterSpacing: '0.02em',\n            opacity: textOpacity,\n            transform: `translateX(${textSlide}px)`\n        }\n    };\n  });\n\n  return (\n    <div style={rootStyle}>\n      <svg width=\"1920\" height=\"1080\" style={bgStyle}>\n        <defs>\n          <mask id=\"video-hole\">\n            <rect width=\"1920\" height=\"1080\" fill=\"white\" />\n            <rect x=\"1350\" y=\"172\" width=\"514\" height=\"715\" rx=\"26\" fill=\"black\" />\n          </mask>\n        </defs>\n        {!transparentBackground && (\n          <rect width=\"1920\" height=\"1080\" fill={bgColor} mask=\"url(#video-hole)\" />\n        )}\n      </svg>\n\n      <div style={videoBorderStyle} />\n\n      {cardData.map((data, i) => (\n        <div key={i} style={data.cardStyle}>\n          <div style={iconCircleStyle}>\n            {data.icon}\n          </div>\n          <div style={data.textStyle}>\n            {data.text}\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n};"
 },
