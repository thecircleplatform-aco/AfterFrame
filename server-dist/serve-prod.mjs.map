  "name": "Bar Chart - Monthly Sales",
  "category": "data-visualization",
  "description": "A modern, minimalist bar chart infographic with a staggered growth animation, customizable data, and a clean card layout.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
