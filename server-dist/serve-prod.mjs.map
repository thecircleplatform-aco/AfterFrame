  "thumb": "/thumbnails/a6e86e59-c544-4ee5-8c49-e8bfed68712b.jpg",
  "code": "const RetroDecodeStyleCard = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const safeFps = fps || 30;\n\n  const props = item.props || {};\n  const transparentBackground = props.transparentBackground;\n  const bgColor = props.bgColor;\n  const primaryColor = props.primaryColor;\n  const accentColor = props.accentColor;\n\n  const fontTitle = props.fontTitle;\n  const fontBody = props.fontBody;\n  const fontScript = props.fontScript;\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  // Typewriter helper\n  const TextAnim = ({ text, startFrame, item }) => {\n    const safeText = text || '';\n    const charCount = Math.max(0, Math.floor((frame - startFrame) * 1.5));\n    return <>{safeText.substring(0, charCount)}</>;\n  };\n\n  // Burst shape generator for the badge\n  const getBurstPath = (cx, cy, r1, r2, pts) => {\n    let d = '';\n    for (let i = 0; i < pts * 2; i++) {\n      const r = i % 2 === 0 ? r1 : r2;\n      const a = (i * Math.PI) / pts;\n      d += (i === 0 ? 'M ' : 'L ') + (cx + r * Math.sin(a)) + ' ' + (cy - r * Math.cos(a)) + ' ';\n    }\n    return d + 'Z';\n  };\n\n  const starScale = spring({ frame: Math.max(0, frame - 15), fps: safeFps, config: { damping: 15 } });\n  const badgeScale = spring({ frame: Math.max(0, frame - 35), fps: safeFps, config: { damping: 12 } });\n  const badgeRotation = interpolate(frame, [35, 65], [-30, -10], { extrapolateRight: 'clamp' });\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor, overflow: 'hidden' }}>\n      {/* Halftone Texture Overlay */}\n      {!transparentBackground && (\n        <div\n          style={{\n            position: 'absolute',\n            inset: 0,\n            backgroundImage: `radial-gradient(${primaryColor}15 1.5px, transparent 1.5px)`,\n            backgroundSize: '12px 12px',\n            pointerEvents: 'none',\n            zIndex: 0\n          }}\n        />\n      )}\n\n      <div style={{ position: 'absolute', inset: 0, zIndex: 1 }}>\n        {/* 1. Chapter Title */}\n        <div style={{ position: 'absolute', left: 120, top: 160, fontFamily: fontTitle, fontSize: 180, lineHeight: 0.9, textTransform: 'uppercase' }}>\n          <div style={{ color: 'transparent', WebkitTextStroke: `4px ${accentColor}` }}>\n            <TextAnim text={props.titleLine1} startFrame={5} />\n          </div>\n          <div style={{ color: primaryColor }}>\n            <TextAnim text={props.titleLine2} startFrame={15} />\n          </div>\n          <div style={{ position: 'absolute', left: 470, top: -20, transform: `scale(${starScale}) rotate(${frame * 0.5}deg)` }}>\n            <svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n              <path d=\"M 50 0 L 60 40 L 100 50 L 60 60 L 50 100 L 40 60 L 0 50 L 40 40 Z\" fill={accentColor} />\n            </svg>\n          </div>\n        </div>\n\n        {/* 2. Data Chart */}\n        <div style={{ position: 'absolute', left: 120, top: 620, width: 420 }}>\n          {[ \n            { label: props.chartT1, val: props.chartV1, color: primaryColor, start: 45 },\n            { label: props.chartT2, val: props.chartV2, color: accentColor, start: 50 },\n            { label: props.chartT3, val: props.chartV3, color: primaryColor, start: 55 }\n          ].map((bar, i) => {\n            const barWidth = spring({ frame: Math.max(0, frame - bar.start - 15), fps: safeFps, config: { damping: 15 } });\n            return (\n              <div key={i} style={{ marginBottom: 24 }}>\n                <div style={{ fontFamily: fontBody, fontSize: 24, color: primaryColor, marginBottom: 8, fontWeight: 600 }}>\n                  <TextAnim text={bar.label} startFrame={bar.start} />\n                </div>\n                {frame >= bar.start && <div style={{ width: '100%', height: 16, backgroundColor: `${bar.color}33`, borderRadius: 8, overflow: 'hidden' }}>\n                  <div style={{ width: `${barWidth * bar.val}%`, height: '100%', backgroundColor: bar.color }} />\n                </div>}\n              </div>\n            );\n          })}\n        </div>\n\n        {/* 3. Name Tag */}\n        <div style={{ position: 'absolute', left: 820, top: 160 }}>\n          <div style={{ fontFamily: fontBody, fontSize: 24, fontWeight: 'bold', letterSpacing: 6, color: accentColor, textTransform: 'uppercase' }}>\n            <TextAnim text={props.nameSubtitle} startFrame={15} />\n          </div>\n          <div style={{ fontFamily: fontTitle, fontSize: 72, color: primaryColor, marginTop: 4 }}>\n            <TextAnim text={props.nameTitle} startFrame={25} />\n          </div>\n          {frame >= 30 && <svg width=\"450\" height=\"40\" style={{ marginTop: 16 }}>\n            <path \n              d=\"M 0 20 Q 15 5 30 20 T 60 20 T 90 20 T 120 20 T 150 20 T 180 20 T 210 20 T 240 20 T 270 20 T 300 20 T 330 20 T 360 20 T 390 20 T 420 20 T 450 20\" \n              fill=\"none\" \n              stroke={accentColor} \n              strokeWidth=\"4\" \n              strokeDasharray=\"500\" \n              strokeDashoffset={interpolate(frame, [30, 60], [500, 0], { extrapolateRight: 'clamp' })} \n            />\n          </svg>}\n        </div>\n\n        {/* 4. Bullet Points */}\n        <div style={{ position: 'absolute', left: 820, top: 620 }}>\n          {[\n            { text: props.bullet1, start: 55 },\n            { text: props.bullet2, start: 60 },\n            { text: props.bullet3, start: 65 }\n          ].map((item, i) => {\n            const dotScale = spring({ frame: Math.max(0, frame - item.start), fps: safeFps, config: { damping: 15 } });\n            return (\n              <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 16, marginBottom: 20 }}>\n                <div style={{ width: 16, height: 16, borderRadius: 8, backgroundColor: accentColor, transform: `scale(${dotScale})` }} />\n                <div style={{ fontFamily: fontBody, fontSize: 32, color: primaryColor, fontWeight: 500 }}>\n                  <TextAnim text={item.text} startFrame={item.start + 5} />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* 5. Highlight Quote */}\n        <div style={{ position: 'absolute', left: 1380, top: 620, width: 440 }}>\n          <div style={{ fontFamily: fontScript, fontSize: 60, color: primaryColor, lineHeight: 1.25 }}>\n            <TextAnim text={props.quoteText} startFrame={65} />\n          </div>\n        </div>\n\n        {/* 6. Timeline & Badge */}\n        <div style={{ position: 'absolute', left: 1380, top: 220, width: 440, height: 100 }}>\n          <div style={{ \n            position: 'absolute', top: 48, left: 0, height: 4, backgroundColor: accentColor, \n            width: `${interpolate(frame, [25, 55], [0, 100], { extrapolateRight: 'clamp' })}%` \n          }} />\n          \n          {[props.timelineY1, props.timelineY2, props.timelineY3, props.timelineY4].map((yr, i) => {\n            const nodeFrame = 25 + (i * 10);\n            const scale = spring({ frame: Math.max(0, frame - nodeFrame), fps: safeFps, config: { damping: 15 } });\n            return (\n              <div key={i} style={{ position: 'absolute', left: `${(i / 3) * 100}%`, top: 0, transform: 'translateX(-50%)', display: 'flex', flexDirection: 'column', alignItems: 'center' }}>\n                <div style={{ width: 20, height: 20, borderRadius: 10, backgroundColor: primaryColor, marginTop: 40, transform: `scale(${scale})` }} />\n                <div style={{ fontFamily: fontBody, fontSize: 20, color: primaryColor, marginTop: 16, fontWeight: 700 }}>\n                  <TextAnim text={yr} startFrame={nodeFrame + 5} />\n                </div>\n              </div>\n            );\n          })}\n\n          <div style={{ position: 'absolute', left: 340, top: -120, width: 140, height: 140, transform: `scale(${badgeScale}) rotate(${badgeRotation}deg)` }}>\n            <svg width=\"140\" height=\"140\" viewBox=\"0 0 140 140\" style={{ position: 'absolute', inset: 0 }}>\n              <path d={getBurstPath(70, 70, 70, 58, 16)} fill={accentColor} />\n            </svg>\n            <div style={{ position: 'absolute', inset: 0, display: 'flex', justifyContent: 'center', alignItems: 'center', fontFamily: fontTitle, fontSize: 44, color: bgColor, paddingTop: 4 }}>\n              <TextAnim text={props.badgeText} startFrame={45} />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
