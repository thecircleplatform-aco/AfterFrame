  "thumb": "/thumbnails/c77f1306-07a0-400c-aa05-303538c87ea0.jpg",
  "code": "const ChapterOverview = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const safeFps = fps || 30;\n\n  const props = item.props || {};\n\n  const bgColor = props.backgroundColor;\n  const cardColor = props.cardColor;\n  const cardBorderColor = props.cardBorderColor;\n  const iconBadgeColor = props.iconBadgeColor;\n  const subtitleColor = props.subtitleColor;\n  const labelColor = props.labelColor;\n  const labelFont = props.labelFont;\n  const subtitleFont = props.subtitleFont;\n\n  const cards = React.useMemo(() => [\n    { id: 1, label: props.part1Label, text: props.part1Text, icon: props.part1Icon },\n    { id: 2, label: props.part2Label, text: props.part2Text, icon: props.part2Icon },\n    { id: 3, label: props.part3Label, text: props.part3Text, icon: props.part3Icon },\n    { id: 4, label: props.part4Label, text: props.part4Text, icon: props.part4Icon }\n  ], [\n    props.part1Label, props.part1Text, props.part1Icon,\n    props.part2Label, props.part2Text, props.part2Icon,\n    props.part3Label, props.part3Text, props.part3Icon,\n    props.part4Label, props.part4Text, props.part4Icon\n  ]);\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    overflow: 'hidden'\n  };\n\n  const gridStyle = {\n    display: 'grid',\n    gridTemplateColumns: 'repeat(2, 820px)',\n    gridTemplateRows: 'repeat(2, 350px)',\n    gap: '28px 44px',\n  };\n\n  const cardBaseStyle = {\n    backgroundColor: cardColor,\n    border: `8px solid ${cardBorderColor}`,\n    borderRadius: '36px',\n    padding: '30px 40px 28px',\n    boxSizing: 'border-box',\n    display: 'flex',\n    flexDirection: 'column',\n    overflow: 'hidden',\n  };\n\n  const headerStyle = {\n    display: 'flex',\n    alignItems: 'center',\n    gap: '20px',\n    flexShrink: 0,\n    marginBottom: '18px',\n  };\n\n  const badgeStyle = {\n    width: '68px',\n    height: '68px',\n    background: `radial-gradient(circle at 38% 32%, #d7f1ff, ${iconBadgeColor})`,\n    borderRadius: '50%',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    flexShrink: 0,\n  };\n\n  const iconTextStyle = {\n    fontSize: '34px',\n    lineHeight: 1,\n    color: '#1a4041',\n    fontFamily: 'Nunito, system-ui, sans-serif',\n    fontWeight: 900,\n  };\n\n  const labelTextStyle = {\n    fontSize: '50px',\n    color: labelColor,\n    fontFamily: labelFont,\n    fontWeight: 700,\n    margin: 0,\n    lineHeight: 1,\n    letterSpacing: '-0.01em',\n  };\n\n  const subtitleTextStyle = {\n    fontSize: '48px',\n    color: subtitleColor,\n    fontFamily: subtitleFont,\n    fontWeight: 800,\n    lineHeight: 1.22,\n    whiteSpace: 'pre-wrap',\n    letterSpacing: '-0.01em',\n    flex: 1,\n    overflow: 'hidden',\n  };\n\n  // Stagger: 14 frames between each card (left→right, top→bottom)\n  // Slide from 120px below, with a longer spring so mid-state shows clear offset\n  const STAGGER = 14;\n  const SLIDE_DISTANCE = 120;\n\n  return (\n    <div style={rootStyle}>\n      <div style={gridStyle}>\n        {cards.map((c, index) => {\n          const delay = index * STAGGER;\n          const progress = spring({\n            frame: Math.max(0, frame - delay),\n            fps: safeFps,\n            config: { damping: 20, mass: 1.1, stiffness: 90 }\n          });\n          const yOffset = interpolate(progress, [0, 1], [SLIDE_DISTANCE, 0]);\n          const opacity = interpolate(progress, [0, 1], [0, 1]);\n\n          const iconContent = (index === 2 || index === 3)\n            ? <span style={iconTextStyle}>{index === 2 ? '?' : 'A'}</span>\n            : <span style={{ fontSize: '34px', lineHeight: 1 }}>{c.icon}</span>;\n\n          return (\n            <div\n              key={c.id}\n              style={{\n                ...cardBaseStyle,\n                opacity,\n                transform: `translateY(${yOffset}px)`,\n              }}\n            >\n              <div style={headerStyle}>\n                <div style={badgeStyle}>{iconContent}</div>\n                <div style={labelTextStyle}>{c.label}</div>\n              </div>\n              <div style={subtitleTextStyle}>{c.text}</div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
