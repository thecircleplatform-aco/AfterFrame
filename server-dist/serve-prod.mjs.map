  "thumb": "/thumbnails/3ce620cb-4199-45cc-984a-6cefe31727c2.jpg",
  "code": "const GroupProjectAnchor = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n  const props = item.props || {};\n\n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const textColor = props.textColor;\n  const accentColor = props.accentColor;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n\n  const parseHex = (hex) => {\n    if (!hex) return [0,0,0];\n    const h = hex.replace('#','');\n    return [parseInt(h.substring(0,2),16)||0, parseInt(h.substring(2,4),16)||0, parseInt(h.substring(4,6),16)||0];\n  };\n  const rgba = (hex, a) => { const [r,g,b] = parseHex(hex); return `rgba(${r},${g},${b},${a})`; };\n\n  const smoothSettle = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,3.5);\n  const bellCurveLate = (t) => t<=0?0:t>=1?1:t<0.4?0.15*Math.pow(t/0.4,2.5):0.15+0.85*(1-Math.pow(1-(t-0.4)/0.6,2.8));\n  const lineDraw = (t) => t<=0?0:t>=1?1:1-Math.pow(1-t,2.8);\n\n  const total = durationInFrames || 150;\n  const exitRaw = Math.max(0, Math.min(1, (frame-(total-25))/25));\n  const ex = 1 - exitRaw*exitRaw;\n\n  const anim = (delay, dur) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/dur)));\n  const fadeIn = (delay) => smoothSettle(Math.min(1, Math.max(0, (frame-delay)/15)));\n\n  // Liquid blobs (continuous motion)\n  const t = frame * 0.012;\n  const b1x = 960 + Math.sin(t)*300;\n  const b1y = 540 + Math.cos(t*1.2)*200;\n  const b2x = 960 + Math.sin(t*0.8+2)*400;\n  const b2y = 540 + Math.cos(t*1.1+1)*300;\n  const blobA = anim(0,40)*ex;\n\n  // Title (delay 8)\n  const ttA = fadeIn(8)*ex;\n  const ttY = (1-anim(8,50))*50;\n\n  // Subtitle (delay 20)\n  const stA = fadeIn(20)*ex;\n  const stY = (1-anim(20,35))*(-20);\n\n  // Body (delay 25)\n  const bdA = fadeIn(25)*ex;\n  const bdY = (1-anim(25,35))*30;\n\n  // Timeline horizontal (delay 15)\n  const tlW = lineDraw(Math.min(1, Math.max(0,(frame-15)/50)))*700;\n  const tlA = fadeIn(15)*ex;\n\n  // Nodes\n  const nd = [0,1,2,3].map(i => {\n    const d = 25+i*6;\n    return { a: fadeIn(d)*ex, s: anim(d,30) };\n  });\n\n  // Ring chart (delay 20)\n  const chRaw = Math.min(1, Math.max(0,(frame-20)/60));\n  const chP = bellCurveLate(chRaw);\n  const ringR = 90, ringC = 2*Math.PI*ringR;\n\n  const metrics = [{v:85,l:'85%'},{v:72,l:'72%'},{v:90,l:'90%'},{v:78,l:'78%'}];\n\n  // Name (delay 30)\n  const nmA = fadeIn(30)*ex;\n\n  return (\n    <div style={{position:'absolute',inset:0,backgroundColor:bgColor,overflow:'hidden',fontFamily:bodyFont}}>\n      {/* Liquid background blobs */}\n      <svg style={{position:'absolute',inset:0,width:'100%',height:'100%'}}>\n        <defs>\n          <filter id=\"gpBlur\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n            <feGaussianBlur stdDeviation=\"120\"/>\n          </filter>\n        </defs>\n        <g filter=\"url(#gpBlur)\">\n          <circle cx={b1x} cy={b1y} r=\"500\" fill={rgba(blobColor1,blobA*0.7)}/>\n          <circle cx={b2x} cy={b2y} r=\"450\" fill={rgba(blobColor2,blobA*0.6)}/>\n        </g>\n      </svg>\n\n      {/* Title (bottom left, bold italic) */}\n      <div style={{position:'absolute',left:100,bottom:200,width:900,transform:`translateY(${ttY}px)`}}>\n        <div style={{fontFamily:titleFont,fontSize:80,fontWeight:800,fontStyle:'italic',color:rgba(textColor,ttA),lineHeight:1.15}}>\n          Group Project Strategies\n        </div>\n      </div>\n\n      {/* Subtitle (top right) */}\n      <div style={{position:'absolute',right:100,top:80,width:400,textAlign:'right',transform:`translateY(${stY}px)`}}>\n        <div style={{fontSize:28,color:rgba(textColor,stA*0.8),lineHeight:1.4}}>\n          Here is where your presentation begins\n        </div>\n      </div>\n\n      {/* Body text */}\n      <div style={{position:'absolute',left:100,top:450,width:600,transform:`translateY(${bdY}px)`}}>\n        <div style={{fontSize:28,color:rgba(textColor,bdA*0.85),lineHeight:1.5}}>\n          Diverse perspectives create breakthrough solutions.\n        </div>\n      </div>\n\n      {/* Timeline (bottom) */}\n      <div style={{position:'absolute',left:100,bottom:100,width:750,height:60}}>\n        <div style={{position:'absolute',left:0,top:8,width:tlW,height:2,backgroundColor:rgba(accentColor,tlA*0.4)}}/>\n        {['Phase 1','Phase 2','Phase 3','Phase 4'].map((p,i) => (\n          <div key={i} style={{position:'absolute',left:i*200,top:0}}>\n            <div style={{width:6,height:6,borderRadius:'50%',backgroundColor:rgba(accentColor,nd[i].a),transform:`scale(${nd[i].s})`}}/>\n            <div style={{fontSize:14,color:rgba(textColor,nd[i].a*0.7),marginTop:14,letterSpacing:'0.05em'}}>{p}</div>\n          </div>\n        ))}\n      </div>\n\n      {/* Progress rings (right side) */}\n      <div style={{position:'absolute',right:80,top:200,display:'flex',flexDirection:'column',gap:20}}>\n        {metrics.map((m,i) => {\n          const mA = fadeIn(20+i*8)*ex;\n          const prog = chP * m.v / 100;\n          const dash = `${prog*ringC} ${ringC}`;\n          return (\n            <div key={i} style={{display:'flex',alignItems:'center',gap:16}}>\n              <svg width={50} height={50} style={{transform:'rotate(-90deg)'}}>\n                <circle cx={25} cy={25} r={20} fill=\"none\" stroke={rgba(accentColor,mA*0.15)} strokeWidth={5}/>\n                <circle cx={25} cy={25} r={20} fill=\"none\" stroke={rgba(accentColor,mA)} strokeWidth={5} strokeDasharray={`${prog*125.6} 125.6`} strokeLinecap=\"round\"/>\n              </svg>\n              <div style={{fontSize:22,fontWeight:700,color:rgba(textColor,mA)}}>{m.l}</div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Team circles */}\n      <div style={{position:'absolute',right:80,bottom:160,display:'flex',gap:24}}>\n        {[0,1,2].map(i => {\n          const cA = fadeIn(32+i*6)*ex;\n          return <div key={i} style={{width:60,height:60,borderRadius:'50%',border:`2px solid ${rgba(accentColor,cA*0.5)}`,backgroundColor:rgba(accentColor,cA*0.08)}}/>;\n        })}\n      </div>\n\n      {/* Name tag */}\n      <div style={{position:'absolute',left:100,top:350}}>\n        <div style={{fontSize:20,fontWeight:500,color:rgba(textColor,nmA),borderLeft:`3px solid ${rgba(accentColor,nmA)}`,paddingLeft:12}}>\n          Alex Rivera — Project Lead\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
