    "label": "Transparent Background"
   }
  ],
  "thumb": "/thumbnails/a75ac7ba-db04-4266-93b9-9ebd0614dc06.jpg",
  "code": "const MarkerHighlightGraphic = ({item}) => {\n  const frame = useCurrentFrame();\n  const { durationInFrames } = useVideoConfig();\n  const props = item.props || {};\n  const bgImage = props.bgImage;\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const line3Text = props.line3Text;\n  const highlightColor = props.highlightColor;\n  const textColor = props.textColor;\n  const fontFamily = props.fontFamily;\n  const transparentBackground = props.transparentBackground === true || props.transparentBackground === 'true';\n  const highlightPad = parseFloat(props.highlightPad) || 0;\n  const lineSpacing = parseFloat(props.lineSpacing) || 148;\n  const ruleWidth = parseFloat(props.ruleWidth) || 10;\n  const marginWidth = parseFloat(props.marginWidth) || 6;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const baseScale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const zoom = interpolate(frame, [0, durationInFrames - 1], [1.0, 1.05], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const totalScale = baseScale * zoom;\n  const offsetX = (DESIGN_WIDTH * (1 - zoom)) / 2;\n  const offsetY = (DESIGN_HEIGHT * (1 - zoom)) / 2;\n\n  const getSweep = (start) => {\n    const dd = 22;\n    const hd = 42;\n    const ed = 22;\n    const t = frame - start;\n    if (t < 0) return { left: 0, width: 0 };\n    const drawRight = interpolate(t, [0, dd], [0, 100], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.cubic) });\n    const eraseLeft = interpolate(t - dd - hd, [0, ed], [0, 100], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.in(Easing.cubic) });\n    return { left: Math.max(0, eraseLeft), width: Math.max(0, drawRight - eraseLeft) };\n  };\n\n  const s1 = getSweep(15);\n  const s2 = getSweep(105);\n  const s3 = getSweep(195);\n\n  const show = !transparentBackground;\n  const edgeGrad = 'linear-gradient(to bottom, rgba(255,255,255,0.58) 0%, rgba(255,255,255,0.0) 30%, rgba(255,255,255,0.0) 70%, rgba(255,255,255,0.58) 100%)';\n\n  const FS = 100;\n  const BASELINE_OFFSET = 80;\n  const LH = lineSpacing;\n  const lineY1 = 432;\n  const lineY2 = lineY1 + LH;\n  const lineY3 = lineY1 + LH * 2;\n  const top1 = lineY1 - BASELINE_OFFSET;\n  const top2 = lineY2 - BASELINE_OFFSET;\n  const top3 = lineY3 - BASELINE_OFFSET;\n\n  const hlTopPx = (-highlightPad) + 'px';\n  const hlBotPx = (-highlightPad) + 'px';\n\n  // translate3d before scale — forces GPU compositing layer, avoids per-frame rasterization\n  const transformStr = 'translate3d(' + offsetX + 'px,' + offsetY + 'px,0) scale(' + totalScale + ')';\n  const rootSt = { position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: transformStr, transformOrigin: 'top left', willChange: 'transform', overflow: 'hidden', backgroundColor: '#f4f0e6' };\n  const bgSt   = { position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'center 20%', willChange: 'transform' };\n\n  const mkRow = (top) => ({ position: 'absolute', left: 210, right: 60, top: top, display: 'flex', alignItems: 'baseline', fontSize: FS + 'px', fontFamily: fontFamily, fontWeight: '900', color: textColor });\n  const row1St = mkRow(top1);\n  const row2St = mkRow(top2);\n  const row3St = mkRow(top3);\n\n  const bullSt = { fontSize: FS + 'px', lineHeight: '1', fontFamily: fontFamily, fontWeight: '900', marginRight: '28px', opacity: 0.75, flexShrink: 0 };\n  const wrapSt = { position: 'relative', display: 'inline-block', lineHeight: '1' };\n  const txtSt  = { position: 'relative', zIndex: 2, letterSpacing: '-0.02em', whiteSpace: 'nowrap', lineHeight: '1' };\n\n  const mkColor = (sw) => ({ position: 'absolute', top: hlTopPx, bottom: hlBotPx, left: sw.left + '%', width: sw.width + '%', backgroundColor: highlightColor, mixBlendMode: 'multiply', zIndex: 0 });\n  const mkEdge  = (sw) => ({ position: 'absolute', top: hlTopPx, bottom: hlBotPx, left: sw.left + '%', width: sw.width + '%', background: edgeGrad, zIndex: 1, pointerEvents: 'none' });\n  const hl1c = mkColor(s1); const hl1e = mkEdge(s1);\n  const hl2c = mkColor(s2); const hl2e = mkEdge(s2);\n  const hl3c = mkColor(s3); const hl3e = mkEdge(s3);\n\n  const rc = 'rgba(131,157,84,0.28)';\n  const rl = (t) => ({position:'absolute',left:0,right:0,top:t,height:ruleWidth,backgroundColor:rc});\n  const rl0=rl(lineY1-LH*3); const rl1=rl(lineY1-LH*2); const rl2=rl(lineY1-LH);\n  const rl3=rl(lineY1);      const rl4=rl(lineY2);       const rl5=rl(lineY3);\n  const rl6=rl(lineY3+LH);   const rl7=rl(lineY3+LH*2); const rl8=rl(lineY3+LH*3);\n  const marginSt = {position:'absolute',left:152,top:0,bottom:0,width:marginWidth,backgroundColor:'rgba(0,132,133,0.55)'};\n\n  return (\n    <div style={rootSt}>\n      {bgImage && <Img src={bgImage} style={bgSt} />}\n      {show && <div style={rl0}/>}{show && <div style={rl1}/>}{show && <div style={rl2}/>}\n      {show && <div style={rl3}/>}{show && <div style={rl4}/>}{show && <div style={rl5}/>}\n      {show && <div style={rl6}/>}{show && <div style={rl7}/>}{show && <div style={rl8}/>}\n      {show && <div style={marginSt}/>}\n      <div style={row1St}><span style={bullSt}>*</span><div style={wrapSt}><div style={hl1c}/><div style={hl1e}/><span style={txtSt}>{line1Text}</span></div></div>\n      <div style={row2St}><span style={bullSt}>*</span><div style={wrapSt}><div style={hl2c}/><div style={hl2e}/><span style={txtSt}>{line2Text}</span></div></div>\n      <div style={row3St}><span style={bullSt}>*</span><div style={wrapSt}><div style={hl3c}/><div style={hl3e}/><span style={txtSt}>{line3Text}</span></div></div>\n    </div>\n  );\n};"
 },
 {
