((n>>16)&255)/255,((n>>8)&255)/255,(n&255)/255]; };\n    gl.useProgram(prog); gl.bindBuffer(gl.ARRAY_BUFFER, buf);\n    const pLoc = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(pLoc); gl.vertexAttribPointer(pLoc, 2, gl.FLOAT, false, 0, 0);\n    gl.viewport(0, 0, DESIGN_WIDTH, DESIGN_HEIGHT);\n    gl.uniform2f(gl.getUniformLocation(prog,'res'), DESIGN_WIDTH, DESIGN_HEIGHT);\n    gl.uniform1f(gl.getUniformLocation(prog,'time'), frame / safeFps);\n    gl.uniform3fv(gl.getUniformLocation(prog,'c1'), hex2rgb(primaryColor));\n    gl.uniform3fv(gl.getUniformLocation(prog,'c2'), hex2rgb(accentColor));\n    gl.uniform3fv(gl.getUniformLocation(prog,'c3'), hex2rgb(bloomColor));\n    gl.drawArrays(gl.TRIANGLES, 0, 6);\n  }, [frame, primaryColor, accentColor, bloomColor, safeFps]);\n  const labelSpr = spring({ frame: Math.max(0, frame-12), fps: safeFps, config: { damping:15, mass:0.8, stiffness:100 } });\n  const ruleSpr = spring({ frame: Math.max(0, frame-21), fps: safeFps, config: { damping:20, mass:1, stiffness:80 } });\n  const titleSpr = spring({ frame: Math.max(0, frame-27), fps: safeFps, config: { damping:15, mass:0.8, stiffness:100 } });\n  const labelOpacity = interpolate(frame, [12,20], [0,1], { extrapolateLeft:'clamp', extrapolateRight:'clamp' });\n  const titleOpacity = interpolate(frame, [27,35], [0,1], { extrapolateLeft:'clamp', extrapolateRight:'clamp' });\n  const labelY = interpolate(labelSpr, [0,1], [30,0]);\n  const titleY = interpolate(titleSpr, [0,1], [42,0]);\n  const breath = 1 + 0.010 * Math.sin(t * Math.PI * 0.30);\n  const numX = 1455 + 5 * Math.sin(t * 0.23);\n  const numY = 1158 + 5 * Math.cos(t * 0.19);\n  const numSize = 1895;\n  const NUM_FONT = \"system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif\";\n  const TEXT_FONT = \"'DM Sans',system-ui,-apple-system,sans-serif\";\n  const GlowBlob = ({ style, item }) => <div style={{ position:'absolute', borderRadius:'50%', filter:'blur(76px)', mixBlendMode:'lighten', pointerEvents:'no