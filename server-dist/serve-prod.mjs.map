    "defaultValue": "#eff3ff",
    "label": "Text Color"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Impact, system-ui, sans-serif",
    "label": "Font"
   }
  ],
  "thumb": "/thumbnails/d490ac7f-2e06-469d-ab59-0584094ac5da.jpg",
  "code": "const KineticTextOverlay = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const line1Text = props.line1Text;\n  const line2Text = props.line2Text;\n  const primaryColor = props.primaryColor;\n  const fontFamily = props.fontFamily;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const line1Chars = (line1Text || '').split('');\n  const line2Chars = (line2Text || '').split('');\n\n  const CHAR_INTERVAL = 3;\n  const LINE1_START = 3;\n  const LINE2_START = LINE1_START + line1Chars.length * CHAR_INTERVAL + 8;\n\n  const exitDuration = 14;\n  const exitStart = Math.max(0, durationInFrames - exitDuration - 4);\n  const exitProgress = interpolate(frame, [exitStart, exitStart + exitDuration], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n    easing: Easing.in(Easing.cubic),\n  });\n\n  const exitX1 = interpolate(exitProgress, [0, 1], [0, -2200]);\n  const exitBlur1 = interpolate(exitProgress, [0, 1], [0, 28]);\n  const exitOpacity1 = interpolate(exitProgress, [0, 0.75, 1], [1, 0.6, 0]);\n\n  const exitX2 = interpolate(exitProgress, [0, 1], [0, 2200]);\n  const exitBlur2 = interpolate(exitProgress, [0, 1], [0, 28]);\n  const exitOpacity2 = interpolate(exitProgress, [0, 0.75, 1], [1, 0.6, 0]);\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      backgroundColor: 'transparent', overflow: 'hidden',\n    }}>\n\n      {/* LINE 1 — upper half center */}\n      <div style={{\n        position: 'absolute',\n        top: 0,\n        left: 0,\n        width: '100%',\n        height: '50%',\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'center',\n        transform: `translateX(${exitX1}px)`,\n        filter: `blur(${exitBlur1}px)`,\n        opacity: exitOpacity1,\n      }}>\n        <div style={{ display: 'flex', flexWrap: 'nowrap', alignItems: 'baseline' }}>\n          {line1Chars.map((char, i) => {\n            const visible = frame >= LINE1_START + i * CHAR_INTERVAL;\n            return (\n              <span key={i} style={{\n                fontFamily,\n                fontSize: '195px',\n                fontWeight: 900,\n                color: primaryColor,\n                lineHeight: 1,\n                textTransform: 'uppercase',\n                whiteSpace: 'pre',\n                opacity: visible ? 1 : 0,\n                display: 'inline-block',\n                width: char === ' ' ? '60px' : 'auto',\n              }}>\n                {char === ' ' ? '\\u00A0' : char}\n              </span>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* LINE 2 — lower half center */}\n      <div style={{\n        position: 'absolute',\n        top: '50%',\n        left: 0,\n        width: '100%',\n        height: '50%',\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'center',\n        transform: `translateX(${exitX2}px)`,\n        filter: `blur(${exitBlur2}px)`,\n        opacity: exitOpacity2,\n      }}>\n        <div style={{ display: 'flex', flexWrap: 'nowrap', alignItems: 'baseline' }}>\n          {line2Chars.map((char, i) => {\n            const visible = frame >= LINE2_START + i * CHAR_INTERVAL;\n            return (\n              <span key={i} style={{\n                fontFamily,\n                fontSize: '340px',\n                fontWeight: 900,\n                color: primaryColor,\n                lineHeight: 1,\n                textTransform: 'uppercase',\n                whiteSpace: 'pre',\n                opacity: visible ? 1 : 0,\n                display: 'inline-block',\n                width: char === ' ' ? '80px' : 'auto',\n              }}>\n                {char === ' ' ? '\\u00A0' : char}\n              </span>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );\n};"
 },
 {
  "id": "64a9ecbd-cf02-434f-8a36-f2567d061b18",
  "name": "MindSpace — Number Counter",
  "category": "uncategorized",
  "description": "Two 3D gradient spheres pop in and float smoothly in the background while a large bold central number increments via a staggered slot-machine roll animation.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "targetNumber": "21",
   "prefix": "",
   "sphereCenterColor": "#b47900",
   "sphereEdgeColor": "#542700",
   "textColor": "#FFFFFF",
   "fontFamily": "DM Sans",
   "backgroundColor": "#020616",
   "transparentBackground": true
  },
  "propSchema": [
   {
    "key": "targetNumber",
