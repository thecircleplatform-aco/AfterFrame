52%', pointerEvents:'none' }}>\n        <defs>\n          <linearGradient id=\"numFill3\" x1=\"28%\" y1=\"8%\" x2=\"86%\" y2=\"92%\"><stop offset=\"0%\" stopColor=\"rgba(255,255,255,0.04)\" /><stop offset=\"20%\" stopColor=\"rgba(142,237,235,0.16)\" /><stop offset=\"46%\" stopColor=\"rgba(0,184,183,0.30)\" /><stop offset=\"72%\" stopColor=\"rgba(0,134,98,0.32)\" /><stop offset=\"100%\" stopColor=\"rgba(0,62,44,0.16)\" /></linearGradient>\n          <linearGradient id=\"rimGrad3\" x1=\"16%\" y1=\"4%\" x2=\"88%\" y2=\"92%\"><stop offset=\"0%\" stopColor=\"rgba(255,255,255,0.22)\" /><stop offset=\"50%\" stopColor=\"rgba(0,209,208,0.14)\" /><stop offset=\"100%\" stopColor=\"rgba(255,255,255,0.05)\" /></linearGradient>\n          <filter id=\"hBlur40_3\" x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\"><feGaussianBlur stdDeviation=\"42\" /></filter>\n          <filter id=\"rimSoft3\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\"><feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"2.4\" result=\"s\" /><feMerge><feMergeNode in=\"s\" /><feMergeNode in=\"SourceGraphic\" /></feMerge></filter>\n          <clipPath id=\"numClip3\"><text x={numX} y={numY} fontSize={numSize} fontFamily={NUM_FONT} fontWeight=\"900\" textAnchor=\"middle\">{chapterNumber}</text></clipPath>\n        </defs>\n        <text x={numX-34} y={numY-15} fontSize={numSize} fontFamily={NUM_FONT} fontWeight=\"900\" fill=\"none\" stroke=\"rgba(255,255,255,0.042)\" strokeWidth=\"2.8\" textAnchor=\"middle\" filter=\"url(#rimSoft3)\">{chapterNumber}</text>\n        <g clipPath=\"url(#numClip3)\" opacity=\"0.95\">\n          <rect x=\"0\" y=\"0\" width={DESIGN_WIDTH} height={DESIGN_HEIGHT} fill=\"url(#numFill3)\" opacity=\"0.80\" />\n          <ellipse cx=\"1500\" cy=\"100\" rx=\"145\" ry=\"75\" fill=\"rgba(97,235,233,0.58)\" filter=\"url(#hBlur40_3)\" />\n          <ellipse cx=\"1400\" cy=\"255\" rx=\"175\" ry=\"130\" fill=\"rgba(0,200,199,0.42)\" filter=\"url(#hBlur40_3)\" />\n          <ellipse cx=\"1185\" cy=\"510\" rx=\"130\" ry=\"85\" fill=\"rgba(0,174,162,0.28)\" filter=\"url(#hBlur40_3)\" />\n          <ellipse cx=\"1405\" cy=\"750\" rx=\"175\" ry=\"130\" fill=\"rgba(0,144,105,0.34)\" filter=\"url(#hBlur40_3)\" />\n          <ellipse cx=\"1500\" cy=\"935\" rx=\"145\" ry=\"72\" fill=\"rgba(0,97,70,0.28)\" filter=\"url(#hBlur40_3)\" />\n        </g>\n        <text x={numX} y={numY} fontSize={numSize} fontFamily={NUM_FONT} fontWeight=\"900\" fill=\"none\" stroke=\"url(#rimGrad3)\" strokeWidth=\"6\" textAnchor=\"middle\" opacity=\"0.50\" filter=\"url(#rimSoft3)\">{chapterNumber}</text>\n        <text x={numX} y={numY} fontSize={numSize} fontFamily={NUM_FONT} fontWeight=\"900\" fill=\"none\" stroke=\"rgba(255,255,255,0.15)\" strokeWidth=\"1.2\" textAnchor=\"middle\" opacity=\"0.88\">{chapterNumber}</text>\n        <text x={numX-9} y={numY-9} fontSize={numSize} fontFamily={NUM_FONT} fontWeight=\"900\" fill=\"none\" stroke=\"rgba(255,255,255,0.07)\" strokeWidth=\"1.0\" textAnchor=\"middle\">{chapterNumber}</text>\n      </svg>\n      <div style={{ position:'absolute', left:-200, bottom:-200, width:1020, height:800, borderRadius:'50%', background:'radial-gradient(circle, rgba(0,4,2,0.97) 0%, rgba(0,7,3,0.84) 34%, rgba(0,7,3,0.32) 68%, rgba(0,7,3,0) 100%)', filter:'blur(20px)', pointerEvents:'none' }} />\n      <div style={{ position:'absolute', left:-220, top:230, width:820, height:720, borderRadius:'50%', background:'radial-gradient(circle, rgba(0,0,0,0.52) 0%, rgba(0,0,0,0.20) 52%, rgba(0,0,0,0) 78%)', filter:'blur(48px)', pointerEvents:'none' }} />\n      <div style={{ position:'absolute', left:136, bottom:118, display:'flex', flexDirection:'column', alignItems:'flex-start' }}>\n        <div style={{ opacity:labelOpacity, transform:`translateY(${labelY}px)`, fontSize:60, fontWeight:300, color:'rgba(255,255,255,0.95)', letterSpacing:'-0.04em', fontFamily:TEXT_FONT, lineHeight:1 }}>{chapterLabel}</div>\n        <div style={{ marginTop:26, marginBottom:26, width:`${ruleSpr*410}px`, height:6, background:'linear-gradient(90deg, rgba(207,241,240,1), rgba(207,241,240,0.78))', boxShadow:'0 0 12px rgba(191,237,236,0.24)' }} />\n        <div style={{ opacity:titleOpacity, transform:`translateY(${titleY}px)`, fontSize:100, fontWeight:700, color:'#ffffff', letterSpacing:'-0.045em', fontFamily:TEXT_FONT, lineHeight:0.96, textShadow:'0 8px 28px rgba(0,0,0,0.22)' }}>{titleText}</div>\n      </div>\n      <div style={{ position:'absolute', top:16, left:16, right:16, bottom:16, border:'3px solid rgba(255,255,255,0.88)', boxShadow:'inset 0 0 18px rgba(255,255,255,0.06)', pointerEvents:'none' }} />\n    </div>\n  );\n};"
 },
 {
  "id": "366dffd3-b6f4-4e47-a05c-37921e5b2852",
