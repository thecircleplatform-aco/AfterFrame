    "defaultValue": "rgba(255, 255, 255, 0.2)",
    "label": "Target Bar Color"
   },
   {
    "key": "gridColor",
    "type": "color",
    "defaultValue": "rgba(255, 255, 255, 0.1)",
    "label": "Grid Lines Color"
   },
   {
    "key": "textColor",
    "type": "color",
