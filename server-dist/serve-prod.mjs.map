  "thumb": "/thumbnails/f9b5adcd-fc88-4f3b-b4f2-c74befe1317e.jpg",
  "code": "const DonutChartInfographic = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  // --- Editable Properties ---\n  const props = item.props || {};\n  const titleText = props.titleText || 'Client Acquisition Breakdown';\n  const centerText = props.centerText || 'Client Source';\n  const subTitleText = props.subTitleText || 'Client Acquisition Breakdown';\n  const bgColor = props.bgColor || '#00292d';\n  const accentColor = props.accentColor || '#ffffff';\n  const titleFont = props.titleFont || 'Noto Sans SC, sans-serif';\n\n  // Data definition with fallbacks\n  const rawData = [\n    {\n      label: props.label1 || 'Search Engine',\n      value: parseFloat(props.val1 || '42'),\n      c1: props.color1Start || '#18d7d5',\n      c2: props.color1End || '#00bab9'\n    },\n    {\n      label: props.label2 || 'Social Media',\n      value: parseFloat(props.val2 || '25'),\n      c1: props.color2Start || '#57c15d',\n      c2: props.color2End || '#009656'\n    },\n    {\n      label: props.label3 || 'Walk-In',\n      value: parseFloat(props.val3 || '18'),\n      c1: props.color3Start || '#c49c00',\n      c2: props.color3End || '#886b00'\n    },\n    {\n      label: props.label4 || 'Referral',\n      value: parseFloat(props.val4 || '10'),\n      c1: props.color4Start || '#53d3a5',\n      c2: props.color4End || '#339472'\n    },\n    {\n      label: props.label5 || 'Newsletter',\n      value: parseFloat(props.val5 || '5'),\n      c1: props.color5Start || '#57baff',\n      c2: props.color5End || '#009cc9'\n    }\n  ];\n\n  // Filter out zero/negative values to avoid drawing errors\n  const data = rawData.filter(d => d.value > 0);\n  const totalValue = data.reduce((acc, cur) => acc + cur.value, 0);\n\n  // --- Layout Constants ---\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const cx = DESIGN_WIDTH / 2;\n  const cy = DESIGN_HEIGHT / 2 + 50;\n  const outerRadius = 320;\n  const innerRadius = 180;\n  const labelRadius = outerRadius + 60;\n\n  // --- Animation ---\n  // Main chart sweep\n  const chartEntrance = spring({\n    frame,\n    fps,\n    config: { damping: 20, stiffness: 90, mass: 1 }\n  });\n\n  // Labels fade in after chart starts settling\n  const labelsEntrance = spring({\n    frame: Math.max(0, frame - 25),\n    fps,\n    config: { damping: 20 }\n  });\n\n  // --- Geometry Helpers ---\n  const polarToCartesian = (centerX, centerY, radius, angleInDegrees) => {\n    const angleInRadians = ((angleInDegrees - 90) * Math.PI) / 180.0;\n    return {\n      x: centerX + radius * Math.cos(angleInRadians),\n      y: centerY + radius * Math.sin(angleInRadians),\n    };\n  };\n\n  const describeArc = (x, y, innerR, outerR, startAngle, endAngle) => {\n    // Avoid 360 collision which causes drawing glitches in some engines\n    const isFullCircle = endAngle - startAngle >= 359.9;\n    const safeEndAngle = isFullCircle ? startAngle + 359.99 : endAngle;\n\n    const startOuter = polarToCartesian(x, y, outerR, startAngle);\n    const endOuter = polarToCartesian(x, y, outerR, safeEndAngle);\n    const startInner = polarToCartesian(x, y, innerR, startAngle);\n    const endInner = polarToCartesian(x, y, innerR, safeEndAngle);\n\n    const largeArcFlag = safeEndAngle - startAngle <= 180 ? '0' : '1';\n\n    return [\n      'M', startOuter.x, startOuter.y,\n      'A', outerR, outerR, 0, largeArcFlag, 1, endOuter.x, endOuter.y,\n      'L', endInner.x, endInner.y,\n      'A', innerR, innerR, 0, largeArcFlag, 0, startInner.x, startInner.y,\n      'Z'\n    ].join(' ');\n  };\n\n  // --- Calculate Slices ---\n  let cumulativeAngle = 0;\n  const slices = data.map((slice, i) => {\n    const percentage = slice.value / totalValue;\n    const angleSize = percentage * 360;\n    \n    // Animate the sweep: The total chart unfolds from 0 to 360 based on chartEntrance\n    // But also each slice grows. \n    // \"Fan out\" effect: multiply all angles by progress\n    const currentTotalAngle = 360 * chartEntrance;\n    const startAngle = cumulativeAngle * chartEntrance;\n    const endAngle = (cumulativeAngle + angleSize) * chartEntrance;\n    \n    const midAngle = startAngle + (endAngle - startAngle) / 2;\n    cumulativeAngle += angleSize;\n\n    return {\n      ...slice,\n      startAngle,\n      endAngle,\n      midAngle,\n      percentage,\n      index: i\n    };\n  });\n\n  // --- Render ---\n  const rootStyle = {\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: bgColor,\n    fontFamily: titleFont,\n    color: 'white',\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    overflow: 'hidden',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n  };\n\n  const titleStyle = {\n    position: 'absolute',\n    top: 80,\n    left: 100,\n    zIndex: 10,\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Gradient Effect */}\n      <div style={{\n        position: 'absolute',\n        width: '100%', height: '100%',\n        background: 'radial-gradient(circle at 50% 50%, rgba(255,255,255,0.03) 0%, rgba(0,0,0,0) 60%)'\n      }} />\n\n      {/* Title Block */}\n      <div style={titleStyle}>\n        <h1 style={{\n          margin: 0,\n          fontSize: '64px',\n          fontWeight: 700,\n          letterSpacing: '-0.02em',\n          opacity: Math.min(1, frame / 30),\n          transform: `translateY(${(1 - Math.min(1, frame/30)) * 20}px)`\n        }}>\n          {titleText}\n        </h1>\n        <p style={{\n          margin: '10px 0 0 0',\n          fontSize: '28px',\n          color: 'rgba(255,255,255,0.6)',\n          fontWeight: 400,\n          opacity: Math.min(1, Math.max(0, frame - 10) / 30),\n          transform: `translateY(${(1 - Math.min(1, Math.max(0, frame - 10)/30)) * 20}px)`\n        }}>\n          {subTitleText}\n        </p>\n      </div>\n\n      {/* Chart Container */}\n      <svg \n        width={DESIGN_WIDTH} \n        height={DESIGN_HEIGHT} \n        viewBox={`0 0 ${DESIGN_WIDTH} ${DESIGN_HEIGHT}`}\n        style={{ position: 'absolute', top: 0, left: 0 }}\n      >\n        <defs>\n          {data.map((slice, i) => (\n            <linearGradient \n              key={`grad-${i}`} \n              id={`grad-${i}`} \n              x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"\n            >\n              <stop offset=\"0%\" stopColor={slice.c1} />\n              <stop offset=\"100%\" stopColor={slice.c2} />\n            </linearGradient>\n          ))}\n          {/* Shadow filter for depth */}\n          <filter id=\"dropShadow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"4\" />\n            <feOffset dx=\"2\" dy=\"4\" result=\"offsetblur\" />\n            <feComponentTransfer>\n              <feFuncA type=\"linear\" slope=\"0.3\" />\n            </feComponentTransfer>\n            <feMerge>\n              <feMergeNode />\n              <feMergeNode in=\"SourceGraphic\" />\n            </feMerge>\n          </filter>\n        </defs>\n\n        {/* Donut Slices */}\n        <g filter=\"url(#dropShadow)\">\n          {slices.map((slice, i) => (\n            <path\n              key={`slice-${i}`}\n              d={describeArc(cx, cy, innerRadius, outerRadius, slice.startAngle, slice.endAngle)}\n              fill={`url(#grad-${i})`}\n              stroke={bgColor}\n              strokeWidth=\"4\"\n            />\n          ))}\n        </g>\n\n        {/* Labels & Connectors */}\n        {slices.map((slice, i) => {\n          // Only show labels if slice is large enough and animation is ready\n          if (slice.percentage < 0.02) return null;\n\n          const normalizedAngle = (slice.midAngle % 360 + 360) % 360;\n          const isRightSide = normalizedAngle < 180;\n          \n          // Calculate connector points\n          // Start at edge of donut\n          const p1 = polarToCartesian(cx, cy, outerRadius, slice.midAngle);\n          // Elbow point\n          const p2 = polarToCartesian(cx, cy, labelRadius, slice.midAngle);\n          // Text anchor point (push out horizontally)\n          const p3 = {\n            x: isRightSide ? p2.x + 80 : p2.x - 80,\n            y: p2.y\n          };\n\n          return (\n            <g \n              key={`label-${i}`} \n              style={{ opacity: labelsEntrance }}\n            >\n              {/* Connector Polyline */}\n              <polyline\n                points={`${p1.x},${p1.y} ${p2.x},${p2.y} ${p3.x},${p3.y}`}\n                fill=\"none\"\n                stroke=\"rgba(255,255,255,0.4)\"\n                strokeWidth=\"2\"\n              />\n              {/* Dot at start */}\n              <circle cx={p1.x} cy={p1.y} r=\"4\" fill={slice.c2} />\n              \n              {/* Text Group */}\n              <g transform={`translate(${p3.x + (isRightSide ? 10 : -10)}, ${p3.y})`}>\n                <text\n                  x={0}\n                  y={-5}\n                  textAnchor={isRightSide ? 'start' : 'end'}\n                  fill=\"white\"\n                  fontSize=\"24\"\n                  fontWeight=\"bold\"\n                  fontFamily={titleFont}\n                  alignmentBaseline=\"baseline\"\n                >\n                  {slice.label}\n                </text>\n                <text\n                  x={0}\n                  y={22}\n                  textAnchor={isRightSide ? 'start' : 'end'}\n                  fill={slice.c1}\n                  fontSize=\"32\"\n                  fontWeight=\"bold\"\n                  fontFamily=\"'IBM Plex Mono', monospace\"\n                  alignmentBaseline=\"baseline\"\n                >\n                  {Math.round(slice.value / totalValue * 100)}%\n                </text>\n              </g>\n            </g>\n          );\n        })}\n      </svg>\n\n      {/* Center Content */}\n      <div style={{\n        position: 'absolute',\n        left: cx - innerRadius + 20,\n        top: cy - innerRadius + 20,\n        width: (innerRadius - 20) * 2,\n        height: (innerRadius - 20) * 2,\n        display: 'flex',\n        flexDirection: 'column',\n        justifyContent: 'center',\n        alignItems: 'center',\n        borderRadius: '50%',\n        textAlign: 'center',\n        opacity: labelsEntrance,\n        transform: `scale(${labelsEntrance})`\n      }}>\n         <div style={{ \n           fontSize: '20px', \n           color: 'rgba(255,255,255,0.6)', \n           marginBottom: '10px',\n           textTransform: 'uppercase',\n           letterSpacing: '0.1em'\n         }}>\n           Total\n         </div>\n         <div style={{ \n           fontSize: '42px', \n           fontWeight: 800, \n           color: '#ffffff' \n         }}>\n           {centerText}\n         </div>\n      </div>\n    </div>\n  );\n};"
 },
