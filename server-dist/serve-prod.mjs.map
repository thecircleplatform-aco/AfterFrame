  ],
  "thumb": "/thumbnails/c480c5c8-9812-49ab-a04b-1dfef0405aa8.jpg",
  "code": "const SmartTitles = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  \n  // Props\n  const props = item.props || {};\n  const titleText = props.titleText || 'NEW EPISODE';\n  const subtitleText = props.subtitleText || 'STREAMING ON SPOTIFY';\n  const marqueeText = props.marqueeText || 'NEW EPISODE DROPPED •';\n  const accentColor = props.accentColor || '#ff69b4';\n  const primaryColor = props.primaryColor || '#000000';\n  const backgroundColor = props.backgroundColor || '#FFFFFF';\n  const fontFamily = props.fontFamily || '\"Press Start 2P\", cursive';\n\n  // Dimensions\n  const DESIGN_WIDTH = 820;\n  const DESIGN_HEIGHT = 220;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Card Spec\n  const CARD_WIDTH = 700;\n  const CARD_HEIGHT = 160;\n  const BORDER_WIDTH = 2;\n\n  // Animation: Entrance Spring (Bouncier)\n  const entrance = spring({\n    frame,\n    fps,\n    config: { damping: 12, stiffness: 120, mass: 1.2 }\n  });\n\n  // Entrance Y: start below canvas, end at center\n  // Centering Y: (220 - 160) / 2 = 30px from top. \n  // But we have shadow offsets (+12px), so we shift slightly up to optical center.\n  const targetY = 20; \n  const startY = 300;\n  const currentY = interpolate(entrance, [0, 1], [startY, targetY]);\n\n  // Animation: Text Reveal (After card lands)\n  const textOpacity = interpolate(frame, [15, 25], [0, 1], { extrapolateRight: 'clamp' });\n  const textY = interpolate(frame, [15, 25], [10, 0], { extrapolateRight: 'clamp' });\n\n  // Animation: Marquee Scroll\n  // Continuous scroll right-to-left\n  const scrollSpeed = 2;\n  const scrollOffset = (frame * scrollSpeed);\n\n  // Animation: Pulse Line\n  const pulse = (Math.sin(frame / 5) + 1) / 2; // 0 to 1 oscillating\n  const pulseOpacity = interpolate(pulse, [0, 1], [0.3, 1]);\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    justifyContent: 'center',\n    fontFamily: fontFamily,\n    backgroundColor: 'transparent',\n  };\n\n  const wrapperStyle = {\n    position: 'relative',\n    width: CARD_WIDTH,\n    height: CARD_HEIGHT,\n    marginTop: currentY, // Animate position\n  };\n\n  const commonCardStyle = {\n    position: 'absolute',\n    width: '100%',\n    height: '100%',\n    border: `${BORDER_WIDTH}px solid ${primaryColor}`,\n    backgroundColor: backgroundColor,\n    boxSizing: 'border-box',\n  };\n\n  // Offset shadows\n  const shadow2Style = {\n    ...commonCardStyle,\n    top: 12,\n    left: 12,\n    zIndex: 0,\n  };\n\n  const shadow1Style = {\n    ...commonCardStyle,\n    top: 6,\n    left: 6,\n    zIndex: 1,\n  };\n\n  // Main content card\n  const mainCardStyle = {\n    ...commonCardStyle,\n    top: 0,\n    left: 0,\n    zIndex: 2,\n    display: 'flex',\n    flexDirection: 'column',\n    overflow: 'hidden',\n  };\n\n  // Pink Header\n  const headerStyle = {\n    height: 24,\n    backgroundColor: accentColor,\n    borderBottom: `${BORDER_WIDTH}px solid ${primaryColor}`,\n    display: 'flex',\n    alignItems: 'center',\n    overflow: 'hidden',\n    whiteSpace: 'nowrap',\n  };\n\n  const marqueeTextStyle = {\n    color: '#FFFFFF',\n    fontSize: 10,\n    fontWeight: 'bold',\n    paddingLeft: 10,\n    transform: `translateX(-${scrollOffset}px)`,\n    display: 'inline-block',\n  };\n\n  // Body Content\n  const bodyStyle = {\n    flex: 1,\n    padding: '20px 24px',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    opacity: textOpacity,\n    transform: `translateY(${textY}px)`,\n  };\n\n  const titleStyle = {\n    fontSize: 22,\n    color: primaryColor,\n    lineHeight: 1.2,\n    marginBottom: 8,\n    textTransform: 'uppercase',\n  };\n\n  const subtitleStyle = {\n    fontSize: 12,\n    color: '#666666',\n    marginBottom: 16,\n    textTransform: 'uppercase',\n  };\n\n  const pulseLineStyle = {\n    width: 60,\n    height: 4,\n    backgroundColor: accentColor,\n    opacity: pulseOpacity,\n  };\n\n  // Helper to repeat text for marquee\n  const repeatedMarquee = Array(40).fill(marqueeText).join(' ');\n\n  return (\n    <div style={rootStyle}>\n      <div style={wrapperStyle}>\n        <div style={shadow2Style} />\n        <div style={shadow1Style} />\n        <div style={mainCardStyle}>\n          <div style={headerStyle}>\n            <div style={marqueeTextStyle}>\n              {repeatedMarquee}\n            </div>\n          </div>\n          <div style={bodyStyle}>\n            <div style={titleStyle}>{titleText}</div>\n            <div style={subtitleStyle}>{subtitleText}</div>\n            <div style={pulseLineStyle} />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "1bdbddfd-60bc-4fb3-ab57-c8a6427777ae",
  "name": "Black Title - Box Title",
  "category": "title-cards",
  "description": "A sharp, impactful title graphic that springs in as a bordered rectangle, followed by a crisp left-to-right wipe reveal of the text. Collapses smoothly to zero scale on exit.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/1bdbddfd-60bc-4fb3-ab57-c8a6427777ae.jpg",
  "code": "const SharpTitleGraphic = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const mainTitle = props.mainTitle || 'WARM LIVING';\n  const textColor = props.textColor || '#eaf8ee';\n  const borderColor = props.borderColor || '#eaf8ee';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const safeFps = fps || 30;\n  const safeDuration = durationInFrames || 150;\n\n  const boxScaleIn = spring({\n    frame,\n    fps: safeFps,\n    config: { damping: 12, stiffness: 140, mass: 1 }\n  });\n\n  const exitStartFrame = safeDuration - 25;\n\n  const exitSpring = spring({\n    frame: Math.max(0, frame - exitStartFrame),\n    fps: safeFps,\n    config: { damping: 18, stiffness: 200 }\n  });\n\n  const boxScale = frame < exitStartFrame ? boxScaleIn : Math.max(0, 1 - exitSpring);\n\n  const wipeProgress = interpolate(frame - 15, [0, 20], [100, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  const textVisible = frame < exitStartFrame;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    overflow: 'hidden'\n  };\n\n  const boxStyle = {\n    width: '1306px',\n    height: '160px',\n    backgroundColor: 'transparent',\n    border: `2px solid ${borderColor}`,\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    transform: `scale(${boxScale})`,\n    boxSizing: 'border-box'\n  };\n\n  const textStyle = {\n    fontFamily: '\"Montserrat\", sans-serif',\n    fontWeight: 800,\n    fontSize: '105px',\n    color: textColor,\n    clipPath: `inset(0 ${wipeProgress}% 0 0)`,\n    opacity: textVisible ? 1 : 0,\n    margin: 0,\n    lineHeight: 1.2,\n    letterSpacing: '0.08em',\n    textTransform: 'uppercase',\n    whiteSpace: 'nowrap'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={boxStyle}>\n        <div style={textStyle}>\n          {mainTitle}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "659cd252-7419-45d5-bbf1-3f6253f12811",
  "name": "Black Title - Character Cascade",
  "category": "title-cards",
  "description": "A big title animation featuring a box wipe entrance, staggered character cascade with opacity and blur, and smooth exit.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/659cd252-7419-45d5-bbf1-3f6253f12811.jpg",
  "code": "const Component = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const mainTitle = props.mainTitle || 'STREET FOOD STORIES';\n  const titleFontFamily = props.titleFontFamily || 'Montserrat, sans-serif';\n  const textColor = props.textColor || '#e9f5ff';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeDuration = durationInFrames || 150;\n  const exitStart = Math.max(40, safeDuration - 30);\n\n  const textFadeOut = interpolate(frame, [exitStart - 15, exitStart], [1, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    overflow: 'hidden'\n  };\n\n  const textContainerStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: '100%',\n    height: '100%',\n    display: 'flex',\n    flexDirection: 'row',\n    justifyContent: 'center',\n    alignItems: 'center',\n    alignContent: 'center',\n    flexWrap: 'wrap',\n    opacity: textFadeOut,\n    fontFamily: titleFontFamily,\n    fontSize: '125px',\n    fontWeight: 800,\n    textTransform: 'uppercase',\n    padding: '0 100px',\n    boxSizing: 'border-box'\n  };\n\n  const words = mainTitle.split(' ');\n  let charGlobalIndex = 0;\n\n  const wordElements = words.map((word, wIdx) => {\n    const chars = word.split('');\n    const charElements = chars.map((char, cIdx) => {\n      const charDelay = 25 + charGlobalIndex * 2;\n      charGlobalIndex++;\n      const charProgress = spring({\n        frame: Math.max(0, frame - charDelay),\n        fps: safeFps,\n        config: { damping: 14, mass: 0.6 }\n      });\n      const charY = interpolate(charProgress, [0, 1], [50, 0]);\n      const charOpacity = interpolate(charProgress, [0, 1], [0, 1]);\n      const charBlur = interpolate(charProgress, [0, 1], [10, 0], { extrapolateRight: 'clamp' });\n\n      const style = {\n        display: 'inline-block',\n        color: textColor,\n        opacity: charOpacity,\n        transform: `translateY(${charY}px)`,\n        filter: `blur(${charBlur}px)`,\n        margin: '0 2px'\n      };\n\n      return { char, style, key: `char-${wIdx}-${cIdx}` };\n    });\n\n    charGlobalIndex++;\n\n    const wordStyle = {\n      display: 'inline-block',\n      whiteSpace: 'nowrap',\n      marginRight: wIdx < words.length - 1 ? '30px' : '0px',\n      marginTop: '15px',\n      marginBottom: '15px'\n    };\n\n    return { charElements, style: wordStyle, key: `word-${wIdx}` };\n  });\n\n  return (\n    <div style={rootStyle}>\n      <div style={textContainerStyle}>\n        {wordElements.map(wordObj => (\n          <div key={wordObj.key} style={wordObj.style}>\n            {wordObj.charElements.map(charObj => (\n              <span key={charObj.key} style={charObj.style}>{charObj.char}</span>\n            ))}\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "afe39099-fba4-4b59-ad48-31a2bf55bc61",
  "name": "Black Title - Subtitle Line",
  "category": "title-cards",
  "description": "Elegant editorial title sequence featuring a center divider expanding while main text fades in, followed by typewriter-style subtitle reveals.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/afe39099-fba4-4b59-ad48-31a2bf55bc61.jpg",
  "code": "const CinematicTitleCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const mainTitle = props.mainTitle || 'PIXEL FOUNDRY';\n  const subtitleText = props.subtitleText || 'FOR YOUR NEXT GAME';\n  const textColor = props.textColor || '#eff3ff';\n  const fontFamily = props.fontFamily || 'Montserrat, sans-serif';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const d = durationInFrames || 150;\n  const exitStart = Math.max(0, d - 30);\n\n  const titleSpring = spring({\n    frame,\n    fps: safeFps,\n    config: { damping: 15, mass: 1, stiffness: 80 }\n  });\n  const titleYEntrance = interpolate(titleSpring, [0, 1], [50, 0]);\n  const titleYExit = interpolate(frame, [exitStart, exitStart + 20], [0, -50], { \n    easing: Easing.inOut(Easing.ease), \n    extrapolateLeft: 'clamp', \n    extrapolateRight: 'clamp' \n  });\n  const titleY = frame < exitStart ? titleYEntrance : titleYExit;\n\n  const titleOpacityEntrance = interpolate(frame, [0, 20], [0, 1], { extrapolateRight: 'clamp' });\n  const titleOpacityExit = interpolate(frame, [exitStart, exitStart + 20], [1, 0], { \n    extrapolateLeft: 'clamp', \n    extrapolateRight: 'clamp' \n  });\n  const titleOpacity = frame < exitStart ? titleOpacityEntrance : titleOpacityExit;\n\n  const lineSpring = spring({\n    frame: Math.max(0, frame - 15),\n    fps: safeFps,\n    config: { damping: 18, mass: 0.8 }\n  });\n  const lineScaleXExit = interpolate(frame, [exitStart, exitStart + 20], [1, 0], { \n    easing: Easing.inOut(Easing.ease), \n    extrapolateLeft: 'clamp', \n    extrapolateRight: 'clamp' \n  });\n  const lineScaleX = frame < exitStart ? lineSpring : lineScaleXExit;\n\n  const subYExit = interpolate(frame, [exitStart, exitStart + 20], [0, 50], { \n    easing: Easing.inOut(Easing.ease), \n    extrapolateLeft: 'clamp', \n    extrapolateRight: 'clamp' \n  });\n  const subY = frame < exitStart ? 0 : subYExit;\n\n  const subGroupOpacityExit = interpolate(frame, [exitStart, exitStart + 20], [1, 0], { \n    extrapolateLeft: 'clamp', \n    extrapolateRight: 'clamp' \n  });\n  const subGroupOpacity = frame < exitStart ? 1 : subGroupOpacityExit;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    overflow: 'hidden'\n  };\n\n  const titleStyle = {\n    fontFamily,\n    fontWeight: 800,\n    fontSize: '110px',\n    color: textColor,\n    margin: 0,\n    padding: 0,\n    transform: `translateY(${titleY}px)`,\n    opacity: titleOpacity,\n    textAlign: 'center',\n    letterSpacing: '0.05em'\n  };\n\n  const lineStyle = {\n    width: '960px',\n    height: '2px',\n    backgroundColor: textColor,\n    margin: '40px 0',\n    transform: `scaleX(${lineScaleX})`,\n    transformOrigin: 'center'\n  };\n\n  const subWrapperStyle = {\n    transform: `translateY(${subY}px)`,\n    opacity: subGroupOpacity,\n    textAlign: 'center'\n  };\n\n  const charStyle = {\n    fontFamily,\n    fontWeight: 400,\n    fontSize: '44px',\n    color: textColor,\n    letterSpacing: '0.15em',\n    textTransform: 'uppercase',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <h1 style={titleStyle}>{mainTitle}</h1>\n      <div style={lineStyle} />\n      <div style={subWrapperStyle}>\n        {subtitleText.split('').map((char, i) => {\n          const charOpacity = frame < exitStart\n            ? interpolate(frame, [25 + i * 2, 25 + i * 2 + 5], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' })\n            : 1;\n          return (\n            <span key={i} style={{ ...charStyle, opacity: charOpacity, whiteSpace: 'pre' }}>\n              {char}\n            </span>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "2995a5a5-7240-4c9a-8528-c167b8dce239",
