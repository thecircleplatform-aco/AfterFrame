    "code": "const ShortsChapter = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const chapter = p.chapter || '01';\n  const total = p.total || '05';\n  const title = p.title || '';\n  const accent = p.accentColor || '#818cf8';\n  const textColor = p.textColor || '#eef2ff';\n  const bg = p.bgColor || 'rgba(15,23,42,0.86)';\n  const enter = spring({ frame, fps, config: { damping: 16, stiffness: 100 } });\n  const exit = interpolate(frame, [durationInFrames - 10, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const progress = Math.min(1, Number(chapter) / Math.max(1, Number(total) || 1));\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent' }}>\n      <div style={{\n        position: 'absolute', top: 120, left: 48, right: 48,\n        opacity: enter * exit,\n        transform: `translateY(${(1 - enter) * -30}px)`,\n        background: bg, borderRadius: 24, padding: '28px 32px',\n        boxShadow: '0 12px 40px #0006',\n      }}>\n        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>\n          <div style={{ fontSize: 28, fontWeight: 800, color: accent }}>第 {chapter} 点</div>\n          <div style={{ fontSize: 24, color: textColor, opacity: 0.6 }}>{chapter} / {total}</div>\n        </div>\n        <div style={{ fontSize: 36, fontWeight: 800, color: textColor, lineHeight: 1.35 }}>{title}</div>\n        <div style={{ marginTop: 22, height: 8, borderRadius: 99, background: '#ffffff22', overflow: 'hidden' }}>\n          <div style={{ width: `${progress * 100}%`, height: '100%', background: accent, borderRadius: 99 }} />\n        </div>\n      </div>\n    </AbsoluteFill>\n  );\n};"
