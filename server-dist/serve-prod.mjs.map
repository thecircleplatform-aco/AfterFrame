  "thumb": "/thumbnails/8963b40a-b5b0-4076-8831-e1e227a9a777.jpg",
  "code": "const LowerThirdEditorial = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const nameText = props.nameText || 'Mara Voss';\n  const titleText = props.titleText || 'Lead Designer';\n  const introText = props.introText || 'Short Introduction';\n  const accentColor = props.accentColor || '#0086bb';\n  const stripColor = props.stripColor || '#FDF9F1';\n  const textColor = props.textColor || '#2C2623';\n  const fontFamily = props.fontFamily || '\"Playfair Display\", serif';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const safeFps = fps || 30;\n  const exitStart = durationInFrames - 30;\n  const activeFrame = frame < exitStart ? frame : Math.max(0, durationInFrames - frame);\n\n  const stripSpring = spring({ frame: activeFrame,                   fps: safeFps, config: { damping: 14, mass: 1,   stiffness: 100 } });\n  const blobSpring  = spring({ frame: Math.max(0, activeFrame - 5),  fps: safeFps, config: { damping: 12, mass: 0.8, stiffness: 120 } });\n  const nameSpring  = spring({ frame: Math.max(0, activeFrame - 10), fps: safeFps, config: { damping: 16, mass: 1,   stiffness: 120 } });\n  const ruleSpring  = spring({ frame: Math.max(0, activeFrame - 15), fps: safeFps, config: { damping: 18, mass: 1,   stiffness: 120 } });\n  const textSpring  = spring({ frame: Math.max(0, activeFrame - 18), fps: safeFps, config: { damping: 16, mass: 1,   stiffness: 120 } });\n\n  const stripY       = interpolate(stripSpring, [0, 1], [-100, 0]);\n  const blobRotation = interpolate(blobSpring,  [0, 1], [-20, -6]);\n  const nameY        = interpolate(nameSpring,  [0, 1], [22, 0]);\n  const textY        = interpolate(textSpring,  [0, 1], [12, 0]);\n  const introY       = interpolate(textSpring,  [0, 1], [-8, 0]);\n\n  const BLOB_SIZE    = 90;   // 压扁：高度\n  const BLOB_W       = 112;  // 宽度保持\n  const BLOB_OVERLAP = 52;   // 多露出一点，文字整体右移\n\n  // Decorative monogram / quill icon inside the blob\n  // Uses the first letter of nameText as a serif initial, with a small ornamental line beneath\n  const initialLetter = nameText.charAt(0).toUpperCase();\n\n  // Thin ornamental lines that animate into the blob\n  const ornamentScale = interpolate(blobSpring, [0, 1], [0, 1], { extrapolateRight: 'clamp' });\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      backgroundColor: 'transparent',\n    }}>\n      <div style={{\n        position: 'absolute',\n        bottom: 120,\n        left: 160,\n        display: 'flex',\n        alignItems: 'center',\n      }}>\n\n        {/* ── Strip (drop from top) ── */}\n        <div style={{\n          position: 'relative',\n          backgroundColor: stripColor,\n          padding: `14px 32px 14px ${BLOB_OVERLAP + 16}px`,\n          borderRadius: '4px',\n          boxShadow: '0 14px 28px rgba(0,0,0,0.09)',\n          transform: `translateY(${stripY}px)`,\n          opacity: Math.max(0, Math.min(1, stripSpring)),\n          display: 'inline-flex',\n          overflow: 'visible',\n        }}>\n\n          {/* ── Logo Blob (rounded square, tilted) ── */}\n          <div style={{\n            position: 'absolute',\n            left: -BLOB_OVERLAP,\n            top: '50%',\n            marginTop: -(BLOB_SIZE / 2),\n            width: BLOB_W,\n            height: BLOB_SIZE,\n            backgroundColor: accentColor,\n            borderRadius: '20px',\n            transform: `scale(${Math.max(0, blobSpring)}) rotate(${blobRotation}deg)`,\n            boxShadow: '0 8px 20px rgba(0,134,187,0.22)',\n            display: 'flex',\n            flexDirection: 'column',\n            justifyContent: 'center',\n            alignItems: 'center',\n            zIndex: 2,\n          }}>\n            {/* Serif initial letter */}\n            <div style={{\n              fontFamily: '\"Playfair Display\", serif',\n              fontSize: '38px',\n              fontWeight: 700,\n              color: 'rgba(255,255,255,0.95)',\n              lineHeight: 1,\n              marginBottom: '4px',\n              textShadow: '0 1px 4px rgba(0,0,0,0.18)',\n              userSelect: 'none',\n            }}>\n              {initialLetter}\n            </div>\n            {/* Thin ornamental divider line */}\n            <div style={{\n              width: '52px',\n              height: '1.5px',\n              backgroundColor: 'rgba(255,255,255,0.6)',\n              transform: `scaleX(${ornamentScale})`,\n              transformOrigin: 'center',\n              borderRadius: '1px',\n            }} />\n            {/* Two small dots on each side of divider */}\n            <div style={{\n              display: 'flex',\n              gap: '6px',\n              marginTop: '4px',\n              opacity: ornamentScale,\n            }}>\n              <div style={{ width: 3, height: 3, borderRadius: '50%', backgroundColor: 'rgba(255,255,255,0.55)' }} />\n              <div style={{ width: 3, height: 3, borderRadius: '50%', backgroundColor: 'rgba(255,255,255,0.55)' }} />\n              <div style={{ width: 3, height: 3, borderRadius: '50%', backgroundColor: 'rgba(255,255,255,0.55)' }} />\n            </div>\n          </div>\n\n          {/* ── Text content ── */}\n          <div style={{\n            position: 'relative',\n            zIndex: 1,\n            display: 'flex',\n            flexDirection: 'column',\n            alignItems: 'flex-start',\n            overflow: 'hidden',   // prevent text from leaking out\n            maxWidth: 700,        // reasonable cap, content-driven\n          }}>\n\n            {/* Intro label */}\n            <div style={{\n              fontFamily,\n              textTransform: 'uppercase',\n              letterSpacing: '0.14em',\n              fontSize: '15px',\n              fontWeight: 600,\n              color: textColor,\n              opacity: Math.max(0, textSpring * 0.6),\n              transform: `translateY(${introY}px)`,\n              marginBottom: '2px',\n              overflow: 'hidden',\n              textOverflow: 'ellipsis',\n              whiteSpace: 'nowrap',\n              width: '100%',\n            }}>\n              {introText}\n            </div>\n\n            {/* Name */}\n            <div style={{\n              fontFamily,\n              fontSize: '54px',\n              fontWeight: 700,\n              color: textColor,\n              lineHeight: 1.05,\n              opacity: Math.max(0, Math.min(1, nameSpring)),\n              transform: `translateY(${nameY}px)`,\n              overflow: 'hidden',\n              textOverflow: 'ellipsis',\n              whiteSpace: 'nowrap',\n              width: '100%',\n            }}>\n              {nameText}\n            </div>\n\n            {/* Rule */}\n            <div style={{\n              height: '1.5px',\n              width: '100%',\n              backgroundColor: accentColor,\n              marginTop: '8px',\n              marginBottom: '8px',\n              transform: `scaleX(${Math.max(0, ruleSpring)})`,\n              transformOrigin: 'left',\n              opacity: Math.max(0, Math.min(1, ruleSpring)),\n            }} />\n\n            {/* Title */}\n            <div style={{\n              fontFamily,\n              fontSize: '26px',\n              fontStyle: 'italic',\n              fontWeight: 400,\n              color: textColor,\n              opacity: Math.max(0, Math.min(1, textSpring * 0.85)),\n              transform: `translateY(${textY}px)`,\n              overflow: 'hidden',\n              textOverflow: 'ellipsis',\n              whiteSpace: 'nowrap',\n              width: '100%',\n            }}>\n              {titleText}\n            </div>\n\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "08aeec62-dffe-4973-b1da-b9bddd492d63",
  "name": "Lower Third 01 - Pill Badge",
  "category": "lower-thirds",
  "description": "A modern sequential lower third featuring a sliding name, an animated horizontal accent line, and a popping pill-shaped role badge.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/08aeec62-dffe-4973-b1da-b9bddd492d63.jpg",
  "code": "const LowerThirdPill = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const nameText = props.nameText || 'MARCUS REYES';\n  const roleText = props.roleText || 'STUDIO PHOTOGRAPHER';\n  const accentColor = props.accentColor || '#56cdb9';\n  const nameColor = props.nameColor || '#FFFFFF';\n  const roleColor = props.roleColor || '#FFFFFF';\n  const nameFont = props.nameFont || 'Oswald, sans-serif';\n  const roleFont = props.roleFont || 'Inter, sans-serif';\n  const xPosition = props.xPosition ?? 80;\n  const yPosition = props.yPosition ?? 880;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n\n  // Intro line: 0s to 0.4s (0 to 12 frames at 30fps)\n  const lineProgress = interpolate(frame, [0, 12], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  // Intro name: 0.4s to 0.8s (12 to 24 frames at 30fps)\n  const nameOpacity = interpolate(frame, [12, 24], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n  const nameY = interpolate(frame, [12, 24], [25, 0], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  // Intro badge: 0.8s to 1.2s (24 to 36 frames at 30fps)\n  const badgeScale = spring({\n    frame: Math.max(0, frame - 24),\n    fps: safeFps,\n    config: { damping: 14, stiffness: 180 }\n  });\n\n  // Outro: Last 0.3s (9 frames at 30fps)\n  const outroStart = Math.max(0, durationInFrames - 9);\n  const outroProgress = interpolate(frame, [outroStart, durationInFrames], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n  const groupY = interpolate(outroProgress, [0, 1], [0, 40]);\n  const groupOpacity = interpolate(outroProgress, [0, 1], [1, 0]);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n  };\n\n  const containerStyle = {\n    position: 'absolute',\n    left: `${xPosition}px`,\n    top: `${yPosition}px`,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'flex-start',\n    opacity: groupOpacity,\n    transform: `translateY(${groupY}px)`\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={containerStyle}>\n        \n        {/* Name and Line Container */}\n        <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'stretch', marginBottom: '16px' }}>\n          <div style={{ overflow: 'hidden', paddingBottom: '8px' }}>\n            <div style={{\n              fontFamily: nameFont,\n              fontSize: '80px',\n              fontWeight: '800',\n              color: nameColor,\n              textTransform: 'uppercase',\n              letterSpacing: '2px',\n              margin: 0,\n              lineHeight: 1,\n              opacity: nameOpacity,\n              transform: `translateY(${nameY}px)`\n            }}>\n              {nameText}\n            </div>\n          </div>\n          <div style={{\n            height: '4px',\n            backgroundColor: accentColor,\n            width: '100%',\n            transform: `scaleX(${lineProgress})`,\n            transformOrigin: 'left center'\n          }} />\n        </div>\n\n        {/* Badge Container */}\n        <div style={{\n          backgroundColor: accentColor,\n          padding: '12px 28px',\n          borderRadius: '50px',\n          transform: `scale(${badgeScale})`,\n          transformOrigin: 'left center',\n          display: 'flex',\n          alignItems: 'center',\n          justifyContent: 'center',\n        }}>\n          <div style={{\n            fontFamily: roleFont,\n            fontSize: '24px',\n            fontWeight: '700',\n            color: roleColor,\n            textTransform: 'uppercase',\n            letterSpacing: '3px',\n            margin: 0,\n            lineHeight: 1,\n          }}>\n            {roleText}\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "5a14be9d-3155-4519-b2c3-0974ee1e7006",
  "name": "Lower Third 03 - Vertical Bar",
  "category": "lower-thirds",
  "description": "A modern lower third featuring a vertical accent bar that drops down, followed by the name and subtitle fading and sliding in from the left.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/5a14be9d-3155-4519-b2c3-0974ee1e7006.jpg",
  "code": "const ModernLowerThird = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const nameText = props.nameText || 'MARCUS VOSS';\n  const subtitleText = props.subtitleText || 'GAME DIRECTOR';\n  const barColor = props.barColor || '#56cdb9';\n  const textColor = props.textColor || '#FFFFFF';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Timings based on prompt: \n  // Bar drop: 0s\n  // Name slide: 0.3s\n  // Subtitle slide: 0.5s\n  const barDelay = 0;\n  const nameDelay = Math.round(fps * 0.3);\n  const subDelay = Math.round(fps * 0.5);\n\n  // Entrance Springs\n  const barEntrance = spring({ \n    frame: Math.max(0, frame - barDelay), \n    fps, \n    config: { damping: 14, stiffness: 120 } \n  });\n  const nameEntrance = spring({ \n    frame: Math.max(0, frame - nameDelay), \n    fps, \n    config: { damping: 15, stiffness: 120 } \n  });\n  const subEntrance = spring({ \n    frame: Math.max(0, frame - subDelay), \n    fps, \n    config: { damping: 15, stiffness: 120 } \n  });\n\n  // Outro \n  // Slide left out + fade at the end\n  const outroDuration = Math.round(fps * 0.6);\n  const outroStart = durationInFrames - outroDuration;\n  const outroProgress = interpolate(\n    frame,\n    [outroStart, durationInFrames - 5],\n    [0, 1],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  // Pre-calculated animation values\n  const groupOpacity = interpolate(outroProgress, [0, 1], [1, 0]);\n  const groupTranslateX = interpolate(outroProgress, [0, 1], [0, -60]);\n\n  const barTranslateY = interpolate(barEntrance, [0, 1], [-60, 0]);\n  const nameTranslateX = interpolate(nameEntrance, [0, 1], [-40, 0]);\n  const subTranslateX = interpolate(subEntrance, [0, 1], [-40, 0]);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    fontFamily,\n  };\n\n  const containerStyle = {\n    position: 'absolute',\n    left: 80,\n    top: 870,\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    opacity: groupOpacity,\n    transform: `translateX(${groupTranslateX}px)`,\n  };\n\n  const barStyle = {\n    width: 6,\n    height: 60,\n    backgroundColor: barColor,\n    marginRight: 20,\n    transform: `translateY(${barTranslateY}px)`,\n    opacity: barEntrance,\n  };\n\n  const textContainerStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n  };\n\n  const nameStyle = {\n    fontSize: 44,\n    fontWeight: 800,\n    textTransform: 'uppercase',\n    color: textColor,\n    margin: 0,\n    lineHeight: 1,\n    transform: `translateX(${nameTranslateX}px)`,\n    opacity: nameEntrance,\n    textShadow: '0px 2px 8px rgba(0,0,0,0.4)',\n  };\n\n  const subStyle = {\n    fontSize: 20,\n    fontWeight: 500,\n    textTransform: 'uppercase',\n    color: textColor,\n    margin: 0,\n    marginTop: 6,\n    letterSpacing: '0.15em',\n    transform: `translateX(${subTranslateX}px)`,\n    opacity: subEntrance,\n    textShadow: '0px 2px 8px rgba(0,0,0,0.4)',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={containerStyle}>\n        <div style={barStyle} />\n        <div style={textContainerStyle}>\n          <h1 style={nameStyle}>{nameText}</h1>\n          <h2 style={subStyle}>{subtitleText}</h2>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "1b06459e-b43f-4a46-9e0f-dd3f67202373",
  "name": "Photo Lower Third",
  "category": "lower-thirds",
  "description": "A retro-inspired wide horizontal card with offset solid borders and stacked paper shadows. The title slides up, reveals an inset photo placeholder block, and cleanly fades in the 8-bit style typography.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "NORA KESSLER",
