  "thumb": "/thumbnails/364c0562-4e3a-4ca6-8f1a-7be3f582d73c.jpg",
  "code": "const StyleShowcase = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const safeFps = fps || 30;\n\n  const props = item.props || {};\n  const transparentBg = props.transparentBackground;\n  const bgColor = props.bgColor;\n  const primaryColor = props.primaryColor;\n  const textColor = props.textColor;\n  const primaryFont = props.primaryFont;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: transparentBg ? 'transparent' : bgColor,\n    overflow: 'hidden'\n  };\n\n  const titleWords = (props.titleText).split(' ');\n  const bars = [\n    { label: props.bar1Label, value: props.bar1Value },\n    { label: props.bar2Label, value: props.bar2Value },\n    { label: props.bar3Label, value: props.bar3Value },\n  ];\n  const bullets = [props.bullet1Text, props.bullet2Text, props.bullet3Text];\n  const quoteWords = (props.quoteText).split(' ');\n  const timelines = [props.timeline1Text, props.timeline2Text, props.timeline3Text, props.timeline4Text];\n\n  return (\n    <div style={rootStyle}>\n      {/* 1. Chapter Title */}\n      <div style={{ \n        position: 'absolute', left: 100, top: 100, width: 1000, \n        display: 'flex', flexWrap: 'wrap', gap: '0 30px' \n      }}>\n        {titleWords.map((word, i) => {\n          const wSpring = spring({ frame: Math.max(0, frame - (i * 4)), fps: safeFps, config: { damping: 15 } });\n          const y = interpolate(wSpring, [0, 1], [50, 0]);\n          const opacity = interpolate(wSpring, [0, 1], [0, 1]);\n          return (\n            <span key={i} style={{ \n              fontFamily: primaryFont, fontSize: 190, color: primaryColor, \n              textTransform: 'uppercase', lineHeight: 0.9,\n              opacity, transform: `translateY(${y}px)`, display: 'inline-block',\n              margin: 0\n            }}>\n              {word}\n            </span>\n          );\n        })}\n      </div>\n\n      {/* 2. Data Chart */}\n      <div style={{ position: 'absolute', right: 100, top: 100, width: 560, display: 'flex', flexDirection: 'column', gap: 40 }}>\n        {bars.map((bar, i) => {\n          const delay = 15 + i * 5;\n          const bSpring = spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping: 15 } });\n          const barW = bSpring * bar.value;\n          const textOp = interpolate(bSpring, [0, 0.5], [0, 1], { extrapolateRight: 'clamp' });\n          return (\n            <div key={i} style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>\n              <div style={{ display: 'flex', justifyContent: 'space-between', fontFamily: primaryFont, fontSize: 36, textTransform: 'uppercase', opacity: textOp }}>\n                <span style={{ color: textColor }}>{bar.label}</span>\n                <span style={{ color: primaryColor }}>{bar.value}%</span>\n              </div>\n              {frame >= (15 + i * 5) && <div style={{ width: '100%', height: 28, backgroundColor: 'rgba(255,255,255,0.1)', overflow: 'hidden' }}>\n                <div style={{ width: `${barW}%`, height: '100%', backgroundColor: primaryColor }} />\n              </div>}\n            </div>\n          );\n        })}\n      </div>\n\n      {/* 3. Bullet Points */}\n      <div style={{ position: 'absolute', right: 100, top: 480, width: 560, display: 'flex', flexDirection: 'column', gap: 24 }}>\n        {bullets.map((txt, i) => {\n          const delay = 35 + i * 5;\n          const blSpring = spring({ frame: Math.max(0, frame - delay), fps: safeFps, config: { damping: 15 } });\n          const x = interpolate(blSpring, [0, 1], [-30, 0]);\n          const opacity = interpolate(blSpring, [0, 1], [0, 1]);\n          return (\n            <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 24, opacity, transform: `translateX(${x}px)` }}>\n              <div style={{ width: 24, height: 24, backgroundColor: primaryColor, flexShrink: 0 }} />\n              <span style={{ fontFamily: primaryFont, fontSize: 44, color: textColor, textTransform: 'uppercase', letterSpacing: 1, lineHeight: 1 }}>{txt}</span>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* 4. Name Tag */}\n      {(() => {\n        const nSpring = spring({ frame: Math.max(0, frame - 55), fps: safeFps, config: { damping: 15 } });\n        const opacity = interpolate(nSpring, [0, 1], [0, 1]);\n        const y = interpolate(nSpring, [0, 1], [30, 0]);\n        return (\n          <div style={{ position: 'absolute', left: 100, bottom: 220, display: 'flex', flexDirection: 'column', opacity, transform: `translateY(${y}px)` }}>\n            <span style={{ fontFamily: primaryFont, fontSize: 110, color: primaryColor, textTransform: 'uppercase', lineHeight: 0.9 }}>{props.nameText}</span>\n            <span style={{ fontFamily: primaryFont, fontSize: 40, color: textColor, textTransform: 'uppercase', letterSpacing: 6 }}>{props.roleText}</span>\n          </div>\n        );\n      })()}\n\n      {/* 5. Highlight Quote */}\n      <div style={{ position: 'absolute', right: 100, bottom: 220, width: 560, display: 'flex', flexWrap: 'wrap', gap: '0 12px' }}>\n        {quoteWords.map((word, i) => {\n          const qSpring = spring({ frame: Math.max(0, frame - (45 + i * 3)), fps: safeFps, config: { damping: 15 } });\n          const opacity = interpolate(qSpring, [0, 1], [0, 1]);\n          const y = interpolate(qSpring, [0, 1], [15, 0]);\n          return (\n            <span key={i} style={{ \n              fontFamily: primaryFont, fontSize: 50, color: textColor, \n              fontStyle: 'italic', opacity, transform: `translateY(${y}px)`,\n              display: 'inline-block', lineHeight: 1.1\n            }}>\n              {word}\n            </span>\n          );\n        })}\n      </div>\n\n      {/* 6. Timeline */}\n      {(() => {\n        const tlDelay = 40;\n        const lineWidth = interpolate(frame - tlDelay, [0, 25], [0, 100], { extrapolateRight: 'clamp', easing: Easing.bezier(0.25, 0.1, 0.25, 1) });\n        return (\n          <div style={{ position: 'absolute', left: 100, right: 100, bottom: 60, height: 80 }}>\n            {frame >= 40 && <div style={{ position: 'absolute', top: 38, left: 0, height: 6, backgroundColor: 'rgba(255,255,255,0.15)', width: '100%' }} />}\n            <div style={{ position: 'absolute', top: 38, left: 0, height: 6, backgroundColor: primaryColor, width: `${lineWidth}%` }} />\n            \n            {timelines.map((yr, i) => {\n              const leftPercent = i * (100 / (timelines.length - 1));\n              const dotDelay = tlDelay + (leftPercent / 100) * 25;\n              const dSpring = spring({ frame: Math.max(0, frame - dotDelay), fps: safeFps, config: { damping: 15 } });\n              const scale = interpolate(dSpring, [0, 1], [0, 1]);\n              const opacity = interpolate(dSpring, [0, 1], [0, 1]);\n              return (\n                <div key={i} style={{ \n                  position: 'absolute', left: `${leftPercent}%`, top: 41, \n                  transform: 'translate(-50%, -50%)', display: 'flex', flexDirection: 'column', alignItems: 'center' \n                }}>\n                  <div style={{ \n                    width: 28, height: 28, borderRadius: 14, \n                    backgroundColor: primaryColor, transform: `scale(${scale})` \n                  }} />\n                  <div style={{ \n                    position: 'absolute', top: 35, \n                    fontFamily: primaryFont, fontSize: 32, color: textColor, opacity \n                  }}>\n                    {yr}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        );\n      })()}\n    </div>\n  );\n};"
 },
