  "code": "const NewsBroadcastTitle = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  // Props extraction with defaults\n  const props = item.props || {};\n  const mainTitle = props.mainTitle || 'ENERGY DESK';\n  const subtitle = props.subtitle || 'POWERING TOMORROW';\n  const primaryColor = props.primaryColor || '#131b02'; // Deep Navy\n  const accentColor = props.accentColor || '#008b8b'; // News Red\n  const bgColor = props.bgColor || '#F1F5F9'; // Light Silver\n\n  // Responsive Scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Animation Timing Config\n  const exitDuration = 30;\n  const exitStart = durationInFrames - exitDuration;\n\n  // 1. Background Planes Entrance (0s start)\n  const bgEntrance = spring({\n    frame,\n    fps,\n    config: { damping: 20, stiffness: 60, mass: 1.5 },\n  });\n\n  // 2. Main Title Entrance (0.3s ~ 10 frames delay)\n  const titleDelay = 10;\n  const titleEntrance = spring({\n    frame: frame - titleDelay,\n    fps,\n    config: { damping: 15, stiffness: 80, mass: 1 },\n  });\n\n  // 3. Line Divider Entrance (0.6s ~ 18 frames delay)\n  const lineDelay = 18;\n  const lineProgress = spring({\n    frame: frame - lineDelay,\n    fps,\n    config: { damping: 20, stiffness: 150 },\n  });\n\n  // 4. Subtitle Entrance (0.8s ~ 24 frames delay)\n  const subDelay = 24;\n  const subEntrance = spring({\n    frame: frame - subDelay,\n    fps,\n    config: { damping: 20 },\n  });\n\n  // 5. Exit Animation\n  const exitProgress = interpolate(\n    frame,\n    [exitStart, durationInFrames],\n    [0, 1],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  // Global Exit Transforms\n  const globalOpacity = 1 - exitProgress;\n  const globalScale = interpolate(exitProgress, [0, 1], [1, 0.95]);\n\n  // Continuous Drift for Background\n  const drift = interpolate(frame, [0, durationInFrames], [0, -40]);\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: bgColor,\n    overflow: 'hidden',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    opacity: globalOpacity,\n  };\n\n  // Geometric Light Ray Helper\n  const LightRay = ({ angle, top, left, width, opacity, delayOffset = 0, item }) => {\n    const slideIn = interpolate(bgEntrance, [0, 1], [150, 0]);\n    const rayStyle = {\n      position: 'absolute',\n      top,\n      left,\n      width,\n      height: 600,\n      background: 'linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.6) 50%, transparent 100%)',\n      transform: `rotate(${angle}deg) translateX(${slideIn + drift}px)`,\n      opacity: opacity,\n      filter: 'blur(40px)',\n    };\n    return <div style={rayStyle} />;\n  };\n\n  const contentContainerStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: '100%',\n    height: '100%',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    transform: `scale(${globalScale})`,\n    zIndex: 10,\n  };\n\n  const titleStyle = {\n    fontFamily: '\"Times New Roman\", Times, serif',\n    fontWeight: '800',\n    fontSize: '150px',\n    color: primaryColor,\n    letterSpacing: '-4px',\n    lineHeight: 0.9,\n    textAlign: 'center',\n    opacity: interpolate(titleEntrance, [0, 1], [0, 1]),\n    transform: `scale(${interpolate(titleEntrance, [0, 1], [0.95, 1])}) translateY(${interpolate(titleEntrance, [0, 1], [30, 0])}px)`,\n    textShadow: '0 10px 30px rgba(0,0,0,0.05)',\n  };\n\n  const dividerStyle = {\n    position: 'relative',\n    width: '600px',\n    height: '6px',\n    margin: '40px 0',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n  };\n\n  const thinLineStyle = {\n    position: 'absolute',\n    width: '100%',\n    height: '1px',\n    backgroundColor: primaryColor,\n    opacity: 0.2,\n    transform: `scaleX(${lineProgress})`,\n  };\n\n  const accentDashStyle = {\n    position: 'absolute',\n    width: '80px',\n    height: '6px',\n    backgroundColor: accentColor,\n    transform: `scaleX(${interpolate(frame - (lineDelay + 8), [0, 15], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' })})`,\n    transformOrigin: 'left',\n  };\n\n  const subStyle = {\n    fontFamily: '\"Helvetica Neue\", Helvetica, Arial, sans-serif',\n    fontWeight: '500',\n    fontSize: '32px',\n    color: primaryColor,\n    letterSpacing: '12px',\n    textTransform: 'uppercase',\n    opacity: subEntrance,\n    transform: `translateY(${interpolate(subEntrance, [0, 1], [15, 0])}px)`,\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Background Shapes */}\n      <LightRay angle={-25} top={-200} left={-200} width={2000} opacity={0.6} />\n      <LightRay angle={-25} top={200} left={-400} width={2500} opacity={0.4} />\n      <LightRay angle={-15} top={500} left={0} width={2200} opacity={0.3} />\n      \n      {/* Subtle Grid Texture */}\n      <div style={{\n        position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',\n        backgroundImage: `linear-gradient(${primaryColor} 1px, transparent 1px), linear-gradient(90deg, ${primaryColor} 1px, transparent 1px)`,\n        backgroundSize: '80px 80px',\n        opacity: 0.03 * bgEntrance,\n        transform: `scale(${1 + (drift * -0.001)})`\n      }} />\n\n      {/* Content */}\n      <div style={contentContainerStyle}>\n        <h1 style={titleStyle}>{mainTitle}</h1>\n        \n        <div style={dividerStyle}>\n          <div style={thinLineStyle} />\n          <div style={accentDashStyle} />\n        </div>\n\n        <h2 style={subStyle}>{subtitle}</h2>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "2063446e-f68f-4284-ae99-aefd13bd4824",
  "name": "Paper Chapter Title",
  "category": "title-cards",
  "description": "Paper Chapter Title title card template with editable text, layout, and visual styling.",
  "tags": [
   "Titles & Structure、Chapter Nav、Chapter Titles"
  ],
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "subtitleText": "Why furniture shipping keeps getting slower",
   "chapterText": "Chapter 2:",
   "titleText": "Wishlists",
   "bgColor": "#f0eae1",
   "titleColor": "#0a0a0a",
   "chapterColor": "#1a1a1a",
   "subtitleColor": "#706c66",
   "animSpeed": 1
  },
  "propSchema": [
