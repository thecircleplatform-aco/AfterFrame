  "description": "Pure Color Infographics style dashboard card featuring a large KPI and an animated horizontal bar chart for days of the week, complete with a stylized virus/molecule watermark.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "Weekly Recipe Saves",
   "kpiValue": "45%",
   "kpiSubtext1": "more engagement",
   "kpiSubtext2": "Information about your recipe activity",
   "barColor": "#1bc4ad",
