    "label": "Main Title"
   },
   {
    "key": "subtitle",
    "type": "text",
    "defaultValue": "How to make your game look \"amateur\"",
    "label": "Subtitle"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Inter, sans-serif",
    "label": "Font Family"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#05121d",
    "label": "Main Text Color"
   },
   {
    "key": "subtitleColor",
    "type": "color",
    "defaultValue": "#4c575f",
    "label": "Subtitle Color"
