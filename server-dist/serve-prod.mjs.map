    "code": "const KbSplitDots = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const W = 1080, H = 1920;\n  const ink = '#2c2620';\n  const accent = p.accentColor || '#e8582e';\n  const ratio = Math.min(0.62, Math.max(0.32, Number(p.splitRatio) || 0.5));\n  const splitY = Math.round(H * ratio);\n  const title = p.title == null ? '' : String(p.title);\n  const subtitle = p.subtitle == null ? '' : String(p.subtitle);\n  const handle = p.handle == null ? '' : String(p.handle);\n  const enter = spring({ frame, fps, config: { damping: 13, stiffness: 125 } });\n  const popIn = spring({ frame: frame - 5, fps, config: { damping: 11, stiffness: 150 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const drawLen = interpolate(frame, [8, 40], [860, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const sway = Math.sin((frame / 150) * Math.PI * 2);\n  const mask = 'linear-gradient(180deg, #000 0 ' + splitY + 'px, transparent ' + splitY + 'px)';\n  return (\n    <AbsoluteFill style={{ opacity: exit }}>\n      <AbsoluteFill style={{ backgroundColor: '#faf6ee', WebkitMaskImage: mask, maskImage: mask, opacity: enter }}>\n        <div style={{ position: 'absolute', inset: 0, backgroundImage: 'radial-gradient(circle 2.5px, #d5c8ae 2.5px, transparent 3px)', backgroundSize: '58px 58px', backgroundPosition: '29px 29px' }} />\n        <div style={{ position: 'absolute', left: 30, right: 30, top: 30, height: splitY - 80, border: '2.5px solid ' + ink + 'cc', borderRadius: 22 }} />\n      </AbsoluteFill>\n      <div style={{ position: 'absolute', left: 0, right: 0, top: Math.round(splitY * 0.40) + (1 - enter) * 30, opacity: enter, textAlign: 'center', padding: '0 80px', transform: 'translateY(-50%)' }}>\n        <div style={{ position: 'relative', display: 'inline-block', padding: '14px 34px' }}>\n          <div style={{ fontSize: 94, fontWeight: 800, color: ink, lineHeight: 1.24, letterSpacing: 3 }}>{title}</div>\n          <svg viewBox=\"0 0 400 160\" preserveAspectRatio=\"none\" style={{ position: 'absolute', inset: -12, width: 'calc(100% + 24px)', height: 'calc(100% + 24px)' }}>\n            <path d=\"M 30 24 C 130 2, 330 6, 372 52 C 396 92, 330 142, 196 148 C 80 152, 10 128, 16 84 C 20 52, 60 30, 120 24\" fill=\"none\" stroke={accent} strokeWidth=\"7\" strokeLinecap=\"round\" strokeDasharray=\"860\" strokeDashoffset={drawLen} />\n          </svg>\n        </div>\n        {subtitle ? (\n          <div style={{ marginTop: 34, display: 'inline-block', fontSize: 34, fontWeight: 700, color: ink + 'bf', letterSpacing: 4, background: 'linear-gradient(0deg, #ffd66e99 0 38%, transparent 38%)', padding: '0 14px 4px' }}>{subtitle}</div>\n        ) : null}\n      </div>\n      <svg viewBox=\"0 0 100 100\" style={{ position: 'absolute', width: 78, height: 78, right: 90, top: Math.round(splitY * 0.14) + sway * 5, transform: 'rotate(' + (16 + sway * 5) + 'deg)', opacity: popIn }}>\n        <path d=\"M50 6 L60 38 L94 38 L66 57 L76 90 L50 70 L24 90 L34 57 L6 38 L40 38 Z\" fill=\"#ffd66e\" stroke={ink} strokeWidth=\"4\" strokeLinejoin=\"round\" />\n      </svg>\n      <div style={{ position: 'absolute', left: 76, top: Math.round(splitY * 0.13), width: 22, height: 22, borderRadius: '50%', border: '4px solid ' + accent, opacity: popIn }} />\n      <div style={{ position: 'absolute', left: 0, top: splitY - 10, width: W, height: 18, background: ink, boxShadow: '0 5px 0 ' + ink + '26' }} />\n      {handle ? (\n        <div style={{ position: 'absolute', left: '50%', top: splitY, transform: 'translate(-50%, -50%) rotate(-2deg)', opacity: popIn, background: '#fffdf6', border: '2.5px solid ' + ink, borderRadius: 999, padding: '10px 30px', fontSize: 30, fontWeight: 800, color: ink, whiteSpace: 'nowrap', boxShadow: '4px 5px 0 ' + ink + '2b' }}>{handle}</div>\n      ) : null}\n    </AbsoluteFill>\n  );\n};"
