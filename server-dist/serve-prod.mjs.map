    "label": "Ribbon End"
   },
   {
    "key": "bgBaseColor",
    "type": "color",
    "defaultValue": "#000d1f",
    "label": "Background Color"
   },
   {
    "key": "animationSpeed",
    "type": "number",
    "defaultValue": 1,
    "label": "Animation Speed"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
    "defaultValue": false,
    "label": "Transparent Background"
   }
  ],
  "thumb": "/thumbnails/630caca9-93c5-459c-bae6-6c0bd0338124.jpg",
  "code": "const RibbonGraphic = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  const props = item.props || {};\n  const bodyText = props.bodyText;\n  const fontFamily = props.fontFamily;\n  const textColor = props.textColor;\n  const ribbonColorStart = props.ribbonColorStart;\n  const ribbonColorMid = props.ribbonColorMid;\n  const ribbonColorEnd = props.ribbonColorEnd;\n  const bgBaseColor = props.bgBaseColor;\n  const animationSpeed = props.animationSpeed;\n  const transparentBackground = props.transparentBackground;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const adjFrame = frame * animationSpeed;\n\n  const dashOffset = interpolate(\n    adjFrame,\n    [0, 54, 120, 166],\n    [1000, 0, 0, -1000],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  const pathData = 'M -110 478 C 110 260, 330 150, 520 178 C 690 202, 760 330, 704 520 C 650 708, 734 842, 905 800 C 1110 750, 1270 568, 1495 410 C 1695 270, 1850 190, 2040 102';\n\n  const sharedPathProps = {\n    d: pathData,\n    fill: 'none',\n    strokeLinecap: 'round',\n    strokeLinejoin: 'round',\n    pathLength: 1000,\n    strokeDasharray: 1000,\n    strokeDashoffset: dashOffset,\n  };\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: transparentBackground ? 'transparent' : bgBaseColor,\n    overflow: 'hidden',\n  };\n\n  const words = bodyText.split(' ');\n\n  return (\n    <div style={rootStyle}>\n      {!transparentBackground && (\n        <AbsoluteFill>\n          <div style={{ position: 'absolute', top: -150, left: -50, width: 800, height: 800, background: ribbonColorStart, filter: 'blur(150px)', opacity: 0.35, borderRadius: '50%' }} />\n          <div style={{ position: 'absolute', bottom: -250, left: '20%', width: 1000, height: 1000, background: ribbonColorMid, filter: 'blur(200px)', opacity: 0.25, borderRadius: '50%' }} />\n          <div style={{ position: 'absolute', top: 100, right: -150, width: 900, height: 900, background: ribbonColorEnd, filter: 'blur(180px)', opacity: 0.3, borderRadius: '50%' }} />\n        </AbsoluteFill>\n      )}\n\n      <AbsoluteFill>\n        <svg viewBox={`0 0 ${DESIGN_WIDTH} ${DESIGN_HEIGHT}`} style={{ position: 'absolute', width: '100%', height: '100%' }}>\n          <defs>\n            <linearGradient id=\"main-grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n              <stop offset=\"0%\" stopColor={ribbonColorStart} />\n              <stop offset=\"50%\" stopColor={ribbonColorMid} />\n              <stop offset=\"100%\" stopColor={ribbonColorEnd} />\n            </linearGradient>\n            <linearGradient id=\"dark-grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n              <stop offset=\"0%\" stopColor=\"#330009\" />\n              <stop offset=\"50%\" stopColor=\"#4b0012\" />\n              <stop offset=\"100%\" stopColor=\"#680018\" />\n            </linearGradient>\n          </defs>\n          <path {...sharedPathProps} stroke=\"rgba(0,0,0,0.48)\" strokeWidth=\"178\" transform=\"translate(30,58)\" opacity=\"0.82\" />\n          <path {...sharedPathProps} stroke=\"url(#dark-grad)\" strokeWidth=\"158\" transform=\"translate(-22,36)\" opacity=\"0.95\" />\n          <path {...sharedPathProps} stroke=\"url(#main-grad)\" strokeWidth=\"150\" />\n          <path {...sharedPathProps} stroke=\"rgba(255,226,214,0.34)\" strokeWidth=\"58\" transform=\"translate(-22,-28)\" opacity=\"0.42\" />\n          <path {...sharedPathProps} stroke=\"rgba(255,136,82,0.30)\" strokeWidth=\"72\" transform=\"translate(18,-18)\" opacity=\"0.48\" />\n        </svg>\n      </AbsoluteFill>\n\n      <AbsoluteFill style={{ display: 'flex', flexDirection: 'row', justifyContent: 'center', alignItems: 'center' }}>\n        {words.map((word, i) => {\n          const delay = 24 + i * 4;\n          const wordFrame = Math.max(0, adjFrame - delay);\n          const springVal = spring({\n            frame: wordFrame,\n            fps,\n            config: { damping: 17, stiffness: 115, mass: 0.9 }\n          });\n          const translateY = interpolate(springVal, [0, 1], [54, 0]);\n          const opacity = interpolate(springVal, [0, 1], [0, 1]);\n          const scaleVal = interpolate(springVal, [0, 1], [0.92, 1]);\n          return (\n            <div key={i} style={{\n              display: 'inline-block',\n              marginRight: i === words.length - 1 ? 0 : '0.28em',\n              transform: `translateY(${translateY}px) scale(${scaleVal})`,\n              opacity,\n              fontFamily,\n              fontSize: 118,\n              fontWeight: 800,\n              color: textColor,\n              letterSpacing: '-0.055em',\n              textShadow: '0px 12px 32px rgba(0,0,0,0.4)',\n              zIndex: 10\n            }}>\n              {word}\n            </div>\n          );\n        })}\n      </AbsoluteFill>\n    </div>\n  );\n};"
 },
 {
  "id": "0d0b9a79-bcc9-4c55-82f3-5a12a2a2a6ce",
  "name": "MindSpace — Self-Check Questions",
  "category": "uncategorized",
  "description": "A list of questions revealing one by one via soft springs, ending with a final typewriter-effect question and a blinking cursor, set over a deep purple bokeh background.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "q1Text": "1. Have you set your travel budget?",
   "q2Text": "2. How often do plans change last minute?",
   "q3Text": "3. Do you leave room to wander?",
   "q4Text": "4. When did you last book a trip?",
   "fontFamily": "DM Sans",
   "textColor": "#ffffff",
   "bgBaseColor": "#000d1f",
   "bgAccent1": "#32445b",
   "bgAccent2": "#1a3043",
   "animationSpeed": 1,
   "transparentBackground": false
  },
  "propSchema": [
   {
    "key": "q1Text",
    "type": "text",
    "defaultValue": "1. Have you set your travel budget?",
    "label": "Question 1"
   },
   {
    "key": "q2Text",
    "type": "text",
    "defaultValue": "2. How often do plans change last minute?",
    "label": "Question 2"
   },
   {
    "key": "q3Text",
    "type": "text",
