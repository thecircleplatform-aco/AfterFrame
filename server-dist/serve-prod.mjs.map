  "thumb": "/thumbnails/49756343-72e4-48aa-8a3d-cc66975d3435.jpg",
  "code": "const PixelDataCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const topLabel = props.topLabel || 'Total roasters served:';\n  const mainValue = props.mainValue || '3.1M';\n  const sourceText = props.sourceText || 'Roast Guild Report 2024';\n  const cardColor = props.cardColor || '#e5f8fa';\n  const borderColor = props.borderColor || '#000203';\n  const shadowColor = props.shadowColor || '#000203';\n  const textColor = props.textColor || '#000203';\n  const fontFamily = props.fontFamily || '\"VT323\", monospace';\n\n  const DESIGN_WIDTH = 500;\n  const DESIGN_HEIGHT = 200;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  \n  // Elastic pop-up animation\n  const cardScale = spring({\n    frame: Math.max(0, frame - 5),\n    fps: safeFps,\n    config: { damping: 10, stiffness: 140, mass: 1 }\n  });\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center',\n    fontFamily: fontFamily,\n  };\n\n  // Stacked paper shadow effect using multiple box-shadow offsets matching the border width\n  const cardStyle = {\n    backgroundColor: cardColor,\n    border: `4px solid ${borderColor}`,\n    boxShadow: `4px 4px 0px 0px ${cardColor}, 8px 8px 0px 0px ${borderColor}, 12px 12px 0px 0px ${cardColor}, 16px 16px 0px 0px ${shadowColor}`,\n    padding: '16px 32px',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n    transform: `scale(${cardScale})`,\n    color: textColor,\n    textTransform: 'uppercase',\n  };\n\n  const labelStyle = {\n    fontSize: '20px',\n    marginBottom: '8px',\n    letterSpacing: '1px',\n    textAlign: 'center',\n  };\n\n  const valueStyle = {\n    fontSize: '72px',\n    fontWeight: 'bold',\n    margin: '0 0 8px 0',\n    textAlign: 'center',\n    lineHeight: '1',\n    letterSpacing: '2px',\n  };\n\n  const sourceStyle = {\n    fontSize: '14px',\n    opacity: 0.8,\n    textAlign: 'center',\n    letterSpacing: '0.5px',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <div style={labelStyle}>{topLabel}</div>\n        <div style={valueStyle}>{mainValue}</div>\n        <div style={sourceStyle}>{sourceText}</div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "23f4a551-32fa-4cf7-ae35-abaa9c3d093c",
  "name": "Timeline Progress Bar",
  "category": "infographics",
  "description": "A clean, minimal progress bar that draws left-to-right with sequentially animated nodes and vertically stacked text labels.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "label1": "CREATE A\nFREE ACCOUNT",
   "label2": "TRACK YOUR\nUSAGE STATS",
   "label3": "UPGRADE TO\nA PRO PLAN",
   "color": "#edf4ff",
   "fontFamily": "Inter, sans-serif",
   "transparentBackground": true
  },
  "propSchema": [
   {
    "key": "label1",
    "type": "text",
    "defaultValue": "CREATE A\nFREE ACCOUNT",
    "label": "Left Node Label"
   },
   {
    "key": "label2",
    "type": "text",
    "defaultValue": "TRACK YOUR\nUSAGE STATS",
    "label": "Center Node Label"
   },
   {
    "key": "label3",
    "type": "text",
    "defaultValue": "UPGRADE TO\nA PRO PLAN",
    "label": "Right Node Label"
   },
   {
    "key": "color",
    "type": "color",
    "defaultValue": "#edf4ff",
    "label": "Primary Color"
   },
   {
    "key": "fontFamily",
    "type": "font",
    "defaultValue": "Inter, sans-serif",
    "label": "Font Family"
   },
   {
    "key": "transparentBackground",
    "type": "boolean",
    "defaultValue": true,
    "label": "Transparent Background"
   }
  ],
  "thumb": "/thumbnails/23f4a551-32fa-4cf7-ae35-abaa9c3d093c.jpg",
  "code": "const CinematicTimeline = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const label1 = props.label1;\n  const label2 = props.label2;\n  const label3 = props.label3;\n  const color = props.color;\n  const fontFam = props.fontFamily;\n  const transparentBg = props.transparentBackground;\n\n  const DESIGN_WIDTH = 1400;\n  const DESIGN_HEIGHT = 260;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 14 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  // Line draws linearly from frame 15 to 65\n  const lineProgress = interpolate(frame, [15, 65], [0, 100], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp'\n  });\n\n  // Nodes pop in sequentially matched with the line progress\n  const node1Scale = safeSpring(15);\n  const node2Scale = safeSpring(40);\n  const node3Scale = safeSpring(65);\n\n  // Labels fade in at the SAME time as their respective nodes\n  const getLabelAnim = (startFrame) => {\n    const opacity = interpolate(frame, [startFrame, startFrame + 8], [0, 1], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp'});\n    const y = interpolate(frame, [startFrame, startFrame + 8], [12, 0], {extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.out(Easing.quad)});\n    return { opacity, y };\n  };\n\n  const l1Anim = getLabelAnim(15);\n  const l2Anim = getLabelAnim(40);\n  const l3Anim = getLabelAnim(65);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: transparentBg ? 'transparent' : 'rgba(0,1,9,0.85)',\n    display: 'flex',\n    justifyContent: 'center',\n    alignItems: 'center'\n  };\n\n  // Line sits at top of container, text lives strictly below\n  const LINE_Y = 20;\n  const NODE_SIZE = 22;\n\n  const barContainerStyle = {\n    position: 'relative',\n    width: 1100,\n    height: 180\n  };\n\n  const lineStyle = {\n    position: 'absolute',\n    top: LINE_Y,\n    left: 0,\n    width: `${lineProgress}%`,\n    height: 4,\n    backgroundColor: color,\n    transform: 'translateY(-50%)',\n    boxShadow: '0 2px 8px rgba(0,1,9,0.4)',\n    borderRadius: 2\n  };\n\n  const renderNode = (leftPercent, scaleAnim, label, lAnim, keyIndex) => {\n    // Circle is centered on the line\n    const circleTop = LINE_Y - NODE_SIZE / 2;\n\n    const circleWrapStyle = {\n      position: 'absolute',\n      left: `${leftPercent}%`,\n      top: circleTop,\n      transform: 'translateX(-50%)',\n      width: NODE_SIZE,\n      height: NODE_SIZE\n    };\n\n    const circleStyle = {\n      width: NODE_SIZE,\n      height: NODE_SIZE,\n      backgroundColor: color,\n      borderRadius: '50%',\n      transform: `scale(${scaleAnim})`,\n      boxShadow: '0 0 12px rgba(0,1,9,0.5)'\n    };\n\n    // Text starts below the circle with a clear gap, never touching the line\n    const labelWrapStyle = {\n      position: 'absolute',\n      left: `${leftPercent}%`,\n      top: LINE_Y + NODE_SIZE + 18,\n      transform: 'translateX(-50%)',\n      width: 320,\n      textAlign: 'center'\n    };\n\n    const labelStyle = {\n      color: color,\n      fontFamily: fontFam,\n      fontWeight: 800,\n      fontSize: 22,\n      letterSpacing: '0.06em',\n      textAlign: 'center',\n      textTransform: 'uppercase',\n      opacity: lAnim.opacity,\n      transform: `translateY(${lAnim.y}px)`,\n      textShadow: '0 3px 6px rgba(0,1,9,0.6)',\n      lineHeight: 1.35,\n      whiteSpace: 'pre-line',\n      display: 'inline-block'\n    };\n\n    return (\n      <React.Fragment key={keyIndex}>\n        <div style={circleWrapStyle}>\n          <div style={circleStyle} />\n        </div>\n        <div style={labelWrapStyle}>\n          <span style={labelStyle}>{label}</span>\n        </div>\n      </React.Fragment>\n    );\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={barContainerStyle}>\n        <div style={lineStyle} />\n        {renderNode(0, node1Scale, label1, l1Anim, 1)}\n        {renderNode(50, node2Scale, label2, l2Anim, 2)}\n        {renderNode(100, node3Scale, label3, l3Anim, 3)}\n      </div>\n    </div>\n  );\n};\n"
 },
 {
