  "thumb": "/thumbnails/243aa8dd-9cd9-41ac-8972-05d2e505f036.jpg",
  "code": "const MonochromeEditorial = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const chapterNumber = props.chapterNumber;\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const primaryColor = props.primaryColor;\n  const serifFont = props.serifFont;\n  const sansFont = props.sansFont;\n  const bgImage = props.bgImage;\n  const backgroundColor = props.transparentBackground ? 'transparent' : props.bgColor;\n\n  // --- Easing curves ---\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n  const lineDraw = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 2.8);\n  };\n\n  // --- Exit (last 25 frames) ---\n  const totalFrames = durationInFrames || 120;\n  const exitStart = totalFrames - 25;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / 25));\n  const exitProgress = exitRaw * exitRaw;\n  const exitOpacity = 1 - exitProgress;\n  const exitScale = 1 - exitProgress * 0.02;\n\n  // --- Background: scale 1.05 → 1.0 over 45 frames + opacity ---\n  const bgRaw = Math.min(1, Math.max(0, frame / 45));\n  const bgProgress = smoothSettle(bgRaw);\n  const bgScale = 1.05 - 0.05 * bgProgress;\n  const bgOpacity = smoothSettle(Math.min(1, Math.max(0, frame / 20))) * 0.35;\n\n  // --- SVG line draw: starts at frame 10, 50 frames duration ---\n  const lineRaw = Math.min(1, Math.max(0, (frame - 10) / 50));\n  const lineProgress = lineDraw(lineRaw);\n  const pathLength = 350;\n  const drawOffset = pathLength * (1 - lineProgress);\n\n  // --- Number: starts at frame 8, 50 frames ---\n  const numRaw = Math.min(1, Math.max(0, (frame - 8) / 50));\n  const numProgress = smoothSettle(numRaw);\n  const numY = (1 - numProgress) * 70;\n  const numOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - 8) / 18)));\n\n  // --- Text column: starts at frame 30, 45 frames ---\n  const textRaw = Math.min(1, Math.max(0, (frame - 30) / 45));\n  const textProgress = smoothSettle(textRaw);\n  const textY = (1 - textProgress) * 60;\n  const textOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - 30) / 15)));\n\n  // --- Subtitle: starts at frame 55, 35 frames ---\n  const subRaw = Math.min(1, Math.max(0, (frame - 55) / 35));\n  const subProgress = smoothSettle(subRaw);\n  const subOpacity = subProgress;\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor,\n    overflow: 'hidden',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    opacity: exitOpacity,\n    transform: `scale(${exitScale})`\n  };\n\n  const bgContainerStyle = {\n    position: 'absolute',\n    inset: 0,\n    transform: `scale(${bgScale})`,\n    transformOrigin: 'center center',\n    opacity: bgOpacity,\n    display: 'flex'\n  };\n\n  const svgStyle = {\n    position: 'absolute',\n    inset: 0,\n    opacity: lineProgress\n  };\n\n  const contentStyle = {\n    position: 'relative',\n    display: 'flex',\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    gap: 80,\n    width: 1200,\n    height: 600\n  };\n\n  const numberStyle = {\n    transform: `translateY(${numY}px)`,\n    opacity: numOpacity,\n    fontSize: 320,\n    fontFamily: serifFont,\n    fontStyle: 'italic',\n    fontWeight: 'bold',\n    color: primaryColor,\n    lineHeight: 1\n  };\n\n  const textColumnStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    gap: 20,\n    maxWidth: 700,\n    transform: `translateY(${textY}px)`,\n    opacity: textOpacity\n  };\n\n  const titleStyle = {\n    fontSize: 96,\n    fontFamily: serifFont,\n    color: primaryColor,\n    lineHeight: 1.15,\n    whiteSpace: 'pre-wrap'\n  };\n\n  const subtitleStyle = {\n    fontSize: 24,\n    fontFamily: sansFont,\n    color: primaryColor,\n    opacity: 0.75 * subOpacity,\n    lineHeight: 1.5,\n    textTransform: 'uppercase',\n    letterSpacing: 4\n  };\n\n  return (\n    <div style={rootStyle}>\n      {bgImage && !props.transparentBackground && (\n        <div style={bgContainerStyle}>\n          <Img src={bgImage} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />\n        </div>\n      )}\n\n      <div style={svgStyle}>\n        <svg width=\"1920\" height=\"1080\" viewBox=\"0 0 1920 1080\" fill=\"none\">\n          <path d=\"M 460 190 L 310 190 L 310 340\" stroke={primaryColor} strokeWidth=\"2\" strokeDasharray={pathLength} strokeDashoffset={drawOffset} />\n          <path d=\"M 1460 190 L 1610 190 L 1610 340\" stroke={primaryColor} strokeWidth=\"2\" strokeDasharray={pathLength} strokeDashoffset={drawOffset} />\n          <path d=\"M 310 740 L 310 890 L 460 890\" stroke={primaryColor} strokeWidth=\"2\" strokeDasharray={pathLength} strokeDashoffset={drawOffset} />\n          <path d=\"M 1610 740 L 1610 890 L 1460 890\" stroke={primaryColor} strokeWidth=\"2\" strokeDasharray={pathLength} strokeDashoffset={drawOffset} />\n        </svg>\n      </div>\n\n      <div style={contentStyle}>\n        <div style={numberStyle}>\n          {chapterNumber}\n        </div>\n        <div style={textColumnStyle}>\n          <div style={titleStyle}>{titleText}</div>\n          <div style={subtitleStyle}>{subtitleText}</div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "49e0b581-862b-42fc-bb6b-a17d0c3d1668",
