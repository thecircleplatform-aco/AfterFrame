  "thumb": "/thumbnails/1ed40a68-6303-427a-94f9-5197a0af7869.jpg",
  "code": "const LocationPopCard = ({item}) => { const frame = useCurrentFrame(); const {fps} = useVideoConfig(); const props = item.props || {}; const headerText = props.headerText || 'CHECKPOINT'; const mainText = props.mainText || 'Portland, Oregon'; const subText = props.subText || 'Riverside Wheel Collective'; const headerColor = props.headerColor || '#b4e926'; const cardColor = props.cardColor || '#FFFFFF'; const textColor = props.textColor || '#000000'; const iconColor = props.iconColor || '#009e9e'; const fontFamily = props.fontFamily || '\"Press Start 2P\", \"VT323\", monospace'; const DESIGN_WIDTH = 520; const DESIGN_HEIGHT = 200; const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT); const safeFps = fps || 30; const entranceScale = spring({ frame, fps: safeFps, config: { damping: 12, mass: 1, stiffness: 180 } }); const rootStyle = { position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: `scale(${scale})`, transformOrigin: 'top left', backgroundColor: 'transparent', display: 'flex', justifyContent: 'center', alignItems: 'center' }; const cardStyle = { width: 440, height: 120, backgroundColor: cardColor, border: `2px solid ${textColor}`, boxShadow: `6px 6px 0px 0px ${textColor}`, display: 'flex', flexDirection: 'column', transform: `scale(${entranceScale})`, transformOrigin: 'center center', fontFamily, color: textColor, overflow: 'hidden' }; const headerStyle = { height: 32, backgroundColor: headerColor, borderBottom: `2px solid ${textColor}`, display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '0 12px' }; const dotStyle = { width: 10, height: 10, backgroundColor: cardColor, border: `2px solid ${textColor}` }; const bodyStyle = { flex: 1, display: 'flex', flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: '20px' }; return ( <div style={rootStyle}> <div style={cardStyle}> <div style={headerStyle}> <div style={{ fontSize: 12, fontWeight: 'bold', marginTop: 2, letterSpacing: '1px' }}>{headerText}</div> <div style={{ display: 'flex', gap: 6 }}> <div style={dotStyle} /> <div style={dotStyle} /> <div style={dotStyle} /> </div> </div> <div style={bodyStyle}> <svg width=\"28\" height=\"36\" viewBox=\"0 0 14 18\" shapeRendering=\"crispEdges\" style={{ flexShrink: 0 }}> <path d=\"M 4 0 H 10 V 2 H 12 V 4 H 14 V 10 H 12 V 12 H 10 V 14 H 8 V 18 H 6 V 14 H 4 V 12 H 2 V 10 H 0 V 4 H 2 V 2 H 4 V 0 Z\" fill={iconColor} /> <path d=\"M 5 4 H 9 V 8 H 5 Z\" fill={cardColor} /> </svg> <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}> <div style={{ fontSize: 20, fontWeight: 'bold', textTransform: 'uppercase', lineHeight: 1 }}> {mainText} </div> <div style={{ fontSize: 10, opacity: 0.8, lineHeight: 1, letterSpacing: '0.5px' }}> {subText} </div> </div> </div> </div> </div> ); };"
 },
 {
  "id": "c987c3d3-e85b-40cf-adca-44ca22b6215a",
  "name": "Minimal Zoom Title Card",
  "category": "title-cards",
  "description": "A minimalist title card featuring white text on a black background, complete with a subtle continuous zoom and smooth fade transitions in and out.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/c987c3d3-e85b-40cf-adca-44ca22b6215a.jpg",
  "code": "const TitleCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'PIXEL HARBOR STUDIO';\n  const subtitleText = props.subtitleText || 'An indie game studio chasing quiet ideas';\n  const textColor = props.textColor || '#f6f0ff';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const opacity = interpolate(\n    frame,\n    [0, 30, durationInFrames - 30, durationInFrames],\n    [0, 1, 1, 0],\n    { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' }\n  );\n\n  const textScale = interpolate(\n    frame,\n    [0, durationInFrames],\n    [0.95, 1.05],\n    { extrapolateRight: 'clamp' }\n  );\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    overflow: 'hidden'\n  };\n\n  const contentStyle = {\n    opacity: opacity,\n    transform: `scale(${textScale})`,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  const titleStyle = {\n    fontFamily: fontFamily,\n    fontSize: '120px',\n    fontWeight: 800,\n    color: textColor,\n    margin: 0,\n    letterSpacing: '0.05em',\n    textAlign: 'center'\n  };\n\n  const subtitleStyle = {\n    fontFamily: fontFamily,\n    fontSize: '48px',\n    fontWeight: 400,\n    color: textColor,\n    margin: '24px 0 0 0',\n    letterSpacing: '0.1em',\n    opacity: 0.8,\n    textAlign: 'center'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={contentStyle}>\n        <h1 style={titleStyle}>{titleText}</h1>\n        {subtitleText ? <h2 style={subtitleStyle}>{subtitleText}</h2> : null}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "ea1d0a33-02a9-4d9e-ae44-99a4e133561c",
  "name": "Modern Welcome Screen",
  "category": "title-cards",
  "description": "A bold, premium welcome screen featuring a morphing initials-to-title animation, atmospheric light bleed, and an elegant drawing border for the subtitle.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/ea1d0a33-02a9-4d9e-ae44-99a4e133561c.jpg",
  "code": "const WelcomeEventScreen = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  // Editable properties\n  const props = item.props || {};\n  const titleText = props.titleText || 'ONBOARD';\n  const initialsText = props.initialsText || 'D K';\n  const subtitleText = props.subtitleText || \"Your dashboard is ready\";\n  const headerText = props.headerText || 'ONBOARD';\n  const glowColorPrimary = props.glowColorPrimary || '#3f5500'; // Soft blue\n  const glowColorAccent = props.glowColorAccent || '#00b5b5'; // Warm amber\n  const backgroundColor = props.backgroundColor || '#08090f';\n\n  // Responsive scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // Timing constants\n  const morphStartFrame = 45;\n  const springConfig = { damping: 12, stiffness: 100, mass: 0.8 };\n\n  // --- Animations ---\n\n  // 1. Initials: Fade in, hold, then scale explosion\n  const initialsOpacity = interpolate(frame, [0, 20, morphStartFrame, morphStartFrame + 8], [0, 1, 1, 0]);\n  const initialsScale = interpolate(frame, [0, morphStartFrame, morphStartFrame + 15], [0.8, 1, 6], {\n    extrapolateRight: 'clamp',\n    easing: Easing.bezier(0.6, 0.0, 0.2, 1),\n  });\n\n  // 2. Main Title: Pop in right after initials explode\n  const titleSpring = spring({\n    frame: frame - morphStartFrame,\n    fps,\n    config: springConfig\n  });\n  const titleScale = interpolate(titleSpring, [0, 1], [0.4, 1]);\n  const titleOpacity = interpolate(frame, [morphStartFrame, morphStartFrame + 5], [0, 1]);\n\n  // 3. Border Box: Draws the line around the subtitle\n  const boxWidth = 550;\n  const boxHeight = 80;\n  const perimeter = (boxWidth + boxHeight) * 2;\n  const boxDrawProgress = spring({\n    frame: frame - (morphStartFrame + 10),\n    fps,\n    config: { stiffness: 50, damping: 20 }\n  });\n  const strokeDashoffset = interpolate(boxDrawProgress, [0, 1], [perimeter, 0]);\n\n  // 4. Subtitle Text: Fades in inside the box\n  const subtitleOpacity = interpolate(frame, [morphStartFrame + 20, morphStartFrame + 45], [0, 1]);\n\n  // 5. Header: Subtle fade in\n  const headerOpacity = interpolate(frame, [10, 50], [0, 0.5]);\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: backgroundColor,\n    color: '#ffffff',\n    fontFamily: 'Inter, system-ui, sans-serif',\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    overflow: 'hidden',\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n  };\n\n  // Cinematic glow (Upper-left light bleed)\n  const glowStyle = {\n    position: 'absolute',\n    top: -300,\n    left: -200,\n    width: 1400,\n    height: 1400,\n    background: `radial-gradient(circle, ${glowColorAccent} 0%, ${glowColorPrimary} 35%, transparent 70%)`,\n    opacity: 0.35,\n    filter: 'blur(100px)',\n    zIndex: 0,\n    transform: 'translate3d(0,0,0)', // GPU hint\n  };\n\n  // Top Header Row\n  const headerStyle = {\n    position: 'absolute',\n    top: 80,\n    width: '100%',\n    display: 'flex',\n    justifyContent: 'center',\n    gap: 120,\n    zIndex: 1,\n    opacity: headerOpacity,\n  };\n\n  const headerLabelStyle = {\n    fontSize: 20,\n    fontWeight: 700,\n    letterSpacing: 6,\n    color: 'rgba(255,255,255,0.7)',\n    textTransform: 'uppercase',\n  };\n\n  // Center Stage\n  const centerContainerStyle = {\n    position: 'relative',\n    zIndex: 2,\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'center',\n    justifyContent: 'center',\n    height: 400,\n    marginTop: -50, // Optical centering adjustment\n  };\n\n  const initialsStyle = {\n    position: 'absolute',\n    fontSize: 140,\n    fontWeight: 800,\n    opacity: initialsOpacity,\n    transform: `scale(${initialsScale})`,\n    letterSpacing: 15,\n    whiteSpace: 'nowrap',\n    textShadow: '0 10px 40px rgba(0,0,0,0.5)',\n  };\n\n  const titleStyle = {\n    fontSize: 200,\n    fontWeight: 900,\n    lineHeight: 0.85,\n    textAlign: 'center',\n    opacity: titleOpacity,\n    transform: `scale(${titleScale})`,\n    textShadow: '0 20px 60px rgba(0,0,0,0.6)',\n    letterSpacing: -5,\n    width: '100%',\n  };\n\n  // Subtitle Box\n  const subtitleContainerStyle = {\n    position: 'relative',\n    width: boxWidth,\n    height: boxHeight,\n    marginTop: 60,\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    zIndex: 2,\n  };\n\n  const subtitleTextStyle = {\n    fontSize: 32,\n    fontStyle: 'italic',\n    fontWeight: 300,\n    opacity: subtitleOpacity,\n    textAlign: 'center',\n    width: '90%',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={glowStyle} />\n\n      {/* Top Decoration */}\n      <div style={headerStyle}>\n        <span style={headerLabelStyle}>{headerText}</span>\n        <span style={headerLabelStyle}>{headerText}</span>\n        <span style={headerLabelStyle}>{headerText}</span>\n      </div>\n\n      {/* Main Animation */}\n      <div style={centerContainerStyle}>\n        <div style={initialsStyle}>{initialsText}</div>\n        <div style={titleStyle}>{titleText}</div>\n      </div>\n\n      {/* Footer Box */}\n      <div style={subtitleContainerStyle}>\n        <svg\n          width={boxWidth}\n          height={boxHeight}\n          style={{ position: 'absolute', top: 0, left: 0 }}\n        >\n          <rect\n            x={2}\n            y={2}\n            width={boxWidth - 4}\n            height={boxHeight - 4}\n            fill=\"none\"\n            stroke=\"rgba(255,255,255,0.9)\"\n            strokeWidth={3}\n            strokeDasharray={perimeter}\n            strokeDashoffset={strokeDashoffset}\n          />\n        </svg>\n        <div style={subtitleTextStyle}>{subtitleText}</div>\n      </div>\n    </div>\n  );\n};"
 },
