  ],
  "thumb": "/thumbnails/1b06459e-b43f-4a46-9e0f-dd3f67202373.jpg",
  "code": "const SmartTitlesCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'NORA KESSLER';\n  const subtitleText = props.subtitleText || 'Founder / Chief Product Officer';\n  const accentColor = props.accentColor || '#f3afa3';\n  const photoBgColor = props.photoBgColor || '#8ed5ff';\n  const textColor = props.textColor || '#000000';\n  const borderColor = props.borderColor || '#000000';\n  const bgColor = props.bgColor || '#FFFFFF';\n  const photoUrl = props.photoUrl || '';\n  const textFontFamily = props.textFontFamily || '\"Press Start 2P\", monospace';\n\n  const DESIGN_WIDTH = 960;\n  const DESIGN_HEIGHT = 180;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n\n  // Animations\n  const cardEntrance = spring({ frame: Math.max(0, frame - 5), fps: safeFps, config: { damping: 14 } });\n  const photoEntrance = spring({ frame: Math.max(0, frame - 18), fps: safeFps, config: { damping: 14 } });\n  const textEntrance = spring({ frame: Math.max(0, frame - 28), fps: safeFps, config: { damping: 14 } });\n\n  const cardTranslateY = interpolate(cardEntrance, [0, 1], [300, 0]);\n  const textTranslateX = interpolate(textEntrance, [0, 1], [40, 0]);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n  };\n\n  // Using slightly smaller size than 860x160 to safely fit the 12px shadow in 960x180\n  const cardWidth = 840;\n  const cardHeight = 140;\n\n  const layerStyle = {\n    position: 'absolute',\n    width: cardWidth,\n    height: cardHeight,\n    backgroundColor: bgColor,\n    border: `2px solid ${borderColor}`,\n    boxSizing: 'border-box'\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* Card Wrapper for positioning and slide-in */}\n      <div style={{\n        position: 'absolute',\n        left: (DESIGN_WIDTH - cardWidth - 12) / 2,\n        top: (DESIGN_HEIGHT - cardHeight - 12) / 2,\n        width: cardWidth + 12,\n        height: cardHeight + 12,\n        transform: `translateY(${cardTranslateY}px)`\n      }}>\n        {/* Bottom Shadow */}\n        <div style={{...layerStyle, left: 12, top: 12}} />\n\n        {/* Middle Shadow */}\n        <div style={{...layerStyle, left: 6, top: 6}} />\n\n        {/* Main Content Layer */}\n        <div style={{\n          ...layerStyle,\n          left: 0, top: 0,\n          display: 'flex',\n          flexDirection: 'column',\n          overflow: 'hidden'\n        }}>\n          {/* Top Accent Line */}\n          <div style={{\n            width: '100%',\n            height: 8,\n            backgroundColor: accentColor,\n            borderBottom: `2px solid ${borderColor}`,\n            boxSizing: 'border-box',\n            flexShrink: 0\n          }} />\n\n          {/* Lower Section */}\n          <div style={{\n            display: 'flex',\n            flexDirection: 'row',\n            flex: 1,\n            boxSizing: 'border-box'\n          }}>\n            {/* Left Photo/Color Block */}\n            <div style={{\n              width: 200,\n              height: '100%',\n              backgroundColor: photoBgColor,\n              borderRight: `2px solid ${borderColor}`,\n              boxSizing: 'border-box',\n              transform: `scaleX(${photoEntrance})`,\n              transformOrigin: 'left',\n              overflow: 'hidden',\n              display: 'flex',\n              alignItems: 'center',\n              justifyContent: 'center'\n            }}>\n              {photoUrl ? (\n                <Img src={photoUrl} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />\n              ) : null}\n            </div>\n\n            {/* Right Text Area */}\n            <div style={{\n              flex: 1,\n              display: 'flex',\n              flexDirection: 'column',\n              justifyContent: 'center',\n              paddingLeft: 30,\n              opacity: textEntrance,\n              transform: `translateX(${textTranslateX}px)`\n            }}>\n              <div style={{\n                fontFamily: textFontFamily,\n                fontSize: 20,\n                color: textColor,\n                marginBottom: 12,\n                lineHeight: 1\n              }}>\n                {titleText}\n              </div>\n              <div style={{\n                fontFamily: textFontFamily,\n                fontSize: 9,\n                color: textColor,\n                opacity: 0.8,\n                lineHeight: 1.5\n              }}>\n                {subtitleText}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
