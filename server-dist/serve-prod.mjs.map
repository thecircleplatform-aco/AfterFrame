  "thumb": "/thumbnails/588b4fb1-6178-4e49-a8f9-42e947c0e4fc.jpg",
  "code": "const ModernSlide = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps, durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const bodyText = props.bodyText;\n  const titleColor = props.titleColor;\n  const bodyColor = props.bodyColor;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const fontFamilyTitle = props.fontFamilyTitle;\n  const fontFamilyBody = props.fontFamilyBody;\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n  const safeFps = fps || 30;\n  const safeDuration = durationInFrames || 150;\n\n  // Intro Springs\n  const titleSpr1 = spring({ frame: Math.max(0, frame - 5), fps: safeFps, config: { damping: 16, mass: 0.8 } });\n  const titleSpr2 = spring({ frame: Math.max(0, frame - 12), fps: safeFps, config: { damping: 16, mass: 0.8 } });\n  const bodySpr = spring({ frame: Math.max(0, frame - 22), fps: safeFps, config: { damping: 15, mass: 1 } });\n\n  // Outro interpolation\n  const fadeOutStart = safeDuration - 20;\n  const globalOpacity = interpolate(frame, [fadeOutStart, Math.max(fadeOutStart + 1, fadeOutStart + 15)], [1, 0], { extrapolateRight: 'clamp', extrapolateLeft: 'clamp' });\n\n  // Split title lines safely\n  const titleLines = titleText.split('\\n');\n  const line1 = titleLines[0] || \"\";\n  const line2 = titleLines.length > 1 ? titleLines.slice(1).join(' ') : \"\";\n\n  // Blob animations\n  const blobIntro = interpolate(frame, [0, 45], [0, 0.85], { extrapolateRight: 'clamp' });\n  const blobScale = 1 + Math.sin(frame / 40) * 0.1;\n  const blobRotate = frame * 0.15;\n\n  return (\n     <div style={{ position: 'absolute', inset: 0, backgroundColor, opacity: globalOpacity, overflow: 'hidden' }}>\n        {/* Blob Backgrounds using CSS radial gradients for safe WebGL capture */}\n        <div style={{\n            position: 'absolute',\n            top: '-40%',\n            right: '-10%',\n            width: '1400px',\n            height: '1400px',\n            background: `radial-gradient(circle at center, ${blobColor1} 0%, transparent 65%)`,\n            opacity: blobIntro,\n            transform: `scale(${blobScale}) rotate(${blobRotate}deg)`,\n            pointerEvents: 'none'\n        }} />\n         <div style={{\n            position: 'absolute',\n            top: '-20%',\n            right: '-30%',\n            width: '1600px',\n            height: '1600px',\n            background: `radial-gradient(circle at center, ${blobColor2} 0%, transparent 60%)`,\n            opacity: blobIntro * 0.7,\n            transform: `scale(${blobScale * 1.05}) rotate(${-blobRotate * 0.5}deg)`,\n            pointerEvents: 'none'\n        }} />\n\n        {/* Content */}\n        <div style={{\n            display: 'flex',\n            flexDirection: 'column',\n            justifyContent: 'center',\n            height: '100%',\n            paddingLeft: '15%',\n            zIndex: 10\n        }}>\n            <h1 style={{\n                margin: 0,\n                fontFamily: fontFamilyTitle,\n                fontSize: '56px',\n                fontWeight: '300',\n                letterSpacing: '0.15em',\n                color: titleColor,\n                lineHeight: '1.1',\n                textTransform: 'uppercase'\n            }}>\n                <div style={{ overflow: 'hidden', paddingBottom: '10px' }}>\n                    <div style={{ transform: `translateY(${(1 - titleSpr1) * 100}%)`, opacity: titleSpr1 }}>{line1}</div>\n                </div>\n                {line2 && (\n                  <div style={{ overflow: 'hidden', paddingBottom: '10px' }}>\n                      <div style={{ transform: `translateY(${(1 - titleSpr2) * 100}%)`, opacity: titleSpr2 }}>{line2}</div>\n                  </div>\n                )}\n            </h1>\n            <div style={{\n                marginTop: '50px',\n                maxWidth: '750px',\n                fontFamily: fontFamilyBody,\n                fontSize: '28px',\n                color: bodyColor,\n                lineHeight: '1.6',\n                fontWeight: '400',\n                opacity: bodySpr,\n                transform: `translateY(${(1 - bodySpr) * 30}px)`\n            }}>\n                {bodyText}\n            </div>\n        </div>\n     </div>\n  );\n}"
 },
