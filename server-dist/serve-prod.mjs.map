  "thumb": "/thumbnails/c430c730-8ff2-4a4b-86af-230563431c49.jpg",
  "code": "const SalesTrendChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n  const titleText = props.titleText || 'Listener Growth';\n  const kpi1Value = props.kpi1Value || '38%';\n  const kpi1Label = props.kpi1Label || 'stream count';\n  const kpi1Color = props.kpi1Color || '#42c36a';\n  const kpi2Value = props.kpi2Value || '12%';\n  const kpi2Label = props.kpi2Label || 'download count';\n  const kpi2Color = props.kpi2Color || '#907800';\n  const backgroundColor = props.backgroundColor || '#E8E6F0';\n  const cardColor = props.cardColor || '#FFFFFF';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const springConfig = { damping: 20, stiffness: 100, mass: 0.8 };\n  const slowSpringConfig = { damping: 100, stiffness: 30, mass: 1 };\n\n  const cardEntrance = spring({ frame: Math.max(0, frame), fps, config: springConfig });\n  const contentEntrance = spring({ frame: Math.max(0, frame - 15), fps, config: springConfig });\n  const lineProgress = spring({ frame: Math.max(0, frame - 25), fps, config: slowSpringConfig });\n\n  const months = ['January', 'February', 'March', 'April', 'May', 'June'];\n  const dataGreen = [15, 22, 28, 30, 36, 40];\n  const dataPurple = [5, 8, 5, 6, 7, 8];\n\n  // Chart sizing\n  // yLabelX: where Y-axis \"0%/25%...\" labels sit (textAnchor end)\n  // plotLeft: where the plot area and first data point start — must be clearly to the right of yLabelX\n  // padX: symmetric right-side padding so last dot doesn't clip\n  const yLabelX = 0;       // Y labels end here\n  const plotLeft = 80;     // plot starts here — 80px gap from Y labels\n  const padX = 40;         // right-side padding\n  const plotWidth = 900 - plotLeft - padX; // remaining width for the lines\n  const chartHeight = 320;\n  const getX = (index) => plotLeft + (index / (months.length - 1)) * plotWidth;\n  const getY = (val) => chartHeight - (val / 100) * chartHeight;\n\n  const createPath = (data) => {\n    return data.map((val, i) => {\n      const x = getX(i);\n      const y = getY(val);\n      return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;\n    }).join(' ');\n  };\n\n  const pathGreen = createPath(dataGreen);\n  const pathPurple = createPath(dataPurple);\n  const pathLength = 1200;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: backgroundColor,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    display: 'flex',\n    alignItems: 'center',\n    justifyContent: 'center',\n    fontFamily: 'Inter, sans-serif',\n    overflow: 'hidden',\n  };\n\n  const cardStyle = {\n    width: 1400,\n    height: 800,\n    backgroundColor: cardColor,\n    borderRadius: 40,\n    boxShadow: '0 30px 80px rgba(0,0,0,0.08)',\n    padding: '80px 100px',\n    position: 'relative',\n    display: 'flex',\n    flexDirection: 'column',\n    opacity: cardEntrance,\n    transform: `translateY(${(1 - cardEntrance) * 40}px) scale(${0.95 + 0.05 * cardEntrance})`,\n    overflow: 'hidden',\n  };\n\n  const headerRowStyle = {\n    display: 'flex',\n    justifyContent: 'space-between',\n    alignItems: 'flex-start',\n    marginBottom: 40,\n    opacity: contentEntrance,\n    transform: `translateX(${(1 - contentEntrance) * -20}px)`,\n  };\n\n  const titleStyle = {\n    fontSize: 56,\n    fontWeight: 700,\n    color: '#333333',\n    margin: 0,\n    letterSpacing: '-0.02em',\n  };\n\n  const kpiGroupStyle = {\n    display: 'flex',\n    gap: 80,\n  };\n\n  const kpiItemStyle = {\n    display: 'flex',\n    flexDirection: 'column',\n    alignItems: 'flex-end',\n  };\n\n  const kpiValueStyle = (color) => ({\n    fontSize: 64,\n    fontWeight: 800,\n    color: color,\n    lineHeight: 1,\n    marginBottom: 8,\n  });\n\n  const kpiLabelStyle = {\n    fontSize: 18,\n    fontWeight: 600,\n    color: '#9E9E9E',\n    textTransform: 'uppercase',\n    letterSpacing: '0.05em',\n  };\n\n  const DnaWatermark = () => {\n    const rungs = 8;\n    return (\n      <div style={{\n        position: 'absolute',\n        right: -100,\n        top: '20%',\n        width: 400,\n        height: 600,\n        opacity: 0.06,\n        transform: 'rotate(-15deg)',\n        pointerEvents: 'none',\n      }}>\n        <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 200 600\">\n          <path d=\"M 60,0 Q 140,75 60,150 T 60,300 T 60,450\" fill=\"none\" stroke=\"#000\" strokeWidth=\"8\" />\n          <path d=\"M 140,0 Q 60,75 140,150 T 140,300 T 140,450\" fill=\"none\" stroke=\"#000\" strokeWidth=\"8\" />\n          {new Array(rungs).fill(0).map((_, i) => (\n            <line key={i} x1=\"60\" y1={30 + i * 60} x2=\"140\" y2={30 + i * 60} stroke=\"#000\" strokeWidth=\"6\" strokeLinecap=\"round\" />\n          ))}\n        </svg>\n      </div>\n    );\n  };\n\n  // viewBox: starts 20px left of yLabelX(0), ends 20px right of plotLeft+plotWidth+padX(900)\n  const vbLeft = -20;\n  const vbTop = -20;\n  const vbWidth = 940;  // 20 left margin + 900 + 20 right margin\n  const vbHeight = chartHeight + 80;\n\n  return (\n    <div style={rootStyle}>\n      <div style={cardStyle}>\n        <DnaWatermark />\n\n        <div style={headerRowStyle}>\n          <h1 style={titleStyle}>{titleText}</h1>\n          <div style={kpiGroupStyle}>\n            <div style={kpiItemStyle}>\n              <span style={kpiValueStyle(kpi1Color)}>{kpi1Value}</span>\n              <span style={kpiLabelStyle}>{kpi1Label}</span>\n            </div>\n            <div style={kpiItemStyle}>\n              <span style={kpiValueStyle(kpi2Color)}>{kpi2Value}</span>\n              <span style={kpiLabelStyle}>{kpi2Label}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Chart container — flex:1 fills remaining card space after header */}\n        <div style={{ position: 'relative', flex: 1, minHeight: 0 }}>\n          <svg\n            width=\"100%\"\n            height=\"100%\"\n            viewBox={`${vbLeft} ${vbTop} ${vbWidth} ${vbHeight}`}\n            preserveAspectRatio=\"xMidYMid meet\"\n          >\n            {/* Grid & Y-Labels */}\n            {[0, 25, 50, 75, 100].map((tick) => (\n              <g key={tick} opacity={contentEntrance}>\n                <line\n                  x1={plotLeft} y1={getY(tick)}\n                  x2={plotLeft + plotWidth} y2={getY(tick)}\n                  stroke=\"#EEEEEE\"\n                  strokeWidth=\"2\"\n                  strokeDasharray=\"6,6\"\n                />\n                <text\n                  x={yLabelX} y={getY(tick) + 6}\n                  textAnchor=\"end\"\n                  fill=\"#B0B0B0\"\n                  fontSize=\"16\"\n                  fontWeight=\"500\"\n                >\n                  {tick}%\n                </text>\n              </g>\n            ))}\n\n            {/* X-Labels */}\n            {months.map((m, i) => (\n              <text\n                key={m}\n                x={getX(i)} y={chartHeight + 36}\n                textAnchor=\"middle\"\n                fill=\"#909090\"\n                fontSize=\"16\"\n                fontWeight=\"600\"\n                opacity={contentEntrance}\n              >\n                {m}\n              </text>\n            ))}\n\n            {/* Lines */}\n            <path\n              d={pathGreen}\n              fill=\"none\"\n              stroke={kpi1Color}\n              strokeWidth=\"6\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              strokeDasharray={pathLength}\n              strokeDashoffset={pathLength * (1 - Math.min(1, lineProgress * 1.5))}\n            />\n            <path\n              d={pathPurple}\n              fill=\"none\"\n              stroke={kpi2Color}\n              strokeWidth=\"6\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              strokeDasharray={pathLength}\n              strokeDashoffset={pathLength * (1 - Math.min(1, lineProgress * 1.5))}\n            />\n\n            {/* Dots Green */}\n            {dataGreen.map((val, i) => {\n              const cx = getX(i);\n              const cy = getY(val);\n              const dotScale = spring({\n                frame: Math.max(0, frame - 30 - i * 5),\n                fps,\n                config: { damping: 15, stiffness: 200 },\n              });\n              return (\n                <circle\n                  key={`g-${i}`}\n                  cx={cx} cy={cy} r={8}\n                  fill=\"#FFFFFF\"\n                  stroke={kpi1Color}\n                  strokeWidth=\"5\"\n                  style={{ transformOrigin: `${cx}px ${cy}px`, transform: `scale(${dotScale})` }}\n                />\n              );\n            })}\n\n            {/* Dots Purple */}\n            {dataPurple.map((val, i) => {\n              const cx = getX(i);\n              const cy = getY(val);\n              const dotScale = spring({\n                frame: Math.max(0, frame - 30 - i * 5),\n                fps,\n                config: { damping: 15, stiffness: 200 },\n              });\n              return (\n                <circle\n                  key={`p-${i}`}\n                  cx={cx} cy={cy} r={8}\n                  fill=\"#FFFFFF\"\n                  stroke={kpi2Color}\n                  strokeWidth=\"5\"\n                  style={{ transformOrigin: `${cx}px ${cy}px`, transform: `scale(${dotScale})` }}\n                />\n              );\n            })}\n          </svg>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
 },
 {
  "id": "033ce93d-219c-4100-9b53-83adf2e19d39",
  "name": "Line Chart - Stock Price",
  "category": "data-visualization",
  "description": "Dark-themed financial line chart with gradient stroke, smooth draw-on animation, and staggered data points.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "Share Price Momentum",
   "bgColor": "#212038",
   "lineColorStart": "#f174b7",
   "lineColorEnd": "#c26cd2",
   "textColor": "#FFFFFF",
   "gridColor": "rgba(255, 255, 255, 0.1)"
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "Share Price Momentum",
    "label": "Title"
   },
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#212038",
    "label": "Background Color"
   },
   {
    "key": "lineColorStart",
    "type": "color",
    "defaultValue": "#f174b7",
    "label": "Line Gradient Start"
   },
   {
    "key": "lineColorEnd",
    "type": "color",
    "defaultValue": "#c26cd2",
    "label": "Line Gradient End"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#FFFFFF",
    "label": "Text Color"
   },
   {
    "key": "gridColor",
    "type": "color",
    "defaultValue": "rgba(255, 255, 255, 0.1)",
    "label": "Grid Line Color"
   }
  ],
  "thumb": "/thumbnails/033ce93d-219c-4100-9b53-83adf2e19d39.jpg",
  "code": "// @bust:1774433868021\nconst StockChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n\n  // Editable Properties\n  const props = item.props || {};\n  const titleText = props.titleText || 'Share Price Momentum';\n  const bgColor = props.bgColor || '#212038';\n  const lineColorStart = props.lineColorStart || '#f174b7';\n  const lineColorEnd = props.lineColorEnd || '#c26cd2';\n  const textColor = props.textColor || '#FFFFFF';\n  const gridColor = props.gridColor || 'rgba(255, 255, 255, 0.1)';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n\n  // Responsive Scaling\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  // Chart Configuration\n  const data = [128, 142, 135, 156, 171, 163, 189, 204, 198, 221, 235, 248];\n  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n  const yMin = 100;\n  const yMax = 260;\n  const margin = { top: 220, right: 120, bottom: 180, left: 180 };\n  const graphWidth = DESIGN_WIDTH - margin.left - margin.right;\n  const graphHeight = DESIGN_HEIGHT - margin.top - margin.bottom;\n\n  // Helper Functions\n  const getX = (index) => margin.left + (index / (data.length - 1)) * graphWidth;\n  const getY = (val) => margin.top + graphHeight - ((val - yMin) / (yMax - yMin)) * graphHeight;\n\n  // Generate Path Strings\n  const points = data.map((val, i) => `${getX(i)},${getY(val)}`);\n  const linePath = `M ${points.join(' L ')}`;\n  const areaPath = `M ${getX(0)},${margin.top + graphHeight} L ${points.join(' L ')} L ${getX(data.length - 1)},${margin.top + graphHeight} Z`;\n\n  // Animation Logic\n  // 1. Title Entrance\n  const titleProgress = spring({ frame, fps, config: { damping: 15 } });\n  const titleY = interpolate(titleProgress, [0, 1], [-40, 0]);\n  const titleOpacity = interpolate(titleProgress, [0, 1], [0, 1]);\n\n  // 2. Grid Fade In\n  const gridOpacity = interpolate(frame, [10, 30], [0, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n  // 3. Line Drawing (Reveal via Mask)\n  const drawT = interpolate(frame, [15, 75], [0, 1], {\n    easing: Easing.bezier(0.25, 0.1, 0.25, 1),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  // 4. Staggered Dots Pop-in — delay synced with line draw progress\n  // Line draws from frame 15 to 75 (60 frames), each dot appears when line reaches it\n  const getDotScale = (index) => {\n    const lineDrawStart = 15;\n    const lineDrawDuration = 60;\n    const delay = lineDrawStart + (index / (data.length - 1)) * lineDrawDuration;\n    if (frame < delay) return 0;\n    return Math.min(1, spring({\n      frame: frame - delay,\n      fps,\n      config: { stiffness: 150, damping: 12 }\n    }));\n  };\n\n  // Styles\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    backgroundColor: bgColor,\n    fontFamily: fontFamily,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    overflow: 'hidden',\n    color: textColor,\n  };\n\n  const titleStyle = {\n    position: 'absolute',\n    left: margin.left,\n    top: 80,\n    fontSize: '80px',\n    fontWeight: 700,\n    opacity: titleOpacity,\n    transform: `translateY(${titleY}px)`,\n    margin: 0,\n  };\n\n  return (\n    <div style={rootStyle}>\n      <h1 style={titleStyle}>{titleText}</h1>\n\n      <svg width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={{ position: 'absolute', top: 0, left: 0 }}>\n        <defs>\n          <linearGradient id=\"lineGradient\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0%\" stopColor={lineColorStart} />\n            <stop offset=\"100%\" stopColor={lineColorEnd} />\n          </linearGradient>\n          \n          <linearGradient id=\"areaGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stopColor={lineColorStart} stopOpacity=\"0.4\" />\n            <stop offset=\"100%\" stopColor={lineColorEnd} stopOpacity=\"0\" />\n          </linearGradient>\n\n          <clipPath id=\"drawClip\">\n            <rect\n              x={margin.left}\n              y={0}\n              width={graphWidth * drawT}\n              height={DESIGN_HEIGHT}\n            />\n          </clipPath>\n        </defs>\n\n        {/* Grid Lines & Y-Axis Labels */}\n        <g style={{ opacity: gridOpacity }}>\n          {[100, 140, 180, 220, 260].map((val) => (\n            <g key={val}>\n              <line\n                x1={margin.left}\n                y1={getY(val)}\n                x2={margin.left + graphWidth}\n                y2={getY(val)}\n                stroke={gridColor}\n                strokeWidth=\"2\"\n              />\n              <text\n                x={margin.left - 30}\n                y={getY(val) + 12}\n                fill={textColor}\n                fillOpacity=\"0.6\"\n                fontSize=\"32\"\n                textAnchor=\"end\"\n                fontWeight=\"500\"\n              >\n                {val}\n              </text>\n            </g>\n          ))}\n\n          {/* X-Axis Labels */}\n          {months.map((m, i) => (\n            <text\n              key={i}\n              x={getX(i)}\n              y={margin.top + graphHeight + 60}\n              fill={textColor}\n              fillOpacity=\"0.6\"\n              fontSize=\"32\"\n              textAnchor=\"middle\"\n              fontWeight=\"500\"\n            >\n              {m}\n            </text>\n          ))}\n        </g>\n\n        {/* Data Chart (Clipped for animation) */}\n        <g clipPath=\"url(#drawClip)\">\n          <path d={areaPath} fill=\"url(#areaGradient)\" />\n          <path\n            d={linePath}\n            fill=\"none\"\n            stroke=\"url(#lineGradient)\"\n            strokeWidth=\"6\"\n            strokeLinecap=\"round\"\n            strokeLinejoin=\"round\"\n          />\n        </g>\n\n        {/* Data Points (Staggered Pop) */}\n        {data.map((val, i) => {\n          const s = getDotScale(i);\n          return (\n            <g key={i} transform={`translate(${getX(i)}, ${getY(val)}) scale(${s})`}>\n              <circle\n                r=\"10\"\n                fill={bgColor}\n                stroke={lineColorEnd}\n                strokeWidth=\"4\"\n              />\n            </g>\n          );\n        })}\n      </svg>\n    </div>\n  );\n};"
 },
 {
  "id": "c206d9e8-7cc6-428f-a030-65f5758641a5",
  "name": "Line Chart - Temperature Change",
  "category": "data-visualization",
  "description": "An elegant spline-based line chart with a dark gradient background, animated grid, and peak/trough highlighting. Designed for infographic data visualization.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {},
  "propSchema": [],
  "thumb": "/thumbnails/c206d9e8-7cc6-428f-a030-65f5758641a5.jpg",
  "code": "const TemperatureChart = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  const props = item.props || {};\n\n  const title = props.title || 'RAINFALL TRENDS';\n  const subtitle = props.subtitle || 'Monthly Average Rainfall (mm)';\n  const bgStart = props.bgStart || '#001518';\n  const bgEnd = props.bgEnd || '#133b40';\n  const lineColor = props.lineColor || '#00c1a9';\n  const dataValues = [-3, 1, 9, 18, 24, 29, 32, 31, 24, 15, 6, -1];\n  const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n  const safeFps = fps || 30;\n\n  const ML = 220, MR = 180, MT = 340, MB = 220;\n  const CW = DESIGN_WIDTH - ML - MR;\n  const CH = DESIGN_HEIGHT - MT - MB;\n  const Y_MIN = -10, Y_MAX = 40;\n\n  const getX = (i) => (i / (dataValues.length - 1)) * CW;\n  const getY = (v) => CH - ((v - Y_MIN) / (Y_MAX - Y_MIN)) * CH;\n\n  const generatePath = (pts) => {\n    let d = `M ${getX(0)} ${getY(pts[0])}`;\n    for (let i = 0; i < pts.length - 1; i++) {\n      const x1 = getX(i), y1 = getY(pts[i]);\n      const x2 = getX(i + 1), y2 = getY(pts[i + 1]);\n      const cp1x = x1 + (x2 - x1) / 3;\n      const cp2x = x2 - (x2 - x1) / 3;\n      d += ` C ${cp1x} ${y1}, ${cp2x} ${y2}, ${x2} ${y2}`;\n    }\n    return d;\n  };\n\n  const pathD = generatePath(dataValues);\n\n  const lineProgress = spring({ frame, fps: safeFps,\n    config: { damping: 22, stiffness: 50, mass: 1.5 } });\n\n  const titleSpring = spring({ frame, fps: safeFps, config: { damping: 22, stiffness: 90 } });\n  const titleOpacity = interpolate(titleSpring, [0, 1], [0, 1]);\n  const titleY = interpolate(titleSpring, [0, 1], [-40, 0]);\n\n  const gridVals = [-10, 0, 10, 20, 30, 40];\n  const maxVal = Math.max(...dataValues);\n  const minVal = Math.min(...dataValues);\n\n  return (\n    <div style={{\n      position: 'absolute', top: 0, left: 0,\n      width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n      background: `linear-gradient(135deg, ${bgStart} 0%, ${bgEnd} 100%)`,\n      transform: `scale(${scale})`, transformOrigin: 'top left',\n      overflow: 'hidden', fontFamily: \"'Inter', sans-serif\", color: '#cfecd7',\n    }}>\n      <div style={{\n        position: 'absolute', top: 0, left: 0, right: 0, height: 3,\n        background: `linear-gradient(90deg, transparent, ${lineColor}, transparent)`,\n        opacity: titleOpacity,\n      }} />\n\n      <div style={{\n        position: 'absolute', top: 80, width: '100%', textAlign: 'center',\n        opacity: titleOpacity, transform: `translateY(${titleY}px)`,\n      }}>\n        <div style={{ fontSize: 72, fontWeight: 900, letterSpacing: '0.08em', textTransform: 'uppercase',\n          textShadow: `0 0 40px ${lineColor}88` }}>{title}</div>\n        <div style={{ fontSize: 28, fontWeight: 300, marginTop: 14, opacity: 0.7, letterSpacing: '0.12em' }}>{subtitle}</div>\n      </div>\n\n      <svg style={{ position: 'absolute', top: MT, left: ML }}\n        width={CW} height={CH} overflow=\"visible\">\n        <defs>\n          <linearGradient id=\"lineGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n            <stop offset=\"0%\" stopColor=\"#4cb158\" />\n            <stop offset=\"50%\" stopColor={lineColor} />\n            <stop offset=\"100%\" stopColor=\"#c39a00\" />\n          </linearGradient>\n          <filter id=\"glowTemp\">\n            <feGaussianBlur stdDeviation=\"4\" result=\"blur\" />\n            <feMerge><feMergeNode in=\"blur\" /><feMergeNode in=\"SourceGraphic\" /></feMerge>\n          </filter>\n          <clipPath id=\"lineClip\">\n            <rect x={0} y={-60} width={CW * lineProgress} height={CH + 120} />\n          </clipPath>\n        </defs>\n\n        {/* Grid lines */}\n        {gridVals.map((val, i) => {\n          const y = getY(val);\n          const op = interpolate(frame, [8 + i * 3, 26 + i * 3], [0, 0.28], { extrapolateRight: 'clamp' });\n          return (\n            <g key={val} opacity={op}>\n              <line x1={0} y1={y} x2={CW} y2={y} stroke=\"#cfecd7\" strokeWidth={val === 0 ? 1.5 : 1} />\n              <text x={-16} y={y + 6} fill=\"#cfecd7\" fontSize={20}\n                fontFamily=\"'IBM Plex Mono', monospace\" textAnchor=\"end\" opacity={3}>{val}°</text>\n            </g>\n          );\n        })}\n\n        {/* X labels */}\n        {months.map((m, i) => {\n          const x = getX(i);\n          const op = interpolate(frame, [20 + i * 2, 36 + i * 2], [0, 0.65], { extrapolateRight: 'clamp' });\n          return (\n            <text key={m} x={x} y={CH + 48} fill=\"#cfecd7\" fontSize={18}\n              fontFamily=\"'IBM Plex Mono', monospace\" textAnchor=\"middle\" opacity={op}>{m}</text>\n          );\n        })}\n\n        {/* Area fill */}\n        <path\n          d={pathD + ` L ${getX(dataValues.length - 1)} ${CH} L ${getX(0)} ${CH} Z`}\n          fill={`url(#lineGrad)`} opacity={0.07}\n          clipPath=\"url(#lineClip)\"\n        />\n\n        {/* Main line */}\n        <path d={pathD} fill=\"none\" stroke=\"url(#lineGrad)\" strokeWidth={6}\n          strokeLinecap=\"round\" clipPath=\"url(#lineClip)\"\n          filter=\"url(#glowTemp)\" />\n\n        {/* Data points */}\n        {dataValues.map((v, i) => {\n          const tp = i / (dataValues.length - 1);\n          const vis = lineProgress >= tp - 0.04;\n          const s = spring({ frame: Math.max(0, frame - tp * 45), fps: safeFps,\n            config: { stiffness: 140, damping: 12 } });\n          const isExtrema = v === maxVal || v === minVal;\n\n          return vis ? (\n            <g key={i} transform={`translate(${getX(i)}, ${getY(v)})`}>\n              <circle r={isExtrema ? 10 : 6} fill={lineColor}\n                style={{ transform: `scale(${s})`, transformOrigin: '0px 0px' }}\n                filter=\"url(#glowTemp)\" />\n              {isExtrema && (\n                <text y={v < 0 ? 38 : -22} fill=\"#fff\" fontSize={28} fontWeight={700}\n                  textAnchor=\"middle\" fontFamily=\"'IBM Plex Mono', monospace\"\n                  opacity={s}>{v}°C</text>\n              )}\n            </g>\n          ) : null;\n        })}\n      </svg>\n\n      <div style={{\n        position: 'absolute', bottom: 0, left: 0, right: 0, height: 2,\n        background: `linear-gradient(90deg, transparent, ${lineColor}88, transparent)`,\n        opacity: titleOpacity,\n      }} />\n    </div>\n  );\n};\n"
 },
 {
  "id": "0371e3ac-0449-4e8d-a5df-c758ccdbba44",
  "name": "Line Chart - User Growth",
  "category": "data-visualization",
  "description": "A sleek, pure color multi-line chart card showing two animated data streams and count-up KPIs.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "Workspace Growth",
   "kpi1Label": "Live Sessions",
   "kpi1Value": 12,
   "kpi2Label": "Trial Starts",
   "kpi2Value": 9,
   "xAxisLabels": "Sunday, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday",
   "line1Data": "20, 35, 28, 45, 38, 55, 62",
   "line2Data": "30, 28, 42, 35, 50, 45, 58",
   "line1Color": "#24bbff",
   "line2Color": "#009c9c",
   "bgColor": "#E8E6F0",
   "cardColor": "#FFFFFF",
   "titleColor": "#2D2D35"
  },
  "propSchema": [
   {
