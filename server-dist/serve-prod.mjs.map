  "thumb": "/thumbnails/b0e7ccf7-d84c-4baf-aca4-678d3ad4b11e.jpg",
  "code": "const SmartTitleCard = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || '8 RULES FOR HOSTS';\n  const topBannerColor = props.topBannerColor || '#85c692';\n  const fontFamily = props.fontFamily || '\"Press Start 2P\", monospace';\n  const textColor = props.textColor || '#000000';\n  const cardBgColor = props.cardBgColor || '#FFFFFF';\n  const borderColor = props.borderColor || '#000000';\n  const bannerImageUrl = props.bannerImageUrl || '';\n\n  const DESIGN_WIDTH = 960;\n  const DESIGN_HEIGHT = 260;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const rootStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`, transformOrigin: 'top left',\n    backgroundColor: 'transparent',\n  };\n\n  const safeFps = fps || 30;\n  const slideUp = spring({\n    frame,\n    fps: safeFps,\n    config: { damping: 14, stiffness: 90 }\n  });\n\n  const yOffset = interpolate(slideUp, [0, 1], [350, 0]);\n\n  const typeStartFrame = 25;\n  const framesPerChar = 2;\n  const visibleChars = Math.max(0, Math.floor((frame - typeStartFrame) / framesPerChar));\n  const displayedText = titleText.substring(0, visibleChars);\n\n  const groupStyle = {\n    position: 'absolute',\n    top: 10,\n    left: 42,\n    width: 860,\n    height: 226,\n    transform: `translateY(${yOffset}px)`,\n  };\n\n  const rectStyle = {\n    position: 'absolute', top: 0, left: 0,\n    width: '100%', height: '100%',\n    border: `2px solid ${borderColor}`,\n    backgroundColor: cardBgColor,\n    boxSizing: 'border-box',\n  };\n\n  const blink = Math.floor(frame / 15) % 2 === 0;\n\n  return (\n    <div style={rootStyle}>\n      <div style={groupStyle}>\n        <div style={{...rectStyle, transform: 'translate(15px, 15px)'}} />\n        <div style={{...rectStyle, transform: 'translate(10px, 10px)'}} />\n        <div style={{...rectStyle, transform: 'translate(5px, 5px)'}} />\n\n        <div style={{\n          ...rectStyle,\n          display: 'flex',\n          flexDirection: 'column',\n          overflow: 'hidden',\n        }}>\n          <div style={{\n            height: 110,\n            width: '100%',\n            backgroundColor: topBannerColor,\n            borderBottom: `2px solid ${borderColor}`,\n            boxSizing: 'border-box',\n            position: 'relative'\n          }}>\n            {bannerImageUrl ? (\n              <Img src={bannerImageUrl} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />\n            ) : null}\n          </div>\n\n          <div style={{\n            flex: 1,\n            display: 'flex',\n            alignItems: 'center',\n            padding: '0 30px',\n            backgroundColor: cardBgColor,\n            boxSizing: 'border-box',\n          }}>\n            <span style={{\n              fontFamily,\n              fontSize: '18px',\n              color: textColor,\n              lineHeight: 1.5,\n              whiteSpace: 'pre-wrap'\n            }}>\n              {displayedText}\n              <span style={{ opacity: blink ? 1 : 0 }}>█</span>\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
