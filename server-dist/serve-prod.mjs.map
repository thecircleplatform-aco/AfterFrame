    "thumb": "/thumbnails/ss-cta-follow.jpg",
    "code": "const ShortsCtaFollow = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const handle = p.handle || '@channel';\n  const ctaText = p.ctaText || '';\n  const buttonText = p.buttonText || '关注';\n  const accent = p.accentColor || '#fb7185';\n  const textColor = p.textColor || '#fff';\n  const enter = spring({ frame, fps, config: { damping: 14, stiffness: 100 } });\n  const pulse = 1 + Math.sin(frame / 6) * 0.03;\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent', justifyContent: 'flex-end', alignItems: 'center', paddingBottom: 280 }}>\n      <div style={{\n        opacity: enter * exit,\n        transform: `translateY(${(1 - enter) * 60}px) scale(${pulse})`,\n        alignItems: 'center',\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 20,\n      }}>\n        <div style={{\n          width: 140, height: 140, borderRadius: 999,\n          background: `linear-gradient(135deg, ${accent}, #6366f1)`,\n          border: '4px solid #fff',\n          boxShadow: '0 12px 40px #0008',\n        }} />\n        <div style={{ fontSize: 36, fontWeight: 800, color: textColor }}>{handle}</div>\n        <div style={{ fontSize: 28, color: textColor, opacity: 0.85 }}>{ctaText}</div>\n        <div style={{\n          marginTop: 8,\n          padding: '16px 48px',\n          borderRadius: 999,\n          background: accent,\n          color: '#fff',\n          fontSize: 32,\n          fontWeight: 800,\n          boxShadow: `0 8px 32px ${accent}88`,\n        }}>{buttonText}</div>\n      </div>\n    </AbsoluteFill>\n  );\n};"
