    "label": "transparentBackground"
   }
  ],
  "thumb": "/thumbnails/f11ec59a-6c28-4b03-8dae-e9e98516547d.jpg",
  "code": "const createTickerRow = (options) => {\n    const { top, delay, direction, opacity, fontSize, repeatText, mainFont, frame, fps } = options;\n    const flyIn = spring({ frame: Math.max(0, frame - delay), fps, config: { damping: 15 } });\n    const offsetX = interpolate(flyIn, [0, 1], [direction * 1500, 0]);\n    const rowStyle = { position: 'absolute', top, left: -500, width: 4000, display: 'flex', gap: '50px', transform: `translateX(${offsetX}px)`, opacity };\n    const textStyle = { fontSize, fontWeight: 900, fontStyle: 'italic', whiteSpace: 'nowrap', color: 'white', fontFamily: mainFont, textTransform: 'uppercase' };\n    const elements = Array(15).fill(0).map((_, i) => (<span key={i} style={textStyle}>{repeatText}</span>));\n    return <div style={rowStyle}>{elements}</div>;\n};\n\nconst createScatteredText = (options) => {\n    const { delay, top, left, fontSize, opacity, startX, outline, repeatText, mainFont, frame, fps } = options;\n    const flyIn = spring({ frame: Math.max(0, frame - delay), fps, config: { damping: 16, stiffness: 120 } });\n    const xOffset = interpolate(flyIn, [0, 1], [startX, 0]);\n    const style = { position: 'absolute', top, left, transform: `translateX(${xOffset}px)`, fontSize, fontWeight: 900, fontStyle: 'italic', opacity, whiteSpace: 'nowrap', textTransform: 'uppercase', fontFamily: mainFont, color: outline ? 'transparent' : 'white', WebkitTextStroke: outline ? '3px white' : 'none' };\n    return <div style={style}>{repeatText}</div>;\n};\n\nconst createRotatedContent = (options) => {\n    const { backgroundColor, transparentBackground, repeatText, mainFont, frame, fps } = options;\n    const gridStyle = { position: 'absolute', inset: 0, backgroundImage: `linear-gradient(to right, rgba(255,255,255,0.08) 2px, transparent 2px), linear-gradient(to bottom, rgba(255,255,255,0.08) 2px, transparent 2px)`, backgroundSize: '120px 120px' };\n    const containerStyle = { width: '100%', height: '100%', position: 'relative' };\n    const bgStyle = { position: 'absolute', inset: 0, backgroundColor };\n    const innerContainerStyle = { position: 'absolute', top: '50%', left: '50%', width: 2500, height: 2000, transform: 'translate(-50%, -50%) rotate(-8deg)', pointerEvents: 'none' };\n    return (\n        <div style={containerStyle}>\n            {!transparentBackground && <div style={bgStyle} />}\n            <div style={innerContainerStyle}>\n                <div style={gridStyle} />\n                {createTickerRow({ top: 200, delay: 10, direction: 1, opacity: 0.12, fontSize: 80, repeatText, mainFont, frame, fps })}\n                {createTickerRow({ top: 1600, delay: 15, direction: -1, opacity: 0.12, fontSize: 100, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 10, top: 400, left: 100, fontSize: 350, opacity: 0.03, startX: 1000, outline: false, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 12, top: 1100, left: 700, fontSize: 400, opacity: 0.02, startX: -1500, outline: false, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 14, top: 800, left: 200, fontSize: 150, opacity: 0.08, startX: -800, outline: false, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 16, top: 1000, left: 1500, fontSize: 180, opacity: 0.06, startX: 800, outline: false, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 18, top: 350, left: 1600, fontSize: 120, opacity: 0.1, startX: -500, outline: false, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 20, top: 1400, left: 300, fontSize: 160, opacity: 0.05, startX: 1000, outline: false, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 22, top: 850, left: 1700, fontSize: 200, opacity: 0.15, startX: 1200, outline: true, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 17, top: 650, left: 1150, fontSize: 60, opacity: 0.8, startX: 800, outline: false, repeatText, mainFont, frame, fps })}\n                {createScatteredText({ delay: 19, top: 1300, left: 1050, fontSize: 60, opacity: 0.8, startX: -800, outline: false, repeatText, mainFont, frame, fps })}\n            </div>\n        </div>\n    );\n};\n\nconst createWipeCol = (options) => {\n    const { left, delay, origin, width, backgroundColor, transparentBackground, repeatText, mainFont, frame, fps } = options;\n    const progress = spring({ frame: Math.max(0, frame - delay), fps, config: { damping: 20 } });\n    const wrapStyle = { position: 'absolute', left, top: 0, width, height: 1080, transformOrigin: origin, transform: `scaleY(${progress})`, overflow: 'hidden' };\n    const innerStyle = { position: 'absolute', left: -left, top: 0, width: 1920, height: 1080 };\n    return (\n        <div style={wrapStyle}>\n            <div style={innerStyle}>\n                {createRotatedContent({ backgroundColor, transparentBackground, repeatText, mainFont, frame, fps })}\n            </div>\n        </div>\n    );\n};\n\nconst createTitleLayer = (options) => {\n    const { delay, isTrail, color, mainFont, titleText, frame, fps } = options;\n    const localFrame = Math.max(0, frame - delay);\n    if (frame < delay) return null;\n    const scaleX = spring({ frame: localFrame, fps, config: { damping: 15, stiffness: 220 } });\n    const scaleY = spring({ frame: localFrame, fps, config: { damping: 15, stiffness: 180 } });\n    const translateY = interpolate(scaleY, [0, 1], [300, 0]);\n    const opacity = isTrail ? interpolate(localFrame, [0, 20], [0.6, 0], { extrapolateRight: 'clamp' }) : 1;\n    const shadowColor = '#260022';\n    const shadow = isTrail ? 'none' : `2px 2px 0 ${shadowColor}, 4px 4px 0 ${shadowColor}, 6px 6px 0 ${shadowColor}, 8px 8px 0 ${shadowColor}, 10px 10px 0 ${shadowColor}, 12px 12px 0 ${shadowColor}, 14px 14px 0 ${shadowColor}, 16px 16px 0 ${shadowColor}`;\n    const style = { position: 'absolute', transform: `translateY(${translateY}px) rotate(-8deg) scaleX(${scaleX}) scaleY(${scaleY})`, opacity, display: 'flex', flexDirection: 'column', alignItems: 'center', fontFamily: mainFont, fontWeight: 900, fontStyle: 'italic', textTransform: 'uppercase', lineHeight: 0.85, color, textShadow: shadow, fontSize: 220, textAlign: 'center', zIndex: isTrail ? 1 : 10 };\n    const lines = titleText.split('\\n').map((line, i) => (<span key={i} style={{ display: 'block' }}>{line}</span>));\n    return <div style={style}>{lines}</div>;\n};\n\nconst VibeEffectsOpener = ({ item }) => {\n    const frame = useCurrentFrame();\n    const { fps } = useVideoConfig();\n\n    const props = item.props || {};\n    const titleText = props.titleText;\n    const repeatText = props.repeatText;\n    const mainFont = props.mainFont;\n    const backgroundColor = props.backgroundColor;\n    const accentColor = props.accentColor;\n    const transparentBackground = props.transparentBackground;\n\n    const DESIGN_WIDTH = 1920;\n    const DESIGN_HEIGHT = 1080;\n    const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n    const EXIT_START = 70;\n    const EXIT_DUR = 14;\n\n    const easeInExpo = Easing.bezier(0.7, 0, 0.84, 0);\n\n    const colScale = (colDelay) => {\n        const f = frame - (EXIT_START + colDelay);\n        if (f <= 0) return 1;\n        if (f >= EXIT_DUR) return 0;\n        return 1 - easeInExpo(f / EXIT_DUR);\n    };\n\n    const col0Scale = colScale(0);\n    const col1Scale = colScale(4);\n    const col2Scale = colScale(8);\n\n    const titleExitOpacity = interpolate(frame, [EXIT_START, EXIT_START + 8], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n\n    const rootStyle = { position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: `scale(${scale})`, transformOrigin: 'top left', backgroundColor: 'transparent', overflow: 'hidden' };\n\n    const renderCol = (left, colWidth, origin, scaleY) => {\n        const wrapStyle = { position: 'absolute', left, top: 0, width: colWidth, height: 1080, transformOrigin: origin, transform: `scaleY(${scaleY})`, overflow: 'hidden' };\n        const innerStyle = { position: 'absolute', left: -left, top: 0, width: 1920, height: 1080 };\n        return (\n            <div style={wrapStyle}>\n                <div style={innerStyle}>\n                    {createRotatedContent({ backgroundColor, transparentBackground, repeatText, mainFont, frame, fps })}\n                </div>\n            </div>\n        );\n    };\n\n    return (\n        <div style={rootStyle}>\n            <div style={{ position: 'absolute', inset: 0 }}>\n                {frame < EXIT_START ? (\n                    <>\n                        {createWipeCol({ left: 0, delay: 0, origin: 'top', width: 641, backgroundColor, transparentBackground, repeatText, mainFont, frame, fps })}\n                        {createWipeCol({ left: 640, delay: 4, origin: 'bottom', width: 641, backgroundColor, transparentBackground, repeatText, mainFont, frame, fps })}\n                        {createWipeCol({ left: 1280, delay: 8, origin: 'top', width: 640, backgroundColor, transparentBackground, repeatText, mainFont, frame, fps })}\n                    </>\n                ) : (\n                    <>\n                        {renderCol(0, 641, 'top', col0Scale)}\n                        {renderCol(640, 641, 'bottom', col1Scale)}\n                        {renderCol(1280, 640, 'top', col2Scale)}\n                    </>\n                )}\n            </div>\n            <div style={{ position: 'absolute', inset: 0, display: 'flex', justifyContent: 'center', alignItems: 'center', opacity: titleExitOpacity }}>\n                {createTitleLayer({ delay: 34, isTrail: true, color: accentColor, mainFont, titleText, frame, fps })}\n                {createTitleLayer({ delay: 32, isTrail: true, color: accentColor, mainFont, titleText, frame, fps })}\n                {createTitleLayer({ delay: 30, isTrail: false, color: '#FFFFFF', mainFont, titleText, frame, fps })}\n            </div>\n        </div>\n    );\n};\n"
 },
 {
  "id": "c480c5c8-9812-49ab-a04b-1dfef0405aa8",
