  "thumb": "/thumbnails/9e649199-8bda-434b-a208-862e88829668.jpg",
  "code": "const NotebookShowcase = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const safeFps = fps || 30;\n\n  const props = item.props || {};\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground;\n  const paperColor = props.paperColor;\n  const accentColor = props.accentColor;\n  const textColor = props.textColor;\n  const titleFontFamily = props.titleFontFamily;\n  const bodyFontFamily = props.bodyFontFamily;\n  \n  const chapterTitle = props.chapterTitle;\n  const nameTagTitle = props.nameTagTitle;\n  const nameTagSubtitle = props.nameTagSubtitle;\n  const quoteText = props.quoteText;\n  \n  const chartLabels = [props.chartLabel1, props.chartLabel2, props.chartLabel3];\n  const chartVals = [parseFloat(props.chartValue1) || 85, parseFloat(props.chartValue2) || 72, parseFloat(props.chartValue3) || 90];\n  \n  const bullets = [props.bullet1, props.bullet2, props.bullet3];\n  const timelines = [props.timeline1, props.timeline2, props.timeline3, props.timeline4];\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  // Animations\n  const paperScale = spring({frame, fps: safeFps, config: {damping: 20}});\n  const paperOpacity = interpolate(frame, [0, 15], [0, 1], {extrapolateRight: 'clamp'});\n\n  const titleScale = spring({frame: Math.max(0, frame - 15), fps: safeFps, config: {damping: 15}});\n  const titleHighlightWidth = `${interpolate(frame, [20, 50], [0, 110], {extrapolateRight: 'clamp'})}%`;\n\n  const chartBarStyles = chartVals.map((val, i) => {\n    const w = interpolate(frame, [30 + i * 10, 60 + i * 10], [0, val], {extrapolateRight: 'clamp'});\n    return { width: `${w}%` };\n  });\n\n  const nameTagScale = spring({frame: Math.max(0, frame - 40), fps: safeFps, config: {damping: 15}});\n\n  const bulletStyles = bullets.map((_, i) => {\n    const op = interpolate(frame, [50 + i * 10, 60 + i * 10], [0, 1], {extrapolateRight: 'clamp'});\n    const tx = interpolate(frame, [50 + i * 10, 60 + i * 10], [-20, 0], {extrapolateRight: 'clamp'});\n    return { opacity: op, transform: `translateX(${tx}px)` };\n  });\n\n  const quoteOpacity = interpolate(frame, [60, 80], [0, 1], {extrapolateRight: 'clamp'});\n  const quoteHighlightWidth = `${interpolate(frame, [70, 100], [0, 110], {extrapolateRight: 'clamp'})}%`;\n\n  const timelineLineWidth = `${interpolate(frame, [80, 110], [0, 100], {extrapolateRight: 'clamp'})}%`;\n  const timelineNodeScales = timelines.map((_, i) => {\n    return spring({frame: Math.max(0, frame - (90 + i * 5)), fps: safeFps, config: {damping: 15}});\n  });\n\n  const star1Scale = spring({frame: Math.max(0, frame - 60), fps: safeFps, config: {damping: 15}});\n  const star2Scale = spring({frame: Math.max(0, frame - 100), fps: safeFps, config: {damping: 15}});\n\n  // Styles\n  const rootStyle = { position: 'absolute', inset: 0, backgroundColor };\n  \n  const paperStyle = {\n    position: 'absolute',\n    top: 90, left: 160, right: 160, bottom: 90,\n    backgroundColor: paperColor,\n    borderRadius: '4px',\n    boxShadow: '10px 15px 30px rgba(0,0,0,0.15)',\n    backgroundImage: `linear-gradient(to right, #e8e8e8 1px, transparent 1px), linear-gradient(to bottom, #e8e8e8 1px, transparent 1px)`,\n    backgroundSize: '40px 40px',\n    opacity: paperOpacity,\n    transform: `scale(${paperScale})`\n  };\n\n  const gridContainerStyle = {\n    display: 'grid',\n    gridTemplateColumns: '1fr 1fr',\n    gridTemplateRows: '1fr 1fr 1fr',\n    gap: '60px',\n    width: '100%',\n    height: '100%',\n    padding: '60px 80px 60px 120px',\n    boxSizing: 'border-box'\n  };\n\n  const spiralContainerStyle = {\n    position: 'absolute', left: -25, top: 40, bottom: 40, \n    display: 'flex', flexDirection: 'column', justifyContent: 'space-between', zIndex: 10\n  };\n\n  const titleHighlightStyle = {\n    position: 'absolute', bottom: '15%', left: '-5%', height: '40%', \n    backgroundColor: accentColor, opacity: 0.7, zIndex: -1,\n    width: titleHighlightWidth,\n    transform: 'rotate(-1deg)',\n    borderRadius: '4px'\n  };\n\n  const quoteHighlightStyle = {\n    position: 'absolute', top: '40%', left: '-5%', height: '30%', \n    backgroundColor: accentColor, opacity: 0.5, zIndex: -1,\n    width: quoteHighlightWidth,\n    transform: 'rotate(1deg)'\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={paperStyle}>\n        \n        {/* Spiral Binding Overlay */}\n        <div style={spiralContainerStyle}>\n          {[...Array(14)].map((_, i) => (\n            <svg key={i} width=\"50\" height=\"20\" viewBox=\"0 0 50 20\">\n              <rect x=\"15\" y=\"6\" width=\"20\" height=\"8\" rx=\"4\" stroke=\"#999\" strokeWidth=\"3\" fill=\"#FFF\" />\n            </svg>\n          ))}\n        </div>\n\n        {/* Doodle Stars */}\n        <div style={{position: 'absolute', top: 50, right: 70, transform: `scale(${star1Scale}) rotate(15deg)`, zIndex: 5}}>\n          <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\">\n            <path d=\"M20,2 L24,14 L38,14 L26,22 L30,36 L20,28 L10,36 L14,22 L2,14 L16,14 Z\" stroke={textColor} strokeWidth=\"2\" fill=\"none\" strokeLinejoin=\"round\" />\n          </svg>\n        </div>\n        <div style={{position: 'absolute', bottom: 90, left: 140, transform: `scale(${star2Scale}) rotate(-10deg)`, zIndex: 5}}>\n          <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\">\n            <path d=\"M20,2 L24,14 L38,14 L26,22 L30,36 L20,28 L10,36 L14,22 L2,14 L16,14 Z\" stroke={textColor} strokeWidth=\"2\" fill=\"none\" strokeLinejoin=\"round\" />\n          </svg>\n        </div>\n\n        <div style={gridContainerStyle}>\n          \n          {/* 1. Chapter Title */}\n          <div style={{display:'flex', alignItems:'center', justifyContent:'center', height:'100%', position:'relative'}}>\n            <h1 style={{fontFamily: titleFontFamily, fontSize: 56, color: textColor, margin: 0, position:'relative', zIndex: 1, textAlign: 'center', whiteSpace: 'normal', overflowWrap: 'break-word', transform: `scale(${titleScale})`}}>\n              {chapterTitle}\n              <div style={titleHighlightStyle} />\n            </h1>\n          </div>\n\n          {/* 2. Data Chart */}\n          <div style={{display:'flex', flexDirection:'column', justifyContent:'center', height:'100%', gap: 20, padding: '0 20px'}}>\n            {chartLabels.map((label, i) => (\n              <div key={i} style={{display:'flex', flexDirection:'column', gap: 8}}>\n                <div style={{display:'flex', justifyContent:'space-between', fontFamily: bodyFontFamily, fontSize: 20, color: textColor, fontWeight: 'bold'}}>\n                  <span>{label}</span>\n                  <span>{chartVals[i]}%</span>\n                </div>\n                <div style={{width: '100%', height: 16, backgroundColor: '#E0E0E0', borderRadius: 8, overflow:'hidden'}}>\n                  <div style={{height: '100%', backgroundColor: accentColor, width: chartBarStyles[i].width}} />\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* 3. Name Tag */}\n          <div style={{display:'flex', alignItems:'center', justifyContent:'center', height:'100%'}}>\n            <div style={{backgroundColor: '#fff3fc', padding: '30px 40px', boxShadow: '4px 6px 15px rgba(0,0,0,0.1)', transform: `scale(${nameTagScale}) rotate(-3deg)`, position: 'relative', display:'flex', flexDirection:'column', alignItems:'center', fontFamily: titleFontFamily, color: textColor}}>\n              <div style={{position:'absolute', top: -35, left: '40%', transform:'rotate(10deg)'}}>\n                <svg width=\"30\" height=\"70\" viewBox=\"0 0 24 60\">\n                  <path d=\"M12,2 L12,48 C12,53 18,53 18,48 L18,12 C18,9 14,9 14,12 L14,40 C14,42 16,42 16,40 L16,15\" stroke=\"#777\" strokeWidth=\"4\" fill=\"none\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/>\n                </svg>\n              </div>\n              <div style={{fontSize: 40, fontWeight: 'bold', whiteSpace: 'normal', textAlign: 'center'}}>{nameTagTitle}</div>\n              <div style={{fontSize: 24, fontFamily: bodyFontFamily, marginTop: 10, whiteSpace: 'normal', textAlign: 'center'}}>{nameTagSubtitle}</div>\n            </div>\n          </div>\n\n          {/* 4. Bullet Points */}\n          <div style={{display:'flex', flexDirection:'column', justifyContent:'center', height:'100%', gap: 25, paddingLeft: 40}}>\n            {bullets.map((text, i) => (\n              <div key={i} style={{display:'flex', alignItems:'center', gap: 15, fontFamily: bodyFontFamily, fontSize: 24, color: textColor, opacity: bulletStyles[i].opacity, transform: bulletStyles[i].transform}}>\n                <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={accentColor} strokeWidth=\"4\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                  <polyline points=\"20 6 9 17 4 12\"></polyline>\n                </svg>\n                <span style={{whiteSpace: 'normal', overflowWrap: 'break-word'}}>{text}</span>\n              </div>\n            ))}\n          </div>\n\n          {/* 5. Highlight Quote */}\n          <div style={{display:'flex', alignItems:'center', justifyContent:'center', height:'100%', padding: '0 30px', opacity: quoteOpacity}}>\n            <div style={{fontFamily: titleFontFamily, fontSize: 36, color: textColor, textAlign:'center', position:'relative', fontStyle:'italic', whiteSpace: 'normal', overflowWrap: 'break-word'}}>\n              \"{quoteText}\"\n              <div style={quoteHighlightStyle} />\n            </div>\n          </div>\n\n          {/* 6. Timeline */}\n          <div style={{display:'flex', alignItems:'center', justifyContent:'space-between', height:'100%', position:'relative', width: '90%', margin: '0 auto'}}>\n            <div style={{position: 'absolute', top: '35%', left: 0, right: 0, height: 2, borderTop: `3px dashed ${textColor}`, opacity: 0.3, zIndex: 0, width: timelineLineWidth}} />\n            {timelines.map((t, i) => (\n              <div key={i} style={{display:'flex', flexDirection:'column', alignItems:'center', gap: 15, zIndex: 1, transform: `scale(${timelineNodeScales[i]})`}}>\n                <div style={{width: 24, height: 24, borderRadius: 12, backgroundColor: '#FFF', border: `4px solid ${textColor}`}} />\n                <span style={{fontFamily: bodyFontFamily, fontSize: 20, color: textColor, fontWeight: 'bold'}}>{t}</span>\n              </div>\n            ))}\n          </div>\n\n        </div>\n      </div>\n    </div>\n  );\n}"
 },
 {
  "id": "e7d1fceb-4526-42bc-b8a7-fec4407e5a51",
  "name": "Stock Market lower-third banner animation",
  "category": "uncategorized",
  "description": "A broadcast-style lower third where bold text slides up, followed by a solid color block sliding in from the left to highlight it, finishing with a smooth downward exit.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "nameText": "Rachel Nguyen",
   "titleText": "Chief Trading Strategist",
   "bgColor": "#a3b3d0",
   "textColor": "#FFFFFF"
  },
  "propSchema": [
   {
    "key": "nameText",
    "type": "text",
    "defaultValue": "Rachel Nguyen",
    "label": "Name"
   },
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "Chief Trading Strategist",
    "label": "Title"
   },
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#a3b3d0",
    "label": "Background Color"
   },
   {
    "key": "textColor",
    "type": "color",
    "defaultValue": "#FFFFFF",
    "label": "Text Color"
   }
  ],
  "thumb": "/thumbnails/e7d1fceb-4526-42bc-b8a7-fec4407e5a51.jpg",
  "code": "const StockMarketBanner = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { durationInFrames } = useVideoConfig();\n  const DESIGN_WIDTH = 600;\n  const DESIGN_HEIGHT = 220;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const props = item.props || {};\n  const nameText = props.nameText;\n  const titleText = props.titleText;\n  const bgColor = props.bgColor;\n  const textColor = props.textColor;\n\n  const textInProgress = interpolate(frame, [0, 18], [0, 1], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const textY = interpolate(textInProgress, [0, 1], [22, 0]);\n  const textOpacity = textInProgress;\n\n  const blockInProgress = interpolate(frame, [18, 52], [0, 1], {\n    easing: Easing.out(Easing.cubic),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const blockScaleX = blockInProgress;\n\n  const outStart = durationInFrames - 22;\n  const outEnd = durationInFrames - 4;\n  const outProgress = interpolate(frame, [outStart, outEnd], [0, 1], {\n    easing: Easing.inOut(Easing.cubic),\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n  const outY = interpolate(outProgress, [0, 1], [0, 150]);\n  const outOpacity = interpolate(outProgress, [0, 1], [1, 0]);\n\n  return (\n    <div style={{\n      position: 'absolute',\n      top: 0,\n      left: 0,\n      width: DESIGN_WIDTH,\n      height: DESIGN_HEIGHT,\n      transform: `scale(${scale})`,\n      transformOrigin: 'top left',\n      overflow: 'visible',\n    }}>\n      <div style={{\n        position: 'relative',\n        display: 'inline-flex',\n        flexDirection: 'column',\n        justifyContent: 'center',\n        alignItems: 'flex-start',\n        padding: '14px 40px',\n        width: 'fit-content',\n        height: 140,\n        transform: `translateY(${outY}px)`,\n        opacity: outOpacity,\n      }}>\n        <div style={{\n          position: 'absolute',\n          inset: 0,\n          backgroundColor: bgColor,\n          transform: `scaleX(${blockScaleX})`,\n          transformOrigin: 'left center',\n        }} />\n        <div style={{\n          position: 'relative',\n          transform: `translateY(${textY}px)`,\n          opacity: textOpacity,\n          color: textColor,\n          fontSize: 62,\n          fontWeight: 800,\n          fontFamily: `'Inter', sans-serif`,\n          whiteSpace: 'nowrap',\n          zIndex: 10,\n          letterSpacing: '-0.01em',\n          lineHeight: 1.15,\n        }}>{nameText}</div>\n        <div style={{\n          position: 'relative',\n          transform: `translateY(${textY}px)`,\n          opacity: interpolate(textInProgress, [0, 1], [0, 0.88]),\n          color: textColor,\n          fontSize: 32,\n          fontWeight: 600,\n          fontFamily: `'Inter', sans-serif`,\n          whiteSpace: 'nowrap',\n          zIndex: 10,\n          letterSpacing: '0.01em',\n          lineHeight: 1.2,\n        }}>{titleText}</div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "dde936b2-bdc0-411d-800e-9fbfc34e3827",
