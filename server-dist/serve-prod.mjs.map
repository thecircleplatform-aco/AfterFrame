  "code": "const TimelineJourney = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const year1 = props.year1;\n  const desc1 = props.desc1;\n  const year2 = props.year2;\n  const desc2 = props.desc2;\n  const year3 = props.year3;\n  const desc3 = props.desc3;\n  const year4 = props.year4;\n  const desc4 = props.desc4;\n\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n  const textColor = props.textColor;\n  const lineColor = props.lineColor;\n  const blobColor1 = props.blobColor1;\n  const blobColor2 = props.blobColor2;\n  const bgColor = props.bgColor;\n  const transparentBackground = props.transparentBackground === 'true' || props.transparentBackground === true;\n\n  const backgroundColor = transparentBackground ? 'transparent' : bgColor;\n\n  // --- Easing curves ---\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n  const lineDraw = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 2.8);\n  };\n\n  // --- Exit ---\n  const totalFrames = durationInFrames || 210;\n  const exitStart = totalFrames - 25;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / 25));\n  const exitProgress = exitRaw * exitRaw;\n  const exitOpacity = 1 - exitProgress;\n  const exitScale = 1 - exitProgress * 0.02;\n\n  // --- Blob: scale 1.04 → 1.0 over 45 frames, gentle sin/cos drift ---\n  const blobFadeRaw = Math.min(1, Math.max(0, frame / 45));\n  const blobOpacity = smoothSettle(blobFadeRaw);\n  const blobScaleRaw = Math.min(1, Math.max(0, frame / 45));\n  const blobScale = 1.04 - 0.04 * smoothSettle(blobScaleRaw);\n  const blobDriftX = Math.sin(frame / 60) * 8;\n  const blobDriftY = Math.cos(frame / 80) * 6;\n\n  // --- Title: starts frame 5, 50 frames ---\n  const titleRaw = Math.min(1, Math.max(0, (frame - 5) / 50));\n  const titleProgress = smoothSettle(titleRaw);\n  const titleOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - 5) / 18)));\n  const titleY = (1 - titleProgress) * 60;\n\n  // --- Horizontal line: starts frame 20, 55 frames ---\n  const lineRaw = Math.min(1, Math.max(0, (frame - 20) / 55));\n  const lineProgress = lineDraw(lineRaw);\n  const lineWidth = lineProgress * 1320;\n\n  // --- Nodes: staggered from frame 45, every 20 frames apart ---\n  const nodes = [\n    { x: 300, year: year1, desc: desc1, delay: 45 },\n    { x: 740, year: year2, desc: desc2, delay: 65 },\n    { x: 1180, year: year3, desc: desc3, delay: 85 },\n    { x: 1620, year: year4, desc: desc4, delay: 105 },\n  ];\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor, overflow: 'hidden', opacity: exitOpacity, transform: `scale(${exitScale})` }}>\n      {/* Blob background — no translate, only scale + drift */}\n      <div style={{\n        position: 'absolute',\n        top: '50%', left: '50%',\n        width: 1400, height: 1400,\n        marginLeft: -700, marginTop: -700,\n        background: `radial-gradient(circle, ${blobColor1} 0%, ${blobColor2} 40%, transparent 70%)`,\n        opacity: blobOpacity,\n        transform: `translate(${blobDriftX}px, ${blobDriftY}px) scale(${blobScale})`,\n        transformOrigin: 'center center'\n      }} />\n\n      {/* Title */}\n      <div style={{\n        position: 'absolute',\n        top: 120, left: 160,\n        fontFamily: titleFont,\n        fontSize: 72,\n        fontStyle: 'italic',\n        color: textColor,\n        opacity: titleOpacity,\n        transform: `translateY(${titleY}px)`,\n        letterSpacing: '-0.02em',\n        whiteSpace: 'pre-wrap',\n        maxWidth: 800\n      }}>\n        {titleText}\n      </div>\n\n      {/* Horizontal line */}\n      <div style={{\n        position: 'absolute',\n        left: 300,\n        top: 540,\n        width: lineWidth,\n        height: 2,\n        backgroundColor: lineColor,\n        transformOrigin: 'left center'\n      }} />\n\n      {/* Nodes */}\n      {nodes.map((node, i) => {\n        const nodeRaw = Math.min(1, Math.max(0, (frame - node.delay) / 40));\n        const nodeProgress = smoothSettle(nodeRaw);\n        const nodeOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - node.delay) / 15)));\n        const textY = (1 - nodeProgress) * 30;\n\n        return (\n          <div key={i} style={{ position: 'absolute', left: node.x, top: 540, opacity: nodeOpacity }}>\n            <div style={{\n              position: 'absolute',\n              width: 12, height: 12,\n              borderRadius: '50%',\n              backgroundColor: lineColor,\n              left: -6, top: -5,\n              transform: `scale(${nodeProgress})`\n            }} />\n\n            <div style={{\n              position: 'absolute',\n              bottom: 40, left: -150, width: 300,\n              textAlign: 'center',\n              fontFamily: titleFont,\n              fontSize: 40,\n              fontStyle: 'italic',\n              color: textColor,\n              transform: `translateY(${textY}px)`\n            }}>\n              {node.year}\n            </div>\n\n            <div style={{\n              position: 'absolute',\n              top: 40, left: -150, width: 300,\n              textAlign: 'center',\n              fontFamily: bodyFont,\n              fontSize: 18,\n              color: textColor,\n              textTransform: 'uppercase',\n              letterSpacing: '0.15em',\n              lineHeight: 1.4,\n              whiteSpace: 'normal',\n              overflowWrap: 'break-word',\n              transform: `translateY(${textY}px)`\n            }}>\n              {node.desc}\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n};"
 },
 {
  "id": "f767f837-0255-49c4-8f17-01a168f1f7a3",
  "name": "Minimal Gradient — Universal Anchor",
  "category": "uncategorized",
  "description": "A comprehensive showcase featuring large typography, a horizontal timeline, a drawing donut chart, and a smooth gradient background anchored in a minimal, organic aesthetic.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "bgColor": "#FFFDF7",
   "transparentBackground": false,
   "textColor": "#1A1A1A",
   "blobColor1": "#6de0d7",
   "blobColor2": "#c2d6bd",
   "chartColor1": "#94e1c7",
