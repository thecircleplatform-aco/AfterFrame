  "thumb": "/thumbnails/614fbd3c-90b1-4e2b-b52d-e78876757b4b.jpg",
  "code": "const QuoteCardOverlay = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps } = useVideoConfig();\n  \n  const props = item.props || {};\n  const quoteText = props.quoteText;\n  const fontFamily = props.fontFamily;\n  const cardColor = props.cardColor;\n  const cardOpacity = typeof props.cardOpacity === 'number' ? props.cardOpacity : 0.88;\n  const textColor = props.textColor;\n  const cardBorderRadius = props.cardBorderRadius;\n  const wordDelay = props.wordDelay;\n  const slideInDuration = props.slideInDuration;\n  const fontSize = props.fontSize;\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  // 贝塞尔缓动：快进慢出，无弹跳\n  const cardProgress = interpolate(\n    frame,\n    [0, slideInDuration],\n    [0, 1],\n    {\n      extrapolateLeft: 'clamp',\n      extrapolateRight: 'clamp',\n      easing: Easing.bezier(0.22, 1, 0.36, 1)\n    }\n  );\n  const cardY = interpolate(cardProgress, [0, 1], [-600, 80]);\n\n  const words = quoteText.split(' ');\n\n  return (\n    <div style={{ position: 'absolute', top: 0, left: 0, width: DESIGN_WIDTH, height: DESIGN_HEIGHT, transform: `scale(${scale})`, transformOrigin: 'top left', backgroundColor: 'transparent', overflow: 'hidden' }}>\n      <div style={{ position: 'absolute', top: 0, left: 80, transform: `translateY(${cardY}px)`, width: 760, borderRadius: cardBorderRadius, boxSizing: 'border-box' }}>\n        <div style={{ position: 'absolute', inset: 0, backgroundColor: cardColor, opacity: cardOpacity, borderRadius: cardBorderRadius, boxShadow: '0 24px 48px rgba(0,0,0,0.08)' }} />\n        <div style={{ position: 'relative', padding: '60px', boxSizing: 'border-box' }}>\n          <div style={{ position: 'absolute', top: 40, right: 40 }}>\n            <svg width=\"56\" height=\"56\" viewBox=\"0 0 24 24\">\n              <path fillRule=\"evenodd\" clipRule=\"evenodd\"\n                d=\"M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h4v3.5l5.5-3.5H20c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z M10.5 7.5h-3v4h2c-.3 1.2-1.2 1.8-2 2v1.5c1.5-.1 3-1.5 3-3.5v-4z M16.5 7.5h-3v4h2c-.3 1.2-1.2 1.8-2 2v1.5c1.5-.1 3-1.5 3-3.5v-4z\"\n                fill={textColor}\n              />\n            </svg>\n          </div>\n          <div style={{ fontFamily, color: textColor, fontSize, lineHeight: 1.25, fontWeight: 'bold', letterSpacing: '-0.02em', marginTop: 10 }}>\n            {words.map((word, i) => {\n              const wordStartFrame = slideInDuration + i * wordDelay;\n              const wordProgress = interpolate(\n                frame,\n                [wordStartFrame, wordStartFrame + 12],\n                [0, 1],\n                { extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: Easing.bezier(0.22, 1, 0.36, 1) }\n              );\n              const wordOpacity = wordProgress;\n              const wordX = interpolate(wordProgress, [0, 1], [18, 0]);\n              return (\n                <React.Fragment key={i}>\n                  <span style={{ display: 'inline-block', opacity: wordOpacity, transform: `translateX(${wordX}px)`, willChange: 'opacity, transform' }}>{word}</span>\n                  {i < words.length - 1 && ' '}\n                </React.Fragment>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
