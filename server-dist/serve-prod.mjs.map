    "label": "Text Color"
   }
  ],
  "thumb": "/thumbnails/1c49b2f1-3dce-4953-afd1-674ae0a285e8.jpg",
  "code": "const GroupedBarChart = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText || 'GROOMING BOOKINGS';\n  const subtitleText = props.subtitleText || 'Booked vs Goal Volume (sessions)';\n  const bgGradientStart = props.bgGradientStart || '#3b4860';\n  const bgGradientEnd = props.bgGradientEnd || '#4d5768';\n  const actualColor = props.actualColor || '#FFFFFF';\n  const targetColor = props.targetColor || 'rgba(255, 255, 255, 0.2)';\n  const textColor = props.textColor || '#FFFFFF';\n  const gridColor = props.gridColor || 'rgba(255, 255, 255, 0.1)';\n  const fontFamily = props.fontFamily || 'Inter, sans-serif';\n  const monoFont = '\"IBM Plex Mono\", monospace';\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const scale = Math.min((item?.width || DESIGN_WIDTH) / DESIGN_WIDTH, (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT);\n\n  const safeFps = fps || 30;\n  const safeSpring = (delay = 0, config = { damping: 15 }) => {\n    return spring({ frame: Math.max(0, frame - delay), fps: safeFps, config });\n  };\n\n  const data = [\n    { label: 'Jan', actual: 55, target: 60 },\n    { label: 'Feb', actual: 68, target: 70 },\n    { label: 'Mar', actual: 72, target: 75 },\n    { label: 'Apr', actual: 61, target: 65 },\n    { label: 'May', actual: 84, target: 80 },\n    { label: 'Jun', actual: 90, target: 85 },\n  ];\n\n  const chartWidth = 1400;\n  const chartHeight = 550;\n  const chartLeft = 260;\n  const chartTop = 320;\n  const yMax = 100;\n  const yStep = 25;\n  const pxPerUnit = chartHeight / yMax;\n\n  const groupWidth = chartWidth / data.length;\n  const barWidth = 40;\n  const barGap = 12;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    background: `linear-gradient(135deg, ${bgGradientStart}, ${bgGradientEnd})`,\n    fontFamily,\n    color: textColor,\n    overflow: 'hidden'\n  };\n\n  const titleOpacity = safeSpring(0, { damping: 20 });\n  const titleY = interpolate(safeSpring(0, { damping: 20 }), [0, 1], [30, 0]);\n  const titleTransform = `translateY(${titleY}px)`;\n\n  const legendOpacity = safeSpring(15, { damping: 20 });\n\n  const gridLines = [];\n  for (let i = 0; i <= yMax; i += yStep) {\n    gridLines.push(i);\n  }\n\n  const gridElements = gridLines.map((val, i) => {\n    const yPos = chartHeight - (val * pxPerUnit);\n    const gridSpring = safeSpring(10 + i * 2, {damping: 20});\n    const gridScaleX = `scaleX(${gridSpring})`;\n\n    return (\n      <div key={`grid-${val}`} style={{\n        position: 'absolute',\n        top: yPos,\n        left: -60,\n        width: chartWidth + 60,\n        height: 1,\n        display: 'flex',\n        alignItems: 'center',\n        opacity: gridSpring\n      }}>\n        <div style={{ width: 40, textAlign: 'right', fontSize: 18, fontWeight: 400, fontFamily: monoFont, opacity: 0.6, marginRight: 20 }}>\n          {val}\n        </div>\n        <div style={{ flex: 1, height: 1, backgroundColor: gridColor, transformOrigin: 'left', transform: gridScaleX }} />\n      </div>\n    );\n  });\n\n  const barElements = data.map((d, i) => {\n    const groupLeft = i * groupWidth;\n    const delay = 25 + i * 5;\n\n    const targetProgress = safeSpring(delay, { damping: 18, stiffness: 80 });\n    const actualProgress = safeSpring(delay + 4, { damping: 18, stiffness: 80 });\n\n    const targetH = Math.max(0, targetProgress * (d.target * pxPerUnit));\n    const actualH = Math.max(0, actualProgress * (d.actual * pxPerUnit));\n\n    const groupCenter = groupWidth / 2;\n    const totalBarsWidth = (barWidth * 2) + barGap;\n    const startX = groupCenter - (totalBarsWidth / 2);\n\n    const labelSpring = safeSpring(20 + i * 3, { damping: 20 });\n    const labelY = interpolate(labelSpring, [0, 1], [10, 0]);\n    const labelTransform = `translateY(${labelY}px)`;\n\n    return (\n      <div key={d.label} style={{\n        position: 'absolute',\n        top: 0,\n        left: groupLeft,\n        width: groupWidth,\n        height: chartHeight + 60,\n      }}>\n        <div style={{\n          position: 'absolute',\n          bottom: 60,\n          left: startX,\n          width: barWidth,\n          height: targetH,\n          backgroundColor: targetColor,\n          transformOrigin: 'bottom',\n        }} />\n        <div style={{\n          position: 'absolute',\n          bottom: 60,\n          left: startX + barWidth + barGap,\n          width: barWidth,\n          height: actualH,\n          backgroundColor: actualColor,\n          transformOrigin: 'bottom',\n        }} />\n        <div style={{\n          position: 'absolute',\n          bottom: 0,\n          left: 0,\n          width: '100%',\n          textAlign: 'center',\n          fontSize: 18,\n          fontWeight: 300,\n          opacity: labelSpring,\n          transform: labelTransform\n        }}>\n          {d.label}\n        </div>\n      </div>\n    );\n  });\n\n  return (\n    <div style={rootStyle}>\n      <div style={{\n        position: 'absolute',\n        top: 120,\n        left: chartLeft,\n        opacity: titleOpacity,\n        transform: titleTransform,\n      }}>\n        <h1 style={{ margin: 0, fontSize: 56, fontWeight: 600, letterSpacing: '4px' }}>{titleText}</h1>\n        <h2 style={{ margin: '12px 0 0 0', fontSize: 24, fontWeight: 300, opacity: 0.7, letterSpacing: '1px' }}>{subtitleText}</h2>\n      </div>\n\n      <div style={{\n        position: 'absolute',\n        top: 140,\n        left: chartLeft + chartWidth - 300,\n        display: 'flex',\n        gap: '32px',\n        opacity: legendOpacity,\n        justifyContent: 'flex-end',\n        width: 300\n      }}>\n        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n          <div style={{ width: 16, height: 16, backgroundColor: actualColor }} />\n          <span style={{ fontSize: 20, fontWeight: 300, opacity: 0.9 }}>Booked</span>\n        </div>\n        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n          <div style={{ width: 16, height: 16, backgroundColor: targetColor }} />\n          <span style={{ fontSize: 20, fontWeight: 300, opacity: 0.9 }}>Goal</span>\n        </div>\n      </div>\n\n      <div style={{\n        position: 'absolute',\n        top: chartTop,\n        left: chartLeft,\n        width: chartWidth,\n        height: chartHeight,\n      }}>\n        {gridElements}\n        {barElements}\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "d03ead86-a81b-4638-98d3-2fae21c1715b",
  "name": "Bar Chart - Monthly User Growth",
  "category": "data-visualization",
  "description": "A sleek, dark-themed infographic bar chart with a staggered upward spring animation for bars, accompanied by fading grid lines and data labels. Perfectly tuned for premium presentations.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "Monthly Learner Signups",
   "bgColor": "#212038",
   "barColorStart": "#bd53aa",
   "barColorEnd": "#a191e6",
   "xLabels": "Jan, Feb, Mar, Apr, May, Jun",
   "dataValues": "1.2, 1.8, 2.4, 3.1, 4.2, 5.8",
   "yMax": 7,
   "yAxisSteps": 7,
   "valueSuffix": "K"
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "Monthly Learner Signups",
    "label": "Chart Title"
   },
   {
    "key": "bgColor",
    "type": "color",
    "defaultValue": "#212038",
    "label": "Background Color"
   },
   {
    "key": "barColorStart",
    "type": "color",
    "defaultValue": "#bd53aa",
    "label": "Bar Gradient Start"
   },
   {
    "key": "barColorEnd",
    "type": "color",
    "defaultValue": "#a191e6",
    "label": "Bar Gradient End"
   },
   {
    "key": "xLabels",
    "type": "text",
    "defaultValue": "Jan, Feb, Mar, Apr, May, Jun",
    "label": "X-Axis Labels (comma separated)"
   },
   {
    "key": "dataValues",
    "type": "text",
    "defaultValue": "1.2, 1.8, 2.4, 3.1, 4.2, 5.8",
    "label": "Data Values (comma separated)"
   },
   {
    "key": "yMax",
