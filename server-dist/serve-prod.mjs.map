    "code": "const KbCreamWindow = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const W = 1080, H = 1920;\n  const ink = '#2c2620';\n  const accent = p.accentColor || '#f7a8b8';\n  const winW = Math.min(960, Math.max(620, Number(p.windowWidth) || 820));\n  const winH = Math.round(winW * 4 / 3);\n  const r = 18;\n  const x = Math.round((W - winW) / 2);\n  const y = Math.round((H - winH) / 2) - 10;\n  const title = p.title == null ? '' : String(p.title);\n  const handle = p.handle == null ? '' : String(p.handle);\n  const enter = spring({ frame, fps, config: { damping: 13, stiffness: 120 } });\n  const popIn = spring({ frame: frame - 6, fps, config: { damping: 12, stiffness: 140 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const sway = Math.sin((frame / 150) * Math.PI * 2);\n  const d = 'M0 0H' + W + 'V' + H + 'H0Z'\n    + 'M' + (x + r) + ' ' + y\n    + 'H' + (x + winW - r) + 'A' + r + ' ' + r + ' 0 0 1 ' + (x + winW) + ' ' + (y + r)\n    + 'V' + (y + winH - r) + 'A' + r + ' ' + r + ' 0 0 1 ' + (x + winW - r) + ' ' + (y + winH)\n    + 'H' + (x + r) + 'A' + r + ' ' + r + ' 0 0 1 ' + x + ' ' + (y + winH - r)\n    + 'V' + (y + r) + 'A' + r + ' ' + r + ' 0 0 1 ' + (x + r) + ' ' + y + 'Z';\n  const svg = '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ' + W + ' ' + H + '\"><path fill-rule=\"evenodd\" d=\"' + d + '\"/></svg>';\n  const mask = 'url(\"data:image/svg+xml,' + encodeURIComponent(svg) + '\")';\n  return (\n    <AbsoluteFill style={{ opacity: exit }}>\n      <AbsoluteFill style={{ backgroundColor: '#f8f1e3', WebkitMaskImage: mask, maskImage: mask, WebkitMaskSize: '100% 100%', maskSize: '100% 100%', opacity: enter }}>\n        <div style={{ position: 'absolute', inset: 0, backgroundImage: 'radial-gradient(circle 2.5px, #e2d4bb 2.5px, transparent 3px)', backgroundSize: '66px 66px', backgroundPosition: '33px 33px' }} />\n      </AbsoluteFill>\n      {title ? (\n        <div style={{ position: 'absolute', left: 0, right: 0, top: Math.max(70, y - 210) + (1 - enter) * 24, opacity: enter, textAlign: 'center' }}>\n          <span style={{ display: 'inline-block', fontSize: 80, fontWeight: 800, color: ink, letterSpacing: 4, background: 'linear-gradient(0deg, #ffd66e99 0 40%, transparent 40%)', padding: '0 20px 6px', transform: 'rotate(-0.8deg)' }}>{title}</span>\n        </div>\n      ) : null}\n      <div style={{ position: 'absolute', left: x, top: y, width: winW, height: winH, transform: 'scale(' + (0.86 + popIn * 0.14) + ') rotate(' + ((1 - popIn) * -2) + 'deg)', transformOrigin: '50% 40%' }}>\n        <div style={{ position: 'absolute', left: -19, top: -19, width: 'calc(100% + 38px)', height: 19, background: '#fffdf8' }} />\n        <div style={{ position: 'absolute', left: -19, bottom: -117, width: 'calc(100% + 38px)', height: 117, background: '#fffdf8' }} />\n        <div style={{ position: 'absolute', left: -19, top: 0, width: 19, height: '100%', background: '#fffdf8' }} />\n        <div style={{ position: 'absolute', right: -19, top: 0, width: 19, height: '100%', background: '#fffdf8' }} />\n        <div style={{ position: 'absolute', left: -22, top: -22, right: -22, bottom: -120, borderRadius: 14, border: '3px solid ' + ink, boxShadow: '12px 14px 0 ' + ink + '24' }} />\n        <div style={{ position: 'absolute', inset: 0, borderRadius: r, boxShadow: 'inset 0 0 0 2px ' + ink + '26' }} />\n        {handle ? (\n          <div style={{ position: 'absolute', left: 0, right: 0, bottom: -108, textAlign: 'center', fontSize: 42, fontWeight: 700, color: ink, letterSpacing: 4, fontStyle: 'italic' }}>{handle}</div>\n        ) : null}\n        <div style={{ position: 'absolute', left: -60, top: -50, width: 190, height: 52, background: accent + 'b3', transform: 'rotate(-12deg)', boxShadow: '0 4px 12px #2c26201f' }} />\n        <div style={{ position: 'absolute', right: -60, top: -50, width: 190, height: 52, background: accent + 'b3', transform: 'rotate(11deg)', boxShadow: '0 4px 12px #2c26201f' }} />\n      </div>\n      <svg viewBox=\"0 0 100 100\" style={{ position: 'absolute', width: 80, height: 80, left: 74, top: y + winH * 0.72 + sway * 5, transform: 'rotate(' + (-12 + sway * 6) + 'deg)', opacity: popIn }}>\n        <path d=\"M50 6 L60 38 L94 38 L66 57 L76 90 L50 70 L24 90 L34 57 L6 38 L40 38 Z\" fill=\"#ffd66e\" stroke={ink} strokeWidth=\"4\" strokeLinejoin=\"round\" />\n      </svg>\n    </AbsoluteFill>\n  );\n};"
