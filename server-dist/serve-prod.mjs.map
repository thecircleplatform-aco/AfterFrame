  "durationInFrames": 90,
  "props": {
   "headlineLine1": "Voltera Reimagines the Grid of Tomorrow",
   "headlineLine2": "Energy — The Solar Startup That Learns",
   "headlineLine3": "Like an Engineer",
   "bylineText": "Staff Writer | Mar. 9, 2027",
   "sourceName": "WATT",
   "sourceColor": "#a73f95",
   "highlightColor": "#e6e2ff",
   "backgroundColor": "#e8e6e0",
   "headlineFont": "Roboto, sans-serif",
   "sourceFont": "Roboto, sans-serif",
   "bylineFont": "Roboto, sans-serif"
  },
  "propSchema": [
   {
    "key": "headlineLine1",
    "type": "text",
