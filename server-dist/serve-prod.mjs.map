  "thumb": "/thumbnails/081855a7-161d-47fe-af5a-cd450e1cd8b5.jpg",
  "code": "const ShowcaseGraphic = ({item}) => {\n  const frame = useCurrentFrame();\n  const {fps} = useVideoConfig();\n  const props = item.props || {};\n\n  // Theme & Colors\n  const bgColor = props.transparentBackground ? 'transparent' : props.bgColor;\n  const cCobalt = props.cCobalt;\n  const cYellow = props.cYellow;\n  const cRed = props.cRed;\n  const cTeal = props.cTeal;\n  const cOrange = props.cOrange;\n  const textColor = props.textColor;\n  const fontHeading = props.fontHeading;\n  const fontAccent = props.fontAccent;\n\n  // Safely bound springs\n  const safeSpring = (delay = 0, damping = 15) => {\n    return spring({ frame: Math.max(0, frame - delay), fps, config: { damping } });\n  };\n\n  // 0. Background Cubist Accents Animation\n  const bgShape1Scale = safeSpring(0, 12);\n  const bgShape2Scale = safeSpring(5, 12);\n  const bgShape3Scale = safeSpring(10, 12);\n\n  // 1. Title Animation\n  const titleSlide = interpolate(frame, [10, 40], [40, 0], {extrapolateRight: 'clamp'});\n  const titleOp = interpolate(frame, [10, 35], [0, 1], {extrapolateRight: 'clamp'});\n  const titleAccentScale = safeSpring(25, 14);\n\n  // 2. Chart Animation\n  const chartTitleOp = interpolate(frame, [15, 45], [0, 1], {extrapolateRight: 'clamp'});\n  const bar1Width = safeSpring(25);\n  const bar2Width = safeSpring(35);\n  const bar3Width = safeSpring(45);\n\n  // 3. Name Tag Animation\n  const avatarScale = safeSpring(30);\n  const nameSlide = interpolate(frame, [35, 60], [-30, 0], {extrapolateRight: 'clamp'});\n  const nameOp = interpolate(frame, [35, 60], [0, 1], {extrapolateRight: 'clamp'});\n\n  // 4. Bullets Animation\n  const b1Scale = safeSpring(40);\n  const b1Op = interpolate(frame, [40, 60], [0, 1], {extrapolateRight: 'clamp'});\n  const b2Scale = safeSpring(50);\n  const b2Op = interpolate(frame, [50, 70], [0, 1], {extrapolateRight: 'clamp'});\n  const b3Scale = safeSpring(60);\n  const b3Op = interpolate(frame, [60, 80], [0, 1], {extrapolateRight: 'clamp'});\n\n  // 5. Quote Animation\n  const quoteOp = interpolate(frame, [55, 85], [0, 1], {extrapolateRight: 'clamp'});\n  const quoteMarkScale = safeSpring(60);\n\n  // 6. Timeline Animation\n  const lineDraw = safeSpring(60);\n  const t1Scale = safeSpring(70);\n  const t2Scale = safeSpring(75);\n  const t3Scale = safeSpring(80);\n  const t4Scale = safeSpring(85);\n\n  const rootStyle = {\n    position: 'absolute',\n    inset: 0,\n    backgroundColor: bgColor,\n    overflow: 'hidden',\n    fontFamily: fontHeading,\n    color: textColor\n  };\n\n  return (\n    <div style={rootStyle}>\n      {/* --- Background Cubist Accents --- */}\n      <div style={{\n        position: 'absolute', top: -100, left: 600, \n        transform: `scale(${bgShape1Scale}) rotate(15deg)`,\n        opacity: 0.15\n      }}>\n        <svg width=\"600\" height=\"800\" viewBox=\"0 0 600 800\">\n          <polygon points=\"0,200 600,0 500,800 100,700\" fill={cYellow} />\n        </svg>\n      </div>\n      <div style={{\n        position: 'absolute', top: 500, left: -200, \n        transform: `scale(${bgShape2Scale}) rotate(-10deg)`,\n        opacity: 0.1\n      }}>\n        <svg width=\"800\" height=\"600\" viewBox=\"0 0 800 600\">\n          <circle cx=\"400\" cy=\"300\" r=\"350\" fill={cCobalt} />\n        </svg>\n      </div>\n      <div style={{\n        position: 'absolute', top: 600, left: 1300, \n        transform: `scale(${bgShape3Scale}) rotate(45deg)`,\n        opacity: 0.15\n      }}>\n        <svg width=\"500\" height=\"500\" viewBox=\"0 0 500 500\">\n          <rect x=\"50\" y=\"50\" width=\"400\" height=\"400\" fill={cRed} />\n        </svg>\n      </div>\n\n      {/* --- 1. Chapter Title --- */}\n      <div style={{\n        position: 'absolute', top: 120, left: 120, width: 700,\n        transform: `translateY(${titleSlide}px)`,\n        opacity: titleOp\n      }}>\n        <div style={{ fontSize: 64, fontWeight: 'bold', letterSpacing: '-0.02em', zIndex: 2, position: 'relative' }}>\n          {props.titleTop}\n        </div>\n        <div style={{\n          fontFamily: fontAccent,\n          fontSize: 160,\n          color: cRed,\n          lineHeight: 0.7,\n          marginLeft: 60,\n          marginTop: 10,\n          transform: `scale(${titleAccentScale}) rotate(-4deg)`,\n          transformOrigin: 'left center',\n          zIndex: 1\n        }}>\n          {props.titleBottom}\n        </div>\n      </div>\n\n      {/* --- 2. Data Chart --- */}\n      <div style={{\n        position: 'absolute', top: 120, left: 950, width: 850,\n        opacity: chartTitleOp\n      }}>\n        <div style={{ fontSize: 22, textTransform: 'uppercase', letterSpacing: '0.15em', fontWeight: 'bold', marginBottom: 30 }}>\n          {props.chartTitle}\n        </div>\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 24 }}>\n          {[ \n            { label: props.chartL1, val: props.chartV1, w: bar1Width, color: cCobalt },\n            { label: props.chartL2, val: props.chartV2, w: bar2Width, color: cYellow },\n            { label: props.chartL3, val: props.chartV3, w: bar3Width, color: cRed }\n          ].map((bar, i) => (\n            <div key={i} style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>\n              <div style={{ fontSize: 24, fontWeight: 500 }}>{bar.label}</div>\n              <div style={{ display: 'flex', alignItems: 'center', gap: 16 }}>\n                <div style={{\n                  height: 32, \n                  backgroundColor: bar.color,\n                  width: `${bar.w * bar.val}%`,\n                  maxWidth: '85%',\n                  borderRadius: '0 4px 4px 0'\n                }} />\n                <div style={{ fontSize: 28, fontWeight: 'bold', fontFamily: fontAccent }}>{bar.val}%</div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* --- 3. Name Tag --- */}\n      <div style={{\n        position: 'absolute', top: 480, left: 120, width: 700,\n        display: 'flex', alignItems: 'center', gap: 32\n      }}>\n        <div style={{\n          width: 130, height: 130, borderRadius: '50%',\n          backgroundColor: cTeal,\n          display: 'flex', justifyContent: 'center', alignItems: 'center',\n          color: '#FFF', fontSize: 72, fontWeight: 'bold',\n          transform: `scale(${avatarScale})`\n        }}>\n          {props.nameTagInit}\n        </div>\n        <div style={{\n          transform: `translateX(${nameSlide}px)`,\n          opacity: nameOp,\n          display: 'flex', flexDirection: 'column', gap: 4\n        }}>\n          <div style={{ fontSize: 48, fontWeight: 'bold', letterSpacing: '-0.02em', textTransform: 'uppercase' }}>\n            {props.nameTagTitle}\n          </div>\n          <div style={{ fontSize: 32, fontStyle: 'italic', color: cOrange }}>\n            {props.nameTagSubtitle}\n          </div>\n        </div>\n      </div>\n\n      {/* --- 4. Bullet Points --- */}\n      <div style={{\n        position: 'absolute', top: 500, left: 950, width: 850,\n        display: 'flex', flexDirection: 'column', gap: 36\n      }}>\n        {[ \n          { text: props.b1, shape: <polygon points=\"25,5 45,45 5,45\" fill={cYellow} />, scale: b1Scale, op: b1Op },\n          { text: props.b2, shape: <polygon points=\"25,5 45,25 25,45 5,25\" fill={cOrange} />, scale: b2Scale, op: b2Op },\n          { text: props.b3, shape: <circle cx=\"25\" cy=\"25\" r=\"20\" fill={cCobalt} />, scale: b3Scale, op: b3Op }\n        ].map((item, i) => (\n          <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 24 }}>\n            <div style={{ width: 50, height: 50, transform: `scale(${item.scale})` }}>\n              <svg width=\"50\" height=\"50\" viewBox=\"0 0 50 50\">\n                {item.shape}\n              </svg>\n            </div>\n            <div style={{ fontSize: 36, opacity: item.op, fontWeight: 500 }}>\n              {item.text}\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* --- 5. Highlight Quote --- */}\n      <div style={{\n        position: 'absolute', top: 780, left: 120, width: 700,\n        opacity: quoteOp\n      }}>\n        <div style={{\n          position: 'absolute', top: -60, left: -40,\n          fontFamily: fontAccent, fontSize: 240, color: cRed, opacity: 0.2,\n          lineHeight: 1, transform: `scale(${quoteMarkScale})`\n        }}>\n          \"\n        </div>\n        <div style={{ position: 'relative', fontSize: 40, fontStyle: 'italic', lineHeight: 1.4, zIndex: 1 }}>\n          {props.quote}\n        </div>\n      </div>\n\n      {/* --- 6. Timeline --- */}\n      <div style={{\n        position: 'absolute', top: 820, left: 950, width: 850\n      }}>\n        <div style={{ position: 'relative', width: '100%', height: 80 }}>\n          {/* Line */}\n          <div style={{\n            position: 'absolute', top: 20, left: 0,\n            height: 4, backgroundColor: textColor,\n            width: `${lineDraw * 100}%`,\n            transformOrigin: 'left center'\n          }} />\n          \n          {/* Nodes */}\n          {[ \n            { label: props.t1, left: '0%', scale: t1Scale, color: cTeal, delay: 70 },\n            { label: props.t2, left: '33%', scale: t2Scale, color: cYellow, delay: 75 },\n            { label: props.t3, left: '66%', scale: t3Scale, color: cCobalt, delay: 80 },\n            { label: props.t4, left: '100%', scale: t4Scale, color: cRed, delay: 85 }\n          ].map((node, i) => (\n            frame >= node.delay ? (\n            <div key={i} style={{\n              position: 'absolute', left: node.left, top: 20,\n              display: 'flex', flexDirection: 'column', alignItems: 'center',\n              transform: `translateX(-50%)`\n            }}>\n              <div style={{\n                width: 28, height: 28, borderRadius: '50%',\n                backgroundColor: node.color, marginTop: -12,\n                border: `4px solid ${bgColor}`,\n                transform: `scale(${node.scale})`\n              }} />\n              <div style={{\n                marginTop: 20, fontSize: 28, fontWeight: 'bold',\n                visibility: node.scale > 0.5 ? 'visible' : 'hidden'\n              }}>\n                {node.label}\n              </div>\n            </div>\n            ) : <div key={i} />\n          ))}\n        </div>\n      </div>\n\n    </div>\n  );\n};"
 },
 {
  "id": "1d52fd05-95dc-4cee-b7ea-4ffff59b6f2d",
  "name": "Pie chart animation",
  "category": "uncategorized",
  "description": "A clean, animated two-slice pie chart card that appears on the left side of the screen, perfect for talking-head video overlays.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
