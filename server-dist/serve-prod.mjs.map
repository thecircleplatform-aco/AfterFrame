  "code": "const SnapdragonPromo = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const props = item.props || {};\n  const titleLine1 = props.titleLine1;\n  const titleLine2 = props.titleLine2;\n  const specs = [\n    props.spec1, props.spec2, props.spec3, props.spec4,\n    props.spec5, props.spec6, props.spec7, props.spec8\n  ];\n  const neonColor = props.neonColor;\n  const dotColor = props.dotColor;\n  const transparentBackground = props.transparentBackground;\n\n  const DESIGN_WIDTH = 608;\n  const DESIGN_HEIGHT = 1080;\n  const SAFE_BOTTOM = 108;\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const SLIDE_IN_DUR  = 54;\n  const SLIDE_OUT_DUR = 54;\n  // 中点钳制:时长 < in+out(如默认 90)时保持严格递增,时长充裕时还原原节奏\n  const SLIDE_MID_IN  = Math.max(1, Math.min(SLIDE_IN_DUR, Math.floor(durationInFrames / 2) - 1));\n  const SLIDE_MID_OUT = Math.min(durationInFrames - 1, Math.max(SLIDE_MID_IN + 1, durationInFrames - SLIDE_OUT_DUR));\n  const easeBellIn    = Easing.bezier(0.4, 0, 0.1, 1);\n  const easeBellOut   = Easing.bezier(0.9, 0.1, 0.6, 1);\n  const easeContentIn = Easing.bezier(0.16, 1, 0.3, 1);\n\n  const bgIn  = interpolate(frame, [0, SLIDE_IN_DUR], [-DESIGN_WIDTH, 0], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: easeBellIn\n  });\n  const bgOut = interpolate(frame, [durationInFrames - SLIDE_OUT_DUR, durationInFrames], [0, -DESIGN_WIDTH], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: easeBellOut\n  });\n  const cardX = frame < durationInFrames / 2 ? bgIn : bgOut;\n\n  const TEXT_IN_START = 18;\n  const TEXT_IN_DUR   = 42;\n  const contentIn  = interpolate(frame, [TEXT_IN_START, TEXT_IN_START + TEXT_IN_DUR], [-DESIGN_WIDTH * 0.15, 0], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: easeContentIn\n  });\n  const contentOut = interpolate(frame, [durationInFrames - SLIDE_OUT_DUR, durationInFrames], [0, -DESIGN_WIDTH * 0.15], {\n    extrapolateLeft: 'clamp', extrapolateRight: 'clamp', easing: easeBellOut\n  });\n  const contentX = frame < durationInFrames / 2 ? contentIn : contentOut;\n\n  const NEON_START = 58;\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0, left: 0,\n    width: DESIGN_WIDTH, height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    overflow: 'hidden',\n    backgroundColor: 'transparent',\n  };\n\n  const rows = 35, cols = 20, spacing = 32;\n  const dots = [];\n  for (let r = 0; r < rows; r++) {\n    for (let c = 0; c < cols; c++) {\n      const x = c * spacing, y = r * spacing;\n      const wave = Math.sin(c * 0.2 + r * 0.15 + frame * 0.05);\n      dots.push(<circle key={`${r}-${c}`} cx={x} cy={y}\n        r={interpolate(wave, [-1,1],[0.5,2])}\n        fill={dotColor}\n        opacity={interpolate(wave, [-1,1],[0.05,0.25])} />);\n    }\n  }\n\n  const getNeonOpacity = (localF) => {\n    if (localF <= 0)  return 0;\n    if (localF <= 6)  return interpolate(localF, [0,6],   [0,0.12]);\n    if (localF <= 14) return interpolate(localF, [6,14],  [0.12,1.0]);\n    if (localF <= 20) return interpolate(localF, [14,20], [1.0,0.2]);\n    if (localF <= 30) return interpolate(localF, [20,30], [0.2,1.0]);\n    if (localF <= 37) return interpolate(localF, [30,37], [1.0,0.55]);\n    if (localF <= 46) return interpolate(localF, [37,46], [0.55,1.0]);\n    return 1.0 + Math.sin((localF - 46) * 0.06) * 0.03;\n  };\n\n  const getNeonGlow = (opacity) => {\n    const g = Math.max(0, Math.min(1, opacity));\n    return [\n      `0 0 ${6*g}px ${neonColor}`,\n      `0 0 ${16*g}px ${neonColor}CC`,\n      `0 0 ${30*g}px ${neonColor}88`,\n      `0 0 ${44*g}px ${neonColor}44`,\n    ].join(', ');\n  };\n\n  const TitleLine = ({ text, globalDelay, item }) => {\n    const localF = Math.max(0, frame - (NEON_START + globalDelay));\n    if (localF === 0) return <div style={{ color:'transparent', fontSize:66, fontWeight:800, lineHeight:1.1, fontFamily:\"'Barlow Condensed', sans-serif\" }}>{text}</div>;\n    const opacity = getNeonOpacity(localF);\n    return (\n      <div style={{ opacity, color:neonColor, fontSize:66, fontWeight:800, lineHeight:1.1,\n        letterSpacing:'0.02em', textShadow:getNeonGlow(opacity), textTransform:'uppercase',\n        fontFamily:\"'Barlow Condensed', sans-serif\" }}>\n        {text}\n      </div>\n    );\n  };\n\n  const SPEC_STAGGER = 30;\n  const SPEC_START   = NEON_START + 52;\n\n  const SpecLine = ({ text, delay, item }) => {\n    const localF = Math.max(0, frame - delay);\n    const tailLen = Math.min(4, text.length);\n    const mainStr = text.slice(0, text.length - tailLen);\n    const tailStr = text.slice(text.length - tailLen);\n    const slideIn  = spring({ frame:localF, fps, config:{ damping:18, stiffness:120 } });\n    const hrSpring = spring({ frame:Math.max(0,localF-5), fps, config:{ damping:24, stiffness:120, overshootClamping:true } });\n    const dotScale = spring({ frame:Math.max(0,localF-12), fps, config:{ damping:15, mass:0.5 } });\n    return (\n      <div style={{ position:'relative', width:'100%', paddingBottom:12 }}>\n        <div style={{ display:'flex', alignItems:'center', fontSize:28, fontWeight:500, color:'#fff', fontFamily:\"'Inter', sans-serif\" }}>\n          <span style={{ display:'inline-block', transform:`translateX(${interpolate(slideIn,[0,1],[-30,0])}px)`, opacity:interpolate(slideIn,[0,1],[0,1]), whiteSpace:'pre' }}>{mainStr}</span>\n          <span style={{ display:'inline-flex' }}>\n            {tailStr.split('').map((char,i) => {\n              const charOp = interpolate(Math.max(0,localF-(10+i*4)),[0,5],[0,1],{extrapolateRight:'clamp'});\n              return <span key={i} style={{ opacity:charOp, whiteSpace:'pre' }}>{char}</span>;\n            })}\n          </span>\n        </div>\n        <div style={{ position:'absolute', bottom:0, left:0, right:0, height:1.5, backgroundColor:'rgba(255,255,255,0.3)', transform:`scaleX(${Math.min(1,hrSpring)})`, transformOrigin:'left' }} />\n        <div style={{ position:'absolute', bottom:-2, right:0, width:6, height:6, backgroundColor:'#fff', transform:`scale(${dotScale})`, transformOrigin:'center' }} />\n      </div>\n    );\n  };\n\n  const dividerOp = interpolate(frame,\n    [0, SLIDE_MID_IN, SLIDE_MID_OUT, durationInFrames],\n    [0, 1, 1, 0],\n    { extrapolateLeft:'clamp', extrapolateRight:'clamp' }\n  );\n\n  return (\n    <div style={rootStyle}>\n      <div style={{ position:'absolute', top:0, left:0, width:DESIGN_WIDTH, height:DESIGN_HEIGHT,\n        backgroundColor: transparentBackground ? 'transparent' : '#1a1a1a',\n        transform:`translateX(${cardX}px)`, willChange:'transform' }}>\n        <svg width=\"100%\" height=\"100%\" style={{ position:'absolute', top:0, left:0 }}>{dots}</svg>\n        <div style={{ position:'absolute', top:0, right:0, width:2, height:'100%',\n          backgroundColor:'#888888', opacity:dividerOp }} />\n      </div>\n      <div style={{ position:'absolute', top:80, left:80, width:488,\n        transform:`translateX(${cardX + contentX}px)`, willChange:'transform', zIndex:1 }}>\n        <div style={{ marginBottom:40 }}>\n          <TitleLine text={titleLine1} globalDelay={0} />\n          <TitleLine text={titleLine2} globalDelay={20} />\n        </div>\n        <div style={{ display:'flex', flexDirection:'column', gap:20, paddingBottom:SAFE_BOTTOM }}>\n          {specs.map((spec, i) => <SpecLine key={i} text={spec} delay={SPEC_START + i * SPEC_STAGGER} />)}\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
