    "defaultValue": "#3b4860",
    "label": "Background Gradient Start"
   },
   {
    "key": "bgGradientEnd",
    "type": "color",
    "defaultValue": "#4d5768",
    "label": "Background Gradient End"
   },
   {
    "key": "actualColor",
    "type": "color",
