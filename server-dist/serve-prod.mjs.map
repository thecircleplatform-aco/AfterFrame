    ],
    "thumb": "/thumbnails/ss-keyword-pop.jpg",
    "code": "const ShortsKeywordPop = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const keyword = p.keyword || '关键是坚持';\n  const subText = p.subText || '';\n  const accent = p.accentColor || '#ff4d6d';\n  const textColor = p.textColor || '#ffffff';\n  const fontSize = Number(p.fontSize) || 96;\n  const enter = spring({ frame, fps, config: { damping: 14, stiffness: 120 } });\n  const pop = spring({ frame: frame - 4, fps, config: { damping: 12, stiffness: 160 } });\n  const exit = interpolate(frame, [durationInFrames - 12, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  const scale = 0.85 + enter * 0.2;\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent', justifyContent: 'center', alignItems: 'center' }}>\n      <div style={{\n        opacity: enter * exit,\n        transform: `scale(${scale * (0.95 + pop * 0.05)})`,\n        textAlign: 'center',\n        padding: '0 64px',\n        maxWidth: 980,\n      }}>\n        <div style={{\n          fontSize,\n          fontWeight: 900,\n          color: textColor,\n          lineHeight: 1.15,\n          letterSpacing: 2,\n          textShadow: `0 0 40px ${accent}99, 0 8px 24px #000a`,\n          WebkitTextStroke: `2px ${accent}`,\n        }}>{keyword}</div>\n        {subText ? (\n          <div style={{\n            marginTop: 28,\n            fontSize: 36,\n            fontWeight: 600,\n            color: textColor,\n            opacity: 0.85 * pop,\n          }}>{subText}</div>\n        ) : null}\n        <div style={{\n          margin: '36px auto 0',\n          width: 120 * pop,\n          height: 8,\n          borderRadius: 99,\n          background: accent,\n          boxShadow: `0 0 24px ${accent}`,\n        }} />\n      </div>\n    </AbsoluteFill>\n  );\n};"
  },
