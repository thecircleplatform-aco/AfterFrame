  "thumb": "/thumbnails/dd96bb2f-ec3c-466b-84b6-23c5735339b7.jpg",
  "code": "const InvestmentSlide = ({item}) => {\n  const frame = useCurrentFrame();\n  const {durationInFrames} = useVideoConfig();\n\n  const props = item.props || {};\n  const titleText = props.titleText;\n  const subtitleText = props.subtitleText;\n  const titleFont = props.titleFont;\n  const bodyFont = props.bodyFont;\n\n  const v1 = parseFloat(props.seg1Value) || 0;\n  const v2 = parseFloat(props.seg2Value) || 0;\n  const v3 = parseFloat(props.seg3Value) || 0;\n  const v4 = parseFloat(props.seg4Value) || 0;\n  const total = (v1 + v2 + v3 + v4) || 1;\n  const p1 = v1 / total;\n  const p2 = v2 / total;\n  const p3 = v3 / total;\n  const p4 = v4 / total;\n\n  const color1 = props.color1;\n  const color2 = props.color2;\n  const color3 = props.color3;\n  const color4 = props.color4;\n\n  const backgroundColor = props.transparentBackground ? 'transparent' : props.bgColor;\n\n  // --- Easing curves ---\n  const smoothSettle = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return 1 - Math.pow(1 - t, 3.5);\n  };\n  const bellCurveLate = (t) => {\n    if (t <= 0) return 0;\n    if (t >= 1) return 1;\n    return t < 0.4\n      ? 0.15 * Math.pow(t / 0.4, 2.5)\n      : 0.15 + 0.85 * (1 - Math.pow(1 - (t - 0.4) / 0.6, 2.8));\n  };\n\n  // --- NO dynamic opacity/transform on root (triggers compositor promotion) ---\n  // Exit: bake into child elements instead\n  const totalFrames = durationInFrames || 180;\n  const exitStart = totalFrames - 25;\n  const exitRaw = Math.max(0, Math.min(1, (frame - exitStart) / 25));\n  const exitProgress = exitRaw * exitRaw;\n  const exitAlpha = 1 - exitProgress;\n\n  // --- Frame border: fade in over 40 frames ---\n  const frameRaw = Math.min(1, Math.max(0, frame / 40));\n  const frameOpacity = smoothSettle(frameRaw) * exitAlpha;\n\n  // --- Title: starts at frame 5, 50 frames ---\n  const titleRaw = Math.min(1, Math.max(0, (frame - 5) / 50));\n  const titleProgress = smoothSettle(titleRaw);\n  const titleOpacity = smoothSettle(Math.min(1, Math.max(0, (frame - 5) / 18))) * exitAlpha;\n  const titleY = (1 - titleProgress) * 60;\n\n  // --- Separator line: starts frame 20, 45 frames ---\n  const sepRaw = Math.min(1, Math.max(0, (frame - 20) / 45));\n  const separatorWidth = smoothSettle(sepRaw) * 100;\n\n  // --- Donut chart segments: bellCurveLate, staggered ---\n  const C = 2 * Math.PI * 130;\n  const d1 = p1 * C;\n  const d2 = p2 * C;\n  const d3 = p3 * C;\n  const d4 = p4 * C;\n\n  const chartRaw1 = Math.min(1, Math.max(0, (frame - 30) / 60));\n  const chartRaw2 = Math.min(1, Math.max(0, (frame - 36) / 60));\n  const chartRaw3 = Math.min(1, Math.max(0, (frame - 42) / 60));\n  const chartRaw4 = Math.min(1, Math.max(0, (frame - 48) / 60));\n\n  const s1 = bellCurveLate(chartRaw1) * d1;\n  const s2 = bellCurveLate(chartRaw2) * d2;\n  const s3 = bellCurveLate(chartRaw3) * d3;\n  const s4 = bellCurveLate(chartRaw4) * d4;\n\n  // --- Legend items: staggered, appear when chart at 55% ---\n  const legendDelay1 = 30 + 60 * 0.55;\n  const legendDelay2 = 36 + 60 * 0.55;\n  const legendDelay3 = 42 + 60 * 0.55;\n  const legendDelay4 = 48 + 60 * 0.55;\n\n  const legendRaw = (delay) => Math.min(1, Math.max(0, (frame - delay) / 20));\n  const l1Op = smoothSettle(legendRaw(legendDelay1)) * exitAlpha;\n  const l2Op = smoothSettle(legendRaw(legendDelay2)) * exitAlpha;\n  const l3Op = smoothSettle(legendRaw(legendDelay3)) * exitAlpha;\n  const l4Op = smoothSettle(legendRaw(legendDelay4)) * exitAlpha;\n\n  const GAP = 2.5;\n\n  // Bake exitAlpha into SVG stroke opacity\n  const chartAlpha = exitAlpha;\n\n  const hexToRgba = (hex, alpha) => {\n    if (!hex) return `rgba(0,1,9,${alpha})`;\n    const h = hex.replace('#', '');\n    const r = parseInt(h.length === 3 ? h[0]+h[0] : h.substring(0,2), 16) || 0;\n    const g = parseInt(h.length === 3 ? h[1]+h[1] : h.substring(2,4), 16) || 0;\n    const b = parseInt(h.length === 3 ? h[2]+h[2] : h.substring(4,6), 16) || 0;\n    return `rgba(${r}, ${g}, ${b}, ${alpha})`;\n  };\n\n  const LegendItem = ({ label, value, color, opacity, item }) => (\n    <div style={{\n      display: 'flex', alignItems: 'center', gap: 24,\n      opacity,\n      transform: `translateX(${(1 - opacity) * -15}px)`\n    }}>\n      <div style={{ width: 16, height: 16, backgroundColor: color, borderRadius: '50%' }} />\n      <div style={{ display: 'flex', flexDirection: 'column', minWidth: 200 }}>\n        <span style={{ fontFamily: bodyFont, fontSize: 24, color: '#dee6f3', fontWeight: 300, letterSpacing: 0.5 }}>{label}</span>\n      </div>\n      <div style={{ flex: 1, borderBottom: '1px dashed rgba(237,244,255,0.15)', margin: '0 20px', position: 'relative', top: 4 }} />\n      <span style={{ fontFamily: titleFont, fontSize: 30, color: color, fontWeight: 500 }}>{value}%</span>\n    </div>\n  );\n\n  return (\n    <div style={{ position: 'absolute', inset: 0, backgroundColor, overflow: 'hidden' }}>\n      <div style={{\n        position: 'absolute',\n        inset: 40,\n        border: '1px solid rgba(237,244,255,0.1)',\n        pointerEvents: 'none',\n        opacity: frameOpacity\n      }}>\n        <div style={{ position: 'absolute', top: -1, left: -1, width: 20, height: 20, borderTop: '2px solid rgba(237,244,255,0.5)', borderLeft: '2px solid rgba(237,244,255,0.5)' }} />\n        <div style={{ position: 'absolute', top: -1, right: -1, width: 20, height: 20, borderTop: '2px solid rgba(237,244,255,0.5)', borderRight: '2px solid rgba(237,244,255,0.5)' }} />\n        <div style={{ position: 'absolute', bottom: -1, left: -1, width: 20, height: 20, borderBottom: '2px solid rgba(237,244,255,0.5)', borderLeft: '2px solid rgba(237,244,255,0.5)' }} />\n        <div style={{ position: 'absolute', bottom: -1, right: -1, width: 20, height: 20, borderBottom: '2px solid rgba(237,244,255,0.5)', borderRight: '2px solid rgba(237,244,255,0.5)' }} />\n      </div>\n\n      <div style={{\n        position: 'absolute',\n        inset: 80,\n        display: 'flex',\n        alignItems: 'center',\n        opacity: exitAlpha\n      }}>\n        <div style={{ flex: '0 0 50%', paddingRight: 60, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>\n          <div style={{ opacity: titleOpacity, transform: `translateY(${titleY}px)` }}>\n            <h1 style={{ fontFamily: titleFont, fontSize: 72, color: color1, margin: '0 0 10px 0', fontWeight: 600, lineHeight: 1.1 }}>\n              {titleText}\n            </h1>\n            <h2 style={{ fontFamily: bodyFont, fontSize: 30, color: '#9ba4b3', margin: 0, fontWeight: 300, letterSpacing: 2 }}>\n              {subtitleText}\n            </h2>\n          </div>\n\n          <div style={{\n            height: 1,\n            backgroundColor: 'rgba(237,244,255,0.2)',\n            margin: '40px 0 60px 0',\n            width: `${separatorWidth}%`\n          }} />\n\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 24 }}>\n            <LegendItem label={props.seg1Label} value={props.seg1Value} color={color1} opacity={l1Op} />\n            <LegendItem label={props.seg2Label} value={props.seg2Value} color={color2} opacity={l2Op} />\n            <LegendItem label={props.seg3Label} value={props.seg3Value} color={color3} opacity={l3Op} />\n            <LegendItem label={props.seg4Label} value={props.seg4Value} color={color4} opacity={l4Op} />\n          </div>\n        </div>\n\n        <div style={{ flex: '0 0 50%', display: 'flex', justifyContent: 'center', alignItems: 'center' }}>\n          <div style={{ width: 700, height: 700, transform: 'rotate(-90deg)' }}>\n            <svg viewBox=\"-20 -20 440 440\" width=\"100%\" height=\"100%\" style={{ overflow: 'hidden' }}>\n              <g opacity={frameOpacity}>\n                <circle cx=\"200\" cy=\"200\" r=\"130\" stroke={`rgba(237,244,255,0.03)`} strokeWidth=\"140\" fill=\"transparent\" />\n                <circle cx=\"200\" cy=\"200\" r=\"205\" stroke={`rgba(237,244,255,0.1)`} strokeWidth=\"1\" fill=\"transparent\" />\n                <circle cx=\"200\" cy=\"200\" r=\"55\" stroke={`rgba(237,244,255,0.1)`} strokeWidth=\"1\" fill=\"transparent\" />\n              </g>\n              <g opacity={chartAlpha}>\n                <circle cx=\"200\" cy=\"200\" r=\"130\" fill=\"transparent\" stroke={color1} strokeWidth=\"140\" strokeDasharray={`${Math.max(0, s1 - GAP)} ${C}`} strokeDashoffset={0} strokeLinecap=\"butt\" />\n                <circle cx=\"200\" cy=\"200\" r=\"130\" fill=\"transparent\" stroke={color2} strokeWidth=\"140\" strokeDasharray={`${Math.max(0, s2 - GAP)} ${C}`} strokeDashoffset={-d1} strokeLinecap=\"butt\" />\n                <circle cx=\"200\" cy=\"200\" r=\"130\" fill=\"transparent\" stroke={color3} strokeWidth=\"140\" strokeDasharray={`${Math.max(0, s3 - GAP)} ${C}`} strokeDashoffset={-(d1+d2)} strokeLinecap=\"butt\" />\n                <circle cx=\"200\" cy=\"200\" r=\"130\" fill=\"transparent\" stroke={color4} strokeWidth=\"140\" strokeDasharray={`${Math.max(0, s4 - GAP)} ${C}`} strokeDashoffset={-(d1+d2+d3)} strokeLinecap=\"butt\" />\n              </g>\n            </svg>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "6fba5c4c-4003-41c3-b1ea-3482b1214293",
  "name": "Data visualization animation",
  "category": "uncategorized",
  "description": "A documentary-style stop-motion animated area chart showing historical data progression. Features a paper texture background with \"shoot on 3s\" framerate emulation.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationInFrames": 90,
  "props": {
   "titleText": "U.S. Home Decor Sales: Storefront vs. Online, 2001–2024",
   "subtitleText": "NHFA Home Furnishings Sales Report",
   "blueText": "Storefront sales",
   "pinkText": "Online revenue",
   "backgroundColor": "#e8e6e0",
   "blueColor": "#5e9b6b",
   "pinkColor": "#a48f3e",
   "yellowColor": "#88ffe9",
   "transparentBackground": false
  },
  "propSchema": [
   {
    "key": "titleText",
    "type": "text",
    "defaultValue": "U.S. Home Decor Sales: Storefront vs. Online, 2001–2024",
    "label": "Title"
   },
   {
    "key": "subtitleText",
    "type": "text",
    "defaultValue": "NHFA Home Furnishings Sales Report",
    "label": "Subtitle"
   },
   {
    "key": "blueText",
    "type": "text",
    "defaultValue": "Storefront sales",
    "label": "Blue Series Label"
   },
   {
    "key": "pinkText",
    "type": "text",
    "defaultValue": "Online revenue",
    "label": "Pink Series Label"
   },
   {
    "key": "backgroundColor",
    "type": "color",
    "defaultValue": "#e8e6e0",
    "label": "Background Color"
   },
   {
    "key": "blueColor",
    "type": "color",
    "defaultValue": "#5e9b6b",
    "label": "Blue Color"
   },
   {
    "key": "pinkColor",
    "type": "color",
    "defaultValue": "#a48f3e",
    "label": "Pink Color"
   },
   {
    "key": "yellowColor",
    "type": "color",
    "defaultValue": "#88ffe9",
    "label": "Event Line Color"
