  "thumb": "/thumbnails/2063446e-f68f-4284-ae99-aefd13bd4824.jpg",
  "code": "const VoxTypewriterTitleClean = ({item}) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n\n  const DESIGN_WIDTH = 1920;\n  const DESIGN_HEIGHT = 1080;\n  const safeFps = fps || 30;\n\n  const textSubtitle = (item.props && item.props.subtitleText) !== undefined ? item.props.subtitleText : \"Why furniture shipping keeps getting slower\";\n  const textChapter = (item.props && item.props.chapterText) !== undefined ? item.props.chapterText : \"Chapter 2:\";\n  const textTitle = (item.props && item.props.titleText) !== undefined ? item.props.titleText : \"Wishlists\";\n  const bgColor = (item.props && item.props.bgColor) !== undefined ? item.props.bgColor : \"#f0eae1\";\n  const titleColor = (item.props && item.props.titleColor) !== undefined ? item.props.titleColor : \"#0a0a0a\";\n  const chapterColor = (item.props && item.props.chapterColor) !== undefined ? item.props.chapterColor : \"#1a1a1a\";\n  const subtitleColor = (item.props && item.props.subtitleColor) !== undefined ? item.props.subtitleColor : \"#706c66\";\n  const animSpeed = (item.props && item.props.animSpeed) !== undefined ? item.props.animSpeed : 1.0;\n\n  const safeSpring = (delay = 0, config = { damping: 18, stiffness: 120 }) => {\n    return spring({ frame: Math.max(0, frame - delay / animSpeed), fps: safeFps, config });\n  };\n\n  const animStartDelay = Math.floor(0.15 * safeFps);\n  const subtitleSpring = safeSpring(animStartDelay, { damping: 20, stiffness: 100 });\n  const subtitleY = interpolate(subtitleSpring, [0, 1], [-40, 0]);\n  const subtitleOpacity = interpolate(subtitleSpring, [0, 1], [0, 1]);\n\n  const chapterSpring = safeSpring(animStartDelay + Math.floor(0.08 * safeFps), { damping: 20, stiffness: 100 });\n  const chapterY = interpolate(chapterSpring, [0, 1], [40, 0]);\n  const chapterOpacity = interpolate(chapterSpring, [0, 1], [0, 1]);\n\n  const typeStartFrame = Math.floor((animStartDelay + Math.floor(0.1 * safeFps)) / animSpeed);\n  const typeDuration = 1.0 / animSpeed;\n  const typeEndFrame = typeStartFrame + Math.floor(typeDuration * safeFps);\n  const typeProgressRaw = interpolate(frame, [typeStartFrame, typeEndFrame], [0, 1], {\n    extrapolateLeft: 'clamp',\n    extrapolateRight: 'clamp',\n  });\n\n  const getCharOpacity = (charIndex) => {\n    const totalChars = textTitle.length;\n    const charStartProgress = charIndex / totalChars;\n    const charEndProgress = Math.min((charIndex + 1.5) / totalChars, 1);\n    return interpolate(typeProgressRaw, [charStartProgress, charEndProgress], [0, 1], {\n      extrapolateLeft: 'clamp',\n      extrapolateRight: 'clamp',\n    });\n  };\n\n  const scale = Math.min(\n    (item?.width || DESIGN_WIDTH) / DESIGN_WIDTH,\n    (item?.height || DESIGN_HEIGHT) / DESIGN_HEIGHT\n  );\n\n  const seededRandom = (seed) => {\n    const x = Math.sin(seed * 9999) * 10000;\n    return x - Math.floor(x);\n  };\n\n  const textureData = React.useMemo(() => {\n    const fibers = [];\n    for (let i = 0; i < 500; i++) {\n      const x = seededRandom(i * 1.7) * 1920;\n      const y = seededRandom(i * 2.3) * 1080;\n      const distX = Math.abs(x - 960) / 960;\n      const distY = Math.abs(y - 540) / 540;\n      const dist = Math.sqrt(distX * distX + distY * distY);\n      const edgeFactor = Math.pow(dist, 1.2);\n      const baseOp = 0.1 + seededRandom(i * 3.1) * 0.2;\n      const op = baseOp * (0.15 + edgeFactor * 0.85);\n      const w = 1 + seededRandom(i * 4.2) * 2.5;\n      const h = 10 + seededRandom(i * 5.1) * 35;\n      const rot = seededRandom(i * 6.3) * 180 - 90;\n      const shade = Math.floor(130 + seededRandom(i * 7.4) * 70);\n      fibers.push({x, y, w, h, rot, op, shade});\n    }\n    const scr = [];\n    for (let i = 0; i < 150; i++) {\n      const x = seededRandom(i * 3.2) * 1920;\n      const y = seededRandom(i * 4.1) * 1080;\n      const distX = Math.abs(x - 960) / 960;\n      const distY = Math.abs(y - 540) / 540;\n      const dist = Math.sqrt(distX * distX + distY * distY);\n      const edgeFactor = Math.pow(dist, 1.3);\n      const baseOp = 0.08 + seededRandom(i * 5.2) * 0.15;\n      const op = baseOp * (0.1 + edgeFactor * 0.9);\n      const w = 0.5 + seededRandom(i * 6.1) * 1.5;\n      const h = 25 + seededRandom(i * 7.2) * 80;\n      const rot = seededRandom(i * 8.3) * 50 - 25;\n      const shade = Math.floor(150 + seededRandom(i * 9.4) * 60);\n      scr.push({x, y, w, h, rot, op, shade});\n    }\n    const spk = [];\n    for (let i = 0; i < 400; i++) {\n      const x = seededRandom(i * 2.1) * 1920;\n      const y = seededRandom(i * 3.4) * 1080;\n      const distX = Math.abs(x - 960) / 960;\n      const distY = Math.abs(y - 540) / 540;\n      const dist = Math.sqrt(distX * distX + distY * distY);\n      const edgeFactor = Math.pow(dist, 1.4);\n      const baseOp = 0.12 + seededRandom(i * 4.5) * 0.2;\n      const op = baseOp * (0.1 + edgeFactor * 0.9);\n      const sz = 1 + seededRandom(i * 5.6) * 4;\n      const shade = Math.floor(140 + seededRandom(i * 6.7) * 80);\n      spk.push({x, y, sz, op, shade});\n    }\n    return {fibers, scr, spk};\n  }, []);\n\n  const rootStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: DESIGN_WIDTH,\n    height: DESIGN_HEIGHT,\n    transform: `scale(${scale})`,\n    transformOrigin: 'top left',\n    backgroundColor: bgColor,\n    overflow: 'hidden',\n    display: 'flex',\n    flexDirection: 'column',\n    justifyContent: 'center',\n    alignItems: 'center',\n  };\n\n  const gridStyle = {\n    position: 'absolute',\n    top: 0,\n    left: 0,\n    width: '100%',\n    height: '100%',\n    backgroundImage: 'linear-gradient(to right, rgba(200,198,192,0.3) 1px, transparent 1px), linear-gradient(to bottom, rgba(200,198,192,0.3) 1px, transparent 1px)',\n    backgroundSize: '40px 40px',\n    pointerEvents: 'none',\n  };\n\n  const fontStack = '\"Georgia\", \"Times New Roman\", serif';\n\n  const subtitleStyle = {\n    fontFamily: fontStack,\n    fontSize: '32px',\n    color: subtitleColor,\n    marginBottom: '20px',\n    fontStyle: 'italic',\n    letterSpacing: '0.5px',\n    textAlign: 'center',\n    transform: `translateY(${subtitleY}px)`,\n    opacity: subtitleOpacity,\n    filter: 'blur(0.8px)',\n  };\n\n  const chapterStyle = {\n    fontFamily: fontStack,\n    fontSize: '42px',\n    fontWeight: 'bold',\n    color: chapterColor,\n    marginBottom: '10px',\n    textAlign: 'center',\n    transform: `translateY(${chapterY}px)`,\n    opacity: chapterOpacity,\n    filter: 'blur(0.4px)',\n    textShadow: '0 1px 0 rgba(85,63,81,0.08)',\n  };\n\n  const titleStyle = {\n    fontFamily: fontStack,\n    fontSize: '150px',\n    fontWeight: 900,\n    color: titleColor,\n    letterSpacing: '-4px',\n    lineHeight: 1,\n    textAlign: 'left',\n    minHeight: '160px',\n    textShadow: '0 1px 0 rgba(64,43,61,0.12), 0 2px 1px rgba(64,43,61,0.06)',\n    position: 'relative',\n  };\n\n  const titleWrapperStyle = {\n    position: 'relative',\n    width: 'auto',\n    display: 'flex',\n    justifyContent: 'center',\n  };\n\n  const titleInnerStyle = {\n    position: 'relative',\n  };\n\n  return (\n    <div style={rootStyle}>\n      <div style={gridStyle} />\n      {textureData.fibers.map((f, i) => (\n        <div key={'f'+i} style={{position: 'absolute', left: f.x, top: f.y, width: f.w, height: f.h, borderRadius: 1, backgroundColor: `rgb(${f.shade},${f.shade},${f.shade})`, opacity: f.op, transform: `rotate(${f.rot}deg)`, pointerEvents: 'none'}} />\n      ))}\n      {textureData.scr.map((s, i) => (\n        <div key={'s'+i} style={{position: 'absolute', left: s.x, top: s.y, width: s.w, height: s.h, backgroundColor: `rgb(${s.shade},${s.shade},${s.shade})`, opacity: s.op, transform: `rotate(${s.rot}deg)`, pointerEvents: 'none'}} />\n      ))}\n      {textureData.spk.map((p, i) => (\n        <div key={'p'+i} style={{position: 'absolute', left: p.x, top: p.y, width: p.sz, height: p.sz, borderRadius: '50%', backgroundColor: `rgb(${p.shade},${p.shade},${p.shade})`, opacity: p.op, pointerEvents: 'none'}} />\n      ))}\n      <div style={{position: 'absolute', top: 0, left: 0, width: '15%', height: '100%', backdropFilter: 'blur(2px)', WebkitBackdropFilter: 'blur(2px)', maskImage: 'linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%)', WebkitMaskImage: 'linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%)', pointerEvents: 'none'}} />\n      <div style={{position: 'absolute', top: 0, right: 0, width: '15%', height: '100%', backdropFilter: 'blur(2px)', WebkitBackdropFilter: 'blur(2px)', maskImage: 'linear-gradient(to left, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%)', WebkitMaskImage: 'linear-gradient(to left, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%)', pointerEvents: 'none'}} />\n      <div style={{zIndex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center'}}>\n        <div style={subtitleStyle}>{textSubtitle}</div>\n        <div style={chapterStyle}>{textChapter}</div>\n        <div style={titleWrapperStyle}>\n          <div style={titleInnerStyle}>\n            <span style={{...titleStyle, visibility: 'hidden'}}>{textTitle}</span>\n            <span style={{...titleStyle, position: 'absolute', left: 0, top: 0}}>{textTitle.split('').map((char, i) => (\n              <span key={i} style={{opacity: getCharOpacity(i), transition: 'none'}}>{char}</span>\n            ))}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
 },
 {
  "id": "4dfa6822-7089-4908-a4e5-3e4d5720f2df",
  "name": "Question mark animation",
  "category": "title-cards",
  "description": "Five bold question marks arranged in a loose arc, independently bobbing up and down with an optional pop-in entrance. Perfectly loops every 3 seconds.",
  "tags": [
