    "thumb": "/thumbnails/ss-big-caption.jpg",
    "code": "const ShortsBigCaption = ({ item }) => {\n  const frame = useCurrentFrame();\n  const { fps, durationInFrames } = useVideoConfig();\n  const p = item.props || {};\n  const caption = p.caption || '';\n  const bg = p.bgColor || 'rgba(0,0,0,0.72)';\n  const textColor = p.textColor || '#fff';\n  const accent = p.accentColor || '#38bdf8';\n  const fontSize = Number(p.fontSize) || 44;\n  const enter = spring({ frame, fps, config: { damping: 18, stiffness: 100 } });\n  const exit = interpolate(frame, [durationInFrames - 10, durationInFrames], [1, 0], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });\n  return (\n    <AbsoluteFill style={{ backgroundColor: 'transparent' }}>\n      <div style={{\n        position: 'absolute',\n        left: 48,\n        right: 48,\n        bottom: 220,\n        opacity: enter * exit,\n        transform: `translateY(${(1 - enter) * 40}px)`,\n        background: bg,\n        borderRadius: 20,\n        padding: '28px 32px 28px 40px',\n        borderLeft: `8px solid ${accent}`,\n        boxShadow: '0 12px 40px #0008',\n      }}>\n        <div style={{\n          color: textColor,\n          fontSize,\n          fontWeight: 700,\n          lineHeight: 1.35,\n          letterSpacing: 0.5,\n        }}>{caption}</div>\n      </div>\n    </AbsoluteFill>\n  );\n};"
