# Agent keys — server side only (read by server/keystore.ts).
# Pick whichever provider you use; the client's provider field selects it.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Client defaults (exposed to the browser by Vite).
VITE_AF_PROVIDER=openai
VITE_AF_MODEL=gpt-5
VITE_AF_PROJECT_ID=agent-standalone-console

# Optional: a service that executes tool calls against a real ProjectDoc.
# Without it, every tool call is answered with "no editor attached".
# VITE_AF_TOOL_EXECUTOR_URL=http://127.0.0.1:5199/api/editor-tools
